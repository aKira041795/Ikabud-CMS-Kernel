APP_ENV=testing
APP_DEBUG=0
APP_URL=http://applicationos.test
APP_FORCE_HTTPS=false
APP_TIMEZONE=Asia/Manila
APP_COOKIE_SAMESITE=Lax

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=baronbakeshop_ci
DB_USERNAME=root
DB_PASSWORD=ci_root_pass
DB_COLLATION=utf8mb4_unicode_ci

CONTROL_DB_HOST=127.0.0.1
CONTROL_DB_PORT=3306
CONTROL_DB_DATABASE=baronbakeshop_ci
CONTROL_DB_USERNAME=root
CONTROL_DB_PASSWORD=ci_root_pass
CONTROL_DB_COLLATION=utf8mb4_unicode_ci
CONTROL_DB_ENC_KEY=ci-enc-key-change-in-production-32chars

JWT_SECRET=ci-jwt-secret-change-in-production-use-48-chars

# Never send real mail in CI — log-only mailer (EMAIL_MAILER=log|null|test).
EMAIL_MAILER=log

ADMIN_VIEW_CACHE_TTL=0
CMS_SETTINGS_CACHE_TTL=0
TENANT_HOST_CACHE_TTL=0

CAP_TIMEOUT_MS=5000
CAP_RETRIES=0
CAP_SCHEMA_MODE=warn

APP_EAGER_MODULE_HELPERS=1
APP_ROUTE_AMBIGUITY_MODE=warn

APP_MULTI_TENANT_ENABLED=true
APP_TENANT_STRATEGY=control_host
APP_TENANT_DEFAULT=1
