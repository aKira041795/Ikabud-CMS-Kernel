{
    "component": "workbench:combobox",
    "contract": "1.0",
    "description": "Searchable select combobox with keyboard navigation",
    "requirements": {
        "role": "combobox",
        "aria_expanded": true,
        "aria_owns": true,
        "keyboard_navigation": [
            "ArrowDown",
            "ArrowUp",
            "Enter",
            "Escape"
        ],
        "focus_traps_within_listbox": false
    },
    "inputs": {
        "name": {
            "type": "string",
            "required": true
        },
        "options": {
            "type": "array",
            "required": true,
            "items": {
                "type": "object",
                "properties": {
                    "value": "string",
                    "label": "string"
                }
            }
        },
        "selected_value": {
            "type": "string"
        },
        "placeholder": {
            "type": "string"
        },
        "multiple": {
            "type": "bool",
            "default": false
        },
        "required": {
            "type": "bool",
            "default": false
        },
        "disabled": {
            "type": "bool",
            "default": false
        },
        "empty_message": {
            "type": "string",
            "default": "No results found"
        }
    },
    "assets": [
        "workbench-combobox.js"
    ]
}