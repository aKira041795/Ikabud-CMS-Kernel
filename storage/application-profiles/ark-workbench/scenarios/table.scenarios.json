{
    "component": "workbench:responsive_table",
    "description": "Named scenarios for responsive-table component states",
    "scenarios": {
        "populated": {
            "description": "Table with multiple rows of data",
            "props": {
                "columns": [
                    {
                        "key": "id",
                        "label": "ID"
                    },
                    {
                        "key": "name",
                        "label": "Name"
                    },
                    {
                        "key": "status",
                        "label": "Status"
                    }
                ],
                "rows": [
                    {
                        "id": "1",
                        "cells": {
                            "id": "001",
                            "name": "Item A",
                            "status": "Active"
                        },
                        "href": "/items/1"
                    },
                    {
                        "id": "2",
                        "cells": {
                            "id": "002",
                            "name": "Item B",
                            "status": "Pending"
                        },
                        "href": "/items/2"
                    },
                    {
                        "id": "3",
                        "cells": {
                            "id": "003",
                            "name": "Item C",
                            "status": "Inactive"
                        },
                        "href": "/items/3"
                    }
                ],
                "entity_type": "test.item",
                "state": "populated"
            },
            "expected": {
                "row_count": 3,
                "column_count": 3,
                "rows_have_href": true,
                "rows_have_entity_id": true,
                "state": "populated"
            }
        },
        "empty": {
            "description": "Table with no data rows",
            "props": {
                "columns": [
                    {
                        "key": "id",
                        "label": "ID"
                    },
                    {
                        "key": "name",
                        "label": "Name"
                    }
                ],
                "rows": [],
                "entity_type": "test.item",
                "state": "empty",
                "empty_message": "No items found."
            },
            "expected": {
                "row_count": 0,
                "shows_empty_message": true,
                "state": "empty"
            }
        },
        "with-actions": {
            "description": "Table with row action buttons",
            "props": {
                "columns": [
                    {
                        "key": "id",
                        "label": "ID"
                    },
                    {
                        "key": "name",
                        "label": "Name"
                    }
                ],
                "rows": [
                    {
                        "id": "1",
                        "cells": {
                            "id": "001",
                            "name": "Item A"
                        },
                        "href": "/items/1"
                    }
                ],
                "row_actions": [
                    {
                        "label": "View",
                        "url": "/items/1",
                        "variant": "ghost"
                    },
                    {
                        "label": "Edit",
                        "url": "/items/1/edit",
                        "variant": "ghost"
                    }
                ],
                "entity_type": "test.item",
                "state": "populated"
            },
            "expected": {
                "actions_column_present": true,
                "action_count": 2
            }
        }
    }
}