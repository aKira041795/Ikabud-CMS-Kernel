{* workbench:approval_panel — Approval review with impact, evidence, and decisions.
   Pass: subject, requester, submitted_at, summary_sections? ({title,body}[]),
         impact_sections? ({title,body}[]), evidence? ({label,url}[]),
         decision_history? (ActivityItem[]), actions (ActionValue[]),
         rejection_reason_required? (bool), audit_context? *}
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 mb-6">
    <div class="mb-4">
        <h2 class="text-lg font-semibold text-gray-900">{subject}</h2>
        <p class="text-sm text-gray-600">Submitted by {requester} on {submitted_at}</p>
    </div>

    {if summary_sections|default:[]}
        <div class="mb-4">
            {for section in summary_sections}
                <div class="mb-3">
                    <h3 class="text-sm font-semibold text-gray-700 mb-1">{section.title}</h3>
                    <div class="text-sm text-gray-900">{section.body|raw}</div>
                </div>
            {/for}
        </div>
    {/if}

    {if impact_sections|default:[]}
        <div class="mb-4 p-3 bg-gray-50 rounded-lg">
            {for section in impact_sections}
                <div class="mb-2">
                    <h3 class="text-sm font-semibold text-gray-700">{section.title}</h3>
                    <div class="text-sm text-gray-900">{section.body|raw}</div>
                </div>
            {/for}
        </div>
    {/if}

    {if evidence|default:[]}
        <div class="mb-4">
            <h3 class="text-sm font-semibold text-gray-700 mb-2">Supporting Documents</h3>
            <ul class="space-y-1">
                {for doc in evidence}
                    <li><a href="{doc.url}" class="text-sm text-blue-600 hover:underline">{doc.label}</a></li>
                {/for}
            </ul>
        </div>
    {/if}

    {if decision_history|default:[]}
        <div class="mb-4">
            <h3 class="text-sm font-semibold text-gray-700 mb-2">Previous Decisions</h3>
            {include "workbench:activity_timeline" items=decision_history variant="compact"}
        </div>
    {/if}

    <div class="flex items-center gap-2 pt-3 border-t border-gray-200">
        {for action in actions}
            {if action.key=='reject' && rejection_reason_required|default:true}
                <div class="flex-1">
                    <form method="POST" action="{action.url}" class="flex gap-2">
                        <input type="text" name="rejection_reason" placeholder="Rejection reason (required)" required class="flex-1 border border-red-300 rounded-lg px-3 py-2 text-sm">
                        <button type="submit" class="px-4 py-2 text-sm text-white bg-red-600 rounded-lg hover:bg-red-700">{action.label}</button>
                    </form>
                </div>
            {else}
                <form method="POST" action="{action.url}" class="inline">
                    <button type="submit" class="px-4 py-2 text-sm rounded-lg btn--{action.variant|default:'primary'}">{action.label}</button>
                </form>
            {/if}
        {/for}
    </div>

    {if audit_context|default:''}
        <div class="mt-3 pt-3 border-t border-gray-100">
            <p class="text-xs text-gray-500">{audit_context}</p>
        </div>
    {/if}
</div>
