{* workbench:responsive_table — Semantic table with data-label mobile card mode.
   Pass: columns ({key,label,align?,width?}[]), rows ({id,cells:{key:value},href?}[]),
         empty_message?, row_actions? (ActionValue[]), pagination? (raw HTML),
         caption? *}
<div class="overflow-x-auto" data-wb-component="responsive-table">
    <table class="wb-table"{if entity_type|default:''} data-wb-entity="{entity_type}"{/if}{if state|default:''} data-wb-state="{state}"{/if}>
        {if caption|default:''}<caption class="sr-only">{caption}</caption>{/if}
        <thead>
            <tr>
                {for col in columns}
                    <th scope="col" style="{if col.width|default:''}width:{col.width};{/if} text-align:{col.align|default:'left'}">{col.label}</th>
                {/for}
                {if row_actions|default:[]}<th scope="col" class="w-10"><span class="sr-only">Actions</span></th>{/if}
            </tr>
        </thead>
        <tbody>
            {if rows|default:[]}
                {for row in rows}
                    <tr {if row.href|default:''}class="wb-table__row--clickable" data-wb-href="{row.href}" tabindex="0" role="link"{/if}{if row.id|default:''} data-wb-entity-id="{row.id}"{/if}{if row.state|default:''} data-wb-row-state="{row.state}"{/if}>
                        {for col in columns}
                            <td data-label="{col.label}" style="text-align:{col.align|default:'left'}">{row.cells[col.key]|default:'—'}</td>
                        {/for}
                        {if row_actions|default:[]}
                            <td data-label="Actions">
                                <div class="flex gap-1">
                                    {for action in row_actions}
                                        <a href="{action.url}" class="btn btn--{action.variant|default:'ghost'} text-xs">{action.label}</a>
                                    {/for}
                                </div>
                            </td>
                        {/if}
                    </tr>
                {/for}
            {else}
                <tr>
                    <td colspan="{columns|count}{if row_actions|default:[]}+1{/if}" class="text-center py-8 text-gray-500">
                        {empty_message|default:'No items found'}
                    </td>
                </tr>
            {/if}
        </tbody>
    </table>
</div>
{if pagination|default:''}<div class="mt-4">{pagination|raw}</div>{/if}
