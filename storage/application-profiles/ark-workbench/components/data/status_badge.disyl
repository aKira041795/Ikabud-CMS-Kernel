{* workbench:status_badge — Semantic tone badge with optional icon.
   Pass: label (string), tone (neutral|informational|warning|success|danger),
         variant? (pill|dot), size? (sm|md|lg), icon? (string — emoji or symbol) *}
{set _hasIcon = icon|default:'' != ''}
<span class="wb-badge wb-badge--{tone} wb-badge--{size|default:'md'} {if variant|default:'pill'=='dot'}wb-badge--dot{/if} {if _hasIcon}wb-badge--icon{/if}"
      data-wb-component="status-badge"
      data-wb-tone="{tone}">
    {if _hasIcon}<span class="wb-badge__icon">{icon}</span> {/if}{label}
</span>
