{* workbench:app_shell — Application chrome with sidebar, header, and content area.
   Pass: shell (ApplicationShellViewModel via toTemplateContext()) *}
{set s = shell|default:[]}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{s.application_name} — {s.page_title|default:'Dashboard'}</title>
    <link rel="stylesheet" href="/assets/workbench/workbench-tailwind.css?v=4">
    <link rel="stylesheet" href="/assets/workbench/workbench.css?v=4">
    {if s.extra_styles|default:[]}{for style in s.extra_styles}<link rel="stylesheet" href="{style}">{/for}{/if}
</head>
<body class="wb-app-shell" data-wb-component="app-shell">
    {* Skip to content *}
    <a href="#wb-main" class="wb-skip-link">Skip to content</a>

    {* Mobile menu toggle *}
    <button id="wb-menu-btn" class="md:hidden fixed top-3 left-3 z-50 p-2 bg-slate-900 text-white rounded-lg shadow-lg" aria-label="Open menu" aria-expanded="false">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>

    {* Mobile overlay *}
    <div id="wb-overlay" class="wb-app-shell__overlay" aria-hidden="true"></div>

    {* Sidebar *}
    <aside id="wb-sidebar" class="wb-app-shell__sidebar">
        <div class="p-4 border-b border-slate-700">
            {if s.logo_url}<img src="{s.logo_url}" class="h-8 mb-1" alt="">{/if}
            <h1 class="text-lg font-bold text-white">{s.application_name}</h1>
            {if s.user_display|default:''}<p class="text-xs text-slate-400">{s.user_display}</p>{/if}
        </div>
        <nav class="flex-1 overflow-y-auto p-2 space-y-1" aria-label="Main navigation">
            {for section in s.navigation_sections|default:[]}
                <div class="wb-sidebar-section">
                    <button class="wb-sidebar-section__trigger" aria-expanded="{if section.collapsed_default|default:false}false{else}true{/if}" {if s.inspect_mode|default:false}data-wb-section="{section.label}"{/if}>
                        <span>{section.label}</span>
                        <span aria-hidden="true">{if section.collapsed_default|default:false}+{else}−{/if}</span>
                    </button>
                    <div class="wb-sidebar-section__items" style="max-height:{if section.collapsed_default|default:false}0{else}none{/if}">
                        {for item in section.items|default:[]}
                            <a href="{item.url}" class="wb-nav-item {if item.is_active}is-active{/if}" {if s.inspect_mode|default:false}data-wb-nav="{item.label|lower|replace:' ': '-'}"{/if}>
                                <span aria-hidden="true">{item.icon_key|default:'•'}</span>
                                {item.label}
                                {if item.badge_count|default:0 > 0}<span class="ml-auto bg-red-500 text-white text-xs rounded-full px-2 py-0.5">{item.badge_count}</span>{/if}
                            </a>
                        {/for}
                    </div>
                </div>
            {/for}
        </nav>
        {if s.user_actions|default:[]}
        <div class="p-4 border-t border-slate-700">
            {for action in s.user_actions}
                <a href="{action.url}" class="block px-3 py-2 rounded-lg text-sm text-slate-400 hover:bg-slate-700 hover:text-white transition-colors">{action.label}</a>
            {/for}
        </div>
        {/if}
    </aside>

    {* Main Content *}
    <main id="wb-main" class="wb-app-shell__main pb-16 md:pb-0"
          data-wb-component="app-shell"
          data-wb-page-family="{s.page_family|default:'default'}">
        {page_body|raw}
    </main>

    {* Bottom Navigation (mobile) *}
    {if s.mobile_navigation|default:[]}
    <nav class="wb-bottom-nav" aria-label="Mobile navigation">
        {for item in s.mobile_navigation}
            <a href="{item.url}" class="wb-bottom-nav__item {if item.is_active}is-active{/if}">
                <span class="text-lg" aria-hidden="true">{item.icon_key|default:'•'}</span>
                <span>{item.label}</span>
            </a>
        {/for}
    </nav>
    {/if}

    {* Toast container *}
    <div id="wb-toast-container" role="status" aria-live="polite" aria-atomic="false"></div>

    <script src="/assets/workbench/workbench-core.js?v=3"></script>
    {if s.extra_scripts|default:[]}{for script in s.extra_scripts}<script src="{script}"></script>{/for}{/if}
    <script>
    /* ajaxSubmit — handles form submission via fetch with toast feedback.
       Used by project-form, expense-detail, issuance-detail, etc.
       Attach via: onsubmit="return ajaxSubmit(this, 'Success message')" */
    function ajaxSubmit(form, successMsg) {
        var fd = new FormData(form);
        fetch(form.action, {
            method: form.method || 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: fd,
        }).then(function(r) { return r.json(); })
          .then(function(res) {
              if (res.ok) {
                  window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: successMsg || 'Saved', type: 'success' } }));
                  if (res.redirect) { window.location.href = res.redirect; }
                  else { setTimeout(function() { window.location.reload(); }, 800); }
              } else {
                  window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: res.error || 'Failed', type: 'error' } }));
              }
          }).catch(function() {
              window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Network error', type: 'error' } }));
          });
        return false; // prevent default form submission
    }
    </script>
    {if s.inspect_mode|default:false}
    <script id="wb-inspect-runtime">
    (function() {
        /* Workbench Inspect Runtime — annotates DOM with data-wb-* attributes for test automation.
           Activated when shell context has inspect_mode=true (?wb_inspect=1). */
        var main = document.getElementById('wb-main');
        if (!main) return;

        /* ---- Buttons: data-wb-action ---- */
        var btns = main.querySelectorAll('button:not([data-wb-action])');
        btns.forEach(function(b) {
            var text = (b.textContent || '').trim().replace(/\s+/g, ' ').substring(0, 50);
            if (!text) return;
            b.setAttribute('data-wb-action', text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''));
        });

        /* ---- Action links: data-wb-action ---- */
        var links = main.querySelectorAll('a:not([data-wb-nav]):not([data-wb-action])');
        links.forEach(function(a) {
            var text = (a.textContent || '').trim().replace(/\s+/g, ' ').substring(0, 50);
            var cls = a.className || '';
            if (!text) return;
            if (/btn|button|action/i.test(cls) || a.getAttribute('onclick') || /create|edit|delete|new|add/i.test(text)) {
                a.setAttribute('data-wb-action', text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''));
            }
        });

        /* ---- Forms: data-wb-form ---- */
        var forms = main.querySelectorAll('form:not([data-wb-form])');
        forms.forEach(function(f) {
            var method = (f.method || 'get').toLowerCase();
            var action = f.getAttribute('action') || '';
            f.setAttribute('data-wb-form', method + ':' + action.replace(/^.*\/\/[^\/]+/, ''));
            f.querySelectorAll('input[name], select[name], textarea[name]').forEach(function(el) {
                el.setAttribute('data-wb-field', el.name);
            });
        });

        /* ---- Entity lists: data-wb-list ---- */
        var lists = main.querySelectorAll('[data-ikb-list]:not([data-wb-list])');
        lists.forEach(function(l) {
            l.setAttribute('data-wb-list', l.getAttribute('data-ikb-list'));
        });

        /* ---- Status badges: data-wb-status ---- */
        var badges = main.querySelectorAll('.wb-badge, [class*="badge"], [class*="status"]');
        badges.forEach(function(b) {
            if (b.hasAttribute('data-wb-status')) return;
            var text = (b.textContent || '').trim();
            if (/draft|pending|approved|started|ongoing|completed|cancelled|closed|paid|overdue|rejected|voided/i.test(text)) {
                b.setAttribute('data-wb-status', text.toLowerCase());
            }
        });

        /* Fallback: check detail-header for plain-text status (no badge component used) */
        if (!main.querySelector('[data-wb-status]')) {
            var dh = main.querySelector('[data-wb-component="detail-header"]');
            if (dh) {
                var dhH2 = dh.querySelector('h2');
                if (dhH2 && dhH2.parentElement) {
                    var dhAll = (dhH2.parentElement.textContent || '').trim();
                    var dhTitle = (dhH2.textContent || '').trim();
                    var dhRemainder = dhAll.slice(dhAll.indexOf(dhTitle) + dhTitle.length).trim();
                    if (/^(draft|pending|approved|started|ongoing|completed|cancelled|closed|paid|overdue|rejected|voided)$/i.test(dhRemainder)) {
                        dhH2.parentElement.setAttribute('data-wb-status', dhRemainder.toLowerCase());
                    }
                }
            }
        }

        /* ---- Emit manifest ---- */
        var manifest = {
            module: document.title.split(' — ')[0] || '',
            page: (main.querySelector('h1') || {}).textContent || '',
            actions: [].map.call(main.querySelectorAll('[data-wb-action]'), function(el) {
                return { key: el.getAttribute('data-wb-action'), text: (el.textContent||'').trim().substring(0,50), tag: el.tagName };
            }),
            forms: [].map.call(main.querySelectorAll('[data-wb-form]'), function(el) {
                return { key: el.getAttribute('data-wb-form'), fields: [].map.call(el.querySelectorAll('[data-wb-field]'), function(f) { return f.getAttribute('data-wb-field'); }) };
            }),
            lists: [].map.call(main.querySelectorAll('[data-wb-list]'), function(el) {
                return { source: el.getAttribute('data-wb-list') };
            }),
            nav: [].map.call(document.querySelectorAll('[data-wb-nav]'), function(el) {
                var clone = el.cloneNode(true);
                clone.querySelectorAll('[aria-hidden="true"]').forEach(function(n) { n.remove(); });
                return { key: el.getAttribute('data-wb-nav'), label: (clone.textContent||'').replace(/\s+/g, ' ').trim(), url: el.getAttribute('href') };
            }),
            status: (function() {
                var s = main.querySelector('[data-wb-status]');
                return s ? s.getAttribute('data-wb-status') : null;
            })(),
        };
        window.__wbManifest = manifest;
        console.log('[wb-inspect] manifest ready:', manifest.actions.length + ' actions, ' + manifest.nav.length + ' nav items');
    })();
    </script>
    {/if}
    {if s.inspect_mode|default:false && s.preflight_data|default:null}
    <script id="wb-preflight-runtime">
    window.__wbPreflight = {s.preflight_data|json|raw};
    console.log('[wb-preflight]', window.__wbPreflight);
    </script>
    {/if}
</body>
</html>
