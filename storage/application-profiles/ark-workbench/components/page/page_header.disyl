{* workbench:page_header — Standard page header with title, subtitle, and structured actions.
   Pass: title, subtitle?, breadcrumb? ({label,url}[]), back_url?, actions (ActionValue[]) *}
<div class="wb-page-header" data-wb-component="page-header">
    <div>
        {if back_url|default:''}
            <a href="{back_url}" class="text-sm text-gray-600 hover:text-gray-900 mb-1 inline-block lg:hidden">← Back</a>
        {/if}
        {if breadcrumb|default:[]}
            <nav class="flex items-center gap-1 text-sm text-gray-500 mb-1" aria-label="Breadcrumb">
                {for crumb in breadcrumb}
                    {if crumb.url|default:''}
                        <a href="{crumb.url}" class="hover:text-gray-900">{crumb.label}</a>
                        <span aria-hidden="true">/</span>
                    {else}
                        <span class="text-gray-900">{crumb.label}</span>
                    {/if}
                {/for}
            </nav>
        {/if}
        <h1 class="wb-page-header__title">{title}</h1>
        {if subtitle|default:''}<p class="wb-page-header__subtitle">{subtitle}</p>{/if}
    </div>
    {if actions|default:[]}
    <div class="wb-page-header__actions">
        {for action in actions}
            {if action.method == 'POST'}
                <form method="POST" action="{action.url}" class="inline">
                    <button type="submit" class="btn btn--{action.variant|default:'primary'}"{if action.key|default:''} data-wb-action="{action.key}"{/if}{if action.method|default:''} data-wb-method="{action.method}"{/if}>{action.label}</button>
                </form>
            {else}
                <a href="{action.url}" class="btn btn--{action.variant|default:'primary'}"{if action.key|default:''} data-wb-action="{action.key}"{/if}>{action.label}</a>
            {/if}
        {/for}
    </div>
    {/if}
</div>
