{# Entity-Native: Entity Detail (Single View) Template
   Pure entity-view rendering — no CMS-specific context injection.
   Theme owns layout, typography, spacing, visual treatment.
   Entity data + actions come from capability-gated entity context. #}

{extends "_cms_active_theme/layouts/public.disyl"}

{block content}
<ikb_section padding_y="lg">
    <ikb_container max_width="800px" padding="md">

        {# ── Governed entity detail — the theme declares intent, the kernel resolves #}
        {if entity_type and entity_id}
            <ikb_entity_detail
                source="{entity_type}"
                id="{entity_id}"
                view="{entity_view|default:'full'}"
            />
        {else}
            {# Fallback: render from context directly (legacy compat) #}
            <article class="en-detail">
                {if entity.title}
                    <h1 class="en-detail__title">{entity.title}</h1>
                {/if}

                {if entity.author_name or entity.published_at}
                    <div class="en-detail__meta">
                        {if entity.author_name}By {entity.author_name}{/if}
                        {if entity.published_at} · {entity.published_at}{/if}
                        {if entity.status}
                            <span class="en-card__status en-card__status--{entity.status}">{entity.status}</span>
                        {/if}
                    </div>
                {/if}

                {if entity.image}
                    <img src="{entity.image}" alt="{entity.title}" style="width:100%;max-height:400px;object-fit:cover;border-radius:var(--radius-md);margin-bottom:var(--spacing-md);" />
                {/if}

                {if entity.body}
                    <div class="en-detail__body">{entity.body|raw}</div>
                {/if}

                {# Actions — capability-gated, module-approved #}
                {if entity.actions}
                    <div class="en-detail__section" style="display:flex;gap:0.75rem;">
                        {for action in entity.actions}
                            <ikb_button variant="primary" size="md" href="{action.url}" label="{action.label}" />
                        {/for}
                    </div>
                {/if}

                {# Capability sections — rendered if the entity provides them #}
                {if capability_data}
                    {# Pricing block #}
                    {if capability_data.pricing}
                        <ikb_section padding_y="md">
                            <h3 style="font-weight:600;margin:0 0 0.5rem;">Pricing</h3>
                            <ikb_card padding="md" radius="md">
                                <span style="font-size:1.5rem;font-weight:700;color:var(--color-primary);">{capability_data.pricing.price_display}</span>
                            </ikb_card>
                        </ikb_section>
                    {/if}

                    {# Inventory block #}
                    {if capability_data.inventory}
                        <ikb_section padding_y="md">
                            <h3 style="font-weight:600;margin:0 0 0.5rem;">Availability</h3>
                            <ikb_badge tone="{if capability_data.inventory.in_stock}success{else}warning{/if}">
                                {if capability_data.inventory.in_stock}In Stock{else}Out of Stock{/if}
                            </ikb_badge>
                        </ikb_section>
                    {/if}

                    {# Progress block (courses, cases) #}
                    {if capability_data.progress_tracking}
                        <ikb_section padding_y="md">
                            <h3 style="font-weight:600;margin:0 0 0.5rem;">Progress</h3>
                            <div style="background:var(--color-surface-muted);border-radius:999px;height:8px;overflow:hidden;">
                                <div style="width:{capability_data.progress_tracking.percentage}%;height:100%;background:var(--color-primary);border-radius:999px;"></div>
                            </div>
                            <span style="font-size:0.8rem;color:var(--color-text-secondary);">{capability_data.progress_tracking.percentage}% complete</span>
                        </ikb_section>
                    {/if}
                {/if}
            </article>
        {/if}

    </ikb_container>
</ikb_section>
{/block}
