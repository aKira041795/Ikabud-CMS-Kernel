{
    "name": "entity-native",
    "version": "1.0.0",
    "label": "Entity Native",
    "description": "A pure entity-view theme — all content rendered through governed ikb_* components. No CMS-specific context injection. Themes present meaning; modules own truth.",
    "author": "Ikabud",
    "license": "MIT",
    "kernel_os_compat": "6.1.0",
    "disyl_compat": "4.7.0",
    "tokens": "tokens.json",
    "shell": "layouts/public.disyl",
    "sections": "sections/",
    "entity_views": "entity-views/",
    "supported_surfaces": [
        "public",
        "print",
        "email"
    ],
    "supported_slots": [
        "site.before",
        "header.before",
        "header.main",
        "header.after",
        "hero",
        "breadcrumbs",
        "content.before",
        "content",
        "content.after",
        "sidebar.primary",
        "footer.before",
        "footer.main",
        "footer.after",
        "site.after"
    ],
    "fallback_views": {
        "card": "entity-views/default-card.disyl",
        "table": "entity-views/default-table.disyl",
        "detail": "entity-views/default-detail.disyl",
        "compact": "entity-views/default-compact.disyl"
    },
    "design_language": {
        "type_scale": "inter",
        "color_system": "oklch",
        "grid": "tailwind-v3",
        "icon_set": "fontawesome-6"
    },
    "accessibility": {
        "semantic_landmarks": true,
        "skip_to_content": true,
        "keyboard_navigation": true,
        "visible_focus": true,
        "reduced_motion": true,
        "aria_current": true,
        "contrast_ratio": "4.5:1"
    },
    "browser_support": [
        "chrome >= 90",
        "firefox >= 88",
        "safari >= 14",
        "edge >= 90"
    ],
    "required_assets": {
        "css": [
            "style.css"
        ],
        "js": []
    },
    "optional_assets": {
        "js": [
            "script.js"
        ]
    },
    "theme": {
        "colors": {
            "primary": {
                "default": "#2563eb",
                "dark": "#3b82f6",
                "light": "#eff6ff"
            },
            "surface": {
                "default": "#ffffff",
                "muted": "#f8fafc",
                "raised": "#ffffff"
            },
            "text": {
                "primary": "#0f172a",
                "secondary": "#475569",
                "muted": "#94a3b8"
            },
            "border": {
                "default": "#e2e8f0",
                "subtle": "#f1f5f9"
            },
            "status": {
                "success": "#16a34a",
                "warning": "#ca8a04",
                "danger": "#dc2626",
                "info": "#0ea5e9"
            }
        },
        "typography": {
            "font_family": "Inter, system-ui, -apple-system, sans-serif",
            "heading_weight": "700",
            "body_size": "16px",
            "line_height": "1.6"
        },
        "spacing": {
            "none": "0",
            "sm": "0.75rem",
            "md": "1.25rem",
            "lg": "2rem",
            "xl": "3rem",
            "2xl": "5rem"
        },
        "radius": {
            "none": "0",
            "sm": "0.375rem",
            "md": "0.75rem",
            "lg": "1rem"
        },
        "shadows": {
            "sm": "0 1px 2px rgba(0,0,0,0.05)",
            "md": "0 4px 6px rgba(0,0,0,0.07)",
            "lg": "0 10px 25px rgba(0,0,0,0.08)"
        }
    },
    "layout": {
        "max_width": "1200px",
        "gutter": "1rem",
        "header": {
            "height": "64px",
            "sticky": true
        },
        "footer": {
            "columns": 3,
            "show_branding": true
        }
    },
    "components": {
        "ikb_container": {
            "defaults": {
                "max_width": "1200px",
                "padding": "md"
            }
        },
        "ikb_section": {
            "defaults": {
                "padding_y": "lg"
            }
        },
        "ikb_card": {
            "defaults": {
                "radius": "md",
                "shadow": "sm",
                "padding": "md"
            }
        },
        "ikb_grid": {
            "defaults": {
                "columns": 3,
                "gap": "md"
            }
        },
        "ikb_entity_list": {
            "defaults": {
                "view": "card_grid",
                "limit": 12,
                "empty_state": "Nothing here yet."
            }
        },
        "ikb_entity_detail": {
            "defaults": {
                "view": "full"
            }
        },
        "ikb_button": {
            "defaults": {
                "variant": "primary",
                "size": "md"
            }
        }
    }
}