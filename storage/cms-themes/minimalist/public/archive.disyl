{extends "_cms_active_theme/layouts/public.disyl"}

{block content}
<div class="archive-shell">
    <div class="archive-meta">{archive_type}</div>
    <h1>{archive_name}</h1>
    {if archive_desc}
    <p class="archive-meta">{archive_desc}</p>
    {/if}

    {if posts | count == 0}
    <p class="archive-meta">No posts found in this archive yet.</p>
    {else}
    <div class="posts-grid">
        {foreach posts as post}
        <article class="post-item">
            <h3><a href="{base_url}/cms/blog/{post.slug}">{post.title}</a></h3>
            <div class="post-meta">
                {if post.author_name}<span>By {post.author_name}</span>{/if}
                {if post.published_at}<span>{post.published_at}</span>{/if}
            </div>
            <p class="excerpt">{post.excerpt|default:"No excerpt available."}</p>
            <a href="{base_url}/cms/blog/{post.slug}" class="read-more">Read more →</a>
        </article>
        {/foreach}
    </div>
    {/if}

    {if total_pages > 1}
    <nav class="post-backlink">
        {if page_num > 1}<a href="?page=1">&laquo; First</a>{/if}
        <span class="taxonomy-chip taxonomy-chip--muted">Page {page_num} of {total_pages}</span>
        {if page_num < total_pages}<a href="?page={next_page}">Next &raquo;</a>{/if}
    </nav>
    {/if}
</div>
{/block}
