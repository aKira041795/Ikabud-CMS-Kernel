{extends "_cms_active_theme/layouts/public.disyl"}

{block head}
{if cms_head}{cms_head|raw}{/if}
{if structured_data}{structured_data|raw}{/if}
{/block}

{block content}
{cache key='cms:page:' + content.slug|default:'_' + ':' + content.updated_at|default:'0' ttl=300 tags=['cms:content:item','cms:content:list','cms:menu','cms:settings']}
{if builder_enabled}
<article class="page page--builder cms-builder-page" style="width: 100%;">
    {content_html|raw}
</article>
{else}
<article class="page cms-content-prose">
    <header class="page-header">
        <h1 class="page-title">{content.title|default:"Untitled"}</h1>
    </header>

    <div class="page-content prose">
        {content_html|raw}
    </div>
</article>
{/if}
{/cache}
{/block}
