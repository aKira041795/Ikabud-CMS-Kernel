<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title|default:"Untitled"}</title>
    {if theme_style_url}<link rel="stylesheet" href="{theme_style_url}">{/if}
    {if colors_style}{colors_style|raw}{/if}
    {if theme_layout_style}{theme_layout_style|raw}{/if}
    {if custom_css}{custom_css|raw}{/if}
    {if head_code}{head_code|raw}{/if}
    <noscript><style>[data-animate]{opacity:1!important;transform:none!important;}</style></noscript>
    {block head}{/block}
</head>
<body class="minimalist-theme{if builder_enabled && builder_page_settings.body_class} {builder_page_settings.body_class}{/if}">
    {if has_customized_header}
    {customized_header|raw}
    {else}
    <header class="site-header minimalist-default-header">
        <div class="container">
            <h1 class="site-title">
                <a href="{base_url}/cms">{site_title|default:gui.app_name|default:"My Website"}</a>
            </h1>
            <div class="site-nav">
                {if primary_menu}
                {primary_menu|raw}
                {else}
                <p>No navigation menu configured.</p>
                {/if}
            </div>
        </div>
    </header>
    {/if}

    <div class="site-content">
        <div class="{if builder_enabled}cms-builder-fullwidth{else}container{/if}">
            <div class="{if has_customized_sidebar && !builder_enabled}cms-content-with-sidebar {if sidebar_position == 'left'}sidebar-left{/if}{/if}"{if has_customized_sidebar && !builder_enabled} style="--sidebar-width:{sidebar_width|default:'300'}px;"{/if}>
                {if has_customized_sidebar && !builder_enabled}
                {if sidebar_position == 'left'}
                <aside class="cms-sidebar-slot">
                    {customized_sidebar|raw}
                </aside>
                {/if}
                {/if}
                <main id="main-content" class="cms-public-main site-main{if builder_enabled} site-main--builder{/if}{if has_customized_sidebar && !builder_enabled} cms-main-slot{/if}" role="main">
                    {block content}{/block}
                </main>
                {if has_customized_sidebar && !builder_enabled}
                {if sidebar_position == 'left'}
                {else}
                <aside class="cms-sidebar-slot">
                    {customized_sidebar|raw}
                </aside>
                {/if}
                {/if}
            </div>
        </div>
    </div>

    {if has_customized_footer}
    {customized_footer|raw}
    {else}
    <footer class="site-footer">
        <div class="container">
            <p>&copy; {current_year|default:"2026"} {site_title|default:gui.app_name|default:"Site"}. All rights reserved.</p>
        </div>
    </footer>
    {/if}

    {if theme_script_url}<script src="{theme_script_url}" defer></script>{/if}
    {if builder_enabled}<script src="{base_url}/assets/cms/builder-public.js" defer></script>{/if}
    {if body_end_code}{body_end_code|raw}{/if}
</body>
</html>
