{extends "_cms_active_theme/layouts/public.disyl"}

{block head}
{include "_cms_active_theme/public/ecommerce/partials/storefront-styles.disyl"}
{/block}

{block content}
<div class="native-storefront native-order-confirmation" data-native-ecommerce-template="order-confirmation">
    <div class="native-confirmation-hero">
        <div class="native-confirmation-icon">&#10003;</div>
        <p class="native-storefront-kicker">Order Received</p>
        <h1>Order placed successfully</h1>
        <p class="native-storefront-subtitle">Order <strong>#{order.order_number}</strong> has been received. A confirmation was sent to <strong>{order.customer_email}</strong>.</p>
        {if payment_label}
        <p class="native-note" style="margin-top:1rem;">Next step: {payment_label}</p>
        {/if}
    </div>

    <div class="native-order-layout" style="margin-top:2rem;">
        <section class="native-storefront-panel">
            <h2 class="native-panel-title">Order Details</h2>
            <div class="native-table-wrap">
                <table class="native-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th style="text-align:center;">Qty</th>
                            <th style="text-align:right;">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {foreach order.items as item}
                        <tr>
                            <td>
                                {item.product_title}
                                {if item.selected_addons | count > 0}<div class="native-note">Add-ons: {foreach item.selected_addons as addon}{addon.label}{if !loop.last}, {/if}{/foreach}</div>{/if}
                                {if item.booking.has_booking}<div class="native-note" style="color:#1d4ed8;">Appointment: {item.booking.scheduled_date} at {item.booking.scheduled_time}</div>{/if}
                                {if item.memberships | count > 0}<div class="native-note" style="color:#0369a1;">Membership: {foreach item.memberships as membership}{membership.tier_label}{if !loop.last}, {/if}{/foreach}</div>{/if}
                            </td>
                            <td style="text-align:center;">{item.qty}</td>
                            <td style="text-align:right;"><strong>{item.line_total_fmt}</strong></td>
                        </tr>
                        {/foreach}
                    </tbody>
                </table>
            </div>
        </section>

        <aside class="native-stack">
            <section class="native-storefront-panel">
                <h2 class="native-panel-title">Summary</h2>
                <div class="native-summary-list">
                    {if order.non_loyalty_discount_amount > 0}
                    <div class="native-summary-row"><span>Discount</span><strong>-{order.non_loyalty_discount_amount_fmt}</strong></div>
                    {/if}
                    {if order.loyalty_points_redeemed > 0}
                    <div class="native-summary-row"><span>Loyalty ({order.loyalty_points_redeemed} pts)</span><strong>-{order.loyalty_discount_amount_fmt}</strong></div>
                    {/if}
                    {if order.tax_amount > 0}
                    <div class="native-summary-row"><span>Tax</span><strong>{order.tax_amount_fmt}</strong></div>
                    {/if}
                    {if order.shipping_amount > 0}
                    <div class="native-summary-row"><span>Shipping</span><strong>{order.shipping_amount_fmt}</strong></div>
                    {/if}
                    <div class="native-summary-row native-summary-row--total"><span>Total</span><strong>{order.total_amount_fmt}</strong></div>
                </div>
            </section>

            {if order.memberships | count > 0 || order.bookings | count > 0}
            <section class="native-storefront-panel">
                <h2 class="native-panel-title">What Was Activated</h2>
                <div class="native-stack">
                    {foreach order.memberships as membership}
                    <div><strong>Membership:</strong> {membership.tier_label}{if membership.ends_at} through {membership.ends_at | date:'M j, Y'}{/if}</div>
                    {/foreach}
                    {foreach order.bookings as booking}
                    <div><strong>Appointment:</strong> {booking.product_title} on {booking.scheduled_for | date:'M j, Y g:i A'}</div>
                    {/foreach}
                </div>
            </section>
            {/if}

            <section class="native-storefront-panel">
                <h2 class="native-panel-title">Shipping To</h2>
                <p class="native-panel-copy">{order.shipping.first_name} {order.shipping.last_name}<br>
                    {order.shipping.address_line1}<br>
                    {if order.shipping.address_line2}{order.shipping.address_line2}<br>{/if}
                    {order.shipping.city}{if order.shipping.state}, {order.shipping.state}{/if} {order.shipping.postal_code}<br>
                    {if order.shipping.country}{order.shipping.country}<br>{/if}
                    {if order.shipping.phone}{order.shipping.phone}{/if}
                </p>
            </section>
        </aside>
    </div>

    <div class="native-actions" style="justify-content:center; margin-top:2rem;">
        {if is_logged_in}
        <a href="{base_url}/ecommerce/my-orders" class="button button-primary">View My Orders</a>
        {/if}
        <a href="{base_url}/ecommerce/shop" class="button button-secondary">Continue Shopping</a>
    </div>
</div>
{/block}