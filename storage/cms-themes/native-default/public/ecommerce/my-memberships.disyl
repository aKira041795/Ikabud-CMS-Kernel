{extends "_cms_active_theme/layouts/public.disyl"}

{block head}
{include "_cms_active_theme/public/ecommerce/partials/storefront-styles.disyl"}
{/block}

{block content}
<div class="native-storefront" data-native-ecommerce-template="my-memberships">
    <header class="native-storefront-hero">
        <div>
            <p class="native-storefront-kicker">Account</p>
            <h1>My Memberships</h1>
            <p class="native-storefront-subtitle">Tier-based access purchased through ecommerce orders.</p>
        </div>
        <div class="native-actions">
            <a href="{base_url}/ecommerce/my-orders" class="button button-secondary">Orders</a>
            <a href="{base_url}/ecommerce/rewards" class="button button-secondary">Rewards</a>
        </div>
    </header>

    {if memberships | count == 0}
    <div class="native-empty-state">
        <h2>No memberships yet</h2>
        <p class="native-note">Membership products you purchase will appear here after payment is completed.</p>
    </div>
    {else}
    <div style="display:grid; gap:1rem; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));">
        {foreach memberships as membership}
        <section class="native-storefront-panel">
            <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:1rem;">
                <div>
                    <p class="native-storefront-kicker" style="margin:0;">{membership.tier_label}</p>
                    <h2 class="native-panel-title" style="margin-top:0.35rem;">{membership.product_title}</h2>
                </div>
                <span class="native-pill {if membership.is_active}native-pill--success{else}native-pill--muted{/if}">{if membership.is_active}Active{else}{membership.status}{/if}</span>
            </div>
            <div class="native-summary-list" style="margin-top:1rem;">
                <div class="native-summary-row"><span>Started</span><strong>{if membership.starts_at}{membership.starts_at | date:'M j, Y'}{else}Pending{/if}</strong></div>
                <div class="native-summary-row"><span>Ends</span><strong>{if membership.ends_at}{membership.ends_at | date:'M j, Y'}{else}Open-ended{/if}</strong></div>
                <div class="native-summary-row"><span>Duration</span><strong>{membership.duration_days} days</strong></div>
            </div>
            {if membership.order_id}
            <div class="native-actions" style="margin-top:1rem; justify-content:flex-start;">
                <a href="{base_url}/ecommerce/my-orders/{membership.order_id}" class="button button-secondary">View Order</a>
            </div>
            {/if}
        </section>
        {/foreach}
    </div>
    {/if}
</div>
{/block}