{extends "_cms_active_theme/layouts/public.disyl"}

{block head}
{include "_cms_active_theme/public/ecommerce/partials/storefront-styles.disyl"}
{/block}

{block content}
<div
    class="native-storefront native-product-page"
    data-native-ecommerce-template="single-product"
    data-storefront-route-kind="{storefront.route.kind|default:public_route_kind|default:'generic'}"
    data-storefront-mode="{storefront.route.mode|default:public_presentation_mode|default:'traditional'}"
    data-storefront-page-kind="{storefront.page.kind|default:'detail'}"
    data-storefront-product-id="{storefront.product.id|default:product.id|default:''}"
>
    <nav class="native-breadcrumbs" aria-label="Breadcrumb">
        <ol>
            <li><a href="{base_url}/cms">Home</a></li>
            <li><span class="separator">/</span></li>
            <li><a href="{base_url}/ecommerce/shop">Shop</a></li>
            {if product.categories | count > 0}
            <li><span class="separator">/</span></li>
            <li><a href="{base_url}/ecommerce/shop/category/{product.categories.0.slug}">{product.categories.0.name}</a></li>
            {/if}
        </ol>
    </nav>

    <div class="native-product-layout">
        <section class="native-product-gallery">
            <div class="native-product-image">
                <img src="{if product.primary_image_url}{product.primary_image_url}{else}{base_url}/assets/ecommerce/product-placeholder.svg{/if}" alt="{product.title}">
            </div>

            {if product.gallery_images | count > 0}
            <div class="native-product-thumbs">
                {foreach product.gallery_images as image}
                <a href="{image.url}" class="native-thumb-link" target="_blank" rel="noopener noreferrer">
                    <img src="{image.thumb}" alt="{if image.caption}{image.caption}{else}{product.title}{/if}">
                </a>
                {/foreach}
            </div>
            {/if}

            {if product.body}
            <div class="native-storefront-panel">
                <h2 class="native-panel-title">Product Details</h2>
                <div class="prose">{product.body | raw}</div>
            </div>
            {/if}
        </section>

        <aside class="native-storefront-panel native-product-summary">
            <p class="native-storefront-kicker">Catalog Detail</p>
            <h1 class="native-product-title">{product.title}</h1>

            <div class="native-product-price native-price-row">
                <span class="native-price-current">{product.pricing.formatted | default:'Contact for price'}</span>
                {if product.pricing.on_sale}
                <span class="native-price-compare">{product.pricing.regular_fmt}</span>
                <span class="native-pill native-pill--sale">Sale</span>
                {/if}
            </div>

            {if product.excerpt}
            <p class="native-storefront-subtitle">{product.excerpt}</p>
            {/if}

            {if product.product_type == 'subscription'}
            <div class="native-note" style="background:#fffbeb;border:1px solid #fcd34d;color:#92400e;padding:0.9rem 1rem;border-radius:0.9rem;">
                <strong>Subscription product.</strong><br>
                {product.subscription_summary.recurring_label}
                {if product.subscription_summary.trial_label}<br>{product.subscription_summary.trial_label}{/if}
                <br>Subscriptions must be purchased separately from one-time products.
            </div>
            {/if}

            {if product.product_type == 'membership'}
            <div class="native-note" style="background:#ecfdf5;border:1px solid #86efac;color:#166534;padding:0.9rem 1rem;border-radius:0.9rem;">
                <strong>Membership product.</strong><br>
                Activates the {product.membership_summary.tier_label | default:'member'} tier for {product.membership_summary.duration_label | default:'365 days access'} after payment.
            </div>
            {/if}

            {if product.membership_gate.requires_membership and !product.membership_gate.allowed}
            <div class="native-note" style="background:#eff6ff;border:1px solid #93c5fd;color:#1d4ed8;padding:0.9rem 1rem;border-radius:0.9rem;">
                <strong>Members-only access.</strong><br>
                {product.membership_gate.message}<br>
                <a href="{if product.membership_gate.login_required}{base_url}/cms/login?redirect=/ecommerce/shop/{product.slug}{else}{base_url}/ecommerce/my-memberships{/if}" class="button button-primary" style="margin-top:0.75rem;">{if product.membership_gate.login_required}Sign In to Unlock{else}View My Memberships{/if}</a>
            </div>
            {/if}

            <div class="native-stack" style="margin-top:1rem;">
                {if product.bundle_children | count > 0}
                    {if product.bundle_summary.all_in_stock}
                    <div class="native-pill native-pill--success">Bundle includes {product.bundle_summary.item_count} item{if product.bundle_summary.item_count == 1}{else}s{/if}</div>
                    {else}
                    <div class="native-pill native-pill--danger">One or more bundle items are unavailable</div>
                    {/if}
                {elseif product.inventory.track_stock}
                    {if product.inventory.out_of_stock or not product.inventory.in_stock}
                    <div class="native-pill native-pill--danger">Out of stock</div>
                    {elseif product.inventory.low_stock}
                    <div class="native-pill native-pill--warning">Low stock - only {product.inventory.stock_qty} left</div>
                    {else}
                    <div class="native-pill native-pill--success">In stock{if product.inventory.stock_qty} - {product.inventory.stock_qty} available{/if}</div>
                    {/if}
                {/if}

                {if product.inventory.sku}
                <div class="native-key-value"><strong>SKU:</strong> <span class="native-muted">{product.inventory.sku}</span></div>
                {/if}

                {if product.categories | count > 0}
                <div class="native-key-value"><strong>Filed under:</strong>
                    <span class="native-muted">{foreach product.categories as cat}{cat.name}{if !loop.last}, {/if}{/foreach}</span>
                </div>
                {/if}
            </div>

            {if !product.is_external_product && (!product.membership_gate.requires_membership || product.membership_gate.allowed) && product.bundle_children | count == 0 && product.grouped_children | count == 0}
                {if product.addons | count > 0}
            <div class="native-stack">
                <div>
                    <h2 class="native-panel-title">Add-ons</h2>
                    <p class="native-note">Optional extras that are added to the line item total.</p>
                </div>
                {foreach product.addons as addon}
                <label class="native-key-value" style="align-items:flex-start; gap:0.85rem;">
                    <input type="checkbox" value="{addon.id}" data-product-addon>
                    <div style="flex:1 1 auto; min-width:0;">
                        <div><strong>{addon.label}</strong></div>
                        {if addon.description}<div class="native-muted">{addon.description}</div>{/if}
                    </div>
                    <div><strong>+{ec_settings.currency_symbol}{addon.price}</strong></div>
                </label>
                {/foreach}
            </div>
                {/if}
                {if product.booking.enabled}
            <div class="native-stack">
                <div>
                    <h2 class="native-panel-title">Book Appointment</h2>
                    <p class="native-note">{product.booking.summary}</p>
                </div>
                <div class="native-form-columns">
                    <div class="native-field">
                        <label for="booking-date">Date</label>
                        <input id="booking-date" type="date" data-booking-date class="native-input">
                    </div>
                    <div class="native-field">
                        <label for="booking-time">Time</label>
                        <select id="booking-time" data-booking-time class="native-input">
                            <option value="">Select a time</option>
                            {foreach product.booking.time_slots as slot}
                            <option value="{slot}">{slot}</option>
                            {/foreach}
                        </select>
                    </div>
                    <div class="native-field" style="grid-column:1 / -1;">
                        <label for="booking-notes">Appointment Notes</label>
                        <textarea id="booking-notes" data-booking-notes rows="2" class="native-textarea" placeholder="Share anything needed before the appointment."></textarea>
                    </div>
                </div>
            </div>
                {/if}
            {/if}

            {if product.is_external_product and product.external_product_url}
            <div class="native-stack">
                <div class="native-note">This product is purchased through an external checkout partner.</div>
                <a href="{product.external_product_url}" target="_blank" rel="noopener noreferrer sponsored" class="button button-primary">{product.external_product_button_text | default:'Buy Externally'}</a>
            </div>
            {elseif product.bundle_children | count > 0}
            <div class="native-stack" id="bundle-products-form">
                <div>
                    <h2 class="native-panel-title">Bundle Includes</h2>
                    <p class="native-note">Fixed quantities are added together as a single bundle purchase.</p>
                </div>
                {foreach product.bundle_children as child}
                <div class="native-key-value" style="align-items:center; gap:0.85rem;">
                    <div style="flex:1 1 auto; min-width:0;">
                        <div><strong>{child.title}</strong></div>
                        <div class="native-muted">Qty {child.bundle_qty} · {child.pricing.formatted | default:'Contact for price'} · {if child.inventory.low_stock}Low stock{elseif child.inventory.in_stock}In stock{else}Out of stock{/if}</div>
                    </div>
                </div>
                {/foreach}
                <div class="native-note">
                    Included items: {product.bundle_summary.child_subtotal_fmt}<br>
                    Bundle total: {product.bundle_summary.bundle_total_fmt | default:product.pricing.formatted}
                    {if product.bundle_summary.has_savings}<br>You save: {product.bundle_summary.savings_fmt}{/if}
                </div>
                <div class="native-inline-actions">
                    <input type="number" value="1" min="1" class="native-input native-qty-input" data-bundle-qty-input>
                    {if product.bundle_summary.all_in_stock}
                    <button onclick="addBundleToCart({product.id}, event)" class="button button-primary" type="button">Add Bundle to Cart</button>
                    {else}
                    <button class="button button-secondary" type="button" disabled>Bundle Unavailable</button>
                    {/if}
                </div>
            </div>
            {elseif product.grouped_children | count > 0}
            <div class="native-stack" id="grouped-products-form">
                <div>
                    <h2 class="native-panel-title">Grouped Products</h2>
                    <p class="native-note">Adjust child quantities and add them to the cart as individual items.</p>
                </div>
                {foreach product.grouped_children as child}
                <div class="native-key-value" data-grouped-child-row data-product-id="{child.id}" style="align-items:center; gap:0.85rem;">
                    <div style="flex:1 1 auto; min-width:0;">
                        <div><strong>{child.title}</strong></div>
                        <div class="native-muted">{child.pricing.formatted | default:'Contact for price'} · {if child.inventory.low_stock}Low stock{elseif child.inventory.in_stock}In stock{else}Out of stock{/if}</div>
                    </div>
                    <input type="number" value="{child.grouped_qty}" min="0" class="native-input native-qty-input" data-grouped-child-qty>
                </div>
                {/foreach}
                <button onclick="addGroupedToCart({product.id}, event)" class="button button-primary" type="button">Add Selected Items</button>
            </div>
            {elseif product.membership_gate.requires_membership and !product.membership_gate.allowed}
            <div class="native-actions">
                <button type="button" class="button button-secondary" disabled>Membership Required</button>
            </div>
            {elseif product.inventory.in_stock && !product.inventory.out_of_stock}
            {if product.product_type == 'subscription'}
            <div class="native-actions">
                <button onclick="addToCart({product.id}, 1, event)" class="button button-primary" type="button">Start Subscription</button>
            </div>
            {else}
            <div class="native-inline-actions">
                <input type="number" id="qty-input" value="1" min="1" {if product.inventory.track_stock}max="{product.inventory.stock_qty}"{/if} class="native-input native-qty-input">
                <button onclick="addToCart({product.id}, document.getElementById('qty-input').value, event)" class="button button-primary" type="button">Add to Cart</button>
            </div>
            {/if}
            {else}
            <div class="native-actions">
                <button type="button" class="button button-secondary" disabled>Currently unavailable</button>
            </div>
            {/if}

            {if not product.is_external_product}
            <div class="native-actions">
                <a href="{base_url}/ecommerce/cart" class="button button-secondary" id="view-cart-card">View Cart (<span id="view-cart-card-count">{storefront.cart.count|default:cart_count|default:0}</span>)</a>
            </div>
            {/if}

            {include "modules/cms/public/blocks/ecommerce-product-wishlist.block.disyl"}
            {include "modules/cms/public/blocks/ecommerce-product-compare.block.disyl"}
        </aside>
    </div>

    {include "modules/cms/public/blocks/ecommerce-recently-viewed.block.disyl"}
</div>

<script>
const __ecCsrf = '{csrf_token}';
const __ecProductTitle = '{storefront.product.title|default:product.title}';
const __ecProductImage = '{storefront.product.primary_image_url|default:product.primary_image_url}';
const __ecProductPrice = '{storefront.product.pricing.formatted|default:product.pricing.formatted}';
const __ecBaseUrl = '{base_url}';
function updateCartBadge(count) {
    const badge = document.getElementById('cart-count-badge');
    const cardCount = document.getElementById('view-cart-card-count');
    const nextCount = Number(count || 0);

    if (badge) {
        if (nextCount > 0) {
            badge.textContent = String(nextCount);
            badge.classList.remove('hidden');
            badge.classList.add('inline-flex');
        } else {
            badge.textContent = '0';
            badge.classList.add('hidden');
            badge.classList.remove('inline-flex');
        }
    }

    if (cardCount) {
        cardCount.textContent = String(nextCount);
    }
}

function collectProductPurchaseOptions() {
    const addOns = Array.from(document.querySelectorAll('[data-product-addon]:checked')).map((input) => input.value);
    const bookingDate = document.querySelector('[data-booking-date]');
    const bookingTime = document.querySelector('[data-booking-time]');
    const bookingNotes = document.querySelector('[data-booking-notes]');

    return {
        add_ons: addOns,
        booking: {
            date: bookingDate ? bookingDate.value : '',
            time: bookingTime ? bookingTime.value : '',
            notes: bookingNotes ? bookingNotes.value : '',
        },
    };
}

async function addToCart(productId, qty, clickEvent) {
    const btn = clickEvent && clickEvent.currentTarget ? clickEvent.currentTarget : null;
    if (!btn) {
        return;
    }

    btn.disabled = true;
    btn.textContent = 'Adding...';
    const options = collectProductPurchaseOptions();

    try {
        const res = await fetch('{base_url}/api/v1/ecommerce/cart/add', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-TOKEN': __ecCsrf},
            body: JSON.stringify({ _token: __ecCsrf, product_id: productId, qty: parseInt(qty, 10) || 1, add_ons: options.add_ons, booking: options.booking }),
        });
        const data = await res.json();
        if (data.ok) {
            showCartPanel(data);
            btn.textContent = 'Added';
            setTimeout(() => {
                btn.disabled = false;
                btn.textContent = 'Add to Cart';
            }, 1600);
        } else {
            alert(data.error || 'Could not add this product to the cart.');
            btn.disabled = false;
            btn.textContent = 'Add to Cart';
        }
    } catch (error) {
        alert('Error. Please try again.');
        btn.disabled = false;
        btn.textContent = 'Add to Cart';
    }
}

async function addBundleToCart(productId, clickEvent) {
    const btn = clickEvent && clickEvent.currentTarget ? clickEvent.currentTarget : null;
    if (!btn) {
        return;
    }

    const qtyInput = document.querySelector('[data-bundle-qty-input]');
    const qty = qtyInput ? parseInt(qtyInput.value || '1', 10) : 1;

    btn.disabled = true;
    btn.textContent = 'Adding...';

    try {
        const res = await fetch('{base_url}/api/v1/ecommerce/cart/add', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-TOKEN': __ecCsrf},
            body: JSON.stringify({ _token: __ecCsrf, product_id: productId, qty: qty > 0 ? qty : 1 }),
        });
        const data = await res.json();
        if (data.ok) {
            showCartPanel(data);
            btn.textContent = 'Added';
            setTimeout(() => {
                btn.disabled = false;
                btn.textContent = 'Add Bundle to Cart';
            }, 1600);
        } else {
            alert(data.error || 'Could not add this bundle to the cart.');
            btn.disabled = false;
            btn.textContent = 'Add Bundle to Cart';
        }
    } catch (error) {
        alert('Error. Please try again.');
        btn.disabled = false;
        btn.textContent = 'Add Bundle to Cart';
    }
}

async function addGroupedToCart(parentProductId, clickEvent) {
    const btn = clickEvent && clickEvent.currentTarget ? clickEvent.currentTarget : null;
    if (!btn) {
        return;
    }

    const rows = Array.from(document.querySelectorAll('[data-grouped-child-row]'));
    const groupedItems = rows.map((row) => ({
        product_id: parseInt(row.getAttribute('data-product-id') || '0', 10),
        qty: parseInt((row.querySelector('[data-grouped-child-qty]') || {}).value || '0', 10),
    })).filter((item) => item.product_id > 0 && item.qty > 0);

    if (groupedItems.length === 0) {
        alert('Select at least one grouped product quantity.');
        return;
    }

    btn.disabled = true;
    btn.textContent = 'Adding...';

    try {
        const res = await fetch('{base_url}/api/v1/ecommerce/cart/add', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-TOKEN': __ecCsrf},
            body: JSON.stringify({ _token: __ecCsrf, grouped_parent_id: parentProductId, grouped_items: groupedItems }),
        });
        const data = await res.json();
        if (data.ok) {
            showCartPanel(data);
            btn.textContent = 'Added';
            setTimeout(() => {
                btn.disabled = false;
                btn.textContent = 'Add Selected Items';
            }, 1600);
        } else {
            alert(data.error || 'Could not add these grouped products to the cart.');
            btn.disabled = false;
            btn.textContent = 'Add Selected Items';
        }
    } catch (error) {
        alert('Error. Please try again.');
        btn.disabled = false;
        btn.textContent = 'Add Selected Items';
    }
}

let __ecCartPanelEl = null;
let __ecCartPanelTimer = null;
function __ecBuildCartPanel() {
    if (__ecCartPanelEl) return;
    const el = document.createElement('div');
    el.id = 'ec-cart-panel-overlay';
    el.style.cssText = 'position:fixed;inset:0;z-index:9999;display:flex;align-items:flex-start;justify-content:flex-end;padding:1rem;pointer-events:none;';
    el.innerHTML = `
        <div id="ec-cart-panel" style="background:#fff;border-radius:20px;box-shadow:0 24px 48px rgba(15,23,42,0.18);width:100%;max-width:380px;pointer-events:auto;transform:translateX(110%);transition:transform 0.28s cubic-bezier(0.22,1,0.36,1);overflow:hidden;">
            <div style="padding:1.1rem 1.1rem 0;display:flex;align-items:center;justify-content:space-between;gap:0.75rem;">
                <div style="display:flex;align-items:center;gap:0.55rem;">
                    <svg style="width:18px;height:18px;color:#16a34a;" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
                    <span style="font-size:0.82rem;font-weight:700;color:#16a34a;letter-spacing:0.02em;">Added to cart</span>
                </div>
                <button onclick="__ecDismissCartPanel()" aria-label="Close" style="background:none;border:none;cursor:pointer;padding:0.25rem;color:#94a3b8;">
                    <svg style="width:18px;height:18px;" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div style="padding:1rem 1.1rem;display:flex;gap:0.85rem;align-items:center;border-bottom:1px solid #f1f5f9;">
                <div style="width:72px;min-width:72px;height:72px;border-radius:12px;overflow:hidden;background:#f8fafc;">
                    <img id="ec-cart-panel-img-el" src="" alt="" style="width:100%;height:100%;object-fit:cover;display:block;">
                </div>
                <div style="min-width:0;flex:1;">
                    <p id="ec-cart-panel-title" style="margin:0 0 0.3rem;font-size:0.92rem;font-weight:700;color:#111827;line-height:1.3;"></p>
                    <p id="ec-cart-panel-price" style="margin:0;font-size:0.88rem;font-weight:600;color:#ea580c;"></p>
                </div>
            </div>
            <div style="padding:0.75rem 1.1rem;background:#f8fafc;display:flex;align-items:center;justify-content:space-between;">
                <span id="ec-cart-panel-summary" style="font-size:0.82rem;color:#64748b;"></span>
                <span id="ec-cart-panel-total" style="font-size:0.9rem;font-weight:700;color:#111827;"></span>
            </div>
            <div style="padding:0.9rem 1.1rem 1.1rem;display:flex;flex-direction:column;gap:0.6rem;">
                <a id="ec-cart-panel-checkout-btn" href="" style="display:block;text-align:center;padding:0.7rem 1rem;border-radius:999px;background:#0f172a;color:#fff;font-size:0.9rem;font-weight:700;text-decoration:none;">Proceed to Checkout</a>
                <a id="ec-cart-panel-cart-btn" href="" style="display:block;text-align:center;padding:0.65rem 1rem;border-radius:999px;border:1.5px solid #e2e8f0;background:#fff;color:#334155;font-size:0.86rem;font-weight:600;text-decoration:none;">View Cart</a>
                <button onclick="__ecDismissCartPanel()" style="background:none;border:none;cursor:pointer;color:#94a3b8;font-size:0.8rem;padding:0.15rem;text-decoration:underline;">Continue Shopping</button>
            </div>
        </div>`;
    document.body.appendChild(el);
    __ecCartPanelEl = el;
    document.getElementById('ec-cart-panel-checkout-btn').href = __ecBaseUrl + '/ecommerce/checkout';
    document.getElementById('ec-cart-panel-cart-btn').href = __ecBaseUrl + '/ecommerce/cart';
}
function showCartPanel(data) {
    __ecBuildCartPanel();
    const panel = document.getElementById('ec-cart-panel');
    const totals = (data && data.cart && data.cart.totals) ? data.cart.totals : {};
    const count = totals.item_count || 0;
    document.getElementById('ec-cart-panel-title').textContent = __ecProductTitle || 'Item';
    const imgEl = document.getElementById('ec-cart-panel-img-el');
    imgEl.src = __ecProductImage || '';
    imgEl.style.display = __ecProductImage ? 'block' : 'none';
    document.getElementById('ec-cart-panel-price').textContent = __ecProductPrice || '';
    document.getElementById('ec-cart-panel-summary').textContent = count + ' item' + (count === 1 ? '' : 's') + ' in cart';
    document.getElementById('ec-cart-panel-total').textContent = totals.total_fmt || '';
    updateCartBadge(count);
    __ecCartPanelEl.style.pointerEvents = 'auto';
    requestAnimationFrame(() => { panel.style.transform = 'translateX(0)'; });
    clearTimeout(__ecCartPanelTimer);
    __ecCartPanelTimer = setTimeout(__ecDismissCartPanel, 6000);
}
function __ecDismissCartPanel() {
    clearTimeout(__ecCartPanelTimer);
    if (!__ecCartPanelEl) return;
    const panel = document.getElementById('ec-cart-panel');
    if (panel) panel.style.transform = 'translateX(110%)';
    __ecCartPanelEl.style.pointerEvents = 'none';
}
</script>
{/block}