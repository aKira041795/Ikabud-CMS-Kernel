{extends "_cms_active_theme/layouts/public.disyl"}

{block content}
<div style="text-align: center; margin-bottom: 3rem;">
    <p style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-primary); margin-bottom: 0.25rem;">{archive_type}</p>
    <h1>{archive_name}</h1>
    {if archive_desc}
    <p style="color: var(--color-text-light); max-width: 32rem; margin: 0.5rem auto 0;">{archive_desc}</p>
    {/if}
</div>

{if posts | count == 0}
<div style="text-align: center; padding: 4rem 0; color: var(--color-text-light);">
    <p style="font-size: 1.125rem;">No posts found.</p>
    <p>There are no posts in this {archive_type} yet.</p>
</div>
{/if}

<div class="cms-blog-listing">
    {foreach posts as post}
    <article class="cms-blog-card ikb-card" style="border: 1px solid var(--color-border);">
        <div style="padding: 1.5rem;">
            <h2 class="ikb-card-title" style="font-size: 1.25rem;">
                <a href="{base_url}/cms/blog/{post.slug}">{post.title}</a>
            </h2>
            <div class="card-meta" style="margin-bottom: 0.75rem;">
                {if theme_settings.blog_show_author}By {post.author_name} {/if}{if theme_settings.blog_show_date}&middot; {post.published_at}{/if}
            </div>
            {if theme_settings.blog_show_excerpt}
            <div class="card-excerpt">
                {post.excerpt}
            </div>
            {/if}
            {if theme_settings.blog_show_readmore}
            <a href="{base_url}/cms/blog/{post.slug}" style="display: inline-block; margin-top: 1rem; font-weight: 500; font-size: 0.9rem;">{theme_settings.blog_readmore_text|default:"Read more &rarr;"}</a>
            {/if}
        </div>
    </article>
    {/foreach}
</div>

{if total_pages > 1}
<nav class="native-pagination">
    <ul>
        {if page_num > 1}
        <li><a href="?page=1">&laquo; First</a></li>
        {/if}
        <li class="current"><span>Page {page_num} of {total_pages}</span></li>
        {if page_num < total_pages}
        <li><a href="?page={next_page}">Next &raquo;</a></li>
        {/if}
    </ul>
</nav>
{/if}
{/block}
