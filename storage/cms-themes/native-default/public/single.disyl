{extends "_cms_active_theme/layouts/public.disyl"}

{block head}
{if cms_head}{cms_head | raw}{/if}
{if structured_data}{structured_data | raw}{/if}
{/block}

{block content}
{if builder_enabled}
<article class="{builder_page_settings.container_class}" style="width: 100%;">
    {post_html | raw}
</article>
{else}
<article class="cms-single-prose">
    <header class="post-header">
        <h1 class="post-title">{post.title}</h1>
        <div class="post-meta">
            {if theme_settings.single_show_author}<span>By {post.author_name}</span>{/if}
            {if theme_settings.single_show_date}<span>&middot; {post.published_at}</span>{/if}
        </div>
    </header>

    {if post.featured_image}
    <div class="post-featured-image">
        <img src="/assets/modules/cms/uploads/{post.featured_image}" alt="{post.title}">
    </div>
    {/if}

    <div class="post-content prose">
        {post_html | raw}
    </div>

    {if theme_settings.single_show_categories && post_categories | count > 0}
    <div class="post-categories" style="margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
        <span style="font-size: 0.8rem; font-weight: 600; color: var(--color-text-light);">Categories:</span>
        {foreach post_categories as cat}
        <a href="{base_url}/cms/category/{cat.slug}" style="display: inline-block; padding: 0.2rem 0.6rem; font-size: 0.75rem; font-weight: 500; background: var(--color-primary-light, #dbeafe); color: var(--color-primary, #2563eb); border-radius: 4px; text-decoration: none;">{cat.name}</a>
        {/foreach}
    </div>
    {/if}

    {if theme_settings.single_show_tags && post_tags | count > 0}
    <div class="post-tags" style="margin-top: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
        <span style="font-size: 0.8rem; font-weight: 600; color: var(--color-text-light);">Tags:</span>
        {foreach post_tags as tag}
        <span style="display: inline-block; padding: 0.2rem 0.6rem; font-size: 0.75rem; background: #f3f4f6; color: #6b7280; border-radius: 4px;">#{tag}</span>
        {/foreach}
    </div>
    {/if}

    {if theme_settings.single_show_nav}
    <div style="margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border);">
        <a href="{base_url}/cms/blog" style="font-weight: 500; font-size: 0.9rem;">&larr; Back to blog</a>
    </div>
    {/if}
</article>
{/if}
{/block}
