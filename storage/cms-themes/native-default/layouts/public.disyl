<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title}</title>
    {if theme_style_url}<link rel="stylesheet" href="{theme_style_url}">{/if}
    {# ── Default variable guards (matching ARK theme pattern) ── #}
    {set has_customized_header = has_customized_header|default:false}
    {set customized_header = customized_header|default:''}
    {set has_customized_footer = has_customized_footer|default:false}
    {set customized_footer = customized_footer|default:''}
    {set has_customized_sidebar = has_customized_sidebar|default:false}
    {set customized_sidebar = customized_sidebar|default:''}
    {set force_customized_sidebar = force_customized_sidebar|default:false}
    {set cms_global_sidebar_force = cms_global_sidebar_force|default:false}
    {set sidebar_position = sidebar_position|default:'right'}
    {set sidebar_width = sidebar_width|default:'300'}
    {set builder_enabled = builder_enabled|default:false}
    {set show_header = show_header|default:true}
    {set show_footer = show_footer|default:true}
    {if theme_style_url}<link rel="stylesheet" href="{theme_style_url}">{/if}
    {if colors_style}{colors_style|raw}{/if}
    {if theme_layout_style}{theme_layout_style|raw}{/if}
    {if storefront_theme_css}{storefront_theme_css|raw}{/if}
    {if custom_css}{custom_css|raw}{/if}
    {if head_code}{head_code|raw}{/if}
    <style>
        .prose h2 { margin: 2rem 0 0.75rem; font-size: 1.4rem; font-weight: 700; }
        .prose h3 { margin: 1.5rem 0 0.5rem; font-size: 1.15rem; font-weight: 600; }
        .prose p { margin: 0 0 1rem; }
        .prose img { max-width: 100%; border-radius: 0.5rem; margin: 1rem 0; }
        .prose img[style*="float: left"], .prose img[style*="float:left"], .prose img.alignleft { float: left; margin: 0 1rem 0 0; max-width: 50%; }
        .prose img[style*="float: right"], .prose img[style*="float:right"], .prose img.alignright { float: right; margin: 0 0 0 1rem; max-width: 50%; }
        .prose img.aligncenter { display: block; margin-left: auto; margin-right: auto; }
        .cms-lightbox-image { cursor: zoom-in; }
        .cms-lightbox-image:focus-visible { outline: 3px solid var(--color-primary, #0ea5e9); outline-offset: 4px; }
        .cms-lightbox-backdrop { position: fixed; inset: 0; z-index: 99999; background: rgba(15, 23, 42, 0.94); cursor: zoom-out; backdrop-filter: blur(8px); }
        .cms-lightbox-stage { min-height: 100%; display: flex; align-items: center; justify-content: center; padding: clamp(0.75rem, 3vw, 1.5rem); box-sizing: border-box; }
        .cms-lightbox-figure { position: relative; width: min(100%, 1200px); max-height: 100%; margin: 0; cursor: default; }
        .cms-lightbox-figure img { display: block; max-width: 100%; max-height: calc(100vh - 5rem); margin: 0 auto; object-fit: contain; border-radius: 0.75rem; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.45); }
        .cms-lightbox-hover-hint { position: fixed; z-index: 99998; padding: 0.4rem 0.7rem; border-radius: 999px; background: rgba(15, 23, 42, 0.88); color: #fff; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.01em; pointer-events: none; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.22); white-space: nowrap; transform: translateY(0); transition: opacity 0.14s ease, transform 0.14s ease; }
        .cms-lightbox-caption { margin-top: 0.75rem; color: rgba(255,255,255,0.84); text-align: center; font-size: 0.95rem; line-height: 1.5; }
        .prose blockquote { border-left: 4px solid var(--color-primary); padding: 0.5rem 1rem; margin: 1rem 0; background: var(--color-light-bg); border-radius: 0 0.5rem 0.5rem 0; }
        .prose pre { background: #1e293b; color: #e2e8f0; padding: 1rem; border-radius: 0.5rem; overflow-x: auto; font-size: 0.875rem; }
        .prose code { background: var(--color-light-bg); padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.9em; }
        .prose pre code { background: none; padding: 0; }
        .prose ul, .prose ol { padding-left: 1.5rem; margin: 0 0 1rem; }
        .prose li { margin-bottom: 0.4rem; }
        .prose a { color: var(--color-primary); text-decoration: underline; }
        .cms-btn-wrap { margin: 1.25rem 0; }
        .cms-btn { display: inline-block; padding: 0.625rem 1.5rem; border-radius: var(--radius-md); font-weight: 600; font-size: 0.9rem; text-decoration: none !important; transition: all 0.15s; }
        .cms-btn-primary { background: var(--color-primary); color: #fff; }
        .cms-btn-primary:hover { opacity: 0.9; }
        .cms-btn-outline { border: 2px solid var(--color-primary); color: var(--color-primary); background: transparent; }
        .cms-btn-outline:hover { background: var(--color-light-bg); }
        .cms-section { width: 100%; }
        .cms-section-inner { box-sizing: border-box; }
        .cms-columns { margin: 1.25rem 0; }
        .cms-column { min-width: 0; }
        .cms-gallery { display: grid; gap: 0.5rem; margin: 1.25rem 0; }
        .cms-gallery-cols-2 { grid-template-columns: repeat(2, 1fr); }
        .cms-gallery-cols-3 { grid-template-columns: repeat(3, 1fr); }
        .cms-gallery-cols-4 { grid-template-columns: repeat(4, 1fr); }
        .cms-gallery-item img { width: 100%; height: 200px; object-fit: cover; border-radius: var(--radius-md); }
        .cms-embed { margin: 1.25rem 0; }
        .cms-embed-responsive { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: var(--radius-md); }
        .cms-embed-responsive iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }
        .cms-spacer { }
        .cms-separator { border: none; border-top: 2px solid var(--color-border); margin: 1.5rem 0; }
        .cms-nav .cms-menu { list-style: none; display: flex; gap: 1rem; padding: 0; margin: 0; }
        .cms-nav .cms-menu a { color: var(--color-text); text-decoration: none; font-size: 0.875rem; }
        .cms-nav .cms-menu a:hover { color: var(--color-primary); }
        .cms-content-with-sidebar { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, var(--sidebar-width, 300px)); gap: 2rem; align-items: start; margin-top: 25px; }
        .cms-content-with-sidebar.sidebar-left { grid-template-columns: minmax(220px, var(--sidebar-width, 300px)) minmax(0, 1fr); }
        .cms-content-with-sidebar .cms-main-slot { min-width: 0; }
        .cms-content-with-sidebar .cms-sidebar-slot { min-width: 0; }
        .ec-customer-banner { margin: 1.5rem 0 0; padding: 1rem 1.25rem; border: 1px solid #fed7aa; border-radius: 1rem; background: linear-gradient(135deg, #fff7ed 0%, #ffffff 60%, #f8fafc 100%); box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06); }
        .ec-customer-banner__eyebrow { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #c2410c; }
        .ec-customer-banner__title { margin: 0.35rem 0 0; font-size: 1.15rem; font-weight: 700; color: #111827; }
        .ec-customer-banner__meta { margin: 0.35rem 0 0; font-size: 0.95rem; color: #475569; }
        .ec-customer-banner__meta strong { color: #0f172a; }
        .ec-customer-banner__row { display: flex; gap: 1rem; align-items: center; justify-content: space-between; }
        .ec-customer-banner__actions { display: flex; flex-wrap: wrap; gap: 0.65rem; }
        .ec-customer-banner__primary,
        .ec-customer-banner__secondary { display: inline-flex; align-items: center; justify-content: center; padding: 0.7rem 1rem; border-radius: 0.8rem; font-size: 0.9rem; font-weight: 600; text-decoration: none !important; }
        .ec-customer-banner__primary { background: #ea580c; color: #ffffff; }
        .ec-customer-banner__primary:hover { background: #c2410c; }
        .ec-customer-banner__secondary { border: 1px solid #cbd5e1; color: #334155; background: #ffffff; }
        .ec-customer-banner__secondary:hover { background: #f8fafc; }
        @media (max-width: 640px) {
            .cms-gallery-cols-3, .cms-gallery-cols-4 { grid-template-columns: repeat(2, 1fr); }
            .cms-columns-stack { grid-template-columns: 1fr !important; }
            .ec-customer-banner__row { flex-direction: column; align-items: flex-start; }
            .ec-customer-banner__actions { width: 100%; }
        }
        @media (max-width: 1024px) {
            .cms-content-with-sidebar,
            .cms-content-with-sidebar.sidebar-left { display: block; }
            .cms-content-with-sidebar .cms-sidebar-slot { margin-top: 1.5rem; }
        }
    </style>
    <noscript><style>body:not(.cz-loaded),[data-animate]{opacity:1!important;transform:none!important;}</style></noscript>
    {block head}{/block}
    <script defer src="https://unpkg.com/alpinejs@3.14.3/dist/cdn.min.js"></script>
</head>
<body class="native-theme {if builder_enabled && builder_page_settings.body_class}{builder_page_settings.body_class}{/if}">

    {if show_header|default:true}
    {if has_customized_header}
    {customized_header|raw}
    {else}
    <div class="header-wrapper header-wrapper--sticky">
        <header class="site-header site-header--sticky">
            <div class="container">
                <div class="header-inner">
                    <div class="site-branding">
                        <a href="{base_url}/cms" class="site-logo">{site_title|default:gui.app_name|default:"Blog"}</a>
                    </div>
                    {if ec_currency.selector_enabled}
                    <div style="display:flex; align-items:center; gap:0.5rem; margin-left:auto; margin-right:1rem;">
                        <label for="ec-native-currency-switcher" style="font-size:0.72rem; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:#64748b;">Currency</label>
                        <select id="ec-native-currency-switcher" style="border:1px solid #cbd5e1; border-radius:0.6rem; background:#fff; padding:0.45rem 0.65rem; font-size:0.8rem; font-weight:600; color:#334155;">
                            {foreach ec_currency.available as option}
                            <option value="{option.code}" {if option.is_current}selected{/if}>{option.code}</option>
                            {/foreach}
                        </select>
                    </div>
                    {/if}
                    <button class="mobile-menu-toggle" aria-label="Toggle menu">
                        <span></span><span></span><span></span>
                    </button>
                    <nav class="main-navigation">
                        {if primary_menu}
                        {primary_menu|raw}
                        {else}
                        <ul class="nav-menu">
                            <li><a href="{base_url}/cms">Home</a></li>
                            <li><a href="{base_url}/cms/blog">Blog</a></li>
                            <li><a href="{base_url}/cms/search">Search</a></li>
                        </ul>
                        {/if}
                    </nav>
                </div>
            </div>
        </header>
    </div>
    {/if}
    {/if}

    <div class="site-content">
        <div class="{if builder_enabled && !(has_customized_sidebar || force_customized_sidebar || cms_global_sidebar_force)}cms-builder-fullwidth{else}container{/if}">
            {if public_render_origin == 'ecommerce' && public_customer_is_logged_in}
            <div class="ec-customer-banner">
                <div class="ec-customer-banner__row">
                    <div>
                        <div class="ec-customer-banner__eyebrow">Signed In</div>
                        <h2 class="ec-customer-banner__title">Welcome back, {public_customer_display_name}</h2>
                        <p class="ec-customer-banner__meta">Shopping with <strong>{public_customer_email}</strong>. Your recent ecommerce activity stays linked to this account.</p>
                    </div>
                    <div class="ec-customer-banner__actions">
                        <a href="{if public_customer_wishlist_url}{public_customer_wishlist_url}{else}{base_url}/ecommerce/my-wishlist{/if}" class="ec-customer-banner__secondary">Wishlist{if wishlist_count|default:storefront.wishlist.count|default:0 > 0} ({wishlist_count|default:storefront.wishlist.count|default:0}){/if}</a>
                        <a href="{public_customer_orders_url}" class="ec-customer-banner__primary">My Orders</a>
                        {if public_customer_has_admin_access}
                        <a href="{public_customer_admin_url}" class="ec-customer-banner__secondary">CMS Admin</a>
                        {/if}
                        <a href="{base_url}/auth/logout?redirect=/ecommerce/shop" class="ec-customer-banner__secondary">Log Out</a>
                    </div>
                </div>
            </div>
            {/if}
            <div class="{if (has_customized_sidebar || force_customized_sidebar || cms_global_sidebar_force)}cms-content-with-sidebar {if sidebar_position == 'left'}sidebar-left{/if}{/if}"{if (has_customized_sidebar || force_customized_sidebar || cms_global_sidebar_force)} style="--sidebar-width:{sidebar_width|default:'300'}px;"{/if}>
                {if (has_customized_sidebar || force_customized_sidebar || cms_global_sidebar_force)}
                {if sidebar_position == 'left'}
                <aside class="cms-sidebar-slot">
                    {customized_sidebar|raw}
                </aside>
                {/if}
                {/if}
                <main id="main-content" class="cms-public-main site-main{if (has_customized_sidebar || force_customized_sidebar || cms_global_sidebar_force)} cms-main-slot{/if}" role="main">
                    {block content}{/block}
                </main>
                {if (has_customized_sidebar || force_customized_sidebar || cms_global_sidebar_force)}
                {if sidebar_position == 'left'}
                {else}
                <aside class="cms-sidebar-slot">
                    {customized_sidebar|raw}
                </aside>
                {/if}
                {/if}
            </div>
        </div>
    </div>

    {if show_footer|default:true}
    <footer class="site-footer">
        {if has_customized_footer}
        {customized_footer|raw}
        {else}
        <div class="container">
            {if social_links}
            <div class="footer-social" style="text-align:center; margin-bottom:1rem;">
                {foreach social_links as sl}
                <a href="{sl.url}" target="_blank" rel="noopener noreferrer" style="display:inline-block; margin:0 0.5rem; color:#64748b; font-size:0.85rem; text-decoration:none;">{sl.label}</a>
                {/foreach}
            </div>
            {/if}
            {if footer_menu}
            <div class="footer-nav" style="text-align:center; margin-bottom:1rem;">
                {footer_menu|raw}
            </div>
            {/if}
            <div class="footer-bottom">
                &copy; {current_year|default:"2025"} {site_title|default:gui.app_name|default:"Site"}. All rights reserved.
                <span style="margin-left: 0.5rem; opacity: 0.5;">·</span>
                <a href="{base_url}/cms/admin" style="color: #64748b; margin-left: 0.5rem; font-size: 0.8rem;">Admin</a>
            </div>
        </div>
        {/if}
    </footer>
    {/if}

    <script>
        (function () {
            function revealCmsContent() {
                if (document.body) {
                    document.body.classList.add('cz-loaded');
                }
                document.querySelectorAll('[data-animate]').forEach(function (el) {
                    el.classList.add('cms-animated');
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', revealCmsContent, { once: true });
            } else {
                revealCmsContent();
            }
        })();

        (function () {
            var switcher = document.getElementById('ec-native-currency-switcher');
            if (!switcher) {
                return;
            }

            switcher.addEventListener('change', function () {
                var url = new URL(window.location.href);
                url.searchParams.set('currency', switcher.value);
                window.location.href = url.toString();
            });
        })();
    </script>
    {if theme_script_url}<script src="{theme_script_url}" defer></script>{/if}
    {if builder_enabled}<script src="{base_url}/assets/cms/builder-public.js" defer></script>{/if}
    {if body_end_code}{body_end_code|raw}{/if}
        <div x-data="{
        lightboxModalSrc: null,
        lightboxModalAlt: '',
        lightboxModalCaption: '',
        previousBodyOverflow: '',
        previousDocumentOverflow: '',
        previousActiveElement: null,
        lightboxBackdropStyle: '',
        hoverHintVisible: false,
        hoverHintText: 'Zoom to enlarge',
        hoverHintStyle: '',
        eligibleSelector: '.prose img, [data-cms-lightbox=true]',
        isEligibleImage(img) {
            if (!(img instanceof HTMLImageElement)) {
                return false;
            }
            if (img.dataset.cmsLightbox === 'false') {
                return false;
            }
            if (img.closest('a, button, .not-prose')) {
                return false;
            }
            const closestRoleButton = img.closest('[role=button]');
            if (closestRoleButton && closestRoleButton !== img) {
                return false;
            }
            if (!img.closest('.prose, [data-cms-lightbox=true]')) {
                return false;
            }

            const renderedWidth = Math.round(img.getBoundingClientRect().width || img.width || 0);
            const naturalWidth = Math.round(img.naturalWidth || 0);
            const naturalHeight = Math.round(img.naturalHeight || 0);
            if (Math.max(renderedWidth, naturalWidth) < 120) {
                return false;
            }
            if (naturalWidth > 0 && naturalHeight > 0 && naturalWidth * naturalHeight < 20000) {
                return false;
            }

            return (img.currentSrc || img.src || '').trim() !== '';
        },
        resolveCaption(img) {
            const figure = img.closest('figure');
            if (figure) {
                const figcaption = figure.querySelector('figcaption');
                if (figcaption && figcaption.textContent) {
                    return figcaption.textContent.trim();
                }
            }
            return (img.getAttribute('title') || img.getAttribute('alt') || '').trim();
        },
        decorateImage(img) {
            if (!this.isEligibleImage(img)) {
                img.classList.remove('cms-lightbox-image');
                if (img.dataset.cmsLightboxDecorated === 'true') {
                    img.removeAttribute('tabindex');
                    img.removeAttribute('role');
                    img.removeAttribute('aria-haspopup');
                    delete img.dataset.cmsLightboxDecorated;
                }
                return;
            }

            img.classList.add('cms-lightbox-image');
            if (!img.hasAttribute('tabindex')) {
                img.setAttribute('tabindex', '0');
            }
            img.setAttribute('role', 'button');
            img.setAttribute('aria-haspopup', 'dialog');
            img.dataset.cmsLightboxDecorated = 'true';
        },
        syncEligibleImages() {
            document.querySelectorAll(this.eligibleSelector).forEach((img) => this.decorateImage(img));
        },
        resolveEventImage(event) {
            const path = typeof event.composedPath === 'function' ? event.composedPath() : [];
            for (const node of path) {
                if (node instanceof HTMLImageElement) {
                    return node;
                }
                if (node instanceof HTMLPictureElement) {
                    const nestedImage = node.querySelector('img');
                    if (nestedImage instanceof HTMLImageElement) {
                        return nestedImage;
                    }
                }
            }

            const target = event.target;
            if (target instanceof HTMLImageElement) {
                return target;
            }
            if (target instanceof HTMLPictureElement) {
                const nestedImage = target.querySelector('img');
                if (nestedImage instanceof HTMLImageElement) {
                    return nestedImage;
                }
            }

            return null;
        },
        updateHoverHintPosition(img) {
            const rect = img.getBoundingClientRect();
            const hintWidth = 144;
            const left = Math.max(12, Math.min(window.innerWidth - hintWidth - 12, rect.left + (rect.width / 2) - (hintWidth / 2)));
            const top = Math.max(12, rect.bottom - 42);
            this.hoverHintStyle = 'left:' + Math.round(left) + 'px;top:' + Math.round(top) + 'px;';
        },
        showHoverHint(img) {
            if (this.lightboxModalSrc || !this.isEligibleImage(img)) {
                return;
            }

            this.updateHoverHintPosition(img);
            this.hoverHintVisible = true;
        },
        hideHoverHint() {
            this.hoverHintVisible = false;
            this.hoverHintStyle = '';
        },
        syncLightboxViewport() {
            const viewport = window.visualViewport || null;
            const top = Math.round(window.scrollY + (viewport ? viewport.offsetTop : 0));
            const height = Math.round(viewport ? viewport.height : window.innerHeight);
            this.lightboxBackdropStyle = 'top:' + top + 'px; bottom:auto; height:' + height + 'px;';
        },
        openFromImage(img) {
            if (!this.isEligibleImage(img)) {
                return;
            }

            this.hideHoverHint();
            this.syncLightboxViewport();
            this.lightboxModalSrc = (img.currentSrc || img.src || '').trim();
            this.lightboxModalAlt = (img.getAttribute('alt') || '').trim();
            this.lightboxModalCaption = this.resolveCaption(img);
            this.previousActiveElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
            this.previousBodyOverflow = document.body.style.overflow || '';
            this.previousDocumentOverflow = document.documentElement.style.overflow || '';
            document.body.style.overflow = 'hidden';
            document.documentElement.style.overflow = 'hidden';

            this.$nextTick(() => {
                if (this.$refs.lightboxClose instanceof HTMLElement) {
                    this.$refs.lightboxClose.focus();
                }
            });
        },
        closeLightbox() {
            this.lightboxModalSrc = null;
            this.lightboxModalAlt = '';
            this.lightboxModalCaption = '';
            this.lightboxBackdropStyle = '';
            document.body.style.overflow = this.previousBodyOverflow;
            document.documentElement.style.overflow = this.previousDocumentOverflow;

            const activeElement = this.previousActiveElement;
            this.previousActiveElement = null;
            this.$nextTick(() => {
                if (activeElement instanceof HTMLElement) {
                    activeElement.focus();
                }
            });
        },
        init() {
            const syncEligibleImages = () => this.syncEligibleImages();

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', syncEligibleImages, { once: true });
            } else {
                syncEligibleImages();
            }
            window.addEventListener('load', syncEligibleImages, { once: true });

            window.addEventListener('click', (event) => {
                const img = this.resolveEventImage(event);
                if (!img || !this.isEligibleImage(img)) {
                    return;
                }

                event.preventDefault();
                this.openFromImage(img);
            });

            window.addEventListener('keydown', (event) => {
                if (event.key !== 'Enter' && event.key !== ' ') {
                    return;
                }
                const img = this.resolveEventImage(event);
                if (!img || !this.isEligibleImage(img)) {
                    return;
                }

                event.preventDefault();
                this.openFromImage(img);
            });

            window.addEventListener('mouseover', (event) => {
                const img = this.resolveEventImage(event);
                if (!img || !this.isEligibleImage(img)) {
                    return;
                }

                this.showHoverHint(img);
            });

            window.addEventListener('mousemove', (event) => {
                const img = this.resolveEventImage(event);
                if (!img || !this.isEligibleImage(img)) {
                    return;
                }

                this.showHoverHint(img);
            });

            window.addEventListener('mouseout', (event) => {
                const img = this.resolveEventImage(event);
                if (!img || !this.isEligibleImage(img)) {
                    return;
                }

                this.hideHoverHint();
            });

            window.addEventListener('scroll', () => this.hideHoverHint(), { passive: true });
            window.addEventListener('resize', () => {
                if (this.lightboxModalSrc) {
                    this.syncLightboxViewport();
                }
            }, { passive: true });
        }
    }">
           <template x-teleport="body">
              <div x-show="hoverHintVisible && !lightboxModalSrc"
                  class="cms-lightbox-hover-hint"
                  style="display: none;"
                  x-transition.opacity.duration.100ms
                  :style="hoverHintStyle"
                  x-text="hoverHintText"></div>
           </template>
           <template x-teleport="body">
            <div x-show="lightboxModalSrc"
                 class="cms-lightbox-backdrop"
                 style="display: none;"
                  :style="lightboxBackdropStyle"
                 x-transition.opacity.duration.200ms
                 @click="closeLightbox()"
                 @keydown.escape.window="closeLightbox()"
                 role="dialog"
                 aria-modal="true"
                 :aria-label="lightboxModalAlt || 'Expanded image preview'">

                     <div class="cms-lightbox-stage">
                     <figure class="cms-lightbox-figure" @click.stop>
                     <button x-ref="lightboxClose" type="button" style="position: absolute; top: 1rem; right: 1rem; padding: 0.5rem; color: rgba(255,255,255,0.7); background: transparent; border: none; cursor: pointer; z-index: 10;" @click="closeLightbox()" onmouseover="this.style.color='white'" onmouseout="this.style.color='rgba(255,255,255,0.7)'" aria-label="Close image preview">
                         <svg style="width: 2rem; height: 2rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                     </button>

                     <img :src="lightboxModalSrc" :alt="lightboxModalAlt" @click.stop style="cursor: default; transition: transform 0.2s;" :style="lightboxModalSrc ? 'transform: scale(1);' : 'transform: scale(0.95);'" />
                     <figcaption x-show="lightboxModalCaption" class="cms-lightbox-caption" x-text="lightboxModalCaption"></figcaption>
                 </figure>
                     </div>
            </div>
        </template>
    </div>
    {block scripts}{/block}
</body>
</html>

