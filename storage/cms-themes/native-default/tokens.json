{
    "$schema": "https://ikabud.dev/schemas/theme-tokens-v1.json",
    "colors": {
        "primary": {
            "value": "var(--color-primary, #2563eb)",
            "description": "Primary brand color — used for buttons, links, accents",
            "css_var": "--color-primary"
        },
        "primary_light": {
            "value": "var(--color-primary-light, #dbeafe)",
            "description": "Light variant for backgrounds, hover states",
            "css_var": "--color-primary-light"
        },
        "surface": {
            "value": "var(--color-surface, #ffffff)",
            "description": "Card and panel background",
            "css_var": "--color-surface"
        },
        "surface_muted": {
            "value": "var(--color-surface-muted, #f8fafc)",
            "description": "Muted surface for secondary areas",
            "css_var": "--color-surface-muted"
        },
        "text_primary": {
            "value": "var(--color-text, #111827)",
            "description": "Primary text color",
            "css_var": "--color-text"
        },
        "text_secondary": {
            "value": "var(--color-text-secondary, #6b7280)",
            "description": "Secondary/muted text",
            "css_var": "--color-text-secondary"
        },
        "border": {
            "value": "var(--color-border, #e5e7eb)",
            "description": "Default border color",
            "css_var": "--color-border"
        }
    },
    "typography": {
        "font_family": {
            "value": "var(--font-family, Inter, system-ui, sans-serif)",
            "description": "Primary typeface"
        },
        "heading_weight": {
            "value": "var(--heading-weight, 700)",
            "description": "Font weight for headings h1-h6"
        },
        "body_size": {
            "value": "var(--body-size, 16px)",
            "description": "Base body font size"
        }
    },
    "spacing": {
        "none": {
            "value": "0",
            "description": "No spacing"
        },
        "sm": {
            "value": "var(--spacing-sm, 0.75rem)",
            "description": "Small — compact layouts"
        },
        "md": {
            "value": "var(--spacing-md, 1.25rem)",
            "description": "Medium — default panels"
        },
        "lg": {
            "value": "var(--spacing-lg, 2rem)",
            "description": "Large — section padding"
        },
        "xl": {
            "value": "var(--spacing-xl, 3rem)",
            "description": "Extra large — page sections"
        }
    },
    "radius": {
        "none": {
            "value": "0",
            "description": "Sharp corners"
        },
        "sm": {
            "value": "var(--radius-sm, 0.375rem)",
            "description": "Small — inputs, badges"
        },
        "md": {
            "value": "var(--radius-md, 0.75rem)",
            "description": "Medium — cards, panels"
        },
        "lg": {
            "value": "var(--radius-lg, 1rem)",
            "description": "Large — modals, featured cards"
        },
        "full": {
            "value": "9999px",
            "description": "Fully rounded — pills, avatars"
        }
    },
    "shadows": {
        "none": {
            "value": "none",
            "description": "No shadow"
        },
        "sm": {
            "value": "var(--shadow-sm, 0 1px 2px 0 rgba(0,0,0,0.05))",
            "description": "Subtle elevation"
        },
        "md": {
            "value": "var(--shadow-md, 0 4px 6px -1px rgba(0,0,0,0.1))",
            "description": "Card elevation"
        },
        "lg": {
            "value": "var(--shadow-lg, 0 10px 15px -3px rgba(0,0,0,0.1))",
            "description": "Modal elevation"
        }
    },
    "layout": {
        "max_width": {
            "value": "var(--layout-max-width, 1280px)",
            "description": "Maximum content width"
        },
        "header_height": {
            "value": "var(--header-height, 64px)",
            "description": "Site header height"
        },
        "sidebar_width": {
            "value": "var(--sidebar-width, 300px)",
            "description": "Default sidebar width"
        }
    }
}