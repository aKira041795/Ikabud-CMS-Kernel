<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    {if theme_style_url}<link rel="stylesheet" href="{theme_style_url}">{/if}
    {if colors_style}{colors_style|raw}{/if}
    {if theme_layout_style}{theme_layout_style|raw}{/if}
    {if custom_css}{custom_css|raw}{/if}
    {if head_code}{head_code|raw}{/if}
    <noscript><style>body{opacity:1!important;}</style></noscript>
    {block head}{/block}
</head>
<body class="entity-commerce-poc {if builder_enabled && builder_page_settings.body_class}{builder_page_settings.body_class}{/if}">

    <div class="poc-shell">
        <div class="poc-shell__backdrop"></div>

        {if has_customized_header}
        {customized_header|raw}
        {else}
        <header class="poc-header">
            <div class="poc-header__inner">
                <div class="poc-branding">
                    <a href="{base_url}/ecommerce/shop" class="poc-branding__mark">{site_title|default:gui.app_name|default:"Ikabud"}</a>
                </div>
                <nav class="poc-nav" aria-label="Primary Navigation">
                    {if primary_menu}
                    {primary_menu|raw}
                    {else}
                    <ul class="nav-menu">
                        <li><a href="{base_url}/cms">Home</a></li>
                        <li><a href="{base_url}/ecommerce/shop">Shop</a></li>
                    </ul>
                    {/if}
                </nav>
                <div class="poc-header__actions">
                    <a href="{base_url}/ecommerce/cart" class="poc-cart-badge" aria-label="Shopping cart">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-9H5.4M7 13l-1.5 6h13M7 13L5.4 5M17 13l1.5 6M9 21a1 1 0 100-2 1 1 0 000 2zm8 0a1 1 0 100-2 1 1 0 000 2z"/></svg>
                        {if cart_count}<span class="poc-cart-badge__count">{cart_count}</span>{/if}
                    </a>
                </div>
            </div>
        </header>
        {/if}

        <main class="poc-main">
            <div class="poc-main__inner{if has_customized_sidebar && !builder_enabled} poc-main__inner--sidebar {if sidebar_position == 'left'}poc-main__inner--sidebar-left{/if}{/if}"{if has_customized_sidebar && !builder_enabled} style="--sidebar-width:{sidebar_width|default:'300'}px;"{/if}>
                {if has_customized_sidebar && !builder_enabled && sidebar_position == 'left'}
                <aside class="poc-sidebar">{customized_sidebar|raw}</aside>
                {/if}
                <div class="poc-content{if builder_enabled} poc-content--builder{/if}">
                    {block content}{/block}
                </div>
                {if has_customized_sidebar && !builder_enabled && sidebar_position != 'left'}
                <aside class="poc-sidebar">{customized_sidebar|raw}</aside>
                {/if}
            </div>
        </main>

        {if has_customized_footer}
        {customized_footer|raw}
        {else}
        <footer class="poc-footer">
            <div class="poc-footer__inner">
                <div>
                    <p class="poc-footer__copy">{site_title|default:gui.app_name|default:"Ikabud"}</p>
                </div>
                <div class="poc-footer__meta">
                    {if footer_menu}
                    <div class="poc-footer__menu">{footer_menu|raw}</div>
                    {/if}
                    <span>&copy; {current_year|default:"2026"} {site_title|default:gui.app_name|default:"Ikabud"}</span>
                </div>
            </div>
        </footer>
        {/if}
    </div>

    {if theme_script_url}<script src="{theme_script_url}" defer></script>{/if}
    {if builder_enabled}<script src="{base_url}/assets/cms/builder-public.js" defer></script>{/if}
    {if body_end_code}{body_end_code|raw}{/if}
    {block scripts}{/block}
</body>
</html>