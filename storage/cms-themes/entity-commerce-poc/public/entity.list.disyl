{extends "_cms_active_theme/layouts/public.disyl"}

{block head}
{if cms_head}{cms_head | raw}{/if}
{/block}

{block content}
<section class="poc-entity-list">

    <div class="poc-entity-list__hero">
        <div>
            <p class="poc-kicker">CMS Entity List</p>
            <h1 class="poc-title">{if list_title}{list_title}{else}Storefront Collection{/if}</h1>
            {if list_description}
            <p class="poc-summary">{list_description}</p>
            {else}
            <p class="poc-summary">This storefront grid is powered by the CMS universal entity list contract, not a storefront-only template family.</p>
            {/if}
        </div>
        {if pagination}
        <div class="poc-entity-list__badge">Page {pagination.current} of {pagination.total}</div>
        {/if}
    </div>

    {if items}
    <div class="poc-catalog-grid">
        {foreach items as item}
        <a href="{item.url}" class="poc-product-card">
            <div class="poc-product-card__media">
                {if item.primary_image_url}
                <img src="{item.primary_image_url}" alt="{item.title}" class="poc-product-card__image">
                {else}
                <div class="poc-product-card__placeholder">{item.title}</div>
                {/if}
            </div>

            <div class="poc-product-card__body">
                <div class="poc-product-card__copy">
                    <h2 class="poc-product-card__title">{item.title}</h2>
                    {if item.excerpt}
                    <p class="poc-product-card__excerpt">{item.excerpt}</p>
                    {/if}
                </div>

                <div class="poc-product-card__meta">
                    {if item.capabilities.pricing and item.capability_data.pricing.price}
                    <div class="poc-price-pill">
                        {if item.capability_data.pricing.sale_price}
                        <span class="poc-price-pill__current">{item.capability_data.pricing.currency} {item.capability_data.pricing.sale_price | number_format:2}</span>
                        <span class="poc-price-pill__previous">{item.capability_data.pricing.currency} {item.capability_data.pricing.price | number_format:2}</span>
                        {else}
                        <span class="poc-price-pill__current">{item.capability_data.pricing.currency} {item.capability_data.pricing.price | number_format:2}</span>
                        {/if}
                    </div>
                    {/if}

                    {if item.capabilities.inventory and item.capability_data.inventory.track_stock}
                        {if item.capability_data.inventory.out_of_stock or not item.capability_data.inventory.in_stock}
                        <span class="poc-stock-tag poc-stock-tag--out">Out of stock</span>
                        {elseif item.capability_data.inventory.low_stock}
                        <span class="poc-stock-tag poc-stock-tag--low">Only {item.capability_data.inventory.stock_qty} left</span>
                        {/if}
                    {/if}

                    {if item.capabilities.progress_tracking and item.capability_data.progress_tracking.authenticated}
                    <div class="poc-progress-rail" aria-label="Progress">
                        <span class="poc-progress-rail__bar" style="width:{item.capability_data.progress_tracking.percent}%"></span>
                    </div>
                    <span class="poc-progress-label">{item.capability_data.progress_tracking.percent}% complete</span>
                    {/if}
                </div>
            </div>
        </a>
        {/foreach}
    </div>

    {if pagination}
    <nav class="poc-pagination" aria-label="Pagination">
        {if pagination.prev_url}<a href="{pagination.prev_url}" class="poc-pagination__link">&larr; Previous</a>{/if}
        <span class="poc-pagination__status">Page {pagination.current} of {pagination.total}</span>
        {if pagination.next_url}<a href="{pagination.next_url}" class="poc-pagination__link">Next &rarr;</a>{/if}
    </nav>
    {/if}

    {else}
    <div class="poc-empty-state">
        <p>No items found.</p>
    </div>
    {/if}

</section>
{/block}