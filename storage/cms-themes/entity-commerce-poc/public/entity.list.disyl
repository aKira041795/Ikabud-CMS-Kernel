{extends "_cms_active_theme/layouts/public.disyl"}

{block head}
{if cms_head}{cms_head | raw}{/if}
{/block}

{block content}
<section
    class="poc-entity-list"
    data-public-render-origin="{public_render_origin|default:'cms'}"
    data-public-route-kind="{public_route_kind|default:'generic'}"
    data-public-presentation-mode="{public_presentation_mode|default:'traditional'}"
    data-list-search="{entity_list_context.search|default:''}"
    data-list-category-slug="{entity_list_context.category_slug|default:''}"
    data-list-result-count="{entity_list_context.result_count|default:0}"
    data-list-active-filter-count="{entity_list_context.active_filter_count|default:0}"
>

    <div class="poc-entity-list__hero">
        <div>
            <p class="poc-kicker">CMS Entity List</p>
            <h1 class="poc-title">{if list_title}{list_title}{else}Storefront Collection{/if}</h1>
            {if list_description}
            <p class="poc-summary">{list_description}</p>
            {else}
            <p class="poc-summary">This storefront grid is powered by the CMS universal entity list contract, not a storefront-only template family.</p>
            {/if}
            {if entity_list_context.result_label or entity_list_context.category_name or entity_list_context.search}
            <div class="poc-entity-list__filters">
                {if entity_list_context.result_label}<span class="poc-entity-list__filter">{entity_list_context.result_label}</span>{/if}
                {if entity_list_context.category_name}<span class="poc-entity-list__filter poc-entity-list__filter--category">{entity_list_context.category_name}</span>{/if}
                {if entity_list_context.search}<span class="poc-entity-list__filter poc-entity-list__filter--search">&quot;{entity_list_context.search}&quot;</span>{/if}
            </div>
            {/if}
        </div>
        {if pagination}
        <div class="poc-entity-list__badge">Page {pagination.current} of {pagination.total}</div>
        {/if}
    </div>

    {if items}
    <div class="poc-catalog-grid">
        {foreach items as item}
        <a
            href="{item.url}"
            class="poc-product-card"
            data-entity-kind="list-item"
            data-entity-type="{item.entity_type|default:content_type|default:'generic'}"
            data-entity-id="{item.id|default:''}"
            data-entity-slug="{item.slug|default:''}"
        >
            <div class="poc-product-card__media">
                {if item.primary_image_url}
                <img src="{item.primary_image_url}" alt="{item.title}" class="poc-product-card__image">
                {else}
                <div class="poc-product-card__placeholder">{item.title}</div>
                {/if}
            </div>

            <div class="poc-product-card__body">
                <div class="poc-product-card__copy">
                    <h2 class="poc-product-card__title">{item.title}</h2>
                    {if item.excerpt}
                    <p class="poc-product-card__excerpt">{item.excerpt}</p>
                    {/if}
                </div>

                <div class="poc-product-card__meta">
                    {if item.list_card_pricing_html}{item.list_card_pricing_html | raw}{/if}
                    {if item.list_card_inventory_html}{item.list_card_inventory_html | raw}{/if}
                    {if item.list_card_progress_html}{item.list_card_progress_html | raw}{/if}
                </div>
            </div>
        </a>
        {/foreach}
    </div>

    {if pagination}
    <nav class="poc-pagination" aria-label="Pagination">
        {if pagination.prev_url}<a href="{pagination.prev_url}" class="poc-pagination__link">&larr; Previous</a>{/if}
        <span class="poc-pagination__status">Page {pagination.current} of {pagination.total}</span>
        {if pagination.next_url}<a href="{pagination.next_url}" class="poc-pagination__link">Next &rarr;</a>{/if}
    </nav>
    {/if}

    {else}
    <div class="poc-empty-state">
        <p>No items found.</p>
    </div>
    {/if}

</section>
{/block}