{extends "_cms_active_theme/layouts/public.disyl"}

{block head}
{if cms_head}{cms_head | raw}{/if}
{/block}

{block content}
<section
    class="poc-entity-list poc-entity-list--density-{entity_presentation.list_card_density|default:'comfortable'}"
    data-public-render-origin="{public_render_origin|default:'cms'}"
    data-public-route-kind="{public_route_kind|default:'generic'}"
    data-public-presentation-mode="{public_presentation_mode|default:'traditional'}"
    data-storefront-route-kind="{storefront.route.kind|default:public_route_kind|default:'generic'}"
    data-storefront-mode="{storefront.route.mode|default:public_presentation_mode|default:'traditional'}"
    data-storefront-page-kind="{storefront.page.kind|default:'catalog'}"
    data-storefront-result-total="{storefront.collection.total|default:entity_list_context.result_count|default:0}"
    data-catalog-api-url="{if public_render_origin == 'ecommerce'}{base_url}/api/v1/ecommerce/catalog{/if}"
    data-list-base-url="{entity_list_context.base_list_url|default:''}"
    data-list-search-action-url="{entity_list_context.search_action_url|default:entity_list_context.base_list_url|default:''}"
    data-list-all-items-url="{entity_list_context.all_items_url|default:entity_list_context.base_list_url|default:''}"
    data-item-base-url="{entity_list_context.item_base_url|default:'/ecommerce/shop'}"
    data-list-search="{entity_list_context.search|default:''}"
    data-list-category-slug="{entity_list_context.category_slug|default:''}"
    data-list-result-count="{entity_list_context.result_count|default:0}"
    data-list-active-filter-count="{entity_list_context.active_filter_count|default:0}"
>
    {include "modules/ecommerce/public/partials/storefront-chrome.disyl"}

    <div class="poc-entity-list__hero">
        <div>
            <h1 class="poc-title">{if storefront.page.title|default:list_title}{storefront.page.title|default:list_title}{else}Shop{/if}</h1>
            {if storefront.page.description|default:list_description}
            <p class="poc-summary">{storefront.page.description|default:list_description}</p>
            {/if}
            {if entity_presentation.list_show_filter_summary and (entity_list_context.result_label or entity_list_context.category_name or entity_list_context.search)}
            <div class="poc-entity-list__filters">
                {if entity_list_context.result_label}<span class="poc-entity-list__filter">{entity_list_context.result_label}</span>{/if}
                {if entity_list_context.category_name}<span class="poc-entity-list__filter poc-entity-list__filter--category">{entity_list_context.category_name}</span>{/if}
                {if entity_list_context.search}<span class="poc-entity-list__filter poc-entity-list__filter--search">&quot;{entity_list_context.search}&quot;</span>{/if}
            </div>
            {/if}
        </div>
        {if pagination}
        <div class="poc-entity-list__badge">Page {pagination.current} of {pagination.total}</div>
        {/if}
    </div>

    {if entity_list_context.search_action_url or entity_list_context.available_categories | count > 0}
    <div class="poc-entity-list__toolbar">
        <form method="get" action="{entity_list_context.search_action_url|default:entity_list_context.base_list_url}" class="poc-entity-list__search">
            {if entity_list_context.category_id > 0 and entity_list_context.category_slug == ''}<input type="hidden" name="cat" value="{entity_list_context.category_id}">{/if}
            {if entity_list_context.attribute_filters | count > 0}
            {foreach entity_list_context.attribute_filters as attrSlug => attrValues}
            {foreach attrValues as attrValue}
            <input type="hidden" name="attr[{attrSlug}][]" value="{attrValue}">
            {/foreach}
            {/foreach}
            {/if}
            <input type="text" name="search" value="{entity_list_context.search|default:''}" placeholder="Search products" class="poc-entity-list__search-input">
            <button type="submit" class="poc-entity-list__search-submit">Search</button>
        </form>

        {if entity_list_context.available_categories | count > 0}
            {if entity_presentation.list_category_navigation == 'dropdown'}
            <form method="get" action="{entity_list_context.all_items_url|default:entity_list_context.base_list_url}" class="poc-entity-list__category-picker">
                {if entity_list_context.search}<input type="hidden" name="search" value="{entity_list_context.search}">{/if}
                <label for="poc-entity-list-category">Shop Categories</label>
                <div class="poc-entity-list__category-picker-controls">
                    <select id="poc-entity-list-category" name="cat" class="poc-entity-list__category-select">
                        <option value="" {if entity_list_context.category_id == 0 and entity_list_context.category_slug == ''}selected{/if}>All Products</option>
                        {foreach entity_list_context.available_categories as category}
                        <option value="{category.id}" {if category.is_active}selected{/if}>{category.name}</option>
                        {/foreach}
                    </select>
                    <button type="submit" class="poc-entity-list__category-submit">Browse</button>
                </div>
            </form>
            {else}
            <nav class="poc-entity-list__categories" aria-label="Categories">
                <a href="{entity_list_context.all_items_url|default:entity_list_context.base_list_url}" class="poc-entity-list__category-link {if entity_list_context.category_id == 0 and entity_list_context.category_slug == ''}poc-entity-list__category-link--active{/if}">All Products</a>
                {foreach entity_list_context.available_categories as category}
                <a href="{category.url}" class="poc-entity-list__category-link {if category.is_active}poc-entity-list__category-link--active{/if}">{category.name}</a>
                {/foreach}
            </nav>
            {/if}
        {/if}
    </div>

    {if entity_list_context.attribute_facets | count > 0}
    <form method="get" action="{entity_list_context.search_action_url|default:entity_list_context.base_list_url}" class="poc-entity-list__toolbar" style="display:block;">
        {if entity_list_context.search}<input type="hidden" name="search" value="{entity_list_context.search}">{/if}
        {if entity_list_context.category_id > 0 and entity_list_context.category_slug == ''}<input type="hidden" name="cat" value="{entity_list_context.category_id}">{/if}
        <div class="poc-entity-list__filters" style="margin-bottom:1rem;">
            {foreach entity_list_context.attribute_facets as facet}
            <div class="poc-entity-list__filter" style="display:block; min-width:200px;">
                <strong style="display:block; margin-bottom:0.75rem;">{facet.attribute_name}</strong>
                <div style="display:grid; gap:0.5rem;">
                    {foreach facet.values as value}
                    <label style="display:flex; align-items:center; justify-content:space-between; gap:0.75rem;">
                        <span style="display:flex; align-items:center; gap:0.5rem;">
                            <input type="checkbox" name="attr[{facet.attribute_slug}][]" value="{value.value_slug}" {if value.is_selected}checked{/if}>
                            <span>{value.value_label}</span>
                        </span>
                        <span>{value.count}</span>
                    </label>
                    {/foreach}
                </div>
            </div>
            {/foreach}
        </div>
        <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
            <button type="submit" class="poc-entity-list__search-submit">Apply Filters</button>
            <a href="{entity_list_context.all_items_url|default:entity_list_context.base_list_url}" class="poc-entity-list__category-link">Reset</a>
        </div>
    </form>
    {/if}
    {/if}

    {if items}
    <div class="poc-catalog-grid poc-catalog-grid--{entity_presentation.list_card_density|default:'comfortable'}">
        {foreach items as item}
        <div
            class="poc-product-card"
            data-entity-kind="list-item"
            data-entity-type="{item.entity_type|default:content_type|default:'generic'}"
            data-entity-id="{item.id|default:''}"
            data-entity-slug="{item.slug|default:''}"
        >
            <a href="{item.url}" class="poc-product-card__link">
                <div class="poc-product-card__media">
                    {if item.primary_image_url}
                    <img src="{item.primary_image_url}" alt="{item.title}" class="poc-product-card__image">
                    {else}
                    <div class="poc-product-card__placeholder">{item.title}</div>
                    {/if}
                </div>

                <div class="poc-product-card__body poc-product-card__body--{entity_presentation.list_card_density|default:'comfortable'}">
                    <div class="poc-product-card__copy">
                        <h2 class="poc-product-card__title">{item.title}</h2>
                        {if item.list_card_excerpt}
                        <p class="poc-product-card__excerpt">{item.list_card_excerpt}</p>
                        {/if}
                    </div>

                    <div class="poc-product-card__meta">
                        {if item.list_card_pricing_html}{item.list_card_pricing_html | raw}{/if}
                        {if item.list_card_inventory_html}{item.list_card_inventory_html | raw}{/if}
                        {if item.list_card_progress_html}{item.list_card_progress_html | raw}{/if}
                    </div>
                </div>
            </a>

            {if item.list_card_action_html}
            <div class="poc-product-card__actions">
                {item.list_card_action_html | raw}
            </div>
            {/if}
        </div>
        {/foreach}
    </div>

    {if pagination}
    <nav class="poc-pagination" aria-label="Pagination">
        {if pagination.prev_url}<a href="{pagination.prev_url}" class="poc-pagination__link">&larr; Previous</a>{/if}
        <span class="poc-pagination__status">Page {pagination.current} of {pagination.total}</span>
        {if pagination.next_url}<a href="{pagination.next_url}" class="poc-pagination__link">Next &rarr;</a>{/if}
    </nav>
    {/if}

    {else}
    <div class="poc-empty-state">
        <p>No items found.</p>
        {if entity_list_context.all_items_url and entity_list_context.active_filter_count > 0}
        <a href="{entity_list_context.all_items_url}" class="poc-entity-list__category-link">Browse all products</a>
        {/if}
    </div>
    {/if}

</section>

{if public_render_origin == 'ecommerce' and (content_type|default:entity_list_context.content_type) == 'product'}
{include "modules/cms/public/blocks/ecommerce-catalog-ajax.block.disyl"}
{/if}
{/block}