{if action_sections}{action_sections | raw}{else}
<div class="poc-action-strip">
    <p class="poc-action-strip__label">Theme-approved action block</p>
    <div class="poc-action-strip__row">
        {if capabilities.pricing and cart_enabled}
            {if not capabilities.inventory}
        <form method="POST" action="{cart_action_url}" class="inline">
            <input type="hidden" name="product_id" value="{entity.id}">
            <input type="hidden" name="qty" value="1">
            <button type="submit" class="poc-action-strip__button poc-action-strip__button--primary">
                Add to Cart
            </button>
        </form>
            {else}
                {if capability_data.inventory.in_stock}
                    {if capability_data.inventory.out_of_stock}
        <span class="poc-action-strip__status">Out of Stock</span>
                    {else}
        <form method="POST" action="{cart_action_url}" class="inline">
            <input type="hidden" name="product_id" value="{entity.id}">
            <input type="hidden" name="qty" value="1">
            <button type="submit" class="poc-action-strip__button poc-action-strip__button--primary">
                Add to Cart
            </button>
        </form>
                    {/if}
                {else}
        <span class="poc-action-strip__status">Out of Stock</span>
                {/if}
            {/if}
        {elseif capabilities.pricing and not cart_enabled}
        <span class="poc-action-strip__status">Price shown, checkout wiring pending</span>
        {/if}

        {if capabilities.booking}
        <a href="{base_url}/cms/{entity.type}/{entity.slug}/book" class="poc-action-strip__button poc-action-strip__button--secondary">
            Book Now
        </a>
        {/if}

        {if capabilities.inquiry}
        <a href="{base_url}/cms/{entity.type}/{entity.slug}/inquire" class="poc-action-strip__button poc-action-strip__button--secondary">
            {if capability_data.inquiry.label}{capability_data.inquiry.label}{else}Inquire{/if}
        </a>
        {/if}
    </div>
</div>
{/if}