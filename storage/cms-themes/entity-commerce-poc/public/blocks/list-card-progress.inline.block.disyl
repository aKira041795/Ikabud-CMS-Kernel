{if capabilities.progress_tracking and capability_data.progress_tracking.authenticated}
<div class="poc-progress-inline">
    <span>{capability_data.progress_tracking.percent}% complete</span>
    <div class="poc-progress-rail" aria-label="Progress">
        <span class="poc-progress-rail__bar" style="width:{capability_data.progress_tracking.percent}%"></span>
    </div>
</div>
{/if}