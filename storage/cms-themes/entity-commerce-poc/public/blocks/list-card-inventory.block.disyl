{if capabilities.inventory and capability_data.inventory.track_stock}
    {if capability_data.inventory.out_of_stock or not capability_data.inventory.in_stock}
    <span class="poc-stock-tag poc-stock-tag--out">Out of stock</span>
    {elseif capability_data.inventory.low_stock}
    <span class="poc-stock-tag poc-stock-tag--low">Only {capability_data.inventory.stock_qty} left</span>
    {/if}
{/if}