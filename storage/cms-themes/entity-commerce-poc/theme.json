{
    "name": "Entity Commerce",
    "version": "1.0.0",
    "author": "GitHub Copilot",
    "description": "Ecommerce storefront theme with product showcase, pricing, inventory, and cart integration through the CMS universal entity rendering system.",
    "customizer_scope": "ecommerce",
    "supports": {
        "menus": [
            "primary",
            "footer"
        ],
        "features": [
            "featured-images",
            "excerpts",
            "custom-templates"
        ]
    },
    "assets": {
        "css": [
            "style.css"
        ]
    },
    "entity_view_defaults": {
        "layout_profile": "commerce",
        "summary_width": 360,
        "summary_sticky": 1,
        "media_ratio": "4:3",
        "spacing_scale": "comfortable",
        "action_size": "md",
        "list_show_filter_summary": 1,
        "list_card_density": "comfortable",
        "list_show_excerpt": 1,
        "list_excerpt_length": 120,
        "block_variants": {
            "action": "inline",
            "list-card-pricing": "featured",
            "list-card-inventory": "compact",
            "list-card-progress": "inline"
        }
    },
    "overridable_blocks": [
        "pricing.block.disyl",
        "action.block.disyl"
    ],
    "tokens": {
        "color-primary": "#0f4c81",
        "color-accent": "#c56a1a",
        "color-background": "#f4efe6",
        "color-surface": "#fffaf2",
        "color-text": "#18212b",
        "color-muted": "#68707a",
        "color-border": "#d7cec1",
        "radius-card": "28px",
        "radius-pill": "999px",
        "container-max": "1180px"
    }
}