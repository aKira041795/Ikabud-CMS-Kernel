{# ARK: Admin Preview Layout (Phase 6 — Customizer Integration)
   Lightweight iframe shell for live customizer preview.
   Receives customizer changes via postMessage and updates CSS variables in real-time.
   Referenced by admin/customizer-preview.disyl. #}

<!DOCTYPE html>
<html lang="en" class="ark-theme">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARK Theme Preview</title>

    {if theme_style_url}<link rel="stylesheet" href="{theme_style_url}">{/if}
    {if preview_colors_style}{preview_colors_style|raw}{/if}
    {if preview_layout_style}{preview_layout_style|raw}{/if}

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <style>
        :root {
            --color-primary: #6366f1; --color-primary-dark: #4f46e5; --color-primary-light: #eef2ff;
            --color-surface: #fff; --color-surface-muted: #f8fafc;
            --color-text: #0f172a; --color-text-secondary: #475569; --color-text-muted: #94a3b8;
            --color-border: #e2e8f0;
            --font-family: Inter, system-ui, -apple-system, sans-serif;
            --font-size-base: 16px; --line-height: 1.6;
            --max-width: 1280px; --header-height: 64px;
            --radius-sm: 0.375rem; --radius-md: 0.75rem; --radius-lg: 1rem;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
            --shadow-md: 0 4px 6px rgba(0,0,0,0.07);
            --shadow-lg: 0 10px 25px rgba(0,0,0,0.08);
            --spacing-sm: 0.75rem; --spacing-md: 1.25rem; --spacing-lg: 2rem; --spacing-xl: 3rem;
        }

        body {
            font-family: var(--font-family);
            font-size: var(--font-size-base);
            line-height: var(--line-height);
            color: var(--color-text);
            background: var(--color-surface);
            margin: 0;
            padding: 1rem;
            -webkit-font-smoothing: antialiased;
        }

        .ark-preview-badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 999px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            background: var(--color-primary-light, #eef2ff);
            color: var(--color-primary, #6366f1);
            margin-bottom: 1rem;
        }

        .ark-preview-section {
            border: 1px dashed var(--color-border, #e2e8f0);
            border-radius: var(--radius-md, 0.75rem);
            padding: 1.5rem;
            margin-bottom: 1rem;
        }

        .ark-preview-section__label {
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--color-text-muted, #94a3b8);
            margin-bottom: 0.75rem;
        }
    </style>
</head>
<body>
    <div class="ark-preview-badge">Live Preview</div>

    {# Slot-driven preview content #}
    <div id="ark-preview-root">
        {block content}{/block}
    </div>

    {# postMessage listener for real-time customizer updates #}
    <script>
        window.addEventListener('message', function(event) {
            if (!event.data || event.data.type !== 'cms:customizer:update') return;

            var vars = event.data.variables || {};
            var root = document.documentElement;

            Object.keys(vars).forEach(function(key) {
                root.style.setProperty(key, vars[key]);
            });

            // Dispatch event for Alpine components to refresh
            window.dispatchEvent(new CustomEvent('ark:preview:updated', { detail: vars }));
        });

        // Signal ready to parent
        if (window.parent && window.parent !== window) {
            window.parent.postMessage({ type: 'cms:customizer:preview-ready' }, '*');
        }
    </script>
</body>
</html>
