<!DOCTYPE html>
<html lang="en" class="ark-theme">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title|default:site_title|default:'ARK Theme'}</title>
    <meta name="description" content="{page_description|default:''}">

    {# ARK Reference Theme — demonstrates every Kernel OS concept
       Manifest: theme.manifest.json, Tokens: tokens.json
       Shell: layouts/public.disyl, Style: style.css
       Slots: 17 governed {ikb_slot} markers
       Entity views: public/entity.view.disyl, public/entity.list.disyl
       Blocks: public/blocks/ (pricing, inventory, action, progress, list-card)
       Partials: public/partials/ (header, footer, navigation, breadcrumbs, pagination)
    #}

    {if theme_style_url}<link rel="stylesheet" href="{theme_style_url}">{/if}
    <link rel="stylesheet" href="{cms_public_css_url}">
    {if colors_style}{colors_style|raw}{/if}
    {if theme_layout_style}{theme_layout_style|raw}{/if}
    {if custom_css}{custom_css|raw}{/if}
    {if head_code}{head_code|raw}{/if}

    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    {# CSS fallback: only inject token defaults when theme style URL is unavailable.
       When theme_style_url is set, style.css provides the authoritative token values
       and this block is skipped to avoid precedence conflicts with customizer overrides. #}
    {if !theme_style_url}
    <style>
        :root {
            --color-primary: #6366f1; --color-primary-dark: #4f46e5; --color-primary-light: #eef2ff;
            --color-surface: #fff; --color-surface-muted: #f8fafc;
            --color-text: #0f172a; --color-text-secondary: #475569; --color-text-muted: #94a3b8;
            --color-border: #e2e8f0;
            --font-family: Inter, system-ui, -apple-system, sans-serif;
            --font-size-base: 16px; --line-height: 1.6;
            --max-width: 1280px; --header-height: 64px;
            --radius-sm: 0.375rem; --radius-md: 0.75rem; --radius-lg: 1rem;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
            --shadow-md: 0 4px 6px rgba(0,0,0,0.07);
            --shadow-lg: 0 10px 25px rgba(0,0,0,0.08);
            --spacing-sm: 0.75rem; --spacing-md: 1.25rem; --spacing-lg: 2rem; --spacing-xl: 3rem;
        }
    </style>
    {/if}
</head>
<body>

    {# ── Declare customizer variables with safe defaults ──
       These are injected by cmsPublicContext() at runtime, but declaring
       defaults here ensures the template is self-documenting and never
       silently fails when a handler path doesn't set them. #}
    {set has_customized_header = has_customized_header|default:false}
    {set customized_header = customized_header|default:''}
    {set has_customized_footer = has_customized_footer|default:false}
    {set customized_footer = customized_footer|default:''}
    {set has_customized_sidebar = has_customized_sidebar|default:false}
    {set customized_sidebar = customized_sidebar|default:''}
    {set sidebar_diag = 'HCS='~has_customized_sidebar~'|SCS='~(has_customized_sidebar or false)}
    {set force_customized_sidebar = force_customized_sidebar|default:false}
    {set cms_global_sidebar_force = cms_global_sidebar_force|default:false}
    {set sidebar_position = sidebar_position|default:'right'}
    {set sidebar_width = sidebar_width|default:'300'}
    {set show_header = show_header|default:true}
    {set show_footer = show_footer|default:true}
    {set builder_enabled = builder_enabled|default:false}
    {set builder_page_settings = builder_page_settings|default:[]}

    {# Skip-to-content link for accessibility #}
    <a href="#main-content" class="ark-skip">Skip to content</a>

    {# ── Governed theme slots (Phase 1) ── #}
    {ikb_slot name="site.before" /}
    {ikb_slot name="header.before" /}

    {block header}
    {ikb_slot name="header.main" /}

    {# Customizer-aware header: use customizer output when available,
       fall back to ARK's own header when no customizer data exists. #}
    {if show_header|default:true}
        {if has_customized_header}
            {customized_header|raw}
        {else}
            {include "../public/partials/header.disyl"}
        {/if}
    {/if}
    {/block}
    {ikb_slot name="header.after" /}

    {ikb_slot name="hero" /}
    {ikb_slot name="breadcrumbs" /}

    {# Customizer-aware sidebar: uses cms-content-with-sidebar grid when
       customizer sidebar is enabled. Falls back to ARK's flex layout when
       no customizer sidebar data exists (slot-only sidebars). #}
    {set show_customizer_sidebar = has_customized_sidebar or force_customized_sidebar or cms_global_sidebar_force}

    <div class="ark-content-area{if builder_enabled} ark-content-area--builder{/if}{if show_customizer_sidebar} cms-content-with-sidebar{if sidebar_position == 'left'} sidebar-left{/if}{/if}"{if show_customizer_sidebar} style="--sidebar-width:{sidebar_width|default:'300'}px;"{/if}>
        {# Sidebar on left when position is 'left' #}
        {if show_customizer_sidebar and sidebar_position == 'left'}
        <aside class="cms-sidebar-slot ark-sidebar-customizer" aria-label="Sidebar">
            {customized_sidebar|raw}
        </aside>
        {/if}

        <main id="main-content" class="ark-main{if builder_enabled} ark-main--builder{/if}{if show_customizer_sidebar} cms-main-slot{/if}" tabindex="-1">
            {ikb_slot name="content.before" /}
            {block content}
                {ikb_slot name="content"}
                    {if body}{body|raw}{/if}
                {/ikb_slot}
            {/block}
            {ikb_slot name="content.after" /}
        </main>

        {# Sidebar on right (default) or slot-only sidebars when no customizer sidebar #}
        {if show_customizer_sidebar and sidebar_position != 'left'}
        <aside class="cms-sidebar-slot ark-sidebar-customizer" aria-label="Sidebar">
            {customized_sidebar|raw}
        </aside>
        {elseif not show_customizer_sidebar}
        <aside class="ark-sidebar-region" aria-label="Sidebar">
            {ikb_slot name="sidebar.primary" /}
            {ikb_slot name="sidebar.secondary" /}
        </aside>
        {/if}
    </div>

    {# Customizer-aware footer: use customizer output when available,
       fall back to ARK's own footer when no customizer data exists. #}
    {if has_customized_footer}
        {customized_footer|raw}
    {else}
        {ikb_slot name="footer.before" /}
        {ikb_slot name="footer.main" /}
        {include "../public/partials/footer.disyl"}
        {ikb_slot name="footer.after" /}
    {/if}

    {ikb_slot name="site.after" /}
    {ikb_slot name="notifications" /}

    {if body_end_code}{body_end_code|raw}{/if}
    {block scripts}{/block}
</body>
</html>
