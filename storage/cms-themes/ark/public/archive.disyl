{# ARK: Blog Archive Template (Phase 3)
   Extends entity list patterns for date-based archives.
   Includes filter chips, result count, and pagination. #}

{extends "_cms_active_theme/layouts/public.disyl"}

{block head}
{include "partials/canonical-entity-styles.disyl"}
{if structured_data}{structured_data|raw}{/if}
{/block}

{block content}
<article class="ark-entity-list" data-ark-template="archive">
    {# Page header #}
    <header class="ark-page-header">
        <h1 class="ark-page-title">{archive_title|default:page_title|default:'Archive'}</h1>
        {if archive_description}
        <p class="ark-result-summary">{archive_description}</p>
        {/if}
    </header>

    {# Toolbar: search + category #}
    <div class="ark-list-toolbar">
        <div class="ark-list-toolbar__grow">
            {include "partials/search-form.disyl"}
        </div>
        {if categories}
        <div class="ark-form-group">
            <span class="ark-label" id="ark-category-label">Category</span>
            <div class="ark-filter-list" role="group" aria-labelledby="ark-category-label">
                <a href="{all_items_url|default:'?'}" class="ark-button">All</a>
                {for cat in categories}
                <a href="{cat.url}" class="ark-button"{if cat.active} aria-current="page"{/if}>{cat.label} ({cat.count})</a>
                {/for}
            </div>
        </div>
        {/if}
    </div>

    {# Active filter pills #}
    {if active_filters}
    <div class="ark-filter-list">
        {for filter in active_filters}
        <span class="ark-badge ark-badge--primary">
            {filter.label}
            <a href="{filter.remove_url}" title="Remove filter">&times;</a>
        </span>
        {/for}
    </div>
    {/if}

    {# Result count #}
    {if result_count}
    <p class="ark-result-summary">{result_count} {result_label|default:'results'}</p>
    {/if}

    {# Entity list — governed component resolves data #}
    {ikb_entity_list source="cms_post.recent" view="{entity_view|default:'card_grid'}" limit="{posts_per_page|default:12}" /}

    {# Pagination partial #}
    {include "partials/pagination.disyl"}

    {# Empty state #}
    {if not posts_exist}
    <div class="ark-empty">
        <div class="ark-empty__icon">&#x1F4DA;</div>
        <div class="ark-empty__text">No posts found in this archive.</div>
    </div>
    {/if}
</article>
{/block}
