{# ARK: Ledger Row Block Alias
   Context: entity, capability_data, entity_presentation
   Builder-facing ledger row alias for ark.blocks.ledger_row. #}

<div class="ark-ledger-row">
    <span class="ark-ledger-row__label">{entity.title|default:capability_data.entry.label|default:'Ledger Entry'}</span>
    <span class="ark-ledger-row__value">{capability_data.entry.amount|default:entity.amount|default:'0.00'}</span>
</div>
