{# ARK: Ledger Row Block Alias
   Context: entity, capability_data, entity_presentation
   Builder-facing ledger row alias for ark.blocks.ledger_row. #}

<div style="display:flex;justify-content:space-between;gap:var(--spacing-sm);padding:var(--spacing-sm) 0;border-bottom:1px solid var(--color-border-subtle);">
    <span style="font-weight:600;color:var(--color-text);">{entity.title|default:capability_data.entry.label|default:'Ledger Entry'}</span>
    <span style="color:var(--color-text-secondary);">{capability_data.entry.amount|default:entity.amount|default:'0.00'}</span>
</div>
