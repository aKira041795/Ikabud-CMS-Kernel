{# ARK: Pricing Block — Featured (Phase 4)
    Context: entity, capability_data, entity_presentation
    Highlighted pricing card with "Best Value" ribbon. #}

{ikb_panel tone="elevated" spacing="lg" radius="lg"}
    {if capability_data.pricing.featured_badge}
    <div class="ark-pricing-ribbon ark-pricing-ribbon--panel">
        {capability_data.pricing.featured_badge}
    </div>
    {/if}
    <h3 class="ark-pricing-title">
        {capability_data.pricing.label|default:'Featured Pricing'}
    </h3>
    <div class="ark-pricing-amount ark-pricing-amount--xl">
        {capability_data.pricing.currency|default:'$'}{capability_data.pricing.price|number_format:2}
    </div>
    {if capability_data.pricing.description}
    <p class="ark-pricing-description">{capability_data.pricing.description}</p>
    {/if}
    {if capability_data.actions and capability_data.actions.add_to_cart}
    <div class="ark-pricing-cta">
        <a href="{capability_data.actions.add_to_cart.url|default:'#'}" class="ark-btn ark-btn--primary ark-pricing-cta__button">
            {capability_data.actions.add_to_cart.label|default:'Get Started'}
        </a>
    </div>
    {/if}
{/ikb_panel}
