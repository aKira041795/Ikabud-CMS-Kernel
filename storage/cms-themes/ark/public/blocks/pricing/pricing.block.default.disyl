{# ARK: Pricing Block — Default (Phase 4)
    Context: entity, capability_data, entity_presentation
    Full price display with sale comparison, currency, and CTA.
    Variants: default, compact, featured #}

{ikb_panel tone="surface" spacing="lg" radius="md"}
    <h3 class="ark-pricing-title">
        {capability_data.pricing.label|default:'Pricing'}
    </h3>
    <div class="ark-pricing-row">
        {if capability_data.pricing.compare_at_price and capability_data.pricing.compare_at_price > capability_data.pricing.price}
        <span class="ark-pricing-compare">
            {capability_data.pricing.currency|default:'$'}{capability_data.pricing.compare_at_price|number_format:2}
        </span>
        {/if}
        <span class="ark-pricing-amount ark-pricing-amount--lg">
            {capability_data.pricing.currency|default:'$'}{capability_data.pricing.price|number_format:2}
        </span>
        {if capability_data.pricing.unit}
        <span class="ark-pricing-unit">/{capability_data.pricing.unit}</span>
        {/if}
    </div>
    {if capability_data.pricing.description}
    <p class="ark-pricing-description">
        {capability_data.pricing.description}
    </p>
    {/if}
    {if capability_data.actions and capability_data.actions.add_to_cart}
    <div class="ark-pricing-cta">
        <a href="{capability_data.actions.add_to_cart.url|default:'#'}" class="ark-btn ark-btn--primary">
            {capability_data.actions.add_to_cart.label|default:'Add to Cart'}
        </a>
    </div>
    {/if}
{/ikb_panel}
