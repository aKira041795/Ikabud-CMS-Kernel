{# ARK: Media Gallery Block (Phase 4)
    Context: entity, capability_data
    Featured image + gallery thumbnails with lightbox support. #}

{if entity.featured_image_url or entity.images}
<div class="ark-media-gallery" x-data="{ activeImage: '{entity.featured_image_url|default:''}', galleryOpen: false }">
    {# Main image #}
    {if entity.featured_image_url}
    <img src="{entity.featured_image_url}" alt="{entity.title|default:''}" class="ark-media-gallery__featured" @click="galleryOpen = true" loading="lazy" />
    {/if}

    {# Gallery thumbnails #}
    {if entity.images and entity.images|length > 0}
    <div class="ark-media-gallery__thumbs">
        {for img in entity.images}
        <img src="{img.url|default:img}" alt="" class="ark-media-gallery__thumb" loading="lazy" :class="{ 'ark-media-gallery__thumb--active': activeImage === '{img.url|default:img}' }" @click="activeImage = '{img.url|default:img}'; galleryOpen = true" />
        {/for}
    </div>
    {/if}

    <div class="ark-lightbox" x-show="galleryOpen" x-cloak @keydown.escape.window="galleryOpen = false" @click.self="galleryOpen = false" style="display:none;">
        <button type="button" class="ark-lightbox__close" @click="galleryOpen = false" aria-label="Close image preview">&times;</button>
        <img :src="activeImage" alt="{entity.title|default:''}" class="ark-lightbox__image" loading="lazy" />
    </div>
</div>
{/if}
