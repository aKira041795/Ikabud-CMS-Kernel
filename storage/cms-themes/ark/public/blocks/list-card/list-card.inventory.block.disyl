{# ARK: List Card Block — With Inventory (Phase 4)
    Context: entity, row, capability_data, entity_presentation
    Card container with integrated stock status badge.
    Shows in-stock/out-of-stock indicator and quantity. #}

<article class="ark-card">
    {if row.image or row.featured_image_url or row.thumbnail_url}
    <a href="{row.url|default:'#'}" class="ark-card__image-link" aria-hidden="true" tabindex="-1">
        <img
            src="{row.image|default:row.featured_image_url|default:row.thumbnail_url}"
            alt="{row.title|default:row.name|default:''}"
            class="ark-card__image"
            loading="lazy"
        />
    </a>
    {/if}
    <div class="ark-card__body">
        {# Inventory status badge — top-right #}
        {if capability_data and capability_data.inventory}
            {if capability_data.inventory.in_stock}
            <span class="ark-badge ark-badge--success ark-stock-badge ark-stock-badge--card">
                <span class="ark-stock-dot ark-stock-dot--success ark-stock-dot--sm"></span>
                In Stock
            </span>
            {else}
            <span class="ark-badge ark-badge--danger ark-stock-badge ark-stock-badge--card">
                <span class="ark-stock-dot ark-stock-dot--danger ark-stock-dot--sm"></span>
                Out of Stock
            </span>
            {/if}
        {/if}

        <h3 class="ark-card__title">
            {if row.url}<a href="{row.url}">{/if}
            {row.title|default:row.name|default:row.label|default:'Untitled'}
            {if row.url}</a>{/if}
        </h3>
        {if row.excerpt or row.description}
        <p class="ark-card__excerpt">
            {row.excerpt|default:row.description}
        </p>
        {/if}

        {# Quantity #}
        {if capability_data and capability_data.inventory and capability_data.inventory.quantity is not null}
        <div class="ark-stock-meta ark-stock-meta--card">
            {capability_data.inventory.quantity} available
        </div>
        {/if}

        {if row.price}
        <div class="ark-card__price ark-card__price--tight">{row.price}</div>
        {/if}
    </div>
</article>
