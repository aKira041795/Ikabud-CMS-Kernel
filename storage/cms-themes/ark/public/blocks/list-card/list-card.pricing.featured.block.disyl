{# ARK: List Card Block — Pricing Featured (Phase 4)
    Context: entity, row, capability_data, entity_presentation
    Highlighted card with "Best Value" or "Featured" ribbon badge.
    Prominent pricing display for featured/commercial products. #}

<article class="ark-card ark-card--featured-pricing">
    {# Featured ribbon #}
    {if capability_data and capability_data.pricing and capability_data.pricing.featured_badge}
    <div class="ark-pricing-ribbon">
        {capability_data.pricing.featured_badge}
    </div>
    {else if row.featured}
    <div class="ark-pricing-ribbon">
        Featured
    </div>
    {/if}

    {if row.image or row.featured_image_url or row.thumbnail_url}
    <a href="{row.url|default:'#'}" class="ark-card__image-link" aria-hidden="true" tabindex="-1">
        <img
            src="{row.image|default:row.featured_image_url|default:row.thumbnail_url}"
            alt="{row.title|default:row.name|default:''}"
            class="ark-card__image"
            loading="lazy"
        />
    </a>
    {/if}
    <div class="ark-card__body">
        <h3 class="ark-card__title">
            {if row.url}<a href="{row.url}">{/if}
            {row.title|default:row.name|default:row.label|default:'Untitled'}
            {if row.url}</a>{/if}
        </h3>
        {if row.excerpt or row.description}
        <p class="ark-card__excerpt">
            {row.excerpt|default:row.description}
        </p>
        {/if}

        {# Featured pricing — larger, highlight color #}
        {if capability_data and capability_data.pricing}
        <div class="ark-pricing-featured-copy">
            <div class="ark-pricing-amount ark-pricing-amount--featured-card">
                {capability_data.pricing.currency|default:'$'}{capability_data.pricing.price|number_format:2}
            </div>
            {if capability_data.pricing.description}
            <p class="ark-pricing-description ark-pricing-description--card">{capability_data.pricing.description}</p>
            {/if}
        </div>
        {else if row.price}
        <div class="ark-card__price ark-pricing-amount ark-pricing-amount--featured-fallback">{row.price}</div>
        {/if}

        {# CTA #}
        {if row.url}
        <a href="{row.url}" class="ark-btn ark-btn--primary ark-pricing-cta__button ark-pricing-cta__button--card">
            View Details
        </a>
        {/if}
    </div>
</article>
