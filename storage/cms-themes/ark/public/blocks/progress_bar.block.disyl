{# ARK: Progress Bar Block Alias
   Context: entity, capability_data, entity_presentation
   Builder-facing progress bar alias for ark.blocks.progress_bar. #}

<div>
    <div class="ark-progress-row ark-progress-row--tight">
        <span class="ark-progress-label ark-progress-label--regular">{capability_data.progress_tracking.label|default:'Progress'}</span>
        <span class="ark-progress-value">{capability_data.progress_tracking.percentage|default:0}%</span>
    </div>
    <div class="ark-progress-track">
        <div class="ark-progress-fill ark-progress-fill--square" style="width:{capability_data.progress_tracking.percentage|default:0}%;"></div>
    </div>
</div>
