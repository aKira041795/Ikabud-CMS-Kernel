{# ARK: Progress Bar Block Alias
   Context: entity, capability_data, entity_presentation
   Builder-facing progress bar alias for ark.blocks.progress_bar. #}

<div>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.35rem;">
        <span style="font-size:0.875rem;color:var(--color-text);">{capability_data.progress_tracking.label|default:'Progress'}</span>
        <span style="font-size:0.8rem;color:var(--color-text-secondary);">{capability_data.progress_tracking.percentage|default:0}%</span>
    </div>
    <div style="background:var(--color-surface-muted);border-radius:999px;height:8px;overflow:hidden;">
        <div style="width:{capability_data.progress_tracking.percentage|default:0}%;height:100%;background:var(--color-primary);"></div>
    </div>
</div>
