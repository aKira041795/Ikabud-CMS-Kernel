{# ARK: Table Block Alias
   Context: entity, capability_data, entity_presentation
   Builder-facing table alias for ark.blocks.table. #}

<div class="ark-table-wrap">
    <table class="ark-table">
        {if capability_data.table.headers|default:[]}
        <thead>
            <tr>
                {for header in capability_data.table.headers}
                <th class="ark-table__head">{header}</th>
                {/for}
            </tr>
        </thead>
        {/if}
        <tbody>
            {for row in capability_data.table.rows|default:[]}
            <tr>
                {for cell in row}
                <td class="ark-table__cell">{cell}</td>
                {/for}
            </tr>
            {/for}
        </tbody>
    </table>
</div>
