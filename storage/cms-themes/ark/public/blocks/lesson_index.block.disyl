{# ARK: Lesson Index Block Alias
   Context: entity, capability_data, entity_presentation
   Builder-facing lesson index alias for ark.blocks.lesson_index. #}

<ol style="list-style:none;padding:0;margin:0;display:grid;gap:var(--spacing-xs);">
    {for lesson in capability_data.lessons.items|default:capability_data.lessons|default:[]}
    <li style="padding:var(--spacing-sm);border:1px solid var(--color-border-subtle);border-radius:var(--radius-md);">{lesson.title|default:'Lesson'}</li>
    {/for}
</ol>
