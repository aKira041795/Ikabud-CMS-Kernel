{# ARK: Lessons Block (Phase 4)
    Context: entity, capability_data
    Ordered lesson/course index with completion badges. #}

{ikb_panel tone="surface" spacing="md" radius="md"}
    <h3 class="ark-lesson-list__heading">
        {capability_data.lessons.label|default:'Course Content'}
    </h3>
    <ol class="ark-simple-list">
        {for lesson in capability_data.lessons.items}
        <li class="ark-lesson-list__item">
            {if lesson.completed}
            <span class="ark-lesson-list__marker ark-lesson-list__marker--complete">&#x2713;</span>
            {else}
            <span class="ark-lesson-list__marker ark-lesson-list__marker--pending">{loop.index}</span>
            {/if}
            <div>
                <div class="ark-lesson-list__title">{lesson.title}</div>
                {if lesson.duration}
                <div class="ark-lesson-list__meta">{lesson.duration}</div>
                {/if}
            </div>
        </li>
        {/for}
    </ol>
{/ikb_panel}
