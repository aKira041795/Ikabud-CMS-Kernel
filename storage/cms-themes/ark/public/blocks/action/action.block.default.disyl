{# ARK: Action Strip — Default (Phase 4)
    Context: entity, capability_data, entity_presentation
    Full action strip with primary and secondary CTAs. #}

{ikb_panel tone="muted" spacing="md" radius="md"}
    <div class="ark-action-group">
        {for action in capability_data.actions}
            {if action.primary}
            <a href="{action.url|default:'#'}" class="ark-btn ark-btn--primary">
                {action.label|default:'Action'}
            </a>
            {else}
            <a href="{action.url|default:'#'}" class="ark-btn ark-btn--outline">
                {action.label|default:'Action'}
            </a>
            {/if}
        {/for}
    </div>
{/ikb_panel}
