{# ARK: Meta Block (Phase 4)
   Author, date, type badge, and reading time. #}

<div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.5rem;font-size:0.85rem;color:var(--color-text-secondary);">
    {if entity.author_name}
    <span>By {entity.author_name}</span>
    {/if}
    {if entity.published_at}
    <span>&middot; {entity.published_at}</span>
    {/if}
    {if entity.type}
    <span class="ikb-badge ikb-badge--primary" style="display:inline-block;padding:0.15rem 0.5rem;border-radius:999px;font-size:0.7rem;font-weight:600;background:var(--color-primary-light);color:var(--color-primary);">{entity.type}</span>
    {/if}
    {if entity.reading_time}
    <span>&middot; {entity.reading_time} min read</span>
    {/if}
</div>
