{# ARK: Progress Block — Default (Phase 4)
    Context: entity, capability_data, entity_presentation
    Full progress bar with percentage and label. #}

{ikb_panel tone="surface" spacing="md" radius="md"}
    <div class="ark-progress-row">
        <span class="ark-progress-label">
            {capability_data.progress_tracking.label|default:'Progress'}
        </span>
        <span class="ark-progress-value">
            {capability_data.progress_tracking.percentage|default:0}%
        </span>
    </div>
    <div class="ark-progress-track">
        <div class="ark-progress-fill" style="width:{capability_data.progress_tracking.percentage|default:0}%;"></div>
    </div>
    {if capability_data.progress_tracking.detail}
    <p class="ark-progress-detail">{capability_data.progress_tracking.detail}</p>
    {/if}
{/ikb_panel}
