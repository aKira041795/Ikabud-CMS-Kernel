{# ARK: Hero Block Alias
   Context: entity, capability_data, entity_presentation
   Builder-facing hero alias for ark.blocks.hero. #}

<section class="ark-hero-block">
    <h2 class="ark-hero-block__title">
        {capability_data.hero.title|default:entity.title|default:page_title|default:'Hero Title'}
    </h2>
    {if capability_data.hero.subtitle|default:entity.excerpt|default:''}
    <p class="ark-hero-block__subtitle">
        {capability_data.hero.subtitle|default:entity.excerpt}
    </p>
    {/if}
    {if capability_data.hero.cta_url|default:''}
    <a href="{capability_data.hero.cta_url}" class="ark-btn ark-btn--primary ark-btn--md">{capability_data.hero.cta_label|default:'Learn More'}</a>
    {/if}
</section>
