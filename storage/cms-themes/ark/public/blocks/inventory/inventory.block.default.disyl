{# ARK: Inventory Block — Default (Phase 4)
    Context: entity, capability_data, entity_presentation
    Full stock status with badge, quantity, and low-stock warning. #}

{ikb_panel tone="surface" spacing="md" radius="md"}
    <div class="ark-stock-row">
        {if capability_data.inventory.in_stock}
        <span class="ark-badge ark-badge--success ark-stock-badge">
            <span class="ark-stock-dot ark-stock-dot--success"></span>
            In Stock
        </span>
        {else}
        <span class="ark-badge ark-badge--danger ark-stock-badge">
            <span class="ark-stock-dot ark-stock-dot--danger"></span>
            Out of Stock
        </span>
        {/if}
        {if capability_data.inventory.quantity is not null}
        <span class="ark-stock-meta">
            {capability_data.inventory.quantity} available
        </span>
        {/if}
    </div>
    {if capability_data.inventory.low_stock_threshold is not null and capability_data.inventory.quantity <= capability_data.inventory.low_stock_threshold}
    <p class="ark-stock-warning">
        Low stock &mdash; order soon
    </p>
    {/if}
{/ikb_panel}
