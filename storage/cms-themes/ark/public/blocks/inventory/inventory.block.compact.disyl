{# ARK: Inventory Block — Compact (Phase 4)
    Context: entity, capability_data, entity_presentation
    Minimal stock indicator — dot + label. #}

<span class="ark-stock-inline">
    {if capability_data.inventory.in_stock}
    <span class="ark-stock-dot ark-stock-dot--success ark-stock-dot--sm"></span>
    In Stock
    {else}
    <span class="ark-stock-dot ark-stock-dot--danger ark-stock-dot--sm"></span>
    Out of Stock
    {/if}
</span>
