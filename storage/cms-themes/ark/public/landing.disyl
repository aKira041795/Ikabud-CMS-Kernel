{# ARK: Landing Page Template (Phase 3)
   Minimal shell — no header, no footer, full-viewport hero focus.
   Use for marketing landing pages, coming-soon, or standalone campaigns. #}

{extends "_cms_active_theme/layouts/public.disyl"}

{set show_header = false}
{set show_footer = false}
{set sidebar_region_present_override = false}
{set show_sidebar = false}

{block head}
{include "partials/canonical-entity-styles.disyl"}
{if structured_data}{structured_data|raw}{/if}
{/block}

{block content}
<article class="ark-entity-view ark-landing" data-ark-template="landing">
    {# Hero section — full viewport #}
    <div class="ark-landing__hero">
        {# Optional logo #}
        {if site_logo_url}
        <img src="{site_logo_url}" alt="{site_title|default:'ARK'}" class="ark-landing__logo" loading="lazy" />
        {/if}

        {# Headline #}
        <h1 class="ark-landing__title">
            {entity_view_context.header_title|default:entity.title|default:page_title|default:'Welcome'}
        </h1>

        {# Subheadline #}
        {if entity.excerpt or entity.description}
        <p class="ark-landing__subtitle">
            {entity.excerpt|default:entity.description}
        </p>
        {/if}

        {# CTA buttons #}
        {if cta_primary_url}
        <div class="ark-action-group ark-action-group--centered ark-action-group--landing">
            <a href="{cta_primary_url}" class="ark-btn ark-btn--primary ark-btn--lg">
                {cta_primary_label|default:'Get Started'}
            </a>
            {if cta_secondary_url}
            <a href="{cta_secondary_url}" class="ark-btn ark-btn--outline ark-btn--lg">
                {cta_secondary_label|default:'Learn More'}
            </a>
            {/if}
        </div>
        {/if}
    </div>

    {# Body content (builder sections below the fold) #}
    {if post_html or entity.body or body}
    <div class="ark-detail__body ark-content ark-landing__body">
        {if builder_enabled}{post_html|raw}
        {else if post_html}{post_html|raw}
        {else if entity.body}{entity.body|raw}
        {else if body}{body|raw}
        {/if}
    </div>
    {/if}
</article>
{/block}
