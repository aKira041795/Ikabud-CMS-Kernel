{# ARK: Blog Single Post Template (Phase 3)
   Extends entity view patterns for individual blog posts.
   Includes meta, featured image, body content, and navigation. #}

{extends "_cms_active_theme/layouts/public.disyl"}

{block head}
{include "partials/canonical-entity-styles.disyl"}
{if structured_data}{structured_data|raw}{/if}
{/block}

{block content}
<article class="ark-entity-view ark-single" data-ark-template="single">
    {# Title #}
    <h1 class="ark-detail__title">{entity.title|default:post_title|default:page_title}</h1>

    {# Meta block #}
    <div class="ark-detail__meta">
        {if entity.author_name}
        <span>By {entity.author_name}</span>
        {/if}
        {if entity.published_at}
        <span>&middot; {entity.published_at}</span>
        {/if}
        {if entity.category_name}
        <a href="{entity.category_url|default:'#'}" class="ark-card__badge" style="text-decoration:none;">{entity.category_name}</a>
        {/if}
        {if entity.reading_time}
        <span>&middot; {entity.reading_time} min read</span>
        {/if}
    </div>

    {# Featured image #}
    {if entity.featured_image_url or entity.image}
    <img
        src="{entity.featured_image_url|default:entity.image}"
        alt="{entity.title|default:''}"
        style="width:100%;max-height:480px;object-fit:cover;border-radius:var(--radius-md);margin-bottom:var(--spacing-lg);"
        loading="eager"
    />
    {/if}

    {# Body content #}
    <div class="ark-detail__body ark-content">
        {if post_html}{post_html|raw}
        {else if entity.body}{entity.body|raw}
        {else if body}{body|raw}
        {/if}
    </div>

    {# Post navigation #}
    <nav style="display:flex;justify-content:space-between;gap:1rem;margin-top:var(--spacing-xl);padding-top:var(--spacing-md);border-top:1px solid var(--color-border);" aria-label="Post navigation">
        {if prev_post}
        <a href="{prev_post.url}" style="color:var(--color-primary);font-weight:500;font-size:0.875rem;text-decoration:none;">&larr; {prev_post.title}</a>
        {else}
        <span></span>
        {/if}
        {if next_post}
        <a href="{next_post.url}" style="color:var(--color-primary);font-weight:500;font-size:0.875rem;text-decoration:none;text-align:right;">{next_post.title} &rarr;</a>
        {else}
        <span></span>
        {/if}
    </nav>

    {# Related posts via slot #}
    {ikb_slot name="content.after" /}
</article>
{/block}
