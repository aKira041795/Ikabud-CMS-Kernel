{# ARK: Entity List Template (Phase 3)
   Generic entity list with card, table, and compact views.
   Uses governed {ikb_entity_list} for data resolution.
   Module-agnostic — renders any entity type through fallback views (Phase 4). #}

{extends "_cms_active_theme/layouts/public.disyl"}

{set is_ecommerce_public = is_ecommerce_public|default:false}
{set is_ecommerce_entity_route = is_ecommerce_entity_route|default:false}
{set entity_view_context = entity_view_context|default:[]}

{block head}
{include "partials/canonical-entity-styles.disyl"}
{if is_ecommerce_public or is_ecommerce_entity_route}
{include "partials/storefront-styles.disyl"}
{/if}
{if structured_data}{structured_data|raw}{/if}
{/block}

{block content}
{ikb_section padding="large"}
    {ikb_container size="xlarge"}

        {# Page header #}
        {if page_title}
        <header class="ark-page-intro">
            <h1 class="ark-page-title">{page_title}</h1>
            {if list_description}
            <p class="ark-page-intro__description">{list_description}</p>
            {/if}
        </header>
        {/if}

        {# CMS blog / archive / tag / search via governed entity list #}
        {if public_route_kind == 'blog-home' or public_route_kind == 'archive' or public_route_kind == 'tag' or public_route_kind == 'search'}

            {# Active filter summary #}
            {if entity_list_context.result_label or entity_list_context.category_name or entity_list_context.search}
            <div class="ark-filter-summary">
                {if entity_list_context.result_label}
                <span class="ark-filter-summary__label">{entity_list_context.result_label}</span>
                {/if}
                {if entity_list_context.category_name}
                <span class="ark-badge ark-badge--primary ark-filter-summary__pill">
                    {entity_list_context.category_name}
                    {if entity_list_context.all_items_url}
                    <a href="{entity_list_context.all_items_url}" class="ark-filter-summary__clear" title="Clear filter">&times;</a>
                    {/if}
                </span>
                {/if}
                {if entity_list_context.search}
                <span class="ark-badge ark-badge--warning ark-filter-summary__pill">
                    &ldquo;{entity_list_context.search}&rdquo;
                </span>
                {/if}
            </div>
            {/if}

            {# Governed entity list — kernel resolves data, theme presents #}
            {ikb_entity_list source="cms_post.recent" view="{entity_view|default:'card_grid'}" limit="10" /}

            {# Pagination #}
            {if pagination and pagination.total > 1}
            <nav class="ark-pagination" aria-label="Pagination">
                {if pagination.prev_url}
                <a href="{pagination.prev_url}" class="ark-btn ark-btn--outline ark-btn--sm">&larr; Previous</a>
                {/if}
                <span class="ark-pagination__status">Page {pagination.current} of {pagination.total}</span>
                {if pagination.next_url}
                <a href="{pagination.next_url}" class="ark-btn ark-btn--outline ark-btn--sm">Next &rarr;</a>
                {/if}
            </nav>
            {/if}

        {# Pure entity-view context (any module, any entity type) #}
        {else if entity_type}
            {if entity_list_context.result_label}
            <p class="ark-page-intro__result">{entity_list_context.result_label}</p>
            {/if}
            {ikb_entity_list
                source="{entity_type}.{qualifier|default:'recent'}"
                view="{entity_view|default:'card_grid'}"
                limit="{entity_limit|default:12}"
            /}

        {# Discovery dashboard (no context — show sample sections) #}
        {else}
            {ikb_section padding="medium"}
                <h2 class="ark-page-section-title">Latest Articles</h2>
                {ikb_entity_list source="cms_post.recent" view="card_grid" limit="6" /}
            {/ikb_section}

            {ikb_section padding="medium"}
                <h2 class="ark-page-section-title">Featured Products</h2>
                {ikb_entity_list source="ecommerce_product.featured" view="card_grid" limit="4" /}
            {/ikb_section}
        {/if}

    {/ikb_container}
{/ikb_section}
{/block}
