{# ARK: 404 Not Found #}

{set site_title = site_title|default:'ARK Theme'}
{set site_tagline = site_tagline|default:'A governed application platform.'}
{set current_year = current_year|default:'2026'}
{set footer_columns = footer_columns|default:3}
{set page_title = page_title|default:'Page Not Found'}
{set page_description = page_description|default:''}
{set cms_public_css_url = cms_public_css_url|default:'/assets/cms/cms-public.css'}

{extends "_cms_active_theme/layouts/public.disyl"}

{block content}
{ikb_section padding="xlarge"}
    {ikb_container size="small" center=true}
        <div class="ark-not-found">
            <div class="ark-not-found__code">404</div>
            <h1 class="ark-not-found__title">{not_found_title|default:'Page not found'}</h1>
            <p class="ark-not-found__body">{not_found_body|default:'The page you requested could not be found or may have moved.'}</p>
            <div class="ark-action-group ark-action-group--centered">
                <a href="{not_found_primary_href|default:'/'}" class="ark-btn ark-btn--primary">{not_found_primary_label|default:'Go to Home'}</a>
                <a href="{not_found_secondary_href|default:'/blog'}" class="ark-btn ark-btn--outline">{not_found_secondary_label|default:'Browse Posts'}</a>
            </div>
        </div>
    {/ikb_container}
{/ikb_section}
{/block}
