{# ARK: Home Page (Phase 3)
   Pure entity-view driven home page.
   Every section uses governed ikb_* components.
   No module-specific handler calls. #}

{extends "_cms_active_theme/layouts/public.v3.disyl"}

{block content}
{# Hero section — using governed components #}
{ikb_section padding="xlarge" background="white"}
    {ikb_container size="small" center=true}
        <div class="ark-hero-block--centered">
            <h1 class="ark-page-title ark-page-title--hero">
                {site_title|default:'Welcome to ARK'}
            </h1>
            <p class="ark-result-summary ark-result-summary--hero">
                {site_tagline|default:'The reference theme demonstrating Kernel OS 6.1 + DiSyL 4.7.'}
            </p>
            <div class="ark-list-toolbar ark-list-toolbar--centered">
                <a href="{base_url}/blog" class="ark-btn ark-btn--primary">Read Articles</a>
                <a href="{base_url}/ecommerce/shop" class="ark-btn ark-btn--secondary">Browse Products</a>
            </div>
        </div>
    {/ikb_container}
{/ikb_section}

{# Recent Articles — module-agnostic, renders empty if CMS not installed #}
{ikb_section padding="large" background="surface"}
    {ikb_container size="xlarge"}
        <div class="ark-list-toolbar">
            <h2 class="en-view-title">Latest Articles</h2>
            <a href="{base_url}/blog" class="ark-btn ark-btn--ghost ark-btn--sm">View all &rarr;</a>
        </div>
        {ikb_entity_list source="cms_post.recent" view="card_grid" limit="6" /}
    {/ikb_container}
{/ikb_section}

{# Featured Products — renders empty if ecommerce not installed #}
{ikb_section padding="large" background="muted"}
    {ikb_container size="xlarge"}
        <div class="ark-list-toolbar">
            <h2 class="en-view-title">Featured Products</h2>
            <a href="{base_url}/ecommerce/shop" class="ark-btn ark-btn--ghost ark-btn--sm">Shop all &rarr;</a>
        </div>
        {ikb_entity_list source="ecommerce_product.featured" view="card_grid" limit="4" /}
    {/ikb_container}
{/ikb_section}

{# Slot contributions from modules (e.g., Theme Studio elements) #}
{ikb_slot name="content.after" /}
{/block}
