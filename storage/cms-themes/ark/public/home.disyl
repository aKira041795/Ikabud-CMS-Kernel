{# ARK: Home Page (Phase 3)
   Pure entity-view driven home page.
   Every section uses governed ikb_* components.
   No module-specific handler calls. #}

{extends "_cms_active_theme/layouts/public.disyl"}

{block content}
{# Hero section — using governed components #}
{ikb_section padding="xlarge" background="white"}
    {ikb_container size="small" center=true}
        <div style="text-align:center;">
            <h1 style="font-size:clamp(1.8rem,5vw,3rem);font-weight:800;letter-spacing:-0.03em;line-height:1.1;margin:0 0 var(--spacing-md);">
                {site_title|default:'Welcome to ARK'}
            </h1>
            <p style="font-size:1.1rem;color:var(--color-text-secondary);max-width:600px;margin:0 auto var(--spacing-lg);line-height:1.6;">
                {site_tagline|default:'The reference theme demonstrating Kernel OS 6.1 + DiSyL 4.7.'}
            </p>
            <div style="display:flex;gap:0.75rem;justify-content:center;">
                <a href="{base_url}/blog" class="ark-btn ark-btn--primary ark-btn--md" style="display:inline-block;padding:0.5rem 1.5rem;background:var(--color-primary);color:#fff;border-radius:var(--radius-md);text-decoration:none;font-weight:500;">Read Articles</a>
                <a href="{base_url}/ecommerce/shop" class="ark-btn ark-btn--outline ark-btn--md" style="display:inline-block;padding:0.5rem 1.5rem;border:2px solid var(--color-primary);color:var(--color-primary);border-radius:var(--radius-md);text-decoration:none;font-weight:500;">Browse Products</a>
            </div>
        </div>
    {/ikb_container}
{/ikb_section}

{# Recent Articles — module-agnostic, renders empty if CMS not installed #}
{ikb_section padding="large" background="surface"}
    {ikb_container size="xlarge"}
        <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:var(--spacing-md);">
            <h2 style="font-size:1.5rem;font-weight:700;margin:0;">Latest Articles</h2>
            <a href="{base_url}/blog" style="color:var(--color-primary);font-weight:500;font-size:0.875rem;">View all &rarr;</a>
        </div>
        {ikb_entity_list source="cms_post.recent" view="card_grid" limit="6" /}
    {/ikb_container}
{/ikb_section}

{# Featured Products — renders empty if ecommerce not installed #}
{ikb_section padding="large" background="muted"}
    {ikb_container size="xlarge"}
        <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:var(--spacing-md);">
            <h2 style="font-size:1.5rem;font-weight:700;margin:0;">Featured Products</h2>
            <a href="{base_url}/ecommerce/shop" style="color:var(--color-primary);font-weight:500;font-size:0.875rem;">Shop all &rarr;</a>
        </div>
        {ikb_entity_list source="ecommerce_product.featured" view="card_grid" limit="4" /}
    {/ikb_container}
{/ikb_section}

{# Slot contributions from modules (e.g., Theme Studio elements) #}
{ikb_slot name="content.after" /}
{/block}
