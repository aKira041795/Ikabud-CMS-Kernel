{# ARK: Standard Page Template #}

{extends "_cms_active_theme/layouts/public.disyl"}

{block content}
{ikb_section padding="large"}
    {ikb_container size="medium"}
        {if page_title}
        <h1 style="font-size:2rem;font-weight:700;margin:0 0 var(--spacing-md);">{page_title}</h1>
        {/if}
        {if body}{body|raw}{/if}
    {/ikb_container}
{/ikb_section}
{/block}
