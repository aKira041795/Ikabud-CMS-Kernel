{# ARK: Standard Page Template #}

{extends "_cms_active_theme/layouts/public.v3.disyl"}

{block content}
{ikb_section padding="large"}
    {ikb_container size="medium"}
        {if page_title}
        <h1 class="ark-page-title ark-page-title--standalone">{page_title}</h1>
        {/if}
        {if body}{body|raw}{/if}
    {/ikb_container}
{/ikb_section}
{/block}
