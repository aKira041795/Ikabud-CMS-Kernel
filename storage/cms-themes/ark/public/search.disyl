{# ARK: Search Results Template (Phase 3)
   Search results page with query display, filter preservation, and pagination.
   Handles empty-state gracefully. #}

{extends "_cms_active_theme/layouts/public.v3.disyl"}

{block head}
{include "partials/canonical-entity-styles.disyl"}
{/block}

{block content}
<article class="ark-entity-list" data-ark-template="search">
    {# Search header #}
    <header class="ark-page-header">
        <h1 class="ark-page-title">
            {if search_query}
            Search results for &ldquo;{search_query}&rdquo;
            {else}
            Search
            {/if}
        </h1>
    </header>

    {# Search form #}
    {include "partials/search-form.disyl"
        search_action = base_url
        search_placeholder = 'Search articles, products, pages...'
    }

    {# Result summary #}
    {if search_query}
    <p class="ark-result-summary">
        {if result_count > 0}
        Found {result_count} {result_label|default:'result(s)'} for &ldquo;{search_query}&rdquo;
        {else}
        No results found for &ldquo;{search_query}&rdquo;
        {/if}
    </p>
    {/if}

    {# Entity list — mixed entity types from search #}
    {if search_query and result_count > 0}
        {ikb_entity_list source="cms_post.search" view="{entity_view|default:'card_grid'}" limit="20" /}
        {include "partials/pagination.disyl"}
    {/if}

    {# Empty state with suggestions #}
    {if search_query and result_count == 0}
    <div class="ark-empty">
        <div class="ark-empty__icon">&#x1F50D;</div>
        <div class="ark-empty__text">No results found. Try a different search term.</div>
        <div>
            <a href="{base_url}/blog" class="ark-btn ark-btn--ghost ark-btn--sm">Browse all articles &rarr;</a>
        </div>
    </div>
    {/if}

    {# Pre-search prompt #}
    {if not search_query}
    <div class="ark-empty">
        <div class="ark-empty__icon">&#x1F50D;</div>
        <div class="ark-empty__text">Enter a search term above to find content.</div>
    </div>
    {/if}
</article>
{/block}
