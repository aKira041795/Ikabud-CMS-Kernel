{# ARK: Storefront Styles Partial (Phase 8 — Multi-Surface)
   Commerce-specific styles used on ecommerce routes (shop, product detail, cart).
   Token-driven — all values reference CSS custom properties. #}

<style>
    /* ── Store banner hero ── */
    .ark-store-hero {
        background: var(--color-primary-light, #eef2ff);
        border-radius: var(--radius-lg, 1rem);
        padding: var(--spacing-lg, 2rem);
        margin-bottom: var(--spacing-lg, 2rem);
        display: flex;
        align-items: center;
        gap: var(--spacing-md, 1.25rem);
    }

    .ark-store-hero__avatar {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        object-fit: cover;
        background: var(--color-surface-muted, #f8fafc);
        flex-shrink: 0;
    }

    .ark-store-hero__title {
        font-size: 1.3rem;
        font-weight: 700;
        margin: 0;
        color: var(--color-text, #0f172a);
    }

    .ark-store-hero__meta {
        font-size: 0.85rem;
        color: var(--color-text-secondary, #475569);
        margin-top: 0.25rem;
    }

    /* ── Product grid (commerce) ── */
    .ark-product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: var(--spacing-md, 1.25rem);
    }

    /* ── Cart link icon ── */
    .ark-header__cart {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--color-text-secondary, #475569);
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        padding: 0.35rem 0.75rem;
        border-radius: var(--radius-sm, 0.375rem);
        transition: all 0.12s;
    }

    .ark-header__cart:hover {
        color: var(--color-primary, #6366f1);
        background: var(--color-primary-light, #eef2ff);
    }

    .ark-header__cart-count {
        font-weight: 700;
        color: var(--color-primary, #6366f1);
    }

    /* ── Store hours panel ── */
    .ark-store-hours {
        background: var(--color-surface-muted, #f8fafc);
        border: 1px solid var(--color-border, #e2e8f0);
        border-radius: var(--radius-md, 0.75rem);
        padding: var(--spacing-md, 1.25rem);
        font-size: 0.85rem;
    }

    .ark-store-hours__heading {
        font-size: 0.95rem;
        font-weight: 600;
        margin: 0 0 0.5rem;
        color: var(--color-text, #0f172a);
    }

    .ark-store-hours__row {
        display: flex;
        justify-content: space-between;
        padding: 0.25rem 0;
        color: var(--color-text-secondary, #475569);
    }

    /* ── Print overrides (commerce-specific) ── */
    @media print {
        .ark-store-hero,
        .ark-store-hours {
            border: 1px solid #ccc;
            background: none;
            box-shadow: none;
        }
    }
</style>
