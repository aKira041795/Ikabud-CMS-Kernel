{# ARK: Canonical Entity Styles Partial (Phase 8 — Multi-Surface)
   Shared CSS variables and base entity rendering styles.
   Included by entity.list, entity.view, archive, single, search templates.
   Token-driven — all values reference CSS custom properties from tokens.json. #}

<style>
    /* ── Entity list shell ── */
    .ark-entity-list,
    .ark-entity-view {
        width: 100%;
        padding: 0;
    }

    /* ── Card grid ── */
    .ark-card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: var(--spacing-md, 1.25rem);
    }

    @media (max-width: 640px) {
        .ark-card-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ── Entity card ── */
    .ark-card {
        background: var(--color-surface, #fff);
        border: 1px solid var(--color-border, #e2e8f0);
        border-radius: var(--radius-md, 0.75rem);
        overflow: hidden;
        transition: box-shadow 0.15s ease, transform 0.15s ease;
    }

    .ark-card:hover {
        box-shadow: var(--shadow-md, 0 4px 6px rgba(0,0,0,0.07));
        transform: translateY(-1px);
    }

    .ark-card__image {
        width: 100%;
        height: 200px;
        object-fit: cover;
        background: var(--color-surface-muted, #f8fafc);
    }

    .ark-card__body {
        padding: var(--spacing-md, 1.25rem);
    }

    .ark-card__title {
        font-size: 1.05rem;
        font-weight: 600;
        margin: 0 0 0.35rem;
        color: var(--color-text, #0f172a);
    }

    .ark-card__title a {
        color: inherit;
        text-decoration: none;
    }

    .ark-card__title a:hover {
        color: var(--color-primary, #6366f1);
    }

    .ark-card__excerpt {
        font-size: 0.875rem;
        color: var(--color-text-secondary, #475569);
        margin: 0 0 0.5rem;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .ark-card__price {
        font-weight: 700;
        color: var(--color-primary, #6366f1);
        font-size: 1.1rem;
    }

    .ark-card__badge {
        display: inline-block;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        background: var(--color-surface-muted, #f8fafc);
        color: var(--color-text-secondary, #475569);
    }

    .ark-card__meta {
        font-size: 0.8rem;
        color: var(--color-text-secondary, #475569);
        margin-top: 0.5rem;
    }

    /* ── Detail view ── */
    .ark-detail {
        max-width: 800px;
    }

    .ark-detail__title {
        font-size: 2rem;
        font-weight: 700;
        margin: 0 0 var(--spacing-sm, 0.75rem);
        letter-spacing: -0.02em;
        color: var(--color-text, #0f172a);
        line-height: 1.2;
    }

    .ark-detail__meta {
        color: var(--color-text-secondary, #475569);
        font-size: 0.875rem;
        margin-bottom: var(--spacing-md, 1.25rem);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
    }

    .ark-detail__body {
        line-height: 1.75;
        color: var(--color-text, #0f172a);
    }

    .ark-content p { margin: 0 0 1rem; }
    .ark-content h2 { margin: 2rem 0 0.75rem; font-size: 1.4rem; font-weight: 700; }
    .ark-content h3 { margin: 1.5rem 0 0.5rem; font-size: 1.15rem; font-weight: 600; }
    .ark-content img { max-width: 100%; border-radius: var(--radius-md, 0.75rem); margin: 1rem 0; }
    .ark-content blockquote { border-left: 4px solid var(--color-primary, #6366f1); padding: 0.5rem 1rem; margin: 1rem 0; background: var(--color-surface-muted, #f8fafc); border-radius: 0 var(--radius-md, 0.75rem) var(--radius-md, 0.75rem) 0; }
    .ark-content a { color: var(--color-primary, #6366f1); text-decoration: underline; }
    .ark-content ul, .ark-content ol { padding-left: 1.5rem; margin: 0 0 1rem; }
    .ark-content li { margin-bottom: 0.4rem; }

    /* ── Empty state ── */
    .ark-empty {
        text-align: center;
        padding: var(--spacing-xl, 3rem);
        color: var(--color-text-secondary, #475569);
    }

    .ark-empty__icon {
        font-size: 2.5rem;
        margin-bottom: var(--spacing-sm, 0.75rem);
    }

    /* ── Page title ── */
    .ark-page-title {
        font-size: 1.75rem;
        font-weight: 700;
        margin: 0 0 0.5rem;
        color: var(--color-text, #0f172a);
    }

    /* ── Print overrides (Phase 8 — Multi-Surface) ── */
    @media print {
        .ark-header,
        .ark-footer,
        .ark-sidebar-region,
        .ark-topbar,
        .ark-pagination,
        .ark-btn,
        .ark-search-form,
        .ark-skip {
            display: none !important;
        }

        .ark-content-area {
            display: block;
            max-width: 100%;
        }

        .ark-main {
            padding: 0;
        }

        body {
            font-size: 12pt;
            color: #000;
            background: #fff;
        }

        a {
            color: #000;
            text-decoration: underline;
        }
    }
</style>
