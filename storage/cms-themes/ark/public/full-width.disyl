{# ARK: Full-Width Page Template (Phase 3)
   Full-width layout — no sidebar, content spans the entire container.
   Use for landing-style pages, wide tables, or media-rich content. #}

{extends "_cms_active_theme/layouts/public.disyl"}

{set sidebar_region_present_override = false}
{set show_sidebar = false}

{block head}
{include "partials/canonical-entity-styles.disyl"}
{if structured_data}{structured_data|raw}{/if}
{/block}

{block content}
<article class="ark-entity-view ark-entity-view--full" data-ark-template="full-width">
    {# Header #}
    {if entity_view_context.show_header|default:1}
    <header class="ark-page-intro">
        <h1 class="ark-detail__title">{entity_view_context.header_title|default:entity.title|default:page_title}</h1>
        {if entity_view_context.show_meta|default:1}
        <div class="ark-detail__meta">
            {include "blocks/meta.block.disyl"}
        </div>
        {/if}
    </header>
    {/if}

    {# Featured image — full-width #}
    {if entity.featured_image_url or entity.image}
    <img
        src="{entity.featured_image_url|default:entity.image}"
        alt="{entity.title|default:''}"
        class="ark-detail__image ark-detail__image--hero"
        loading="lazy"
    />
    {/if}

    {# Body — full-width, unconstrained #}
    <div class="ark-detail__body ark-content ark-detail__body--wide">
        {if builder_enabled}
        <div class="{builder_page_settings.container_class|default:''}">
            {post_html|raw}
        </div>
        {else if post_html}{post_html|raw}
        {else if entity.body}{entity.body|raw}
        {else if body}{body|raw}
        {/if}
    </div>
</article>
{/block}
