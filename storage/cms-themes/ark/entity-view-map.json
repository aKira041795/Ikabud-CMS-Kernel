{
    "version": "3.0.0",
    "description": "ARK cross-module entity presentation contract map. V3 extends with guidance, attendance-wage, and pal module entity types.",
    "entity_views": {
        "cms_post": {
            "card_grid": {
                "fields": [
                    "title",
                    "excerpt",
                    "featured_image_url",
                    "published_at"
                ],
                "actions": [
                    "view"
                ]
            },
            "detail": {
                "fields": [
                    "title",
                    "body",
                    "author_name",
                    "published_at",
                    "featured_image_url"
                ],
                "actions": [
                    "view"
                ]
            }
        },
        "ecommerce_product": {
            "compact": {
                "fields": [
                    "name",
                    "price",
                    "image",
                    "stock_status"
                ],
                "actions": [
                    "view",
                    "add_to_cart"
                ],
                "block": "product_card"
            },
            "detail": {
                "fields": [
                    "name",
                    "price",
                    "images",
                    "description",
                    "stock_status"
                ],
                "actions": [
                    "add_to_cart",
                    "wishlist"
                ]
            }
        },
        "ehr_patient": {
            "compact": {
                "fields": [
                    "first_name",
                    "last_name",
                    "patient_uuid",
                    "status"
                ],
                "actions": [
                    "view"
                ],
                "block": "patient_summary"
            },
            "detail": {
                "fields": [
                    "patient_uuid",
                    "first_name",
                    "last_name",
                    "birth_date",
                    "sex",
                    "status"
                ],
                "actions": [
                    "view"
                ]
            }
        },
        "ehr_appointment": {
            "compact": {
                "fields": [
                    "patient_name",
                    "appointment_type",
                    "status",
                    "scheduled_at"
                ],
                "actions": [
                    "view"
                ],
                "block": "appointment_list"
            },
            "detail": {
                "fields": [
                    "appointment_uuid",
                    "patient_name",
                    "appointment_type",
                    "reason_for_visit",
                    "status"
                ],
                "actions": [
                    "view"
                ]
            }
        },
        "bakeshop_product": {
            "compact": {
                "fields": [
                    "name",
                    "price",
                    "unit"
                ],
                "actions": [
                    "view"
                ],
                "block": "ledger_row"
            }
        },
        "wms_stock": {
            "compact": {
                "fields": [
                    "sku",
                    "qty",
                    "location_name"
                ],
                "actions": [
                    "view"
                ],
                "block": "inventory_badge"
            },
            "table": {
                "fields": [
                    "sku",
                    "name",
                    "qty",
                    "location_name",
                    "updated_at"
                ],
                "actions": [
                    "view",
                    "move"
                ]
            }
        },
        "guidance_case": {
            "compact": {
                "fields": [
                    "title",
                    "status",
                    "assigned_to",
                    "updated_at"
                ],
                "actions": [
                    "view"
                ],
                "block": "patient_summary"
            },
            "detail": {
                "fields": [
                    "title",
                    "status",
                    "assigned_to",
                    "description",
                    "created_at",
                    "updated_at"
                ],
                "actions": [
                    "view",
                    "edit"
                ]
            }
        },
        "guidance_appointment": {
            "compact": {
                "fields": [
                    "patient_name",
                    "appointment_type",
                    "status",
                    "scheduled_at"
                ],
                "actions": [
                    "view"
                ],
                "block": "appointment_list"
            },
            "detail": {
                "fields": [
                    "appointment_uuid",
                    "patient_name",
                    "appointment_type",
                    "reason_for_visit",
                    "status",
                    "scheduled_at"
                ],
                "actions": [
                    "view"
                ]
            }
        },
        "attendance_record": {
            "compact": {
                "fields": [
                    "employee_name",
                    "date",
                    "clock_in",
                    "clock_out",
                    "status"
                ],
                "actions": [
                    "view"
                ],
                "block": "ledger_row"
            },
            "table": {
                "fields": [
                    "employee_name",
                    "date",
                    "clock_in",
                    "clock_out",
                    "hours_worked",
                    "status"
                ],
                "actions": [
                    "view",
                    "edit"
                ]
            }
        },
        "pal_project": {
            "compact": {
                "fields": [
                    "name",
                    "status",
                    "budget",
                    "deadline"
                ],
                "actions": [
                    "view"
                ],
                "block": "course_card"
            },
            "detail": {
                "fields": [
                    "name",
                    "status",
                    "description",
                    "budget",
                    "deadline",
                    "assigned_to"
                ],
                "actions": [
                    "view",
                    "edit"
                ]
            }
        },
        "pal_expense": {
            "compact": {
                "fields": [
                    "description",
                    "amount",
                    "category",
                    "date"
                ],
                "actions": [
                    "view"
                ],
                "block": "ledger_row"
            },
            "table": {
                "fields": [
                    "description",
                    "amount",
                    "category",
                    "date",
                    "approved_by"
                ],
                "actions": [
                    "view"
                ]
            }
        }
    }
}