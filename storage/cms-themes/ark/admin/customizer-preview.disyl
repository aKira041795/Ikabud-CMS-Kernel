{# ARK: Customizer Preview Frame (Phase 6)
   Live preview iframe shell for the CMS customizer.
   Receives token/variant changes via postMessage and applies them in real-time.
   Loaded inside the customizer panel iframe. #}

{extends "_cms_active_theme/layouts/admin-preview.disyl"}

{block head append}
<style>
    .ark-preview-copy {
        font-size: var(--font-size-base, 16px);
        line-height: var(--line-height, 1.6);
        color: var(--color-text-secondary);
        margin: 0;
    }

    .ark-preview-copy--hero {
        font-size: var(--font-size-3xl, 1.875rem);
        font-weight: var(--heading-weight, 700);
        line-height: 1.2;
        color: var(--color-text);
        margin: 0 0 0.5rem;
    }

    .ark-preview-copy--muted {
        font-size: var(--font-size-sm, 0.875rem);
        color: var(--color-text-muted);
    }

    .ark-preview-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
    }

    .ark-preview-swatches {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .ark-preview-swatch {
        width: 64px;
        height: 64px;
        border-radius: var(--radius-md);
        background: var(--swatch-color);
    }

    .ark-preview-swatch--bordered {
        border: 1px solid var(--color-border);
    }

    .ark-preview-card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1rem;
    }

    .ark-preview-card {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        padding: 1rem;
    }

    .ark-preview-card--elevated {
        box-shadow: var(--shadow-md);
    }

    .ark-preview-card__title {
        margin: 0 0 0.25rem;
        font-weight: 600;
        color: var(--color-text);
    }

    .ark-preview-card__text {
        margin: 0;
        font-size: 0.85rem;
        color: var(--color-text-secondary);
    }

    .ark-preview-card__price {
        margin-top: 0.5rem;
        font-weight: 700;
        color: var(--color-primary);
    }
</style>
{/block}

{block content}
<div class="ark-preview-section">
    <div class="ark-preview-section__label">Typography</div>
    <h1 class="ark-preview-copy ark-preview-copy--hero">
        {site_title|default:'ARK Theme'}
    </h1>
    <p class="ark-preview-copy">
        The quick brown fox jumps over the lazy dog. ABCDEFGHIJKLMNOPQRSTUVWXYZ.
    </p>
    <p class="ark-preview-copy ark-preview-copy--muted">
        Secondary text — smaller, muted. 0123456789.
    </p>
</div>

<div class="ark-preview-section">
    <div class="ark-preview-section__label">Color Palette</div>
    <div class="ark-preview-swatches">
        <div class="ark-preview-swatch" style="--swatch-color: var(--color-primary);" title="Primary"></div>
        <div class="ark-preview-swatch" style="--swatch-color: var(--color-primary-dark);" title="Primary Dark"></div>
        <div class="ark-preview-swatch" style="--swatch-color: var(--color-primary-light);" title="Primary Light"></div>
        <div class="ark-preview-swatch ark-preview-swatch--bordered" style="--swatch-color: var(--color-surface);" title="Surface"></div>
        <div class="ark-preview-swatch" style="--swatch-color: var(--color-surface-muted);" title="Surface Muted"></div>
        <div class="ark-preview-swatch" style="--swatch-color: var(--color-success);" title="Success"></div>
        <div class="ark-preview-swatch" style="--swatch-color: var(--color-warning);" title="Warning"></div>
        <div class="ark-preview-swatch" style="--swatch-color: var(--color-danger);" title="Danger"></div>
    </div>
</div>

<div class="ark-preview-section">
    <div class="ark-preview-section__label">Buttons</div>
    <div class="ark-preview-row">
        <a href="#" class="ark-btn ark-btn--primary">Primary</a>
        <a href="#" class="ark-btn ark-btn--secondary">Outline</a>
        <a href="#" class="ark-btn ark-btn--primary ark-btn--sm">Small</a>
    </div>
</div>

<div class="ark-preview-section">
    <div class="ark-preview-section__label">Cards</div>
    <div class="ark-preview-card-grid">
        <div class="ark-preview-card">
            <div class="ark-preview-card__title">Card Title</div>
            <div class="ark-preview-card__text">Card excerpt text for preview.</div>
            <div class="ark-preview-card__price">$49.99</div>
        </div>
        <div class="ark-preview-card ark-preview-card--elevated">
            <div class="ark-preview-card__title">Elevated Card</div>
            <div class="ark-preview-card__text">With shadow applied.</div>
        </div>
    </div>
</div>

<div class="ark-preview-section">
    <div class="ark-preview-section__label">Badges &amp; Status</div>
    <div class="ark-preview-row">
        <span class="ark-badge ark-badge--gray">Default</span>
        <span class="ark-badge ark-badge--success">Success</span>
        <span class="ark-badge ark-badge--danger">Danger</span>
        <span class="ark-badge ark-badge--warning">Warning</span>
    </div>
</div>
{/block}
