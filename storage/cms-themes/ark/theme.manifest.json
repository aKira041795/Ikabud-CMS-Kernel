{
    "name": "ark",
    "version": "1.0.0",
    "label": "ARK Reference Theme",
    "description": "ARK — Architectural Reference Kit: production reference theme and executable theme specification for Kernel OS 6.1+. Demonstrates every approved theme convention.",
    "author": "Ikabud Kernel Team",
    "license": "MIT",
    "kernel_os_compat": "6.1.0",
    "disyl_compat": "4.7.0",
    "customizer_scope": "native",
    "customizer": {
        "owns": true,
        "schema": "customizer.schema.json",
        "schema_version": "1.0.0",
        "provider": "Ikabud\\Themes\\Ark\\ArkCustomizerProvider",
        "sections": [
            "header",
            "footer",
            "sidebar",
            "colors",
            "theme",
            "typography"
        ]
    },
    "regions": {
        "header": "templates/regions/header.disyl",
        "footer": "templates/regions/footer.disyl",
        "sidebar": "templates/regions/sidebar.disyl"
    },
    "capabilities": {
        "requires": [],
        "supports": [
            "cms.entity.list",
            "cms.entity.detail",
            "theme.token.apply@1",
            "theme.elements@1"
        ]
    },
    "tokens": "tokens.json",
    "shell": "layouts/public.disyl",
    "supported_surfaces": [
        "public",
        "print",
        "email"
    ],
    "supported_slots": [
        "site.before",
        "header.before",
        "header.main",
        "header.after",
        "hero",
        "breadcrumbs",
        "content.before",
        "content",
        "content.after",
        "sidebar.primary",
        "sidebar.secondary",
        "footer.before",
        "footer.main",
        "footer.after",
        "site.after",
        "notifications"
    ],
    "fallback_views": {
        "card": "entity-views/default-card.disyl",
        "table": "entity-views/default-table.disyl",
        "detail": "entity-views/default-detail.disyl",
        "compact": "entity-views/default-compact.disyl"
    },
    "design_language": {
        "type_scale": "inter",
        "color_system": "oklch",
        "grid": "tailwind-v3",
        "icon_set": "fontawesome-6"
    },
    "accessibility": {
        "semantic_landmarks": true,
        "skip_to_content": true,
        "keyboard_navigation": true,
        "visible_focus": true,
        "reduced_motion": true,
        "aria_current": true,
        "aria_sort": true,
        "contrast_ratio": "4.5:1"
    },
    "browser_support": [
        "chrome >= 90",
        "firefox >= 88",
        "safari >= 14",
        "edge >= 90"
    ],
    "required_assets": {
        "css": [
            "style.css"
        ]
    },
    "optional_assets": {
        "js": [
            "script.js"
        ]
    },
    "component_variants": {
        "ikb_panel": {
            "tone": {
                "surface": "bg-white border border-gray-100",
                "muted": "bg-gray-50 border border-gray-100",
                "elevated": "bg-white shadow-md",
                "primary": "bg-indigo-600 text-white"
            },
            "spacing": {
                "none": "p-0",
                "sm": "p-3",
                "md": "p-5",
                "lg": "p-8",
                "xl": "p-12"
            },
            "radius": {
                "none": "rounded-none",
                "sm": "rounded-md",
                "md": "rounded-xl",
                "lg": "rounded-2xl",
                "full": "rounded-full"
            }
        },
        "ikb_button": {
            "variant": {
                "primary": "bg-indigo-600 text-white hover:bg-indigo-700",
                "secondary": "bg-gray-200 text-gray-800 hover:bg-gray-300",
                "outline": "border border-indigo-600 text-indigo-600 hover:bg-indigo-50",
                "ghost": "text-gray-600 hover:bg-gray-100",
                "danger": "bg-red-600 text-white hover:bg-red-700"
            },
            "size": {
                "sm": "px-3 py-1.5 text-sm",
                "md": "px-4 py-2",
                "lg": "px-6 py-3 text-lg"
            }
        },
        "ikb_badge": {
            "variant": {
                "primary": "bg-indigo-100 text-indigo-800",
                "success": "bg-green-100 text-green-800",
                "warning": "bg-yellow-100 text-yellow-800",
                "danger": "bg-red-100 text-red-800",
                "info": "bg-blue-100 text-blue-800"
            }
        }
    },
    "theme": {
        "colors": {
            "primary": {
                "default": "#6366f1",
                "dark": "#4f46e5",
                "light": "#eef2ff"
            },
            "surface": {
                "default": "#ffffff",
                "muted": "#f8fafc",
                "raised": "#ffffff"
            },
            "text": {
                "primary": "#0f172a",
                "secondary": "#475569",
                "muted": "#94a3b8"
            },
            "border": {
                "default": "#e2e8f0",
                "subtle": "#f1f5f9"
            },
            "status": {
                "success": "#22c55e",
                "warning": "#f59e0b",
                "danger": "#ef4444",
                "info": "#3b82f6"
            }
        },
        "typography": {
            "font_family": "Inter, system-ui, -apple-system, sans-serif",
            "heading_weight": "700",
            "body_size": "16px",
            "line_height": "1.6"
        },
        "spacing": {
            "none": "0",
            "xs": "0.5rem",
            "sm": "0.75rem",
            "md": "1.25rem",
            "lg": "2rem",
            "xl": "3rem",
            "2xl": "5rem"
        },
        "radius": {
            "none": "0",
            "sm": "0.375rem",
            "md": "0.75rem",
            "lg": "1rem",
            "xl": "1.5rem",
            "full": "9999px"
        },
        "shadows": {
            "sm": "0 1px 2px rgba(0,0,0,0.05)",
            "md": "0 4px 6px rgba(0,0,0,0.07)",
            "lg": "0 10px 25px rgba(0,0,0,0.08)"
        }
    },
    "layout": {
        "max_width": "1280px",
        "gutter": "1rem",
        "header": {
            "height": "64px",
            "sticky": true
        },
        "footer": {
            "columns": 3,
            "show_branding": true
        },
        "sidebar": {
            "default_position": "right",
            "default_width": "300px"
        }
    }
}