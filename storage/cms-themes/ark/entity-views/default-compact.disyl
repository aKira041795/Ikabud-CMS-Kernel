{# Entity-Native: Generic fallback compact view for unknown entity types
   Minimal inline rendering — used in sidebars, meta panels, related-item lists. #}

{extends "_cms_active_theme/layouts/public.disyl"}

{block content}
{ikb_section padding_y="md"}
    {ikb_container max_width="1200px" padding="sm"}
        {if rows}
        <div class="ark-compact-list">
            {for row in rows}
            <div class="ark-compact-list__item">
                {if row.image or row.thumbnail_url or row.featured_image_url}
                <img src="{row.image|default:row.thumbnail_url|default:row.featured_image_url}" alt="" class="ark-compact-list__image" loading="lazy" width="32" height="32" />
                {/if}
                <div class="ark-compact-list__body">
                    <div class="ark-compact-list__title">
                        {if row.url}<a href="{row.url}" class="ark-compact-list__link">{/if}
                        {row.title|default:row.name|default:row.label|default:'Item'}
                        {if row.url}</a>{/if}
                    </div>
                    {if row.excerpt or row.description}
                    <div class="ark-compact-list__excerpt">
                        {row.excerpt|default:row.description}
                    </div>
                    {/if}
                </div>
                {if row.price or row.status}
                <div class="ark-compact-list__aside">
                    {if row.price}<div class="ark-compact-list__price">{row.price}</div>{/if}
                    {if row.status}<span class="ark-badge ark-badge--gray ark-compact-list__status">{row.status}</span>{/if}
                </div>
                {/if}
            </div>
            {/for}
        </div>
        {else}
        <div class="ark-compact-list__empty">
            {empty_state|default:'No items.'}
        </div>
        {/if}
    {/ikb_container}
{/ikb_section}
{/block}
