{# Entity-Native: Generic fallback card for unknown entity types
   Renders when no module-specific view contract is registered.
   Theme presents governed fields — module owns truth.
   All visual decisions come from design tokens (CSS vars), not hardcoded values. #}

{extends "_cms_active_theme/layouts/public.disyl"}

{block content}
{ikb_section padding_y="lg"}
    {ikb_container max_width="1200px" padding="md"}
        {if entity_list_title}
        <h2 class="en-view-title">{entity_list_title}</h2>
        {/if}

        {if rows}
        <div class="ark-card-grid">
            {for row in rows}
            <article class="ark-card">
                {if row.image or row.featured_image_url or row.thumbnail_url}
                <img src="{row.image|default:row.featured_image_url|default:row.thumbnail_url}" alt="{row.title|default:row.name|default:''}" class="ark-card__image" loading="lazy" />
                {/if}
                <div class="ark-card__body">
                    <h3 class="ark-card__title">
                        {if row.url}<a href="{row.url}" class="ark-card__link">{/if}
                        {row.title|default:row.name|default:row.label|default:'Untitled'}
                        {if row.url}</a>{/if}
                    </h3>
                    {if row.excerpt or row.description}
                    <p class="ark-card__excerpt">
                        {row.excerpt|default:row.description}
                    </p>
                    {/if}
                    {if row.price}
                    <div class="ark-card__price">{row.price}</div>
                    {/if}
                    {if row.status}
                    <span class="ark-card__status ark-card__status--{row.status}">{row.status}</span>
                    {/if}
                    {if row.published_at or row.created_at or row.date}
                    <div class="ark-card__meta">
                        {row.published_at|default:row.created_at|default:row.date|default:''}
                    </div>
                    {/if}
                </div>
            </article>
            {/for}
        </div>
        {else}
        <div class="ark-empty">
            <div class="ark-empty__text">{empty_state|default:'No records found.'}</div>
        </div>
        {/if}
    {/ikb_container}
{/ikb_section}
{/block}
