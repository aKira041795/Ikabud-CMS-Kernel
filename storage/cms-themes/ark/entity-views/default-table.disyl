{# Entity-Native: Generic fallback table for unknown entity types
   Renders when no module-specific view contract is registered.
   Header row auto-detected from first entity's keys. #}

{extends "_cms_active_theme/layouts/public.disyl"}

{block content}
{ikb_section padding_y="lg"}
    {ikb_container max_width="1200px" padding="md"}
        {if entity_list_title}
        <h2 class="ark-table-view__title">{entity_list_title}</h2>
        {/if}

        {if rows}
        {set headers = rows[0]|array_keys}
        <div class="ark-table-wrap">
            <table class="ark-table ark-table--compact">
                <thead>
                    <tr class="ark-table__row ark-table__row--head">
                        {for header in headers}
                        <th class="ark-table__head ark-table__head--strong">{header}</th>
                        {/for}
                        {if actions}
                        <th class="ark-table__head ark-table__head--strong ark-table__head--actions">Actions</th>
                        {/if}
                    </tr>
                </thead>
                <tbody>
                    {for row in rows}
                    <tr class="ark-table__row ark-table__row--body">
                        {for header in headers}
                        <td class="ark-table__cell ark-table__cell--compact">
                            {if header == 'url' and row[header]}
                            <a href="{row[header]}" class="ark-table__link">{row.title|default:'View'}</a>
                            {else if header == 'image' or header == 'thumbnail_url' or header == 'featured_image_url'}
                                {if row[header]}
                                <img src="{row[header]}" alt="" class="ark-table__thumb" />
                                {/if}
                            {else if header == 'status' or header == 'type'}
                            <span class="ark-badge ark-badge--gray">{row[header]}</span>
                            {else if header == 'price' or header == 'amount' or header == 'total'}
                            <span class="ark-pricing-amount">{row[header]}</span>
                            {else}
                            {row[header]|default:''}
                            {/if}
                        </td>
                        {/for}
                        {if actions}
                        <td class="ark-table__cell ark-table__cell--compact ark-table__cell--actions">
                            {if row.url}
                            <a href="{row.url}" class="ark-table__action-link">View →</a>
                            {/if}
                        </td>
                        {/if}
                    </tr>
                    {/for}
                </tbody>
            </table>
        </div>
        {else}
        <div class="en-empty ark-table-view__empty">
            <div class="en-empty__text">{empty_state|default:'No records found.'}</div>
        </div>
        {/if}
    {/ikb_container}
{/ikb_section}
{/block}
