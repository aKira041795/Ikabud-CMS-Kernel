{
  "$schema": "https://ikabud.dev/schemas/customizer-schema-v1.json",
  "title": "ARK Theme Customizer",
  "description": "Customization schema for the ARK Reference Theme. V4 widens coverage to the full CMS chrome surface (top bar, dropdown, mobile canvas, transparent header, geometry + targeting) and classifies every control by audience (user vs developer).",
  "schema_version": "4.0.0",
  "sections": {
    "header": {
      "label": "Header Settings",
      "controls": {
        "layout": {
          "type": "select",
          "label": "Header Layout",
          "default": "logo-left-menu-right",
          "options": [
            "logo-left-menu-right",
            "logo-center",
            "stacked",
            "default"
          ],
          "description": "Choose the header layout style",
          "audience": "user"
        },
        "sticky": {
          "type": "boolean",
          "label": "Sticky Header",
          "default": true,
          "description": "Keep header visible on scroll",
          "audience": "user"
        },
        "show_tagline": {
          "type": "boolean",
          "label": "Show Tagline",
          "default": false,
          "audience": "user"
        },
        "show_search": {
          "type": "boolean",
          "label": "Show Search",
          "default": false,
          "audience": "user"
        },
        "show_cta_button": {
          "type": "boolean",
          "label": "Show CTA Button",
          "default": false,
          "audience": "user"
        },
        "logo_image_url": {
          "type": "image",
          "label": "Logo Image",
          "default": "",
          "description": "URL to logo image (leave empty for text logo)",
          "audience": "user"
        },
        "logo_max_height": {
          "type": "number",
          "label": "Logo Max Height",
          "default": 40,
          "constraints": {
            "min": 16,
            "max": 120
          },
          "audience": "user"
        },
        "height": {
          "type": "text",
          "label": "Header Height",
          "default": "auto",
          "description": "auto or pixel value (e.g., 64px)",
          "audience": "developer"
        },
        "bg_color": {
          "type": "color",
          "label": "Background Color",
          "default": "#ffffff",
          "audience": "user"
        },
        "text_color": {
          "type": "color",
          "label": "Text Color",
          "default": "#1f2937",
          "audience": "user"
        },
        "link_color": {
          "type": "color",
          "label": "Link Color",
          "default": "#1f2937",
          "audience": "user"
        },
        "link_hover_color": {
          "type": "color",
          "label": "Link Hover Color",
          "default": "#2563eb",
          "audience": "user"
        },
        "padding_top": {
          "type": "number",
          "label": "Padding Top",
          "default": 12,
          "constraints": {
            "min": 0,
            "max": 60
          },
          "audience": "user"
        },
        "padding_bottom": {
          "type": "number",
          "label": "Padding Bottom",
          "default": 12,
          "constraints": {
            "min": 0,
            "max": 60
          },
          "audience": "user"
        },
