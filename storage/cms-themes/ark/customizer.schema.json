  "audience_contract": {
    "description": "ARK classifies its customizer surface on TWO independent axes. schema_scope says whether a section is CMS-owned or theme-owned; audience says whether a control is written for the site owner or for a developer. They are not the same thing and both are needed.",
    "audience": {
      "user": "Brand identity, content, visibility toggles, counts, and layout choices an owner can judge by looking at the page.",
      "developer": "CSS-level internals: pixel rhythm, width/height mode enums, breakpoints, opacity, radii, and template scoping/rules."
    },
    "schema_scope": {
      "cms_owned": {
        "sections": [
          "header",
          "footer",
          "sidebar",
          "colors",
          "theme"
        ],
        "matters_to": "the CMS and theme author, NOT directly to the user",
        "why": "The CMS renders these sections from hardcoded tabs in theme-customizer.disyl and reads the theme schema only for DEFAULTS and VALIDATION. Declaring more keys here makes the theme's contract complete and its defaults correct, but it adds no UI. Control ids must match the CMS chrome vocabulary (see cmsHeaderSettingsDefaults / cmsFooterSettingsDefaults / cmsSidebarSettingsDefaults) or the default is simply unused."
      },
      "theme_owned": {
        "sections": [
          "typography"
        ],
        "matters_to": "the user directly",
        "why": "Anything outside the CMS base-section list renders generically from this schema (cmsThemeSectionControlSchema -> cmsThemeSectionPanels -> the {foreach customizer_theme_sections} block). This IS the theme's own user-facing surface, and it is the correct place to add new owner-facing controls."
      }
    }
  }
}
