{
    "$schema": "https://ikabud.dev/schemas/customizer-schema-v1.json",
    "title": "ARK Theme Customizer",
    "description": "Customization schema for the ARK Reference Theme",
    "schema_version": "1.0.0",
    "sections": {
        "header": {
            "label": "Header Settings",
            "controls": {
                "layout": {
                    "type": "select",
                    "label": "Header Layout",
                    "default": "logo-left-menu-right",
                    "options": [
                        "logo-left-menu-right",
                        "logo-center",
                        "stacked",
                        "default"
                    ],
                    "description": "Choose the header layout style"
                },
                "sticky": {
                    "type": "boolean",
                    "label": "Sticky Header",
                    "default": true,
                    "description": "Keep header visible on scroll"
                },
                "show_tagline": {
                    "type": "boolean",
                    "label": "Show Tagline",
                    "default": false
                },
                "show_search": {
                    "type": "boolean",
                    "label": "Show Search",
                    "default": false
                },
                "show_cta_button": {
                    "type": "boolean",
                    "label": "Show CTA Button",
                    "default": false
                },
                "logo_image_url": {
                    "type": "image",
                    "label": "Logo Image",
                    "default": "",
                    "description": "URL to logo image (leave empty for text logo)"
                },
                "logo_max_height": {
                    "type": "number",
                    "label": "Logo Max Height",
                    "default": 40,
                    "constraints": {
                        "min": 16,
                        "max": 120
                    }
                },
                "height": {
                    "type": "text",
                    "label": "Header Height",
                    "default": "auto",
                    "description": "auto or pixel value (e.g., 64px)"
                },
                "bg_color": {
                    "type": "color",
                    "label": "Background Color",
                    "default": "#ffffff"
                },
                "text_color": {
                    "type": "color",
                    "label": "Text Color",
                    "default": "#1f2937"
                },
                "link_color": {
                    "type": "color",
                    "label": "Link Color",
                    "default": "#1f2937"
                },
                "link_hover_color": {
                    "type": "color",
                    "label": "Link Hover Color",
                    "default": "#2563eb"
                },
                "padding_top": {
                    "type": "number",
                    "label": "Padding Top",
                    "default": 12,
                    "constraints": {
                        "min": 0,
                        "max": 60
                    }
                },
                "padding_bottom": {
                    "type": "number",
                    "label": "Padding Bottom",
                    "default": 12,
                    "constraints": {
                        "min": 0,
                        "max": 60
                    }
                },
                "menu_location": {
                    "type": "select",
                    "label": "Menu Location",
                    "default": "primary",
                    "options": [
                        "primary",
                        "secondary",
                        "tertiary"
                    ],
                    "description": "Which menu to display in the header"
                },
                "mobile_menu_style": {
                    "type": "select",
                    "label": "Mobile Menu Style",
                    "default": "dropdown",
                    "options": [
                        "dropdown",
                        "canvas"
                    ],
                    "description": "How the mobile menu behaves"
                },
                "mobile_breakpoint": {
                    "type": "number",
                    "label": "Mobile Breakpoint",
                    "default": 768,
                    "constraints": {
                        "min": 480,
                        "max": 1024
                    }
                },
                "border_color": {
                    "type": "color",
                    "label": "Border Color",
                    "default": "#e5e7eb"
                },
                "header_container_width": {
                    "type": "select",
                    "label": "Header Container Width",
                    "default": "contained",
                    "options": [
                        "full",
                        "contained"
                    ]
                }
            }
        },
        "footer": {
            "label": "Footer Settings",
            "controls": {
                "columns": {
                    "type": "select",
                    "label": "Footer Columns",
                    "default": "3",
                    "options": [
                        "1",
                        "2",
                        "3",
                        "4",
                        "5"
                    ],
                    "description": "Number of widget columns"
                },
                "footer_bg_color": {
                    "type": "color",
                    "label": "Background Color",
                    "default": "#1e293b"
                },
                "footer_text_color": {
                    "type": "color",
                    "label": "Text Color",
                    "default": "#cbd5e1"
                },
                "footer_link_color": {
                    "type": "color",
                    "label": "Link Color",
                    "default": "#94a3b8"
                },
                "footer_link_hover_color": {
                    "type": "color",
                    "label": "Link Hover Color",
                    "default": "#ffffff"
                },
                "footer_title_color": {
                    "type": "color",
                    "label": "Title Color",
                    "default": "#f1f5f9"
                },
                "container_width": {
                    "type": "select",
                    "label": "Container Width",
                    "default": "contained",
                    "options": [
                        "full",
                        "contained"
                    ]
                },
                "padding_top": {
                    "type": "number",
                    "label": "Padding Top",
                    "default": 40,
                    "constraints": {
                        "min": 0,
                        "max": 120
                    }
                },
                "padding_bottom": {
                    "type": "number",
                    "label": "Padding Bottom",
                    "default": 40,
                    "constraints": {
                        "min": 0,
                        "max": 120
                    }
                },
                "show_admin_link": {
                    "type": "boolean",
                    "label": "Show Admin Link",
                    "default": true
                },
                "show_footer_bar": {
                    "type": "boolean",
                    "label": "Show Footer Bar",
                    "default": true
                },
                "copyright_text": {
                    "type": "text",
                    "label": "Copyright Text",
                    "default": "\u00a9 {current_year} {site_title}. All rights reserved.",
                    "description": "Use {current_year} and {site_title} as placeholders"
                },
                "bar_bg_color": {
                    "type": "color",
                    "label": "Bottom Bar Background",
                    "default": "#0f172a"
                },
                "bar_text_color": {
                    "type": "color",
                    "label": "Bottom Bar Text Color",
                    "default": "#64748b"
                },
                "bar_link_color": {
                    "type": "color",
                    "label": "Bottom Bar Link Color",
                    "default": "#94a3b8"
                },
                "bar_link_hover_color": {
                    "type": "color",
                    "label": "Bottom Bar Link Hover Color",
                    "default": "#ffffff"
                }
            }
        },
        "sidebar": {
            "label": "Sidebar Settings",
            "controls": {
                "enabled": {
                    "type": "boolean",
                    "label": "Enable Sidebar",
                    "default": true,
                    "description": "Show sidebar on pages"
                },
                "scope_mode": {
                    "type": "select",
                    "label": "Visibility Mode",
                    "default": "general",
                    "options": [
                        "general",
                        "exclude_templates",
                        "template"
                    ],
                    "description": "Which pages display the sidebar"
                },
                "placement": {
                    "type": "select",
                    "label": "Sidebar Position",
                    "default": "right",
                    "options": [
                        "left",
                        "right"
                    ]
                },
                "width": {
                    "type": "number",
                    "label": "Sidebar Width",
                    "default": 300,
                    "constraints": {
                        "min": 220,
                        "max": 420
                    }
                },
                "sticky": {
                    "type": "boolean",
                    "label": "Sticky Sidebar",
                    "default": false
                },
                "widget_bg_color": {
                    "type": "color",
                    "label": "Widget Background",
                    "default": "#ffffff"
                },
                "widget_text_color": {
                    "type": "color",
                    "label": "Widget Text Color",
                    "default": "#334155"
                },
                "widget_title_color": {
                    "type": "color",
                    "label": "Widget Title Color",
                    "default": "#0f172a"
                },
                "widget_border_color": {
                    "type": "color",
                    "label": "Widget Border Color",
                    "default": "#e2e8f0"
                },
                "widget_radius": {
                    "type": "number",
                    "label": "Widget Border Radius",
                    "default": 10,
                    "constraints": {
                        "min": 0,
                        "max": 24
                    }
                }
            }
        },
        "colors": {
            "label": "Colors",
            "controls": {
                "primary": {
                    "type": "color",
                    "label": "Primary Color",
                    "default": "#6366f1",
                    "description": "Main brand color for buttons, links, and accents"
                },
                "primary_dark": {
                    "type": "color",
                    "label": "Primary Dark",
                    "default": "#4f46e5"
                },
                "primary_light": {
                    "type": "color",
                    "label": "Primary Light",
                    "default": "#eef2ff"
                },
                "secondary": {
                    "type": "color",
                    "label": "Secondary Color",
                    "default": "#64748b"
                },
                "accent": {
                    "type": "color",
                    "label": "Accent Color",
                    "default": "#f59e0b"
                },
                "background": {
                    "type": "color",
                    "label": "Page Background",
                    "default": "#ffffff"
                },
                "surface": {
                    "type": "color",
                    "label": "Surface Color",
                    "default": "#ffffff"
                },
                "surface_muted": {
                    "type": "color",
                    "label": "Muted Surface",
                    "default": "#f8fafc"
                },
                "text": {
                    "type": "color",
                    "label": "Text Color",
                    "default": "#0f172a"
                },
                "text_secondary": {
                    "type": "color",
                    "label": "Secondary Text",
                    "default": "#475569"
                },
                "text_muted": {
                    "type": "color",
                    "label": "Muted Text",
                    "default": "#94a3b8"
                },
                "link": {
                    "type": "color",
                    "label": "Link Color",
                    "default": "#6366f1"
                },
                "link_hover": {
                    "type": "color",
                    "label": "Link Hover Color",
                    "default": "#4f46e5"
                },
                "border": {
                    "type": "color",
                    "label": "Border Color",
                    "default": "#e2e8f0"
                },
                "success": {
                    "type": "color",
                    "label": "Success Color",
                    "default": "#22c55e"
                },
                "warning": {
                    "type": "color",
                    "label": "Warning Color",
                    "default": "#f59e0b"
                },
                "danger": {
                    "type": "color",
                    "label": "Danger Color",
                    "default": "#ef4444"
                },
                "info": {
                    "type": "color",
                    "label": "Info Color",
                    "default": "#3b82f6"
                }
            }
        },
        "theme": {
            "label": "Theme Layout",
            "controls": {
                "max_width": {
                    "type": "number",
                    "label": "Max Content Width",
                    "default": 1280,
                    "constraints": {
                        "min": 800,
                        "max": 1920
                    },
                    "description": "Maximum width of content area in pixels"
                },
                "font_family": {
                    "type": "text",
                    "label": "Body Font",
                    "default": "Inter, system-ui, -apple-system, sans-serif",
                    "description": "CSS font-family for body text"
                },
                "heading_font": {
                    "type": "text",
                    "label": "Heading Font",
                    "default": "Inter, system-ui, -apple-system, sans-serif"
                },
                "body_font_size": {
                    "type": "number",
                    "label": "Body Font Size",
                    "default": 16,
                    "constraints": {
                        "min": 12,
                        "max": 24
                    }
                },
                "line_height": {
                    "type": "number",
                    "label": "Line Height",
                    "default": 1.6,
                    "constraints": {
                        "min": 1.0,
                        "max": 2.5,
                        "step": 0.1
                    }
                },
                "heading_weight": {
                    "type": "select",
                    "label": "Heading Weight",
                    "default": "700",
                    "options": [
                        "400",
                        "500",
                        "600",
                        "700",
                        "800",
                        "900"
                    ]
                },
                "border_radius": {
                    "type": "number",
                    "label": "Base Border Radius",
                    "default": 8,
                    "constraints": {
                        "min": 0,
                        "max": 24
                    }
                }
            }
        },
        "typography": {
            "label": "Typography",
            "controls": {
                "h1_size": {
                    "type": "number",
                    "label": "H1 Font Size",
                    "default": 2.5,
                    "constraints": {
                        "min": 1.0,
                        "max": 4.0,
                        "step": 0.25
                    }
                },
                "h2_size": {
                    "type": "number",
                    "label": "H2 Font Size",
                    "default": 2.0,
                    "constraints": {
                        "min": 1.0,
                        "max": 3.5,
                        "step": 0.25
                    }
                },
                "h3_size": {
                    "type": "number",
                    "label": "H3 Font Size",
                    "default": 1.5,
                    "constraints": {
                        "min": 0.875,
                        "max": 3.0,
                        "step": 0.125
                    }
                },
                "h4_size": {
                    "type": "number",
                    "label": "H4 Font Size",
                    "default": 1.25,
                    "constraints": {
                        "min": 0.875,
                        "max": 2.5,
                        "step": 0.125
                    }
                }
            }
        }
    }
}