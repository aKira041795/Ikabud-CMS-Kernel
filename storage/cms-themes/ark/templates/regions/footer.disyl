{# ARK Region Template: Footer #}
{# Receives from ThemeRenderContext: settings.footer.*, tokens, site, navigation #}
{# NOTE: DiSyL does NOT parse expressions inside <style> tags. Dynamic values are CSS variables. #}
{set footer_link = section_settings.link_color|default:'#94a3b8'}
{set footer_link_hover = section_settings.link_hover_color|default:'#ffffff'}
{set footer_text = section_settings.text_color|default:'#cbd5e1'}
{set footer_title = section_settings.title_color|default:'#f1f5f9'}
{set footer_columns = section_settings.columns|default:'3'}
{# The outer band is driven by the schema's container_width. It is a declared control and the
   declared-vs-honoured ratchet asserts it changes the render, so the wiring stays here; what
   was missing was the editor control that sets it (see the Footer panel's "Footer Container"). #}
{set footer_container = section_settings.container_width|default:'contained'}
{set footer_inner_width = section_settings.inner_width|default:'0'}
{# The footer bar owns its own shell, so it follows its own control rather than the widget band's. #}
{set bar_shell = section_settings.inner_width|default:'contained'}
{set widget_container = section_settings.widget_container_width|default:'contained'}
{set widget_inner_mode = section_settings.widget_inner_width_mode|default:'inherit'}
{set widget_custom_width = section_settings.widget_inner_custom_width|default:'1200'}
{set copyright = section_settings.copyright_text|default:'© {current_year} {site_title}. All rights reserved.'|replace:'{current_year}':current_year|replace:'{site_title}':site.title}

<div class="ark-customized-region ark-region-footer ark-region-footer--{footer_container} ark-region-footer--columns-{footer_columns}"
     data-region="footer"
     data-theme="{theme}"
     data-inner-width="{footer_inner_width}"
     data-widget-container-width="{widget_container}"
     style="background:{section_settings.bg_color|default:'#1e293b'};color:{footer_text};
            padding:{section_settings.padding_top|default:'40'}px 0 {section_settings.padding_bottom|default:'40'}px;
            margin-top:3rem;
            {if footer_container == 'contained'}max-width:var(--ark-max-width);margin-left:auto;margin-right:auto;{/if}
            --footer-link-hover:{footer_link_hover};--footer-link:{footer_link};
            --footer-title:{footer_title};--footer-columns:{footer_columns};
            --footer-widget-custom-width:{widget_custom_width|replace:'px':''}px;">
    {# Only the widget band's own controls decide its inner width. The footer bar keeps its
       own shell, so inner_width must not reach in here as well. #}
    <div class="ark-region-footer__inner ark-region-footer__inner--{widget_container} ark-region-footer__inner-mode--{widget_inner_mode}"
         style="{if widget_container == 'full'}max-width:none;{elseif widget_container == 'custom'}max-width:var(--footer-widget-custom-width);{elseif widget_inner_mode == 'full'}max-width:none;{elseif widget_inner_mode == 'custom'}max-width:var(--footer-widget-custom-width);{elseif widget_inner_mode == 'contained'}max-width:var(--ark-max-width);{/if}
                {# Gutter only when this inner is actually full-bleed, matching the max-width
                   chain above. A capped inner is already centred by margin:auto, so applying
                   the gutter too insets the content twice -- measured 472px where the content
                   column starts at 226px. Branches are explicit: a compound {set} expression
                   silently evaluated false here and dropped the gutter. #}
                {if footer_container == 'full' and widget_container == 'full'}padding-left:max(var(--ark-spacing-md),calc((100% - var(--ark-max-width))/2 + var(--ark-spacing-md)));padding-right:max(var(--ark-spacing-md),calc((100% - var(--ark-max-width))/2 + var(--ark-spacing-md)));
                {elseif footer_container == 'full' and widget_inner_mode == 'full'}padding-left:max(var(--ark-spacing-md),calc((100% - var(--ark-max-width))/2 + var(--ark-spacing-md)));padding-right:max(var(--ark-spacing-md),calc((100% - var(--ark-max-width))/2 + var(--ark-spacing-md)));
                {elseif footer_container == 'full'}padding-left:var(--ark-spacing-md);padding-right:var(--ark-spacing-md);{/if}">
        {if navigation.footer}
        <nav class="ark-region-footer__nav" aria-label="Footer navigation">{navigation.footer|raw}</nav>
        {/if}
        {if widgets_html}
        <div class="ark-region-footer__widgets" style="display:grid;width:100%;gap:1.5rem;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
            {widgets_html|raw}
        </div>
        {/if}
        {# The footer bar carries the copyright and admin link when enabled. #}
        {if section_settings.show_footer_bar|default:'1' == '0'}
        <div class="ark-region-footer__copy" style="color:{footer_text};">{copyright}</div>
        {if section_settings.show_admin_link|default:'1'}
        <div class="ark-region-footer__admin"><a href="/cms/admin">Admin</a></div>
        {/if}
        {/if}
    </div>
</div>
{if section_settings.show_footer_bar|default:'1'}
{set bar_bg = section_settings.bar_bg_color|default:'#0f172a'}
{# #94a3b8 on #0f172a measures 6.96:1. Keep these fallbacks aligned with the schema. #}
{set bar_text = section_settings.bar_text_color|default:'#94a3b8'}
{set bar_link = section_settings.bar_link_color|default:'#94a3b8'}
{set bar_link_hover = section_settings.bar_link_hover_color|default:'#ffffff'}
<div class="ark-customized-region ark-region-footer-bar ark-region-footer-bar--{bar_shell}"
     data-region="footer-bar"
     data-theme="{theme}"
     style="background:{bar_bg};color:{bar_text};padding:1rem 0;font-size:0.875rem;
            {if bar_shell == 'contained'}max-width:var(--ark-max-width);margin-left:auto;margin-right:auto;{/if}
            --footer-bar-link:{bar_link};--footer-bar-link-hover:{bar_link_hover};">
    <div class="ark-region-footer-bar__inner" style="{if bar_shell == 'full-width'}max-width:none;padding-left:max(var(--ark-spacing-md),calc((100% - var(--ark-max-width))/2 + var(--ark-spacing-md)));padding-right:max(var(--ark-spacing-md),calc((100% - var(--ark-max-width))/2 + var(--ark-spacing-md)));{elseif bar_shell == 'contained'}max-width:var(--ark-max-width);{elseif bar_shell != '0'}max-width:{bar_shell}px;{/if}">
        <span>{copyright}</span>
        {if section_settings.show_admin_link|default:'1'}<a href="/cms/admin">Admin</a>{/if}
    </div>
</div>
{/if}
