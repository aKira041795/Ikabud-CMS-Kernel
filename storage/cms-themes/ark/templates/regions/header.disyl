{# ARK Region Template: Header #}
{# Receives from ThemeRenderContext: settings.header.*, tokens, site, navigation, entity_context #}
{# NOTE: DiSyL does NOT parse expressions inside <style> tags. Dynamic values are CSS variables. #}
{set header_layout = section_settings.layout|default:'logo-left-menu-right'}
{set header_sticky = section_settings.sticky|default:'1'}
{set header_bg = section_settings.bg_color|default:'#ffffff'}
{set header_text = section_settings.text_color|default:'#1f2937'}
{set header_link = section_settings.link_color|default:'#1f2937'}
{set header_link_hover = section_settings.link_hover_color|default:'#2563eb'}
{set header_border = section_settings.border_color|default:'#e5e7eb'}
{set header_height = section_settings.height|default:'auto'}
{set header_pt = section_settings.padding_top|default:'12'}
{set header_pb = section_settings.padding_bottom|default:'12'}
{set header_opacity = section_settings.header_bg_opacity|default:'100'}
{set header_container = section_settings.header_container_width|default:'contained'}
{set header_inner_mode = section_settings.header_inner_width_mode|default:'inherit'}
{set header_inner_custom = section_settings.header_inner_custom_width|default:'1200'}
{set header_inner_legacy = section_settings.header_inner_width|default:'0'}
{set inner_width_legacy = section_settings.inner_width|default:'0'}
{set menu_location = section_settings.menu_location|default:'primary'}
{set mobile_location = section_settings.mobile_menu_location|default:'primary'}
{set mobile_style = section_settings.mobile_menu_style|default:'dropdown'}
{set mobile_breakpoint = section_settings.mobile_breakpoint|default:'768'}
{set mobile_direction = section_settings.mobile_canvas_direction|default:'right'}
{set mobile_align = section_settings.mobile_menu_align|default:'left'}

{# Browsers honour an icon link discovered in the body. Keeping it beside the governed region
   lets favicon_url remain part of the same independently-renderable header contract. #}
{if section_settings.favicon_url}<link rel="icon" href="{section_settings.favicon_url}">{/if}

{# data-topbar-* attributes are currently unconsumed and retained as stable external hooks. #}
<div class="ark-customized-region ark-region-header ark-region-header--{header_container} ark-region-header--mobile-{mobile_style} ark-region-header--canvas-{mobile_direction}{if section_settings.transparent_home == '1' and entity_context.kind == 'front-page'} ark-region-header--transparent{/if}"
     data-region="header"
     data-theme="{theme}"
     data-menu-location="{menu_location}"
     data-mobile-menu-location="{mobile_location}"
     data-mobile-breakpoint="{mobile_breakpoint}"
     data-mobile-close-on-link="{section_settings.mobile_close_on_link|default:'1'}"
     data-transparent-home="{section_settings.transparent_home|default:'0'}"
     data-transparent-text-color="{section_settings.transparent_text_color|default:'#ffffff'}"
     data-transparent-logo-color="{section_settings.transparent_logo_color|default:'#ffffff'}"
     data-header-inner-width="{header_inner_legacy}"
     data-header-inner-custom-width="{header_inner_custom}"
     data-inner-width="{inner_width_legacy}"
     data-topbar-bg-color="{section_settings.topbar_bg_color|default:'#0f172a'}"
     data-topbar-text-color="{section_settings.topbar_text_color|default:'#e2e8f0'}"
     data-topbar-link-color="{section_settings.topbar_link_color|default:'#cbd5e1'}"
     data-topbar-link-hover-color="{section_settings.topbar_link_hover_color|default:'#ffffff'}"
     data-topbar-border-bottom="{section_settings.topbar_border_bottom|default:'1'}"
     data-topbar-align="{section_settings.topbar_align|default:'between'}"
     data-topbar-font-size="{section_settings.topbar_font_size|default:'13'}"
     data-topbar-font-weight="{section_settings.topbar_font_weight|default:'400'}"
     data-topbar-padding-y="{section_settings.topbar_padding_y|default:'8'}"
     data-topbar-container-width="{section_settings.topbar_container_width|default:'contained'}"
     data-topbar-inner-width-mode="{section_settings.topbar_inner_width_mode|default:'inherit'}"
     data-topbar-inner-custom-width="{section_settings.topbar_inner_custom_width|default:'1200'}"
     data-topbar-inner-width="{section_settings.topbar_inner_width|default:'0'}"
     x-data="{ navOpen: false, viewport: window.innerWidth, breakpoint: Number('{mobile_breakpoint}') }"
     x-bind:class="{ 'ark-region-header--mobile-active': viewport <= breakpoint }"
     x-on:resize.window="viewport = window.innerWidth"
     style="background:{if section_settings.transparent_home == '1' and entity_context.kind == 'front-page'}color-mix(in srgb,#0f172a {header_opacity}%,transparent){else}color-mix(in srgb,{header_bg} {header_opacity}%,transparent){/if};
            border-bottom:1px solid {if section_settings.transparent_home == '1' and entity_context.kind == 'front-page'}transparent{else}{header_border}{/if};
            min-height:{header_height};
            {if header_sticky == '1'}position:sticky;top:0;z-index:100;{/if}
            {if header_container == 'contained'}max-width:var(--ark-max-width);margin-left:auto;margin-right:auto;{/if}
            color:{if section_settings.transparent_home == '1' and entity_context.kind == 'front-page'}{section_settings.transparent_text_color|default:'#ffffff'}{else}{header_text}{/if};
            --header-link:{if section_settings.transparent_home == '1' and entity_context.kind == 'front-page'}{section_settings.transparent_text_color|default:'#ffffff'}{else}{header_link}{/if};
            --header-link-hover:{header_link_hover};
            --header-logo:{if section_settings.transparent_home == '1' and entity_context.kind == 'front-page'}{section_settings.transparent_logo_color|default:'#ffffff'}{else}{section_settings.logo_color|default:'#0f172a'}{/if};
            --dropdown-bg:{section_settings.dropdown_bg_color|default:'#ffffff'};
            --dropdown-text:{section_settings.dropdown_text_color|default:'#1f2937'};
            --dropdown-hover-bg:{section_settings.dropdown_hover_bg_color|default:'#f1f5f9'};
            --dropdown-hover-text:{section_settings.dropdown_hover_text_color|default:'#111827'};
            --dropdown-border:{section_settings.dropdown_border_color|default:'#e5e7eb'};
            --dropdown-min-width:{section_settings.dropdown_min_width|default:'220'}px;
            --dropdown-item-padding-y:{section_settings.dropdown_item_padding_y|default:'10'}px;
            --dropdown-radius:{section_settings.dropdown_radius|default:'8'}px;
            --mobile-bg:{section_settings.mobile_bg_color|default:'#ffffff'};
            --mobile-text:{section_settings.mobile_text_color|default:'#1f2937'};
            --mobile-active-bg:{section_settings.mobile_active_bg_color|default:'#eef2ff'};
            --mobile-hover-bg:{section_settings.mobile_hover_bg_color|default:'#f1f5f9'};
            --mobile-overlay:{section_settings.mobile_overlay_color|default:'#0f172a'};
            --mobile-canvas-width:{section_settings.mobile_canvas_width|default:'320'}px;">

    {# Top bar: the site tagline is always useful data, so show_topbar has visible evidence even
       when no optional social-link collection was supplied to ThemeRenderContext. #}
    {if section_settings.show_topbar|default:'0'}
    <div class="ark-topbar ark-topbar--{section_settings.topbar_container_width|default:'contained'}"
         style="background:{section_settings.topbar_bg_color|default:'#0f172a'};
                color:{section_settings.topbar_text_color|default:'#e2e8f0'};
                border-bottom:{if section_settings.topbar_border_bottom|default:'1'}1px solid rgba(255,255,255,.18){else}0{/if};
                font-size:{section_settings.topbar_font_size|default:'13'}px;
                font-weight:{section_settings.topbar_font_weight|default:'400'};
                padding:{section_settings.topbar_padding_y|default:'8'}px 0;
                --topbar-link:{section_settings.topbar_link_color|default:'#cbd5e1'};
                --topbar-link-hover:{section_settings.topbar_link_hover_color|default:'#ffffff'};
                {if section_settings.topbar_container_width|default:'contained' == 'contained'}max-width:var(--ark-max-width);margin-left:auto;margin-right:auto;{/if}">
        <div class="ark-topbar__inner ark-topbar__inner--{section_settings.topbar_inner_width_mode|default:'inherit'}"
             data-topbar-inner-width="{section_settings.topbar_inner_width|default:'0'}"
             style="{if section_settings.topbar_inner_width_mode == 'full'}max-width:none;{elseif section_settings.topbar_inner_width_mode == 'custom'}max-width:{section_settings.topbar_inner_custom_width|default:'1200'}px;{elseif section_settings.topbar_inner_width_mode == 'contained'}max-width:var(--ark-max-width);{/if}
                    {if section_settings.topbar_container_width == 'full'}padding-left:max(var(--ark-spacing-md),calc((100% - var(--ark-max-width))/2 + var(--ark-spacing-md)));padding-right:max(var(--ark-spacing-md),calc((100% - var(--ark-max-width))/2 + var(--ark-spacing-md)));{/if}
                    justify-content:{if section_settings.topbar_align == 'left'}flex-start{elseif section_settings.topbar_align == 'center'}center{elseif section_settings.topbar_align == 'right'}flex-end{else}space-between{/if};">
            <div class="ark-topbar__left">
                {if site.tagline}<a href="{site.url}" class="ark-topbar__tagline">{site.tagline}</a>{else}<a href="{site.url}">{site.title}</a>{/if}
            </div>
            {if widgets_topbar_html}
            <div class="ark-topbar__right">{widgets_topbar_html|raw}</div>
            {/if}
        </div>
    </div>
    {/if}

    <div class="ark-region-header__inner ark-region-header__inner--{header_inner_mode}"
         style="{if header_layout == 'logo-center'}justify-content:center;{else}justify-content:space-between;{/if}
                flex-wrap:wrap;padding:{header_pt}px {if header_container == 'full'}max(var(--ark-spacing-md),calc((100% - var(--ark-max-width))/2 + var(--ark-spacing-md))){else}var(--ark-spacing-md){/if} {header_pb}px;
                {if header_inner_mode == 'full'}max-width:none;{elseif header_inner_mode == 'custom'}max-width:{header_inner_custom}px;{elseif header_inner_mode == 'contained'}max-width:var(--ark-max-width);{else}max-width:var(--ark-max-width);{/if}
                margin:0 auto;
                {if header_layout == 'stacked'}flex-direction:column;text-align:center;{/if}">
        <div class="ark-region-header__brand">
            {if section_settings.logo_image_url}
            <a href="{site.url}" class="ark-region-header__site-link">
                <img src="{section_settings.logo_image_url}" alt="{site.title}" class="ark-region-header__logo" style="max-height:{section_settings.logo_max_height|default:'40'}px;">
            </a>
            {else}
            <a href="{site.url}" class="ark-region-header__site-link" style="color:var(--header-logo);">{site.title}</a>
            {/if}
            {if section_settings.show_tagline|default:'0' and site.tagline}
            <span class="ark-region-header__tagline">{site.tagline}</span>
            {/if}
        </div>

        {if widgets_html}
        <div class="ark-region-header__widgets" style="display:flex;flex-wrap:wrap;gap:1rem 1.5rem;align-items:center;">
            {widgets_html|raw}
        </div>
        {/if}

        <nav class="ark-region-header__nav" aria-label="Main navigation">
            <button class="ark-header__mobile-toggle" aria-label="Toggle navigation menu"
                    x-bind:aria-expanded="navOpen" x-on:click="navOpen = !navOpen"
                    x-bind:style="viewport <= breakpoint ? 'display:inline-flex' : 'display:none'">
                <span></span><span></span><span></span>
            </button>
            <div class="ark-region-header__nav-links" x-show="viewport > breakpoint">
                {# ThemeRenderContext currently supplies primary and footer locations. An explicitly
                   selected unprovided desktop location is intentionally empty, not silently primary. #}
                {if menu_location == 'primary' and navigation.primary}{navigation.primary|raw}{/if}
            </div>
            {if section_settings.show_search|default:'0'}
            <a href="/search" aria-label="Search" class="ark-region-header__search" style="color:var(--header-link);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            </a>
            {/if}
            {if section_settings.show_cta_button|default:'0'}
            <a href="{section_settings.cta_url|default:'#'}"
               class="ark-region-header__cta ark-region-header__cta--{section_settings.cta_style|default:'primary'}">
                {section_settings.cta_text|default:'Get Started'}
            </a>
            {/if}
        </nav>
    </div>

    {if section_settings.mobile_overlay|default:'1'}
    <button class="ark-region-header__mobile-overlay" aria-label="Close navigation"
            x-show="navOpen &amp;&amp; viewport <= breakpoint" x-on:click="navOpen = false"
            style="background:var(--mobile-overlay);display:none;"></button>
    {/if}
    <div class="ark-region-header__mobile-panel ark-region-header__mobile-panel--{mobile_style} ark-region-header__mobile-panel--{mobile_direction}"
         x-show="navOpen &amp;&amp; viewport <= breakpoint" x-cloak
         style="background:var(--mobile-bg);color:var(--mobile-text);text-align:{mobile_align};
                {if mobile_style == 'canvas'}width:{if mobile_direction == 'top'}100%{else}var(--mobile-canvas-width){/if};{/if}display:none;">
        <div class="ark-region-header__mobile-brand">
            {if section_settings.mobile_logo_url}
            <img src="{section_settings.mobile_logo_url}" alt="{site.title}" style="max-height:{section_settings.mobile_logo_max_height|default:'32'}px;width:auto;">
            {else}<span style="color:var(--mobile-text);font-weight:700;">{site.title}</span>{/if}
            <button type="button" class="ark-region-header__mobile-close" aria-label="Close navigation" x-on:click="navOpen = false">&times;</button>
        </div>
        <nav class="ark-region-header__mobile-nav" aria-label="Mobile navigation"{if section_settings.mobile_close_on_link|default:'1'} x-on:click="navOpen = false"{/if}>
            {if mobile_location == 'footer' and navigation.footer}{navigation.footer|raw}{elseif mobile_location == 'primary' and navigation.primary}{navigation.primary|raw}{/if}
        </nav>
    </div>
</div>
