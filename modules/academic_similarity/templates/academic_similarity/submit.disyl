{* Public submission form for Academic Similarity checking *}
<div class="ac-sim-submit-form" id="ac-sim-submit-form">
    <form id="ac-sim-upload-form" class="space-y-5" onsubmit="return acSimSubmit(event)">
        <input type="hidden" name="_token" value="{csrf_token}" />

        <div class="space-y-2">
            <label class="block text-sm font-semibold text-gray-700" for="ac-sim-title">Document Title *</label>
            <input type="text" id="ac-sim-title" name="submission_title" required
                   class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                   placeholder="e.g. Research Paper on Climate Change" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-semibold text-gray-700" for="ac-sim-name">Your Name</label>
            <input type="text" id="ac-sim-name" name="author_name"
                   class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                   placeholder="e.g. Juan Dela Cruz" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-semibold text-gray-700">Submission Method</label>
            <div class="flex gap-4">
                <label class="flex items-center gap-2 text-sm text-gray-700">
                    <input type="radio" name="source_type" value="upload" checked onchange="acSimToggleSourceType()" class="text-blue-600" />
                    Upload File
                </label>
                <label class="flex items-center gap-2 text-sm text-gray-700">
                    <input type="radio" name="source_type" value="pasted" onchange="acSimToggleSourceType()" class="text-blue-600" />
                    Paste Text
                </label>
            </div>
        </div>

        <div id="ac-sim-upload-section" class="space-y-2">
            <label class="block text-sm font-semibold text-gray-700" for="ac-sim-file">Upload Document (DOCX, PDF, TXT)</label>
            <input type="file" id="ac-sim-file" name="file" accept=".docx,.pdf,.txt"
                   class="w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
            <p class="text-xs text-gray-400">Max 20 MB. Accepted formats: DOCX, PDF, TXT.</p>
        </div>

        <div id="ac-sim-paste-section" class="space-y-2" style="display:none">
            <label class="block text-sm font-semibold text-gray-700" for="ac-sim-text">Paste Your Text</label>
            <textarea id="ac-sim-text" name="pasted_text" rows="10"
                      class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                      placeholder="Paste your document content here..."></textarea>
            <p class="text-xs text-gray-400">Minimum 20 words, maximum 50,000 words.</p>
        </div>

        <button type="submit" id="ac-sim-submit-btn"
                class="w-full py-3 px-6 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
            Check Similarity
        </button>
    </form>

    <div id="ac-sim-result" class="mt-6 hidden"></div>
</div>

<script>
function acSimToggleSourceType() {
    var upload = document.getElementById('ac-sim-upload-section');
    var paste = document.getElementById('ac-sim-paste-section');
    upload.style.display = document.querySelector('input[name="source_type"][value="upload"]').checked ? '' : 'none';
    paste.style.display = document.querySelector('input[name="source_type"][value="pasted"]').checked ? '' : 'none';
}

function acSimSubmit(event) {
    event.preventDefault();
    var btn = document.getElementById('ac-sim-submit-btn');
    var result = document.getElementById('ac-sim-result');
    btn.disabled = true;
    btn.textContent = 'Submitting...';

    var formData = new FormData(document.getElementById('ac-sim-upload-form'));
    formData.set('submission_title', formData.get('submission_title') || 'Untitled Document');

    fetch('/api/v1/academic-similarity/public/submit', {
        method: 'POST',
        body: formData,
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        result.className = 'mt-6 p-4 rounded-lg border text-sm';
        if (data.ok) {
            result.className += ' bg-green-50 border-green-200 text-green-700';
            result.innerHTML = '<strong>Submission received!</strong> Your document has been submitted for similarity checking. Reference ID: <code>' + data.submission_id + '</code>';
            document.getElementById('ac-sim-upload-form').reset();
        } else {
            result.className += ' bg-red-50 border-red-200 text-red-700';
            result.innerHTML = '<strong>Submission failed:</strong> ' + (data.error || 'Unknown error');
        }
        result.classList.remove('hidden');
    })
    .catch(function(err) {
        result.className = 'mt-6 p-4 rounded-lg border text-sm bg-red-50 border-red-200 text-red-700';
        result.innerHTML = '<strong>Network error:</strong> ' + err.message;
        result.classList.remove('hidden');
    })
    .finally(function() {
        btn.disabled = false;
        btn.textContent = 'Check Similarity';
    });

    return false;
}
</script>

<style>
.ac-sim-submit-form { max-width: 640px; margin: 0 auto; }
</style>
