{extends "modules/academic-similarity/layouts/admin"}

{block "title"}Sources{/block}

{block "content"}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Sources</h1>
        <a href="/admin/academic-similarity/sources/new" class="bg-brand-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-brand-700">Add Source</a>
    </div>

    <div class="bg-white rounded-lg shadow border border-gray-200">
        <div class="p-4 border-b border-gray-200">
            <form method="GET" class="flex gap-4 flex-wrap">
                <input type="text" name="search" value="{search_query}" placeholder="Search by title or author..." class="flex-1 min-w-[200px] rounded-lg border border-gray-300 px-3 py-2 text-sm">
                <select name="type" class="rounded-lg border border-gray-300 px-3 py-2 text-sm">
                    <option value="">All Types</option>
                    <option value="article" {if current_type == 'article'}selected{/if}>Article</option>
                    <option value="book" {if current_type == 'book'}selected{/if}>Book</option>
                    <option value="thesis" {if current_type == 'thesis'}selected{/if}>Thesis</option>
                    <option value="web" {if current_type == 'web'}selected{/if}>Web</option>
                    <option value="other" {if current_type == 'other'}selected{/if}>Other</option>
                </select>
                <select name="collection_id" class="rounded-lg border border-gray-300 px-3 py-2 text-sm">
                    <option value="0">All Collections</option>
                    {for col in collections}
                    <option value="{col.collection_id}" {if current_collection_id == col.collection_id}selected{/if}>{col.collection_name}</option>
                    {/for}
                </select>
                <button type="submit" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-200">Filter</button>
            </form>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-gray-50">
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Title</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Author</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Type</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Collection</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Words</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Added</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {if sources|count > 0}
                    {for source in sources}
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 font-medium text-gray-900">{source.title}</td>
                        <td class="px-6 py-4 text-gray-600">{source.author_name}</td>
                        <td class="px-6 py-4"><span class="text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded">{source.source_type}</span></td>
                        <td class="px-6 py-4 text-gray-500">{source.collection_name|default:—}</td>
                        <td class="px-6 py-4 text-gray-500">{source.word_count|default:0}</td>
                        <td class="px-6 py-4 text-gray-500">{source.created_at}</td>
                        <td class="px-6 py-4">
                            <a href="/admin/academic-similarity/sources/{source.source_id}" class="text-brand-600 hover:text-brand-900 font-medium mr-3">View</a>
                            <a href="/admin/academic-similarity/sources/{source.source_id}/edit" class="text-gray-500 hover:text-gray-700 font-medium">Edit</a>
                        </td>
                    </tr>
                    {/for}
                    {else}
                    <tr>
                        <td colspan="7" class="px-6 py-8 text-center text-gray-500">No sources found. <a href="/admin/academic-similarity/sources/new" class="text-brand-600 hover:underline">Add your first source</a>.</td>
                    </tr>
                    {/if}
                </tbody>
            </table>
        </div>
    </div>
</div>
{/block}
