{extends "modules/academic-similarity/layouts/admin"}

{block "title"}Source{/block}

{block "content"}
<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
        <a href="/admin/academic-similarity/sources" class="text-brand-600 hover:text-brand-900 text-sm">&larr; Back to Sources</a>
    </div>

    <div class="bg-white rounded-lg shadow border border-gray-200 p-6">
        <h1 class="text-2xl font-bold text-gray-900 mb-6">{if source.id}Edit Source{else}Add Source{/if}</h1>

        {if error}
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</div>
        {/if}

        <form method="POST" action="/api/v1/academic-similarity/sources" enctype="multipart/form-data" class="space-y-5">
            <input type="hidden" name="_token" value="{csrf_token}">
            <input type="hidden" name="institution_id" value="{source.institution_id|default:0}">

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
                <input type="text" name="title" value="{source.title}" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Author</label>
                <input type="text" name="author" value="{source.author}" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Source Input</label>
                    <select name="source_type" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
                        <option value="pasted" {if source.source_type == 'pasted'}selected{/if}>Pasted Text</option>
                        <option value="upload" {if source.source_type == 'upload'}selected{/if}>Upload File</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Classification</label>
                    <select name="classification" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
                        <option value="published" {if source.classification == 'published'}selected{/if}>Published</option>
                        <option value="student" {if source.classification == 'student'}selected{/if}>Student Work</option>
                        <option value="institutional" {if source.classification == 'institutional'}selected{/if}>Institutional</option>
                        <option value="other" {if source.classification == 'other'}selected{/if}>Other</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Collection</label>
                <select name="collection_id" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
                    <option value="0">No collection</option>
                    {for col in collections}
                    <option value="{col.collection_id}" {if source.collection_id == col.collection_id}selected{/if}>{col.collection_name}</option>
                    {/for}
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Paste Source Text</label>
                <textarea name="pasted_text" rows="10" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm"></textarea>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Or Upload File</label>
                <input type="file" name="file" accept=".pdf,.doc,.docx,.txt" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
            </div>

            <div class="flex justify-end gap-3">
                <a href="/admin/academic-similarity/sources" class="px-4 py-2 rounded-lg border border-gray-300 text-sm text-gray-700">Cancel</a>
                <button type="submit" class="px-4 py-2 rounded-lg bg-brand-600 text-white text-sm font-medium hover:bg-brand-700">Save Source</button>
            </div>
        </form>
    </div>
</div>
{/block}
