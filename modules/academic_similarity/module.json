{
    "id": "academic-similarity",
    "name": "Academic Integrity & Similarity",
    "version": "1.0.0",
    "description": "Secure academic document submission, deterministic exact and near-exact similarity detection, offset-accurate highlights, reviewer exclusions, reproducible reports, and audit history with tenant isolation.",
    "author": "Ikabud Kernel Team",
    "depends": [
        "cms"
    ],
    "requires_tables": [],
    "owns_tables": [
        "ac_similarity_institutions",
        "ac_similarity_plans",
        "ac_similarity_subscriptions",
        "ac_similarity_usage_counters",
        "ac_similarity_collections",
        "ac_similarity_sources",
        "ac_similarity_submissions",
        "ac_similarity_files",
        "ac_similarity_text_versions",
        "ac_similarity_segments",
        "ac_similarity_fingerprints",
        "ac_similarity_candidate_sources",
        "ac_similarity_matches",
        "ac_similarity_match_evidence",
        "ac_similarity_exclusions",
        "ac_similarity_reviews",
        "ac_similarity_reports",
        "ac_similarity_processing_jobs",
        "ac_similarity_model_profiles",
        "ac_similarity_integrations",
        "ac_similarity_retention_policies",
        "ac_similarity_internet_search_runs",
        "ac_similarity_internet_sources",
        "ac_similarity_audit_events",
        "ac_similarity_settings"
    ],
    "reads_tables": [
        "audit_logs"
    ],
    "migrations": [
        "migrations/001_academic_similarity_schema.sql",
        "migrations/002_academic_similarity_seed_plans.sql",
        "migrations/005_academic_similarity_public_results.sql",
        "migrations/006_academic_similarity_internet_sources.sql",
        "migrations/007_academic_similarity_ai_report_narrative.sql",
        "migrations/008_academic_similarity_reconcile_settings.sql",
        "migrations/009_academic_similarity_multilayer_fingerprinting.sql",
        "migrations/010_academic_similarity_evidence_taxonomy.sql"
    ],
    "routes": true,
    "settings": [],
    "hooks": [],
    "capabilities": {
        "exposes": [
            {
                "id": "academic_similarity.submit@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Submit a document for similarity checking",
                "schema": {
                    "type": "object",
                    "properties": {
                        "institution_id": {
                            "type": "integer"
                        },
                        "submission_title": {
                            "type": "string"
                        },
                        "file_content": {
                            "type": "string",
                            "description": "Base64-encoded file content"
                        },
                        "filename": {
                            "type": "string"
                        },
                        "source_type": {
                            "type": "string",
                            "enum": [
                                "upload",
                                "pasted"
                            ]
                        }
                    }
                }
            },
            {
                "id": "academic_similarity.check@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Check a submission's similarity against sources",
                "schema": {
                    "type": "object",
                    "properties": {
                        "submission_id": {
                            "type": "integer"
                        },
                        "external_text_processing_allowed": {
                            "type": "boolean",
                            "description": "Explicitly allow a configured external semantic provider to receive text segments; false skips semantic_match"
                        }
                    }
                }
            },
            {
                "id": "academic_similarity.match.exact@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Run exact-match comparison for a submission",
                "schema": {
                    "type": "object",
                    "properties": {
                        "submission_id": {
                            "type": "integer"
                        }
                    }
                }
            },
            {
                "id": "academic_similarity.match.near@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Run near-exact-match comparison for a submission",
                "schema": {
                    "type": "object",
                    "properties": {
                        "submission_id": {
                            "type": "integer"
                        }
                    }
                }
            },
            {
                "id": "academic_similarity.report.view@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "View similarity report",
                "schema": {
                    "type": "object",
                    "properties": {
                        "submission_id": {
                            "type": "integer"
                        }
                    }
                }
            },
            {
                "id": "academic_similarity.review.exclude@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Exclude a match from similarity scoring",
                "schema": {
                    "type": "object",
                    "properties": {
                        "submission_id": {
                            "type": "integer"
                        },
                        "match_id": {
                            "type": "integer"
                        },
                        "reason": {
                            "type": "string"
                        },
                        "note": {
                            "type": "string"
                        }
                    }
                }
            },
            {
                "id": "academic_similarity.semantic.compare@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Optional semantic similarity comparison (fallback handler — actual dispatch goes to ServiceProxy when the Python service-module is enabled)",
                "schema": {
                    "type": "object",
                    "properties": {
                        "submission_id": {
                            "type": "integer"
                        },
                        "model_profile_id": {
                            "type": "integer"
                        }
                    }
                }
            },
            {
                "id": "academic_similarity.internet.discover@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Discover internet sources for a submission (default handler; external modules can override at higher priority)"
            },
            {
                "id": "academic_similarity.context.analyze@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Analyze the contextual and scholarly relationship between two passages. Returns relationship type, scholarly classification, attribution status, evidence, and limitations. Governed by AI rules: never declares plagiarism.",
                "schema": {
                    "type": "object",
                    "properties": {
                        "submission_passage": {
                            "type": "string",
                            "description": "The passage from the submission document"
                        },
                        "source_passage": {
                            "type": "string",
                            "description": "The matching passage from the source document"
                        },
                        "citation_context": {
                            "type": "string",
                            "description": "Optional citation text near the passage"
                        },
                        "surrounding_context": {
                            "type": "object",
                            "properties": {
                                "submission_before": {
                                    "type": "string"
                                },
                                "submission_after": {
                                    "type": "string"
                                },
                                "source_before": {
                                    "type": "string"
                                },
                                "source_after": {
                                    "type": "string"
                                }
                            }
                        },
                        "document_sections": {
                            "type": "object",
                            "properties": {
                                "submission": {
                                    "type": "string"
                                },
                                "source": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "required": [
                        "submission_passage",
                        "source_passage"
                    ]
                }
            },
            {
                "id": "academic_similarity.citation.analyze@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Analyze a passage for citation and attribution signals. Detects in-text citations, quotation marks, and cross-references against a bibliography.",
                "schema": {
                    "type": "object",
                    "properties": {
                        "submission_passage": {
                            "type": "string"
                        },
                        "bibliography_text": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "submission_passage"
                    ]
                }
            },
            {
                "id": "academic_similarity.scholarship.profile@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Generate a multi-dimensional scholarship profile for a submission. Returns synthesis, methodology, attribution, and engagement scores with narrative summary.",
                "schema": {
                    "type": "object",
                    "properties": {
                        "submission_id": {
                            "type": "integer"
                        }
                    },
                    "required": [
                        "submission_id"
                    ]
                }
            },
            {
                "id": "academic_similarity.lineage.graph@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Build a knowledge lineage graph showing how a submission relates to its sources. Supports JSON and Mermaid output formats.",
                "schema": {
                    "type": "object",
                    "properties": {
                        "submission_id": {
                            "type": "integer"
                        },
                        "format": {
                            "type": "string",
                            "enum": [
                                "json",
                                "mermaid"
                            ]
                        }
                    },
                    "required": [
                        "submission_id"
                    ]
                }
            },
            {
                "id": "academic_similarity.review.workflow.action@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Perform a reviewer workflow action on a match. Actions: confirm_relationship, reclassify_evidence, exclude_common_knowledge, mark_standard_method, identify_quotation, flag_insufficient_attribution, request_revision, refer_formal_review, leave_note.",
                "schema": {
                    "type": "object",
                    "properties": {
                        "match_id": {
                            "type": "integer"
                        },
                        "action": {
                            "type": "string",
                            "enum": [
                                "confirm_relationship",
                                "reclassify_evidence",
                                "exclude_common_knowledge",
                                "mark_standard_method",
                                "identify_quotation",
                                "flag_insufficient_attribution",
                                "request_revision",
                                "refer_formal_review",
                                "leave_note"
                            ]
                        },
                        "user_id": {
                            "type": "integer"
                        },
                        "reason": {
                            "type": "string"
                        },
                        "classification": {
                            "type": "object"
                        }
                    },
                    "required": [
                        "match_id",
                        "action",
                        "reason"
                    ]
                }
            }
        ],
        "depends": [
            "kernel.audit.record@1"
        ]
    },
    "events": {
        "emits": [
            "academic_similarity.submission.created",
            "academic_similarity.submission.processed",
            "academic_similarity.report.generated",
            "academic_similarity.review.excluded",
            "academic_similarity.quota.warning",
            "academic_similarity.quota.exhausted"
        ]
    },
    "settings_fields": [
        {
            "key": "enabled",
            "type": "checkbox",
            "label": "Enable Academic Similarity",
            "default": "1",
            "description": "Master switch for the similarity module"
        },
        {
            "key": "exact_match_enabled",
            "type": "checkbox",
            "label": "Enable Exact Matching",
            "default": "1"
        },
        {
            "key": "near_match_enabled",
            "type": "checkbox",
            "label": "Enable Near-Exact Matching",
            "default": "1"
        },
        {
            "key": "semantic_match_enabled",
            "type": "checkbox",
            "label": "Enable Semantic Matching",
            "default": "0",
            "description": "Requires external semantic service module"
        },
        {
            "key": "semantic_provider",
            "type": "select",
            "label": "Semantic Provider",
            "default": "token_overlap",
            "options": [
                {
                    "value": "token_overlap",
                    "label": "Token overlap"
                },
                {
                    "value": "tfidf",
                    "label": "TF-IDF cosine"
                },
                {
                    "value": "sentence_transformers",
                    "label": "Sentence transformers"
                },
                {
                    "value": "groq",
                    "label": "Groq LLM judge"
                }
            ]
        },
        {
            "key": "semantic_model_name",
            "type": "text",
            "label": "Semantic Model Name",
            "default": "token_overlap"
        },
        {
            "key": "semantic_service_endpoint",
            "type": "text",
            "label": "Python Service Endpoint",
            "default": "http://127.0.0.1:9003",
            "description": "Base URL for the Python semantic service"
        },
        {
            "key": "semantic_service_token_env",
            "type": "text",
            "label": "Service Token Environment Variable",
            "default": "SEMANTIC_SERVICE_TOKEN",
            "description": "Environment variable containing the ServiceProxy bearer token"
        },
        {
            "key": "semantic_external_api_key_env",
            "type": "text",
            "label": "External AI API Key Environment Variable",
            "default": "SEMANTIC_API_KEY",
            "description": "Optional fallback environment variable when no encrypted tenant key is saved"
        },
        {
            "key": "semantic_external_api_key",
            "type": "password",
            "label": "External AI API Key",
            "default": "",
            "description": "Stored encrypted at rest. Leave blank to keep the current key."
        },
        {
            "key": "semantic_similarity_threshold",
            "type": "number",
            "label": "Semantic Threshold",
            "default": "0.15"
        },
        {
            "key": "semantic_max_segments",
            "type": "number",
            "label": "Semantic Max Segments",
            "default": "500"
        },
        {
            "key": "semantic_payload_policy",
            "type": "select",
            "label": "Semantic Payload Policy",
            "default": "segments_only",
            "options": [
                {
                    "value": "segments_only",
                    "label": "Segments only"
                },
                {
                    "value": "redacted_segments",
                    "label": "Redacted segments"
                }
            ]
        },
        {
            "key": "semantic_health_visible",
            "type": "checkbox",
            "label": "Show Semantic Health",
            "default": "1"
        },
        {
            "key": "internet_check_enabled",
            "type": "checkbox",
            "label": "Enable AI Internet Check",
            "default": "1",
            "description": "Discover public internet sources via SerpAPI during similarity checking; not a comprehensive internet search"
        },
        {
            "key": "internet_check_provider",
            "type": "select",
            "label": "Internet Discovery Provider",
            "default": "ai",
            "options": [
                {
                    "value": "capability",
                    "label": "Provider capability (via academic_similarity.internet.discover)"
                },
                {
                    "value": "ai",
                    "label": "AI search (via ai.search.discover — SerpAPI)"
                },
                {
                    "value": "seed_urls",
                    "label": "Configured seed URLs only"
                }
            ]
        },
        {
            "key": "internet_search_backend",
            "type": "select",
            "label": "Search Backend (when provider=ai)",
            "default": "serpapi",
            "options": [
                {
                    "value": "serpapi",
                    "label": "SerpAPI (serpapi.com)"
                }
            ]
        },
        {
            "key": "internet_search_engine",
            "type": "select",
            "label": "SerpAPI Search Engine",
            "default": "google_scholar",
            "description": "Use Google Scholar for academic source discovery; Google web search remains available as a fallback.",
            "options": [
                {
                    "value": "google_scholar",
                    "label": "Google Scholar"
                },
                {
                    "value": "google",
                    "label": "Google Web Search"
                }
            ]
        },
        {
            "key": "internet_query_generation_mode",
            "type": "select",
            "label": "Search Query Generation",
            "default": "local",
            "description": "Local mode keeps document text on this server. AI mode sends the bounded abstract to the configured AI provider and requires explicit privacy approval.",
            "options": [
                {
                    "value": "local",
                    "label": "Local contextual extraction"
                },
                {
                    "value": "ai",
                    "label": "External AI abstract extraction"
                }
            ]
        },
        {
            "key": "internet_check_timeout",
            "type": "number",
            "label": "HTTP Timeout (seconds)",
            "default": "15",
            "description": "Timeout per search query. SerpAPI can be slow; 15s is recommended."
        },
        {
            "key": "internet_check_api_key_env",
            "type": "text",
            "label": "Internet Provider API Key Environment Variable",
            "default": "AISS_INTERNET_API_KEY"
        },
        {
            "key": "internet_check_api_key",
            "type": "password",
            "label": "Internet Provider API Key",
            "default": "",
            "description": "Stored encrypted at rest. Leave blank to keep the current key."
        },
        {
            "key": "internet_check_max_queries",
            "type": "number",
            "label": "Max Internet Queries",
            "default": "3"
        },
        {
            "key": "internet_check_max_sources",
            "type": "number",
            "label": "Max Internet Sources",
            "default": "5"
        },
        {
            "key": "internet_check_max_chars_per_source",
            "type": "number",
            "label": "Max Retrieved Characters Per Source",
            "default": "12000"
        },
        {
            "key": "internet_check_payload_policy",
            "type": "select",
            "label": "Internet Payload Policy",
            "default": "snippets_only",
            "options": [
                {
                    "value": "snippets_only",
                    "label": "Snippets only"
                },
                {
                    "value": "phrases_only",
                    "label": "Distinctive phrases only"
                }
            ]
        },
        {
            "key": "internet_check_auto_run_when_no_sources",
            "type": "checkbox",
            "label": "Auto-run Internet Check When Local Sources Are Unavailable",
            "default": "0"
        },
        {
            "key": "internet_check_allow_full_document_query",
            "type": "checkbox",
            "label": "Allow Longer Internet Query Text",
            "default": "0"
        },
        {
            "key": "internet_check_store_retrieved_text",
            "type": "checkbox",
            "label": "Store Retrieved Internet Text",
            "default": "1"
        },
        {
            "key": "internet_check_seed_urls",
            "type": "text",
            "label": "Internet Seed URLs",
            "default": "",
            "description": "Comma-separated or line-separated curated URLs for deterministic internet checks"
        },
        {
            "key": "cms_public_submission_enabled",
            "type": "checkbox",
            "label": "Enable CMS Public Submission",
            "default": "1"
        },
        {
            "key": "cms_submission_shortcode",
            "type": "text",
            "label": "CMS Submission Shortcode",
            "default": "academic_similarity_submission"
        },
        {
            "key": "cms_builder_block_enabled",
            "type": "checkbox",
            "label": "Enable CMS Builder Block",
            "default": "1"
        },
        {
            "key": "cms_default_submission_title",
            "type": "text",
            "label": "Default CMS Submission Title",
            "default": "Submit Document for Similarity Check"
        },
        {
            "key": "public_results_enabled",
            "type": "checkbox",
            "label": "Enable Public Results History",
            "default": "1",
            "description": "Show submission history and stats to logged-in CMS users"
        },
        {
            "key": "public_results_recent_limit",
            "type": "number",
            "label": "Recent Results Limit",
            "default": "10",
            "description": "Number of recent submissions shown in user history"
        },
        {
            "key": "public_results_show_scores",
            "type": "checkbox",
            "label": "Show Scores in Public Results",
            "default": "1"
        },
        {
            "key": "public_results_show_match_count",
            "type": "checkbox",
            "label": "Show Match Count in Public Results",
            "default": "1"
        },
        {
            "key": "public_results_show_report_links",
            "type": "checkbox",
            "label": "Show Report Links in Public Results",
            "default": "1"
        },
        {
            "key": "public_results_allow_anonymous",
            "type": "checkbox",
            "label": "Allow Anonymous Submissions",
            "default": "1",
            "description": "When disabled, only logged-in users can submit documents"
        },
        {
            "key": "public_report_workspace_enabled",
            "type": "checkbox",
            "label": "Enable Public Report Workspace",
            "default": "1"
        },
        {
            "key": "public_report_download_enabled",
            "type": "checkbox",
            "label": "Enable Public Report Download",
            "default": "1"
        },
        {
            "key": "public_report_show_raw_score",
            "type": "checkbox",
            "label": "Show Raw Score in Public Reports",
            "default": "1"
        },
        {
            "key": "public_report_show_source_names",
            "type": "checkbox",
            "label": "Show Source Names in Public Reports",
            "default": "1"
        },
        {
            "key": "public_report_show_full_document",
            "type": "checkbox",
            "label": "Show Full Highlighted Document",
            "default": "1"
        },
        {
            "key": "public_report_default_mode",
            "type": "select",
            "label": "Public Report Default Mode",
            "default": "workspace",
            "options": [
                {
                    "value": "workspace",
                    "label": "Workspace"
                },
                {
                    "value": "form_only",
                    "label": "Form only"
                }
            ]
        },
        {
            "key": "min_word_count",
            "type": "number",
            "label": "Minimum Word Count",
            "default": "20",
            "description": "Submissions below this word count are not processed"
        },
        {
            "key": "max_word_count",
            "type": "number",
            "label": "Maximum Word Count",
            "default": "50000",
            "description": "Submissions above this word count are rejected"
        },
        {
            "key": "max_file_size_mb",
            "type": "number",
            "label": "Max File Size (MB)",
            "default": "20"
        },
        {
            "key": "fingerprint_shingle_size",
            "type": "number",
            "label": "Shingle Size (words)",
            "default": "5"
        },
        {
            "key": "near_match_threshold",
            "type": "number",
            "label": "Near-Match Threshold (0.0-1.0)",
            "default": "0.8"
        },
        {
            "key": "retention_days",
            "type": "number",
            "label": "Default Retention Days",
            "default": "365"
        },
        {
            "key": "allowed_extensions",
            "type": "text",
            "label": "Allowed File Extensions",
            "default": "docx,pdf,txt"
        }
    ],
    "nav": [
        {
            "label": "Similarity Dashboard",
            "url": "/admin/academic-similarity",
            "icon": "search",
            "roles": [
                "admin"
            ]
        },
        {
            "label": "Submissions",
            "url": "/admin/academic-similarity/submissions",
            "icon": "document",
            "roles": [
                "admin"
            ]
        },
        {
            "label": "Sources",
            "url": "/admin/academic-similarity/sources",
            "icon": "library",
            "roles": [
                "admin"
            ]
        },
        {
            "label": "Collections",
            "url": "/admin/academic-similarity/collections",
            "icon": "folder",
            "roles": [
                "admin"
            ]
        },
        {
            "label": "Reports",
            "url": "/admin/academic-similarity/reports",
            "icon": "chart",
            "roles": [
                "admin"
            ]
        },
        {
            "label": "Settings",
            "url": "/admin/academic-similarity/settings",
            "icon": "settings",
            "roles": [
                "admin"
            ]
        }
    ]
}
