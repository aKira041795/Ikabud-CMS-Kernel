{
    "id": "inventory-scanner",
    "name": "Inventory Scanner",
    "version": "1.0.0",
    "description": "Standalone barcode-based inventory scanning with offline-capable mobile app",
    "author": "Ikabud",
    "auth_owned": {
        "users_table": "is_users",
        "username_column": "username",
        "email_column": "email",
        "password_column": "password_hash",
        "name_column": "full_name",
        "active_column": "is_active",
        "deleted_column": "deleted_at",
        "admin_roles": [
            "admin"
        ],
        "default_admin_role": "admin",
        "requires_named_admin_on_provision": false,
        "touch_updated_at": true
    },
    "auth_cookie": "inventory_scanner_token",
    "owns_tables": [
        "is_users",
        "is_password_resets",
        "is_scan_sessions",
        "is_scan_items",
        "is_products"
    ],
    "co_owns_tables": [
        "audit_logs"
    ],
    "reads_tables": [
        "rate_limits",
        "refresh_tokens"
    ],
    "migrations": [
        "database/migrations/001_initial.sql"
    ],
    "capabilities": {
        "exposes": [
            "kernel.auth.authenticate@1",
            "inventory-scanner.scan.lookup@1",
            "inventory-scanner.scan.save@1",
            "inventory-scanner.products.list@1",
            "inventory-scanner.products.export@1",
            "inventory-scanner.scan.sync@1"
        ],
        "depends": []
    },
    "settings_fields": [
        {
            "key": "default_warehouse",
            "label": "Default Warehouse",
            "type": "text",
            "default": ""
        },
        {
            "key": "require_location_scan",
            "label": "Require Location Scan",
            "type": "bool",
            "default": false
        },
        {
            "key": "auto_generate_sku",
            "label": "Auto-generate SKU on new product",
            "type": "bool",
            "default": true
        }
    ],
    "nav": [
        {
            "label": "Scanner",
            "url": "/inventory-scanner/scanner",
            "icon": "fa-barcode",
            "roles": [
                "admin"
            ]
        },
        {
            "label": "Products",
            "url": "/inventory-scanner/products",
            "icon": "fa-boxes",
            "roles": [
                "admin"
            ]
        },
        {
            "label": "Scan History",
            "url": "/inventory-scanner/history",
            "icon": "fa-history",
            "roles": [
                "admin"
            ]
        }
    ]
}