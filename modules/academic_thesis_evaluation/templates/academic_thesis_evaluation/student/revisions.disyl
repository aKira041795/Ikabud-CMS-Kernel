{extends "layouts/student"}

{block content}
<div class="p-6">
    <div class="mb-6">
        <a href="/thesis/cases/{case.id|default:'0'}" class="text-blue-600 hover:underline text-sm">&larr; Back to Case</a>
    </div>

    <h1 class="text-2xl font-bold mb-6">Revision Requests</h1>

    {if revisions|default:[]|length > 0}
    <div class="space-y-4 mb-8">
        {for rev in revisions}
        <div class="bg-white rounded-lg shadow p-5 border-l-4 {if rev.severity == 'critical'}border-red-500{else if rev.severity == 'major'}border-orange-500{else}border-yellow-500{/if}">
            <div class="flex justify-between items-start mb-2">
                <div>
                    <span class="px-2 py-0.5 text-xs rounded-full font-medium {if rev.severity == 'critical'}bg-red-100 text-red-800{else if rev.severity == 'major'}bg-orange-100 text-orange-800{else}bg-yellow-100 text-yellow-800{/if}">
                        {rev.severity|capitalize}
                    </span>
                    <span class="px-2 py-0.5 text-xs rounded-full bg-gray-100 text-gray-700 ml-1">{rev.category|replace:'_':' '|capitalize}</span>
                </div>
                <span class="px-2 py-0.5 text-xs rounded-full {if rev.status == 'resolved'}bg-green-100 text-green-800{else}bg-blue-100 text-blue-800{/if}">
                    {rev.status|replace:'_':' '|capitalize}
                </span>
            </div>

            <p class="text-sm text-gray-700 mb-3">{rev.instruction}</p>

            <div class="flex gap-4 text-xs text-gray-500">
                {if rev.due_at}
                <span>Due: {rev.due_at|date:"M d, Y"}</span>
                {/if}
                <span>Created: {rev.created_at|date:"M d, Y"}</span>
            </div>
        </div>
        {/for}
    </div>
    {else}
    <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500 mb-8">
        No revision requests pending.
    </div>
    {/if}

    {* Revised manuscript upload *}
    <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold mb-4">Submit Revised Manuscript</h2>

        {if manuscripts|default:[]|length > 0}
        <div class="mb-4">
            <span class="text-sm font-medium text-gray-700">Current versions:</span>
            <div class="flex flex-wrap gap-2 mt-1">
                {for m in manuscripts}
                <span class="px-2 py-1 text-xs rounded bg-gray-100">v{m.version_number} {if m.is_revision == 1}(revision){/if}</span>
                {/for}
            </div>
        </div>
        {/if}

        <form id="upload-form" enctype="multipart/form-data" class="space-y-4">
            <input type="hidden" name="csrf_token" value="{csrf_token}">

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Revised Manuscript</label>
                <input type="file" name="manuscript" class="w-full border border-gray-300 rounded px-3 py-2 text-sm" accept=".pdf,.docx,.doc,.txt">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Submission Note</label>
                <textarea name="submission_note" rows="3" class="w-full border border-gray-300 rounded px-3 py-2 text-sm" placeholder="Describe the changes made..."></textarea>
            </div>

            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm">
                Submit Revised Manuscript
            </button>
        </form>
    </div>
</div>

{script id="upload-form-js"}
document.getElementById('upload-form').addEventListener('submit', function(e) {
    e.preventDefault();
    var fd = new FormData(this);
    fetch('/api/v1/thesis-evaluation/cases/{case.id|default:'0'}/manuscripts', {
        method: 'POST',
        headers: {'X-CSRF-TOKEN': '{csrf_token}'},
        body: fd
    }).then(function(r) { return r.json(); }).then(function(data) {
        if (data.ok) {
            alert('Revised manuscript submitted (version ' + data.data.version_number + ').');
            location.reload();
        } else {
            alert('Error: ' + (data.error || 'Upload failed'));
        }
    });
});
{/script}
{/block}
