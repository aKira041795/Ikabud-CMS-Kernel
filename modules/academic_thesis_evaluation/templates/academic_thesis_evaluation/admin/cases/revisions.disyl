{extends "layouts/admin"}

{block content}
<div class="p-6">
    <div class="mb-6">
        <a href="/admin/thesis-evaluation/cases/{case.id|default:'0'}" class="text-blue-600 hover:underline text-sm">&larr; Back to Case</a>
    </div>

    <h1 class="text-2xl font-bold mb-6">Revision Tracker</h1>

    {if revisions|default:[]|length > 0}
    <div class="space-y-4">
        {for rev in revisions}
        <div class="bg-white rounded-lg shadow p-5 border-l-4 {if rev.severity == 'critical'}border-red-500{else if rev.severity == 'major'}border-orange-500{else}border-yellow-500{/if}">
            <div class="flex justify-between items-start mb-2">
                <div>
                    <span class="px-2 py-0.5 text-xs rounded-full font-medium {if rev.severity == 'critical'}bg-red-100 text-red-800{else if rev.severity == 'major'}bg-orange-100 text-orange-800{else}bg-yellow-100 text-yellow-800{/if}">
                        {rev.severity|capitalize}
                    </span>
                    <span class="px-2 py-0.5 text-xs rounded-full bg-gray-100 text-gray-700 ml-1">{rev.category|replace:'_':' '|capitalize}</span>
                </div>
                <span class="px-2 py-0.5 text-xs rounded-full {if rev.status == 'resolved'}bg-green-100 text-green-800{else if rev.status == 'in_progress'}bg-blue-100 text-blue-800{else}bg-yellow-100 text-yellow-800{/if}">
                    {rev.status|replace:'_':' '|capitalize}
                </span>
            </div>

            <p class="text-sm text-gray-700 mb-2">{rev.instruction}</p>

            <div class="flex gap-4 text-xs text-gray-500">
                {if rev.due_at}
                <span>Due: {rev.due_at|date:"M d, Y"}</span>
                {/if}
                {if rev.resolved_in_version_id}
                <span>Resolved in: v{rev.resolved_in_version_id}</span>
                {/if}
                <span>Created: {rev.created_at|date:"M d, Y"}</span>
            </div>

            {if rev.status != 'resolved'}
            <div class="mt-3">
                <button onclick="resolveRevision({rev.id})" class="px-3 py-1 bg-green-600 text-white text-xs rounded hover:bg-green-700">
                    Mark Resolved
                </button>
            </div>
            {/if}
        </div>
        {/for}
    </div>

    <div class="mt-4 bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-semibold mb-4">Create Revision Request</h3>
        <form id="revision-form" class="space-y-3">
            <input type="hidden" name="csrf_token" value="{csrf_token}">
            <input type="hidden" name="case_id" value="{case.id|default:'0'}">

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Category</label>
                <select name="category" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
                    <option value="formatting">Formatting</option>
                    <option value="citation">Citation</option>
                    <option value="attribution">Attribution</option>
                    <option value="methodology">Methodology</option>
                    <option value="analysis">Analysis</option>
                    <option value="literature_review">Literature Review</option>
                    <option value="clarity">Clarity</option>
                    <option value="ethics">Ethics</option>
                    <option value="panel_comment">Panel Comment</option>
                    <option value="other">Other</option>
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Severity</label>
                <select name="severity" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
                    <option value="minor">Minor</option>
                    <option value="major">Major</option>
                    <option value="critical">Critical</option>
                </select>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Instruction</label>
                <textarea name="instruction" rows="3" class="w-full border border-gray-300 rounded px-3 py-2 text-sm" required></textarea>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Due Date</label>
                <input type="date" name="due_at" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
            </div>

            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm">Create Request</button>
        </form>
    </div>
    {else}
    <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
        No revision requests yet.
        <div class="mt-4">
            <h3 class="text-lg font-semibold mb-4">Create Revision Request</h3>
            <form id="revision-form" class="space-y-3 max-w-lg mx-auto text-left">
                <input type="hidden" name="csrf_token" value="{csrf_token}">
                <input type="hidden" name="case_id" value="{case.id|default:'0'}">

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Category</label>
                    <select name="category" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
                        <option value="formatting">Formatting</option>
                        <option value="citation">Citation</option>
                        <option value="attribution">Attribution</option>
                        <option value="methodology">Methodology</option>
                        <option value="analysis">Analysis</option>
                        <option value="literature_review">Literature Review</option>
                        <option value="clarity">Clarity</option>
                        <option value="ethics">Ethics</option>
                        <option value="panel_comment">Panel Comment</option>
                        <option value="other">Other</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Severity</label>
                    <select name="severity" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
                        <option value="minor">Minor</option>
                        <option value="major">Major</option>
                        <option value="critical">Critical</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Instruction</label>
                    <textarea name="instruction" rows="3" class="w-full border border-gray-300 rounded px-3 py-2 text-sm" required></textarea>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Due Date</label>
                    <input type="date" name="due_at" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
                </div>

                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm">Create Request</button>
            </form>
        </div>
    </div>
    {/if}
</div>

{script id="revision-form-js"}
document.getElementById('revision-form').addEventListener('submit', function(e) {
    e.preventDefault();
    var fd = new FormData(this);
    var data = {};
    fd.forEach(function(v, k) { data[k] = v; });
    fetch('/api/v1/thesis-evaluation/cases/' + data.case_id + '/revisions', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-CSRF-TOKEN': '{csrf_token}'},
        body: JSON.stringify(data)
    }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.ok) { location.reload(); }
        else { alert('Error: ' + (d.error || 'Unknown')); }
    });
});

function resolveRevision(id) {
    if (!confirm('Mark this revision as resolved? You must provide the manuscript version that resolves it.')) return;
    var vid = prompt('Resolved in manuscript version number:');
    if (!vid) return;
    fetch('/api/v1/thesis-evaluation/cases/{case.id|default:'0'}/revisions/' + id + '/resolve', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-CSRF-TOKEN': '{csrf_token}'},
        body: JSON.stringify({resolved_in_version_id: parseInt(vid)})
    }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.ok) { location.reload(); }
        else { alert('Error: ' + (d.error || 'Unknown')); }
    });
}
{/script}
{/block}
