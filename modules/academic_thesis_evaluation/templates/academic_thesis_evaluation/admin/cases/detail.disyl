{extends "layouts/admin"}

{block content}
<div class="p-6">
    {if case|default:null}
    <div class="mb-6">
        <a href="/admin/thesis-evaluation/cases" class="text-blue-600 hover:underline text-sm">&larr; Back to Cases</a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {* Main column *}
        <div class="lg:col-span-2 space-y-6">
            {* Case info *}
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-xl font-bold mb-4">{case.title}</h2>
                <dl class="grid grid-cols-2 gap-4 text-sm">
                    <div>
                        <dt class="text-gray-500">Profile</dt>
                        <dd>{case.profile_name|default:'—'} ({case.profile_code|default:'—'})</dd>
                    </div>
                    <div>
                        <dt class="text-gray-500">Degree Level</dt>
                        <dd>{case.degree_level|default:'—'}</dd>
                    </div>
                    <div>
                        <dt class="text-gray-500">Current Stage</dt>
                        <dd><span class="px-2 py-1 text-xs rounded-full bg-blue-100 text-blue-800">{case.current_stage}</span></dd>
                    </div>
                    <div>
                        <dt class="text-gray-500">Status</dt>
                        <dd>{case.status}</dd>
                    </div>
                    <div>
                        <dt class="text-gray-500">Submitted</dt>
                        <dd>{case.created_at|date:"M d, Y"}</dd>
                    </div>
                    <div>
                        <dt class="text-gray-500">Research Category</dt>
                        <dd>{case.research_category|default:'—'}</dd>
                    </div>
                </dl>
            </div>

            {* Stage timeline *}
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-semibold mb-4">Stage Timeline</h3>
                {if stages|default:[]|length > 0}
                <div class="space-y-3">
                    {for stage in stages}
                    <div class="flex items-center gap-3">
                        <div class="w-3 h-3 rounded-full {if stage.status == 'completed'}bg-green-500{else if stage.status == 'active'}bg-blue-500{else}bg-gray-300{/if}"></div>
                        <div class="flex-1">
                            <span class="font-medium text-sm">{stage.stage_code}</span>
                            <span class="text-xs text-gray-500 ml-2">({stage.status})</span>
                        </div>
                        {if stage.completed_at}
                        <span class="text-xs text-gray-400">{stage.completed_at|date:"M d"}</span>
                        {/if}
                    </div>
                    {/for}
                </div>
                {else}
                <p class="text-sm text-gray-500">No stages recorded yet.</p>
                {/if}
            </div>

            {* Manuscript versions *}
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-semibold mb-4">Manuscript Versions</h3>
                {if manuscripts|default:[]|length > 0}
                <div class="space-y-2">
                    {for m in manuscripts}
                    <div class="flex justify-between items-center p-3 bg-gray-50 rounded">
                        <span class="text-sm">Version {m.version_number} {if m.is_revision == 1}<span class="text-xs text-orange-600">(revision)</span>{/if}</span>
                        <span class="text-xs text-gray-400">{m.created_at|date:"M d, Y H:i"}</span>
                    </div>
                    {/for}
                </div>
                {else}
                <p class="text-sm text-gray-500">No manuscripts uploaded yet.</p>
                {/if}
            </div>
        </div>

        {* Sidebar *}
        <div class="space-y-6">
            {* Quick actions *}
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-semibold mb-4">Quick Actions</h3>
                <div class="space-y-2">
                    <a href="/admin/thesis-evaluation/cases/{case.id}/evidence" class="block w-full text-center px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm">
                        View Evidence
                    </a>
                    <a href="/admin/thesis-evaluation/cases/{case.id}/rubrics" class="block w-full text-center px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 text-sm">
                        View Rubrics
                    </a>
                    <a href="/admin/thesis-evaluation/cases/{case.id}/revisions" class="block w-full text-center px-4 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300 text-sm">
                        Revision Tracker
                    </a>
                </div>
            </div>

            {* Reviewers *}
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-semibold mb-4">Reviewers</h3>
                {if assignments|default:[]|length > 0}
                <div class="space-y-2">
                    {for a in assignments}
                    <div class="flex justify-between items-center p-2 bg-gray-50 rounded text-sm">
                        <span>{a.reviewer_role}</span>
                        <span class="px-2 py-0.5 text-xs rounded-full {if a.status == 'completed'}bg-green-100 text-green-800{else if a.status == 'accepted'}bg-blue-100 text-blue-800{else}bg-yellow-100 text-yellow-800{/if}">{a.status}</span>
                    </div>
                    {/for}
                </div>
                {else}
                <p class="text-sm text-gray-500">No reviewers assigned.</p>
                {/if}
            </div>
        </div>
    </div>
    {else}
    <p class="text-gray-500">Case not found.</p>
    {/if}
</div>
{/block}
