{
    "id": "cms",
    "name": "Content Management System",
    "version": "1.0.0",
    "description": "Full CMS with pages, posts, custom content types, media library, and public frontend.",
    "author": "Noah C. Omamalin",
    "depends": [
        "users",
        "media",
        "search"
    ],
    "auth_cookie": "cms_token",
    "auth_owned": {
        "users_table": "cms_users",
        "username_column": "username",
        "email_column": "email",
        "password_column": "password_hash",
        "name_column": "display_name",
        "active_column": "is_active",
        "admin_roles": [
            "administrator"
        ],
        "default_admin_role": "administrator",
        "requires_named_admin_on_provision": false,
        "touch_updated_at": false
    },
    "owns_tables": [
        "cms_content",
        "cms_content_meta",
        "cms_content_types",
        "cms_field_definitions",
        "cms_content_fields",
        "cms_blocks",
        "cms_builder_documents",
        "cms_builder_revisions",
        "cms_builder_reusable_sections",
        "cms_builder_templates",
        "cms_relations",
        "cms_categories",
        "cms_content_categories",
        "cms_users",
        "cms_media",
        "cms_tags",
        "cms_content_tags",
        "cms_menus",
        "cms_menu_items",
        "cms_revisions",
        "cms_slug_redirects",
        "cms_media_usage",
        "cms_menu_locations",
        "cms_saved_blocks",
        "cms_password_resets",
        "cms_auth_verifications",
        "cms_user_services",
        "audit_logs",
        "kernel_search_index",
        "workflow_instances",
        "workflow_transition_logs",
        "cms_theme_customizer",
        "cms_ai_content_plans",
        "cms_ai_content_runs",
        "cms_entity_capabilities",
        "cms_entity_progress"
    ],
    "reads_tables": [
        "kernel_event_triggers",
        "rate_limits",
        "workflow_definitions",
        "ec_stores",
        "ec_store_users"
    ],
    "migrations": [
        "database/migrations/001_cms_content_core.sql",
        "database/migrations/001_cms_foundation.sql",
        "database/migrations/002_cms_blocks_json.sql",
        "database/migrations/003_cms_content_types_and_fields.sql",
        "database/migrations/003_cms_content_fields.sql",
        "database/migrations/004_cms_blocks_table.sql",
        "database/migrations/005_cms_relations.sql",
        "database/migrations/006_cms_categories.sql",
        "database/migrations/007_cms_tags.sql",
        "database/migrations/008_cms_menus.sql",
        "database/migrations/009_cms_revisions.sql",
        "database/migrations/010_cms_tier3.sql",
        "database/migrations/011_cms_builder_documents.sql",
        "database/migrations/012_cms_theme_customizer.sql",
        "database/migrations/013_cms_crud_enhancements.sql",
        "database/migrations/014_cms_redirect_manager.sql",
        "database/migrations/015_cms_password_resets.sql",
        "database/migrations/016_cms_ai_content_automation.sql",
        "database/migrations/017_cms_ai_plan_search_grounding.sql",
        "database/migrations/018_cms_ai_plan_content_mode.sql",
        "database/migrations/019_cms_ai_plan_auto_refine_policy.sql",
        "database/migrations/020_cms_ai_plan_auto_publish_policy.sql",
        "database/migrations/021_cms_entity_capabilities.sql",
        "database/migrations/022_cms_entity_progress.sql",
        "database/migrations/023_rename_capability_ids.sql",
        "database/migrations/024_cms_auth_verifications.sql",
        "database/migrations/025_cms_user_services.sql"
    ],
    "seeds": [
        "database/seeds/001_cms_baseline_content_types.sql"
    ],
    "capabilities": {
        "exposes": [
            {
                "id": "cms.content.get@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "entity.list.cms_post@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "entity.list.cms_page@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "cms.content.list@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "cms.content.create@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "cms.content.update@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "kernel.auth.authenticate@1",
                "priority": 500,
                "modes": [
                    "pipeline"
                ]
            },
            {
                "id": "cms.media.list@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "cms.media.upload@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "cms.builder.get@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "cms.builder.render@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "cms.settings.get@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "cms.themes.list@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "entity.capability.pricing.data@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "entity.capability.inventory.data@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "entity.capability.booking.data@1",
                "priority": 10,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "entity.capability.inquiry.data@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "entity.capability.progress_tracking.data@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "entity.capability.lessons_index.data@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "entity.capability.media_gallery.data@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            }
        ],
        "depends": [
            "kernel.auth.user@1",
            "kernel.audit.record@1",
            "ai.text.generate@1",
            "workflow.state.get@1",
            "workflow.transition@1",
            "tinymce.assets.get@1",
            "tinymce.config.get@1",
            "tinymce.html.normalize@1",
            "tinymce.html.sanitize@1"
        ],
        "policy": {
            "capabilities": {
                "cms.content.create@1": {
                    "allow_callers": [
                        "content-ingestion",
                        "media",
                        "search",
                        "users",
                        "workflow"
                    ]
                },
                "cms.content.update@1": {
                    "allow_callers": [
                        "content-ingestion",
                        "media",
                        "search",
                        "users",
                        "workflow"
                    ]
                },
                "cms.content.get@1": {
                    "allow_callers": [
                        "media",
                        "search",
                        "workflow"
                    ]
                },
                "cms.content.list@1": {
                    "allow_callers": [
                        "media",
                        "search",
                        "workflow"
                    ]
                },
                "cms.settings.get@1": {
                    "allow_callers": [
                        "contact-form"
                    ]
                }
            }
        }
    },
    "routes": true,
    "events": [
        {
            "key": "cms.content.created",
            "description": "Content item created",
            "available_vars": [
                "content_id",
                "title",
                "type",
                "author_id"
            ]
        },
        {
            "key": "cms.content.published",
            "description": "Content item published",
            "available_vars": [
                "content_id",
                "title",
                "slug",
                "type"
            ]
        },
        {
            "key": "cms.content.updated",
            "description": "Content item updated",
            "available_vars": [
                "content_id",
                "title",
                "fields_changed"
            ]
        },
        {
            "key": "cms.content.deleted",
            "description": "Content item trashed",
            "available_vars": [
                "content_id",
                "title",
                "type"
            ]
        },
        {
            "key": "cms.media.uploaded",
            "description": "Media file uploaded",
            "available_vars": [
                "media_id",
                "filename",
                "mime_type"
            ]
        },
        {
            "key": "cms.user.created",
            "description": "CMS user created",
            "available_vars": [
                "user_id",
                "username",
                "role"
            ]
        },
        {
            "key": "cms.settings.updated",
            "description": "CMS settings changed",
            "available_vars": [
                "settings"
            ]
        }
    ],
    "settings_fields": [
        {
            "key": "site_title",
            "type": "text",
            "label": "Site Title",
            "default": ""
        },
        {
            "key": "site_tagline",
            "type": "text",
            "label": "Site Tagline",
            "default": ""
        },
        {
            "key": "posts_per_page",
            "type": "number",
            "label": "Posts Per Page",
            "default": "10"
        },
        {
            "key": "default_post_status",
            "type": "select",
            "label": "Default Post Status",
            "default": "draft"
        },
        {
            "key": "comments_enabled",
            "type": "select",
            "label": "Comments Enabled",
            "default": "1"
        },
        {
            "key": "excerpt_length",
            "type": "number",
            "label": "Excerpt Length",
            "default": "160"
        },
        {
            "key": "max_upload_mb",
            "type": "number",
            "label": "Max Upload Size (MB)",
            "default": "2"
        },
        {
            "key": "seo_title_separator",
            "type": "text",
            "label": "SEO Title Separator",
            "default": "|"
        },
        {
            "key": "seo_meta_description",
            "type": "textarea",
            "label": "SEO Meta Description",
            "default": ""
        },
        {
            "key": "seo_og_image",
            "type": "text",
            "label": "SEO Open Graph Image",
            "default": ""
        },
        {
            "key": "seo_robots",
            "type": "text",
            "label": "SEO Robots",
            "default": "index, follow"
        },
        {
            "key": "homepage_type",
            "type": "select",
            "label": "Homepage Type",
            "default": "posts"
        },
        {
            "key": "homepage_page_id",
            "type": "text",
            "label": "Homepage Page ID",
            "default": ""
        },
        {
            "key": "date_format",
            "type": "text",
            "label": "Date Format",
            "default": "M j, Y"
        },
        {
            "key": "time_format",
            "type": "text",
            "label": "Time Format",
            "default": "g:i A"
        },
        {
            "key": "cache_enabled",
            "type": "select",
            "label": "Cache Enabled",
            "default": "1"
        },
        {
            "key": "cache_ttl",
            "type": "number",
            "label": "Cache TTL",
            "default": "600"
        },
        {
            "key": "social_facebook",
            "type": "text",
            "label": "Facebook URL",
            "default": ""
        },
        {
            "key": "social_twitter",
            "type": "text",
            "label": "Twitter URL",
            "default": ""
        },
        {
            "key": "social_instagram",
            "type": "text",
            "label": "Instagram URL",
            "default": ""
        },
        {
            "key": "social_youtube",
            "type": "text",
            "label": "YouTube URL",
            "default": ""
        },
        {
            "key": "social_linkedin",
            "type": "text",
            "label": "LinkedIn URL",
            "default": ""
        },
        {
            "key": "active_theme",
            "type": "text",
            "label": "Active Theme",
            "default": "default"
        },
        {
            "key": "active_ecommerce_theme",
            "type": "text",
            "label": "Active Ecommerce Theme",
            "default": "default"
        },
        {
            "key": "builder_enabled_types",
            "type": "text",
            "label": "Builder Enabled Types",
            "default": "page"
        },
        {
            "key": "builder_enforce_lock",
            "type": "select",
            "label": "Builder Enforce Lock",
            "default": "1"
        },
        {
            "key": "page_builder_show_sidebar",
            "type": "select",
            "label": "Show Sidebar on Page Builder Pages",
            "default": "0"
        },
        {
            "key": "default_comment_status",
            "type": "text",
            "label": "Default Comment Status",
            "default": "open"
        },
        {
            "key": "enabled_post_formats",
            "type": "text",
            "label": "Enabled Post Formats",
            "default": "standard,aside,gallery,link,image,quote,video,audio"
        },
        {
            "key": "media_alt_required",
            "type": "select",
            "label": "Media Alt Required",
            "default": "0"
        },
        {
            "key": "media_extra_allowed_exts",
            "type": "text",
            "label": "Extra Allowed Media Extensions",
            "default": ""
        },
        {
            "key": "media_usage_tracking",
            "type": "select",
            "label": "Media Usage Tracking",
            "default": "1"
        },
        {
            "key": "reading_time_enabled",
            "type": "select",
            "label": "Reading Time Enabled",
            "default": "1"
        },
        {
            "key": "reading_time_wpm",
            "type": "number",
            "label": "Reading Time WPM",
            "default": "200"
        },
        {
            "key": "role_permissions",
            "type": "textarea",
            "label": "Role Permissions",
            "default": ""
        }
    ],
    "nav": [
