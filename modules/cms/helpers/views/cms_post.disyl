{ikb_entity_view name="cms_post" view="card_grid"}
    {field name="title" type="string" role="title"}
    {field name="excerpt" type="string" role="subtitle"}
    {field name="published_at" type="date" renderer="datetime:date"}
    {field name="author_name" type="string"}
    {field name="image" type="string" role="image"}
    {field name="status" type="enum" renderer="badge:{published|green|draft|gray}"}
    {action name="view" url="{base_url}/cms/blog/{slug}" label="Read More"}
    {filter name="status" type="enum" values="published,draft"}
{/ikb_entity_view}

{ikb_entity_view name="cms_post" view="table"}
    {field name="id" type="number"}
    {field name="title" type="string"}
    {field name="author_name" type="string"}
    {field name="status" type="enum" renderer="badge:{published|green|draft|gray}"}
    {field name="published_at" type="date" renderer="datetime:date"}
    {action name="view" url="/cms/blog/{slug}" label="View"}
{/ikb_entity_view}

{ikb_entity_view name="cms_post" view="compact"}
    {field name="title" type="string"}
    {field name="excerpt" type="string"}
    {field name="published_at" type="date" renderer="datetime:date"}
    {field name="status" type="enum" renderer="badge:{published|green|draft|gray}"}
{/ikb_entity_view}
