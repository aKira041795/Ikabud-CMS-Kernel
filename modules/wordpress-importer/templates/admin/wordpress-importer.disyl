{extends "modules/cms/layouts/admin.disyl"}

{block content}
<div x-data="wordpressImporter()" class="max-w-3xl">
    <div class="mb-6">
        <h1 class="text-xl font-bold text-gray-900">WordPress Import</h1>
        <p class="text-sm text-gray-500 mt-0.5">Import WordPress XML/WXR posts, pages, categories, and tags into this CMS.</p>
    </div>

    {* ── Live Sync callout (shown when content-ingestion module is active) ── *}
    {if bridge_available}
    <div class="mb-6 rounded-xl border border-blue-200 bg-blue-50/70 overflow-hidden">
        <div class="px-5 py-4 border-b border-blue-100 flex items-center justify-between gap-3">
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded bg-blue-600 text-white text-xs font-bold flex-shrink-0">CI</span>
                <h2 class="text-sm font-semibold text-gray-900">Live Sync Available — Content Ingestion Bridge</h2>
            </div>
            {if bridge_enabled}
            <span class="flex-shrink-0 px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">Active</span>
            {else}
            <span class="flex-shrink-0 px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700">Not configured</span>
            {/if}
        </div>
        <div class="px-5 py-4 space-y-3">
            <p class="text-sm text-gray-700">
                The <strong>Content Ingestion Bridge</strong> is installed. Instead of a one-shot XML export, you can set up
                <strong>real-time live sync</strong> — posts and pages pushed automatically every time you publish in WordPress.
            </p>
            <div class="flex flex-wrap items-center gap-3">
                {if bridge_enabled}
                <a href="{bridge_companion_url}"
                   class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                    Download Companion Plugin
                </a>
                {/if}
                <a href="{bridge_settings_url}"
                   class="inline-flex items-center gap-2 px-4 py-2 border border-blue-300 text-blue-700 text-sm font-semibold rounded-lg hover:bg-blue-100 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/></svg>
                    {if bridge_enabled}Bridge Settings &amp; Dashboard{else}Configure Live Sync{/if}
                </a>
            </div>
            {if !bridge_enabled}
            <p class="text-xs text-gray-500">Configure the bridge (add your WordPress URL + download the companion plugin) to enable live sync. The one-shot import below still works without configuration.</p>
            {/if}
        </div>
    </div>
    {/if}

    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 bg-amber-50/70">
            <h2 class="text-sm font-semibold text-gray-900">Import XML</h2>
        </div>
        <div class="p-5 space-y-4">
            <div>
                <label class="block text-xs font-medium text-gray-500 mb-1.5">WordPress Export File</label>
                <label class="flex items-center justify-center gap-2 px-4 py-6 border-2 border-dashed border-gray-300 rounded-lg cursor-pointer hover:border-sky-400 hover:bg-sky-50/50 transition-colors"
                    :class="importFile ? 'border-emerald-400 bg-emerald-50/50' : ''">
                    <template x-if="!importFile">
                        <span class="text-sm text-gray-400">Click to select a WordPress `.xml` export</span>
                    </template>
                    <template x-if="importFile">
                        <span class="text-sm text-emerald-700 font-medium" x-text="importFile.name"></span>
                    </template>
                    <input type="file" accept=".xml,text/xml,application/xml" @change="importFile = $event.target.files[0] || null" class="hidden">
                </label>
                <p class="text-[11px] text-gray-400 mt-1">Supported scope: posts, pages, categories, and tags. Media download is not part of this extension yet.</p>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-500 mb-1.5">Duplicate Handling</label>
                <div class="flex gap-3">
                    <label class="inline-flex items-center gap-1.5 text-sm">
                        <input type="radio" x-model="importMode" value="merge" class="border-gray-300 text-sky-600 focus:ring-sky-500"> Skip existing
                    </label>
                    <label class="inline-flex items-center gap-1.5 text-sm">
                        <input type="radio" x-model="importMode" value="replace" class="border-gray-300 text-sky-600 focus:ring-sky-500"> Overwrite
                    </label>
                </div>
            </div>

            <button @click="doImport()" :disabled="!importFile || importing" class="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-amber-600 text-white text-sm font-semibold rounded-lg hover:bg-amber-700 disabled:opacity-50 transition-colors">
                <svg class="w-4 h-4" x-show="!importing" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                <svg class="w-4 h-4 animate-spin" x-show="importing" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                <span x-text="importing ? 'Importing...' : 'Import WordPress XML'"></span>
            </button>

            <div x-show="importResult" x-cloak class="bg-gray-50 rounded-lg p-4 text-sm">
                <h4 class="font-semibold text-gray-700 mb-2">Import Result</h4>
                <template x-if="importResult">
                    <div class="grid grid-cols-2 gap-1 text-xs">
                        <span class="text-gray-500">Imported:</span>
                        <span class="font-semibold text-emerald-700" x-text="importResult.imported || 0"></span>
                        <span class="text-gray-500">Updated:</span>
                        <span class="font-semibold text-sky-700" x-text="importResult.updated || 0"></span>
                        <span class="text-gray-500">Skipped:</span>
                        <span class="font-semibold text-gray-500" x-text="importResult.skipped || 0"></span>
                        <span class="text-gray-500">Errors:</span>
                        <span class="font-semibold" :class="(importResult.errors||0) > 0 ? 'text-red-600' : 'text-gray-400'" x-text="importResult.errors || 0"></span>
                        <span class="text-gray-500">New Categories:</span>
                        <span class="font-semibold text-gray-700" x-text="importResult.categories_imported || 0"></span>
                        <span class="text-gray-500">Category Links:</span>
                        <span class="font-semibold text-gray-700" x-text="importResult.category_links || 0"></span>
                        <span class="text-gray-500">New Tags:</span>
                        <span class="font-semibold text-gray-700" x-text="importResult.tags_imported || 0"></span>
                        <span class="text-gray-500">Tag Links:</span>
                        <span class="font-semibold text-gray-700" x-text="importResult.tag_links || 0"></span>
                    </div>
                </template>
            </div>

            <p x-show="importError" x-text="importError" class="text-sm text-red-600"></p>
        </div>
    </div>
</div>

<script>
function wordpressImporter() {
    return {
        importFile: null,
        importMode: 'merge',
        importing: false,
        importResult: null,
        importError: '',

        async doImport() {
            if (!this.importFile) return;
            this.importing = true;
            this.importResult = null;
            this.importError = '';
            try {
                const fd = new FormData();
                fd.append('file', this.importFile);
                fd.append('mode', this.importMode);
                fd.append('_token', CMS_CSRF);
                const res = await fetch(CMS_BASE + '/api/v1/cms/wordpress-importer/import', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.ok) {
                    this.importResult = data.stats;
                } else {
                    this.importError = data.error || 'Import failed';
                }
            } catch (e) {
                this.importError = 'Network error';
            } finally {
                this.importing = false;
            }
        }
    };
}
</script>
{/block}