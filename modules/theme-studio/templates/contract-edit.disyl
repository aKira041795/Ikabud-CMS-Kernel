{extends "modules/cms/layouts/admin.disyl"}

{block content}
<div class="p-6 space-y-6" x-data="contractEditor()" x-init="init()">
    <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
            <h1 class="text-2xl font-bold mb-2">Theme Contract Editor</h1>
            <p class="text-gray-500">Edit one of the ARK authority-layer JSON contracts for the active theme.</p>
        </div>
        <a href="/admin/theme-studio/contracts" class="px-4 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">Back To Theme Contracts</a>
    </div>

    {if error}
    <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</div>
    {/if}
    {if notice}
    <div class="rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{notice}</div>
    {/if}

    {if !contract_detail.registered}
    <div class="bg-white rounded-xl shadow-sm border border-red-100 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-2">Unknown Contract</h2>
        <p class="text-sm text-gray-600">This contract key is not on the Theme Studio allowlist, so it cannot be edited here.</p>
    </div>
    {else}
    {if contract_detail.key == 'renderer-registry'}
    <script type="application/json" id="renderer-rows-json">{contract_detail.form.renderer_rows_json|raw}</script>
    {else if contract_detail.key == 'block-registry'}
    <script type="application/json" id="block-registry-rows-json">{contract_detail.form.block_registry_rows_json|raw}</script>
    {else if contract_detail.key == 'entity-view-map'}
    <script type="application/json" id="entity-view-rows-json">{contract_detail.form.entity_view_rows_json|raw}</script>
    {/if}
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <div class="xl:col-span-2 bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm mb-6">
                <div>
                    <div class="text-gray-500 mb-1">Theme</div>
                    <div class="font-semibold text-gray-900">{theme_manifest.label|default:active_theme|default:'None'}</div>
                </div>
                <div>
                    <div class="text-gray-500 mb-1">Contract</div>
                    <div class="font-semibold text-gray-900">{contract_detail.label}</div>
                </div>
                <div>
                    <div class="text-gray-500 mb-1">File</div>
                    <div class="font-semibold text-gray-900 font-mono text-xs break-all">{contract_detail.file}</div>
                </div>
            </div>

            {if contract_detail.key == 'renderer-registry'}
            <form method="POST" action="/admin/theme-studio/contracts/{contract_detail.key}/save" class="space-y-6">
                <input type="hidden" name="editor_mode" value="structured">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Version</label>
                        <input type="text" name="version" value="{contract_detail.form.version}" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500" required>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
                        <input type="text" name="description" value="{contract_detail.form.description}" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>
                </div>

                <div class="space-y-4">
                    <div class="flex items-center justify-between gap-4 flex-wrap">
                        <div>
                            <h2 class="text-base font-semibold text-gray-900">Renderer Entries</h2>
                            <p class="text-sm text-gray-500">Each entry maps an ARK render name to either a template or a governed component, plus its controls and required context.</p>
                        </div>
                        <button type="button" @click="addRenderer()" class="px-3 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">Add Renderer</button>
                    </div>

                    <template x-for="(renderer, index) in renderers" :key="index">
                        <div class="rounded-xl border border-gray-200 p-4 space-y-4 bg-gray-50/40">
                            <div class="flex items-center justify-between gap-4">
                                <div class="text-sm font-medium text-gray-700">Renderer Row <span x-text="index + 1"></span></div>
                                <button type="button" @click="removeRenderer(index)" class="text-sm text-red-600 hover:text-red-800">Remove</button>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Renderer Name</label>
                                    <input type="text" name="renderer_name[]" x-model="renderer.name" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900" placeholder="pricing_default">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Template Path</label>
                                    <input type="text" name="renderer_template[]" x-model="renderer.template" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900" placeholder="public/blocks/pricing/pricing.block.default.disyl">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Governed Component</label>
                                    <input type="text" name="renderer_component[]" x-model="renderer.renders_as_component" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900" placeholder="ikb_entity_list">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Controls</label>
                                    <textarea name="renderer_controls[]" x-model="renderer.controls_text" rows="3" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900" placeholder="currency&#10;variant"></textarea>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Context Keys</label>
                                    <textarea name="renderer_context_keys[]" x-model="renderer.context_keys_text" rows="3" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900" placeholder="entity&#10;capability_data&#10;entity_presentation"></textarea>
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-medium text-gray-600 mb-1">Extra JSON</label>
                                <textarea name="renderer_extra_json[]" x-model="renderer.extra_json" rows="4" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900" placeholder="{}"></textarea>
                                <p class="text-xs text-gray-400 mt-1">Use this only for renderer keys beyond template/component, controls, and context keys.</p>
                            </div>
                        </div>
                    </template>
                </div>

                <div class="flex items-center justify-end gap-3">
                    <a href="/admin/theme-studio/contracts" class="px-4 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</a>
                    <button type="submit" class="px-4 py-2 text-sm font-medium bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">Save Structured Contract</button>
                </div>
            </form>

            <div class="mt-8 pt-6 border-t border-gray-200">
                <div class="mb-4">
                    <h2 class="text-base font-semibold text-gray-900">Advanced JSON</h2>
                    <p class="text-sm text-gray-500">Use advanced JSON only when the structured renderer editor does not cover a legitimate registry property yet.</p>
                </div>
                <form method="POST" action="/admin/theme-studio/contracts/{contract_detail.key}/save" class="space-y-4">
                    <input type="hidden" name="editor_mode" value="advanced">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Contract JSON</label>
                        <textarea name="contract_json" rows="20" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">{contract_detail.json}</textarea>
                    </div>
                    <div class="flex items-center justify-end">
                        <button type="submit" class="px-4 py-2 text-sm font-medium border border-gray-300 rounded-lg hover:bg-gray-50">Save Advanced JSON</button>
                    </div>
                </form>
            </div>
            {else if contract_detail.key == 'block-registry'}
            <form method="POST" action="/admin/theme-studio/contracts/{contract_detail.key}/save" class="space-y-6">
                <input type="hidden" name="editor_mode" value="structured">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Version</label>
                        <input type="text" name="version" value="{contract_detail.form.version}" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500" required>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
                        <input type="text" name="description" value="{contract_detail.form.description}" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>
                </div>

                <div class="space-y-4">
                    <div class="flex items-center justify-between gap-4 flex-wrap">
                        <div>
                            <h2 class="text-base font-semibold text-gray-900">Block Categories</h2>
                            <p class="text-sm text-gray-500">Each category maps to the ARK block types builders are allowed to expose in that lane.</p>
                        </div>
                        <button type="button" @click="addBlockCategory()" class="px-3 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">Add Category</button>
                    </div>

                    <template x-for="(row, index) in blockCategories" :key="index">
                        <div class="rounded-xl border border-gray-200 p-4 space-y-4 bg-gray-50/40">
                            <div class="flex items-center justify-between gap-4">
                                <div class="text-sm font-medium text-gray-700">Category Row <span x-text="index + 1"></span></div>
                                <button type="button" @click="removeBlockCategory(index)" class="text-sm text-red-600 hover:text-red-800">Remove</button>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Category Name</label>
                                    <input type="text" name="category_name[]" x-model="row.category_name" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900" placeholder="ecommerce">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Block Types</label>
                                    <textarea name="category_block_types[]" x-model="row.block_types_text" rows="5" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900" placeholder="product_card&#10;product_grid&#10;price_display"></textarea>
                                </div>
                            </div>
                        </div>
                    </template>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Extra Registry JSON</label>
                    <textarea name="extra_registry_json" rows="6" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">{contract_detail.form.extra_registry_json}</textarea>
                    <p class="text-xs text-gray-400 mt-2">Use this only for valid top-level registry keys beyond version, description, and categories.</p>
                </div>

                <div class="flex items-center justify-end gap-3">
                    <a href="/admin/theme-studio/contracts" class="px-4 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</a>
                    <button type="submit" class="px-4 py-2 text-sm font-medium bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">Save Structured Contract</button>
                </div>
            </form>

            <div class="mt-8 pt-6 border-t border-gray-200">
                <div class="mb-4">
                    <h2 class="text-base font-semibold text-gray-900">Advanced JSON</h2>
                    <p class="text-sm text-gray-500">Use advanced JSON only when the structured block-registry editor does not yet cover a legitimate ARK registry property.</p>
                </div>
                <form method="POST" action="/admin/theme-studio/contracts/{contract_detail.key}/save" class="space-y-4">
                    <input type="hidden" name="editor_mode" value="advanced">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Contract JSON</label>
                        <textarea name="contract_json" rows="20" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">{contract_detail.json}</textarea>
                    </div>
                    <div class="flex items-center justify-end">
                        <button type="submit" class="px-4 py-2 text-sm font-medium border border-gray-300 rounded-lg hover:bg-gray-50">Save Advanced JSON</button>
                    </div>
                </form>
            </div>
            {else if contract_detail.key == 'entity-view-map'}
            <form method="POST" action="/admin/theme-studio/contracts/{contract_detail.key}/save" class="space-y-6">
                <input type="hidden" name="editor_mode" value="structured">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Version</label>
                        <input type="text" name="version" value="{contract_detail.form.version}" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500" required>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
                        <input type="text" name="description" value="{contract_detail.form.description}" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>
                </div>

                <div class="space-y-4">
                    <div class="flex items-center justify-between gap-4 flex-wrap">
                        <div>
                            <h2 class="text-base font-semibold text-gray-900">Entity View Rows</h2>
                            <p class="text-sm text-gray-500">Each row defines one entity type + view pair in the ARK capability bridge, including fields, actions, and optional block mapping.</p>
                        </div>
                        <button type="button" @click="addEntityView()" class="px-3 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">Add Entity View</button>
                    </div>

                    <template x-for="(row, index) in entityViews" :key="index">
                        <div class="rounded-xl border border-gray-200 p-4 space-y-4 bg-gray-50/40">
                            <div class="flex items-center justify-between gap-4">
                                <div class="text-sm font-medium text-gray-700">Entity View Row <span x-text="index + 1"></span></div>
                                <button type="button" @click="removeEntityView(index)" class="text-sm text-red-600 hover:text-red-800">Remove</button>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Entity Type</label>
                                    <input type="text" name="entity_type[]" x-model="row.entity_type" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900" placeholder="ecommerce_product">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">View Name</label>
                                    <input type="text" name="view_name[]" x-model="row.view_name" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900" placeholder="compact">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Fields</label>
                                    <textarea name="view_fields[]" x-model="row.fields_text" rows="4" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900" placeholder="name&#10;price&#10;image"></textarea>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Actions</label>
                                    <textarea name="view_actions[]" x-model="row.actions_text" rows="4" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900" placeholder="view&#10;add_to_cart"></textarea>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-gray-600 mb-1">Block Mapping</label>
                                    <input type="text" name="view_block[]" x-model="row.block" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900" placeholder="product_card">
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-medium text-gray-600 mb-1">Extra JSON</label>
                                <textarea name="view_extra_json[]" x-model="row.extra_json" rows="4" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900" placeholder="{}"></textarea>
                                <p class="text-xs text-gray-400 mt-1">Use this for valid bridge properties beyond `fields`, `actions`, and `block`.</p>
                            </div>
                        </div>
                    </template>
                </div>

                <div class="flex items-center justify-end gap-3">
                    <a href="/admin/theme-studio/contracts" class="px-4 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</a>
                    <button type="submit" class="px-4 py-2 text-sm font-medium bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">Save Structured Contract</button>
                </div>
            </form>

            <div class="mt-8 pt-6 border-t border-gray-200">
                <div class="mb-4">
                    <h2 class="text-base font-semibold text-gray-900">Advanced JSON</h2>
                    <p class="text-sm text-gray-500">Use advanced JSON only when the structured capability-bridge editor does not yet cover a legitimate ARK view property.</p>
                </div>
                <form method="POST" action="/admin/theme-studio/contracts/{contract_detail.key}/save" class="space-y-4">
                    <input type="hidden" name="editor_mode" value="advanced">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Contract JSON</label>
                        <textarea name="contract_json" rows="20" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">{contract_detail.json}</textarea>
                    </div>
                    <div class="flex items-center justify-end">
                        <button type="submit" class="px-4 py-2 text-sm font-medium border border-gray-300 rounded-lg hover:bg-gray-50">Save Advanced JSON</button>
                    </div>
                </form>
            </div>
            {else if contract_detail.key == 'page-composition-schema'}
            <form method="POST" action="/admin/theme-studio/contracts/{contract_detail.key}/save" class="space-y-6">
                <input type="hidden" name="editor_mode" value="structured">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Version</label>
                        <input type="text" name="version" value="{contract_detail.form.version}" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500" required>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
                        <input type="text" name="description" value="{contract_detail.form.description}" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>
                </div>

                <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
                    <div class="rounded-xl border border-gray-200 p-4 space-y-4 bg-gray-50/40">
                        <h2 class="text-base font-semibold text-gray-900">Document Envelope</h2>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Required Keys</label>
                            <textarea name="envelope_required_keys_text" rows="4" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900">{contract_detail.form.envelope_required_keys_text}</textarea>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Default Schema Version</label>
                            <input type="text" name="envelope_schema_version_default" value="{contract_detail.form.envelope_schema_version_default}" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Extra Envelope JSON</label>
                            <textarea name="envelope_extra_json" rows="4" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900">{contract_detail.form.envelope_extra_json}</textarea>
                        </div>
                    </div>

                    <div class="rounded-xl border border-gray-200 p-4 space-y-4 bg-gray-50/40">
                        <h2 class="text-base font-semibold text-gray-900">Root Node</h2>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Root Type</label>
                            <input type="text" name="root_type" value="{contract_detail.form.root_type}" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Required Keys</label>
                            <textarea name="root_required_keys_text" rows="4" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900">{contract_detail.form.root_required_keys_text}</textarea>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Children Key</label>
                            <input type="text" name="root_children_key" value="{contract_detail.form.root_children_key}" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Extra Root JSON</label>
                            <textarea name="root_extra_json" rows="4" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900">{contract_detail.form.root_extra_json}</textarea>
                        </div>
                    </div>

                    <div class="rounded-xl border border-gray-200 p-4 space-y-4 bg-gray-50/40">
                        <h2 class="text-base font-semibold text-gray-900">Top-Level Children</h2>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Allowed Top-Level Node Types</label>
                            <textarea name="allowed_top_level_children_text" rows="8" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900">{contract_detail.form.allowed_top_level_children_text}</textarea>
                        </div>
                    </div>

                    <div class="rounded-xl border border-gray-200 p-4 space-y-4 bg-gray-50/40">
                        <h2 class="text-base font-semibold text-gray-900">Node Contract</h2>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Required Keys</label>
                            <textarea name="node_required_keys_text" rows="4" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900">{contract_detail.form.node_required_keys_text}</textarea>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" name="props_must_be_object" value="1" {if contract_detail.form.props_must_be_object}checked{/if}> Props Must Be Object</label>
                            <label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" name="style_must_be_object" value="1" {if contract_detail.form.style_must_be_object}checked{/if}> Style Must Be Object</label>
                            <label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" name="children_must_be_array" value="1" {if contract_detail.form.children_must_be_array}checked{/if}> Children Must Be Array</label>
                            <label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" name="meta_must_be_object" value="1" {if contract_detail.form.meta_must_be_object}checked{/if}> Meta Must Be Object</label>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Extra Node Contract JSON</label>
                            <textarea name="node_contract_extra_json" rows="4" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900">{contract_detail.form.node_contract_extra_json}</textarea>
                        </div>
                    </div>

                    <div class="rounded-xl border border-gray-200 p-4 space-y-4 bg-gray-50/40 xl:col-span-2">
                        <h2 class="text-base font-semibold text-gray-900">CMS Compatibility</h2>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-medium text-gray-600 mb-1">CMS Builder Schema Version</label>
                                <input type="text" name="cms_builder_schema_version" value="{contract_detail.form.cms_builder_schema_version}" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-600 mb-1">Normalizer Function</label>
                                <input type="text" name="normalizer" value="{contract_detail.form.normalizer}" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-600 mb-1">Default Document Factory</label>
                                <input type="text" name="default_document_factory" value="{contract_detail.form.default_document_factory}" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-600 mb-1">Extra Compatibility JSON</label>
                            <textarea name="compatibility_extra_json" rows="4" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono text-gray-900">{contract_detail.form.compatibility_extra_json}</textarea>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Extra Top-Level Schema JSON</label>
                    <textarea name="extra_schema_json" rows="4" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">{contract_detail.form.extra_schema_json}</textarea>
                    <p class="text-xs text-gray-400 mt-2">Use this only for valid top-level page schema keys beyond the structured fields above.</p>
                </div>

                <div class="flex items-center justify-end gap-3">
                    <a href="/admin/theme-studio/contracts" class="px-4 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</a>
                    <button type="submit" class="px-4 py-2 text-sm font-medium bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">Save Structured Contract</button>
                </div>
            </form>

            <div class="mt-8 pt-6 border-t border-gray-200">
                <div class="mb-4">
                    <h2 class="text-base font-semibold text-gray-900">Advanced JSON</h2>
                    <p class="text-sm text-gray-500">Use advanced JSON only when the structured page-composition schema editor does not yet cover a legitimate ARK document contract key.</p>
                </div>
                <form method="POST" action="/admin/theme-studio/contracts/{contract_detail.key}/save" class="space-y-4">
                    <input type="hidden" name="editor_mode" value="advanced">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Contract JSON</label>
                        <textarea name="contract_json" rows="20" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">{contract_detail.json}</textarea>
                    </div>
                    <div class="flex items-center justify-end">
                        <button type="submit" class="px-4 py-2 text-sm font-medium border border-gray-300 rounded-lg hover:bg-gray-50">Save Advanced JSON</button>
                    </div>
                </form>
            </div>
            {else if contract_detail.key == 'safety-policy'}
            <form method="POST" action="/admin/theme-studio/contracts/{contract_detail.key}/save" class="space-y-6">
                <input type="hidden" name="editor_mode" value="structured">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Version</label>
                        <input type="text" name="version" value="{contract_detail.form.version}" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500" required>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Allowed Raw Keys</label>
                        <textarea name="allowed_raw_keys_text" rows="8" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">{contract_detail.form.allowed_raw_keys_text}</textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Required Capabilities</label>
                        <textarea name="requires_capability_text" rows="8" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">{contract_detail.form.requires_capability_text}</textarea>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Raw Output Note</label>
                    <textarea name="raw_output_note" rows="3" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">{contract_detail.form.raw_output_note}</textarea>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Allowed Context Sources</label>
                        <textarea name="allowed_context_sources_text" rows="6" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">{contract_detail.form.allowed_context_sources_text}</textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Blocked Patterns</label>
                        <textarea name="blocked_patterns_text" rows="6" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">{contract_detail.form.blocked_patterns_text}</textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Allowed JS Bridges</label>
                        <textarea name="allowed_js_bridges_text" rows="6" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">{contract_detail.form.allowed_js_bridges_text}</textarea>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">CSP Note</label>
                    <textarea name="csp_note" rows="3" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">{contract_detail.form.csp_note}</textarea>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Extra Policy JSON</label>
                    <textarea name="extra_policy_json" rows="6" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">{contract_detail.form.extra_policy_json}</textarea>
                    <p class="text-xs text-gray-400 mt-2">Use this only for valid policy keys beyond the structured fields above.</p>
                </div>

                <div class="flex items-center justify-end gap-3">
                    <a href="/admin/theme-studio/contracts" class="px-4 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</a>
                    <button type="submit" class="px-4 py-2 text-sm font-medium bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">Save Structured Contract</button>
                </div>
            </form>

            <div class="mt-8 pt-6 border-t border-gray-200">
                <div class="mb-4">
                    <h2 class="text-base font-semibold text-gray-900">Advanced JSON</h2>
                    <p class="text-sm text-gray-500">Use advanced JSON only when the structured safety-policy editor does not yet cover a legitimate ARK policy key.</p>
                </div>
                <form method="POST" action="/admin/theme-studio/contracts/{contract_detail.key}/save" class="space-y-4">
                    <input type="hidden" name="editor_mode" value="advanced">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Contract JSON</label>
                        <textarea name="contract_json" rows="20" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">{contract_detail.json}</textarea>
                    </div>
                    <div class="flex items-center justify-end">
                        <button type="submit" class="px-4 py-2 text-sm font-medium border border-gray-300 rounded-lg hover:bg-gray-50">Save Advanced JSON</button>
                    </div>
                </form>
            </div>
            {else}
            <form method="POST" action="/admin/theme-studio/contracts/{contract_detail.key}/save" class="space-y-4">
                <input type="hidden" name="editor_mode" value="advanced">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Contract JSON</label>
                    <textarea name="contract_json" rows="28" class="w-full rounded-xl border border-gray-300 px-4 py-3 text-sm font-mono text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500">{contract_detail.json}</textarea>
                </div>

                <div class="flex items-center justify-end gap-3">
                    <a href="/admin/theme-studio/contracts" class="px-4 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</a>
                    <button type="submit" class="px-4 py-2 text-sm font-medium bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">Save Contract</button>
                </div>
            </form>
            {/if}
        </div>

        <div class="space-y-4">
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                <h2 class="text-base font-semibold text-gray-900 mb-3">Status</h2>
                <div class="space-y-3 text-sm">
                    <div class="flex items-center justify-between gap-4">
                        <span class="text-gray-500">Allowlist</span>
                        <span class="px-2 py-1 rounded-full bg-green-100 text-green-700 text-xs font-medium">Editable</span>
                    </div>
                    <div class="flex items-center justify-between gap-4">
                        <span class="text-gray-500">File Status</span>
                        <span class="px-2 py-1 rounded-full {if contract_detail.exists}bg-green-100 text-green-700{else}bg-amber-100 text-amber-700{/if} text-xs font-medium">{if contract_detail.exists}Existing File{else}New File{/if}</span>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                <h2 class="text-base font-semibold text-gray-900 mb-3">Resolved Path</h2>
                <div class="text-xs font-mono text-gray-600 break-all">{contract_detail.path|default:'Unavailable'}</div>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                <h2 class="text-base font-semibold text-gray-900 mb-3">Purpose</h2>
                <p class="text-sm text-gray-600">{contract_detail.description}</p>
            </div>

            {if contract_detail.key == 'renderer-registry'}
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                <h2 class="text-base font-semibold text-gray-900 mb-3">Editor Policy</h2>
                <div class="text-sm text-gray-600 space-y-2">
                    <p>Structured save is the default path for renderer entries because ARK validation now enforces this contract directly.</p>
                    <p>Use advanced JSON only for properties that Theme Studio has not exposed yet and that should later become part of the structured contract.</p>
                </div>
            </div>
            {else if contract_detail.key == 'block-registry'}
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                <h2 class="text-base font-semibold text-gray-900 mb-3">Editor Policy</h2>
                <div class="text-sm text-gray-600 space-y-2">
                    <p>Structured save is the default path for ARK block categories so builder-visible block lanes stay explicit and governed.</p>
                    <p>Use advanced JSON only for top-level registry keys that still need first-class structured coverage later.</p>
                </div>
            </div>
            {else if contract_detail.key == 'entity-view-map'}
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                <h2 class="text-base font-semibold text-gray-900 mb-3">Editor Policy</h2>
                <div class="text-sm text-gray-600 space-y-2">
                    <p>Structured save is the default path for ARK capability-bridge rows so entity presentation contracts stay legible and governed.</p>
                    <p>Use advanced JSON only for bridge properties that still need first-class structured coverage later.</p>
                </div>
            </div>
            {else if contract_detail.key == 'page-composition-schema'}
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                <h2 class="text-base font-semibold text-gray-900 mb-3">Editor Policy</h2>
                <div class="text-sm text-gray-600 space-y-2">
                    <p>Structured save is the default path for the ARK builder document contract so future page builders stay anchored to the live CMS document envelope.</p>
                    <p>Use advanced JSON only for schema sections that still need first-class structured coverage later.</p>
                </div>
            </div>
            {else if contract_detail.key == 'safety-policy'}
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                <h2 class="text-base font-semibold text-gray-900 mb-3">Editor Policy</h2>
                <div class="text-sm text-gray-600 space-y-2">
                    <p>Structured save is the default path for the actively enforced ARK safety policy.</p>
                    <p>Use advanced JSON only for policy keys that still need first-class structured coverage later.</p>
                </div>
            </div>
            {/if}
        </div>
    </div>
    {/if}
</div>

<script>
function contractEditor() {
    return {
        renderers: [],
        blockCategories: [],
        entityViews: [],
        init() {
            const source = document.getElementById('renderer-rows-json');
            if (source) {
                try {
                    const parsed = JSON.parse(source.textContent || '[]');
                    this.renderers = Array.isArray(parsed) && parsed.length ? parsed : [this.emptyRenderer()];
                } catch (error) {
                    this.renderers = [this.emptyRenderer()];
                }
            }

            const blockRegistrySource = document.getElementById('block-registry-rows-json');
            if (blockRegistrySource) {
                try {
                    const parsed = JSON.parse(blockRegistrySource.textContent || '[]');
                    this.blockCategories = Array.isArray(parsed) && parsed.length ? parsed : [this.emptyBlockCategory()];
                } catch (error) {
                    this.blockCategories = [this.emptyBlockCategory()];
                }
            }

            const entitySource = document.getElementById('entity-view-rows-json');
            if (entitySource) {
                try {
                    const parsed = JSON.parse(entitySource.textContent || '[]');
                    this.entityViews = Array.isArray(parsed) && parsed.length ? parsed : [this.emptyEntityView()];
                } catch (error) {
                    this.entityViews = [this.emptyEntityView()];
                }
            }
        },
        emptyRenderer() {
            return {
                name: '',
                template: '',
                renders_as_component: '',
                controls_text: '',
                context_keys_text: '',
                extra_json: '{}'
            };
        },
        addRenderer() {
            this.renderers.push(this.emptyRenderer());
        },
        removeRenderer(index) {
            this.renderers.splice(index, 1);
            if (!this.renderers.length) {
                this.renderers.push(this.emptyRenderer());
            }
        },
        emptyBlockCategory() {
            return {
                category_name: '',
                block_types_text: ''
            };
        },
        addBlockCategory() {
            this.blockCategories.push(this.emptyBlockCategory());
        },
        removeBlockCategory(index) {
            this.blockCategories.splice(index, 1);
            if (!this.blockCategories.length) {
                this.blockCategories.push(this.emptyBlockCategory());
            }
        },
        emptyEntityView() {
            return {
                entity_type: '',
                view_name: '',
                fields_text: '',
                actions_text: '',
                block: '',
                extra_json: '{}'
            };
        },
        addEntityView() {
            this.entityViews.push(this.emptyEntityView());
        },
        removeEntityView(index) {
            this.entityViews.splice(index, 1);
            if (!this.entityViews.length) {
                this.entityViews.push(this.emptyEntityView());
            }
        }
    };
}
</script>
{/block}