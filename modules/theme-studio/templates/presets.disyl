{# Theme Studio — Presets
   Manage theme presets: save, apply, import, export. #}

{extends "modules/cms/layouts/admin.disyl"}

{block content}
<div class="p-6">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold">Theme Presets</h1>
            <p class="text-gray-500">Save, apply, import, and export theme configuration presets.</p>
        </div>
        <button type="button" onclick="document.getElementById('importModal').classList.remove('hidden')" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium">
            + Import Preset
        </button>
    </div>

    {if active_preset}
    <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-4 mb-6 flex items-center justify-between">
        <div>
            <span class="text-sm font-medium text-indigo-800">Active Preset:</span>
            <span class="text-sm text-indigo-600 ml-2">{active_preset}</span>
        </div>
        <form method="POST" action="/api/v1/theme-studio/presets/apply" style="display:inline;">
            <input type="hidden" name="slug" value="">
            <button type="submit" class="text-sm text-indigo-600 hover:text-indigo-800 font-medium">Clear</button>
        </form>
    </div>
    {/if}

    {# Preset grid #}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {for slug, preset in presets}
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 {if slug == active_preset}ring-2 ring-indigo-500{/if}">
            <div class="flex items-start justify-between mb-3">
                <div>
                    <h3 class="font-semibold text-gray-900">{preset.label}</h3>
                    <span class="text-xs text-gray-400">{preset.source|default:'custom'}</span>
                </div>
                {if slug == active_preset}
                <span class="px-2 py-0.5 text-xs font-medium bg-indigo-100 text-indigo-700 rounded-full">Active</span>
                {/if}
            </div>
            {if preset.description}
            <p class="text-sm text-gray-500 mb-4">{preset.description}</p>
            {/if}
            <div class="flex gap-2">
                {if slug != active_preset}
                <form method="POST" action="/api/v1/theme-studio/presets/apply" style="display:inline;">
                    <input type="hidden" name="slug" value="{slug}">
                    <button type="submit" class="px-3 py-1.5 text-sm bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">Apply</button>
                </form>
                {/if}
                <form method="POST" action="/api/v1/theme-studio/presets/export" style="display:inline;">
                    <input type="hidden" name="slug" value="{slug}">
                    <button type="submit" class="px-3 py-1.5 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">Export</button>
                </form>
                {if preset.source == 'custom' or preset.source == 'imported'}
                <form method="POST" action="/api/v1/theme-studio/presets/delete" style="display:inline;" onsubmit="return confirm('Delete this preset?')">
                    <input type="hidden" name="slug" value="{slug}">
                    <button type="submit" class="px-3 py-1.5 text-sm text-red-600 border border-red-200 rounded-lg hover:bg-red-50">Delete</button>
                </form>
                {/if}
            </div>
        </div>
        {/for}
    </div>

    {# Save current as preset #}
    <div class="mt-8 bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-lg font-semibold mb-3">Save Current Configuration as Preset</h2>
        <form method="POST" action="/api/v1/theme-studio/presets/save" class="flex flex-wrap gap-3 items-end">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Slug</label>
                <input type="text" name="slug" required class="px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="my-preset">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Label</label>
                <input type="text" name="label" required class="px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="My Preset">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                <input type="text" name="description" class="px-3 py-2 border border-gray-300 rounded-lg text-sm" placeholder="Optional description">
            </div>
            <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium">Save Preset</button>
        </form>
    </div>
</div>

{# Import Modal #}
<div id="importModal" class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-50" onclick="if(event.target===this)this.classList.add('hidden')">
    <div class="bg-white rounded-xl shadow-xl p-6 max-w-md w-full mx-4" onclick="event.stopPropagation()">
        <h2 class="text-lg font-semibold mb-3">Import Preset</h2>
        <p class="text-sm text-gray-500 mb-4">Paste a preset JSON exported from another Ikabud installation.</p>
        <form method="POST" action="/api/v1/theme-studio/presets/import" enctype="text/plain">
            <textarea name="payload" rows="8" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono mb-4" placeholder='{"preset":{"slug":"...","label":"...","data":{...}}}'></textarea>
            <div class="flex gap-2 justify-end">
                <button type="button" onclick="document.getElementById('importModal').classList.add('hidden')" class="px-3 py-1.5 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</button>
                <button type="submit" class="px-3 py-1.5 text-sm bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">Import</button>
            </div>
        </form>
    </div>
</div>
{/block}
