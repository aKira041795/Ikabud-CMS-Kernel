{# Theme Studio — Theme Elements
   Create and manage governed slot content contributions.
   Each element can inject a component into a theme slot with display conditions. #}

{extends "modules/cms/layouts/admin.disyl"}

{block content}
<div class="p-6" x-data="elementManager()">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold">Theme Elements</h1>
            <p class="text-gray-500">Inject governed components into ARK-declared theme slots with validated component and display-condition JSON.</p>
        </div>
        <button @click="openNew()" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium">
            + New Element
        </button>
    </div>

    {# Elements table #}
    {if elements|length}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-gray-100 bg-gray-50">
                    <th class="text-left px-4 py-3 font-medium text-gray-600">Label</th>
                    <th class="text-left px-4 py-3 font-medium text-gray-600">Type</th>
                    <th class="text-left px-4 py-3 font-medium text-gray-600">Slot</th>
                    <th class="text-left px-4 py-3 font-medium text-gray-600">Component</th>
                    <th class="text-center px-4 py-3 font-medium text-gray-600">Priority</th>
                    <th class="text-center px-4 py-3 font-medium text-gray-600">Active</th>
                    <th class="text-right px-4 py-3 font-medium text-gray-600">Actions</th>
                </tr>
            </thead>
            <tbody>
                {for el in elements}
                <tr class="border-b border-gray-50 hover:bg-gray-50/50">
                    <td class="px-4 py-3 font-medium text-gray-900">{el.label}</td>
                    <td class="px-4 py-3">
                        <span class="px-2 py-0.5 rounded-full text-xs font-medium
                            {if el.element_type == 'hook'}bg-blue-100 text-blue-700
                            {else if el.element_type == 'hero'}bg-purple-100 text-purple-700
                            {else if el.element_type == 'header'}bg-green-100 text-green-700
                            {else if el.element_type == 'block'}bg-yellow-100 text-yellow-700
                            {else if el.element_type == 'token_override'}bg-gray-100 text-gray-700
                            {:else}bg-gray-100 text-gray-600{/if}">
                            {el.element_type}
                        </span>
                    </td>
                    <td class="px-4 py-3 text-gray-600 font-mono text-xs">{el.slot_name|default:'—'}</td>
                    <td class="px-4 py-3 text-gray-600 font-mono text-xs">{el.component|default:'ikb_panel'}</td>
                    <td class="px-4 py-3 text-center text-gray-600">{el.priority}</td>
                    <td class="px-4 py-3 text-center">
                        {if el.is_active}
                        <span class="text-green-600 text-lg">✓</span>
                        {:else}
                        <span class="text-gray-300 text-lg">—</span>
                        {/if}
                    </td>
                    <td class="px-4 py-3 text-right">
                        <button @click="editElement({el.id|default:0})" class="text-indigo-600 hover:text-indigo-800 text-sm mr-2">Edit</button>
                        <form method="POST" action="/api/v1/theme-studio/elements/delete" style="display:inline;" onsubmit="return confirm('Delete this element?')">
                            <input type="hidden" name="slug" value="{el.slug}">
                            <button type="submit" class="text-red-600 hover:text-red-800 text-sm">Delete</button>
                        </form>
                    </td>
                </tr>
                {/for}
            </tbody>
        </table>
    </div>
    {:else}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-12 text-center">
        <div class="text-3xl mb-3">🧩</div>
        <p class="text-gray-500 mb-1">No Theme Elements yet.</p>
        <p class="text-sm text-gray-400">Create your first element to inject content into a theme slot.</p>
    </div>
    {/if}

    {# New/Edit Form Modal #}
    <div x-show="showForm" class="fixed inset-0 bg-black/40 flex items-start justify-center z-50 pt-12 overflow-y-auto" @click.self="showForm=false">
        <div class="bg-white rounded-xl shadow-xl p-6 max-w-lg w-full mx-4 mb-12">
            <h2 class="text-lg font-semibold mb-4" x-text="editingId ? 'Edit Element' : 'New Element'"></h2>

            <form method="POST" action="/api/v1/theme-studio/elements/save" class="space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Slug *</label>
                        <input type="text" name="slug" x-model="form.slug" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Label *</label>
                        <input type="text" name="label" x-model="form.label" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Element Type</label>
                        <select name="element_type" x-model="form.element_type" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                            <option value="hook">Hook — governed slot content</option>
                            <option value="hero">Hero — page/entity hero</option>
                            <option value="header">Header — alternate header</option>
                            <option value="block">Block — reusable DiSyL composition</option>
                            <option value="token_override">Token Override — conditional token changes</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Target Slot</label>
                        <select name="slot_name" x-model="form.slot_name" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono">
                            <option value="">Select a governed slot</option>
                            {foreach slot_items as slotName => slotDef}
                            <option value="{slotName}">{slotName} — {slotDef.label|default:'Slot'}</option>
                            {/foreach}
                        </select>
                        <p class="text-xs text-gray-400 mt-1">Only ARK-declared slots are listed here.</p>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Governed Component</label>
                        <select name="component" x-model="form.component" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                            {foreach governed_components as component}
                            <option value="{component.name}">{component.name} — {component.category|default:'ui'}</option>
                            {/foreach}
                        </select>
                        <p class="text-xs text-gray-400 mt-1">Available governed components come directly from the DiSyL ComponentRegistry.</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Priority</label>
                        <input type="number" name="priority" x-model="form.priority" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" min="0" max="100">
                    </div>
                </div>

                <div>
                    <label class="flex items-center gap-2">
                        <input type="checkbox" name="is_active" x-model="form.is_active" class="rounded border-gray-300">
                        <span class="text-sm font-medium text-gray-700">Active</span>
                    </label>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Component Attributes (JSON)</label>
                    <textarea name="component_attrs" x-model="form.component_attrs" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" placeholder='{"tone":"muted","spacing":"lg"}'></textarea>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Display Conditions (JSON)</label>
                    <textarea name="display_conditions" x-model="form.display_conditions" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono" placeholder='{"entity_type":"cms.post","view":"detail"}'></textarea>
                    <p class="text-xs text-gray-400 mt-1">Supported keys: entity_type, view, route, role, capability, tenant</p>
                </div>

                <div class="flex gap-2 justify-end pt-2">
                    <button type="button" @click="showForm=false" class="px-3 py-1.5 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium">Save Element</button>
                </div>
            </form>
        </div>
    </div>

    <script>
    function elementManager() {
        return {
            showForm: false,
            editingId: null,
            form: {
                slug: '', label: '', element_type: 'hook', slot_name: '',
                component: 'ikb_panel', component_attrs: '',
                display_conditions: '', priority: 10, is_active: true
            },
            openNew() {
                this.editingId = null;
                this.form = { slug: '', label: '', element_type: 'hook', slot_name: '',
                    component: 'ikb_panel', component_attrs: '',
                    display_conditions: '', priority: 10, is_active: true };
                this.showForm = true;
            },
            editElement(id) {
                // Find element by id and populate form
                {for el in elements}
                if ({el.id|default:0} == id) {
                    this.editingId = id;
                    this.form = {
                        slug: '{el.slug}',
                        label: '{el.label}',
                        element_type: '{el.element_type}',
                        slot_name: '{el.slot_name|default:""}',
                        component: '{el.component|default:"ikb_panel"}',
                        component_attrs: '{el.component_attrs|default:""}',
                        display_conditions: '{el.display_conditions|default:""}',
                        priority: {el.priority|default:10},
                        is_active: {if el.is_active}true{else}false{/if}
                    };
                    this.showForm = true;
                }
                {/for}
            }
        };
    }
    </script>
</div>
{/block}
