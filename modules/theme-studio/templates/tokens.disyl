{# Theme Studio — Design Token Editor
   Visual editor for theme design tokens: colors, typography, spacing, radius, shadows. #}

{extends "modules/cms/layouts/admin.disyl"}

{block content}
<div class="p-6" x-data="tokenEditor()">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold">Design Tokens</h1>
            <p class="text-gray-500">
                {if active_theme}
                Editing tokens for <strong>{theme_manifest.label|default:active_theme}</strong>
                {else}
                No active theme selected
                {/if}
            </p>
        </div>
        <div class="flex gap-2">
            <button @click="resetTokens()" class="px-3 py-1.5 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">Reset</button>
            <button @click="saveTokens()" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium">Save Tokens</button>
        </div>
    </div>

    {if !active_theme}
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 text-sm text-yellow-800">
        No active theme is configured. Tokens cannot be edited without an active theme.
    </div>
    {/if}

    <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-4 mb-6 text-sm text-indigo-900">
        <div class="font-medium mb-1">ARK-aware token editing</div>
        <div>This editor is driven from the active theme's declared token file. Default values come from ARK, preset values come from the active Theme Studio preset, and your tenant overrides are edited here.</div>
    </div>

    <div class="space-y-6">
        {foreach token_group_rows as group}
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <div class="flex items-center justify-between mb-4 gap-4 flex-wrap">
                <h2 class="text-lg font-semibold">{group.label}</h2>
                <div class="text-xs text-gray-400">{group.items|length} token(s)</div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                {foreach group.items as item}
                <div class="rounded-lg border border-gray-200 p-4">
                    <label class="block text-sm font-medium text-gray-700 mb-2">{item.key}</label>
                    <div class="space-y-2">
                        {if item.is_color}
                        <div class="flex gap-2 items-center">
                            <input type="color" x-model="tokens['{item.key}']" class="w-10 h-10 rounded border border-gray-300 cursor-pointer">
                            <input type="text" x-model="tokens['{item.key}']" class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono">
                        </div>
                        {else}
                        <input type="text" x-model="tokens['{item.key}']" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono">
                        {/if}
                        <div class="text-xs text-gray-500 space-y-1">
                            <div>Default: <span class="font-mono text-gray-700">{item.default_value}</span></div>
                            {if item.preset_value}<div>Preset: <span class="font-mono text-indigo-700">{item.preset_value}</span></div>{/if}
                            {if item.override_value}<div>Override: <span class="font-mono text-emerald-700">{item.override_value}</span></div>{/if}
                        </div>
                    </div>
                </div>
                {/foreach}
            </div>
        </div>
        {/foreach}
    </div>

    {# Alpine.js state management #}
    <script>
    function tokenEditor() {
        return {
            tokens: {token_overrides_json|default:'{}'|raw},
            customKey: '',
            customVal: '#000000',
            addCustomToken() {
                if (this.customKey) {
                    this.tokens[this.customKey] = this.customVal;
                    this.customKey = '';
                    this.customVal = '#000000';
                }
            },
            saveTokens() {
                fetch('/api/v1/theme-studio/tokens/save', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        tokens: this.tokens,
                        theme_slug: '{active_theme}'
                    })
                }).then(r => r.json()).then(d => {
                    if (d.ok) { alert('Tokens saved!'); }
                    else { alert('Save failed: ' + (d.error || 'unknown')); }
                }).catch(e => alert('Error: ' + e.message));
            },
            resetTokens() {
                if (!confirm('Reset all token overrides to theme defaults?')) return;
                fetch('/api/v1/theme-studio/tokens/reset', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ theme_slug: '{active_theme}' })
                }).then(r => r.json()).then(d => {
                    if (d.ok) { this.tokens = {}; alert('Tokens reset!'); }
                    else { alert('Reset failed'); }
                });
            }
        };
    }
    </script>
</div>
{/block}
