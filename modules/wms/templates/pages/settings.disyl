<div class="p-6">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">⚙️ Settings</h1>

    <div class="bg-white rounded shadow max-w-2xl">
        <div class="p-4 border-b">
            <h2 class="text-sm font-semibold text-gray-700">Warehouse Configuration</h2>
        </div>
        <div class="p-4 space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-sm font-medium text-gray-700">Default Warehouse Name</div>
                    <div class="text-xs text-gray-400">Configured during onboarding</div>
                </div>
                <div class="text-sm text-gray-600">{settings.warehouse_name ?? 'Main Warehouse'}</div>
            </div>
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-sm font-medium text-gray-700">Picking Strategy</div>
                    <div class="text-xs text-gray-400">Controls pick-list generation order</div>
                </div>
                <div class="text-sm text-gray-600">{settings.picking_strategy ?? 'fifo'}</div>
            </div>
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-sm font-medium text-gray-700">Allow Negative Stock</div>
                    <div class="text-xs text-gray-400">When disabled, blocks under-picking</div>
                </div>
                <div class="text-sm text-gray-600">{settings.allow_negative_stock ?? '0' === '1' ? 'Yes' : 'No'}</div>
            </div>
        </div>
        {if count(settings) === 0}
        <div class="p-8 text-center text-gray-400 text-sm">No settings configured yet.</div>
        {/if}
    </div>
</div>
