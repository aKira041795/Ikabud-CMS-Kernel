<div class="p-6">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">📊 Dashboard</h1>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded shadow p-4 border-l-4 border-blue-500">
            <div class="text-2xl font-bold text-gray-800">{total_products}</div>
            <div class="text-xs text-gray-500 mt-1">Active Products</div>
        </div>
        <div class="bg-white rounded shadow p-4 border-l-4 border-green-500">
            <div class="text-2xl font-bold text-gray-800">{total_stock_qty|number_format:0}</div>
            <div class="text-xs text-gray-500 mt-1">Total Stock (units)</div>
            <div class="text-xs text-gray-400">{total_stock_items} SKU-locations</div>
        </div>
        <div class="bg-white rounded shadow p-4 border-l-4 border-amber-500">
            <div class="text-2xl font-bold text-amber-600">{low_stock_count}</div>
            <div class="text-xs text-gray-500 mt-1">Low Stock Items</div>
        </div>
        <div class="bg-white rounded shadow p-4 border-l-4 border-purple-500">
            <div class="text-2xl font-bold text-gray-800">{pending_orders}</div>
            <div class="text-xs text-gray-500 mt-1">Pending Orders</div>
        </div>
        <div class="bg-white rounded shadow p-4 border-l-4 border-indigo-500">
            <div class="text-2xl font-bold text-gray-800">{pending_deliveries}</div>
            <div class="text-xs text-gray-500 mt-1">Pending Deliveries</div>
        </div>
        <div class="bg-white rounded shadow p-4 border-l-4 border-teal-500">
            <div class="text-2xl font-bold text-gray-800">{open_tasks}</div>
            <div class="text-xs text-gray-500 mt-1">Open Tasks</div>
        </div>
    </div>

    <div class="bg-white rounded shadow">
        <div class="px-4 py-3 border-b font-semibold text-sm text-gray-700">Recent Movements</div>
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left">
                    <th class="px-4 py-2 font-medium text-gray-600">Product</th>
                    <th class="px-4 py-2 font-medium text-gray-600">Type</th>
                    <th class="px-4 py-2 font-medium text-gray-600">Qty</th>
                    <th class="px-4 py-2 font-medium text-gray-600">Prev</th>
                    <th class="px-4 py-2 font-medium text-gray-600">New</th>
                    <th class="px-4 py-2 font-medium text-gray-600">Date</th>
                </tr>
            </thead>
            <tbody>
                {each recent_movements as m}
                <tr class="border-t hover:bg-gray-50">
                    <td class="px-4 py-2">{m.product_name}</td>
                    <td class="px-4 py-2"><span class="text-xs px-1.5 py-0.5 rounded {m.movement_type === 'receipt' ? 'bg-green-100 text-green-700' : (m.movement_type === 'transfer' ? 'bg-blue-100 text-blue-700' : (m.movement_type === 'sale' ? 'bg-red-100 text-red-700' : 'bg-gray-100'))}">{m.movement_type}</span></td>
                    <td class="px-4 py-2">{m.quantity|number_format:2}</td>
                    <td class="px-4 py-2 text-gray-500">{m.prev_qty_on_hand|number_format:2}</td>
                    <td class="px-4 py-2">{m.new_qty_on_hand|number_format:2}</td>
                    <td class="px-4 py-2 text-xs text-gray-400">{m.created_at}</td>
                </tr>
                {/each}
                {if count(recent_movements) === 0}
                <tr><td colspan="6" class="px-4 py-6 text-center text-gray-400">No movements yet.</td></tr>
                {/if}
            </tbody>
        </table>
    </div>
</div>
