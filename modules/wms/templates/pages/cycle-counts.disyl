<div class="p-6" x-data="cycleCountsPage()">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Cycle Counts</h1>
        <button @@click="showCreate = true" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm">+ New Count</button>
    </div>

    <div class="bg-white rounded shadow mb-6">
        <div class="p-4 border-b flex gap-4 items-center">
            <select onchange="if(this.value) {const p=new URLSearchParams(location.search); p.set('status',this.value); location.search=p.toString();} else {const p=new URLSearchParams(location.search); p.delete('status'); location.search=p.toString();}" class="border rounded px-3 py-2 text-sm">
                <option value="">All</option>
                <option value="open" {eq($_GET['status'] ?? '', 'open') ? 'selected' : ''}>Open</option>
                <option value="in_progress" {eq($_GET['status'] ?? '', 'in_progress') ? 'selected' : ''}>In Progress</option>
                <option value="completed" {eq($_GET['status'] ?? '', 'completed') ? 'selected' : ''}>Completed</option>
            </select>
        </div>
    </div>

    <div class="bg-white rounded shadow overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left">
                    <th class="px-4 py-3 font-medium text-gray-600">Count #</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Type</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Warehouse</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Status</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Assigned To</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Scheduled</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Completed</th>
                        <th class="px-4 py-3 font-medium text-gray-600 text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {each cycle_counts as cc}
                <tr class="border-t hover:bg-gray-50">
                    <td class="px-4 py-3 font-medium">{cc.count_number}</td>
                    <td class="px-4 py-3 text-xs">{cc.count_type}</td>
                    <td class="px-4 py-3">{cc.warehouse_code}</td>
                    <td class="px-4 py-3">
                        <span class="inline-block px-2 py-0.5 rounded text-xs font-medium"
                              class="inline-block px-2 py-0.5 rounded text-xs font-medium {cc.status == 'open' ? 'bg-yellow-100 text-yellow-700' : cc.status == 'in_progress' ? 'bg-blue-100 text-blue-700' : cc.status == 'completed' ? 'bg-green-100 text-green-700' : ''}">{cc.status}</span>
                    </td>
                    <td class="px-4 py-3 text-sm">{cc.assigned_name ?? '—'}</td>
                    <td class="px-4 py-3 text-sm">{cc.scheduled_at ?? '—'}</td>
                    <td class="px-4 py-3 text-xs text-gray-400">{cc.completed_at ?? '—'}</td>
                        <td class="px-4 py-3 text-center text-xs">
                            <button onclick="location.href='/wms/cycle-counts'" class="text-blue-600 hover:text-blue-800 mr-2">View</button>
                            <button onclick="completeCount({cc.id})" class="text-green-600 hover:text-green-800">Complete</button>
                        </td>
                </tr>
                {/each}
                {if count(cycle_counts) === 0}
                <tr><td colspan="9" class="px-4 py-8 text-center text-gray-400">No cycle counts found.</td></tr>
                {/if}
            </tbody>
        </table>
    </div>

    <div x-show="showCreate" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" style="display:none">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4 p-6" @@click.outside="showCreate=false">
            <h2 class="text-lg font-bold mb-4">New Cycle Count</h2>
            <form @@submit.prevent="submitCount()" class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Warehouse *</label>
                    <select x-model="form.warehouse_id" required class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Select...</option>
                        {each warehouses as w}
                            <option value="{w.id}">{w.code} — {w.name}</option>
                        {/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Type</label>
                    <select x-model="form.count_type" class="border rounded px-3 py-2 w-full text-sm">
                        <option value="full">Full</option>
                        <option value="partial">Partial</option>
                        <option value="ad_hoc">Ad Hoc</option>
                        <option value="abc_a">ABC A</option>
                        <option value="abc_b">ABC B</option>
                        <option value="abc_c">ABC C</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Assigned To</label>
                    <select x-model="form.assigned_to" class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Unassigned</option>
                        {each users as u}
                            <option value="{u.id}">{u.full_name}</option>
                        {/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Notes</label>
                    <textarea x-model="form.notes" class="border rounded px-3 py-2 w-full text-sm" rows="2"></textarea>
                </div>
                <div class="flex gap-2 justify-end pt-2">
                    <button type="button" @@click="showCreate=false" class="px-4 py-2 text-gray-600 border rounded text-sm">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded text-sm">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function cycleCountsPage() {
    return {
        showCreate: false,
        form: { warehouse_id: '', count_type: 'full', assigned_to: '', notes: '' },
        async submitCount() {
            const res = await fetch('/api/v1/wms/cycle-counts', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(this.form)});
            const data = await res.json();
            if (!data.ok) { alert('Error: ' + data.error); return; }
            location.reload();
        }
    }
}

function completeCount(id) { if(confirm('Complete this cycle count?')) { fetch('{base_url}/api/v1/wms/cycle-counts/'+id+'/complete', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({apply_adjustments:true})}).then(function(r){return r.json()}).then(function(res){if(res.ok)location.reload();else alert(res.error)}); } }

</script>
