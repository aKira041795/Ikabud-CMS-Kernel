<div class="p-6">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Movement History</h1>
        <select onchange="if(this.value) { const p=new URLSearchParams(location.search); p.set('type',this.value); location.search=p.toString(); } else { const p=new URLSearchParams(location.search); p.delete('type'); location.search=p.toString(); }"
                class="border rounded px-3 py-2 text-sm">
            <option value="">All Types</option>
            <option value="receipt" {eq($_GET['type'] ?? '', 'receipt') ? 'selected' : ''}>Receipts</option>
            <option value="transfer" {eq($_GET['type'] ?? '', 'transfer') ? 'selected' : ''}>Transfers</option>
            <option value="adjustment_up" {eq($_GET['type'] ?? '', 'adjustment_up') ? 'selected' : ''}>Adjustments (Up)</option>
            <option value="adjustment_down" {eq($_GET['type'] ?? '', 'adjustment_down') ? 'selected' : ''}>Adjustments (Down)</option>
            <option value="scrap" {eq($_GET['type'] ?? '', 'scrap') ? 'selected' : ''}>Scrap</option>
            <option value="sale" {eq($_GET['type'] ?? '', 'sale') ? 'selected' : ''}>Sales</option>
            <option value="return_in" {eq($_GET['type'] ?? '', 'return_in') ? 'selected' : ''}>Returns (In)</option>
            <option value="return_out" {eq($_GET['type'] ?? '', 'return_out') ? 'selected' : ''}>Returns (Out)</option>
        </select>
    </div>

    <div class="bg-white rounded shadow overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left">
                    <th class="px-4 py-3 font-medium text-gray-600">Date</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Product</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Type</th>
                    <th class="px-4 py-3 font-medium text-gray-600">From</th>
                    <th class="px-4 py-3 font-medium text-gray-600">To</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Batch</th>
                    <th class="px-4 py-3 font-medium text-gray-600 text-right">Qty</th>
                    <th class="px-4 py-3 font-medium text-gray-600 text-right">Prev</th>
                    <th class="px-4 py-3 font-medium text-gray-600 text-right">New</th>
                    <th class="px-4 py-3 font-medium text-gray-600">By</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Notes</th>
                </tr>
            </thead>
            <tbody>
                {@each movements as m}
                <tr class="border-t hover:bg-gray-50">
                    <td class="px-4 py-3 text-xs text-gray-500 whitespace-nowrap">{m.created_at}</td>
                    <td class="px-4 py-3">{m.product_name}<br><span class="text-xs text-gray-400">{m.sku}</span></td>
                    <td class="px-4 py-3">
                        <span class="inline-block px-2 py-0.5 rounded text-xs font-medium"
                              :class="{
                                  'bg-green-100 text-green-700': m.movement_type === 'receipt',
                                  'bg-blue-100 text-blue-700': m.movement_type === 'transfer',
                                  'bg-amber-100 text-amber-700': m.movement_type === 'adjustment_up',
                                  'bg-red-100 text-red-700': m.movement_type === 'adjustment_down' || m.movement_type === 'scrap',
                                  'bg-purple-100 text-purple-700': m.movement_type === 'sale',
                                  'bg-gray-100 text-gray-700': !['receipt','transfer','adjustment_up','adjustment_down','scrap','sale'].includes(m.movement_type)
                              }">{m.movement_type}</span>
                    </td>
                    <td class="px-4 py-3 text-xs text-gray-500">{m.from_location_code ?? '—'}</td>
                    <td class="px-4 py-3 text-xs text-gray-500">{m.to_location_code ?? '—'}</td>
                    <td class="px-4 py-3 text-xs text-gray-500">{m.batch_number ?? '—'}</td>
                    <td class="px-4 py-3 text-right font-medium" :class="m.quantity >= 0 ? 'text-green-600' : 'text-red-600'">{m.quantity|number_format:4}</td>
                    <td class="px-4 py-3 text-right text-gray-500">{m.prev_qty_on_hand|number_format:4}</td>
                    <td class="px-4 py-3 text-right text-gray-500">{m.new_qty_on_hand|number_format:4}</td>
                    <td class="px-4 py-3 text-xs text-gray-500">{m.created_by_name ?? '—'}</td>
                    <td class="px-4 py-3 text-xs text-gray-400 max-w-xs truncate">{m.notes ?? m.reason ?? ''}</td>
                </tr>
                {@/each}
                {@if count(movements) === 0}
                <tr><td colspan="11" class="px-4 py-8 text-center text-gray-400">No movements found.</td></tr>
                {@/if}
            </tbody>
        </table>
    </div>
</div>
