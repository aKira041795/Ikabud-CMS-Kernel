<div class="p-6" id="users-page">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">👥 Users</h1>
        <button onclick="document.getElementById('user-modal').classList.remove('hidden')" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm">+ Add User</button>
    </div>

    <div class="bg-white rounded shadow overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left">
                    <th class="px-4 py-3 font-medium text-gray-600">Username</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Name</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Email</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Role</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Status</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Created</th>
                        <th class="px-4 py-3 font-medium text-gray-600 text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {each users as u}
                <tr class="border-t hover:bg-gray-50">
                    <td class="px-4 py-3 font-medium">{u.username}</td>
                    <td class="px-4 py-3">{u.full_name}</td>
                    <td class="px-4 py-3 text-sm text-gray-500">{u.email ?? '—'}</td>
                    <td class="px-4 py-3">
                        <span class="inline-block px-2 py-0.5 rounded text-xs font-medium {u.role == 'admin' ? 'bg-purple-100 text-purple-700' : u.role == 'supervisor' ? 'bg-blue-100 text-blue-700' : u.role == 'viewer' ? 'bg-gray-100 text-gray-600' : ''}">{u.role}</span>
                    </td>
                    <td class="px-4 py-3">
                        <span class="inline-block px-2 py-0.5 rounded text-xs font-medium {u.is_active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}">{u.is_active ? 'Active' : 'Inactive'}</span>
                    </td>
                    <td class="px-4 py-3 text-xs text-gray-400">{u.created_at ?? '—'}</td>
                        <td class="px-4 py-3 text-center text-xs">
                            <button data-user-id="{u.id}" onclick="resetPassword(this)" class="text-blue-600 hover:text-blue-800 mr-2">Reset PW</button>
                            <button data-user-id="{u.id}" onclick="toggleUser(this)" class="text-amber-600 hover:text-amber-800">Toggle</button>
                        </td>
                </tr>
                {/each}
                {if count(users) === 0}
                <tr><td colspan="8" class="px-4 py-8 text-center text-gray-400">No users found.</td></tr>
                {/if}
            </tbody>
        </table>
    </div>

    <div id="user-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden" onclick="if(event.target===this)this.classList.add('hidden')">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-md mx-4 p-6">
            <h2 class="text-lg font-bold mb-4">Add User</h2>
            <form id="form-user" onsubmit="return submitUser(event)" class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Username *</label>
                    <input type="text" name="username" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Full Name *</label>
                    <input type="text" name="full_name" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Email</label>
                    <input type="email" name="email" class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Password *</label>
                    <input type="password" name="password" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Role</label>
                    <select name="role" class="border rounded px-3 py-2 w-full text-sm">
                        <option value="viewer">Viewer</option>
                        <option value="supervisor">Supervisor</option>
                        <option value="admin">Admin</option>
                    </select>
                </div>
                <div class="flex gap-2 justify-end pt-2">
                    <button type="button" onclick="document.getElementById('user-modal').classList.add('hidden')" class="px-4 py-2 text-gray-600 border rounded text-sm">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded text-sm">Add User</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
function submitUser(e) {
    e.preventDefault();
    var fd = new FormData(e.target);
    fetch('/api/v1/wms/auth/register', {method:'POST', body: fd})
        .then(function(r){ return r.json(); })
        .then(function(data) {
            if (!data.ok) { alert('Error: ' + data.error); return; }
            location.reload();
        });
    return false;
}
function resetPassword(btn) {
    var id = btn.getAttribute('data-user-id');
    var pw = prompt('New password:');
    if (pw && pw.length > 3) {
        fetch('{base_url}/api/v1/wms/auth/admin-reset-password', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({user_id:parseInt(id), password:pw})})
            .then(function(r){ return r.json(); })
            .then(function(res){ if(res.ok) alert('Password reset'); else alert(res.error); });
    }
}
function toggleUser(btn) {
    var id = btn.getAttribute('data-user-id');
    if (confirm('Toggle user active status?')) {
        fetch('{base_url}/api/v1/wms/users/' + id + '/toggle', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({user_id:parseInt(id)})})
            .then(function(r){ return r.json(); })
            .then(function(res){ if(res.ok) location.reload(); else alert(res.error); });
    }
}
</script>
