<div class="p-6" x-data="usersPage()">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">👥 Users</h1>
        <button @@click="showCreate = true" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm">+ Add User</button>
    </div>

    <div class="bg-white rounded shadow overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left">
                    <th class="px-4 py-3 font-medium text-gray-600">Username</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Name</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Email</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Role</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Status</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Created</th>
                </tr>
            </thead>
            <tbody>
                {each users as u}
                <tr class="border-t hover:bg-gray-50">
                    <td class="px-4 py-3 font-medium">{u.username}</td>
                    <td class="px-4 py-3">{u.full_name}</td>
                    <td class="px-4 py-3 text-sm text-gray-500">{u.email|default:'—'}</td>
                    <td class="px-4 py-3">
                        <span class="inline-block px-2 py-0.5 rounded text-xs font-medium"
                              :class="{'bg-purple-100 text-purple-700': u.role==='admin','bg-blue-100 text-blue-700': u.role==='supervisor','bg-gray-100 text-gray-600': u.role==='viewer'}">{u.role}</span>
                    </td>
                    <td class="px-4 py-3">
                        <span class="inline-block px-2 py-0.5 rounded text-xs font-medium"
                              :class="u.is_active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'">{u.is_active ? 'Active' : 'Inactive'}</span>
                    </td>
                    <td class="px-4 py-3 text-xs text-gray-400">{u.created_at|default:'—'}</td>
                </tr>
                {/each}
                {if count(users) === 0}
                <tr><td colspan="6" class="px-4 py-8 text-center text-gray-400">No users found.</td></tr>
                {/if}
            </tbody>
        </table>
    </div>

    <div x-show="showCreate" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" style="display:none">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-md mx-4 p-6" @@click.outside="showCreate=false">
            <h2 class="text-lg font-bold mb-4">Add User</h2>
            <form @@submit.prevent="submitUser()" class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Username *</label>
                    <input type="text" x-model="form.username" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Full Name *</label>
                    <input type="text" x-model="form.full_name" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Email</label>
                    <input type="email" x-model="form.email" class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Password *</label>
                    <input type="password" x-model="form.password" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Role</label>
                    <select x-model="form.role" class="border rounded px-3 py-2 w-full text-sm">
                        <option value="viewer">Viewer</option>
                        <option value="supervisor">Supervisor</option>
                        <option value="admin">Admin</option>
                    </select>
                </div>
                <div class="flex gap-2 justify-end pt-2">
                    <button type="button" @@click="showCreate=false" class="px-4 py-2 text-gray-600 border rounded text-sm">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded text-sm">Add User</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
function usersPage() {
    return {
        showCreate: false,
        form: { username: '', full_name: '', email: '', password: '', role: 'viewer' },
        async submitUser() {
            const res = await fetch('/api/v1/wms/auth/register', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(this.form)});
            const data = await res.json();
            if (!data.ok) { alert('Error: ' + data.error); return; }
            location.reload();
        }
    }
}
</script>
