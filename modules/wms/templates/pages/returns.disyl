<div class="p-6" id="returnsPage-page">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Returns</h1>
        <button onclick="document.getElementById('showCreate-modal').classList.remove('hidden')" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm">+ New Return</button>
    </div>

    <div class="bg-white rounded shadow overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left">
                    <th class="px-4 py-3 font-medium text-gray-600">Return #</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Type</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Customer</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Warehouse</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Status</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Disposition</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Date</th>
                        <th class="px-4 py-3 font-medium text-gray-600 text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {each returns as r}
                <tr class="border-t hover:bg-gray-50">
                    <td class="px-4 py-3 font-medium">{r.return_number}</td>
                    <td class="px-4 py-3 text-xs">{r.return_type}</td>
                    <td class="px-4 py-3">{r.customer_name ?? '—'}</td>
                    <td class="px-4 py-3">{r.warehouse_code}</td>
                    <td class="px-4 py-3">
                        <span class="inline-block px-2 py-0.5 rounded text-xs font-medium">{r.status}</span>
                    </td>
                    <td class="px-4 py-3 text-xs">{r.disposition ?? '—'}</td>
                    <td class="px-4 py-3 text-xs text-gray-400">{r.created_at}</td>
                        <td class="px-4 py-3 text-center text-xs">
                            <button onclick="processReturn({r.id},'approve')" class="text-green-600 hover:text-green-800 mr-2">Approve</button>
                            <button onclick="processReturn({r.id},'reject')" class="text-red-600 hover:text-red-800">Reject</button>
                        </td>
                </tr>
                {/each}
                {if count(returns) === 0}
                <tr><td colspan="9" class="px-4 py-8 text-center text-gray-400">No returns found.</td></tr>
                {/if}
            </tbody>
        </table>
    </div>

    <div id="showCreate-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden" onclick="if(event.target===this)this.classList.add('hidden')">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4 p-6">
            <h2 class="text-lg font-bold mb-4">New Return</h2>
            <form id="form-return" onsubmit="return submitReturn(event)" class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Warehouse *</label>
                    <select name="warehouse_id" required class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Select...</option>
                        {each warehouses as w}
                            <option value="{w.id}">{w.code} — {w.name}</option>
                        {/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Type</label>
                    <select name="return_type" class="border rounded px-3 py-2 w-full text-sm">
                        <option value="customer">Customer</option>
                        <option value="supplier">Supplier</option>
                        <option value="internal">Internal</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Customer Name</label>
                    <input type="text" name="customer_name" class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Reason</label>
                    <textarea name="reason" class="border rounded px-3 py-2 w-full text-sm" rows="2"></textarea>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Items</label>
                    
                    
                </div>
                <div class="flex gap-2 justify-end pt-2">
                    <button type="button" onclick="document.getElementById('showCreate-modal').classList.add('hidden')" class="px-4 py-2 text-gray-600 border rounded text-sm">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded text-sm">Create Return</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function returnsPage() {
    return {
        showCreate: false,
        form: { warehouse_id: '', return_type: 'customer', customer_name: '', reason: '', items: [] },
        async submitReturn() {
            const res = await fetch('/api/v1/wms/returns', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(this.form)});
            const data = await res.json();
            if (!data.ok) { alert('Error: ' + data.error); return; }
            location.reload();
        }
    }
}

function processReturn(id, action) { if(confirm(action === 'approve' ? 'Approve this return?' : 'Reject this return?')) { fetch('{base_url}/api/v1/wms/returns/'+id+'/process', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({action:action})}).then(function(r){return r.json()}).then(function(res){if(res.ok)location.reload();else alert(res.error)}); } }

</script>
