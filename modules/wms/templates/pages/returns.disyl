<div class="p-6" x-data="returnsPage()">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Returns</h1>
        <button @@click="showCreate = true" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm">+ New Return</button>
    </div>

    <div class="bg-white rounded shadow overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left">
                    <th class="px-4 py-3 font-medium text-gray-600">Return #</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Type</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Customer</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Warehouse</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Status</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Disposition</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Date</th>
                </tr>
            </thead>
            <tbody>
                {@each returns as r}
                <tr class="border-t hover:bg-gray-50">
                    <td class="px-4 py-3 font-medium">{r.return_number}</td>
                    <td class="px-4 py-3 text-xs">{r.return_type}</td>
                    <td class="px-4 py-3">{r.customer_name ?? '—'}</td>
                    <td class="px-4 py-3">{r.warehouse_code}</td>
                    <td class="px-4 py-3">
                        <span class="inline-block px-2 py-0.5 rounded text-xs font-medium"
                              :class="{'bg-yellow-100 text-yellow-700': r.status==='pending','bg-blue-100 text-blue-700': r.status==='approved','bg-red-100 text-red-700': r.status==='rejected','bg-green-100 text-green-700': r.status==='restocked'}">{r.status}</span>
                    </td>
                    <td class="px-4 py-3 text-xs">{r.disposition ?? '—'}</td>
                    <td class="px-4 py-3 text-xs text-gray-400">{r.created_at}</td>
                </tr>
                {@/each}
                {@if count(returns) === 0}
                <tr><td colspan="7" class="px-4 py-8 text-center text-gray-400">No returns found.</td></tr>
                {@/if}
            </tbody>
        </table>
    </div>

    <div x-show="showCreate" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" style="display:none">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4 p-6" @@click.outside="showCreate=false">
            <h2 class="text-lg font-bold mb-4">New Return</h2>
            <form @@submit.prevent="submitReturn()" class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Warehouse *</label>
                    <select x-model="form.warehouse_id" required class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Select...</option>
                        {@each warehouses as w}
                            <option value="{w.id}">{w.code} — {w.name}</option>
                        {@/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Type</label>
                    <select x-model="form.return_type" class="border rounded px-3 py-2 w-full text-sm">
                        <option value="customer">Customer</option>
                        <option value="supplier">Supplier</option>
                        <option value="internal">Internal</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Customer Name</label>
                    <input type="text" x-model="form.customer_name" class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Reason</label>
                    <textarea x-model="form.reason" class="border rounded px-3 py-2 w-full text-sm" rows="2"></textarea>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Items</label>
                    <template x-for="(item, i) in form.items" :key="i">
                        <div class="flex gap-2 mb-2 items-end">
                            <select x-model="item.product_id" class="border rounded px-3 py-2 text-sm flex-1">
                                <option value="">Product...</option>
                                {@each products as p}
                                    <option value="{p.id}">{p.name} ({p.sku})</option>
                                {@/each}
                            </select>
                            <input type="number" step="0.0001" x-model="item.quantity" placeholder="Qty" class="border rounded px-3 py-2 text-sm w-20">
                            <select x-model="item.condition" class="border rounded px-3 py-2 text-sm">
                                <option value="">Condition</option>
                                <option value="good">Good</option>
                                <option value="defective">Defective</option>
                                <option value="damaged">Damaged</option>
                                <option value="expired">Expired</option>
                            </select>
                            <button type="button" @@click="form.items.splice(i,1)" class="text-red-500 text-xs">✕</button>
                        </div>
                    </template>
                    <button type="button" @@click="form.items.push({product_id:'',quantity:'',condition:''})" class="text-blue-600 text-xs">+ Add item</button>
                </div>
                <div class="flex gap-2 justify-end pt-2">
                    <button type="button" @@click="showCreate=false" class="px-4 py-2 text-gray-600 border rounded text-sm">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded text-sm">Create Return</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function returnsPage() {
    return {
        showCreate: false,
        form: { warehouse_id: '', return_type: 'customer', customer_name: '', reason: '', items: [] },
        async submitReturn() {
            const res = await fetch('/api/v1/wms/returns', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(this.form)});
            const data = await res.json();
            if (!data.ok) { alert('Error: ' + data.error); return; }
            location.reload();
        }
    }
}
</script>
