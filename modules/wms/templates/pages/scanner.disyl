<div class="p-6">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">📷 Barcode Scanner</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white rounded shadow p-6">
            <h2 class="text-sm font-semibold text-gray-700 mb-4">Scan Product</h2>
            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Barcode / SKU</label>
                    <input type="text" id="scan-input" placeholder="Scan or type barcode..." autofocus
                           class="border rounded px-3 py-2 w-full text-sm"
                           onkeydown="if(event.key==='Enter'){const v=this.value.trim();if(!v)return;fetch('/api/v1/wms/products?q='+encodeURIComponent(v)).then(r=>r.json()).then(d=>{if(d.ok&&d.products.length>0){const p=d.products[0];document.getElementById('scan-result').innerHTML='<div class=\\'p-4 bg-green-50 rounded\\'><p class=\\'font-medium\\'>'+p.name+'</p><p class=\\'text-sm text-gray-500\\'>SKU: '+p.sku+' | Unit: '+p.unit+'</p><p class=\\'text-xs text-gray-400\\'>ID: '+p.id+'</p></div>';}else{document.getElementById('scan-result').innerHTML='<div class=\\'p-4 bg-red-50 text-red-700 rounded\\'>Product not found</div>';}}).catch(()=>{document.getElementById('scan-result').innerHTML='<div class=\\'p-4 bg-red-50 text-red-700 rounded\\'>Search failed</div>';});this.value='';})">
                </div>
                <div id="scan-result" class="text-sm text-gray-400">Awaiting scan...</div>
            </div>
        </div>

        <div class="bg-white rounded shadow p-6">
            <h2 class="text-sm font-semibold text-gray-700 mb-4">Quick Lookup</h2>
            <div class="space-y-2 max-h-96 overflow-y-auto">
                {each products as p}
                <div class="p-2 border rounded text-sm hover:bg-gray-50 cursor-pointer"
                     onclick="document.getElementById('scan-input').value='{p.sku}';document.getElementById('scan-input').dispatchEvent(new KeyboardEvent('keydown',{'key':'Enter'}))">
                    <span class="font-medium">{p.name}</span>
                    <span class="text-xs text-gray-400 ml-2">{p.sku}</span>
                    {if p.barcode}
                    <span class="text-xs text-gray-400 ml-1">| {p.barcode}</span>
                    {/if}
                </div>
                {/each}
                {if count(products) === 0}
                <div class="text-center text-gray-400 py-4 text-sm">No products loaded.</div>
                {/if}
            </div>
        </div>
    </div>
</div>
