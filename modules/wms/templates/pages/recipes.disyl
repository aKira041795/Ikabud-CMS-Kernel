<div class="p-6" id="recipesPage-page">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Recipes / Bill of Materials</h1>
        <button onclick="document.getElementById('recipe-modal').classList.remove('hidden')" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm">+ New Recipe</button>
    </div>

    <div class="bg-white rounded shadow overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left">
                    <th class="px-4 py-3 font-medium text-gray-600">Recipe Code</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Name</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Product</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Output</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Version</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Status</th>
                        <th class="px-4 py-3 font-medium text-gray-600 text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {each recipes as r}
                <tr class="border-t hover:bg-gray-50">
                    <td class="px-4 py-3 font-medium">{r.recipe_code}</td>
                    <td class="px-4 py-3">{r.name}</td>
                    <td class="px-4 py-3 text-sm">{r.product_name} ({r.sku})</td>
                    <td class="px-4 py-3 text-sm">{r.output_qty|number_format:4} {r.output_unit}</td>
                    <td class="px-4 py-3 text-sm">v{r.version}</td>
                    <td class="px-4 py-3">
                        <span class="inline-block px-2 py-0.5 rounded text-xs font-medium">{r.is_active ? 'Active' : 'Inactive'}</span>
                    </td>
                        <td class="px-4 py-3 text-center text-xs">
                            <button onclick="location.href='/wms/recipes'" class="text-blue-600 hover:text-blue-800">View</button>
                        </td>
                </tr>
                {/each}
                {if count(recipes) === 0}
                <tr><td colspan="7" class="px-4 py-8 text-center text-gray-400">No recipes found.</td></tr>
                {/if}
            </tbody>
        </table>
    </div>

    <div id="recipe-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden" onclick="if(event.target===this)this.classList.add('hidden')">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4 p-6">
            <h2 class="text-lg font-bold mb-4">New Recipe</h2>
            <form id="form-recipe" onsubmit="return submitRecipe(event)" class="space-y-3">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Recipe Code *</label>
                        <input type="text" name="recipe_code" required class="border rounded px-3 py-2 w-full text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Product *</label>
                        <select name="product_id" required class="border rounded px-3 py-2 w-full text-sm">
                            <option value="">Select...</option>
                            {each products as p}
                                <option value="{p.id}">{p.name} ({p.sku})</option>
                            {/each}
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Name *</label>
                    <input type="text" name="name" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Output Qty</label>
                        <input type="number" step="0.0001" name="output_qty" class="border rounded px-3 py-2 w-full text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Output Unit</label>
                        <input type="text" name="output_unit" class="border rounded px-3 py-2 w-full text-sm">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-2">Ingredients</label>
                    
                    
                </div>
                <div class="flex gap-2 justify-end pt-2">
                    <button type="button" onclick="document.getElementById('recipe-modal').classList.add('hidden')" class="px-4 py-2 text-gray-600 border rounded text-sm">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded text-sm">Create Recipe</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function recipesPage() {
    return {
        showCreate: false,
        form: { product_id: '', recipe_code: '', name: '', output_qty: 1, output_unit: 'pcs', description: '', ingredients: [] },
        async submitRecipe() {
            const res = await fetch('/api/v1/wms/recipes', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(this.form)});
            const data = await res.json();
            if (!data.ok) { alert('Error: ' + data.error); return; }
            location.reload();
        }
    }
}

// Recipes are view-only from the list page

</script>
