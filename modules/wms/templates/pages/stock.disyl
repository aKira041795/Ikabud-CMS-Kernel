<div class="p-6" id="stock-page">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Stock Levels</h1>
        <div class="flex gap-2">
            <button onclick="document.getElementById('receive-modal').classList.remove('hidden')" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 text-sm">Receive Stock</button>
            <button onclick="document.getElementById('adjust-modal').classList.remove('hidden')" class="px-4 py-2 bg-amber-600 text-white rounded hover:bg-amber-700 text-sm">Adjust Stock</button>
            <button onclick="document.getElementById('transfer-modal').classList.remove('hidden')" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm">Transfer</button>
        </div>
    </div>

    <div class="bg-white rounded shadow mb-6">
        <div class="p-4 border-b flex flex-wrap gap-4 items-end">
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Warehouse</label>
                <select id="filter-warehouse" onchange="applyFilters()" class="border rounded px-3 py-2 text-sm">
                    <option value="">All Warehouses</option>
                    {each warehouses as w}
                        <option value="{w.id}">{w.code} — {w.name}</option>
                    {/each}
                </select>
            </div>
            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" id="filter-low-stock" onchange="applyFilters()" class="rounded">
                Low stock only (below reorder point)
            </label>
            <div class="ml-auto">
                <input type="text" id="filter-search" placeholder="Search product..." oninput="applyFiltersDelayed()" class="border rounded px-3 py-2 text-sm w-48">
            </div>
        </div>
    </div>

    <div class="bg-white rounded shadow overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left">
                    <th class="px-4 py-3 font-medium text-gray-600">Product</th>
                    <th class="px-4 py-3 font-medium text-gray-600">SKU</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Warehouse</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Location</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Batch</th>
                    <th class="px-4 py-3 font-medium text-gray-600 text-right">On Hand</th>
                    <th class="px-4 py-3 font-medium text-gray-600 text-right">Reserved</th>
                    <th class="px-4 py-3 font-medium text-gray-600 text-right">Available</th>
                    <th class="px-4 py-3 font-medium text-gray-600 text-right">Staged</th>
                </tr>
            </thead>
            <tbody>
                {each stock as s}
                <tr class="border-t hover:bg-gray-50" class="{'bg-red-50': s.qty_on_hand <= s.reorder_point && s.reorder_point > 0 ? 'bg-red-50' : ''}>
                    <td class="px-4 py-3">{s.product_name}</td>
                    <td class="px-4 py-3 text-gray-500">{s.sku}</td>
                    <td class="px-4 py-3">{s.warehouse_code}</td>
                    <td class="px-4 py-3 text-gray-500">{s.location_code ?? '—'}</td>
                    <td class="px-4 py-3 text-gray-500">{s.batch_number ?? '—'}</td>
                    <td class="px-4 py-3 text-right font-medium">{s.qty_on_hand|number_format:4}</td>
                    <td class="px-4 py-3 text-right text-amber-600">{s.qty_reserved|number_format:4}</td>
                    <td class="px-4 py-3 text-right font-medium">{(s.qty_on_hand - s.qty_reserved)|number_format:4}</td>
                    <td class="px-4 py-3 text-right text-gray-400">{s.qty_staged|number_format:4}</td>
                </tr>
                {/each}
                {if count(stock) === 0}
                <tr><td colspan="9" class="px-4 py-8 text-center text-gray-400">No stock records found.</td></tr>
                {/if}
            </tbody>
        </table>
    </div>

    <!-- Receive Modal -->
    <div id="receive-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden" onclick="if(event.target===this)this.classList.add('hidden')">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4 p-6">
            <h2 class="text-lg font-bold mb-4">Receive Stock</h2>
            <form id="form-receive" onsubmit="return submitReceive(event)" class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Product *</label>
                    <select name="product_id" required class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Select product...</option>
                        {each products as p}
                            <option value="{p.id}">{p.name} ({p.sku})</option>
                        {/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Warehouse *</label>
                    <select name="warehouse_id" required class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Select warehouse...</option>
                        {each warehouses as w}
                            <option value="{w.id}">{w.code} — {w.name}</option>
                        {/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Location</label>
                    <input type="text" name="location_id" placeholder="Location ID (optional)" class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Quantity *</label>
                    <input type="number" step="0.0001" min="0.0001" name="quantity" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Reference</label>
                    <input type="text" name="reference_type" placeholder="e.g. delivery, PO" class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Notes</label>
                    <textarea name="notes" class="border rounded px-3 py-2 w-full text-sm" rows="2"></textarea>
                </div>
                <div class="flex gap-2 justify-end pt-2">
                    <button type="button" onclick="document.getElementById('receive-modal').classList.add('hidden')" class="px-4 py-2 text-gray-600 border rounded text-sm">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded text-sm">Receive</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Transfer Modal -->
    <div id="transfer-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden" onclick="if(event.target===this)this.classList.add('hidden')">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4 p-6">
            <h2 class="text-lg font-bold mb-4">Transfer Stock</h2>
            <form id="form-transfer" onsubmit="return submitTransfer(event)" class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Product *</label>
                    <select name="product_id" required class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Select product...</option>
                        {each products as p}
                            <option value="{p.id}">{p.name} ({p.sku})</option>
                        {/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">From Location ID *</label>
                    <input type="number" name="from_location_id" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">To Location ID *</label>
                    <input type="number" name="to_location_id" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Quantity *</label>
                    <input type="number" step="0.0001" min="0.0001" name="quantity" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Notes</label>
                    <textarea name="notes" class="border rounded px-3 py-2 w-full text-sm" rows="2"></textarea>
                </div>
                <div class="flex gap-2 justify-end pt-2">
                    <button type="button" onclick="document.getElementById('transfer-modal').classList.add('hidden')" class="px-4 py-2 text-gray-600 border rounded text-sm">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded text-sm">Transfer</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Adjust Modal -->
    <div id="adjust-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden" onclick="if(event.target===this)this.classList.add('hidden')">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4 p-6">
            <h2 class="text-lg font-bold mb-4">Adjust Stock</h2>
            <form id="form-adjust" onsubmit="return submitAdjust(event)" class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Product *</label>
                    <select name="product_id" required class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Select product...</option>
                        {each products as p}
                            <option value="{p.id}">{p.name} ({p.sku})</option>
                        {/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Warehouse *</label>
                    <select name="warehouse_id" required class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Select warehouse...</option>
                        {each warehouses as w}
                            <option value="{w.id}">{w.code} — {w.name}</option>
                        {/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">New Quantity *</label>
                    <input type="number" step="0.0001" min="0" name="new_quantity" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Type</label>
                    <select name="adjustment_type" class="border rounded px-3 py-2 w-full text-sm">
                        <option value="correction">Correction</option>
                        <option value="damage">Damage</option>
                        <option value="loss">Loss</option>
                        <option value="write_off">Write-off</option>
                        <option value="cycle_count">Cycle Count</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Reason *</label>
                    <textarea name="reason" required class="border rounded px-3 py-2 w-full text-sm" rows="2"></textarea>
                </div>
                <div class="flex gap-2 justify-end pt-2">
                    <button type="button" onclick="document.getElementById('adjust-modal').classList.add('hidden')" class="px-4 py-2 text-gray-600 border rounded text-sm">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-amber-600 text-white rounded text-sm">Adjust</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
var filterTimeout = null;
function applyFilters() {
    var params = new URLSearchParams();
    var w = document.getElementById('filter-warehouse');
    if (w && w.value) params.set('warehouse_id', w.value);
    var ls = document.getElementById('filter-low-stock');
    if (ls && ls.checked) params.set('low_stock', '1');
    var s = document.getElementById('filter-search');
    if (s && s.value) params.set('q', s.value);
    window.location.search = params.toString();
}
function applyFiltersDelayed() {
    if (filterTimeout) clearTimeout(filterTimeout);
    filterTimeout = setTimeout(applyFilters, 300);
}
function submitReceive(e) {
    e.preventDefault();
    var fd = new FormData(e.target);
    fd.set('idempotency_key', 'recv-' + Date.now());
    fetch('/api/v1/wms/stock/receive', { method: 'POST', body: fd })
        .then(function(r){ return r.json(); })
        .then(function(data) {
            if (!data.ok) { alert('Error: ' + data.error); return; }
            location.reload();
        });
    return false;
}
function submitTransfer(e) {
    e.preventDefault();
    var fd = new FormData(e.target);
    fetch('/api/v1/wms/stock/transfer', { method: 'POST', body: fd })
        .then(function(r){ return r.json(); })
        .then(function(data) {
            if (!data.ok) { alert('Error: ' + data.error); return; }
            location.reload();
        });
    return false;
}
function submitAdjust(e) {
    e.preventDefault();
    var fd = new FormData(e.target);
    fetch('/api/v1/wms/stock/adjust', { method: 'POST', body: fd })
        .then(function(r){ return r.json(); })
        .then(function(data) {
            if (!data.ok) { alert('Error: ' + data.error); return; }
            location.reload();
        });
    return false;
}
</script>

