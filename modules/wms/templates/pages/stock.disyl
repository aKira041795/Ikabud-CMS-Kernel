<div class="p-6" x-data="stockPage()">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Stock Levels</h1>
        <div class="flex gap-2">
            <button @@click="showReceive = true" class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 text-sm">Receive Stock</button>
            <button @@click="showAdjust = true" class="px-4 py-2 bg-amber-600 text-white rounded hover:bg-amber-700 text-sm">Adjust Stock</button>
            <button @@click="showTransfer = true" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm">Transfer</button>
        </div>
    </div>

    <div class="bg-white rounded shadow mb-6">
        <div class="p-4 border-b flex flex-wrap gap-4 items-end">
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Warehouse</label>
                <select x-model="filterWarehouse" @@change="applyFilters()" class="border rounded px-3 py-2 text-sm">
                    <option value="">All Warehouses</option>
                    {each warehouses as w}
                        <option value="{w.id}">{w.code} — {w.name}</option>
                    {/each}
                </select>
            </div>
            <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" x-model="filterLowStock" @@change="applyFilters()" class="rounded">
                Low stock only (below reorder point)
            </label>
            <div class="ml-auto">
                <input type="text" x-model="search" placeholder="Search product..." @@input.debounce="applyFilters()" class="border rounded px-3 py-2 text-sm w-48">
            </div>
        </div>
    </div>

    <div class="bg-white rounded shadow overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left">
                    <th class="px-4 py-3 font-medium text-gray-600">Product</th>
                    <th class="px-4 py-3 font-medium text-gray-600">SKU</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Warehouse</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Location</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Batch</th>
                    <th class="px-4 py-3 font-medium text-gray-600 text-right">On Hand</th>
                    <th class="px-4 py-3 font-medium text-gray-600 text-right">Reserved</th>
                    <th class="px-4 py-3 font-medium text-gray-600 text-right">Available</th>
                    <th class="px-4 py-3 font-medium text-gray-600 text-right">Staged</th>
                </tr>
            </thead>
            <tbody>
                {each stock as s}
                <tr class="border-t hover:bg-gray-50" :class="{'bg-red-50': s.qty_on_hand <= s.reorder_point && s.reorder_point > 0}">
                    <td class="px-4 py-3">{s.product_name}</td>
                    <td class="px-4 py-3 text-gray-500">{s.sku}</td>
                    <td class="px-4 py-3">{s.warehouse_code}</td>
                    <td class="px-4 py-3 text-gray-500">{s.location_code|default:'—'}</td>
                    <td class="px-4 py-3 text-gray-500">{s.batch_number|default:'—'}</td>
                    <td class="px-4 py-3 text-right font-medium">{s.qty_on_hand|number_format:4}</td>
                    <td class="px-4 py-3 text-right text-amber-600">{s.qty_reserved|number_format:4}</td>
                    <td class="px-4 py-3 text-right font-medium" :class="s.qty_on_hand - s.qty_reserved <= 0 ? 'text-red-600' : 'text-green-600'">{(s.qty_on_hand - s.qty_reserved)|number_format:4}</td>
                    <td class="px-4 py-3 text-right text-gray-400">{s.qty_staged|number_format:4}</td>
                </tr>
                {/each}
                {if count(stock) === 0}
                <tr><td colspan="9" class="px-4 py-8 text-center text-gray-400">No stock records found.</td></tr>
                {/if}
            </tbody>
        </table>
    </div>

    <!-- Receive Modal -->
    <div x-show="showReceive" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" style="display:none">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4 p-6" @@click.outside="showReceive=false">
            <h2 class="text-lg font-bold mb-4">Receive Stock</h2>
            <form @@submit.prevent="submitReceive()" class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Product *</label>
                    <select x-model="receive.product_id" required class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Select product...</option>
                        {each products as p}
                            <option value="{p.id}">{p.name} ({p.sku})</option>
                        {/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Warehouse *</label>
                    <select x-model="receive.warehouse_id" required class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Select warehouse...</option>
                        {each warehouses as w}
                            <option value="{w.id}">{w.code} — {w.name}</option>
                        {/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Location</label>
                    <input type="text" x-model="receive.location_id" placeholder="Location ID (optional)" class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Quantity *</label>
                    <input type="number" step="0.0001" min="0.0001" x-model="receive.quantity" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Reference</label>
                    <input type="text" x-model="receive.reference_type" placeholder="e.g. delivery, PO" class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Notes</label>
                    <textarea x-model="receive.notes" class="border rounded px-3 py-2 w-full text-sm" rows="2"></textarea>
                </div>
                <div class="flex gap-2 justify-end pt-2">
                    <button type="button" @@click="showReceive=false" class="px-4 py-2 text-gray-600 border rounded text-sm">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-green-600 text-white rounded text-sm">Receive</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Transfer Modal -->
    <div x-show="showTransfer" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" style="display:none">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4 p-6" @@click.outside="showTransfer=false">
            <h2 class="text-lg font-bold mb-4">Transfer Stock</h2>
            <form @@submit.prevent="submitTransfer()" class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Product *</label>
                    <select x-model="transfer.product_id" required class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Select product...</option>
                        {each products as p}
                            <option value="{p.id}">{p.name} ({p.sku})</option>
                        {/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">From Location ID *</label>
                    <input type="number" x-model="transfer.from_location_id" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">To Location ID *</label>
                    <input type="number" x-model="transfer.to_location_id" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Quantity *</label>
                    <input type="number" step="0.0001" min="0.0001" x-model="transfer.quantity" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Notes</label>
                    <textarea x-model="transfer.notes" class="border rounded px-3 py-2 w-full text-sm" rows="2"></textarea>
                </div>
                <div class="flex gap-2 justify-end pt-2">
                    <button type="button" @@click="showTransfer=false" class="px-4 py-2 text-gray-600 border rounded text-sm">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded text-sm">Transfer</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Adjust Modal -->
    <div x-show="showAdjust" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50" style="display:none">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4 p-6" @@click.outside="showAdjust=false">
            <h2 class="text-lg font-bold mb-4">Adjust Stock</h2>
            <form @@submit.prevent="submitAdjust()" class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Product *</label>
                    <select x-model="adjust.product_id" required class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Select product...</option>
                        {each products as p}
                            <option value="{p.id}">{p.name} ({p.sku})</option>
                        {/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Warehouse *</label>
                    <select x-model="adjust.warehouse_id" required class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Select warehouse...</option>
                        {each warehouses as w}
                            <option value="{w.id}">{w.code} — {w.name}</option>
                        {/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">New Quantity *</label>
                    <input type="number" step="0.0001" min="0" x-model="adjust.new_quantity" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Type</label>
                    <select x-model="adjust.adjustment_type" class="border rounded px-3 py-2 w-full text-sm">
                        <option value="correction">Correction</option>
                        <option value="damage">Damage</option>
                        <option value="loss">Loss</option>
                        <option value="write_off">Write-off</option>
                        <option value="cycle_count">Cycle Count</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Reason *</label>
                    <textarea x-model="adjust.reason" required class="border rounded px-3 py-2 w-full text-sm" rows="2"></textarea>
                </div>
                <div class="flex gap-2 justify-end pt-2">
                    <button type="button" @@click="showAdjust=false" class="px-4 py-2 text-gray-600 border rounded text-sm">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-amber-600 text-white rounded text-sm">Adjust</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function stockPage() {
    return {
        showReceive: false,
        showTransfer: false,
        showAdjust: false,
        filterWarehouse: '',
        filterLowStock: false,
        search: '',
        receive: { product_id: '', warehouse_id: '', location_id: '', quantity: '', reference_type: '', notes: '', idempotency_key: '' },
        transfer: { product_id: '', from_location_id: '', to_location_id: '', quantity: '', notes: '' },
        adjust: { product_id: '', warehouse_id: '', new_quantity: '', adjustment_type: 'correction', reason: '' },
        applyFilters() {
            const params = new URLSearchParams();
            if (this.filterWarehouse) params.set('warehouse_id', this.filterWarehouse);
            if (this.filterLowStock) params.set('low_stock', '1');
            if (this.search) params.set('q', this.search);
            window.location.search = params.toString();
        },
        async submitReceive() {
            const r = this.receive;
            r.idempotency_key = 'recv-' + Date.now();
            const res = await fetch('/api/v1/wms/stock/receive', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(r) });
            const data = await res.json();
            if (!data.ok) { alert('Error: ' + data.error); return; }
            location.reload();
        },
        async submitTransfer() {
            const res = await fetch('/api/v1/wms/stock/transfer', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(this.transfer) });
            const data = await res.json();
            if (!data.ok) { alert('Error: ' + data.error); return; }
            location.reload();
        },
        async submitAdjust() {
            const res = await fetch('/api/v1/wms/stock/adjust', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(this.adjust) });
            const data = await res.json();
            if (!data.ok) { alert('Error: ' + data.error); return; }
            location.reload();
        }
    }
}
</script>

