<div class="p-6" id="pickingPage-page">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">📦 Picking</h1>
        <button onclick="document.getElementById('picking-modal').classList.remove('hidden')" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm">+ New Picklist</button>
    </div>

    <div class="bg-white rounded shadow overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left">
                    <th class="px-4 py-3 font-medium text-gray-600">Picklist</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Warehouse</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Status</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Assigned To</th>
                    <th class="px-4 py-3 font-medium text-gray-600">Created</th>
                        <th class="px-4 py-3 font-medium text-gray-600 text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {each picklists as p}
                <tr class="border-t hover:bg-gray-50">
                    <td class="px-4 py-3 font-medium">Picklist #{p.id}</td>
                    <td class="px-4 py-3">{p.warehouse_code}</td>
                    <td class="px-4 py-3">
                        <span class="inline-block px-2 py-0.5 rounded text-xs font-medium">{p.status}</span>
                    </td>
                    <td class="px-4 py-3 text-sm">{p.assigned_name ?? '—'}</td>
                    <td class="px-4 py-3 text-xs text-gray-400">{p.created_at}</td>
                        <td class="px-4 py-3 text-center text-xs">
                            <button onclick="location.href='/wms/picking'" class="text-blue-600 hover:text-blue-800">View</button>
                        </td>
                </tr>
                {/each}
                {if count(picklists) === 0}
                <tr><td colspan="6" class="px-4 py-8 text-center text-gray-400">No active picklists.</td></tr>
                {/if}
            </tbody>
        </table>
    </div>

    <!-- Create Picklist Modal -->
    <div id="picking-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 hidden" onclick="if(event.target===this)this.classList.add('hidden')">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4 p-6">
            <h2 class="text-lg font-bold mb-4">New Picklist</h2>
            <form id="form-picking" onsubmit="return submitPicklist(event)" class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Warehouse *</label>
                    <select name="warehouse_id" required class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Select...</option>
                        {each warehouses as w}
                            <option value="{w.id}">{w.code} — {w.name}</option>
                        {/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Order</label>
                    <select name="order_ids" class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Select order...</option>
                        {each orders as o}
                            <option value="{o.id}">#{o.id} — {o.customer_name ?? 'Unnamed'}</option>
                        {/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Assign To</label>
                    <select name="assigned_to" class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Unassigned</option>
                        {each users as u}
                            <option value="{u.id}">{u.full_name}</option>
                        {/each}
                    </select>
                </div>
                <div class="flex gap-2 justify-end pt-2">
                    <button type="button" onclick="document.getElementById('picking-modal').classList.add('hidden')" class="px-4 py-2 text-gray-600 border rounded text-sm">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded text-sm">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
function pickingPage() {
    return {
        showCreate: false,
        form: { warehouse_id: '', order_ids: '', assigned_to: '' },
        async submitPicklist() {
            const ids = this.form.order_ids ? [parseInt(this.form.order_ids)] : [];
            const res = await fetch('/api/v1/wms/picklists', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({warehouse_id:parseInt(this.form.warehouse_id), order_ids: ids, assigned_to: this.form.assigned_to ? parseInt(this.form.assigned_to) : null})});
            const data = await res.json();
            if (!data.ok) { alert('Error: ' + data.error); return; }
            location.reload();
        }
    }
}

// Picking actions available on the picklist detail page

</script>
