<div class="p-6">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Warehouse Tasks</h1>
        <button onclick="document.getElementById('task-modal').classList.remove('hidden')" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm">+ New Task</button>
    </div>

    <div class="bg-white rounded shadow mb-6">
        <div class="p-4 border-b flex gap-4 items-center">
            <select onchange="if(this.value) {const p=new URLSearchParams(location.search); p.set('status',this.value); location.search=p.toString();} else {const p=new URLSearchParams(location.search); p.delete('status'); location.search=p.toString();}" class="border rounded px-3 py-2 text-sm">
                <option value="">All</option>
                <option value="open" {eq($_GET['status'] ?? '', 'open') ? 'selected' : ''}>Open</option>
                <option value="assigned" {eq($_GET['status'] ?? '', 'assigned') ? 'selected' : ''}>Assigned</option>
                <option value="in_progress" {eq($_GET['status'] ?? '', 'in_progress') ? 'selected' : ''}>In Progress</option>
                <option value="completed" {eq($_GET['status'] ?? '', 'completed') ? 'selected' : ''}>Completed</option>
            </select>
            <span class="text-xs text-gray-400">{tasks|count} tasks</span>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {each tasks as t}
        <div class="bg-white rounded shadow border-l-4 p-4"
             class="border-l-4 {t.priority == 'critical' ? 'border-l-red-500' : t.priority == 'high' ? 'border-l-amber-500' : t.priority == 'medium' ? 'border-l-blue-500' : 'border-l-gray-400'}">
            <div class="flex items-start justify-between mb-2">
                <h3 class="font-medium text-sm">{t.title}</h3>
                <span class="inline-block px-2 py-0.5 rounded text-xs font-medium"
                      class="inline-block px-2 py-0.5 rounded text-xs font-medium {t.status == 'open' ? 'bg-gray-100 text-gray-600' : t.status == 'assigned' || t.status == 'in_progress' ? 'bg-blue-100 text-blue-700' : t.status == 'completed' ? 'bg-green-100 text-green-700' : ''}">{t.status}</span>
            </div>
            <div class="text-xs text-gray-500 space-y-1">
                <div><span class="font-medium">Type:</span> {t.task_type}</div>
                <div><span class="font-medium">Priority:</span> {t.priority}</div>
                <div><span class="font-medium">Warehouse:</span> {t.warehouse_code}</div>
                <div><span class="font-medium">Assigned:</span> {t.assigned_name ?? '—'}</div>
                {if t.description}
                <div class="text-gray-400 pt-1">{t.description}</div>
                {/if}
            </div>
        </div>
        {/each}
        {if count(tasks) === 0}
        <div class="col-span-3 py-12 text-center text-gray-400">No tasks found.</div>
        {/if}
    </div>

    <div id="task-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50" onclick="if(event.target===this)this.classList.add('hidden')">
        <div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4 p-6" onclick="event.stopPropagation()">
            <h2 class="text-lg font-bold mb-4">New Task</h2>
            <form id="task-form" onsubmit="return submitTask(event)" class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Warehouse *</label>
                    <select name="warehouse_id" required class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Select...</option>
                        {each warehouses as w}
                            <option value="{w.id}">{w.code} — {w.name}</option>
                        {/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Title *</label>
                    <input type="text" name="title" required class="border rounded px-3 py-2 w-full text-sm">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Type</label>
                    <select name="task_type" class="border rounded px-3 py-2 w-full text-sm">
                        <option value="other">Other</option>
                        <option value="putaway">Putaway</option>
                        <option value="pick">Pick</option>
                        <option value="cycle_count">Cycle Count</option>
                        <option value="receive">Receive</option>
                        <option value="transfer">Transfer</option>
                        <option value="audit">Audit</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Priority</label>
                    <select name="priority" class="border rounded px-3 py-2 w-full text-sm">
                        <option value="low">Low</option>
                        <option value="medium">Medium</option>
                        <option value="high">High</option>
                        <option value="critical">Critical</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Assigned To</label>
                    <select name="assigned_to" class="border rounded px-3 py-2 w-full text-sm">
                        <option value="">Unassigned</option>
                        {each users as u}
                            <option value="{u.id}">{u.full_name}</option>
                        {/each}
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Description</label>
                    <textarea name="description" class="border rounded px-3 py-2 w-full text-sm" rows="2"></textarea>
                </div>
                <div class="flex gap-2 justify-end pt-2">
                    <button type="button" onclick="document.getElementById('task-modal').classList.add('hidden')" class="px-4 py-2 text-gray-600 border rounded text-sm">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded text-sm">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function submitTask(e) { e.preventDefault(); var data={}; new FormData(e.target).forEach(function(v,k){data[k]=v;}); fetch('/api/v1/wms/tasks', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(data)}).then(function(r){return r.json()}).then(function(res){if(res.ok)location.reload();else alert(res.error||'Failed');}); return false; }
</script>
