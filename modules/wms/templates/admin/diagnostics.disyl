@extends('layouts/admin')

@section('content')
<div class="max-w-6xl mx-auto py-8" x-data="diagnosticsData()">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold">WMS Diagnostics & Observability</h2>
    </div>

    <!-- Trace Movement Tool -->
    <div class="bg-white shadow rounded-lg p-6 mb-6">
        <h3 class="text-lg font-bold mb-4 border-b pb-2">Movement Trace Inspector</h3>
        <p class="text-gray-500 mb-4">Select a product to view the exact sequence of lifecycle stock mutations.</p>
        
        <div class="flex items-center space-x-2 w-full max-w-sm mb-4">
            <input type="number" x-model="traceProductId" placeholder="Product ID" class="border rounded px-3 py-2 w-full" />
            <button @click="traceMovements()" class="bg-indigo-600 text-white px-4 py-2 rounded hover:bg-indigo-700">Trace</button>
        </div>

        <template x-if="tracing">
            <div class="text-gray-500 py-4">Scanning audit trail...</div>
        </template>
        
        <template x-if="traces.length > 0">
            <table class="min-w-full divide-y divide-gray-200 mt-4 border rounded">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Movement ID</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Delta</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Balances</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Reference</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Timestamp</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    <template x-for="t in traces" :key="t.id">
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900" x-text="t.id"></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full" 
                                      :class="{'bg-green-100 text-green-800': ['in', 'cycle_count_adjustment'].includes(t.movement_type), 'bg-red-100 text-red-800': t.movement_type == 'out', 'bg-yellow-100 text-yellow-800': t.movement_type == 'reserved', 'bg-blue-100 text-blue-800': true}" x-text="t.movement_type"></span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-bold" :class="parseFloat(t.qty) < 0 ? 'text-red-500' : 'text-green-600'" x-text="t.qty"></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" x-text="t.qty_before + ' → ' + t.qty_after"></td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                <span x-text="t.reference_type || 'Manual'"></span>: <span x-text="t.reference_id || 'N/A'"></span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" x-text="t.created_at"></td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </template>
        <template x-if="traces.length === 0 && !tracing && traceProductId !== null">
            <div class="text-red-500 py-4">No movements found.</div>
        </template>
    </div>

    <!-- Hot Reservations -->
    <div class="bg-white shadow rounded-lg p-6">
        <h3 class="text-lg font-bold mb-4 border-b pb-2">Active Reservation Locks</h3>
        <p class="text-gray-500 mb-4">Current items being held by incomplete orders/processes.</p>
        
        <table class="min-w-full divide-y divide-gray-200 border rounded">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Product</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Warehouse / Location</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Qty Reserved</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                <template x-for="r in reservations" :key="r.stock_id">
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-bold" x-text="r.sku + ' - ' + r.product_name"></td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500" x-text="r.warehouse_name + ' - ' + r.location_code"></td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-orange-600 font-bold text-center" x-text="r.qty_reserved"></td>
                    </tr>
                </template>
                <template x-if="reservations.length === 0">
                    <tr>
                        <td colspan="3" class="px-6 py-4 text-center text-gray-500">No active reservations exist in the system.</td>
                    </tr>
                </template>
            </tbody>
        </table>
    </div>
</div>

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('diagnosticsData', () => ({
        traceProductId: null,
        tracing: false,
        traces: [],
        reservations: [],
        init() {
            this.fetchReservations();
        },
        async fetchReservations() {
            try {
                const res = await fetch('/api/v1/wms/diagnostics/reservations');
                if (res.ok) {
                    const data = await res.json();
                    this.reservations = data.reservations || [];
                }
            } catch (err) {
                console.error(err);
            }
        },
        async traceMovements() {
            if (!this.traceProductId) return;
            this.tracing = true;
            this.traces = [];
            try {
                const res = await fetch('/api/v1/wms/diagnostics/trace?product_id=' + this.traceProductId);
                if (res.ok) {
                    const data = await res.json();
                    this.traces = data.trace || [];
                }
            } catch (err) {
                console.error(err);
            } finally {
                this.tracing = false;
            }
        }
    }));
});
</script>
@endsection