@extends('layouts/admin')

@section('content')
<div class="max-w-4xl mx-auto py-8" x-data="onboardingWizard()">
    <div class="bg-white shadow rounded-lg p-6 mb-6 inline-block w-full">
        <h2 class="text-2xl font-bold mb-2">Welcome to your WMS Platform Setup</h2>
        <p class="text-gray-600 mb-6">Let's get your warehouse environment initialized.</p>

        <div x-show="loading" class="text-gray-500 py-4">Checking onboarding status...</div>

        <template x-if="!loading && !status.completed">
            <div class="space-y-6">
                <div class="flex items-center justify-between p-4 border rounded" :class="{'bg-green-50': status.steps.warehouse_created}">
                    <div>
                        <h4 class="font-bold">1. Create a Warehouse</h4>
                        <p class="text-sm text-gray-500">Add your first physical location.</p>
                    </div>
                    <span x-text="status.steps.warehouse_created ? '✅ Done' : 'Pending'" 
                          class="font-medium" :class="status.steps.warehouse_created ? 'text-green-700' : 'text-gray-400'"></span>
                </div>

                <div class="flex items-center justify-between p-4 border rounded" :class="{'bg-green-50': status.steps.categories_created}">
                    <div>
                        <h4 class="font-bold">2. Add Initial Catalog</h4>
                        <p class="text-sm text-gray-500">Create at least one product to track.</p>
                    </div>
                    <span x-text="status.steps.categories_created ? '✅ Done' : 'Pending'" 
                          class="font-medium" :class="status.steps.categories_created ? 'text-green-700' : 'text-gray-400'"></span>
                </div>

                <div class="pt-4 border-t text-right">
                    <button @click="completeOnboarding()" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
                        Mark Onboarding Complete
                    </button>
                </div>
            </div>
        </template>

        <template x-if="!loading && status.completed">
            <div class="bg-green-100 text-green-800 p-6 rounded text-center">
                <h3 class="text-xl font-bold mb-2">Setup Complete!</h3>
                <p>Your WMS tenant space is fully activated.</p>
                <a href="/wms" class="inline-block mt-4 px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">Go to Dashboard</a>
            </div>
        </template>
    </div>
</div>

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('onboardingWizard', () => ({
        loading: true,
        status: { completed: false, steps: {} },
        init() {
            this.fetchStatus();
        },
        async fetchStatus() {
            try {
                const res = await fetch('/api/v1/wms/onboarding/status');
                if (res.ok) {
                    this.status = await res.json();
                }
            } catch (err) {
                console.error(err);
            } finally {
                this.loading = false;
            }
        },
        async completeOnboarding() {
            try {
                const res = await fetch('/api/v1/wms/onboarding/complete', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json', 'Accept': 'application/json'}
                });
                if (res.ok) {
                    this.fetchStatus();
                }
            } catch (err) {
                console.error(err);
            }
        }
    }));
});
</script>
@endsection