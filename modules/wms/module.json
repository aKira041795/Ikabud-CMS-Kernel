{
    "id": "wms",
    "name": "Warehouse Management System",
    "version": "1.4.0",
    "description": "Entity-driven warehouse management for inventory, task execution, imports, diagnostics, onboarding, and financial supply loops.",
    "author": "Ikabud Kernel Team",
    "owns_tables": [
        "wms_users",
        "wms_products",
        "wms_warehouses",
        "wms_locations",
        "wms_batches",
        "wms_stocks",
        "wms_movements",
        "wms_deliveries",
        "wms_delivery_items",
        "wms_orders",
        "wms_order_items",
        "wms_putaway_rules",
        "wms_cycle_counts",
        "wms_cycle_count_items",
        "wms_suppliers",
        "wms_returns",
        "wms_return_items",
        "wms_idempotency_keys",
        "wms_tasks",
        "wms_recipes",
        "wms_recipe_items",
        "wms_production_orders",
        "wms_production_materials",
        "wms_task_exceptions",
        "audit_logs",
        "rate_limits",
        "wms_configs",
        "wms_purchase_orders",
        "wms_purchase_order_items"
    ],
    "reads_tables": [
        "users"
    ],
    "migrations": [
        "database/migrations/001_wms_products.sql",
        "database/migrations/002_wms_warehouses_locations.sql",
        "database/migrations/003_wms_batches.sql",
        "database/migrations/004_wms_stocks.sql",
        "database/migrations/005_wms_movements.sql",
        "database/migrations/006_wms_deliveries.sql",
        "database/migrations/007_wms_orders.sql",
        "database/migrations/008_wms_putaway_rules.sql",
        "database/migrations/009_wms_cycle_counts.sql",
        "database/migrations/010_wms_users.sql",
        "database/migrations/011_wms_suppliers.sql",
        "database/migrations/012_wms_returns.sql",
        "database/migrations/013_wms_hardening.sql",
        "database/migrations/014_wms_phase2.sql",
        "database/migrations/015_wms_phase5_production.sql",
        "database/migrations/016_wms_phase6_platformization.sql",
        "database/migrations/017_wms_phase6_financials.sql",
        "database/migrations/018_wms_phase7_task_exceptions.sql",
        "database/migrations/019_wms_phase75_receiving_closure.sql",
        "database/migrations/020_wms_phase76_exception_dispositions.sql"
    ],
    "events": [
        {
            "key": "wms.delivery.received",
            "description": "Fired when a delivery is received."
        },
        {
            "key": "wms.order.dispatched",
            "description": "Fired when an order is dispatched."
        },
        {
            "key": "wms.order.picked",
            "description": "Fired when an order is successfully picked."
        },
        {
            "key": "wms.order.delivered",
            "description": "Fired when an order is marked as delivered."
        },
        {
            "key": "wms.order.payment_collected",
            "description": "Fired when payment is collected for a delivered order.",
            "available_vars": [
                "order_id",
                "wms_order_id",
                "order_number",
                "external_reference",
                "warehouse_id",
                "customer_name",
                "status",
                "ecommerce_order_id",
                "ecommerce_order_number",
                "payment_status",
                "payment_method",
                "collected_at",
                "actor_user_id",
                "meta"
            ]
        },
        {
            "key": "wms.product.created",
            "description": "Fired when a WMS product is created.",
            "available_vars": [
                "id",
                "sku",
                "barcode",
                "name",
                "description",
                "unit",
                "product_type",
                "is_active",
                "actor_user_id"
            ]
        },
        {
            "key": "wms.product.updated",
            "description": "Fired when a WMS product is updated.",
            "available_vars": [
                "id",
                "sku",
                "barcode",
                "name",
                "description",
                "unit",
                "product_type",
                "is_active",
                "actor_user_id"
            ]
        },
        {
            "key": "wms.movement.created",
            "description": "Fired after a stock movement is recorded."
        },
        {
            "key": "wms.stock.low",
            "description": "Fired when stock falls below configured threshold."
        },
        {
            "key": "wms.production.completed",
            "description": "Fired when a production order successfully consumes materials and generates yield."
        }
    ],
    "capabilities": {
        "exposes": [
            {
                "id": "kernel.auth.authenticate@1",
                "priority": 550,
                "modes": [
                    "pipeline"
                ]
            },
            {
                "id": "wms.stock.query@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "wms.stock.reserve@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "wms.stock.release@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "wms.replenishment.suggest@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "wms.product.upsert@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "wms.order.create@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "wms.order.cancel@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            }
        ],
        "depends": [],
        "policy": {
            "capabilities": {
                "kernel.auth.authenticate@1": {
                    "allow_callers": [
                        "wms",
                        "kernel"
                    ]
                }
            }
        },
        "consumes": []
    },
    "auth_cookie": "wms_token",
    "settings_fields": [
        {
            "key": "low_stock_threshold",
            "type": "number",
            "label": "Default Low Stock Threshold",
            "default": "10"
        },
        {
            "key": "picking_strategy",
            "type": "select",
            "label": "Default Picking Strategy",
            "default": "fefo"
        },
        {
            "key": "bridge.default_location_id",
            "type": "number",
            "label": "Bridge Default Location ID",
            "default": "0",
            "description": "Optional fallback location used when bridge-triggered reserve/release payloads specify a warehouse but no location."
        }
    ],
