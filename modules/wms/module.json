{
    "id": "wms",
    "name": "Warehouse Management System",
    "version": "2.0.0",
    "description": "ERP-lite warehouse management with movement-ledger accounting, barcode scanning, and ecommerce integration.",
    "author": "Ikabud Kernel Team",
    "routes": true,
    "auth_cookie": "wms_token",
    "auth_owned": {
        "users_table": "wms_users",
        "username_column": "username",
        "email_column": "email",
        "password_column": "password_hash",
        "name_column": "full_name",
        "active_column": "is_active",
        "admin_roles": [
            "admin"
        ],
        "default_admin_role": "admin",
        "requires_named_admin_on_provision": true,
        "blocked_password_hashes": [
            "!wms-bootstrap-password-reset-required!"
        ],
        "touch_updated_at": true
    },
    "owns_tables": [
        "wms_users",
        "wms_password_resets",
        "wms_products",
        "wms_warehouses",
        "wms_locations",
        "wms_batches",
        "wms_stock",
        "wms_stock_movements",
        "wms_inventory_adjustments",
        "wms_idempotency_keys",
        "wms_deliveries",
        "wms_delivery_items",
        "wms_orders",
        "wms_order_items",
        "wms_picklists",
        "wms_picklist_items",
        "wms_shipments",
        "wms_putaway_rules",
        "wms_cycle_counts",
        "wms_cycle_count_items",
        "wms_suppliers",
        "wms_returns",
        "wms_return_items",
        "wms_tasks",
        "wms_recipes",
        "wms_recipe_ingredients",
        "wms_production_orders",
        "wms_production_order_items",
        "wms_configs",
        "wms_event_webhooks"
    ],
    "co_owns_tables": [
        "audit_logs",
        "rate_limits"
    ],
    "reads_tables": [],
    "reads_tables_deprecated": [],
    "migrations": [
        "database/migrations/001_wms_core_schema.sql",
        "database/migrations/002_wms_password_resets.sql",
        "database/migrations/003_wms_bootstrap_admin.sql",
        "database/migrations/004_wms_catalog.sql",
        "database/migrations/005_wms_movement_ledger.sql",
        "database/migrations/006_wms_inbound_outbound.sql",
        "database/migrations/007_wms_advanced_ops.sql"
    ],
    "capabilities": {
        "exposes": [
            {
                "id": "kernel.auth.authenticate@1",
                "priority": 560,
                "mode": "pipeline",
                "policy": {
                    "allow_callers": [
                        "wms",
                        "kernel"
                    ]
                }
            },
            {
                "id": "wms.stock.query@1",
                "priority": 50,
                "mode": "first",
                "policy": {
                    "allow_callers": [
                        "wms",
                        "ecommerce",
                        "kernel"
                    ]
                }
            },
            {
                "id": "wms.stock.reserve@1",
                "priority": 50,
                "mode": "first",
                "policy": {
                    "allow_callers": [
                        "wms",
                        "ecommerce",
                        "kernel"
                    ]
                }
            },
            {
                "id": "wms.stock.release@1",
                "priority": 50,
                "mode": "first",
                "policy": {
                    "allow_callers": [
                        "wms",
                        "ecommerce",
                        "kernel"
                    ]
                }
            },
            {
                "id": "wms.order.create@1",
                "priority": 50,
                "mode": "first",
                "policy": {
                    "allow_callers": [
                        "wms",
                        "ecommerce",
                        "kernel"
                    ]
                }
            },
            {
                "id": "wms.order.cancel@1",
                "priority": 50,
                "mode": "first",
                "policy": {
                    "allow_callers": [
                        "wms",
                        "ecommerce",
                        "kernel"
                    ]
                }
            }
        ],
        "depends": [
            "kernel.audit.record@1",
            "kernel.auth.user@1"
        ]
    },
    "events": {
        "emits": [
            "wms.stock.low",
            "wms.stock.movement.created",
            "wms.order.picked",
            "wms.order.dispatched",
            "wms.order.delivered",
            "wms.order.payment_collected",
            "wms.production.completed",
            "wms.delivery.received",
            "wms.cycle_count.completed",
            "wms.return.restocked"
        ]
    },
    "settings_fields": [
        {
            "key": "warehouse_name",
            "label": "Default Warehouse Name",
            "type": "text",
            "default": "Main Warehouse",
            "description": "Name for the default warehouse created during onboarding."
        },
        {
            "key": "picking_strategy",
            "label": "Default Picking Strategy",
            "type": "select",
            "default": "fifo",
            "options": [
                {
                    "value": "fifo",
                    "label": "FIFO (First In, First Out)"
                },
                {
                    "value": "fefo",
                    "label": "FEFO (First Expired, First Out)"
                },
                {
                    "value": "lifo",
                    "label": "LIFO (Last In, First Out)"
                }
            ],
            "description": "Default strategy for pick-list generation."
        },
        {
            "key": "allow_negative_stock",
            "label": "Allow Negative Stock",
            "type": "select",
            "default": "0",
            "options": [
                {
                    "value": "0",
                    "label": "No — block under-picking"
                },
                {
                    "value": "1",
                    "label": "Yes — allow negative balances"
                }
            ],
            "description": "Whether to permit stock to go negative during picking."
        },
        {
            "key": "auto_replenish_enabled",
            "label": "Auto-Replenishment",
            "type": "select",
            "default": "1",
            "options": [
                {
                    "value": "1",
                    "label": "Enabled"
                },
                {
                    "value": "0",
                    "label": "Disabled"
                }
            ],
            "description": "Automatically generate replenishment tasks when stock falls below reorder point."
        },
        {
            "key": "bridge.default_location_id",
            "label": "Bridge Default Location",
            "type": "number",
            "default": "",
            "description": "Fallback location ID for bridge-triggered reserve/release calls."
        }
    ],
    "nav": [
        {
            "label": "Dashboard",
            "path": "/wms",
            "roles": [
                "admin",
                "supervisor",
                "viewer"
            ],
            "icon": "dashboard"
        },
        {
            "label": "Receiving",
            "path": "/wms/receiving",
            "roles": [
                "admin",
                "supervisor"
            ],
            "icon": "inbox"
        },
        {
            "label": "Picking",
            "path": "/wms/picking",
            "roles": [
                "admin",
                "supervisor",
                "viewer"
            ],
            "icon": "package"
        },
        {
            "label": "Inventory",
            "path": "/wms/inventory",
            "roles": [
                "admin",
                "supervisor",
                "viewer"
            ],
            "icon": "warehouse"
        },
        {
            "label": "Suppliers",
            "path": "/wms/suppliers",
            "roles": [
                "admin",
                "supervisor"
            ],
            "icon": "truck"
        },
        {
            "label": "Returns",
            "path": "/wms/returns",
            "roles": [
                "admin",
                "supervisor"
            ],
            "icon": "rotate-ccw"
        },
        {
            "label": "Tasks",
            "path": "/wms/tasks",
            "roles": [
                "admin",
                "supervisor",
                "viewer"
            ],
            "icon": "check-square"
        },
        {
            "label": "Scanner",
            "path": "/wms/scanner",
            "roles": [
                "admin",
                "supervisor"
            ],
            "icon": "scan"
        },
        {
            "label": "Settings",
            "path": "/wms/settings",
            "roles": [
                "admin"
            ],
            "icon": "settings"
        },
        {
            "label": "Users",
            "path": "/wms/users",
            "roles": [
                "admin"
            ],
            "icon": "users"
        }
    ]
}