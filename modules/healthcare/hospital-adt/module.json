{
    "id": "hospital-adt",
    "name": "Hospital ADT",
    "version": "0.1.0",
    "description": "Admission, discharge, and transfer (ADT) workflow with wards, beds, and inpatient encounter context.",
    "author": "Ikabud Platform Team",
    "owns_tables": [
        "ehr_wards",
        "ehr_beds",
        "ehr_admissions",
        "ehr_adt_events"
    ],
    "reads_tables": [],
    "migrations": [
        "database/migrations/001_initial.sql"
    ],
    "capabilities": {
        "exposes": [
            {
                "id": "ehr.adt.ward.list@1",
                "priority": 100,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "ehr.adt.bed.list@1",
                "priority": 100,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "ehr.adt.admit@1",
                "priority": 100,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "ehr.adt.transfer@1",
                "priority": 100,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "ehr.adt.discharge@1",
                "priority": 100,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "ehr.adt.admission.view@1",
                "priority": 100,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "ehr.adt.admission.list@1",
                "priority": 100,
                "modes": [
                    "first"
                ]
            }
        ],
        "depends": [
            "kernel.audit.record@1",
            "ehr.patient.view@1"
        ],
        "policy": {
            "capabilities": {
                "ehr.adt.ward.list@1": {
                    "allow_callers": [
                        "hospital-adt",
                        "ehr"
                    ]
                },
                "ehr.adt.bed.list@1": {
                    "allow_callers": [
                        "hospital-adt",
                        "ehr"
                    ]
                },
                "ehr.adt.admit@1": {
                    "allow_callers": [
                        "hospital-adt"
                    ]
                },
                "ehr.adt.transfer@1": {
                    "allow_callers": [
                        "hospital-adt"
                    ]
                },
                "ehr.adt.discharge@1": {
                    "allow_callers": [
                        "hospital-adt"
                    ]
                },
                "ehr.adt.admission.view@1": {
                    "allow_callers": [
                        "hospital-adt",
                        "ehr",
                        "patient-portal",
                        "billing-bridge"
                    ]
                },
                "ehr.adt.admission.list@1": {
                    "allow_callers": [
                        "hospital-adt",
                        "ehr",
                        "patient-portal",
                        "billing-bridge"
                    ]
                }
            }
        }
    },
    "nav": [
        {
            "key": "ehr_hospital_adt",
            "label": "Admissions & Beds",
            "url": "/admin/ehr/adt",
            "icon": "bed",
            "roles": [
                "admin"
            ],
            "description": "Manage admissions, transfers, and discharges across wards and beds",
            "order": 100
        }
    ],
    "events": [
        "ehr.adt.admitted",
        "ehr.adt.transferred",
        "ehr.adt.discharged"
    ]
}
