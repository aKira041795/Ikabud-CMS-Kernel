    "invariants": [
        {
            "id": "patient-record-authority",
            "severity": "critical",
            "scope": "capability",
            "description": "Patient records are disclosed only when the active tenant and actor possess the required patient-view capability."
        },
        {
            "id": "clinical-privacy-no-cross-tenant-data",
            "severity": "critical",
            "scope": "tenancy",
            "description": "Search, chart, logs, errors, exports, and cached views never disclose another tenant's clinical data."
        },
        {
            "id": "navigation-routes-resolve",
            "severity": "critical",
            "scope": "navigation",
            "description": "Every declared internal navigation URL resolves to an owned or explicitly allowed GET route."
        }
