                    ]
                },
                "ehr.appointment.view@1": {
                    "allow_callers": [
                        "scheduling",
                        "patient-portal"
                    ]
                },
                "ehr.appointment.list@1": {
                    "allow_callers": [
                        "scheduling",
                        "patient-portal",
                        "ehr"
                    ]
                },
                "ehr.appointment.update@1": {
                    "allow_callers": [
                        "scheduling"
                    ]
                },
                "ehr.appointment.transition@1": {
                    "allow_callers": [
                        "scheduling"
                    ]
                }
            }
        }
    },
    "nav": [
        {
            "key": "ehr_scheduling",
            "label": "Appointments",
            "url": "/admin/ehr/appointments",
            "icon": "calendar",
            "roles": [
                "admin"
            ],
            "description": "Start the day with the appointment and queue worklist",
            "order": 15
        }
    ],
    "events": [
        "ehr.appointment.scheduled",
        "ehr.appointment.updated"
    ]
