{
    "id": "documents",
    "name": "Documents",
    "version": "0.1.0",
    "description": "Patient and encounter linked document metadata, access restrictions, and audit trail registration.",
    "author": "Ikabud Platform Team",
    "owns_tables": [
        "ehr_documents",
        "ehr_access_policies"
    ],
    "reads_tables": [],
    "migrations": [
        "database/migrations/001_initial.sql"
    ],
    "capabilities": {
        "exposes": [
            {
                "id": "ehr.document.upload@1",
                "priority": 100,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "ehr.document.view@1",
                "priority": 100,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "ehr.document.print@1",
                "priority": 100,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "ehr.document.export@1",
                "priority": 100,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "ehr.document.restrict@1",
                "priority": 100,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "ehr.document.list@1",
                "priority": 100,
                "modes": [
                    "first"
                ]
            }
        ],
        "depends": [
            "kernel.audit.record@1",
            "ehr.patient.view@1",
            "ehr.patient.search@1",
            "ehr.encounter.view@1",
            "ehr.encounter.list@1",
            "ehr.consent.active@1",
            "ehr.break_glass.active@1"
        ],
        "policy": {
            "capabilities": {
                "ehr.document.upload@1": {
                    "allow_callers": [
                        "documents",
                        "clinical-notes",
                        "results"
                    ]
                },
                "ehr.document.view@1": {
                    "allow_callers": [
                        "documents",
                        "clinical-notes",
                        "results",
                        "patient-portal"
                    ]
                },
                "ehr.document.print@1": {
                    "allow_callers": [
                        "documents",
                        "clinical-notes",
                        "results",
                        "patient-portal"
                    ]
                },
                "ehr.document.export@1": {
                    "allow_callers": [
                        "documents",
                        "clinical-notes",
                        "results",
                        "patient-portal"
                    ]
                },
                "ehr.document.restrict@1": {
                    "allow_callers": [
                        "documents",
                        "privacy-consent"
                    ]
                },
                "ehr.document.list@1": {
                    "allow_callers": [
                        "documents",
                        "clinical-notes",
                        "results",
                        "patient-portal",
                        "ehr"
                    ]
                }
            }
        }
    },
    "nav": [
        {
            "key": "ehr_documents",
            "label": "Patient Documents",
            "url": "/admin/ehr/documents",
            "icon": "folder",
            "roles": [
                "admin"
            ],
            "description": "Browse uploaded files and document access policies",
            "order": 80
        }
    ],
    "routes": true,
    "events": [
        "ehr.document.uploaded",
        "ehr.document.viewed",
        "ehr.document.access_denied",
        "ehr.document.printed",
        "ehr.document.exported",
        "ehr.document.restricted"
    ]
}
