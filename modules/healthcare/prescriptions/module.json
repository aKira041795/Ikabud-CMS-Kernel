            {
                "id": "ehr.prescription.issue@1",
                "priority": 100,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "ehr.prescription.view@1",
                "priority": 100,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "ehr.prescription.cancel@1",
                "priority": 100,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "ehr.prescription.list@1",
                "priority": 100,
                "modes": [
                    "first"
                ]
            }
        ],
        "depends": [
            "kernel.audit.record@1",
            "ehr.core.status.catalog@1",
            "ehr.patient.view@1",
            "ehr.patient.search@1",
            "ehr.encounter.view@1",
            "ehr.encounter.list@1"
        ],
        "policy": {
            "capabilities": {
                "ehr.prescription.issue@1": {
                    "allow_callers": [
                        "prescriptions",
                        "clinical-notes"
                    ]
                },
                "ehr.prescription.view@1": {
                    "allow_callers": [
                        "prescriptions",
                        "clinical-notes",
                        "patient-portal"
                    ]
                },
                "ehr.prescription.cancel@1": {
                    "allow_callers": [
                        "prescriptions",
                        "clinical-notes"
                    ]
                },
                "ehr.prescription.list@1": {
                    "allow_callers": [
                        "prescriptions",
                        "clinical-notes",
                        "patient-portal"
                    ]
                }
            }
        }
    },
    "events": [
        "ehr.prescription.issued",
        "ehr.prescription.canceled"
    ]
}