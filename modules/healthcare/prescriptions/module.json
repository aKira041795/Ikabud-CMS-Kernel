{
    "id": "prescriptions",
    "name": "Prescriptions",
    "version": "0.1.0",
    "description": "Encounter-linked prescription issuance and cancellation with patient and prescriber traceability.",
    "author": "Ikabud Platform Team",
    "owns_tables": [
        "ehr_prescriptions"
    ],
    "nav": [
        {
            "key": "ehr_prescriptions",
            "label": "Prescriptions",
            "url": "/admin/ehr/prescriptions",
            "icon": "pill",
            "roles": [
                "admin"
            ],
            "description": "Follow active and canceled medication orders",
            "order": 70
        }
    ],
    "reads_tables": [],
