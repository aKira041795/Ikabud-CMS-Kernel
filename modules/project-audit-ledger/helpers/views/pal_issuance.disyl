{ikb_entity_view name="pal_issuance" view="table"}
    {field name="issuance_number" type="string"}
    {field name="project_title" type="string"}
    {field name="item_count" type="number"}
    {field name="status" type="enum" renderer="badge:{draft|gray|submitted|blue|partially_issued|amber|fully_issued|green|approved|green|cancelled|red}"}
    {field name="id" type="number" visible="false"}
    {field name="created_at" type="date" renderer="datetime:date"}
    {action name="view" url="/admin/project-audit-ledger/material-issuance/{id}" label="View"}
{/ikb_entity_view}
