{ikb_entity_view name="pal_collection" view="table"}
    {field name="collection_number" type="string"}
    {field name="project_title" type="string"}
    {field name="client_name" type="string"}
    {field name="amount" type="number" renderer="money:2"}
    {field name="payment_method" type="string"}
    {field name="status" type="enum" renderer="badge:{pending|amber|approved|green|rejected|red}"}
    {field name="payment_date" type="date" renderer="datetime:date"}
    {action name="view" url="/admin/project-audit-ledger/collections/{id}" label="View"}
{/ikb_entity_view}

{ikb_entity_view name="pal_collection" view="compact"}
    {field name="collection_number" type="string"}
    {field name="client_name" type="string"}
    {field name="amount" type="number" renderer="money:2"}
    {field name="status" type="enum" renderer="badge:{pending|amber|approved|green}"}
{/ikb_entity_view}
