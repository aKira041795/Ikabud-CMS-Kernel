{ikb_entity_view name="pal_mobilization" view="table"}
    {field name="id" type="number" visible="false"}
    {field name="team_lead_name" type="string"}
    {field name="job_order_number" type="string"}
    {field name="project_title" type="string"}
    {field name="amount" type="number" renderer="money:2"}
    {field name="purpose" type="string"}
    {field name="status" type="enum" renderer="badge:{pending|amber|approved|green|rejected|red|disbursed|blue|voided|gray}"}
    {field name="request_date" type="date" renderer="datetime:date"}
    {action name="view" url="/admin/project-audit-ledger/mobilization/{id}" label="View"}
{/ikb_entity_view}
