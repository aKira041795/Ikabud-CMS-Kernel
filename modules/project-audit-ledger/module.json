        "database/migrations/001_pal_core_schema.sql",
        "database/migrations/002_pal_users.sql",
        "database/migrations/003_pal_password_resets.sql",
        "database/migrations/004_pal_fabrication_remove_unique.sql",
        "database/migrations/005_pal_purchases_add_project_id.sql",
