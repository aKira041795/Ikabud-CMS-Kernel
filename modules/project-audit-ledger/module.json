    "settings_fields": [
        {
            "key": "company_name",
            "type": "text",
            "label": "Company Name",
            "default": "My Company",
            "description": "Business name displayed on reports, headers, and exports."
        },
        {
            "key": "company_address",
            "type": "text",
            "label": "Company Address",
            "default": "",
            "description": "Business address displayed on report headers."
        },
        {
            "key": "company_contact",
            "type": "text",
            "label": "Contact Number",
            "default": "",
            "description": "Business contact number displayed on reports."
        },
        {
            "key": "default_fabrication_pct",
            "type": "number",
            "label": "Default Fabrication Allocation (%)",
            "default": "25",
            "description": "Default percentage used for fabrication allocation calculations."
        },
        {
            "key": "default_fabrication_basis",
            "type": "select",
            "label": "Default Fabrication Basis",
            "default": "expenses",
            "description": "Default calculation basis for fabrication allocation.",
            "options": [
                {
                    "label": "Total Project Expenses",
                    "value": "expenses"
                },
                {
                    "label": "Labor + Materials",
                    "value": "labor_materials"
                },
                {
                    "label": "Contract Amount",
                    "value": "contract"
                },
                {
                    "label": "Fixed Amount",
                    "value": "fixed"
                }
            ]
        },
        {
            "key": "budget_warning_pct",
            "type": "number",
            "label": "Budget Warning Threshold (%)",
            "default": "80",
            "description": "Percentage of contract amount at which the system warns the project is near budget."
        },
        {
            "key": "currency_symbol",
            "type": "text",
            "label": "Currency Symbol",
            "default": "\u20b1",
            "description": "Currency symbol used in monetary displays."
        },
        {
            "key": "allow_self_approval",
            "type": "select",
            "label": "Allow Self-Approval",
            "default": "0",
            "description": "If enabled, users can approve their own submitted entries.",
            "options": [
                {
                    "label": "Disabled",
                    "value": "0"
                },
                {
                    "label": "Enabled",
                    "value": "1"
                }
            ]
        }
    ],
