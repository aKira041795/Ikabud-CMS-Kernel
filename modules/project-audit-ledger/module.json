{
    "id": "project-audit-ledger",
    "name": "Project Audit Ledger",
    "version": "1.0.0",
    "description": "Project costing, inventory, fabrication dues, sales, and audit management for construction, fabrication, signage, and installation businesses.",
    "author": "Ikabud Kernel Team",
    "auth_owned": {
        "users_table": "pal_users",
        "username_column": "username",
        "email_column": "email",
        "password_column": "password_hash",
        "name_column": "full_name",
        "active_column": "is_active",
        "admin_roles": [
            "admin"
        ],
        "default_admin_role": "admin",
        "requires_named_admin_on_provision": true,
        "touch_updated_at": true
    },
    "owns_tables": [
        "pal_users",
        "pal_password_resets",
