<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Code — Project Audit Ledger</title>
<link rel="stylesheet" href="/assets/workbench/workbench-tailwind.css?v=4">
<link rel="stylesheet" href="/assets/workbench/workbench.css?v=4">
</head>
<body class="wb-auth-page min-h-screen flex items-center justify-center p-4">
    <div class="max-w-md w-full p-8">
        <div class="text-center mb-8">
            <h1 class="text-2xl font-bold text-gray-900">ZAP-ARTS</h1>
            <p class="text-sm text-gray-600">Team Lead Portal</p>
        </div>

        <div class="wb-auth-card p-6">
            <h2 class="font-semibold text-gray-900 mb-2">Enter verification code</h2>
            <p class="text-xs text-gray-600 mb-1">A 6-digit code was sent to:</p>
            <p class="text-sm font-medium text-gray-800 mb-4" id="masked-email">{masked_email|default:''}</p>

            <form onsubmit="return verifyOtp(this)" class="space-y-4">
                {csrf_field | raw}
                <input type="hidden" name="ticket" value="{ticket}" id="otp-ticket">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Verification Code</label>
                    <input type="text" name="code" required maxlength="6" inputmode="numeric" pattern="[0-9]*"
                           autocomplete="one-time-code"
                           placeholder="000000"
                           class="w-full px-3 py-3 border border-gray-300 rounded text-sm text-center text-2xl tracking-[8px] font-mono"
                           id="otp-code"
                           oninput="this.value=this.value.replace(/[^0-9]/g,'');if(this.value.length>=6)this.form.submit()">
                </div>
                <button type="submit" id="tl-verify-btn" class="wb-btn wb-btn--primary wb-btn--lg" style="width:100%">
                    Verify & Sign In
                </button>
            </form>

            <div class="mt-4 text-center">
                <button onclick="resendOtp()" class="wb-auth-link text-sm" id="resend-btn">Resend Code</button>
                <span id="resend-timer" class="text-xs text-gray-500 ml-2"></span>
            </div>
            <div class="mt-2 text-center">
                <a href="/project-audit-ledger/team-lead/login" class="wb-auth-link text-xs">Use a different email</a>
            </div>
        </div>
    </div>

    <script src="/assets/workbench/workbench-core.js?v=3"></script>
    <script>
    function verifyOtp(form) {
        var btn = document.getElementById('tl-verify-btn');
        btn.disabled = true;
        btn.textContent = 'Verifying...';

        var formData = new FormData(form);
        fetch('/api/v1/project-audit-ledger/tl/otp-verify', { method: 'POST', body: formData })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.ok) {
                window.location.href = d.redirect || '/admin/project-audit-ledger/team-lead';
            } else {
                btn.disabled = false;
                btn.textContent = 'Verify & Sign In';
                alert(d.error || 'Invalid code.');
            }
        })
        .catch(function() {
            btn.disabled = false;
            btn.textContent = 'Verify & Sign In';
            alert('Verification failed.');
        });
        return false;
    }

    function resendOtp() {
        var btn = document.getElementById('resend-btn');
        btn.disabled = true;
        btn.textContent = 'Sending...';

        var formData = new FormData();
        formData.append('ticket', document.getElementById('otp-ticket').value);

        fetch('/api/v1/project-audit-ledger/tl/otp-resend', { method: 'POST', body: formData })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.ok) {
                document.getElementById('otp-ticket').value = d.ticket;
                if (d.masked_email) document.getElementById('masked-email').textContent = d.masked_email;
                btn.textContent = 'Code Sent!';
                startResendTimer(60);
            } else {
                btn.disabled = false;
                btn.textContent = 'Resend Code';
                alert(d.error || 'Failed to resend.');
            }
        })
        .catch(function() {
            btn.disabled = false;
            btn.textContent = 'Resend Code';
            alert('Failed to resend.');
        });
    }

    function startResendTimer(seconds) {
        var timer = document.getElementById('resend-timer');
        var btn = document.getElementById('resend-btn');
        var remaining = seconds;
        timer.textContent = '(' + remaining + 's)';
        var interval = setInterval(function() {
            remaining--;
            if (remaining <= 0) {
                clearInterval(interval);
                timer.textContent = '';
                btn.disabled = false;
                btn.textContent = 'Resend Code';
            } else {
                timer.textContent = '(' + remaining + 's)';
            }
        }, 1000);
    }

    // Focus code input on load
    document.addEventListener('DOMContentLoaded', function() {
        var input = document.getElementById('otp-code');
        if (input) input.focus();
    });
    </script>
</body>
</html>
