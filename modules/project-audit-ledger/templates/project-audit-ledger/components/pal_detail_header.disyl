{* pal_detail_header — delegates to workbench:detail_header. *}
{include "workbench:detail_header"
    title=_dh_title|default:''
    subtitle=_dh_subtitle|default:''
    status_badge=_dh_status|default:''
    metrics=[
        {if _dh_amount|default:0 > 0}
            ['label' => 'Total', 'value' => '₱' ~ (_dh_amount|number_format:2)],
            {if _dh_collected|default:null !== null}['label' => 'Collected', 'value' => '₱' ~ (_dh_collected|number_format:2)],{/if}
            {if _dh_outstanding|default:null !== null}['label' => 'Outstanding', 'value' => '₱' ~ (_dh_outstanding|number_format:2)],{/if}
            {if _dh_target_date|default:''}['label' => 'Target', 'value' => _dh_target_date]{/if}
        {/if}
    ]
    actions=_dh_actions|default:''
}
