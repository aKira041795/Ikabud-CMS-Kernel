{* pal_status_badge — Colored status badge.
   Pass: _sb_status (string: draft|pending|approved|started|ongoing|completed|paid|overdue|rejected|cancelled) *}
{set s = _sb_status|default:''}
<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
    {if s=='draft'}bg-gray-100 text-gray-700
    {elseif s=='pending'}bg-yellow-100 text-yellow-800
    {elseif s=='approved'}bg-green-100 text-green-800
    {elseif s=='started'}bg-blue-100 text-blue-800
    {elseif s=='ongoing'}bg-indigo-100 text-indigo-800
    {elseif s=='completed'}bg-teal-100 text-teal-800
    {elseif s=='paid'}bg-green-100 text-green-800
    {elseif s=='overdue'}bg-red-100 text-red-800
    {elseif s=='rejected'}bg-red-100 text-red-700
    {elseif s=='cancelled'}bg-gray-200 text-gray-600
    {else}bg-gray-100 text-gray-700{/if}">
    {s|capitalize}
</span>
