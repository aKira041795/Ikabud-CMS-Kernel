<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title} — Team Lead Portal</title>
    <link rel="stylesheet" href="/assets/workbench/workbench.css?v=2">
    <link rel="stylesheet" href="/assets/workbench/workbench-tailwind.css?v=1">
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="wb-app-shell">
    {csrf_field | raw}
    <!-- Mobile sidebar toggle -->
    <button id="wb-menu-btn" class="md:hidden fixed top-3 left-3 z-50 p-2 bg-slate-900 text-white rounded-lg shadow-lg" aria-label="Open menu" aria-expanded="false">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <!-- Mobile overlay -->
    <div id="wb-overlay" class="wb-app-shell__overlay" aria-hidden="true"></div>

    <aside id="wb-sidebar" class="wb-app-shell__sidebar">
        <div class="p-4 border-b border-slate-700">
            <h1 class="text-lg font-bold text-white">ZAP-ARTS</h1>
            <p class="text-xs text-slate-400">Team Lead Portal</p>
            <p class="text-xs text-slate-500 mt-1">{tl.name|default:''}</p>
        </div>
        <nav class="flex-1 overflow-y-auto p-2 space-y-1">
            <a href="/admin/project-audit-ledger/team-lead" class="wb-nav-item {if page_content=='team-lead-dashboard'}is-active{/if}">📊 Dashboard</a>
            <a href="/admin/project-audit-ledger/team-lead/fabrication" class="wb-nav-item {if page_content=='team-lead-fabrication'}is-active{/if}">🔧 My Fabrications</a>
            <a href="/admin/project-audit-ledger/team-lead/cash-advances" class="wb-nav-item {if page_content=='team-lead-cash-advances'}is-active{/if}">💵 Cash Advances</a>
            <a href="/admin/project-audit-ledger/team-lead/mobilization" class="wb-nav-item {if page_content=='team-lead-mobilization'}is-active{/if}">🚛 Mobilization</a>
            <a href="/admin/project-audit-ledger/team-lead/attendance" class="wb-nav-item {if page_content=='team-lead-attendance'}is-active{/if}">👥 Attendance</a>
        </nav>
        <div class="p-4 border-t border-slate-700">
            <form method="POST" action="/api/v1/project-audit-ledger/tl/logout">
                <button type="submit" class="wb-nav-item" style="color:var(--wb-text-muted)">Sign Out</button>
            </form>
        </div>
    </aside>

    <main class="wb-app-shell__main" id="wb-main">
        <h1 class="wb-page-header__title mb-6">{page_title}</h1>
        {page_body|raw}
    </main>

    <!-- Mobile bottom nav -->
    <nav class="wb-bottom-nav">
        <a href="/admin/project-audit-ledger/team-lead" class="wb-bottom-nav__item {if page_content=='team-lead-dashboard'}is-active{/if}"><span class="text-lg">📊</span><span>Home</span></a>
        <a href="/admin/project-audit-ledger/team-lead/fabrication" class="wb-bottom-nav__item {if page_content=='team-lead-fabrication'}is-active{/if}"><span class="text-lg">🔧</span><span>Fab</span></a>
        <a href="/admin/project-audit-ledger/team-lead/attendance" class="wb-bottom-nav__item {if page_content=='team-lead-attendance'}is-active{/if}"><span class="text-lg">👥</span><span>Attend</span></a>
        <a href="/admin/project-audit-ledger/team-lead/cash-advances" class="wb-bottom-nav__item {if page_content=='team-lead-cash-advances'}is-active{/if}"><span class="text-lg">💵</span><span>Cash</span></a>
        <button onclick="toggleMobileSidebar()" class="wb-bottom-nav__item"><span class="text-lg">☰</span><span>Menu</span></button>
    </nav>

    <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2" role="status" aria-live="polite" aria-atomic="false"></div>
    <script src="/assets/pal/pal-core.js?v=1"></script>
    <script src="/assets/pal/pal-forms.js?v=1"></script>
</body>
</html>