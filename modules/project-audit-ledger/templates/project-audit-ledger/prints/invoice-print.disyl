<div class="print-only" style="font-family: Arial, sans-serif; max-width: 210mm; margin: 0 auto; padding: 20px; color: #333;">
    <!-- Header: Logo + Company Info -->
    <div style="display: flex; align-items: flex-start; justify-content: space-between; border-bottom: 2px solid #1e40af; padding-bottom: 15px; margin-bottom: 20px;">
        <div style="display: flex; align-items: center; gap: 15px;">
            {if settings.logo_path}
            <img src="/{settings.logo_path}" style="max-height: 70px; max-width: 120px; object-fit: contain;">
            {/if}
            <div>
                <h1 style="margin: 0; font-size: 22px; color: #1e40af;">SALES INVOICE</h1>
                <p style="margin: 2px 0; font-size: 14px; font-weight: bold; color: #333;">{settings.company_name|default:'ZAP-ARTS Signage & Printing Solutions'}</p>
                {if settings.company_address}<p style="margin: 2px 0; font-size: 11px; color: #666;">{settings.company_address}</p>{/if}
                <p style="margin: 2px 0; font-size: 11px; color: #666;">
                    {if settings.company_phone}Phone: {settings.company_phone}{/if}
                    {if settings.company_phone && settings.company_email} | {/if}
                    {if settings.company_email}{settings.company_email}{/if}
                </p>
            </div>
        </div>
        <div style="text-align: right; min-width: 200px;">
            <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 6px; padding: 10px 14px;">
                <p style="margin: 1px 0; font-size: 12px;"><strong>Invoice #:</strong> {sale.sales_number|default:sale.id}</p>
                <p style="margin: 1px 0; font-size: 12px;"><strong>Date:</strong> {sale.sales_date|default:sale.created_at}</p>
                <p style="margin: 1px 0; font-size: 12px;"><strong>Due Date:</strong> {sale.due_date|default:'Upon Receipt'}</p>
                {if sale.invoice_number}<p style="margin: 1px 0; font-size: 12px;"><strong>Ref #:</strong> {sale.invoice_number}</p>{/if}
            </div>
        </div>
    </div>

    <!-- Bill To + Project Info -->
    <table style="width: 100%; font-size: 12px; margin-bottom: 20px;">
        <tr>
            <td style="width: 55%; vertical-align: top;">
                <div style="background: #f9fafb; padding: 10px 12px; border-radius: 4px; border: 1px solid #e5e7eb;">
                    <p style="margin: 0 0 4px 0; font-size: 11px; font-weight: bold; color: #6b7280; text-transform: uppercase;">Bill To</p>
                    <p style="margin: 2px 0;"><strong>{sale.client_name|default:'—'}</strong></p>
                    <p style="margin: 2px 0;"><strong>Project:</strong> {sale.project_title|default:'—'}</p>
                    {if sale.scope_of_work}
                    <p style="margin: 2px 0;"><strong>Scope:</strong> {sale.scope_of_work|replace:'_':' '|capitalize}</p>
                    {/if}
                    {if sale.mode_of_payment}
                    <p style="margin: 2px 0;"><strong>Payment:</strong> {sale.mode_of_payment|replace:'_':' '|capitalize}</p>
                    {/if}
                </div>
            </td>
            <td style="width: 45%; vertical-align: top;">
                <div style="background: #f9fafb; padding: 10px 12px; border-radius: 4px; border: 1px solid #e5e7eb;">
                    <p style="margin: 0 0 4px 0; font-size: 11px; font-weight: bold; color: #6b7280; text-transform: uppercase;">Payment Details</p>
                    <p style="margin: 2px 0;"><strong>Status:</strong> {sale.status|default:'draft'|replace:'_':' '|capitalize}</p>
                    <p style="margin: 2px 0;"><strong>Outstanding:</strong> ₱{sale.outstanding|default:0|number_format:2}</p>
                    {if sale.down_payment}
                    <p style="margin: 2px 0;"><strong>Down Payment:</strong> ₱{sale.down_payment|number_format:2}</p>
                    {/if}
                </div>
            </td>
        </tr>
    </table>

    <!-- Line Items -->
    {if sale.items && sale.items|count > 0}
    <table style="width: 100%; border-collapse: collapse; font-size: 11px; margin-bottom: 15px;">
        <thead>
            <tr style="background-color: #1e40af; color: #fff;">
                <th style="padding: 7px 10px; text-align: left; border: 1px solid #1e40af;">#</th>
                <th style="padding: 7px 10px; text-align: left; border: 1px solid #1e40af;">Particulars</th>
                <th style="padding: 7px 10px; text-align: center; border: 1px solid #1e40af;">Width</th>
                <th style="padding: 7px 10px; text-align: center; border: 1px solid #1e40af;">Height</th>
                <th style="padding: 7px 10px; text-align: center; border: 1px solid #1e40af;">Unit</th>
                <th style="padding: 7px 10px; text-align: center; border: 1px solid #1e40af;">QTY</th>
                <th style="padding: 7px 10px; text-align: right; border: 1px solid #1e40af;">Unit Price</th>
                <th style="padding: 7px 10px; text-align: right; border: 1px solid #1e40af;">SqFt Price</th>
                <th style="padding: 7px 10px; text-align: right; border: 1px solid #1e40af;">Total</th>
            </tr>
        </thead>
        <tbody>
            {for item in sale.items}
            <tr style="border-bottom: 1px solid #e5e7eb;">
                <td style="padding: 5px 10px; border: 1px solid #e5e7eb; text-align: center;">{item.sort_order|default:item_index+1}</td>
                <td style="padding: 5px 10px; border: 1px solid #e5e7eb;">{item.particulars}{if item.material_name} <span style="color: #6b7280; font-size: 10px;">({item.material_name})</span>{/if}</td>
                <td style="padding: 5px 10px; border: 1px solid #e5e7eb; text-align: center;">{item.width|default:'—'}</td>
                <td style="padding: 5px 10px; border: 1px solid #e5e7eb; text-align: center;">{item.height|default:'—'}</td>
                <td style="padding: 5px 10px; border: 1px solid #e5e7eb; text-align: center;">{item.uom|default:'—'}</td>
                <td style="padding: 5px 10px; border: 1px solid #e5e7eb; text-align: center;">{item.quantity|default:1}</td>
                <td style="padding: 5px 10px; border: 1px solid #e5e7eb; text-align: right;">{if item.price_per_unit > 0}₱{item.price_per_unit|number_format:2}{else}—{/if}</td>
                <td style="padding: 5px 10px; border: 1px solid #e5e7eb; text-align: right;">{if item.price_per_sqft > 0}₱{item.price_per_sqft|number_format:2}{else}—{/if}</td>
                <td style="padding: 5px 10px; border: 1px solid #e5e7eb; text-align: right; font-weight: bold;">₱{item.line_total|number_format:2}</td>
            </tr>
            {/for}
        </tbody>
    </table>
    {else}
    <p style="text-align: center; color: #9ca3af; font-size: 12px; padding: 20px;">No line items.</p>
    {/if}

    <!-- Totals -->
    <table style="width: 100%; font-size: 12px; margin-bottom: 20px;">
        <tr>
            <td style="width: 50%; vertical-align: top;">
                {if sale.notes}
                <div style="background: #f9fafb; padding: 10px 12px; border-radius: 4px; border: 1px solid #e5e7eb;">
                    <p style="margin: 0 0 4px 0; font-size: 11px; font-weight: bold; color: #6b7280; text-transform: uppercase;">Notes</p>
                    <p style="margin: 2px 0; font-size: 11px;">{sale.notes}</p>
                </div>
                {/if}
            </td>
            <td style="width: 50%; vertical-align: top;">
                <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                    <tr><td style="padding: 4px 10px; text-align: right; color: #6b7280;">Gross Amount:</td><td style="padding: 4px 10px; text-align: right;">₱{sale.gross_amount|number_format:2}</td></tr>
                    {if sale.discount_amount|default:0 > 0}
                    <tr><td style="padding: 4px 10px; text-align: right; color: #6b7280;">Discount:</td><td style="padding: 4px 10px; text-align: right; color: #dc2626;">−₱{sale.discount_amount|number_format:2}</td></tr>
                    {/if}
                    {if sale.tax_amount|default:0 > 0}
                    <tr><td style="padding: 4px 10px; text-align: right; color: #6b7280;">Tax:</td><td style="padding: 4px 10px; text-align: right;">₱{sale.tax_amount|number_format:2}</td></tr>
                    {/if}
                    {if sale.installation_charge|default:0 > 0}
                    <tr><td style="padding: 4px 10px; text-align: right; color: #6b7280;">Installation:</td><td style="padding: 4px 10px; text-align: right;">₱{sale.installation_charge|number_format:2}</td></tr>
                    {/if}
                    {if sale.mobilization_charge|default:0 > 0}
                    <tr><td style="padding: 4px 10px; text-align: right; color: #6b7280;">Mobilization:</td><td style="padding: 4px 10px; text-align: right;">₱{sale.mobilization_charge|number_format:2}</td></tr>
                    {/if}
                    {if sale.other_charges|default:0 > 0}
                    <tr><td style="padding: 4px 10px; text-align: right; color: #6b7280;">Other Charges:</td><td style="padding: 4px 10px; text-align: right;">₱{sale.other_charges|number_format:2}</td></tr>
                    {/if}
                    <tr style="font-weight: bold;">
                        <td style="padding: 6px 10px; text-align: right; font-size: 14px; border-top: 2px solid #1e40af; color: #1e40af;">NET AMOUNT:</td>
                        <td style="padding: 6px 10px; text-align: right; font-size: 14px; border-top: 2px solid #1e40af; color: #1e40af;">₱{sale.net_amount|number_format:2}</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <!-- Signatures -->
    <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #d1d5db; font-size: 11px;">
        <table style="width: 100%;">
            <tr>
                <td style="width: 33%; text-align: center;">
                    <p style="margin-bottom: 40px;">______________________________</p>
                    <p><strong>Prepared By</strong></p>
                </td>
                <td style="width: 33%; text-align: center;">
                    <p style="margin-bottom: 40px;">______________________________</p>
                    <p><strong>Client Signature</strong></p>
                </td>
                <td style="width: 33%; text-align: center;">
                    <p style="margin-bottom: 40px;">______________________________</p>
                    <p><strong>Date Received</strong></p>
                </td>
            </tr>
        </table>
    </div>

    <!-- Footer -->
    <div style="margin-top: 15px; text-align: center; font-size: 10px; color: #9ca3af; border-top: 1px solid #e5e7eb; padding-top: 10px;">
        <p>{settings.company_name|default:'ZAP-ARTS Signage & Printing Solutions'}</p>
        {if settings.company_address}<p>{settings.company_address}</p>{/if}
        {if settings.company_phone || settings.company_email}<p>{if settings.company_phone}Tel: {settings.company_phone}{/if}{if settings.company_phone && settings.company_email} | {/if}{if settings.company_email}Email: {settings.company_email}{/if}</p>{/if}
        {if settings.receipt_footer}<p>{settings.receipt_footer}</p>{/if}
        <p style="margin-top: 4px;">Invoice #{sale.sales_number|default:sale.id} — Status: {sale.status|default:'draft'|replace:'_':' '|capitalize} — Outstanding: ₱{sale.outstanding|default:0|number_format:2}</p>
    </div>
</div>

<style>
    @media print {
        body { margin: 0; padding: 0; }
        .no-print { display: none !important; }
        .print-only { max-width: 100%; }
    }
    @media screen {
        .print-only { border: 1px dashed #ccc; padding: 20px; background: #fff; max-width: 210mm; margin: 0 auto; }
    }
</style>
