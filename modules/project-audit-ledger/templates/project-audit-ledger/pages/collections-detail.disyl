<div class="max-w-lg">
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="font-semibold text-gray-900 mb-2">Collection #{collection.id}</h2>
    <div class="space-y-2 text-sm">
        <div class="flex justify-between"><span class="text-gray-500">Sale</span><span>{collection.sales_number|default:'#'~collection.sales_id}</span></div>
        <div class="flex justify-between"><span class="text-gray-500">Amount</span><span class="font-medium">₱{collection.amount|number_format:2}</span></div>
        <div class="flex justify-between"><span class="text-gray-500">Status</span><span class="font-medium">{collection.status|default:'pending'}</span></div>
        <div class="flex justify-between"><span class="text-gray-500">Date</span><span>{collection.created_at}</span></div>
    </div>
    <div class="mt-4"><a href="/admin/project-audit-ledger/collections" class="px-3 py-1.5 bg-gray-200 text-gray-700 text-sm rounded-lg hover:bg-gray-300">Back</a></div>
</div>
</div>
