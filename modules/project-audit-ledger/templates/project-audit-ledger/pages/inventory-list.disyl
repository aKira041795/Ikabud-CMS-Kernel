<div class="wb-panel">
    <div class="wb-panel__header">
        <span class="wb-panel__title">Inventory</span>
        <div class="wb-toolbar__group">
            <a href="/admin/project-audit-ledger/inventory/movements" class="wb-btn wb-btn--secondary wb-btn--sm">Movements</a>
            <button onclick="document.getElementById('material-form').classList.toggle('hidden')" class="wb-btn wb-btn--primary wb-btn--sm">+ Add Material</button>
        </div>
    </div>
    <div id="material-form" class="hidden p-4 border-b border-gray-200 bg-gray-50">
        <form onsubmit="return ajaxSubmit(this, 'Material created')" action="/api/v1/project-audit-ledger/materials" method="POST" class="grid grid-cols-3 gap-3">
            {csrf_field | raw}
            <div><input type="text" name="name" placeholder="Material name *" required class="wb-input"></div>
            <div><input type="text" name="description" placeholder="e.g. 18ft x 8ft roll" class="wb-input"></div>
            <div><select name="category_id" class="wb-select inv-cat-select" data-creatable="material_category"><option value="">Category</option>{for c in categories}<option value="{c.id}">{c.name}</option>{/for}</select></div>
            <div><select name="unit_id" class="wb-select inv-unit-select" data-creatable="unit"><option value="">Unit</option>{for u in units}<option value="{u.id}">{u.name}{if u.abbreviation} ({u.abbreviation}){/if}</option>{/for}</select></div>
            <div><input type="number" step="0.01" name="reorder_level" placeholder="Reorder level" class="wb-input"></div>
            <div class="col-span-3 flex gap-2"><button type="submit" class="wb-btn wb-btn--primary wb-btn--sm">Create</button><button type="button" onclick="document.getElementById('material-form').classList.add('hidden')" class="wb-btn wb-btn--secondary wb-btn--sm">Cancel</button></div>
        </form>
    </div>
    <div class="wb-panel__body--flush">
        {ikb_entity_list source="pal_material" view="table" use="workbench" sortable="true" search="true" search-placeholder="Search materials..." empty="No materials." /}
    </div>
</div>
