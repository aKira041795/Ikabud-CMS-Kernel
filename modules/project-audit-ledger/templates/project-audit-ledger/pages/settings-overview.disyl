<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="p-4 border-b border-gray-200"><h2 class="font-semibold text-gray-900">General Settings</h2></div>
    <div class="p-6">
        <form onsubmit="return ajaxSubmit(this, 'Settings saved')" action="/api/v1/project-audit-ledger/settings" method="POST" class="space-y-4 max-w-lg" enctype="multipart/form-data">
            {csrf_field | raw}
            <div><label class="block text-sm font-medium text-gray-700 mb-1">App Name</label><input type="text" name="app_name" value="{settings.app_name|default:''}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">App Logo</label>
                <div class="flex items-center gap-3">
                    {if settings.logo_path}<img src="/{settings.logo_path}" class="h-10 w-auto rounded border border-gray-200">{/if}
                    <input type="file" name="logo" accept="image/png,image/jpeg,image/gif,image/svg+xml" class="w-full px-3 py-2 border border-gray-300 rounded text-sm file:mr-3 file:py-1 file:px-3 file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100">
                </div>
                <p class="text-xs text-gray-500 mt-1">Upload PNG, JPG, GIF, or SVG. Replaces current logo.</p>
            </div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Company Name</label><input type="text" name="company_name" value="{settings.company_name|default:''}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Company Address</label><textarea name="company_address" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded text-sm">{settings.company_address|default:''}</textarea></div>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Phone</label><input type="text" name="company_phone" value="{settings.company_phone|default:''}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Email</label><input type="email" name="company_email" value="{settings.company_email|default:''}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            </div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Default Currency</label><select name="currency" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><option value="PHP" {if settings.currency=='PHP'}selected{/if}>PHP (₱)</option><option value="USD" {if settings.currency=='USD'}selected{/if}>USD ($)</option></select></div>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">Save Settings</button>
        </form>
    </div>
</div>
