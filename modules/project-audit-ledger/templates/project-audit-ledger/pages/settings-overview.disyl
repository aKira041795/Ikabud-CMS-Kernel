<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="p-4 border-b border-gray-200"><h2 class="font-semibold text-gray-900">General Settings</h2></div>
    <div class="p-6">
        <form onsubmit="return ajaxSubmit(this, 'Settings saved')" action="/api/v1/project-audit-ledger/settings" method="POST" class="space-y-4 max-w-lg">
            {csrf_field | raw}
            <div><label class="block text-sm font-medium text-gray-700 mb-1">App Name</label><input type="text" name="app_name" value="{settings.pal_app_name|default:''}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">App Logo URL</label><input type="text" name="logo_path" value="{settings.pal_logo_path|default:''}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Company Name</label><input type="text" name="company_name" value="{settings.pal_company_name|default:''}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Company Address</label><textarea name="company_address" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded text-sm">{settings.pal_company_address|default:''}</textarea></div>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Phone</label><input type="text" name="company_phone" value="{settings.pal_company_phone|default:''}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Email</label><input type="email" name="company_email" value="{settings.pal_company_email|default:''}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            </div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Default Currency</label><select name="currency" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><option value="PHP" {if settings.pal_currency=='PHP'}selected{/if}>PHP (₱)</option><option value="USD" {if settings.pal_currency=='USD'}selected{/if}>USD ($)</option></select></div>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">Save Settings</button>
        </form>
    </div>
</div>
