<div class="max-w-6xl">
<div class="wb-panel p-6">
    <h2 class="wb-section__title mb-4">Bill of Materials</h2>

    <form method="GET" class="mb-6 flex gap-3 items-end">
        <div class="flex-1">
            <label class="wb-label">Select Project</label>
            <select name="project_id" onchange="this.form.submit()" class="wb-select">
                <option value="">— Select a project —</option>
                {for p in projects}
                <option value="{p.id}"{if selected_project.id==p.id} selected{/if}>{if p.job_order_number}{p.job_order_number} — {/if}{p.title}</option>
                {/for}
            </select>
        </div>
        {if selected_project}
        <a href="/api/v1/project-audit-ledger/bom/export?project_id={selected_project.id}" class="wb-btn wb-btn--success wb-btn--sm">⬇ Export CSV</a>
        {/if}
    </form>

    {if selected_project}
    <div class="mb-4 p-3 bg-gray-50 rounded text-sm">
        <strong>Project:</strong> {selected_project.title}
        {if selected_project.job_order_number} &middot; <strong>JO #:</strong> {selected_project.job_order_number}{/if}
        &middot; <strong>Total Items:</strong> {bom|count}
    </div>

    {if bom|count > 0}
    <div class="overflow-x-auto">
        <table class="w-full text-sm wb-table wb-table--sticky">
            <thead>
                <tr class="bg-gray-800 text-white text-xs">
                    <th class="text-left py-2 px-3">#</th>
                    <th class="text-left py-2 px-3">Material</th>
                    <th class="text-left py-2 px-3">Category</th>
                    <th class="text-left py-2 px-3">Particulars</th>
                    <th class="text-center py-2 px-3">Width</th>
                    <th class="text-center py-2 px-3">Height</th>
                    <th class="text-center py-2 px-3">UOM</th>
                    <th class="text-center py-2 px-3">QTY</th>
                    <th class="text-right py-2 px-3">Price/Unit</th>
                    <th class="text-right py-2 px-3">Price/SqFt</th>
                    <th class="text-right py-2 px-3">Total</th>
                    <th class="text-left py-2 px-3">Source</th>
                </tr>
            </thead>
            <tbody>
                {for item in bom}
                <tr class="border-b border-gray-200 {if item.source_type=='quotation'}bg-blue-50{/if}">
                    <td class="py-2 px-3 text-xs text-gray-500">{item_index+1}</td>
                    <td class="py-2 px-3 text-sm">{item.material_name|default:item.particulars}</td>
                    <td class="py-2 px-3 text-xs text-gray-600">{item.category_name|default:'—'}</td>
                    <td class="py-2 px-3 text-xs">{item.particulars}</td>
                    <td class="py-2 px-3 text-xs text-center">{item.width|default:'—'}</td>
                    <td class="py-2 px-3 text-xs text-center">{item.height|default:'—'}</td>
                    <td class="py-2 px-3 text-xs text-center">{item.uom|default:'—'}</td>
                    <td class="py-2 px-3 text-xs text-center font-medium">{item.quantity|default:1}</td>
                    <td class="py-2 px-3 text-xs text-right">{if item.price_per_unit > 0}₱{item.price_per_unit|number_format:2}{else}—{/if}</td>
                    <td class="py-2 px-3 text-xs text-right">{if item.price_per_sqft > 0}₱{item.price_per_sqft|number_format:2}{else}—{/if}</td>
                    <td class="py-2 px-3 text-xs text-right font-medium">₱{item.line_total|number_format:2}</td>
                    <td class="py-2 px-3 text-xs">
                        <span class="inline-flex px-1.5 py-0.5 rounded text-xs font-medium {if item.source_type=='quotation'}bg-blue-100 text-blue-700{else}bg-green-100 text-green-700{/if}">
                            {item.source_ref|default:'—'}
                        </span>
                    </td>
                </tr>
                {/for}
            </tbody>
        </table>
    </div>

    <!-- BOM Summary -->
    <div class="mt-4 p-4 bg-gray-50 rounded text-sm border-t">
        <div class="grid grid-cols-4 gap-4">
            <div>
                <span class="text-xs text-gray-500">Total Line Items</span>
                <p class="font-semibold">{bom|count}</p>
            </div>
            <div>
                <span class="text-xs text-gray-500">From Quotations</span>
                <p class="font-semibold text-blue-700">{bom|filter:item=>item.source_type=='quotation'|count}</p>
            </div>
            <div>
                <span class="text-xs text-gray-500">From Sales</span>
                <p class="font-semibold text-green-700">{bom|filter:item=>item.source_type=='sales'|count}</p>
            </div>
            <div>
                <span class="text-xs text-gray-500">Total Cost</span>
                {set bom_total = 0}{for item in bom}{set bom_total = bom_total + (item.line_total|default:0)}{/for}
                <p class="font-semibold text-lg text-gray-900">₱{bom_total|number_format:2}</p>
            </div>
        </div>
    </div>
    {else}
    <div class="p-6 text-center text-gray-600 text-sm">
        No materials found for this project. Create a quotation or sales invoice with line items first.
    </div>
    {/if}
    {/if}
</div>
</div>
