<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="p-4 border-b border-gray-200"><h2 class="font-semibold text-gray-900">Expense Categories</h2></div>
        <table class="w-full text-sm">
            <thead><tr class="bg-gray-50 border-b"><th class="text-left py-2 px-4 font-semibold text-gray-600">Name</th><th class="text-left py-2 px-4 font-semibold text-gray-600">Status</th></tr></thead>
            <tbody>{for c in expense_cats}<tr class="border-b border-gray-100"><td class="py-2 px-4">{c.name}</td><td class="py-2 px-4"><button onclick="toggleStatus('expense_category',{c.id})" class="text-xs px-2 py-0.5 rounded-full {if c.is_active}bg-green-100 text-green-700{else}bg-red-100 text-red-700{/if}">{c.is_active?'active':'inactive'}</button></td></tr>{/for}</tbody>
        </table>
        <div class="p-4 border-t bg-gray-50">
            <div class="flex gap-2"><input type="text" id="new-exp-cat" placeholder="Category name" class="flex-1 px-2 py-1.5 border border-gray-300 rounded text-sm"><button onclick="addCategory('expense_category','new-exp-cat')" class="px-3 py-1.5 bg-blue-600 text-white text-sm rounded-lg">Add</button></div>
        </div>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="p-4 border-b border-gray-200"><h2 class="font-semibold text-gray-900">Material Categories</h2></div>
        <table class="w-full text-sm">
            <thead><tr class="bg-gray-50 border-b"><th class="text-left py-2 px-4 font-semibold text-gray-600">Name</th><th class="text-left py-2 px-4 font-semibold text-gray-600">Status</th></tr></thead>
            <tbody>{for c in material_cats}<tr class="border-b border-gray-100"><td class="py-2 px-4">{c.name}</td><td class="py-2 px-4"><button onclick="toggleStatus('material_category',{c.id})" class="text-xs px-2 py-0.5 rounded-full {if c.is_active}bg-green-100 text-green-700{else}bg-red-100 text-red-700{/if}">{c.is_active?'active':'inactive'}</button></td></tr>{/for}</tbody>
        </table>
        <div class="p-4 border-t bg-gray-50">
            <div class="flex gap-2"><input type="text" id="new-mat-cat" placeholder="Category name" class="flex-1 px-2 py-1.5 border border-gray-300 rounded text-sm"><button onclick="addCategory('material_category','new-mat-cat')" class="px-3 py-1.5 bg-blue-600 text-white text-sm rounded-lg">Add</button></div>
        </div>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="p-4 border-b border-gray-200"><h2 class="font-semibold text-gray-900">Project Types</h2></div>
        <table class="w-full text-sm">
            <thead><tr class="bg-gray-50 border-b"><th class="text-left py-2 px-4 font-semibold text-gray-600">Name</th><th class="text-left py-2 px-4 font-semibold text-gray-600">Status</th></tr></thead>
            <tbody>{for t in project_types}<tr class="border-b border-gray-100"><td class="py-2 px-4">{t.name}</td><td class="py-2 px-4"><button onclick="toggleStatus('project_type',{t.id})" class="text-xs px-2 py-0.5 rounded-full {if t.is_active}bg-green-100 text-green-700{else}bg-red-100 text-red-700{/if}">{t.is_active?'active':'inactive'}</button></td></tr>{/for}</tbody>
        </table>
        <div class="p-4 border-t bg-gray-50">
            <div class="flex gap-2"><input type="text" id="new-ptype" placeholder="Type name" class="flex-1 px-2 py-1.5 border border-gray-300 rounded text-sm"><button onclick="addCategory('project_type','new-ptype')" class="px-3 py-1.5 bg-blue-600 text-white text-sm rounded-lg">Add</button></div>
        </div>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="p-4 border-b border-gray-200"><h2 class="font-semibold text-gray-900">Units of Measure</h2></div>
        <table class="w-full text-sm">
            <thead><tr class="bg-gray-50 border-b"><th class="text-left py-2 px-4 font-semibold text-gray-600">Name</th><th class="text-left py-2 px-4 font-semibold text-gray-600">Abbr</th><th class="text-left py-2 px-4 font-semibold text-gray-600">Status</th></tr></thead>
            <tbody>{for u in units}<tr class="border-b border-gray-100"><td class="py-2 px-4">{u.name}</td><td class="py-2 px-4 text-xs">{u.abbreviation|default:'—'}</td><td class="py-2 px-4"><button onclick="toggleStatus('unit',{u.id})" class="text-xs px-2 py-0.5 rounded-full {if u.is_active}bg-green-100 text-green-700{else}bg-red-100 text-red-700{/if}">{u.is_active?'active':'inactive'}</button></td></tr>{/for}</tbody>
        </table>
        <div class="p-4 border-t bg-gray-50 border-b border-gray-200">
            <div class="flex gap-2 mb-2"><input type="text" id="new-unit-name" placeholder="Unit name (e.g. Piece)" class="flex-1 px-2 py-1.5 border border-gray-300 rounded text-sm"><input type="text" id="new-unit-abbr" placeholder="Abbr (e.g. pc)" class="w-24 px-2 py-1.5 border border-gray-300 rounded text-sm"></div>
            <button onclick="addUnit()" class="px-3 py-1.5 bg-blue-600 text-white text-sm rounded-lg">Add Unit</button>
        </div>
        <div class="p-4 border-b border-gray-200"><h2 class="font-semibold text-gray-900">Team Leads</h2></div>
        <table class="w-full text-sm">
            <thead><tr class="bg-gray-50 border-b"><th class="text-left py-2 px-4 font-semibold text-gray-600">Name</th><th class="text-left py-2 px-4 font-semibold text-gray-600">Status</th></tr></thead>
            <tbody>{for l in team_leads}<tr class="border-b border-gray-100"><td class="py-2 px-4">{l.name}</td><td class="py-2 px-4"><button onclick="toggleStatus('team_lead',{l.id})" class="text-xs px-2 py-0.5 rounded-full {if l.is_active}bg-green-100 text-green-700{else}bg-red-100 text-red-700{/if}">{l.is_active?'active':'inactive'}</button></td></tr>{/for}</tbody>
        </table>
        <div class="p-4 border-t bg-gray-50">
            <div class="flex gap-2 mb-2"><input type="text" id="new-tl-name" placeholder="Name" class="flex-1 px-2 py-1.5 border border-gray-300 rounded text-sm"><input type="text" id="new-tl-contact" placeholder="Contact" class="w-32 px-2 py-1.5 border border-gray-300 rounded text-sm"><input type="text" id="new-tl-email" placeholder="Email" class="w-32 px-2 py-1.5 border border-gray-300 rounded text-sm"></div>
            <button onclick="addTeamLead()" class="px-3 py-1.5 bg-blue-600 text-white text-sm rounded-lg">Add Team Lead</button>
        </div>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="p-4 border-b border-gray-200"><h2 class="font-semibold text-gray-900">Inventory Locations</h2></div>
        <table class="w-full text-sm">
            <thead><tr class="bg-gray-50 border-b"><th class="text-left py-2 px-4 font-semibold text-gray-600">Name</th><th class="text-left py-2 px-4 font-semibold text-gray-600">Description</th><th class="text-left py-2 px-4 font-semibold text-gray-600">Status</th></tr></thead>
            <tbody>{for l in locations}<tr class="border-b border-gray-100"><td class="py-2 px-4">{l.name}</td><td class="py-2 px-4 text-xs">{l.description|default:'—'}</td><td class="py-2 px-4"><button onclick="toggleStatus('inventory_location',{l.id})" class="text-xs px-2 py-0.5 rounded-full {if l.is_active}bg-green-100 text-green-700{else}bg-red-100 text-red-700{/if}">{l.is_active?'active':'inactive'}</button></td></tr>{/for}</tbody>
        </table>
        <div class="p-4 border-t bg-gray-50">
            <div class="flex gap-2"><input type="text" id="new-loc-name" placeholder="Location name" class="flex-1 px-2 py-1.5 border border-gray-300 rounded text-sm"><input type="text" id="new-loc-desc" placeholder="Description" class="flex-1 px-2 py-1.5 border border-gray-300 rounded text-sm"><button onclick="addInvLocation()" class="px-3 py-1.5 bg-blue-600 text-white text-sm rounded-lg">Add</button></div>
        </div>
    </div>
</div>
