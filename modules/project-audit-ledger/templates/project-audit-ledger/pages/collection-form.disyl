<div class="max-w-2xl">
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="font-semibold text-gray-900 mb-4">Record Collection</h2>
    <form onsubmit="return ajaxSubmit(this, 'Collection recorded')" action="/api/v1/project-audit-ledger/collections" method="POST" class="space-y-4">
        {csrf_field | raw}

        <!-- Invoice Selection -->
        <div class="bg-gray-50 rounded-lg p-4 space-y-3 border border-gray-200">
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Invoice Reference</h3>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Project Filter</label><select id="col-project" class="w-full px-3 py-2 border border-gray-300 rounded text-sm" onchange="var pid=this.value;var sel=document.getElementById('col-sale');var opts=sel.querySelectorAll('option');opts.forEach(function(o){if(o.dataset.pid){o.style.display=(!pid||o.dataset.pid===pid)?'':'none';}});sel.value='';"><option value="">— All Projects —</option>{for p in projects}<option value="{p.id}">{p.title}</option>{/for}</select></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Invoice *</label><select name="sales_id" id="col-sale" required class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><option value="">— Select Invoice —</option>{for s in sales}<option value="{s.id}" data-pid="{s.project_id}">{s.sales_number|default:'INV#'~s.id} — {s.client_name|default:'—'} — Net: ₱{s.net_amount|number_format:2} — Due: ₱{(s.net_amount - s.collected_amt)|number_format:2}</option>{/for}</select></div>
        </div>

        <!-- Payment Details -->
        <div class="bg-gray-50 rounded-lg p-4 space-y-3 border border-gray-200">
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Payment Details</h3>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Amount *</label><input type="number" step="0.01" name="amount" required class="w-full px-3 py-2 border border-gray-300 rounded text-sm" placeholder="0.00"></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Payment Date</label><input type="date" name="payment_date" value="{'now'|date:'Y-m-d'}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Method</label><select name="payment_method" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><option value="">—</option><option value="cash">Cash</option><option value="bank_transfer">Bank Transfer</option><option value="check">Check</option><option value="gcash">GCash</option><option value="other">Other</option></select></div>
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Reference #</label><input type="text" name="reference_number" placeholder="OR# / Check#" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            </div>
        </div>

        <!-- Status & Notes -->
        <div class="bg-gray-50 rounded-lg p-4 space-y-3 border border-gray-200">
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Status & Notes</h3>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="block text-sm font-medium text-gray-700 mb-1">Status *</label><select name="status" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><option value="pending" selected>Pending</option><option value="approved">Paid</option><option value="rejected">Rejected</option></select></div>
                <div></div>
            </div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Notes</label><textarea name="notes" rows="2" placeholder="Payment notes, bank details, etc." class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></textarea></div>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">Record Collection</button>
            <a href="/admin/project-audit-ledger/collections" class="px-4 py-2 bg-gray-200 text-gray-700 text-sm rounded-lg hover:bg-gray-300">Cancel</a>
        </div>
    </form>
</div>
</div>

