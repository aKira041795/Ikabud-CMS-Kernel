<div class="max-w-2xl">
<div class="wb-panel p-6">
    <h2 class="wb-section__title mb-4">Record Collection</h2>
    <form onsubmit="return ajaxSubmit(this, 'Collection recorded')" action="/api/v1/project-audit-ledger/collections" method="POST" class="wb-form-surface">
        {csrf_field | raw}

        <!-- Invoice Selection -->
        <div class="wb-form-section space-y-3">
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Invoice Reference</h3>
            <div><label class="wb-label">Project Filter</label><select id="col-project" class="wb-select" onchange="var pid=this.value;var sel=document.getElementById('col-sale');var opts=sel.querySelectorAll('option');opts.forEach(function(o){if(o.dataset.pid){o.style.display=(!pid||o.dataset.pid===pid)?'':'none';}});sel.value='';"><option value="">— All Projects —</option>{for p in projects}<option value="{p.id}">{p.title}</option>{/for}</select></div>
            <div><label class="wb-label">Invoice *</label><select name="sales_id" id="col-sale" required class="wb-select"><option value="">— Select Invoice —</option>{for s in sales}<option value="{s.id}" data-pid="{s.project_id}">{s.sales_number|default:'INV#'~s.id} — {s.client_name|default:'—'} — Net: ₱{s.net_amount|number_format:2} — Due: ₱{(s.net_amount - s.collected_amt)|number_format:2}</option>{/for}</select></div>
        </div>

        <!-- Payment Details -->
        <div class="wb-form-section space-y-3">
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Payment Details</h3>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="wb-label">Amount *</label><input type="number" step="0.01" name="amount" required class="wb-input" placeholder="0.00"></div>
                <div><label class="wb-label">Payment Date</label><input type="date" name="payment_date" value="{'now'|date:'Y-m-d'}" class="wb-input"></div>
                <div><label class="wb-label">Method</label><select name="payment_method" class="wb-select"><option value="">—</option><option value="cash">Cash</option><option value="bank_transfer">Bank Transfer</option><option value="check">Check</option><option value="gcash">GCash</option><option value="other">Other</option></select></div>
                <div><label class="wb-label">Reference #</label><input type="text" name="reference_number" placeholder="OR# / Check#" class="wb-input"></div>
            </div>
        </div>

        <!-- Notes -->
        <div class="wb-form-section space-y-3">
            <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Notes</h3>
            <div><label class="wb-label">Notes</label><textarea name="notes" rows="2" placeholder="Payment notes, bank details, etc." class="wb-textarea"></textarea></div>
        </div>

        <div class="flex gap-3 pt-2">
            <button type="submit" class="wb-btn wb-btn--primary">Record Collection</button>
            <a href="/admin/project-audit-ledger/collections" class="wb-btn wb-btn--secondary">Cancel</a>
        </div>
    </form>
</div>
</div>
