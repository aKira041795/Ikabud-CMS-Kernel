<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-3 grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
            <p class="text-xs text-gray-500">Assigned Projects</p>
            <p class="text-2xl font-bold text-gray-900">{project_count|default:0}</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
            <p class="text-xs text-gray-500">Active Fabrications</p>
            <p class="text-2xl font-bold text-indigo-600">{fab_count|default:0}</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
            <p class="text-xs text-gray-500">Pending Approvals</p>
            <p class="text-2xl font-bold text-amber-600">{pending_count|default:0}</p>
        </div>
    </div>

    <!-- My Projects -->
    <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h3 class="font-semibold text-gray-900 mb-3">My Assigned Projects</h3>
        {if projects|count > 0}
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-gray-50 border-b">
                        <th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">JO #</th>
                        <th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Project</th>
                        <th class="text-right py-2 px-3 font-semibold text-gray-600 text-xs">Contract</th>
                        <th class="text-right py-2 px-3 font-semibold text-gray-600 text-xs">Fab Budget</th>
                        <th class="text-center py-2 px-3 font-semibold text-gray-600 text-xs">Status</th>
                    </tr>
                </thead>
                <tbody>
                    {for p in projects}
                    <tr class="border-b border-gray-100">
                        <td class="py-2 px-3 text-xs font-medium">{p.job_order_number|default:'—'}</td>
                        <td class="py-2 px-3 text-sm">{p.title}</td>
                        <td class="py-2 px-3 text-xs text-right">₱{p.contract_amount|number_format:2}</td>
                        <td class="py-2 px-3 text-xs text-right font-medium text-indigo-600">₱{p.fab_budget|number_format:2}</td>
                        <td class="py-2 px-3 text-center">
                            <span class="inline-flex px-1.5 py-0.5 rounded-full text-xs font-medium {if p.status=='started' || p.status=='ongoing'}bg-green-100 text-green-700{elseif p.status=='approved'}bg-blue-100 text-blue-700{elseif p.status=='completed'}bg-gray-100 text-gray-700{elseif p.status=='pending'}bg-yellow-100 text-yellow-700{elseif p.status=='cancelled' || p.status=='closed'}bg-red-100 text-red-700{else}bg-gray-100 text-gray-600{/if}">{p.status|capitalize}</span>
                        </td>
                    </tr>
                    {/for}
                </tbody>
            </table>
        </div>
        {else}
        <p class="text-sm text-gray-600">No projects assigned to you yet.</p>
        {/if}
    </div>

    <!-- Quick Actions -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h3 class="font-semibold text-gray-900 mb-3">Quick Actions</h3>
        <div class="space-y-3">
            <a href="/admin/project-audit-ledger/team-lead/cash-advances/create" class="block p-3 bg-gray-50 rounded-lg border border-gray-200 hover:border-blue-300 text-sm">
                <span class="font-medium text-gray-900">Request Cash Advance</span>
                <p class="text-xs text-gray-600 mt-1">Submit a new cash advance request</p>
            </a>
            <a href="/admin/project-audit-ledger/team-lead/mobilization/create" class="block p-3 bg-gray-50 rounded-lg border border-gray-200 hover:border-blue-300 text-sm">
                <span class="font-medium text-gray-900">Request Mobilization</span>
                <p class="text-xs text-gray-600 mt-1">Submit a mobilization fund request</p>
            </a>
            <a href="/admin/project-audit-ledger/team-lead/fabrication" class="block p-3 bg-gray-50 rounded-lg border border-gray-200 hover:border-blue-300 text-sm">
                <span class="font-medium text-gray-900">View Fabrications</span>
                <p class="text-xs text-gray-600 mt-1">See your fabrication dues and history</p>
            </a>
        </div>
    </div>
</div>