<div class="max-w-lg">
<div class="wb-panel p-6">
    <h2 class="wb-section__title mb-4">New Cash Advance</h2>
    <form onsubmit="return ajaxSubmit(this, 'Cash advance created')" action="/api/v1/project-audit-ledger/cash-advances" method="POST" class="space-y-4">
        {csrf_field | raw}
        <div><label class="wb-label">Team Lead *</label><select name="team_lead_id" required class="wb-select" data-creatable="team_lead"><option value="">— Select —</option>{for tl in team_leads}<option value="{tl.id}">{tl.name}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.querySelector('select[name=team_lead_id]');if(e)makeCreatable(e);});</script></div>
        <div><label class="wb-label">Project</label><select name="project_id" class="wb-select"><option value="">— Optional —</option>{for p in projects}<option value="{p.id}">{p.title}</option>{/for}</select></div>
        <div class="grid grid-cols-2 gap-4">
            <div><label class="wb-label">Amount *</label><input type="number" step="0.01" name="amount" required class="wb-input"></div>
            <div><label class="wb-label">Date</label><input type="date" name="advance_date" value="{('now'|date:'Y-m-d')}" class="wb-input"></div>
        </div>
        <div><label class="wb-label">Description</label><input type="text" name="description" placeholder="Purpose of advance" class="wb-input"></div>
        <div class="flex gap-3"><button type="submit" class="wb-btn wb-btn--primary">Create</button><a href="/admin/project-audit-ledger/cash-advances" class="wb-btn wb-btn--secondary">Cancel</a></div>
    </form>
</div>
</div>