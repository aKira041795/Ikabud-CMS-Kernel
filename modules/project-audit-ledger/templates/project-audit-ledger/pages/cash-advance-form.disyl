<div class="max-w-lg">
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="font-semibold text-gray-900 mb-4">New Cash Advance</h2>
    <form onsubmit="return ajaxSubmit(this, 'Cash advance created')" action="/api/v1/project-audit-ledger/cash-advances" method="POST" class="space-y-4">
        {csrf_field | raw}
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Team Lead *</label><select name="team_lead_id" required class="w-full px-3 py-2 border border-gray-300 rounded text-sm" data-creatable="team_lead"><option value="">— Select —</option>{for tl in team_leads}<option value="{tl.id}">{tl.name}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.querySelector('select[name=team_lead_id]');if(e)makeCreatable(e);});</script></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Project</label><select name="project_id" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><option value="">— Optional —</option>{for p in projects}<option value="{p.id}">{p.title}</option>{/for}</select></div>
        <div class="grid grid-cols-2 gap-4">
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Amount *</label><input type="number" step="0.01" name="amount" required class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Date</label><input type="date" name="advance_date" value="{('now'|date:'Y-m-d')}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
        </div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Description</label><input type="text" name="description" placeholder="Purpose of advance" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
        <div class="flex gap-3"><button type="submit" class="wb-btn wb-btn--primary">Create</button><a href="/admin/project-audit-ledger/cash-advances" class="wb-btn wb-btn--secondary">Cancel</a></div>
    </form>
</div>
</div>