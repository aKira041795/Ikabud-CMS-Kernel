<div class="max-w-lg">
<div class="wb-panel p-6">
    <h2 class="wb-section__title mb-4">{is_edit ? 'Edit Client' : 'Create Client'}</h2>
    <form onsubmit="return ajaxSubmit(this, '{if is_edit}Client updated{else}Client created{/if}')" action="/api/v1/project-audit-ledger/clients{if is_edit}{if client.id}/{client.id}{/if}{/if}" method="POST" class="space-y-4">
        {csrf_field | raw}
        <div><label class="wb-label wb-label--required">Name</label><input type="text" name="name" value="{client.name}" required class="wb-input"></div>
        <div><label class="wb-label">Contact Person</label><input type="text" name="contact_person" value="{client.contact_person}" class="wb-input"></div>
        <div><label class="wb-label">Email</label><input type="email" name="email" value="{client.email}" class="wb-input"></div>
        <div><label class="wb-label">Phone</label><input type="text" name="phone" value="{client.phone}" class="wb-input"></div>
        <div><label class="wb-label">Address</label><textarea name="address" rows="2" class="wb-textarea">{client.address}</textarea></div>
        <div class="flex gap-3"><button type="submit" class="wb-btn wb-btn--primary">{is_edit ? 'Update' : 'Create'}</button><a href="/admin/project-audit-ledger/clients" class="wb-btn wb-btn--secondary">Cancel</a></div>
    </form>
</div>
</div>
