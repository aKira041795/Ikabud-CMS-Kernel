<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="p-4 border-b border-gray-200">
        <h2 class="font-semibold text-gray-900">Fabrication Dashboard</h2>
        <p class="text-xs text-gray-600 mt-1">Budget = Contract × Alloc%. CA Dispensed = amount released to team lead.</p>
    </div>
    <table class="w-full text-sm pal-responsive-table">
        <thead><tr class="bg-gray-50 border-b border-gray-200">
            <th class="text-left py-3 px-4 font-semibold text-gray-600">Project</th>
            <th class="text-left py-3 px-4 font-semibold text-gray-600">Team Lead</th>
            <th class="text-left py-3 px-4 font-semibold text-gray-600">Budget</th>
            <th class="text-left py-3 px-4 font-semibold text-gray-600">CA Dispensed</th>
            <th class="text-left py-3 px-4 font-semibold text-gray-600">Remaining</th>
            <th class="text-left py-3 px-4 font-semibold text-gray-600">Timeline</th>
            <th class="text-left py-3 px-4 font-semibold text-gray-600"></th>
        </tr></thead>
        <tbody>
            {for p in fabricationProjects}
            <tr class="border-b border-gray-100 hover:bg-gray-50">
                <td class="py-3 px-4 font-medium text-gray-900">{if p.project_id}<a href="/admin/project-audit-ledger/projects/{p.project_id}" class="text-blue-600 hover:text-blue-800">{p.project_title}</a>{else}{p.project_title}{/if}</td>
                <td class="py-3 px-4 text-gray-700">{p.team_lead_name|default:'—'}</td>
                <td class="py-3 px-4"><span class="font-medium">₱{p.fab_budget|default:0|number_format:2}</span><br><span class="text-xs text-gray-600">{p.fabrication_alloc_pct|default:0}% of contract</span></td>
                <td class="py-3 px-4">
                    {if p.ca_dispensed > 0}
                    <span class="font-medium text-indigo-600">₱{p.ca_dispensed|number_format:2}</span>
                    <br><span class="text-xs text-gray-600">{p.dispense_count} dispense{if p.dispense_count != 1}s{/if} · last {p.last_dispense_at|default:''}</span>
                    {else}
                    <span class="text-gray-600">—</span>
                    {/if}
                </td>
                <td class="py-3 px-4">
                    {if p.ca_dispensed > 0}
                    <span class="font-medium {if p.ca_remaining > 0}text-green-600{else}text-gray-600{/if}">₱{p.ca_remaining|number_format:2}</span>
                    {else}
                    <span class="font-medium text-green-600">₱{p.fab_budget|default:0|number_format:2}</span>
                    {/if}
                </td>
                <td class="py-3 px-4 text-xs text-gray-600">{p.start_date|default:'—'} → {p.target_completion_date|default:'—'}</td>
                <td class="py-3 px-4 flex gap-2">
                    {if p.ca_remaining|default:0 > 0}
                    <button onclick="var r=document.getElementById('dispense-{p.project_id}');r.classList.toggle('hidden');if(!r.classList.contains('hidden')){document.getElementById('disp-amt-{p.project_id}').max='{p.ca_remaining|default:p.fab_budget}';}" class="px-2 py-1 bg-blue-600 text-white text-xs rounded hover:bg-blue-700">+ Dispense CA</button>
                    {/if}
                    {if p.ca_dispensed > 0}
                    <a href="/admin/project-audit-ledger/fabrication/{p.project_id}/dues" class="text-xs text-blue-600 hover:text-blue-800 font-medium">Dues →</a>
                    {/if}
                </td>
            </tr>
            <!-- Dispense CA inline form -->
            <tr id="dispense-{p.project_id}" class="hidden border-b border-gray-100 bg-blue-50">
                <td colspan="7" class="py-3 px-4">
                    <form onsubmit="return ajaxSubmit(this, 'CA Dispensed')" action="/api/v1/project-audit-ledger/fabrication/allocations" method="POST" class="flex gap-3 items-end flex-wrap">
                        {csrf_field | raw}
                        <input type="hidden" name="project_id" value="{p.project_id}">
                        <div><label class="block text-xs font-medium text-gray-600 mb-1">CA Amount *</label><input type="number" step="0.01" name="approved_amount" id="disp-amt-{p.project_id}" required placeholder="Max: ₱{p.ca_remaining|default:p.fab_budget|number_format:2}" class="w-36 px-2 py-1.5 border border-gray-300 rounded text-sm"></div>
                        <div><label class="block text-xs font-medium text-gray-600 mb-1">Reason / Ref</label><input type="text" name="approval_reason" placeholder="e.g. Phase 1 materials" class="w-40 px-2 py-1.5 border border-gray-300 rounded text-sm"></div>
                        <div><span class="text-xs text-gray-600">Budget: ₱{p.fab_budget|default:0|number_format:2} ({p.fabrication_alloc_pct}%)<br>Limit: ₱{p.ca_remaining|default:p.fab_budget|number_format:2}</span></div>
                        <button type="submit" class="wb-btn wb-btn--primary wb-btn--sm">Dispense</button>
                        <button type="button" onclick="document.getElementById('dispense-{p.project_id}').classList.add('hidden')" class="wb-btn wb-btn--secondary wb-btn--sm">Cancel</button>
                    </form>
                </td>
            </tr>
            {/for}
            {if fabricationProjects|count == 0}
            <tr><td colspan="7" class="py-12 text-center text-gray-600">
                <p class="mb-2">No projects configured for fabrication.</p>
                <p class="text-xs">Set fabrication allocation percentage on a project to enable fabrication tracking here.</p>
            </td></tr>
            {/if}
        </tbody>
    </table>
</div>



