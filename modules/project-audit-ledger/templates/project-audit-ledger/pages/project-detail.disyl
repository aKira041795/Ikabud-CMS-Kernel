{!-- Expose available entity fields for frontend features --}
<div data-ikb-entity-fields="" class="print-hidden" aria-hidden="true" style="display:none"></div>
{set _dh_title = project.project_id|default:project.title}
{set _dh_subtitle = project.client_name|default:''}
{set _dh_status = project.status|default:'draft'}
{set _dh_amount = project.contract_amount|default:0}
{set _dh_collected = profitability.total_collected|default:0}
{set _dh_outstanding = remaining_collectible|default:0}
{set _dh_target_date = project.target_completion_date|default:''}
<div class="wb-detail-actions">
    <a href="/admin/project-audit-ledger/projects" class="wb-btn wb-btn--secondary wb-btn--sm">← Back</a>
    <a href="/admin/project-audit-ledger/projects/{project.id}/edit" class="wb-btn wb-btn--primary wb-btn--sm">Edit</a>
    {if project.status == 'pending'}
        <button onclick="approveProject({project.id})" class="wb-btn wb-btn--success wb-btn--sm">✓ Approve</button>
        <button onclick="rejectProject({project.id})" class="wb-btn wb-btn--danger wb-btn--sm">✗ Reject</button>
    {/if}
    {if project.client_email}
        <button onclick="sendProjectEmail({project.id})" class="wb-btn wb-btn--success wb-btn--sm">📧 Email Client</button>
    {/if}
    <a href="/admin/project-audit-ledger/projects/{project.id}/print" target="_blank" class="wb-btn wb-btn--outline wb-btn--sm">🖨 Print</a>
</div>

{include "workbench:detail_header"
    title=_dh_title|default:''
    subtitle=_dh_subtitle|default:''
    status_badge=_dh_status|default:''
    metrics=[
        {if _dh_amount|default:0 > 0}
            ['label' => 'Total', 'value' => '₱' ~ (_dh_amount|number_format:2)],
            {if _dh_collected|default:null !== null}['label' => 'Collected', 'value' => '₱' ~ (_dh_collected|number_format:2)],{/if}
            {if _dh_outstanding|default:null !== null}['label' => 'Outstanding', 'value' => '₱' ~ (_dh_outstanding|number_format:2)],{/if}
            {if _dh_target_date|default:''}['label' => 'Target', 'value' => _dh_target_date]{/if}
        {/if}
    ]
    actions=_dh_actions|default:''
}

<div x-data="{ tab: 'overview' }" class="print-area">
  <div class="wb-tabs no-print overflow-x-auto">
    <button @click="tab='overview'" :class="tab==='overview'?'is-active':''" class="wb-tab">📋 Overview</button>
    <button @click="tab='items'" :class="tab==='items'?'is-active':''" class="wb-tab">📦 Items</button>
    <button @click="tab='financials'" :class="tab==='financials'?'is-active':''" class="wb-tab">💰 Financials</button>
    <button @click="tab='docs'" :class="tab==='docs'?'is-active':''" class="wb-tab">📄 Docs</button>
  </div>

  <!-- Tab: Overview -->
  <div x-show="tab==='overview'" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- Project Details -->
    <div class="wb-panel p-6 min-w-0">
        <h4 class="font-semibold text-gray-900 text-sm mb-3">📋 Project Details</h4>
        <dl class="space-y-2 text-sm">
            <div><dt class="text-gray-500 text-xs">Job Order #</dt><dd class="font-medium text-gray-900 break-words">{project_overview.project.job_order_number|default:'—'}</dd></div>
            <div><dt class="text-gray-500 text-xs">Project Type</dt><dd class="text-gray-700 break-words">{project_overview.project.project_type|default:'—'}</dd></div>
            <div><dt class="text-gray-500 text-xs">Scope of Work</dt><dd class="text-gray-700 break-words">{project_overview.project.scope_of_work|default:'—'|replace:'_':' '}</dd></div>
            <div><dt class="text-gray-500 text-xs">Description</dt><dd class="text-gray-700 break-words">{project_overview.project.description|default:'—'}</dd></div>
            <div><dt class="text-gray-500 text-xs">Location</dt><dd class="text-gray-700 break-words">{project_overview.project.location|default:'—'}</dd></div>
        </dl>
    </div>
    <!-- Client Details -->
    <div class="wb-panel p-6 min-w-0">
        <h4 class="font-semibold text-gray-900 text-sm mb-3">👤 Client Details</h4>
        <dl class="space-y-2 text-sm">
            <div><dt class="text-gray-500 text-xs">Client Name</dt><dd class="font-medium text-gray-900 break-words">{project_overview.client.name|default:'—'}</dd></div>
            <div><dt class="text-gray-500 text-xs">Contact Person</dt><dd class="text-gray-700 break-words">{project_overview.client.contact_person|default:'—'}</dd></div>
            <div><dt class="text-gray-500 text-xs">Email</dt><dd class="break-words">{if project_overview.client.email}<a href="mailto:{project_overview.client.email}" class="text-blue-600">{project_overview.client.email}</a>{else}<span class="text-gray-700">—</span>{/if}</dd></div>
            <div><dt class="text-gray-500 text-xs">Phone</dt><dd class="text-gray-700 break-words">{project_overview.client.phone|default:'—'}</dd></div>
            <div><dt class="text-gray-500 text-xs">Address</dt><dd class="text-gray-700 break-words">{project_overview.client.address|default:'—'}</dd></div>
        </dl>
    </div>
    <!-- Schedule & Assignment -->
    <div class="wb-panel p-6 min-w-0">
        <h4 class="font-semibold text-gray-900 text-sm mb-3">📅 Schedule &amp; Assignment</h4>
        <dl class="space-y-2 text-sm">
            <div><dt class="text-gray-500 text-xs">Start Date</dt><dd class="text-gray-700">{project_overview.schedule.start_date|default:'—'}</dd></div>
            <div><dt class="text-gray-500 text-xs">Target Completion</dt><dd class="text-gray-700">{project_overview.schedule.target_completion_date|default:'—'}</dd></div>
            <div><dt class="text-gray-500 text-xs">Actual Completion</dt><dd class="text-gray-700">{project_overview.schedule.actual_completion_date|default:'—'}</dd></div>
            <div><dt class="text-gray-500 text-xs">Project Manager</dt><dd class="font-medium text-gray-900 break-words">{project_overview.schedule.project_manager|default:'—'}</dd></div>
        </dl>
    </div>
    <!-- Payment Terms -->
    <div class="wb-panel p-6 min-w-0">
        <h4 class="font-semibold text-gray-900 text-sm mb-3">💳 Payment Terms</h4>
        <dl class="space-y-2 text-sm">
            <div><dt class="text-gray-500 text-xs">Mode of Payment</dt><dd class="text-gray-700">{project_overview.payment.mode_of_payment|default:'—'|replace:'_':' '}</dd></div>
            <div><dt class="text-gray-500 text-xs">Down Payment</dt><dd class="font-medium text-gray-900">{if project_overview.payment.down_payment !== null}₱{project_overview.payment.down_payment|number_format:2}{if project_overview.payment.down_payment_type} ({project_overview.payment.down_payment_type|replace:'_':' '}){/if}{else}—{/if}</dd></div>
        </dl>
    </div>
    <!-- Installation & Fabrication -->
    <div class="wb-panel p-6 min-w-0">
        <h4 class="font-semibold text-gray-900 text-sm mb-3">🔧 Installation &amp; Fabrication</h4>
        <dl class="space-y-2 text-sm">
            <div><dt class="text-gray-500 text-xs">Installation Included</dt><dd class="font-medium {if project_overview.installation.included}text-green-600{else}text-gray-500{/if}">{if project_overview.installation.included}Yes{else}No{/if}</dd></div>
            {if project_overview.installation.included}
            <div><dt class="text-gray-500 text-xs">Fabrication Team Lead</dt><dd class="text-gray-700">{project_overview.installation.team_lead|default:'—'}</dd></div>
            {/if}
        </dl>
    </div>
    <!-- Notes (conditional) -->
    {if project_overview.notes}
    <div class="wb-panel p-6 min-w-0">
        <h4 class="font-semibold text-gray-900 text-sm mb-3">📝 Notes</h4>
        <p class="text-sm text-gray-700 whitespace-pre-wrap">{project_overview.notes}</p>
    </div>
    {/if}
  </div>
  <!-- Mockup Image (conditional, full width) -->
  {if mockup_url}
  <div x-show="tab==='overview'" class="mt-6">
    <div class="wb-panel p-6 inline-block min-w-0">
        <h4 class="font-semibold text-gray-900 text-sm mb-3">🖼 Mockup / Reference Image</h4>
        <img src="{mockup_url}" alt="Mockup" class="rounded-lg border border-gray-200 cursor-zoom-in" style="max-width:300px;max-height:200px;object-fit:cover;" onclick="openLightbox(this.src, 'Mockup Image')">
    </div>
  </div>
  {/if}

  <!-- Tab: Items -->
  <div x-show="tab==='items'" class="wb-panel p-6">
        {if project.items && project.items|count > 0}
        <div class="mt-6 border-t pt-4">
            <h4 class="font-semibold text-gray-900 text-sm mb-3">📋 Line Items</h4>
            <div class="overflow-x-auto">
            <table class="w-full text-sm wb-table wb-table--sticky">
                <thead><tr class="bg-gray-50 border-b"><th class="text-left py-2 px-2 font-semibold text-gray-600 text-xs">#</th><th class="text-left py-2 px-2 font-semibold text-gray-600 text-xs">Material</th><th class="text-left py-2 px-2 font-semibold text-gray-600 text-xs">Particulars</th><th class="text-center py-2 px-2 font-semibold text-gray-600 text-xs">W×H</th><th class="text-center py-2 px-2 font-semibold text-gray-600 text-xs">Unit</th><th class="text-center py-2 px-2 font-semibold text-gray-600 text-xs">QTY</th><th class="text-right py-2 px-2 font-semibold text-gray-600 text-xs">Price/Unit</th><th class="text-right py-2 px-2 font-semibold text-gray-600 text-xs">Price/SqFt</th><th class="text-right py-2 px-2 font-semibold text-gray-600 text-xs">Total</th></tr></thead>
                <tbody>
                {for item in project.items}
                <tr class="border-b border-gray-100"><td class="py-2 px-2 text-xs text-center">{item.sort_order}</td><td class="py-2 px-2 text-xs text-gray-700">{item.material_name|default:item.particulars}</td><td class="py-2 px-2 text-xs text-gray-700">{item.particulars}</td><td class="py-2 px-2 text-xs text-center">{if item.width && item.height}{item.width} × {item.height}{else}—{/if}</td><td class="py-2 px-2 text-xs text-center">{item.uom|default:'—'}</td><td class="py-2 px-2 text-xs text-center">{item.quantity}</td><td class="py-2 px-2 text-xs text-right">₱{item.price_per_unit|number_format:2}</td><td class="py-2 px-2 text-xs text-right">{if item.price_per_sqft}₱{item.price_per_sqft|number_format:2}{else}—{/if}</td><td class="py-2 px-2 text-xs text-right font-medium">₱{item.line_total|number_format:2}</td></tr>
                {/for}
                </tbody>
            </table>
            </div>
        </div>
        {else}
        <div class="mt-6 border-t pt-4"><p class="text-sm text-gray-500">No line items recorded.</p></div>
        {/if}
  </div>

  <!-- Tab: Financials -->
  <div x-show="tab==='financials'" class="space-y-4 no-print">
        <!-- Financial Summary -->
        <div class="wb-panel p-6">
            <h3 class="font-semibold text-gray-900 mb-3">Financial Summary</h3>
            <div class="space-y-2 text-sm">
                <div class="flex justify-between"><span class="text-gray-700 font-semibold">Budget</span><span class="font-semibold text-gray-900">₱{budget.contract_amount|default:0|number_format:2}</span></div>
                {if remaining_collectible > 0}
                <div class="flex justify-between text-xs"><span class="text-gray-600">Remaining Collectible</span><span class="text-orange-500">₱{remaining_collectible|number_format:2}</span></div>
                {/if}
                <div class="flex justify-between"><span class="text-gray-600 pl-3">↳ Collected</span><span class="font-medium text-green-600">{if profitability.total_collected|default:0 > 0}+₱{profitability.total_collected|number_format:2}{else}₱0.00{/if}</span></div>
                {if project.fabrication_alloc_pct && project.fabrication_alloc_pct > 0}
                <div class="flex justify-between"><span class="text-gray-600 pl-3">↳ Fabrication</span><span class="font-medium text-indigo-600">−₱{fabrication_amount|number_format:2} ({project.fabrication_alloc_pct}%)</span></div>
                {/if}
                <div class="flex justify-between"><span class="text-gray-600 pl-3">↳ Spent</span><span class="font-medium text-yellow-600">−₱{costs.total_cost|default:0|number_format:2}</span></div>
                <div class="border-t pt-2 flex justify-between"><span class="text-gray-700 font-medium">Net Profit</span><span class="font-medium {if net_profit >= 0}text-green-600{else}text-red-600{/if}">₱{net_profit|number_format:2}</span></div>
                <div class="flex justify-between text-xs"><span class="text-gray-600">Amount Collectible</span><span class="{if remaining_collectible > 0}text-orange-500{else}text-green-600{/if}">₱{remaining_collectible|number_format:2}</span></div>
            </div>
        </div>
        <div class="wb-panel p-6">
            <h4 class="font-semibold text-gray-900 text-sm mb-3">Collections ({collection_history|count})</h4>
            <div class="overflow-x-auto">
            <table class="w-full text-sm wb-table wb-table--sticky">
                <thead><tr class="bg-gray-50 border-b"><th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Date</th><th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Sale #</th><th class="text-right py-2 px-3 font-semibold text-gray-600 text-xs">Amount</th><th class="text-center py-2 px-3 font-semibold text-gray-600 text-xs">Status</th></tr></thead>
                <tbody>
                    {for c in collection_history}
                    <tr class="border-b border-gray-100 hover:bg-blue-50 cursor-pointer" onclick="window.location='/admin/project-audit-ledger/collections/{c.id}'"><td class="py-2 px-3 text-xs text-gray-600">{c.created_at}</td><td class="py-2 px-3 text-xs text-gray-700">{if c.sales_id}<a href="/admin/project-audit-ledger/sales/{c.sales_id}" class="text-blue-600 hover:text-blue-800" onclick="event.stopPropagation()">{c.sales_number|default:'#'~c.sales_id}</a>{else}{c.sales_number|default:'#'~c.sales_id}{/if}</td><td class="py-2 px-3 text-xs text-right font-medium text-green-600">₱{c.amount|number_format:2}</td><td class="py-2 px-3 text-center">{include "project-audit-ledger/components/pal_status_badge" _sb_status=c.status|default:'pending'}</td></tr>
                    {/for}
                    {if collection_history|count == 0}
                    <tr><td colspan="4" class="py-6 text-center text-gray-600 text-sm">No collections recorded.</td></tr>
                    {/if}
                </tbody>
            </table>
            </div>
        </div>
        <div class="wb-panel p-6">
            <h4 class="font-semibold text-gray-900 text-sm mb-3">Expenses</h4>
            {ikb_entity_list source="pal_expense" view="table" use="workbench" filter="project_id={project.id}" empty="No expenses recorded." /}
        </div>
        <div class="wb-panel p-6">
            <h4 class="font-semibold text-gray-900 text-sm mb-3">Purchase Orders ({purchase_history|count})</h4>
            <div class="overflow-x-auto">
            <table class="w-full text-sm wb-table wb-table--sticky">
                <thead><tr class="bg-gray-50 border-b"><th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">PO #</th><th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Supplier</th><th class="text-right py-2 px-3 font-semibold text-gray-600 text-xs">Total</th><th class="text-center py-2 px-3 font-semibold text-gray-600 text-xs">Status</th><th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Date</th></tr></thead>
                <tbody>
                    {for po in purchase_history}
                    <tr class="border-b border-gray-100"><td class="py-2 px-3 text-xs font-medium text-gray-900"><a href="/admin/project-audit-ledger/purchases/{po.id}" class="text-blue-600 hover:text-blue-800">{po.purchase_number|default:'PO#'~po.id}</a></td><td class="py-2 px-3 text-xs text-gray-700">{po.supplier_name|default:'—'}</td><td class="py-2 px-3 text-xs text-right font-medium">₱{po.total_amount|number_format:2}</td><td class="py-2 px-3 text-center">{include "project-audit-ledger/components/pal_status_badge" _sb_status=po.status|default:'draft'}</td><td class="py-2 px-3 text-xs text-gray-600">{po.purchase_date|default:po.created_at}</td></tr>
                    {/for}
                    {if purchase_history|count == 0}
                    <tr><td colspan="5" class="py-6 text-center text-gray-600 text-sm">No purchase orders linked to this project.</td></tr>
                    {/if}
                </tbody>
            </table>
            </div>
        </div>
  </div>

  <!-- Tab: Docs -->
  <div x-show="tab==='docs'" class="space-y-4">
        <div class="wb-panel p-6">
            <h4 class="font-semibold text-gray-900 text-sm mb-2">📄 Project Documents</h4>
            <p class="text-xs text-gray-600 mb-2">Upload contracts, permits, plans, and other project files.</p>
            <form onsubmit="return uploadAttachment(this, 'project', {project.id})" class="flex gap-2 items-end">
                {csrf_field | raw}
                <div class="flex-1"><input type="file" name="file" required class="wb-file-input"></div>
                <div><input type="text" name="description" placeholder="Description" class="wb-input w-40"></div>
                <button type="submit" class="wb-btn wb-btn--primary wb-btn--sm">Upload</button>
            </form>
            <div id="project-attachments" class="mt-2">{attachments_html|raw}</div>
        </div>
        <div class="wb-panel p-6">
            <h4 class="font-semibold text-gray-900 text-sm mb-2">🖼 PO Receipts &amp; Invoices</h4>
            <p class="text-xs text-gray-600 mb-2">Upload supplier invoices, receipts, and delivery documents.</p>
            <form onsubmit="return uploadAttachment(this, 'po', {project.id})" class="flex gap-2 items-end mb-3">
                {csrf_field | raw}
                <div class="flex-1"><input type="file" name="file" accept="image/*" required class="wb-file-input"></div>
                <div><input type="text" name="description" placeholder="PO ref / notes" class="wb-input w-40"></div>
                <button type="submit" class="wb-btn wb-btn--primary wb-btn--sm">Upload PO</button>
            </form>
            <div id="po-images" class="grid grid-cols-2 md:grid-cols-3 gap-3">{po_images_html|raw}</div>
        </div>
  </div>
</div>

<script>
function sendProjectEmail(id) {
    var btn = document.querySelector('button[onclick*="sendProjectEmail"]');
    var orig = '📧 Email Client';
    if (btn) { btn.disabled = true; btn.textContent = 'Sending...'; }
    var csrf = document.querySelector('input[name="_token"]');
    var fd = new FormData();
    if (csrf) fd.append('_token', csrf.value);
    fetch('/api/v1/project-audit-ledger/projects/' + id + '/email', { method: 'POST', body: fd })
    .then(function(r){ return r.json(); })
    .then(function(d){
        if (d.ok) {
            showToast('Email sent to ' + d.to);
        } else {
            showToast(d.error || 'Failed', 'error');
        }
        if (btn) { btn.disabled = false; btn.textContent = orig; }
    })
    .catch(function(){
        showToast('Network error', 'error');
        if (btn) { btn.disabled = false; btn.textContent = orig; }
    });
}

function approveProject(id) {
    if (!confirm('Approve this Job Order?')) return;
    var csrf = document.querySelector('input[name="_token"]');
    var fd = new FormData();
    fd.append('status', 'approved');
    if (csrf) fd.append('_token', csrf.value);
    fetch('/api/v1/project-audit-ledger/projects/' + id + '/status', { method: 'POST', body: fd })
    .then(function(r){ return r.json(); })
    .then(function(d){
        if (d.ok) { showToast('Job Order approved'); setTimeout(function(){ location.reload(); }, 800); }
        else { showToast(d.error || 'Failed', 'error'); }
    })
    .catch(function(){ showToast('Network error', 'error'); });
}

function rejectProject(id) {
    var reason = prompt('Reason for rejection:');
    if (reason === null) return; // cancelled
    var csrf = document.querySelector('input[name="_token"]');
    var fd = new FormData();
    fd.append('status', 'draft');
    fd.append('rejection_reason', reason);
    if (csrf) fd.append('_token', csrf.value);
    fetch('/api/v1/project-audit-ledger/projects/' + id + '/status', { method: 'POST', body: fd })
    .then(function(r){ return r.json(); })
    .then(function(d){
        if (d.ok) { showToast('Job Order returned to draft'); setTimeout(function(){ location.reload(); }, 800); }
        else { showToast(d.error || 'Failed', 'error'); }
    })
    .catch(function(){ showToast('Network error', 'error'); });
}
</script>
