<div class="max-w-lg">
<div class="wb-panel p-6">
    <h2 class="wb-section__title mb-4">Record Fabrication Payment</h2>
    <form onsubmit="return ajaxSubmit(this, 'Payment recorded')" action="/api/v1/project-audit-ledger/fabrication/payments" method="POST" class="wb-form-surface">
        {csrf_field | raw}
        <div><label class="wb-label wb-label--required">Project</label><select name="project_id" required class="wb-select" data-creatable="project"><option value="">—</option>{for p in projects}<option value="{p.id}">{p.title}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.querySelector('select[name=project_id]');if(e)makeCreatable(e);});</script></div>
        <div><label class="wb-label wb-label--required">Team Lead</label><select name="team_lead_id" required class="wb-select" data-creatable="team_lead"><option value="">—</option>{for l in team_leads}<option value="{l.id}">{l.name}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.querySelector('select[name=team_lead_id]');if(e)makeCreatable(e);});</script></div>
        <div><label class="wb-label wb-label--required">Amount</label><input type="number" step="0.01" name="amount" required class="wb-input"></div>
        <div><label class="wb-label">Notes</label><textarea name="notes" rows="2" class="wb-textarea"></textarea></div>
        <button type="submit" class="wb-btn wb-btn--primary">Record & Submit</button>
    </form>
</div>
</div>
