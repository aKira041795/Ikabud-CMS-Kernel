<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="p-4 border-b border-gray-200"><h2 class="font-semibold text-gray-900">Pending ({pending|count})</h2></div>
        {for a in pending}
        {set entity_path = a.entity_type|default:''}
        {if entity_path == 'expense'}{set url_base = '/admin/project-audit-ledger/expenses'}
        {elseif entity_path == 'purchase'}{set url_base = '/admin/project-audit-ledger/purchases'}
        {elseif entity_path == 'issuance'}{set url_base = '/admin/project-audit-ledger/material-issuance'}
        {elseif entity_path == 'collection'}{set url_base = '/admin/project-audit-ledger/collections'}
        {elseif entity_path == 'fabrication_payment'}{set url_base = '/admin/project-audit-ledger/fabrication'}
        {elseif entity_path == 'cash_advance'}{set url_base = '/admin/project-audit-ledger/cash-advances'}
        {elseif entity_path == 'mobilization'}{set url_base = '/admin/project-audit-ledger/mobilization'}
        {else}{set url_base = ''}{/if}
        <div class="p-4 border-b border-gray-100">
            <div class="flex justify-between items-start">
                <div>
                    <p class="font-medium text-gray-900">{if url_base && a.entity_id}<a href="{url_base}/{a.entity_id}" class="text-blue-600 hover:text-blue-800">{a.entity_type|capitalize} #{a.entity_id}</a>{else}{a.entity_type|capitalize|default:'Request'} #{a.entity_id}{/if}</p>
                    <p class="text-xs text-gray-600">{a.submitted_at} by {a.submitter_name|default:'—'}</p>
                    <p class="text-xs text-gray-600 mt-1">{a.notes|default:''}</p>
                </div>
                <div class="flex gap-2">
                    <button onclick="approve({a.id})" class="px-3 py-1 bg-green-600 text-white text-xs rounded hover:bg-green-700">Approve</button>
                    <button onclick="reject({a.id})" class="px-3 py-1 bg-red-600 text-white text-xs rounded hover:bg-red-700">Reject</button>
                </div>
            </div>
        </div>
        {/for}
        {if pending|count == 0}
        <div class="p-8 text-center text-gray-600 text-sm">No pending approvals.</div>
        {/if}
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="p-4 border-b border-gray-200"><h2 class="font-semibold text-gray-900">Recent Decisions</h2></div>
        {for a in recent}
        {set entity_path2 = a.entity_type|default:''}
        {if entity_path2 == 'expense'}{set url_base2 = '/admin/project-audit-ledger/expenses'}
        {elseif entity_path2 == 'purchase'}{set url_base2 = '/admin/project-audit-ledger/purchases'}
        {elseif entity_path2 == 'issuance'}{set url_base2 = '/admin/project-audit-ledger/material-issuance'}
        {elseif entity_path2 == 'collection'}{set url_base2 = '/admin/project-audit-ledger/collections'}
        {elseif entity_path2 == 'fabrication_payment'}{set url_base2 = '/admin/project-audit-ledger/fabrication'}
        {elseif entity_path2 == 'cash_advance'}{set url_base2 = '/admin/project-audit-ledger/cash-advances'}
        {elseif entity_path2 == 'mobilization'}{set url_base2 = '/admin/project-audit-ledger/mobilization'}
        {else}{set url_base2 = ''}{/if}
        <div class="p-4 border-b border-gray-100">
            <div class="flex justify-between items-start">
                <div>
                    <p class="font-medium text-gray-900">{if url_base2 && a.entity_id}<a href="{url_base2}/{a.entity_id}" class="text-blue-600 hover:text-blue-800">{a.entity_type|capitalize} #{a.entity_id}</a>{else}{a.entity_type|capitalize|default:'Request'} #{a.entity_id}{/if}</p>
                    <p class="text-xs text-gray-600">{a.decision_date} by {a.reviewer_name|default:'—'}</p>
                </div>
                <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium {if a.decision=='approved'}bg-green-100 text-green-700{else}bg-red-100 text-red-700{/if}">{a.decision}</span>
            </div>
        </div>
        {/for}
        {if recent|count == 0}
        <div class="p-8 text-center text-gray-600 text-sm">No decisions yet.</div>
        {/if}
    </div>
</div>
