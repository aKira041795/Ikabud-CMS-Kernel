<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="wb-list-card">
        <div class="wb-list-card__header"><span class="wb-list-card__title">Pending ({pending|count})</span></div>
        {for a in pending}
        {set eurl = palEntityUrl(a.entity_type, a.entity_id)}
        <div class="wb-list-card__item" data-wb-entity-type="{a.entity_type}" data-wb-entity-id="{a.entity_id}">
            <div class="wb-list-card__item-main">
                <div class="flex items-center gap-2 mb-0.5">
                    <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">{palEntityLabel(a.entity_type)}</span>
                    {if a.project_title}<span class="text-xs text-gray-500">{a.project_title}</span>{/if}
                </div>
                <p class="wb-list-card__item-title">{if eurl}<a href="{eurl}" class="text-blue-600 hover:text-blue-800">{if a.project_title}{a.project_title}{else}{a.entity_type|capitalize} #{a.entity_id}{/if}</a>{else}{if a.project_title}{a.project_title}{else}{a.entity_type|capitalize|default:'Request'} #{a.entity_id}{/if}{/if}</p>
                {if a.project_id}<a href="/admin/project-audit-ledger/projects/{a.project_id}" class="inline-flex items-center gap-1 text-xs text-blue-500 hover:text-blue-700 mt-0.5">📋 View Project</a>{/if}
                <p class="wb-list-card__item-sub">{a.submitted_at} by {a.submitter_name|default:'—'}</p>
                {if a.amount|default:0 > 0}<p class="text-sm font-semibold text-gray-800 mt-1">₱{a.amount|number_format:2}</p>{/if}
                {if a.notes}<p class="text-xs text-gray-500 mt-1 italic">"{a.notes}"</p>{/if}
            </div>
            <div class="wb-list-card__item-end flex gap-1.5">
                <button onclick="approve({a.id}, '{palEntityLabel(a.entity_type)}', {a.amount|default:0}, '{a.project_title|default:''|escape:'html'}', '{a.submitter_name|default:'—'|escape:'html'}', '{a.notes|default:''|escape:'html'}')" class="wb-btn wb-btn--success wb-btn--sm">Approve</button>
                <button onclick="reject({a.id}, '{palEntityLabel(a.entity_type)}', {a.amount|default:0}, '{a.project_title|default:''|escape:'html'}')" class="wb-btn wb-btn--danger wb-btn--sm">Reject</button>
            </div>
        </div>
        {/for}
        {if pending|count == 0}
        <div class="p-8 text-center text-gray-600 text-sm">No pending approvals.</div>
        {/if}
    </div>
    <div class="wb-list-card">
        <div class="wb-list-card__header"><span class="wb-list-card__title">Recent Decisions</span></div>
        {for a in recent}
        {set eurl2 = palEntityUrl(a.entity_type, a.entity_id)}
        <div class="wb-list-card__item">
            <div class="wb-list-card__item-main">
                <div class="flex items-center gap-2 mb-0.5">
                    <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700">{palEntityLabel(a.entity_type)}</span>
                </div>
                <p class="wb-list-card__item-title">{if eurl2}<a href="{eurl2}" class="text-blue-600 hover:text-blue-800">{if a.project_title}{a.project_title}{else}{a.entity_type|capitalize} #{a.entity_id}{/if}</a>{else}{if a.project_title}{a.project_title}{else}{a.entity_type|capitalize|default:'Request'} #{a.entity_id}{/if}{/if}</p>
                {if a.project_id}<a href="/admin/project-audit-ledger/projects/{a.project_id}" class="inline-flex items-center gap-1 text-xs text-blue-500 hover:text-blue-700 mt-0.5">📋 View Project</a>{/if}
                <p class="wb-list-card__item-sub">{a.decision_date} by {a.reviewer_name|default:'—'}</p>
            </div>
            {include "project-audit-ledger/components/pal_status_badge" _sb_status=a.decision}
        </div>
        {/for}
        {if recent|count == 0}
        <div class="p-8 text-center text-gray-600 text-sm">No decisions yet.</div>
        {/if}
    </div>
</div>
