<div class="max-w-4xl print-area">
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="font-semibold text-gray-900 mb-2">Invoice #{sale.sales_number|default:sale.id}</h2>
    <div class="space-y-2 text-sm mb-4">
        <div class="flex justify-between"><span class="text-gray-600">Project</span><span>{if sale.project_title && sale.project_id}<a href="/admin/project-audit-ledger/projects/{sale.project_id}" class="text-blue-600 hover:text-blue-800">{sale.project_title}</a>{else}{sale.project_title|default:'—'}{/if}</span></div>
        <div class="flex justify-between"><span class="text-gray-600">Client</span><span>{if sale.client_name && sale.client_id}<a href="/admin/project-audit-ledger/clients/{sale.client_id}" class="text-blue-600 hover:text-blue-800">{sale.client_name}</a>{else}{sale.client_name|default:'—'}{/if}</span></div>
        {if sale.scope_of_work}
        <div class="flex justify-between"><span class="text-gray-600">Scope of Work</span><span>{sale.scope_of_work|replace:'_':' '|capitalize}</span></div>
        {/if}
        {if sale.mode_of_payment}
        <div class="flex justify-between"><span class="text-gray-600">Mode of Payment</span><span>{sale.mode_of_payment|replace:'_':' '|capitalize}</span></div>
        {/if}
    </div>

    <!-- Line Items -->
    {if sale.items && sale.items|count > 0}
    <h3 class="text-sm font-semibold text-gray-800 mb-2">Line Items</h3>
    <div class="overflow-x-auto mb-4">
        <table class="w-full text-sm border-collapse">
            <thead>
                <tr class="bg-gray-800 text-white text-xs">
                    <th class="text-left py-2 px-3">#</th>
                    <th class="text-left py-2 px-3">Particulars</th>
                    <th class="text-center py-2 px-3">Width</th>
                    <th class="text-center py-2 px-3">Height</th>
                    <th class="text-center py-2 px-3">QTY</th>
                    <th class="text-right py-2 px-3">Price/Unit</th>
                    <th class="text-right py-2 px-3">Price/SqFt</th>
                    <th class="text-right py-2 px-3">Total</th>
                </tr>
            </thead>
            <tbody>
                {for item in sale.items}
                <tr class="border-b border-gray-200">
                    <td class="py-2 px-3 text-xs text-gray-500">{item.sort_order|default:item_index+1}</td>
                    <td class="py-2 px-3 text-sm">{item.particulars}{if item.material_name} <span class="text-xs text-gray-500">({item.material_name})</span>{/if}</td>
                    <td class="py-2 px-3 text-xs text-center">{item.width|default:'—'}</td>
                    <td class="py-2 px-3 text-xs text-center">{item.height|default:'—'}</td>
                    <td class="py-2 px-3 text-xs text-center">{item.quantity|default:1}</td>
                    <td class="py-2 px-3 text-xs text-right">{if item.price_per_unit > 0}₱{item.price_per_unit|number_format:2}{else}—{/if}</td>
                    <td class="py-2 px-3 text-xs text-right">{if item.price_per_sqft > 0}₱{item.price_per_sqft|number_format:2}{else}—{/if}</td>
                    <td class="py-2 px-3 text-xs text-right font-medium">₱{item.line_total|number_format:2}</td>
                </tr>
                {/for}
            </tbody>
        </table>
    </div>
    {/if}

    <!-- Amount Summary -->
    <div class="border-t pt-3">
        <div class="flex justify-end">
            <div class="w-64 space-y-1 text-sm">
                <div class="flex justify-between"><span class="text-gray-600">Gross Amount</span><span>₱{sale.gross_amount|number_format:2}</span></div>
                <div class="flex justify-between"><span class="text-gray-600">Discount</span><span>₱{sale.discount_amount|default:0|number_format:2}</span></div>
                <div class="flex justify-between"><span class="text-gray-600">Tax</span><span>₱{sale.tax_amount|default:0|number_format:2}</span></div>
                {if sale.installation_charge > 0}
                <div class="flex justify-between"><span class="text-gray-600">Installation</span><span>₱{sale.installation_charge|number_format:2}</span></div>
                {/if}
                {if sale.mobilization_charge > 0}
                <div class="flex justify-between"><span class="text-gray-600">Mobilization</span><span>₱{sale.mobilization_charge|number_format:2}</span></div>
                {/if}
                {if sale.other_charges > 0}
                <div class="flex justify-between"><span class="text-gray-600">Other Charges</span><span>₱{sale.other_charges|number_format:2}</span></div>
                {/if}
                <div class="flex justify-between font-semibold text-base border-t pt-1">
                    <span>Net Amount</span>
                    <span>₱{sale.net_amount|number_format:2}</span>
                </div>
                <div class="flex justify-between"><span class="text-gray-600">Collected</span><span class="text-green-600">₱{sale.total_collected|default:0|number_format:2}</span></div>
                <div class="flex justify-between"><span class="text-gray-600">Outstanding</span><span class="font-medium {if sale.outstanding|default:0 > 0}text-red-600{else}text-green-600{/if}">₱{sale.outstanding|default:0|number_format:2}</span></div>
                <div class="flex justify-between"><span class="text-gray-600">Status</span><span class="font-medium">{sale.status|default:'draft'}</span></div>
                <div class="flex justify-between"><span class="text-gray-600">Date</span><span>{sale.sales_date|default:sale.created_at}</span></div>
                <div class="flex justify-between"><span class="text-gray-600">Due Date</span><span>{sale.due_date|default:'—'}</span></div>
                <div class="flex justify-between"><span class="text-gray-600">Invoice #</span><span>{sale.invoice_number|default:'—'}</span></div>
                {if sale.quotation_id}
                <div class="flex justify-between"><span class="text-gray-600">Quotation</span><span><a href="/admin/project-audit-ledger/quotations/{sale.quotation_id}" class="text-blue-600 hover:text-blue-800">View Source</a></span></div>
                {/if}
                <div class="flex justify-between"><span class="text-gray-600">Notes</span><span>{sale.notes|default:'—'}</span></div>
            </div>
        </div>
    </div>
    <div class="mt-4 flex gap-2 no-print">
        <a href="/admin/project-audit-ledger/sales/{sale.id}/edit" class="px-3 py-1.5 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">Edit</a>
        <button onclick="window.print()" class="px-3 py-1.5 bg-gray-600 text-white text-sm rounded-lg hover:bg-gray-700">🖨 Print Invoice</button>
        <a href="/admin/project-audit-ledger/sales" class="px-3 py-1.5 bg-gray-200 text-gray-700 text-sm rounded-lg hover:bg-gray-300">Back</a>
    </div>
</div>
</div>