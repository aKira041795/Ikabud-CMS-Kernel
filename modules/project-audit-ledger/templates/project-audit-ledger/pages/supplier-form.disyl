<div class="max-w-4xl">
<div class="wb-panel">
    <div class="wb-panel__header"><h2 class="wb-section-title">{is_edit ? 'Edit Supplier' : 'Create Supplier'}</h2></div>
    <form onsubmit="return ajaxSubmit(this, '{if is_edit}Supplier updated{else}Supplier created{/if}')" action="/api/v1/project-audit-ledger/suppliers{if is_edit}{if supplier.id}/{supplier.id}{/if}{/if}" method="POST" class="wb-panel__body">
        {csrf_field | raw}
        <div class="wb-form-grid wb-form-grid--2">
            <div class="sm:col-span-2"><label class="wb-label wb-label--required" for="supplier-name">Name</label><input id="supplier-name" type="text" name="name" value="{supplier.name}" required class="wb-input"></div>
            <div><label class="wb-label" for="supplier-contact">Contact Person</label><input id="supplier-contact" type="text" name="contact_person" value="{supplier.contact_person}" class="wb-input"></div>
            <div><label class="wb-label" for="supplier-phone">Phone</label><input id="supplier-phone" type="tel" name="phone" value="{supplier.phone}" class="wb-input"></div>
            <div class="sm:col-span-2"><label class="wb-label" for="supplier-email">Email</label><input id="supplier-email" type="email" name="email" value="{supplier.email}" class="wb-input"></div>
        </div>
        <div class="wb-form-sticky-bar"><button type="submit" class="wb-btn wb-btn--primary">{is_edit ? 'Update' : 'Create'}</button><a href="/admin/project-audit-ledger/suppliers" class="wb-btn wb-btn--secondary">Cancel</a></div>
    </form>
</div>
</div>
