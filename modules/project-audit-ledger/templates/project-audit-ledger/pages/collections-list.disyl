<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="p-4 border-b border-gray-200 flex justify-between items-center">
        <h2 class="font-semibold text-gray-900">Collections</h2>
        <a href="/admin/project-audit-ledger/collections/create" class="px-3 py-1.5 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">+ Record Collection</a>
    </div>
    <table class="w-full text-sm">
        <thead><tr class="bg-gray-50 border-b border-gray-200">
            <th class="text-left py-3 px-4 font-semibold text-gray-600">Amount</th>
            <th class="text-left py-3 px-4 font-semibold text-gray-600">Invoice</th>
            <th class="text-left py-3 px-4 font-semibold text-gray-600">Client</th>
            <th class="text-left py-3 px-4 font-semibold text-gray-600">Project</th>
            <th class="text-left py-3 px-4 font-semibold text-gray-600">Method</th>
            <th class="text-left py-3 px-4 font-semibold text-gray-600">Status</th>
            <th class="text-left py-3 px-4 font-semibold text-gray-600">Date</th>
            <th class="text-left py-3 px-4 font-semibold text-gray-600"></th>
        </tr></thead>
        <tbody>
            {for c in collections}
            <tr class="border-b border-gray-100">
                <td class="py-3 px-4 font-medium text-green-600">₱{c.amount|default:0|number_format:2}</td>
                <td class="py-3 px-4 text-gray-700">{c.sales_number|default:'#'~c.sales_id}</td>
                <td class="py-3 px-4 text-gray-700">{c.client_name|default:'—'}</td>
                <td class="py-3 px-4 text-gray-700">{c.project_title|default:'—'}</td>
                <td class="py-3 px-4 text-xs text-gray-600">{c.payment_method|default:'—'}</td>
                <td class="py-3 px-4"><span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium {if c.status=='approved'}bg-green-100 text-green-700{elseif c.status=='rejected'}bg-red-100 text-red-700{else}bg-yellow-100 text-yellow-700{/if}">{c.status|default:'pending'}</span></td>
                <td class="py-3 px-4 text-xs text-gray-600">{c.payment_date|default:c.created_at}</td>
                <td class="py-3 px-4"><a href="/admin/project-audit-ledger/collections/{c.id}" class="text-xs text-blue-600 hover:text-blue-800 font-medium">View</a></td>
            </tr>
            {/for}
            {if collections|count == 0}
            <tr><td colspan="8" class="py-8 text-center text-gray-600">No collections recorded.</td></tr>
            {/if}
        </tbody>
    </table>
</div>
