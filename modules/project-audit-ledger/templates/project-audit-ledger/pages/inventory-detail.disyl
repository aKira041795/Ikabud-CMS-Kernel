<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 max-w-lg">
    <h2 class="font-semibold text-gray-900 mb-2">{material.name}</h2>
    <div class="space-y-2 text-sm">
        <div class="flex justify-between"><span class="text-gray-600">Stock Balance</span><span class="font-medium">{material.stock_qty|default:0}{if material.unit_name} {material.unit_name}{/if}</span></div>
        <div class="flex justify-between"><span class="text-gray-600">Avg Cost</span><span class="font-medium">₱{material.avg_cost|default:0|number_format:2}{if material.unit_name} / {material.unit_name}{/if}</span></div>
        {if material.conversion_factor > 0 && material.conversion_unit_name}
        <div class="flex justify-between text-xs text-gray-500"><span class="text-gray-500">Cost per {material.conversion_unit_name}</span><span>₱{(material.avg_cost|default:0 / material.conversion_factor)|number_format:4}</span></div>
        <div class="flex justify-between text-xs text-gray-500"><span class="text-gray-500">Conversion</span><span>1 {material.unit_name} = {material.conversion_factor|number_format:4} {material.conversion_unit_name}</span></div>
        {/if}
        <div class="flex justify-between"><span class="text-gray-600">Reorder Level</span><span>{material.reorder_level|default:'—'}{if material.unit_name && material.reorder_level} {material.unit_name}{/if}</span></div>
        <div class="flex justify-between"><span class="text-gray-600">Category</span><span>{material.category_name|default:'—'}</span></div>
        {if material.description}
        <div class="flex justify-between"><span class="text-gray-600">Description</span><span>{material.description}</span></div>
        {/if}
    </div>
    <div class="mt-2 flex gap-2"><a href="/admin/project-audit-ledger/inventory" class="text-xs text-gray-600 hover:text-gray-800 font-medium">← Back to Inventory</a><a href="/admin/project-audit-ledger/settings?tab=materials" class="text-xs text-blue-600 hover:text-blue-800 font-medium">Edit material details →</a></div>
    <hr class="my-4">
    <h3 class="font-semibold text-gray-900 mb-2">Adjust Stock</h3>
    <form onsubmit="return ajaxSubmit(this, 'Stock adjusted')" action="/api/v1/project-audit-ledger/inventory/adjust" method="POST" class="grid grid-cols-3 gap-3">
        {csrf_field | raw}
        <input type="hidden" name="material_id" value="{material.id}">
        <div><input type="number" step="0.01" name="quantity" placeholder="Qty (+/-)" required class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm"></div>
        <div><input type="text" name="reason" placeholder="Reason" required class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm"></div>
        <div><button type="submit" class="px-3 py-1.5 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">Adjust</button></div>
    </form>
</div>
