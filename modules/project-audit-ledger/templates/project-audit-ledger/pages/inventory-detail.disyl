<div class="max-w-2xl">
<div class="wb-panel p-6">
    <h2 class="font-semibold text-gray-900 mb-2">{material.name} <span class="text-xs text-gray-500 font-normal">#{material.id}</span></h2>
    <div class="grid grid-cols-2 gap-4 text-sm">
        <div class="col-span-2 border-b pb-2 mb-2"><span class="text-xs text-gray-500 uppercase tracking-wide">Stock Summary</span></div>
        <div><span class="text-gray-600">Stock Balance</span><br><span class="font-medium">{material.stock_qty|default:0}{if material.unit_name} {material.unit_name}{/if}</span></div>
        <div><span class="text-gray-600">Avg Cost</span><br><span class="font-medium">₱{material.avg_cost|default:0|number_format:2}{if material.unit_name} / {material.unit_name}{/if}</span>
        {if material.conversion_factor > 0 && material.conversion_unit_name}
        <br><span class="text-xs text-gray-500">= ₱{(material.avg_cost|default:0 / material.conversion_factor)|number_format:4} / {material.conversion_unit_name}</span>
        {/if}
        </div>
    </div>

    <form onsubmit="return ajaxSubmit(this, 'Material updated')" action="/api/v1/project-audit-ledger/settings/materials/{material.id}" method="POST" class="grid grid-cols-2 gap-3 mt-4">
        {csrf_field | raw}
        <div class="col-span-2 border-b pb-2 mb-2"><span class="text-xs text-gray-500 uppercase tracking-wide">Edit Material</span></div>

        <div class="col-span-2"><label class="wb-label">Name</label><input type="text" name="name" value="{material.name}" required class="wb-input"></div>

        <div><label class="wb-label">Code</label><input type="text" name="material_code" value="{material.material_code}" class="wb-input"></div>

        <div><label class="wb-label">Category</label><select name="category_id" class="wb-select detail-cat-select" data-creatable="material_category"><option value="">—</option>{for c in categories}<option value="{c.id}"{if material.category_id==c.id} selected{/if}>{c.name}</option>{/for}</select></div>

        <div><label class="wb-label">Unit (purchase)</label><select name="unit_id" class="wb-select detail-unit-select" data-creatable="unit"><option value="">—</option>{for u in units}<option value="{u.id}"{if material.unit_id==u.id} selected{/if}>{u.name}{if u.abbreviation} ({u.abbreviation}){/if}</option>{/for}</select></div>

        <div><label class="wb-label">Unit (cost conversion)</label><select name="conversion_unit_id" class="wb-select detail-conv-select" data-creatable="unit"><option value="">— (same as purchase unit)</option>{for u in units}<option value="{u.id}"{if material.conversion_unit_id==u.id} selected{/if}>{u.name}{if u.abbreviation} ({u.abbreviation}){/if}</option>{/for}</select></div>

        <div><label class="wb-label">Conversion factor</label><input type="number" step="0.000001" name="conversion_factor" value="{material.conversion_factor}" placeholder="e.g. 144 for sqft/roll" class="wb-input"><p class="text-xs text-gray-400 mt-1">How many {material.conversion_unit_name|default:'sub-units'} per purchase unit</p></div>

        <div><label class="wb-label">Avg Cost ({material.unit_name|default:'per unit'})</label><input type="number" step="0.01" name="current_avg_cost" value="{material.current_avg_cost|default:0}" class="wb-input"></div>

        <div><label class="wb-label">Supplier</label><select name="preferred_supplier_id" class="wb-select detail-supplier-select" data-creatable="supplier"><option value="">—</option>{for s in suppliers}<option value="{s.id}"{if material.preferred_supplier_id==s.id} selected{/if}>{s.name}</option>{/for}</select></div>

        <div><label class="wb-label">Reorder Level</label><input type="number" step="0.01" name="reorder_level" value="{material.reorder_level}" class="wb-input"></div>

        <div class="col-span-2"><label class="wb-label">Description</label><input type="text" name="description" value="{material.description}" placeholder="e.g. 18ft x 8ft roll" class="wb-input"></div>

        <div class="col-span-2 flex gap-2 mt-2"><button type="submit" class="wb-btn wb-btn--primary">Save Changes</button><a href="/admin/project-audit-ledger/inventory" class="wb-btn wb-btn--secondary">← Back to Inventory</a></div>
    </form>
    <script>document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('.detail-cat-select,.detail-unit-select,.detail-conv-select,.detail-supplier-select').forEach(function(e){if(e)makeCreatable(e);});});</script>

    <hr class="my-6">
    <h3 class="font-semibold text-gray-900 mb-2">Adjust Stock</h3>
    <form onsubmit="return ajaxSubmit(this, 'Stock adjusted')" action="/api/v1/project-audit-ledger/inventory/adjust" method="POST" class="grid grid-cols-3 gap-3">
        {csrf_field | raw}
        <input type="hidden" name="material_id" value="{material.id}">
        <div><input type="number" step="0.01" name="quantity" placeholder="Qty (+/-)" required class="wb-input"></div>
        <div><input type="text" name="reason" placeholder="Reason" required class="wb-input"></div>
        <div><button type="submit" class="wb-btn wb-btn--primary wb-btn--sm">Adjust</button></div>
    </form>
</div>
</div>
