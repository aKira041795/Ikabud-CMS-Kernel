<div class="max-w-2xl">
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="font-semibold text-gray-900 mb-2">{material.name} <span class="text-xs text-gray-500 font-normal">#{material.id}</span></h2>
    <div class="grid grid-cols-2 gap-4 text-sm">
        <div class="col-span-2 border-b pb-2 mb-2"><span class="text-xs text-gray-500 uppercase tracking-wide">Stock Summary</span></div>
        <div><span class="text-gray-600">Stock Balance</span><br><span class="font-medium">{material.stock_qty|default:0}{if material.unit_name} {material.unit_name}{/if}</span></div>
        <div><span class="text-gray-600">Avg Cost</span><br><span class="font-medium">₱{material.avg_cost|default:0|number_format:2}{if material.unit_name} / {material.unit_name}{/if}</span>
        {if material.conversion_factor > 0 && material.conversion_unit_name}
        <br><span class="text-xs text-gray-500">= ₱{(material.avg_cost|default:0 / material.conversion_factor)|number_format:4} / {material.conversion_unit_name}</span>
        {/if}
        </div>
    </div>

    <form onsubmit="return ajaxSubmit(this, 'Material updated')" action="/api/v1/project-audit-ledger/settings/materials/{material.id}" method="POST" class="grid grid-cols-2 gap-3 mt-4">
        {csrf_field | raw}
        <div class="col-span-2 border-b pb-2 mb-2"><span class="text-xs text-gray-500 uppercase tracking-wide">Edit Material</span></div>

        <div class="col-span-2"><label class="block text-xs font-medium text-gray-600 mb-1">Name</label><input type="text" name="name" value="{material.name}" required class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm"></div>

        <div><label class="block text-xs font-medium text-gray-600 mb-1">Code</label><input type="text" name="material_code" value="{material.material_code}" class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm"></div>

        <div><label class="block text-xs font-medium text-gray-600 mb-1">Category</label><select name="category_id" class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm detail-cat-select" data-creatable="material_category"><option value="">—</option>{for c in categories}<option value="{c.id}"{if material.category_id==c.id} selected{/if}>{c.name}</option>{/for}</select></div>

        <div><label class="block text-xs font-medium text-gray-600 mb-1">Unit (purchase)</label><select name="unit_id" class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm detail-unit-select" data-creatable="unit"><option value="">—</option>{for u in units}<option value="{u.id}"{if material.unit_id==u.id} selected{/if}>{u.name}{if u.abbreviation} ({u.abbreviation}){/if}</option>{/for}</select></div>

        <div><label class="block text-xs font-medium text-gray-600 mb-1">Unit (cost conversion)</label><select name="conversion_unit_id" class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm detail-conv-select" data-creatable="unit"><option value="">— (same as purchase unit)</option>{for u in units}<option value="{u.id}"{if material.conversion_unit_id==u.id} selected{/if}>{u.name}{if u.abbreviation} ({u.abbreviation}){/if}</option>{/for}</select></div>

        <div><label class="block text-xs font-medium text-gray-600 mb-1">Conversion factor</label><input type="number" step="0.000001" name="conversion_factor" value="{material.conversion_factor}" placeholder="e.g. 144 for sqft/roll" class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm"><p class="text-xs text-gray-400 mt-1">How many {material.conversion_unit_name|default:'sub-units'} per purchase unit</p></div>

        <div><label class="block text-xs font-medium text-gray-600 mb-1">Avg Cost ({material.unit_name|default:'per unit'})</label><input type="number" step="0.01" name="current_avg_cost" value="{material.current_avg_cost|default:0}" class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm"></div>

        <div><label class="block text-xs font-medium text-gray-600 mb-1">Supplier</label><select name="preferred_supplier_id" class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm detail-supplier-select" data-creatable="supplier"><option value="">—</option>{for s in suppliers}<option value="{s.id}"{if material.preferred_supplier_id==s.id} selected{/if}>{s.name}</option>{/for}</select></div>

        <div><label class="block text-xs font-medium text-gray-600 mb-1">Reorder Level</label><input type="number" step="0.01" name="reorder_level" value="{material.reorder_level}" class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm"></div>

        <div class="col-span-2"><label class="block text-xs font-medium text-gray-600 mb-1">Description</label><input type="text" name="description" value="{material.description}" placeholder="e.g. 18ft x 8ft roll" class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm"></div>

        <div class="col-span-2 flex gap-2 mt-2"><button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">Save Changes</button><a href="/admin/project-audit-ledger/inventory" class="px-4 py-2 bg-gray-200 text-gray-700 text-sm rounded-lg hover:bg-gray-300">← Back to Inventory</a></div>
    </form>
    <script>document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('.detail-cat-select,.detail-unit-select,.detail-conv-select,.detail-supplier-select').forEach(function(e){if(e)makeCreatable(e);});});</script>

    <hr class="my-6">
    <h3 class="font-semibold text-gray-900 mb-2">Adjust Stock</h3>
    <form onsubmit="return ajaxSubmit(this, 'Stock adjusted')" action="/api/v1/project-audit-ledger/inventory/adjust" method="POST" class="grid grid-cols-3 gap-3">
        {csrf_field | raw}
        <input type="hidden" name="material_id" value="{material.id}">
        <div><input type="number" step="0.01" name="quantity" placeholder="Qty (+/-)" required class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm"></div>
        <div><input type="text" name="reason" placeholder="Reason" required class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm"></div>
        <div><button type="submit" class="px-3 py-1.5 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">Adjust</button></div>
    </form>
</div>
</div>
