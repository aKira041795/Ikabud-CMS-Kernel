{set _dh_title = client.name}
{set _dh_status = client.is_active==1 ? 'active' : 'inactive'}
{set _dh_actions = '<a href="/admin/project-audit-ledger/clients/' ~ client.id ~ '/edit" class="wb-btn wb-btn--primary wb-btn--sm">Edit</a> <a href="/admin/project-audit-ledger/clients" class="wb-btn wb-btn--secondary wb-btn--sm">Back</a>'}
{include "workbench:detail_header" title=_dh_title|default:'' subtitle=_dh_subtitle|default:'' status_badge=_dh_status|default:'' actions=_dh_actions|default:''}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="wb-panel p-6">
        <div class="space-y-3 text-sm">
            <div class="flex justify-between"><span class="text-gray-600">Contact</span><span class="font-medium">{client.contact_person|default:'—'}</span></div>
            <div class="flex justify-between"><span class="text-gray-600">Email</span><span class="font-medium">{client.email|default:'—'}</span></div>
            <div class="flex justify-between"><span class="text-gray-600">Phone</span><span class="font-medium">{client.phone|default:'—'}</span></div>
            <div class="flex justify-between"><span class="text-gray-600">Address</span><span class="font-medium">{client.address|default:'—'}</span></div>
            <div class="flex justify-between"><span class="text-gray-600">Status</span><span>{if client.is_active==1}<span class="text-green-600 font-medium">Active</span>{else}<span class="text-red-600 font-medium">Inactive</span>{/if}</span></div>
        </div>
    </div>
    <div class="lg:col-span-2 wb-panel">
        <div class="wb-panel__header"><span class="wb-panel__title">Linked Projects ({clientProjects|count})</span></div>
        <table class="w-full text-sm">
            <thead><tr class="bg-gray-50 border-b"><th class="text-left py-2 px-4 font-semibold text-gray-600">Project</th><th class="text-left py-2 px-4 font-semibold text-gray-600">Status</th><th class="text-left py-2 px-4 font-semibold text-gray-600">Amount</th><th class="text-left py-2 px-4 font-semibold text-gray-600">Dates</th><th class="text-left py-2 px-4 font-semibold text-gray-600"></th></tr></thead>
            <tbody>
                {for p in clientProjects}
                <tr class="border-b border-gray-100"><td class="py-2 px-4 font-medium">{p.title}</td><td class="py-2 px-4">{p.status|default:'draft'}</td><td class="py-2 px-4">₱{p.contract_amount|default:0|number_format:2}</td><td class="py-2 px-4 text-xs">{p.start_date|default:'—'} → {p.target_completion_date|default:'—'}</td><td class="py-2 px-4"><a href="/admin/project-audit-ledger/projects/{p.id}" class="text-xs text-blue-600 font-medium">View</a></td></tr>
                {/for}
                {if clientProjects|count == 0}
                <tr><td colspan="5" class="py-8 text-center text-gray-600">No projects linked to this client.</td></tr>
                {/if}
            </tbody>
        </table>
    </div>
</div>
