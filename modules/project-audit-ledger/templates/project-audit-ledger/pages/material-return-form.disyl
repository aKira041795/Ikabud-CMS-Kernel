<div class="max-w-lg">
<div class="wb-panel p-6">
    <h2 class="wb-section__title mb-4">Record Material Return</h2>
    <form onsubmit="return ajaxSubmit(this, 'Return recorded')" action="/api/v1/project-audit-ledger/materials/return" method="POST" class="wb-form-surface">
        {csrf_field | raw}
        <div><label class="wb-label wb-label--required">Project</label><select name="project_id" required class="wb-select" data-creatable="project"><option value="">—</option>{for p in projects}<option value="{p.id}">{if p.job_order_number}{p.job_order_number} — {/if}{p.title}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.querySelector('select[name=project_id]');if(e)makeCreatable(e);});</script></div>
        <div><label class="wb-label wb-label--required">Material</label><select name="material_id" required class="wb-select" data-creatable="material"><option value="">—</option>{for m in materials}<option value="{m.id}">{m.name}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.querySelector('select[name=material_id]');if(e)makeCreatable(e);});</script></div>
        <div><label class="wb-label wb-label--required">Quantity</label><input type="number" step="0.01" name="quantity" required class="wb-input"></div>
        <div><label class="wb-label">Condition</label><select name="condition" class="wb-select"><option value="reusable">Reusable</option><option value="damaged">Damaged</option><option value="wasted">Wasted</option><option value="scrap">Scrap</option></select></div>
        <div><label class="wb-label">Reference Issuance</label><select name="issuance_id" class="wb-select"><option value="">—</option>{for i in issuances}<option value="{i.id}">{i.issuance_number|default:'#'~i.id}</option>{/for}</select></div>
        <div><label class="wb-label">Return Date</label><input type="date" name="return_date" value="{'now'|date:'Y-m-d'}" class="wb-input"></div>
        <div><label class="wb-label">Reason / Notes</label><textarea name="reason" rows="2" class="wb-textarea"></textarea></div>
        <button type="submit" class="wb-btn wb-btn--primary">Record Return</button>
    </form>
</div>
</div>
