<div class="max-w-lg">
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="font-semibold text-gray-900 mb-4">Record Material Return</h2>
    <form onsubmit="return ajaxSubmit(this, 'Return recorded')" action="/api/v1/project-audit-ledger/materials/return" method="POST" class="space-y-4">
        {csrf_field | raw}
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Project *</label><select name="project_id" required class="w-full px-3 py-2 border border-gray-300 rounded text-sm" data-creatable="project"><option value="">—</option>{for p in projects}<option value="{p.id}">{p.title}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.querySelector('select[name=project_id]');if(e)makeCreatable(e);});</script></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Material *</label><select name="material_id" required class="w-full px-3 py-2 border border-gray-300 rounded text-sm" data-creatable="material"><option value="">—</option>{for m in materials}<option value="{m.id}">{m.name}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.querySelector('select[name=material_id]');if(e)makeCreatable(e);});</script></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Quantity *</label><input type="number" step="0.01" name="quantity" required class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Condition</label><select name="condition" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><option value="reusable">Reusable</option><option value="damaged">Damaged</option><option value="wasted">Wasted</option><option value="scrap">Scrap</option></select></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Reference Issuance</label><select name="issuance_id" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><option value="">—</option>{for i in issuances}<option value="{i.id}">{i.issuance_number|default:'#'~i.id}</option>{/for}</select></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Return Date</label><input type="date" name="return_date" value="{'now'|date:'Y-m-d'}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Reason / Notes</label><textarea name="reason" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></textarea></div>
        <button type="submit" class="wb-btn wb-btn--primary">Record Return</button>
    </form>
</div>
</div>
