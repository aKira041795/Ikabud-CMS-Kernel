<form method="GET" class="flex gap-3 items-end mb-4">
    <div>
        <label class="block text-xs text-gray-600 mb-1">From</label>
        <input type="date" name="date_from" value="{date_from}" class="wb-input">
    </div>
    <div>
        <label class="block text-xs text-gray-600 mb-1">To</label>
        <input type="date" name="date_to" value="{date_to}" class="wb-input">
    </div>
    <div>
        <button type="submit" class="wb-btn wb-btn--primary wb-btn--sm">Filter</button>
    </div>
</form>

{if groups|count > 0}
<div class="mb-4 text-sm">
    {for g in groups}
    <span class="inline-flex items-center px-2 py-1 rounded bg-blue-100 text-blue-700 text-xs font-medium mr-2">{g.name}</span>
    {/for}
</div>
{/if}

<div class="wb-panel">
        <thead>
            <tr class="bg-gray-50 border-b">
                <th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Employee</th>
                <th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Date</th>
                <th class="text-center py-2 px-3 font-semibold text-gray-600 text-xs">Clock In</th>
                <th class="text-center py-2 px-3 font-semibold text-gray-600 text-xs">Clock Out</th>
                <th class="text-right py-2 px-3 font-semibold text-gray-600 text-xs">Hours</th>
                <th class="text-center py-2 px-3 font-semibold text-gray-600 text-xs">Status</th>
                <th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Group</th>
            </tr>
        </thead>
        <tbody>
            {for a in attendance}
            <tr class="border-b border-gray-100">
                <td class="py-2 px-3 text-sm">{a.employee_name}<br><span class="text-xs text-gray-500">{a.position|default:''}</span></td>
                <td class="py-2 px-3 text-xs">{a.clock_in|substr:0:10}</td>
                <td class="py-2 px-3 text-xs text-center">{a.clock_in|substr:11:8}</td>
                <td class="py-2 px-3 text-xs text-center">{if a.clock_out}{a.clock_out|substr:11:8}{else}—{/if}</td>
                <td class="py-2 px-3 text-xs text-right font-medium">{a.hours_worked|default:0}</td>
                <td class="py-2 px-3 text-center">
                    <span class="inline-flex px-1.5 py-0.5 rounded-full text-xs font-medium {if a.status=='completed'}bg-green-100 text-green-700{else}bg-yellow-100 text-yellow-700{/if}">{a.status|default:'active'}</span>
                </td>
                <td class="py-2 px-3 text-xs text-gray-500">{a.group_name|default:'—'}</td>
            </tr>
            {else}
            <tr><td colspan="7" class="py-6 text-center text-gray-600 text-sm">No attendance records found for this period.</td></tr>
            {/for}
        </tbody>
    </table>
</div>