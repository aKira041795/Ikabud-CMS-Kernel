<form method="GET" class="flex gap-3 items-end mb-4" data-wb-region="attendance-filter">
    <div>
        <label class="block text-xs text-gray-600 mb-1">From</label>
        <input type="date" name="date_from" value="{date_from}" class="wb-input" data-wb-field="date_from">
    </div>
    <div>
        <label class="block text-xs text-gray-600 mb-1">To</label>
        <input type="date" name="date_to" value="{date_to}" class="wb-input" data-wb-field="date_to">
    </div>
    <div>
        <button type="submit" class="wb-btn wb-btn--primary wb-btn--sm" data-wb-action="filter">Filter</button>
    </div>
    {if employee_summary|count > 0}
    <div class="ml-auto">
        <a href="/admin/project-audit-ledger/team-lead/mobilization/create?attendance_group_id={groups.0.group_id}&date_from={date_from}&date_to={date_to}"
           class="wb-btn wb-btn--primary wb-btn--sm" data-wb-action="request-mobilization">+ Request Mobilization</a>
    </div>
    {/if}
</form>

{if groups|count > 0}
<div class="mb-4 text-sm" data-wb-region="attendance-groups">
    {for g in groups}
    <span class="inline-flex items-center px-2 py-1 rounded bg-blue-100 text-blue-700 text-xs font-medium mr-2" data-wb-tag="group">{g.name}</span>
    {/for}
</div>
{/if}

<!-- Salary/Wage Summary from AW capability -->
{if employee_summary|count > 0}
<div class="mb-4" data-wb-region="attendance-salary-summary">
    <div class="wb-panel p-4">
        <h3 class="text-sm font-semibold text-gray-800 mb-2">Wage Estimate</h3>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-gray-100 text-xs">
                        <th class="text-left py-1.5 px-2">Employee</th>
                        <th class="text-center py-1.5 px-2">Type</th>
                        <th class="text-center py-1.5 px-2">Days</th>
                        <th class="text-right py-1.5 px-2">Hours</th>
                        <th class="text-right py-1.5 px-2">Est. Pay</th>
                    </tr>
                </thead>
                <tbody>
                    {for es in employee_summary}
                    <tr class="border-b border-gray-100">
                        <td class="py-1.5 px-2 font-medium text-xs">{es.name}</td>
                        <td class="py-1.5 px-2 text-center text-xs">{es.salary_type}</td>
                        <td class="py-1.5 px-2 text-center text-xs">{es.days_worked}</td>
                        <td class="py-1.5 px-2 text-right text-xs">{es.total_hours|round:1}</td>
                        <td class="py-1.5 px-2 text-right text-xs font-semibold">₱{es.computed_salary|number_format:2}</td>
                    </tr>
                    {/for}
                </tbody>
                <tfoot>
                    <tr class="bg-gray-50 font-semibold text-xs">
                        <td class="py-1.5 px-2" colspan="3">Totals &middot; {totals.record_count} records</td>
                        <td class="py-1.5 px-2 text-right">{totals.total_hours|round:1}</td>
                        <td class="py-1.5 px-2 text-right">₱{totals.total_computed_wages|number_format:2}</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
{/if}

<div class="wb-panel" data-wb-region="attendance-table">
    <div class="overflow-x-auto">
        <table class="w-full">
        <thead>
            <tr class="bg-gray-50 border-b">
                <th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Employee</th>
                <th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Date</th>
                <th class="text-center py-2 px-3 font-semibold text-gray-600 text-xs">Clock In</th>
                <th class="text-center py-2 px-3 font-semibold text-gray-600 text-xs">Clock Out</th>
                <th class="text-right py-2 px-3 font-semibold text-gray-600 text-xs">Hours</th>
                <th class="text-center py-2 px-3 font-semibold text-gray-600 text-xs">Status</th>
                <th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Group</th>
            </tr>
        </thead>
        <tbody>
            {if attendance|count > 0}
            {for a in attendance}
            <tr class="border-b border-gray-100" data-wb-row="attendance" data-wb-id="{a.attendance_id}">
                <td class="py-2 px-3 text-sm" data-wb-cell="employee_name">{a.employee_name}<br><span class="text-xs text-gray-500">{a.position|default:''}</span></td>
                <td class="py-2 px-3 text-xs" data-wb-cell="date">{a.clock_in|substr:0:10}</td>
                <td class="py-2 px-3 text-xs text-center" data-wb-cell="clock_in">{a.clock_in|substr:11:8}</td>
                <td class="py-2 px-3 text-xs text-center" data-wb-cell="clock_out">{if a.clock_out}{a.clock_out|substr:11:8}{else}—{/if}</td>
                <td class="py-2 px-3 text-xs text-right font-medium" data-wb-cell="hours">{a.hours_worked|default:0}</td>
                <td class="py-2 px-3 text-center" data-wb-cell="status">
                    <span class="inline-flex px-1.5 py-0.5 rounded-full text-xs font-medium {if a.status=='completed'}bg-green-100 text-green-700{elseif a.status=='active'}bg-yellow-100 text-yellow-700{else}bg-gray-100 text-gray-600{/if}">{a.status|default:'active'}</span>
                </td>
                <td class="py-2 px-3 text-xs text-gray-500" data-wb-cell="group">{a.group_name|default:'—'}</td>
            </tr>
            {/for}
            {else}
            <tr><td colspan="7" class="py-6 text-center text-gray-600 text-sm" data-wb-empty="attendance">No attendance records found for this period.</td></tr>
            {/if}
        </tbody>
        </table>
    </div>
</div>