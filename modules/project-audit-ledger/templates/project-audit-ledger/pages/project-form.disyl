<div class="max-w-4xl" x-data="{ joType: '{if project.items && project.items|count > 0}items{else}contract{/if}', hasInstallation: {if project.with_installation}true{else}false{/if} }">
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="font-semibold text-gray-900 mb-4">{is_edit|default:false ? 'Edit Job Order' : 'Create Job Order'}</h2>
    <form onsubmit="return ajaxSubmit(this, '{if is_edit}JO updated{else}JO created{/if}')" action="/api/v1/project-audit-ledger/projects{if is_edit}{if project.id}/{project.id}{/if}{/if}" method="POST" class="space-y-4">
        {csrf_field | raw}
        <div class="grid grid-cols-2 gap-4">
            <div class="col-span-2"><label class="block text-sm font-medium text-gray-700 mb-1">Title / Job Description *</label><input type="text" name="title" value="{project.title}" required class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div class="col-span-2"><label class="block text-sm font-medium text-gray-700 mb-1">Description</label><textarea name="description" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded text-sm">{project.description}</textarea></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Client</label><select name="client_id" id="sel-client" class="w-full px-3 py-2 border border-gray-300 rounded text-sm" data-creatable="client"><option value="">—</option>{for c in clients}<option value="{c.id}"{if project.client_id==c.id} selected{/if}>{c.name}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.getElementById('sel-client');if(e)makeCreatable(e);});</script></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">JO Number</label><input type="text" name="job_order_number" value="{project.job_order_number}" placeholder="Auto-generated if empty" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Scope of Work</label><select name="scope_of_work" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><option value="">—</option><option value="new"{if project.scope_of_work=='new'} selected{/if}>New</option><option value="refurbish"{if project.scope_of_work=='refurbish'} selected{/if}>Refurbish</option><option value="warranty_claim"{if project.scope_of_work=='warranty_claim'} selected{/if}>Warranty Claim</option><option value="labor_only"{if project.scope_of_work=='labor_only'} selected{/if}>Labor Only</option><option value="print_only"{if project.scope_of_work=='print_only'} selected{/if}>Print Only</option></select></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Project Type</label><select name="project_type_id" id="sel-proj-type" class="w-full px-3 py-2 border border-gray-300 rounded text-sm" data-creatable="project_type"><option value="">—</option>{for t in project_types}<option value="{t.id}"{if project.project_type_id==t.id} selected{/if}>{t.name}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.getElementById('sel-proj-type');if(e)makeCreatable(e);});</script></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Status</label><select name="status" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><option value="draft"{if project.status=='draft'} selected{/if}>Draft</option><option value="pending"{if project.status=='pending'} selected{/if}>Pending</option><option value="approved"{if project.status=='approved'} selected{/if}>Approved</option><option value="started"{if project.status=='started'} selected{/if}>Started</option><option value="ongoing"{if project.status=='ongoing'} selected{/if}>Ongoing</option><option value="completed"{if project.status=='completed'} selected{/if}>Completed</option></select></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Start Date</label><input type="date" name="start_date" value="{project.start_date}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Target End</label><input type="date" name="target_completion_date" value="{project.target_completion_date}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>

            <!-- JO Type Toggle -->
            <div class="col-span-2 border-t pt-4 mt-2"><h3 class="text-sm font-semibold text-gray-800 mb-2">📋 JO Type</h3></div>
            <div class="col-span-2 flex gap-4">
                <label class="flex items-center gap-2 text-sm cursor-pointer" @click="joType='items'"><input type="radio" name="_jo_type" value="items" x-bind:checked="joType==='items'" class="rounded-full border-gray-300" :disabled="joType==='items'"> <span :class="joType==='items' ? 'font-semibold text-blue-600' : 'text-gray-500'">📋 Quotation Items</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer" @click="joType='contract'"><input type="radio" name="_jo_type" value="contract" x-bind:checked="joType==='contract'" class="rounded-full border-gray-300" :disabled="joType==='contract'"> <span :class="joType==='contract' ? 'font-semibold text-blue-600' : 'text-gray-500'">💰 Contracted Amount</span></label>
            </div>

            <!-- Contracted Amount (visible when joType=contract) -->
            <div class="col-span-2" x-show="joType==='contract'"><label class="block text-sm font-medium text-gray-700 mb-1">Contract Amount *</label><input type="number" step="0.01" name="contract_amount" value="{project.contract_amount|default:''}" x-bind:required="joType==='contract'" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><p class="text-xs text-gray-600 mt-1">Total contract value — no line items breakdown</p></div>

            <!-- Charges -->
            <div class="col-span-2 border-t pt-4 mt-2" x-show="joType==='items'"><h3 class="text-sm font-semibold text-gray-800 mb-2">💰 Charges</h3></div>
            <div x-show="joType==='items'"><label class="block text-sm font-medium text-gray-700 mb-1">Installation Charge</label><input type="number" step="0.01" name="installation_charge" value="{project.installation_charge|default:0}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div x-show="joType==='items'"><label class="block text-sm font-medium text-gray-700 mb-1">Mobilization Charge</label><input type="number" step="0.01" name="mobilization_charge" value="{project.mobilization_charge|default:0}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div x-show="joType==='items'"><label class="block text-sm font-medium text-gray-700 mb-1">Other Charges</label><input type="number" step="0.01" name="other_charges" value="{project.other_charges|default:0}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Mode of Payment</label><select name="mode_of_payment" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><option value="">—</option><option value="cash"{if project.mode_of_payment=='cash'} selected{/if}>Cash</option><option value="check"{if project.mode_of_payment=='check'} selected{/if}>Check</option><option value="bank_transfer"{if project.mode_of_payment=='bank_transfer'} selected{/if}>Bank Transfer</option><option value="gcash"{if project.mode_of_payment=='gcash'} selected{/if}>Gcash</option></select></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Down Payment</label><input type="number" step="0.01" name="down_payment" value="{project.down_payment|default:''}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">With Installation</label><label class="flex items-center gap-2 mt-2"><input type="checkbox" name="with_installation" value="1" x-model="hasInstallation" class="rounded border-gray-300"> <span class="text-sm">Yes</span></label></div>

            <!-- Team Lead (only when With Installation = YES, works for both JO types) -->
            <template x-if="hasInstallation">
            <div class="col-span-2 border-t pt-4 mt-2"><h3 class="text-sm font-semibold text-gray-800 mb-2">👤 Team Lead</h3></div>
            </template>
            <template x-if="hasInstallation">
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Team Lead</label><select name="fabrication_team_lead_id" id="sel-tl" class="w-full px-3 py-2 border border-gray-300 rounded text-sm" data-creatable="team_lead"><option value="">—</option>{for l in team_leads}<option value="{l.id}"{if project.fabrication_team_lead_id==l.id} selected{/if}>{l.name}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.getElementById('sel-tl');if(e)makeCreatable(e);});</script></div>
            </template>
            <template x-if="hasInstallation">
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Allocation Basis</label><select name="fabrication_alloc_basis" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><option value="expenses"{if project.fabrication_alloc_basis=='expenses'} selected{/if}>Expenses</option><option value="labor_materials"{if project.fabrication_alloc_basis=='labor_materials'} selected{/if}>Labor + Materials</option><option value="contract"{if project.fabrication_alloc_basis=='contract'} selected{/if}>Contract Amount</option><option value="fixed"{if project.fabrication_alloc_basis=='fixed'} selected{/if}>Fixed Amount</option><option value="manual"{if project.fabrication_alloc_basis=='manual'} selected{/if}>Manual</option></select></div>
            </template>
            <template x-if="hasInstallation">
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Allocation %</label><input type="number" step="0.01" name="fabrication_alloc_pct" value="{project.fabrication_alloc_pct|default:25}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><p class="text-xs text-gray-600 mt-1">% of basis amount allocated to fabrication</p></div>
            </template>
            <input type="hidden" name="_jo_type" x-bind:value="joType">
        </div>

        <!-- Line Items (visible when joType=items) -->
        <div class="border-t pt-4 mt-4" x-show="joType==='items'">
            <h3 class="text-sm font-semibold text-gray-800 mb-2">📋 Line Items</h3>
            <div class="overflow-x-auto">
                <table class="w-full text-sm border-collapse" id="items-table">
                    <thead>
                        <tr class="bg-gray-100 text-xs text-gray-600">
                            <th class="text-left py-2 px-2">#</th>
                            <th class="text-left py-2 px-2">Material</th>
                            <th class="text-left py-2 px-2">Particulars</th>
                            <th class="text-center py-2 px-2">Width</th>
                            <th class="text-center py-2 px-2">Height</th>
                            <th class="text-center py-2 px-2">QTY</th>
                            <th class="text-right py-2 px-2">Price/Unit</th>
                            <th class="text-right py-2 px-2">Price/SqFt</th>
                            <th class="text-right py-2 px-2">Total</th>
                            <th class="text-center py-2 px-2"></th>
                        </tr>
                    </thead>
                    <tbody id="items-body">
                        {for item in project.items}
                        <tr class="border-b border-gray-200 item-row">
                            <td class="py-2 px-2 text-center item-num">{item.sort_order}</td>
                            <td class="py-2 px-2">
                                <select name="items[{item.sort_order}][material_id]" class="w-full px-2 py-1 border border-gray-300 rounded text-xs" onchange="selMat(this)">
                                    <option value="">—</option>
                                    {for m in materials}
                                    <option value="{m.id}" data-ppu="{m.price_per_unit}" data-psf="{m.price_per_sqft}" data-w="{m.default_width}" data-h="{m.default_height}"{if item.material_id==m.id} selected{/if}>{m.name}</option>
                                    {/for}
                                </select>
                            </td>
                            <td class="py-2 px-2"><input type="text" name="items[{item.sort_order}][particulars]" value="{item.particulars}" class="w-full px-2 py-1 border border-gray-300 rounded text-xs" oninput="calcRow(this)"></td>
                            <td class="py-2 px-2"><input type="number" step="0.01" name="items[{item.sort_order}][width]" value="{item.width}" class="w-16 px-2 py-1 border border-gray-300 rounded text-xs text-center" oninput="calcRow(this)"></td>
                            <td class="py-2 px-2"><input type="number" step="0.01" name="items[{item.sort_order}][height]" value="{item.height}" class="w-16 px-2 py-1 border border-gray-300 rounded text-xs text-center" oninput="calcRow(this)"></td>
                            <td class="py-2 px-2"><input type="number" step="0.01" name="items[{item.sort_order}][quantity]" value="{item.quantity}" class="w-16 px-2 py-1 border border-gray-300 rounded text-xs text-center" oninput="calcRow(this)"></td>
                            <td class="py-2 px-2"><input type="number" step="0.01" name="items[{item.sort_order}][price_per_unit]" value="{item.price_per_unit}" class="w-20 px-2 py-1 border border-gray-300 rounded text-xs text-right" oninput="calcRow(this)"></td>
                            <td class="py-2 px-2"><input type="number" step="0.01" name="items[{item.sort_order}][price_per_sqft]" value="{item.price_per_sqft}" class="w-20 px-2 py-1 border border-gray-300 rounded text-xs text-right" oninput="calcRow(this)"></td>
                            <td class="py-2 px-2 text-right font-medium item-total">₱{item.line_total|number_format:2}</td>
                            <td class="py-2 px-2 text-center"><button type="button" onclick="this.closest('tr').remove(); renumItems();" class="text-red-500 hover:text-red-700 text-xs">✕</button></td>
                        </tr>
                        {/for}
                    </tbody>
                </table>
            </div>
            <button type="button" onclick="addItem()" class="mt-2 px-3 py-1.5 bg-gray-100 text-gray-700 text-sm rounded-lg hover:bg-gray-200 border border-gray-300">+ Add Item</button>
            <div class="text-right mt-2">
                <span class="text-sm text-gray-600">Subtotal: </span><span class="text-sm font-semibold" id="items-subtotal">₱0.00</span>
            </div>
        </div>

        <div class="flex gap-3"><button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">{is_edit ? 'Update' : 'Create'} Job Order</button> <a href="/admin/project-audit-ledger/projects" class="px-4 py-2 bg-gray-200 text-gray-700 text-sm rounded-lg hover:bg-gray-300">Cancel</a></div>
    </form>
</div>
</div>

<script>
var matData = {for m in materials}{m.id}:{ppu:m.price_per_unit,psf:m.price_per_sqft,w:m.default_width,h:m.default_height},{/for};
var itemIdx = {project.items ? project.items.length : 0};
function addItem() {
    itemIdx++;
    var tbody = document.getElementById('items-body');
    var tr = document.createElement('tr');
    tr.className = 'border-b border-gray-200 item-row';
    var matOpts = '<option value="">—</option>';
    {for m in materials}
    matOpts += '<option value="{m.id}" data-ppu="{m.price_per_unit}" data-psf="{m.price_per_sqft}" data-w="{m.default_width}" data-h="{m.default_height}">{m.name}</option>';
    {/for}
    tr.innerHTML = '<td class="py-2 px-2 text-center item-num">' + itemIdx + '</td>' +
        '<td class="py-2 px-2"><select name="items[' + itemIdx + '][material_id]" class="w-full px-2 py-1 border border-gray-300 rounded text-xs" onchange="selMat(this)">' + matOpts + '</select></td>' +
        '<td class="py-2 px-2"><input type="text" name="items[' + itemIdx + '][particulars]" class="w-full px-2 py-1 border border-gray-300 rounded text-xs" oninput="calcRow(this)"></td>' +
        '<td class="py-2 px-2"><input type="number" step="0.01" name="items[' + itemIdx + '][width]" class="w-16 px-2 py-1 border border-gray-300 rounded text-xs text-center" oninput="calcRow(this)"></td>' +
        '<td class="py-2 px-2"><input type="number" step="0.01" name="items[' + itemIdx + '][height]" class="w-16 px-2 py-1 border border-gray-300 rounded text-xs text-center" oninput="calcRow(this)"></td>' +
        '<td class="py-2 px-2"><input type="number" step="0.01" name="items[' + itemIdx + '][quantity]" value="1" class="w-16 px-2 py-1 border border-gray-300 rounded text-xs text-center" oninput="calcRow(this)"></td>' +
        '<td class="py-2 px-2"><input type="number" step="0.01" name="items[' + itemIdx + '][price_per_unit]" class="w-20 px-2 py-1 border border-gray-300 rounded text-xs text-right" oninput="calcRow(this)"></td>' +
        '<td class="py-2 px-2"><input type="number" step="0.01" name="items[' + itemIdx + '][price_per_sqft]" class="w-20 px-2 py-1 border border-gray-300 rounded text-xs text-right" oninput="calcRow(this)"></td>' +
        '<td class="py-2 px-2 text-right font-medium item-total">₱0.00</td>' +
        '<td class="py-2 px-2 text-center"><button type="button" onclick="this.closest(\'tr\').remove(); renumItems();" class="text-red-500 hover:text-red-700 text-xs">✕</button></td>';
    tbody.appendChild(tr);
}
function selMat(sel) {
    var opt = sel.options[sel.selectedIndex];
    var row = sel.closest('tr');
    if (!row) return;
    if (opt.value && matData[opt.value]) {
        var d = matData[opt.value];
        row.querySelector('[name$="[particulars]"]').value = opt.text;
        if (d.w) row.querySelector('[name$="[width]"]').value = d.w;
        if (d.h) row.querySelector('[name$="[height]"]').value = d.h;
        if (d.ppu) row.querySelector('[name$="[price_per_unit]"]').value = d.ppu;
        if (d.psf) row.querySelector('[name$="[price_per_sqft]"]').value = d.psf;
    }
    calcRow(sel);
}
function calcRow(el) {
    var row = el.closest('tr');
    if (!row) return;
    var w = parseFloat(row.querySelector('[name$="[width]"]').value) || 0;
    var h = parseFloat(row.querySelector('[name$="[height]"]').value) || 0;
    var qty = parseFloat(row.querySelector('[name$="[quantity]"]').value) || 1;
    var ppu = parseFloat(row.querySelector('[name$="[price_per_unit]"]').value) || 0;
    var psf = parseFloat(row.querySelector('[name$="[price_per_sqft]"]').value) || 0;
    var total = 0;
    if (psf > 0 && w > 0 && h > 0) {
        total = w * h * psf * qty;
    } else {
        total = ppu * qty;
    }
    row.querySelector('.item-total').textContent = '₱' + total.toFixed(2);
    calcSubtotal();
}
function calcSubtotal() {
    var sum = 0;
    document.querySelectorAll('.item-total').forEach(function(el) {
        sum += parseFloat(el.textContent.replace(/[₱,]/g, '')) || 0;
    });
    document.getElementById('items-subtotal').textContent = '₱' + sum.toFixed(2);
}
function renumItems() {
    var rows = document.querySelectorAll('#items-body .item-row');
    rows.forEach(function(row, i) {
        row.querySelector('.item-num').textContent = i + 1;
    });
}
document.addEventListener('DOMContentLoaded', function() {
    calcSubtotal();
    // Auto-generate title from client
    var clientSel = document.getElementById('sel-client');
    if (clientSel && !'{is_edit}') {
        // Could auto-fill title
    }
});
</script>