<div class="max-w-6xl" x-data="{ joType: '{project.jo_type|default:"items"}', hasInstallation: {if project.with_installation|default:0}true{else}false{/if}, activeStep: 1, visitedSteps: [1], dirty: false }" x-init="
    window.addEventListener('beforeunload', function(e) { if (dirty) { e.preventDefault(); e.returnValue = ''; } });
    $watch('activeStep', function(v) { if (visitedSteps.indexOf(v) === -1) visitedSteps.push(v); });
    document.addEventListener('change', function() { dirty = true; });
    document.addEventListener('input', function() { dirty = true; });
">
<div class="flex flex-col lg:flex-row gap-6">
  <div class="flex-1 space-y-4">
    <!-- Step navigation -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-3">
        <h2 class="font-semibold text-gray-900 mb-2">{is_edit|default:false ? 'Edit Job Order' : 'Create Job Order'}</h2>
        <div class="flex flex-wrap gap-1">
            <button type="button" @click="activeStep=1;document.getElementById('sec-customer').scrollIntoView({behavior:'smooth',block:'start'})" :class="activeStep===1?'bg-blue-600 text-white':'bg-gray-100 text-gray-600 hover:bg-gray-200'" class="flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">👤 Customer<span class="inline-block w-1.5 h-1.5 rounded-full ml-0.5" :class="visitedSteps.indexOf(1)>=0?'bg-green-400':'bg-gray-400'"></span></button>
            <button type="button" @click="activeStep=2;document.getElementById('sec-details').scrollIntoView({behavior:'smooth',block:'start'})" :class="activeStep===2?'bg-blue-600 text-white':'bg-gray-100 text-gray-600 hover:bg-gray-200'" class="flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">📋 Details<span class="inline-block w-1.5 h-1.5 rounded-full ml-0.5" :class="visitedSteps.indexOf(2)>=0?'bg-green-400':'bg-gray-400'"></span></button>
            <button type="button" @click="activeStep=3;document.getElementById('sec-pricing').scrollIntoView({behavior:'smooth',block:'start'})" :class="activeStep===3?'bg-blue-600 text-white':'bg-gray-100 text-gray-600 hover:bg-gray-200'" class="flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">💰 Pricing<span class="inline-block w-1.5 h-1.5 rounded-full ml-0.5" :class="visitedSteps.indexOf(3)>=0?'bg-green-400':'bg-gray-400'"></span></button>
            <button type="button" @click="activeStep=4;document.getElementById('sec-fab').scrollIntoView({behavior:'smooth',block:'start'})" :class="activeStep===4?'bg-blue-600 text-white':'bg-gray-100 text-gray-600 hover:bg-gray-200'" class="flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">🔧 Fab<span class="inline-block w-1.5 h-1.5 rounded-full ml-0.5" :class="visitedSteps.indexOf(4)>=0?'bg-green-400':'bg-gray-400'"></span></button>
            <button type="button" @click="activeStep=5;document.getElementById('sec-items').scrollIntoView({behavior:'smooth',block:'start'})" :class="activeStep===5?'bg-blue-600 text-white':'bg-gray-100 text-gray-600 hover:bg-gray-200'" class="flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">📦 Items<span class="inline-block w-1.5 h-1.5 rounded-full ml-0.5" :class="visitedSteps.indexOf(5)>=0?'bg-green-400':'bg-gray-400'"></span></button>
            <button type="button" @click="activeStep=6;document.getElementById('sec-docs').scrollIntoView({behavior:'smooth',block:'start'})" :class="activeStep===6?'bg-blue-600 text-white':'bg-gray-100 text-gray-600 hover:bg-gray-200'" class="flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">🖼 Docs<span class="inline-block w-1.5 h-1.5 rounded-full ml-0.5" :class="visitedSteps.indexOf(6)>=0?'bg-green-400':'bg-gray-400'"></span></button>
        </div>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <form onsubmit="return ajaxSubmit(this, '{if is_edit}JO updated{else}JO created{/if}')" action="/api/v1/project-audit-ledger/projects{if is_edit}{if project.id}/{project.id}{/if}{/if}" method="POST" class="space-y-4">
        {csrf_field | raw}
        {if is_edit}<input type="hidden" name="_project_numeric_id" value="{project.id}">{/if}
        <!-- ── Section 1: Customer ── -->
        <div id="sec-customer" class="border border-blue-200 rounded-lg p-4 -mx-2 bg-blue-50/30">
        <h3 class="text-sm font-semibold text-gray-800 mb-2">👤 Customer Information</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Customer's Name *</label><select name="client_id" id="sel-client" class="w-full px-3 py-2 border border-gray-300 rounded text-sm" data-creatable="client" onchange="selClient(this)"><option value="">—</option>{for c in clients}<option value="{c.id}" data-contact="{c.contact_person|escape:'html'}" data-addr="{c.address|escape:'html'}" data-phone="{c.phone|escape:'html'}" data-email="{c.email|escape:'html'}"{if project.client_id==c.id} selected{/if}>{c.name}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.getElementById('sel-client');if(e)makeCreatable(e);});</script></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Contact Person</label><input type="text" id="client-company" name="client_company" value="{project.client_contact|default:''}" placeholder="Company or contact person" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Contact #</label><input type="text" id="client-phone" name="client_phone" value="{project.client_phone|default:''}" placeholder="Phone number" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Client Email</label><input type="email" id="client-email" name="client_email" value="{project.client_email|default:''}" placeholder="Email address" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div class="sm:col-span-2"><label class="block text-sm font-medium text-gray-700 mb-1">Address</label><textarea id="client-address" name="client_address" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded text-sm">{project.client_address|default:''}</textarea></div>
        </div></div>

        <!-- ── Section 2: Job Details ── -->
        <div id="sec-details" class="border border-gray-200 rounded-lg p-4 -mx-2">
        <h3 class="text-sm font-semibold text-gray-800 mb-2">📋 Job Details</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
            <div class="sm:col-span-2"><label class="block text-sm font-medium text-gray-700 mb-1">Title / Job Description *</label><input type="text" name="title" value="{project.title}" required class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">JO Number</label><input type="text" name="job_order_number" value="{project.job_order_number}" placeholder="Auto-generated if empty" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Date</label><input type="date" name="start_date" value="{project.start_date|default:''}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Scope of Work</label><select name="scope_of_work" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><option value="">—</option><option value="new"{if project.scope_of_work=='new'} selected{/if}>New</option><option value="refurbish"{if project.scope_of_work=='refurbish'} selected{/if}>Refurbish</option><option value="warranty_claim"{if project.scope_of_work=='warranty_claim'} selected{/if}>Warranty Claim</option><option value="labor_only"{if project.scope_of_work=='labor_only'} selected{/if}>Labor Only</option><option value="print_only"{if project.scope_of_work=='print_only'} selected{/if}>Print Only</option></select></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Project Type</label><select name="project_type_id" id="sel-proj-type" class="w-full px-3 py-2 border border-gray-300 rounded text-sm" data-creatable="project_type"><option value="">—</option>{for t in project_types}<option value="{t.id}"{if project.project_type_id==t.id} selected{/if}>{t.name}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.getElementById('sel-proj-type');if(e)makeCreatable(e);});</script></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Prepared by</label><input type="text" value="{prepared_by|default:current_user.full_name|default:current_user.username}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm bg-gray-50" disabled><input type="hidden" name="prepared_by" value="{current_user.full_name|default:current_user.username}"></div>
            <div class="flex gap-4">
                <div class="flex-1"><label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                    {if is_edit|default:false}
                    <span class="inline-flex items-center px-3 py-2 rounded text-sm font-medium {if project.status=='draft'}bg-gray-100 text-gray-700{elseif project.status=='pending'}bg-yellow-100 text-yellow-800{elseif project.status=='approved'}bg-green-100 text-green-800{elseif project.status=='started'}bg-blue-100 text-blue-800{elseif project.status=='ongoing'}bg-indigo-100 text-indigo-800{elseif project.status=='completed'}bg-teal-100 text-teal-800{else}bg-gray-100 text-gray-700{/if}">
                        {project.status|capitalize}
                    </span>
                    <input type="hidden" name="status" value="{project.status}">
                    {else}
                    <span class="inline-flex items-center px-3 py-2 rounded text-sm font-medium bg-gray-100 text-gray-700">Draft</span>
                    <input type="hidden" name="status" value="draft">
                    {/if}
                </div>
                <div class="flex-1"><label class="block text-sm font-medium text-gray-700 mb-1">Target End</label><input type="date" name="target_completion_date" value="{project.target_completion_date}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            </div>
            <div class="sm:col-span-2"><label class="block text-sm font-medium text-gray-700 mb-1">Description</label><textarea name="description" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded text-sm">{project.description}</textarea></div>
        </div></div>

        <!-- ── Section 3: Pricing & Charges ── -->
        <div id="sec-pricing" class="border border-gray-200 rounded-lg p-4 -mx-2">
        <h3 class="text-sm font-semibold text-gray-800 mb-2">💰 Pricing &amp; Charges</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
            <div class="sm:col-span-2"><h3 class="text-sm font-semibold text-gray-800 mb-2">📋 JO Type</h3></div>
            <div class="sm:col-span-2 flex gap-4">
                <label class="flex items-center gap-2 text-sm cursor-pointer" @click="joType='items'"><input type="radio" name="_jo_type" value="items" x-bind:checked="joType==='items'" class="rounded-full border-gray-300" :disabled="joType==='items'"> <span :class="joType==='items' ? 'font-semibold text-blue-600' : 'text-gray-500'">📋 Quotation Items</span></label>
                <label class="flex items-center gap-2 text-sm cursor-pointer" @click="joType='contract'"><input type="radio" name="_jo_type" value="contract" x-bind:checked="joType==='contract'" class="rounded-full border-gray-300" :disabled="joType==='contract'"> <span :class="joType==='contract' ? 'font-semibold text-blue-600' : 'text-gray-500'">💰 Contracted Amount</span></label>
            </div>

            <!-- Contracted Amount (visible when joType=contract) -->
            <div class="sm:col-span-2" x-show="joType==='contract'"><label class="block text-sm font-medium text-gray-700 mb-1">Contract Amount *</label><input type="number" step="0.01" name="contract_amount" value="{project.contract_amount|default:''}" x-bind:required="joType==='contract'" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><p class="text-xs text-gray-600 mt-1">Fixed contract price — line items below are for material tracking only</p></div>

            <!-- Charges (only for quotation-items mode) -->
            <div class="sm:col-span-2" x-show="joType==='items'"><h3 class="text-sm font-semibold text-gray-800 mb-2">💰 Charges</h3></div>
            <div x-show="joType==='items'"><label class="block text-sm font-medium text-gray-700 mb-1">Installation Charge</label><input type="number" step="0.01" name="installation_charge" value="{project.installation_charge|default:0}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div x-show="joType==='items'"><label class="block text-sm font-medium text-gray-700 mb-1">Mobilization Charge</label><input type="number" step="0.01" name="mobilization_charge" value="{project.mobilization_charge|default:0}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div x-show="joType==='items'"><label class="block text-sm font-medium text-gray-700 mb-1">Other Charges</label><input type="number" step="0.01" name="other_charges" value="{project.other_charges|default:0}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Mode of Payment</label><select name="mode_of_payment" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><option value="">—</option><option value="cash"{if project.mode_of_payment=='cash'} selected{/if}>Cash</option><option value="check"{if project.mode_of_payment=='check'} selected{/if}>Check</option><option value="bank_transfer"{if project.mode_of_payment=='bank_transfer'} selected{/if}>Bank Transfer</option><option value="gcash"{if project.mode_of_payment=='gcash'} selected{/if}>Gcash</option></select></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Down Payment</label><input type="number" step="0.01" name="down_payment" value="{project.down_payment|default:''}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">With Installation</label><label class="flex items-center gap-2 mt-2"><input type="checkbox" name="with_installation" value="1" x-model="hasInstallation" class="rounded border-gray-300"> <span class="text-sm">Yes</span></label></div>
        </div></div>

        <!-- ── Section 4: Installation & Fabrication ── -->
        <div id="sec-fab" class="border border-gray-200 rounded-lg p-4 -mx-2" x-show="hasInstallation">
        <h3 class="text-sm font-semibold text-gray-800 mb-2">🔧 Installation &amp; Fabrication</h3>

            <!-- Team Lead (only when With Installation = YES, works for both JO types) -->
            <template x-if="hasInstallation">
            <div class="sm:col-span-2"><h3 class="text-sm font-semibold text-gray-800 mb-2">👤 Team Lead</h3></div>
            </template>
            <template x-if="hasInstallation">
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Team Lead</label><select name="fabrication_team_lead_id" id="sel-tl" class="w-full px-3 py-2 border border-gray-300 rounded text-sm" data-creatable="team_lead"><option value="">—</option>{for l in team_leads}<option value="{l.id}"{if project.fabrication_team_lead_id==l.id} selected{/if}>{l.name}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.getElementById('sel-tl');if(e)makeCreatable(e);});</script></div>
            </template>
            <template x-if="hasInstallation">
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Allocation Basis</label><select name="fabrication_alloc_basis" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><option value="expenses"{if project.fabrication_alloc_basis=='expenses'} selected{/if}>Expenses</option><option value="labor_materials"{if project.fabrication_alloc_basis=='labor_materials'} selected{/if}>Labor + Materials</option><option value="contract"{if project.fabrication_alloc_basis=='contract'} selected{/if}>Contract Amount</option><option value="fixed"{if project.fabrication_alloc_basis=='fixed'} selected{/if}>Fixed Amount</option><option value="manual"{if project.fabrication_alloc_basis=='manual'} selected{/if}>Manual</option></select></div>
            </template>
            <template x-if="hasInstallation">
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Allocation %</label><input type="number" step="0.01" name="fabrication_alloc_pct" value="{project.fabrication_alloc_pct|default:25}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><p class="text-xs text-gray-600 mt-1">% of basis amount allocated to fabrication</p></div>
            </template>
            <input type="hidden" name="_jo_type" x-bind:value="joType">
        </div>

        <!-- ── Section 5: Line Items ── -->
        <div id="sec-items" class="border border-gray-200 rounded-lg p-4 -mx-2">
        <h3 class="text-sm font-semibold text-gray-800 mb-2">📦 Line Items</h3>
            <div class="overflow-x-auto">
                <table class="w-full text-sm border-collapse" id="items-table">
                    <thead>
                        <tr class="bg-gray-100 text-xs text-gray-600">
                            <th class="text-left py-2 px-2">#</th>
                            <th class="text-left py-2 px-2">Material</th>
                            <th class="text-left py-2 px-2">Particulars</th>
                            <th class="text-center py-2 px-2">Width</th>
                            <th class="text-center py-2 px-2">Height</th>
                            <th class="text-center py-2 px-2">Unit</th>
                            <th class="text-center py-2 px-2">QTY</th>
                            <th class="text-right py-2 px-2">Price/Unit</th>
                            <th class="text-right py-2 px-2">Price/SqFt</th>
                            <th class="text-right py-2 px-2">Total</th>
                            <th class="text-center py-2 px-2"></th>
                        </tr>
                    </thead>
                    <tbody id="items-body">
                        {for item in project.items}
                        <tr class="border-b border-gray-200 item-row">
                            <td class="py-2 px-2 text-center item-num">{item.sort_order}</td>
                            <td class="py-2 px-2">
                                {if !item.material_id}
                                <input type="text" name="items[{item.sort_order}][custom_material]" value="" class="w-full px-2 py-1 border border-blue-400 rounded text-xs bg-blue-50" placeholder="Custom material">
                                {else}
                                <select name="items[{item.sort_order}][material_id]" class="w-full px-2 py-1 border border-gray-300 rounded text-xs item-mat-sel" onchange="selMat(this)">
                                    <option value="">—</option>
                                    {for m in materials}
                                    <option value="{m.id}" data-ppu="{m.price_per_unit|default:0}" data-psf="{m.price_per_sqft|default:0}" data-w="{m.default_width|default:0}" data-h="{m.default_height|default:0}"{if item.material_id==m.id} selected{/if}>{m.name}</option>
                                    {/for}
                                    <option value="__other__">✦ Custom: type name…</option>
                                </select>
                                {/if}
                            </td>
                            <td class="py-2 px-2"><input type="text" name="items[{item.sort_order}][particulars]" value="{item.particulars}" class="w-full px-2 py-1 border border-gray-300 rounded text-xs" oninput="calcRow(this)"></td>
                            <td class="py-2 px-2"><input type="number" step="0.01" name="items[{item.sort_order}][width]" value="{item.width}" class="w-16 px-2 py-1 border border-gray-300 rounded text-xs text-center" oninput="calcRow(this)"></td>
                            <td class="py-2 px-2"><input type="number" step="0.01" name="items[{item.sort_order}][height]" value="{item.height}" class="w-16 px-2 py-1 border border-gray-300 rounded text-xs text-center" oninput="calcRow(this)"></td>
                            <td class="py-2 px-2">
                                {if item.uom && item.uom != 'meter' && item.uom != 'inches' && item.uom != 'cm' && item.uom != 'liter'}
                                <input type="text" name="items[{item.sort_order}][uom]" value="{item.uom}" class="w-20 px-2 py-1 border border-blue-400 rounded text-xs bg-blue-50">
                                {else}
                                <select name="items[{item.sort_order}][uom]" class="w-20 px-2 py-1 border border-gray-300 rounded text-xs" onchange="selUom(this)">
                                    <option value="">—</option>
                                    <option value="meter"{if item.uom=='meter'} selected{/if}>Meter</option>
                                    <option value="inches"{if item.uom=='inches'} selected{/if}>Inches</option>
                                    <option value="cm"{if item.uom=='cm'} selected{/if}>CM</option>
                                    <option value="liter"{if item.uom=='liter'} selected{/if}>Liter</option>
                                    <option value="__uom_other__">✦ Other…</option>
                                </select>
                                {/if}
                            </td>
                            <td class="py-2 px-2"><input type="number" step="0.01" name="items[{item.sort_order}][quantity]" value="{item.quantity|default:1}" class="w-16 px-2 py-1 border border-gray-300 rounded text-xs text-center" oninput="calcRow(this)"></td>
                            <td class="py-2 px-2"><input type="number" step="0.01" name="items[{item.sort_order}][price_per_unit]" value="{item.price_per_unit|default:0}" class="w-20 px-2 py-1 border border-gray-300 rounded text-xs text-right" oninput="calcRow(this)"></td>
                            <td class="py-2 px-2"><input type="number" step="0.01" name="items[{item.sort_order}][price_per_sqft]" value="{item.price_per_sqft|default:''}" class="w-20 px-2 py-1 border border-gray-300 rounded text-xs text-right" oninput="calcRow(this)"></td>
                            <td class="py-2 px-2 text-right font-medium item-total">₱{item.line_total|default:0|number_format:2}</td>
                            <td class="py-2 px-2 text-center"><button type="button" onclick="this.closest('tr').remove(); renumItems();" class="text-red-500 hover:text-red-700 text-xs">✕</button></td>
                        </tr>
                        {/for}
                    </tbody>
                </table>
            </div>
            <button type="button" onclick="addItem()" class="mt-2 px-3 py-1.5 bg-gray-100 text-gray-700 text-sm rounded-lg hover:bg-gray-200 border border-gray-300">+ Add Item</button>
            <div class="text-right mt-2">
                <span class="text-sm text-gray-600">Subtotal: </span><span class="text-sm font-semibold" id="items-subtotal">₱0.00</span>
            </div>
        </div></div>

        <!-- ── Section 6: Documents ── -->
        <div id="sec-docs" class="border border-gray-200 rounded-lg p-4 -mx-2">
        <h3 class="text-sm font-semibold text-gray-800 mb-2">🖼 Mockup / Reference Image</h3>
            <div class="flex gap-4 items-start">
                <div class="flex-1">
                    <input type="file" id="mockup-file" accept="image/*" onchange="uploadMockup()" class="w-full text-sm">
                    <p class="text-xs text-gray-500 mt-1">Upload a design mockup or reference image for this JO (max 2MB recommended)</p>
                    <input type="hidden" name="mockup_attachment_id" id="mockup-attachment-id" value="{mockup_attachment_id|default:0}">
                </div>
                <div id="mockup-preview" class="flex-shrink-0" {if !mockup_url}style="display:none"{/if}>
                    <img id="mockup-img" src="{mockup_url|default:''}" alt="Mockup preview" class="rounded-lg border border-gray-200" style="max-width:200px;max-height:150px;object-fit:cover;cursor:pointer" onclick="openLightbox(this.src, 'Mockup Image')" title="Click to enlarge">
                    <button type="button" onclick="removeMockup()" class="block mt-1 text-xs text-red-500 hover:text-red-700" title="Remove mockup">✕ Remove</button>
                </div>
            </div>
        </div></div>

        <div class="flex gap-3">
            {if !is_edit|default:false || project.status=='draft'}
            <button type="submit" data-wb-action="save-as-draft" onclick="document.querySelector('input[name=status]').value='draft';dirty=false" class="px-4 py-2 bg-gray-600 text-white text-sm rounded-lg hover:bg-gray-700">Save as Draft</button>
            <button type="submit" data-wb-action="submit-for-approval" onclick="document.querySelector('input[name=status]').value='pending';dirty=false" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">Submit for Approval</button>
            {elseif project.status=='approved'}
            <button type="submit" data-wb-action="start-work" onclick="document.querySelector('input[name=status]').value='started'" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">Start Work</button>
            {elseif project.status=='started'}
            <button type="submit" data-wb-action="mark-ongoing" onclick="document.querySelector('input[name=status]').value='ongoing'" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">Mark Ongoing</button>
            {elseif project.status=='ongoing'}
            <button type="submit" onclick="document.querySelector('input[name=status]').value='completed'" class="px-4 py-2 bg-teal-600 text-white text-sm rounded-lg hover:bg-teal-700">Complete Job Order</button>
            {else}
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">{is_edit|default:false ? 'Update' : 'Create'} Job Order</button>
            {/if}
            <a href="/admin/project-audit-ledger/projects" class="px-4 py-2 bg-gray-200 text-gray-700 text-sm rounded-lg hover:bg-gray-300">Cancel</a>
        </div>
    </form>
</div></div>

  <!-- ── RIGHT: Sticky Summary (desktop only) ── -->
  <div class="hidden lg:block w-72 flex-shrink-0">
    <div class="sticky top-6 space-y-4">
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
        <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Order Summary</h4>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between"><span class="text-gray-600">Subtotal</span><span class="font-medium" id="summary-subtotal">₱0.00</span></div>
          <div class="flex justify-between"><span class="text-gray-600">Charges</span><span class="font-medium" id="summary-charges">₱0.00</span></div>
          <div class="flex justify-between"><span class="text-gray-600">Discount</span><span class="font-medium">—</span></div>
          <div class="border-t pt-2 flex justify-between font-semibold"><span>Total</span><span id="summary-total">₱0.00</span></div>
          <div class="flex justify-between text-xs text-gray-500"><span>Down Payment</span><span id="summary-down">—</span></div>
          <div class="border-t pt-2 flex justify-between text-xs"><span class="text-gray-500">Expected Balance</span><span class="font-medium text-gray-700" id="summary-balance">₱0.00</span></div>
        </div>
      </div>
      <div class="text-xs text-gray-500 text-center">💡 Use the step buttons above to navigate between sections.</div>
    </div>
  </div>
</div>

<script>
// ── Mockup Image Upload ──
function uploadMockup() {
    var fileInput = document.getElementById('mockup-file');
    if (!fileInput || !fileInput.files || !fileInput.files[0]) return;
    var file = fileInput.files[0];
    var fd = new FormData();
    fd.append('file', file);
    fd.append('entity_type', 'project');
    // Use real project ID if available (edit mode), else 0 for new
    var projIdInput = document.querySelector('input[name="_project_numeric_id"]');
    var entityId = projIdInput ? projIdInput.value : '0';
    fd.append('entity_id', entityId);
    fd.append('description', 'Mockup image');
    var csrf = document.querySelector('input[name="_token"]');
    if (csrf) fd.append('_token', csrf.value);

    // Show inline preview immediately (client-side)
    document.getElementById('mockup-img').src = URL.createObjectURL(file);
    document.getElementById('mockup-preview').style.display = 'block';

    fetch('/api/v1/project-audit-ledger/attachments', { method: 'POST', body: fd })
    .then(function(r){ return r.json(); })
    .then(function(d){
        if (d.ok) {
            document.getElementById('mockup-attachment-id').value = d.id;
        } else {
            showToast(d.error || 'Upload failed', 'error');
        }
    })
    .catch(function(){ showToast('Upload silently failed — preview shown', 'warning'); });
}
function removeMockup() {
    var attId = document.getElementById('mockup-attachment-id').value;
    document.getElementById('mockup-attachment-id').value = '';
    document.getElementById('mockup-file').value = '';
    document.getElementById('mockup-preview').style.display = 'none';
    document.getElementById('mockup-img').src = '';
    // Delete from server if already saved (has attachment ID)
    if (attId && attId !== '0') {
        var csrf = document.querySelector('input[name="_token"]');
        var fd = new FormData();
        if (csrf) fd.append('_token', csrf.value);
        fetch('/api/v1/project-audit-ledger/attachments/' + attId + '/delete', { method: 'POST', body: fd })
        .then(function(r){ return r.json(); })
        .then(function(d){ if (d.ok) showToast('Mockup removed'); else showToast(d.error || 'Failed', 'warning'); })
        .catch(function(){});
    }
}
</script>

<script>
var matData = {};
var clientData = { {for c in clients}{c.id}:{company:"{c.contact_person|escape:'js'}",addr:"{c.address|escape:'js'}",phone:"{c.phone|escape:'js'}",email:"{c.email|escape:'js'}"},{/for}_end:0 };

function selClient(sel) {
    var data = clientData[sel.value];
    if (data) {
        document.getElementById('client-company').value = data.company || '';
        document.getElementById('client-address').value = data.addr || '';
        document.getElementById('client-phone').value = data.phone || '';
        document.getElementById('client-email').value = data.email || '';
    } else {
        document.getElementById('client-company').value = '';
        document.getElementById('client-address').value = '';
        document.getElementById('client-phone').value = '';
        document.getElementById('client-email').value = '';
    }
}
{for m in materials}
matData[{m.id}] = {ppu:{m.price_per_unit|default:0},psf:{m.price_per_sqft|default:0},w:{m.default_width|default:0},h:{m.default_height|default:0}};
{/for}
var itemIdx = {if project.items}{project.items|count}{else}0{/if};

function addItem() {
    itemIdx++;
    var tbody = document.getElementById('items-body');
    if (!tbody) return;
    var tr = document.createElement('tr');
    tr.className = 'border-b border-gray-200 item-row';
    var matOpts = '<option value="">—</option>';
    {for m in materials}
    matOpts += '<option value="{m.id}" data-ppu="{m.price_per_unit|default:0}" data-psf="{m.price_per_sqft|default:0}" data-w="{m.default_width|default:0}" data-h="{m.default_height|default:0}">{m.name|escape:'html'}</option>';
    {/for}
    matOpts += '<option value="__other__">✦ Custom: type name…</option>';
    tr.innerHTML = '<td class="py-2 px-2 text-center item-num">' + itemIdx + '</td>' +
        '<td class="py-2 px-2"><select name="items[' + itemIdx + '][material_id]" class="w-full px-2 py-1 border border-gray-300 rounded text-xs item-mat-sel" onchange="selMat(this)">' + matOpts + '</select></td>' +
        '<td class="py-2 px-2"><input type="text" name="items[' + itemIdx + '][particulars]" class="w-full px-2 py-1 border border-gray-300 rounded text-xs" oninput="calcRow(this)"></td>' +
        '<td class="py-2 px-2"><input type="number" step="0.01" name="items[' + itemIdx + '][width]" class="w-16 px-2 py-1 border border-gray-300 rounded text-xs text-center" oninput="calcRow(this)"></td>' +
        '<td class="py-2 px-2"><input type="number" step="0.01" name="items[' + itemIdx + '][height]" class="w-16 px-2 py-1 border border-gray-300 rounded text-xs text-center" oninput="calcRow(this)"></td>' +
        '<td class="py-2 px-2"><select name="items[' + itemIdx + '][uom]" class="w-20 px-2 py-1 border border-gray-300 rounded text-xs" onchange="selUom(this)"><option value="">—</option><option value="meter">Meter</option><option value="inches">Inches</option><option value="cm">CM</option><option value="liter">Liter</option><option value="__uom_other__">✦ Other…</option></select></td>' +
        '<td class="py-2 px-2"><input type="number" step="0.01" name="items[' + itemIdx + '][quantity]" value="1" class="w-16 px-2 py-1 border border-gray-300 rounded text-xs text-center" oninput="calcRow(this)"></td>' +
        '<td class="py-2 px-2"><input type="number" step="0.01" name="items[' + itemIdx + '][price_per_unit]" class="w-20 px-2 py-1 border border-gray-300 rounded text-xs text-right" oninput="calcRow(this)"></td>' +
        '<td class="py-2 px-2"><input type="number" step="0.01" name="items[' + itemIdx + '][price_per_sqft]" class="w-20 px-2 py-1 border border-gray-300 rounded text-xs text-right" oninput="calcRow(this)"></td>' +
        '<td class="py-2 px-2 text-right font-medium item-total">₱0.00</td>' +
        '<td class="py-2 px-2 text-center"><button type="button" onclick="this.closest(\'tr\').remove(); renumItems();" class="text-red-500 hover:text-red-700 text-xs">✕</button></td>';
    tbody.appendChild(tr);
}

function selMat(sel) {
    var row = sel.closest('tr');
    if (!row) return;
    if (sel.value === '__other__') {
        // Replace select with inline text input for custom material
        // Use custom_material field name so backend stores it as custom entry
        var input = document.createElement('input');
        input.type = 'text';
        // Use custom_material name (backend stores in particulars)
        input.name = sel.name.replace('[material_id]', '[custom_material]');
        input.placeholder = 'Type material name…';
        input.className = 'w-full px-2 py-1 border border-blue-400 rounded text-xs bg-blue-50';
        input.value = '';
        input.oninput = function() { calcRow(this); };
        input.onblur = function() {
            if (!this.value.trim()) {
                var td = this.parentElement;
                var newSel = document.createElement('select');
                newSel.name = this.name.replace('[custom_material]', '[material_id]');
                newSel.className = 'w-full px-2 py-1 border border-gray-300 rounded text-xs item-mat-sel';
                newSel.onchange = function() { selMat(this); };
                newSel.innerHTML = sel.innerHTML.replace('selected','');
                newSel.value = '';
                this.replaceWith(newSel);
                calcRow(newSel);
            }
        };
        sel.replaceWith(input);
        input.focus();
        calcRow(input);
        return;
    }
    var opt = sel.options[sel.selectedIndex];
    if (opt && opt.value && matData[opt.value]) {
        var d = matData[opt.value];
        row.querySelector('[name$="[particulars]"]').value = opt.text;
        if (d.w) row.querySelector('[name$="[width]"]').value = d.w;
        if (d.h) row.querySelector('[name$="[height]"]').value = d.h;
        if (d.ppu) row.querySelector('[name$="[price_per_unit]"]').value = d.ppu;
        if (d.psf) row.querySelector('[name$="[price_per_sqft]"]').value = d.psf;
    }
    calcRow(sel);
}
function selUom(sel) {
    if (sel.value === '__uom_other__') {
        var input = document.createElement('input');
        input.type = 'text';
        input.name = sel.name;
        input.placeholder = 'Type unit…';
        input.className = 'w-20 px-2 py-1 border border-blue-400 rounded text-xs bg-blue-50';
        input.value = '';
        input.onblur = function() {
            if (!this.value.trim()) {
                var td = this.parentElement;
                var newSel = document.createElement('select');
                newSel.name = this.name;
                newSel.className = 'w-20 px-2 py-1 border border-gray-300 rounded text-xs';
                newSel.onchange = function() { selUom(this); };
                newSel.innerHTML = '<option value="">—</option><option value="meter">Meter</option><option value="inches">Inches</option><option value="cm">CM</option><option value="liter">Liter</option><option value="__uom_other__">✦ Other…</option>';
                this.replaceWith(newSel);
            }
        };
        sel.replaceWith(input);
        input.focus();
    }
}
function calcRow(el) {
    var row = el.closest('tr');
    if (!row) return;
    var w = parseFloat(row.querySelector('[name$="[width]"]').value) || 0;
    var h = parseFloat(row.querySelector('[name$="[height]"]').value) || 0;
    var qty = parseFloat(row.querySelector('[name$="[quantity]"]').value) || 1;
    var ppu = parseFloat(row.querySelector('[name$="[price_per_unit]"]').value) || 0;
    var psf = parseFloat(row.querySelector('[name$="[price_per_sqft]"]').value) || 0;
    var total = 0;
    if (psf > 0 && w > 0 && h > 0) {
        total = w * h * psf * qty;
    } else {
        total = ppu * qty;
    }
    row.querySelector('.item-total').textContent = '₱' + total.toFixed(2);
    calcSubtotal();
}
function calcSubtotal() {
    var sum = 0;
    document.querySelectorAll('.item-total').forEach(function(el) {
        sum += parseFloat(el.textContent.replace(/[₱,]/g, '')) || 0;
    });
    document.getElementById('items-subtotal').textContent = '₱' + sum.toFixed(2);
}
function renumItems() {
    var rows = document.querySelectorAll('#items-body .item-row');
    rows.forEach(function(row, i) {
        row.querySelector('.item-num').textContent = i + 1;
        // Update name attributes on all inputs in this row to match the new index
        var idx = i + 1;
        row.querySelectorAll('[name]').forEach(function(el) {
            el.name = el.name.replace(/^items\[\d+\]/, 'items[' + idx + ']');
        });
    });
}
document.addEventListener('DOMContentLoaded', function() {
    calcSubtotal();
    // Auto-generate title from client
    var clientSel = document.getElementById('sel-client');
    if (clientSel && !'{is_edit}') {
        // Could auto-fill title
    }
});
</script>