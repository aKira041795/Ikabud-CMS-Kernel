<div class="max-w-lg">
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="font-semibold text-gray-900 mb-4">{is_edit ? 'Edit Sales Invoice' : 'Create Sales Invoice'}</h2>
    <form onsubmit="return ajaxSubmit(this, '{if is_edit}Invoice updated{else}Invoice created{/if}')" action="/api/v1/project-audit-ledger/sales{if is_edit}{if sale.id}/{sale.id}{/if}{/if}" method="POST" class="space-y-4">
        {csrf_field | raw}
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Project *</label><select name="project_id" required class="w-full px-3 py-2 border border-gray-300 rounded text-sm" data-creatable="project"><option value="">—</option>{for p in projects}<option value="{p.id}"{if sale.project_id==p.id} selected{/if}>{p.title}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.querySelector('select[name=project_id]');if(e)makeCreatable(e);});</script></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Client *</label><select name="client_id" required class="w-full px-3 py-2 border border-gray-300 rounded text-sm" data-creatable="client"><option value="">—</option>{for c in clients}<option value="{c.id}"{if sale.client_id==c.id} selected{/if}>{c.name}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.querySelector('select[name=client_id]');if(e)makeCreatable(e);});</script></div>
        <div class="grid grid-cols-2 gap-3">
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Gross Amount *</label><input type="number" step="0.01" name="gross_amount" value="{sale.gross_amount}" required class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Discount</label><input type="number" step="0.01" name="discount_amount" value="{sale.discount_amount|default:0}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Tax</label><input type="number" step="0.01" name="tax_amount" value="{sale.tax_amount|default:0}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Sales Date</label><input type="date" name="sales_date" value="{is_edit ? sale.sales_date : ('now'|date:'Y-m-d')}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Due Date</label><input type="date" name="due_date" value="{sale.due_date}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Invoice #</label><input type="text" name="invoice_number" value="{sale.invoice_number}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
        </div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Notes</label><textarea name="notes" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded text-sm">{sale.notes}</textarea></div>
        <div class="flex gap-3"><button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">{is_edit ? 'Update' : 'Create Invoice'}</button><a href="/admin/project-audit-ledger/sales" class="px-4 py-2 bg-gray-200 text-gray-700 text-sm rounded-lg hover:bg-gray-300">Cancel</a></div>
    </form>
</div>
</div>
