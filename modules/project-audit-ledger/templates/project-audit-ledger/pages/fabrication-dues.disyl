<div class="grid grid-cols-1 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4"><p class="text-xs text-gray-600 uppercase">Project</p><p class="font-semibold text-gray-900">{project.title|default:'Project #'~project_id}</p></div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4"><p class="text-xs text-gray-600 uppercase">Fabrication Budget</p><p class="font-semibold text-gray-900">₱{fab_budget|number_format:2} ({project.fabrication_alloc_pct|default:0}%)</p></div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4"><p class="text-xs text-gray-600 uppercase">Total CA Dispensed</p><p class="font-semibold text-indigo-600">₱{total_dispensed|number_format:2}</p></div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4"><p class="text-xs text-gray-600 uppercase">Remaining</p><p class="font-semibold {if fab_budget - total_dispensed > 0}text-green-600{else}text-gray-600{/if}">₱{fab_budget - total_dispensed|number_format:2}</p></div>
</div>

<!-- CA Dispense History -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6">
    <div class="p-4 border-b border-gray-200"><h2 class="font-semibold text-gray-900">CA Dispense History ({dispenses|count})</h2></div>
    <table class="w-full text-sm">
        <thead><tr class="bg-gray-50 border-b border-gray-200">
            <th class="text-left py-2 px-4 font-semibold text-gray-600">Date</th>
            <th class="text-left py-2 px-4 font-semibold text-gray-600">Amount</th>
            <th class="text-left py-2 px-4 font-semibold text-gray-600">Reason</th>
            <th class="text-left py-2 px-4 font-semibold text-gray-600">By</th>
            <th class="text-left py-2 px-4 font-semibold text-gray-600">Status</th>
        </tr></thead>
        <tbody>
            {for d in dispenses}
            <tr class="border-b border-gray-100">
                <td class="py-2 px-4 text-xs text-gray-600">{d.created_at}</td>
                <td class="py-2 px-4 font-medium text-indigo-600">₱{d.approved_amount|number_format:2}</td>
                <td class="py-2 px-4 text-gray-600 text-xs">{d.approval_reason|default:'—'}</td>
                <td class="py-2 px-4 text-gray-700">{d.dispensed_by_name|default:'—'}</td>
                <td class="py-2 px-4"><span class="inline-flex px-1.5 py-0.5 rounded-full text-xs font-medium {if d.status=='approved'}bg-green-100 text-green-700{else}bg-yellow-100 text-yellow-700{/if}">{d.status|default:'approved'}</span></td>
            </tr>
            {/for}
            {if dispenses|count == 0}
            <tr><td colspan="5" class="py-6 text-center text-gray-600 text-sm">No CA dispensed yet.</td></tr>
            {/if}
        </tbody>
    </table>
</div>
