<div class="grid grid-cols-1 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4"><p class="text-xs text-gray-600 uppercase">Project</p><p class="font-semibold text-gray-900">{if project_id}<a href="/admin/project-audit-ledger/projects/{project_id}" class="text-blue-600 hover:text-blue-800">{project.title|default:'Project #'~project_id}</a>{else}{project.title|default:'Project #'~project_id}{/if}</p></div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4"><p class="text-xs text-gray-600 uppercase">Fabrication Budget</p><p class="font-semibold text-gray-900">₱{fab_budget|number_format:2} ({project.fabrication_alloc_pct|default:0}%)</p></div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4"><p class="text-xs text-gray-600 uppercase">Total CA Dispensed</p><p class="font-semibold text-indigo-600">₱{total_dispensed|number_format:2}</p></div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4"><p class="text-xs text-gray-600 uppercase">Remaining</p><p class="font-semibold {if fab_budget - total_dispensed > 0}text-green-600{else}text-gray-600{/if}">₱{(fab_budget - total_dispensed)|number_format:2}</p></div>
</div>

<!-- CA Dispense History -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6">
    <div class="p-4 border-b border-gray-200"><h2 class="font-semibold text-gray-900">CA Dispense History ({dispenses|count})</h2></div>
    <table class="w-full text-sm pal-responsive-table">
        <thead><tr class="bg-gray-50 border-b border-gray-200">
            <th class="text-left py-2 px-4 font-semibold text-gray-600">Date</th>
            <th class="text-left py-2 px-4 font-semibold text-gray-600">Amount</th>
            <th class="text-left py-2 px-4 font-semibold text-gray-600">Reason</th>
            <th class="text-left py-2 px-4 font-semibold text-gray-600">By</th>
            <th class="text-left py-2 px-4 font-semibold text-gray-600">Status</th>
        </tr></thead>
        <tbody>
            {for d in dispenses}
            <tr class="border-b border-gray-100">
                <td class="py-2 px-4 text-xs text-gray-600">{d.created_at}</td>
                <td class="py-2 px-4 font-medium text-indigo-600">₱{d.approved_amount|number_format:2}</td>
                <td class="py-2 px-4 text-gray-600 text-xs">{d.approval_reason|default:'—'}</td>
                <td class="py-2 px-4 text-gray-700">{d.dispensed_by_name|default:'—'}</td>
                <td class="py-2 px-4">{include "project-audit-ledger/components/pal_status_badge" _sb_status=d.status|default:'approved'}</td>
            </tr>
            {/for}
            {if dispenses|count == 0}
            <tr><td colspan="5" class="py-6 text-center text-gray-600 text-sm">No CA dispensed yet.</td></tr>
            {/if}
        </tbody>
    </table>
</div>

<!-- Weekly Dues -->
<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-6">
    <div class="p-4 border-b border-gray-200 flex justify-between items-center">
        <h2 class="font-semibold text-gray-900">Weekly Dues ({weekly_dues|count})</h2>
        {if remaining_budget > 0}
        <button onclick="showGenerateDues()" class="px-3 py-1.5 bg-indigo-600 text-white text-sm rounded-lg hover:bg-indigo-700">+ Generate Weekly Dues</button>
        {/if}
    </div>
    {if weekly_dues|count > 0}
    <table class="w-full text-sm pal-responsive-table">
        <thead><tr class="bg-gray-50 border-b">
            <th class="text-left py-2 px-4 font-semibold text-gray-600">Week</th>
            <th class="text-right py-2 px-4 font-semibold text-gray-600">Due Amount</th>
            <th class="text-right py-2 px-4 font-semibold text-gray-600">Paid</th>
            <th class="text-right py-2 px-4 font-semibold text-gray-600">Balance</th>
            <th class="text-center py-2 px-4 font-semibold text-gray-600">Status</th>
        </tr></thead>
        <tbody>
            {for w in weekly_dues}
            <tr class="border-b border-gray-100">
                <td class="py-2 px-4 text-xs">Week {w.week_number}</td>
                <td class="py-2 px-4 text-xs text-right">₱{w.due_amount|number_format:2}</td>
                <td class="py-2 px-4 text-xs text-right">₱{w.paid_amount|number_format:2}</td>
                <td class="py-2 px-4 text-xs text-right font-medium {if w.balance > 0}text-red-600{else}text-green-600{/if}">₱{w.balance|number_format:2}</td>
                <td class="py-2 px-4 text-center">
                    {include "project-audit-ledger/components/pal_status_badge" _sb_status=w.status|default:'pending'}
                </td>
            </tr>
            {/for}
        </tbody>
    </table>
    {elseif fab_budget > 0}
    <div class="p-4 text-center text-sm text-gray-600">No weekly dues yet. Click "Generate Weekly Dues" to auto-split the remaining budget.</div>
    {/if}
</div>

<!-- Generate Dues Modal -->
<div id="gen-dues-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center" onclick="if(event.target==this)closeGenDues()">
    <div class="bg-white rounded-xl p-6 w-96 shadow-lg" onclick="event.stopPropagation()">
        <h3 class="font-semibold text-gray-900 mb-3">Generate Weekly Dues</h3>
        <p class="text-xs text-gray-600 mb-4">Remaining budget: <strong>₱{remaining_budget|number_format:2}</strong></p>
        <div class="space-y-3">
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Number of Weeks</label><input type="number" id="gen-weeks" value="4" min="1" max="52" class="w-full px-3 py-2 border border-gray-300 rounded text-sm" oninput="updateGenPreview()"></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Start Date</label><input type="date" id="gen-start" value="{('now'|date:'Y-m-d')}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
            <p class="text-xs text-gray-500" id="gen-preview">₱{(remaining_budget / 4)|number_format:2} per week for 4 weeks</p>
        </div>
        <div class="flex gap-2 mt-4 justify-end">
            <button onclick="closeGenDues()" class="wb-btn wb-btn--secondary wb-btn--sm">Cancel</button>
            <button onclick="generateDues({project_id})" class="px-3 py-1.5 bg-indigo-600 text-white text-sm rounded-lg hover:bg-indigo-700">Generate</button>
        </div>
    </div>
</div>

<script>
function showGenerateDues() { document.getElementById('gen-dues-modal').classList.remove('hidden'); updateGenPreview(); }
function closeGenDues() { document.getElementById('gen-dues-modal').classList.add('hidden'); }
function updateGenPreview() {
    var remaining = {remaining_budget};
    var weeks = parseInt(document.getElementById('gen-weeks').value) || 4;
    var perWeek = weeks > 0 ? (remaining / weeks) : 0;
    document.getElementById('gen-preview').textContent = '₱' + perWeek.toFixed(2) + ' per week for ' + weeks + ' weeks';
}
function generateDues(projectId) {
    var weeks = parseInt(document.getElementById('gen-weeks').value) || 4;
    var startDate = document.getElementById('gen-start').value;
    if (!startDate) { alert('Select a start date.'); return; }
    var allocationId = {first_allocation_id|default:0};
    if (!allocationId) { alert('No CA allocation found. Create a CA dispense first.'); return; }
    var weekStarts = [], weekEnds = [], dueDates = [];
    var start = new Date(startDate);
    for (var i = 0; i < weeks; i++) {
        var ws = new Date(start); ws.setDate(ws.getDate() + i * 7);
        var we = new Date(ws); we.setDate(we.getDate() + 6);
        var fmt = function(d) { return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); };
        weekStarts.push(fmt(ws)); weekEnds.push(fmt(we)); dueDates.push(fmt(we));
    }
    var form = new FormData();
    form.append('allocation_id', allocationId);
    weekStarts.forEach(function(v, i) {
        form.append('week_start[' + i + ']', v);
        form.append('week_end[' + i + ']', weekEnds[i]);
        form.append('due_date[' + i + ']', dueDates[i]);
    });
    var csrf = document.querySelector('input[name=_csrf_token]');
    if (csrf) form.append('_csrf_token', csrf.value);
    fetch('/api/v1/project-audit-ledger/fabrication/dues', { method: 'POST', body: form })
    .then(function(r) { return r.json(); })
    .then(function(d) {
        if (d.ok) { showToast('Weekly dues generated!', 'success'); setTimeout(function(){ location.reload(); }, 1000); }
        else { showToast(d.error || 'Failed.', 'error'); }
    })
    .catch(function(){ showToast('Failed.', 'error'); });
}
</script>