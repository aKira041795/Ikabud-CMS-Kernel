<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4"><p class="text-xs text-gray-600 uppercase">Active Projects</p><p class="text-2xl font-bold text-gray-900">{dashboard.active_projects|default:0}</p></div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4"><p class="text-xs text-gray-600 uppercase">Pending Approvals</p><p class="text-2xl font-bold text-yellow-600">{dashboard.pending_approvals|default:0}</p></div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4"><p class="text-xs text-gray-600 uppercase">This Month Sales</p><p class="text-2xl font-bold text-green-600">₱{dashboard.monthly_sales|default:'0'|number_format:2}</p></div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4"><p class="text-xs text-gray-600 uppercase">Low Stock Items</p><p class="text-2xl font-bold text-red-600">{dashboard.low_stock|default:0}</p></div>
</div>
<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="p-4 border-b border-gray-200"><h2 class="font-semibold text-gray-900">Recent Activity</h2></div>
    <ikb_entity_list source="pal_audit_log" view="compact" limit="10" empty="No recent activity." />
</div>