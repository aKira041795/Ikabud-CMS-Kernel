<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="wb-panel p-6">
        <h2 class="font-semibold text-gray-900 mb-4">Generate Report</h2>
        <form onsubmit="return ajaxSubmit(this, 'Report generated')" action="/api/v1/project-audit-ledger/reports/generate" method="POST" class="wb-form-surface">
            {csrf_field | raw}
            <div><label class="wb-label">Report Type</label><select name="report_type" class="wb-select"><option value="financial">Financial Summary</option><option value="project">Project Status</option><option value="inventory">Inventory</option><option value="sales">Sales</option></select></div>
            <div><label class="wb-label">Format</label><select name="format" class="wb-select"><option value="html">HTML (Preview)</option><option value="csv">CSV</option></select></div>
            <div class="grid grid-cols-2 gap-3"><div><label class="wb-label">From</label><input type="date" name="date_from" class="wb-input"></div><div><label class="wb-label">To</label><input type="date" name="date_to" class="wb-input"></div></div>
            <button type="submit" class="wb-btn wb-btn--primary">Generate</button>
        </form>
        <div class="mt-4 pt-4 border-t border-gray-100">
            <p class="text-xs font-semibold text-gray-600 mb-2">Quick CSV Export</p>
            <div class="flex flex-wrap gap-2">
                <a href="{base_url}/api/v1/project-audit-ledger/reports/export?type=financial" class="wb-btn wb-btn--secondary wb-btn--sm">Financial CSV</a>
                <a href="{base_url}/api/v1/project-audit-ledger/reports/export?type=project" class="wb-btn wb-btn--secondary wb-btn--sm">Projects CSV</a>
                <a href="{base_url}/api/v1/project-audit-ledger/reports/export?type=inventory" class="wb-btn wb-btn--secondary wb-btn--sm">Inventory CSV</a>
                <a href="{base_url}/api/v1/project-audit-ledger/reports/export?type=sales" class="wb-btn wb-btn--secondary wb-btn--sm">Sales CSV</a>
            </div>
        </div>
    </div>
    <div>
    <div class="wb-panel">
        <div class="wb-panel__header"><span class="wb-panel__title">Recent Exports</span></div>
        {for e in exports}
        <div class="p-4 border-b border-gray-100 flex justify-between">
            <div><p class="font-medium text-gray-900 text-sm">{e.report_type}</p><p class="text-xs text-gray-600">{e.generated_at} · {e.format}</p></div>
            {include "project-audit-ledger/components/pal_status_badge" _sb_status=e.status}
        </div>
        {/for}
        {if exports|count == 0}
        <div class="p-8 text-center text-gray-600 text-sm">No exports yet.</div>
        {/if}
    </div>
    {if preview_type}{if preview_data|count > 0}
    <div class="wb-panel overflow-hidden">
        <div class="wb-panel__header"><span class="wb-panel__title">Preview: {preview_type}</span></div>
        {if preview_type == 'financial'}
        <div class="p-4 space-y-2">{for d in preview_data}<div class="flex justify-between text-sm"><span class="text-gray-600">{d.item}</span><span class="font-medium">₱{d.val|number_format:2}</span></div>{/for}</div>
        {else}
        <table class="w-full text-sm wb-table wb-table--sticky">
            <thead><tr class="bg-gray-50 border-b border-gray-200">{for k in preview_data[0]|keys}<th class="text-left py-2 px-3 font-semibold text-gray-600">{k}</th>{/for}</tr></thead>
            <tbody>{for row in preview_data}<tr class="border-b border-gray-100">{for v in row}<td class="py-2 px-3 text-gray-700">{v|default:'—'}</td>{/for}</tr>{/for}</tbody>
        </table>
        {/if}
    </div>
    {/if}
    {/if}
    </div>
</div>
