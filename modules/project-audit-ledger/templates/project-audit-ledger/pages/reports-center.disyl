<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h2 class="font-semibold text-gray-900 mb-4">Generate Report</h2>
        <form onsubmit="return ajaxSubmit(this, 'Report generated')" action="/api/v1/project-audit-ledger/reports/generate" method="POST" class="space-y-4">
            {csrf_field | raw}
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Report Type</label><select name="report_type" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><option value="financial">Financial Summary</option><option value="project">Project Status</option><option value="inventory">Inventory</option><option value="sales">Sales</option></select></div>
            <div><label class="block text-sm font-medium text-gray-700 mb-1">Format</label><select name="format" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"><option value="html">HTML (Preview)</option><option value="csv">CSV</option></select></div>
            <div class="grid grid-cols-2 gap-3"><div><label class="block text-xs font-medium text-gray-600 mb-1">From</label><input type="date" name="date_from" class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm"></div><div><label class="block text-xs font-medium text-gray-600 mb-1">To</label><input type="date" name="date_to" class="w-full px-2 py-1.5 border border-gray-300 rounded text-sm"></div></div>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">Generate</button>
        </form>
    </div>
    <div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-4">
        <div class="p-4 border-b border-gray-200"><h2 class="font-semibold text-gray-900">Recent Exports</h2></div>
        {for e in exports}
        <div class="p-4 border-b border-gray-100 flex justify-between">
            <div><p class="font-medium text-gray-900 text-sm">{e.report_type}</p><p class="text-xs text-gray-500">{e.generated_at} · {e.format}</p></div>
            <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">{e.status}</span>
        </div>
        {/for}
        {if exports|count == 0}
        <div class="p-8 text-center text-gray-400 text-sm">No exports yet.</div>
        {/if}
    </div>
    {if preview_type}{if preview_data|count > 0}
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="p-4 border-b border-gray-200"><h2 class="font-semibold text-gray-900">Preview: {preview_type}</h2></div>
        {if preview_type == 'financial'}
        <div class="p-4 space-y-2">{for d in preview_data}<div class="flex justify-between text-sm"><span class="text-gray-600">{d.item}</span><span class="font-medium">₱{d.val|number_format:2}</span></div>{/for}</div>
        {else}
        <table class="w-full text-sm">
            <thead><tr class="bg-gray-50 border-b border-gray-200">{for k in preview_data[0]|keys}<th class="text-left py-2 px-3 font-semibold text-gray-600">{k}</th>{/for}</tr></thead>
            <tbody>{for row in preview_data}<tr class="border-b border-gray-100">{for v in row}<td class="py-2 px-3 text-gray-700">{v|default:'—'}</td>{/for}</tr>{/for}</tbody>
        </table>
        {/if}
    </div>
    {/if}
    {/if}
    </div>
</div>
