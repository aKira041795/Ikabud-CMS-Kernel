<div class="max-w-4xl">
<div class="wb-panel">
    <div class="wb-panel__header"><h2 class="wb-section-title">{is_edit ? 'Edit Expense' : 'Create Expense'}</h2></div>
    <form onsubmit="return ajaxSubmit(this, '{if is_edit}Expense updated{else}Expense created{/if}')" action="/api/v1/project-audit-ledger/expenses{if is_edit}{if expense.id}/{expense.id}{/if}{/if}" method="POST" class="wb-panel__body wb-form-surface">
        {csrf_field | raw}
        <div class="wb-form-grid wb-form-grid--2">
            <div><label class="wb-label wb-label--required">Category</label><select name="category_id" id="sel-exp-cat" required class="wb-select" data-creatable="expense_category"><option value="">—</option>{for c in categories}<option value="{c.id}"{if expense.category_id==c.id} selected{/if}>{c.name}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.getElementById('sel-exp-cat');if(e)makeCreatable(e);});</script></div>
            <div><label class="wb-label wb-label--required">Amount</label><input type="number" step="0.01" name="amount" value="{expense.amount}" required class="wb-input"></div>
            <div><label class="wb-label">Project</label><select name="project_id" class="wb-select" data-creatable="project"><option value="">—</option>{for p in projects}<option value="{p.id}"{if expense.project_id==p.id} selected{/if}>{if p.job_order_number}{p.job_order_number} — {/if}{p.title}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.querySelector('select[name=project_id]');if(e)makeCreatable(e);});</script></div>
            <div><label class="wb-label">Supplier</label><select name="supplier_id" class="wb-select" data-creatable="supplier"><option value="">—</option>{for s in suppliers}<option value="{s.id}"{if expense.supplier_id==s.id} selected{/if}>{s.name}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.querySelector('select[name=supplier_id]');if(e)makeCreatable(e);});</script></div>
            <div class="sm:col-span-2"><label class="wb-label">Description</label><textarea name="description" rows="3" class="wb-textarea">{expense.description}</textarea></div>
            <div><label class="wb-label">Expense Date</label><input type="date" name="expense_date" value="{expense.expense_date}" class="wb-input"></div>
        </div>
        <div class="wb-form-sticky-bar"><button type="submit" class="wb-btn wb-btn--primary">{is_edit ? 'Update' : 'Create'}</button><a href="/admin/project-audit-ledger/expenses" class="wb-btn wb-btn--secondary">Cancel</a></div>
    </form>
</div>
</div>
