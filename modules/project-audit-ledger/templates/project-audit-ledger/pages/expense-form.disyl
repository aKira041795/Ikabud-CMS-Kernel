<div class="max-w-lg">
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="font-semibold text-gray-900 mb-4">{is_edit ? 'Edit Expense' : 'Create Expense'}</h2>
    <form onsubmit="return ajaxSubmit(this, '{if is_edit}Expense updated{else}Expense created{/if}')" action="/api/v1/project-audit-ledger/expenses{if is_edit}{if expense.id}/{expense.id}{/if}{/if}" method="POST" class="space-y-4">
        {csrf_field | raw}
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Category *</label><select name="category_id" id="sel-exp-cat" required class="w-full px-3 py-2 border border-gray-300 rounded text-sm" data-creatable="expense_category"><option value="">—</option>{for c in categories}<option value="{c.id}"{if expense.category_id==c.id} selected{/if}>{c.name}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.getElementById('sel-exp-cat');if(e)makeCreatable(e);});</script></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Amount *</label><input type="number" step="0.01" name="amount" value="{expense.amount}" required class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Project</label><select name="project_id" class="w-full px-3 py-2 border border-gray-300 rounded text-sm" data-creatable="project"><option value="">—</option>{for p in projects}<option value="{p.id}"{if expense.project_id==p.id} selected{/if}>{p.title}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.querySelector('select[name=project_id]');if(e)makeCreatable(e);});</script></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Supplier</label><select name="supplier_id" class="w-full px-3 py-2 border border-gray-300 rounded text-sm" data-creatable="supplier"><option value="">—</option>{for s in suppliers}<option value="{s.id}"{if expense.supplier_id==s.id} selected{/if}>{s.name}</option>{/for}</select><script>document.addEventListener('DOMContentLoaded',function(){var e=document.querySelector('select[name=supplier_id]');if(e)makeCreatable(e);});</script></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Description</label><textarea name="description" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded text-sm">{expense.description}</textarea></div>
        <div><label class="block text-sm font-medium text-gray-700 mb-1">Expense Date</label><input type="date" name="expense_date" value="{expense.expense_date}" class="w-full px-3 py-2 border border-gray-300 rounded text-sm"></div>
        <div class="flex gap-3"><button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">{is_edit ? 'Update' : 'Create'}</button><a href="/admin/project-audit-ledger/expenses" class="px-4 py-2 bg-gray-200 text-gray-700 text-sm rounded-lg hover:bg-gray-300">Cancel</a></div>
    </form>
</div>
</div>
