<div class="wb-panel">
    <div class="wb-panel__header">
        <div>
            <form method="GET" class="flex gap-2 items-center">
                <label class="text-xs text-gray-600">Month:</label>
                <select name="month" onchange="this.form.submit()" class="px-2 py-1 border border-gray-300 rounded text-xs">
                    <option value="">All</option>
                    <option value="01"{if _GET.month=='01'} selected{/if}>January</option>
                    <option value="02"{if _GET.month=='02'} selected{/if}>February</option>
                    <option value="03"{if _GET.month=='03'} selected{/if}>March</option>
                    <option value="04"{if _GET.month=='04'} selected{/if}>April</option>
                    <option value="05"{if _GET.month=='05'} selected{/if}>May</option>
                    <option value="06"{if _GET.month=='06'} selected{/if}>June</option>
                    <option value="07"{if _GET.month=='07'} selected{/if}>July</option>
                    <option value="08"{if _GET.month=='08'} selected{/if}>August</option>
                    <option value="09"{if _GET.month=='09'} selected{/if}>September</option>
                    <option value="10"{if _GET.month=='10'} selected{/if}>October</option>
                    <option value="11"{if _GET.month=='11'} selected{/if}>November</option>
                    <option value="12"{if _GET.month=='12'} selected{/if}>December</option>
                </select>
                <select name="year" onchange="this.form.submit()" class="px-2 py-1 border border-gray-300 rounded text-xs">
                    <option value="">All Years</option>
                    <option value="2025"{if _GET.year=='2025'} selected{/if}>2025</option>
                    <option value="2026"{if _GET.year=='2026'} selected{/if}>2026</option>
                    <option value="2027"{if _GET.year=='2027'} selected{/if}>2027</option>
                </select>
                {if _GET.month || _GET.year}
                <a href="/admin/project-audit-ledger/cash-advances" class="text-xs text-blue-600 hover:text-blue-800">Clear</a>
                {/if}
            </form>
        </div>
        <a href="/admin/project-audit-ledger/cash-advances/create" class="wb-btn wb-btn--primary wb-btn--sm">+ New Cash Advance</a>
    </div>
    <div class="wb-panel__body--flush">
        {ikb_entity_list source="pal_cash_advance" view="table" use="tailwind" empty="No cash advances recorded." /}
    </div>
</div>

<script>
function approveCa(id) {
    if (!confirm('Approve this cash advance?')) return;
    var form = new FormData();
    form.append('decision', 'approved');
    form.append('_csrf_token', document.querySelector('input[name=_csrf_token]')?.value || '');
    fetch('/api/v1/project-audit-ledger/cash-advances/' + id + '/approve', { method: 'POST', body: form })
    .then(function(r){ return r.json(); })
    .then(function(d){
        if (d.ok) { showToast('Approved.', 'success'); location.reload(); }
        else { showToast(d.error || 'Failed.', 'error'); }
    })
    .catch(function(){ showToast('Failed.', 'error'); });
}
</script>