<div class="max-w-4xl print-area">
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex justify-between items-start mb-4">
        <div>
            <h2 class="font-semibold text-gray-900">Quotation #{quotation.quotation_number}</h2>
            <p class="text-xs text-gray-500">Status: <span class="font-medium">{quotation.status|default:'draft'}</span></p>
        </div>
        <div class="flex gap-2 no-print">
            <a href="/admin/project-audit-ledger/quotations" class="px-3 py-1.5 bg-gray-200 text-gray-700 text-sm rounded-lg hover:bg-gray-300">← Back</a>
            <a href="/admin/project-audit-ledger/quotations/{quotation.id}/edit" class="px-3 py-1.5 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">Edit</a>
            {if quotation.status == 'approved'}
            <button onclick="convertToProject({quotation.id})" class="px-3 py-1.5 bg-indigo-600 text-white text-sm rounded-lg hover:bg-indigo-700">Create Project</button>
            {/if}
            {if quotation.status != 'converted'}
            <button onclick="convertToSale({quotation.id})" class="px-3 py-1.5 bg-green-600 text-white text-sm rounded-lg hover:bg-green-700">Convert to Invoice</button>
            {/if}
            <button onclick="updateQuotationStatus({quotation.id}, '{if quotation.status=='draft'}sent{elseif quotation.status=='sent'}approved{else}draft{/if}')" class="px-3 py-1.5 bg-yellow-600 text-white text-sm rounded-lg hover:bg-yellow-700">
                {if quotation.status=='draft'}Mark Sent{elseif quotation.status=='sent'}Approve{else}—{/if}
            </button>
            <button onclick="window.print()" class="px-3 py-1.5 bg-gray-600 text-white text-sm rounded-lg hover:bg-gray-700">🖨 Print</button>
        </div>
    </div>

    {if quotation.converted_to_sale_id}
    <div class="mb-4 p-3 bg-purple-50 border border-purple-200 rounded text-sm">
        ✅ Converted to Invoice <a href="/admin/project-audit-ledger/sales/{quotation.converted_to_sale_id}" class="text-blue-600 hover:text-blue-800 font-medium">#{quotation.converted_to_sale_id}</a>
    </div>
    {/if}
    {if quotation.project_id}
    <div class="mb-4 p-3 bg-indigo-50 border border-indigo-200 rounded text-sm">
        📁 Project: <a href="/admin/project-audit-ledger/projects/{quotation.project_id}" class="text-blue-600 hover:text-blue-800 font-medium">{quotation.project_title|default:'View Project'}</a>
    </div>
    {/if}

    <!-- Customer Info -->
    <div class="grid grid-cols-2 gap-4 mb-4 p-4 bg-gray-50 rounded">
        <div>
            <p class="text-xs text-gray-500">Customer</p>
            <p class="text-sm font-medium">{quotation.client_name|default:'—'}</p>
            <p class="text-xs text-gray-600">{quotation.client_address|default:''}</p>
            <p class="text-xs text-gray-600">{quotation.client_contact|default:''}</p>
        </div>
        <div class="text-right">
            <p class="text-xs text-gray-500">Date: {quotation.quotation_date}</p>
            {if quotation.project_title}<p class="text-xs text-gray-500">Project: {quotation.project_title}</p>{/if}
            {if quotation.scope_of_work}<p class="text-xs text-gray-500">Scope: {quotation.scope_of_work|replace:'_':' '|capitalize}</p>{/if}
        </div>
    </div>

    <!-- Line Items -->
    <h3 class="text-sm font-semibold text-gray-800 mb-2">Line Items</h3>
    <div class="overflow-x-auto mb-4">
        <table class="w-full text-sm border-collapse">
            <thead>
                <tr class="bg-gray-800 text-white text-xs">
                    <th class="text-left py-2 px-3">#</th>
                    <th class="text-left py-2 px-3">Particulars</th>
                    <th class="text-center py-2 px-3">Width</th>
                    <th class="text-center py-2 px-3">Height</th>
                    <th class="text-center py-2 px-3">QTY</th>
                    <th class="text-right py-2 px-3">Price/Unit</th>
                    <th class="text-right py-2 px-3">Price/SqFt</th>
                    <th class="text-right py-2 px-3">Total</th>
                </tr>
            </thead>
            <tbody>
                {for item in quotation.items}
                <tr class="border-b border-gray-200">
                    <td class="py-2 px-3 text-xs text-gray-500">{item.sort_order|default:item_index+1}</td>
                    <td class="py-2 px-3 text-sm">{item.particulars}{if item.material_name} <span class="text-xs text-gray-500">({item.material_name})</span>{/if}</td>
                    <td class="py-2 px-3 text-xs text-center">{item.width|default:'—'}</td>
                    <td class="py-2 px-3 text-xs text-center">{item.height|default:'—'}</td>
                    <td class="py-2 px-3 text-xs text-center">{item.quantity|default:1}</td>
                    <td class="py-2 px-3 text-xs text-right">{if item.price_per_unit > 0}₱{item.price_per_unit|number_format:2}{else}—{/if}</td>
                    <td class="py-2 px-3 text-xs text-right">{if item.price_per_sqft > 0}₱{item.price_per_sqft|number_format:2}{else}—{/if}</td>
                    <td class="py-2 px-3 text-xs text-right font-medium">₱{item.line_total|number_format:2}</td>
                </tr>
                {/for}
            </tbody>
        </table>
    </div>

    <!-- Totals -->
    <div class="border-t pt-3">
        <div class="flex justify-end">
            <div class="w-64 space-y-1 text-sm">
                <div class="flex justify-between"><span class="text-gray-600">Subtotal</span><span>₱{quotation.subtotal|number_format:2}</span></div>
                {if quotation.installation_charge > 0}
                <div class="flex justify-between"><span class="text-gray-600">Installation Charge</span><span>₱{quotation.installation_charge|number_format:2}</span></div>
                {/if}
                {if quotation.mobilization_charge > 0}
                <div class="flex justify-between"><span class="text-gray-600">Mobilization Charge</span><span>₱{quotation.mobilization_charge|number_format:2}</span></div>
                {/if}
                {if quotation.other_charges > 0}
                <div class="flex justify-between"><span class="text-gray-600">Other Charges</span><span>₱{quotation.other_charges|number_format:2}</span></div>
                {/if}
                <div class="flex justify-between font-semibold text-base border-t pt-1">
                    <span>Total</span>
                    <span>₱{quotation.total_amount|number_format:2}</span>
                </div>
                {if quotation.down_payment > 0}
                <div class="flex justify-between text-xs text-gray-600">
                    <span>Down Payment ({quotation.down_payment_type|replace:'_':' '|default:'—'})</span>
                    <span>₱{quotation.down_payment|number_format:2}</span>
                </div>
                {/if}
                {if quotation.mode_of_payment}
                <div class="flex justify-between text-xs text-gray-600">
                    <span>Mode of Payment</span>
                    <span>{quotation.mode_of_payment|replace:'_':' '|capitalize}</span>
                </div>
                {/if}
            </div>
        </div>
    </div>

    {if quotation.notes}
    <div class="mt-4 p-3 bg-gray-50 rounded text-sm">
        <span class="text-xs text-gray-500">Notes:</span>
        <p class="text-gray-700">{quotation.notes}</p>
    </div>
    {/if}

    <!-- Attachments / Mockup Upload -->
    <div class="mt-6 border-t pt-4 no-print">
        <h3 class="text-sm font-semibold text-gray-800 mb-3">📎 Attachments</h3>
        <p class="text-xs text-gray-600 mb-2">Upload mockup designs, reference images, or project photos.</p>
        <form onsubmit="return uploadQuotationAttachment(this, {quotation.id})" class="flex gap-2 items-end">
            {csrf_field | raw}
            <div class="flex-1">
                <input type="file" name="file" accept="image/*" required class="w-full text-sm">
            </div>
            <div>
                <select name="description" class="px-2 py-1.5 border border-gray-300 rounded text-sm">
                    <option value="mockup">🎨 Mockup</option>
                    <option value="photo">📷 Photo</option>
                    <option value="reference">📄 Reference</option>
                    <option value="other">📁 Other</option>
                </select>
            </div>
            <button type="submit" class="px-3 py-1.5 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">Upload</button>
        </form>
        <div id="quotation-attachments" class="mt-3 grid grid-cols-3 gap-3"></div>
        <script>
        function uploadQuotationAttachment(form, quotationId) {
            var formData = new FormData(form);
            formData.append('entity_type', 'quotation');
            formData.append('entity_id', quotationId);
            var csrf = document.querySelector('input[name=_csrf_token]');
            if (csrf) formData.append('_csrf_token', csrf.value);
            fetch('/api/v1/project-audit-ledger/attachments', { method: 'POST', body: formData })
            .then(function(r){ return r.json(); })
            .then(function(d){
                if (d.ok) { showToast('File uploaded.', 'success'); loadQuotationAttachments(quotationId); }
                else { showToast('Upload failed.', 'error'); }
            })
            .catch(function(){ showToast('Upload failed.', 'error'); });
            return false;
        }
        function loadQuotationAttachments(quotationId) {
            var container = document.getElementById('quotation-attachments');
            if (!container) return;
            container.innerHTML = '<div class="col-span-3 text-xs text-gray-500">Loading...</div>';
            fetch('/api/v1/project-audit-ledger/attachments/list?entity_type=quotation&entity_id=' + quotationId)
            .then(function(r){ return r.json(); })
            .then(function(data){
                container.innerHTML = '';
                if (!data.length) { container.innerHTML = '<div class="col-span-3 text-xs text-gray-500">No attachments.</div>'; return; }
                data.forEach(function(a){
                    var typeLabel = a.description || 'file';
                    var icon = typeLabel === 'mockup' ? '🎨' : typeLabel === 'photo' ? '📷' : typeLabel === 'reference' ? '📄' : '📁';
                    var div = document.createElement('div');
                    div.className = 'relative group';
                    div.innerHTML = '<a href="/admin/project-audit-ledger/attachments/' + a.id + '/download" target="_blank" class="block p-3 bg-gray-50 rounded border border-gray-200 hover:border-blue-300 text-center">'
                        + '<div class="text-2xl mb-1">' + icon + '</div>'
                        + '<div class="text-xs text-gray-700 truncate">' + a.original_filename + '</div>'
                        + '<div class="text-xs text-gray-500">' + typeLabel + '</div>'
                        + '</a>'
                        + '<button onclick="deleteQuotationAttachment(' + a.id + ', ' + quotationId + ')" class="absolute top-1 right-1 bg-red-500 text-white rounded-full w-4 h-4 text-xs flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">&times;</button>';
                    container.appendChild(div);
                });
            })
            .catch(function(){ container.innerHTML = '<div class="col-span-3 text-xs text-red-500">Failed to load.</div>'; });
        }
        function deleteQuotationAttachment(id, quotationId) {
            if (!confirm('Delete this attachment?')) return;
            var form = new FormData();
            var csrf = document.querySelector('input[name=_csrf_token]');
            if (csrf) form.append('_csrf_token', csrf.value);
            fetch('/api/v1/project-audit-ledger/attachments/' + id + '/delete', { method: 'POST', body: form })
            .then(function(r){ return r.json(); })
            .then(function(d){
                if (d.ok) { showToast('Deleted.', 'success'); loadQuotationAttachments(quotationId); }
                else { showToast('Delete failed.', 'error'); }
            })
            .catch(function(){ showToast('Delete failed.', 'error'); });
        }
        document.addEventListener('DOMContentLoaded', function(){
            var match = window.location.pathname.match(/\/quotations\/(\d+)/);
            if (match) loadQuotationAttachments(match[1]);
        });
        </script>
    </div>

    <!-- Signature -->
    <div class="mt-8 pt-4 border-t grid grid-cols-3 gap-4 text-xs text-gray-600">
        <div>
            <p class="font-medium text-gray-800 mb-6">Prepared By:</p>
            <p class="border-t border-gray-300 pt-1">___________________________</p>
        </div>
        <div>
            <p class="font-medium text-gray-800 mb-6">Client Signature:</p>
            <p class="border-t border-gray-300 pt-1">___________________________</p>
        </div>
        <div class="text-right">
            <p class="text-gray-500">ZAP-ARTS</p>
            <p class="text-gray-500">Signage & Printing Solutions</p>
        </div>
    </div>
</div>
</div>

<script>
function convertToSale(id) {
    if (!confirm('Convert this quotation to a sales invoice?')) return;
    fetch('/api/v1/project-audit-ledger/quotations/' + id + '/convert', { method: 'POST', headers: { 'X-CSRF-Token': document.querySelector('input[name=_csrf_token]')?.value || '' } })
    .then(function(r) { return r.json(); })
    .then(function(d) {
        if (d.ok) { showToast('Quotation converted to invoice #' + d.sale_id, 'success'); setTimeout(function(){ window.location = '/admin/project-audit-ledger/sales/' + d.sale_id; }, 1000); }
        else { showToast('Conversion failed.', 'error'); }
    })
    .catch(function(){ showToast('Conversion failed.', 'error'); });
}
function convertToProject(id) {
    if (!confirm('Create a project from this approved quotation? A JO number will be auto-generated.')) return;
    fetch('/api/v1/project-audit-ledger/quotations/' + id + '/convert-project', { method: 'POST', headers: { 'X-CSRF-Token': document.querySelector('input[name=_csrf_token]')?.value || '' } })
    .then(function(r) { return r.json(); })
    .then(function(d) {
        if (d.ok) { showToast('Project created!', 'success'); setTimeout(function(){ window.location = '/admin/project-audit-ledger/projects/' + d.project_id; }, 1000); }
        else { showToast(d.error || 'Failed to create project', 'error'); }
    })
    .catch(function(){ showToast('Failed to create project.', 'error'); });
}
function updateQuotationStatus(id, status) {
    var label = status.replace(/_/g, ' ');
    if (!confirm('Mark as "' + label + '"?')) return;
    var form = new FormData();
    form.append('status', status);
    form.append('_csrf_token', document.querySelector('input[name=_csrf_token]')?.value || '');
    fetch('/api/v1/project-audit-ledger/quotations/' + id + '/status', { method: 'POST', body: form })
    .then(function(r) { return r.json(); })
    .then(function(d) {
        if (d.ok) { showToast('Status updated.', 'success'); window.location.reload(); }
        else { showToast('Update failed.', 'error'); }
    })
    .catch(function(){ showToast('Update failed.', 'error'); });
}
</script>