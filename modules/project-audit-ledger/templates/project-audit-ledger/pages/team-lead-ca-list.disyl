<div class="flex justify-between items-center mb-4">
    <div>
        <p class="text-sm text-gray-600">
            <span class="font-medium">{advances|count}</span> records
        </p>
    </div>
    <a href="/admin/project-audit-ledger/team-lead/cash-advances/create" class="wb-btn wb-btn--primary">+ Request Advance</a>
</div>

<div class="wb-panel">
    <table class="w-full text-sm wb-table wb-table--sticky">
        <thead>
            <tr class="bg-gray-50 border-b">
                <th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Date</th>
                <th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Project</th>
                <th class="text-right py-2 px-3 font-semibold text-gray-600 text-xs">Amount</th>
                <th class="text-center py-2 px-3 font-semibold text-gray-600 text-xs">Status</th>
                <th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Description</th>
            </tr>
        </thead>
        <tbody>
            {for a in advances}
            <tr class="border-b border-gray-100 {if a.status=='approved'}bg-green-50{elseif a.status=='rejected'}bg-red-50{/if}">
                <td class="py-2 px-3 text-xs text-gray-600">{a.advance_date|default:a.created_at}</td>
                <td class="py-2 px-3 text-xs">{a.project_title|default:'—'}</td>
                <td class="py-2 px-3 text-xs text-right font-medium">₱{a.amount|number_format:2}</td>
                <td class="py-2 px-3 text-center">
                    <span class="inline-flex px-1.5 py-0.5 rounded-full text-xs font-medium {if a.status=='approved'}bg-green-100 text-green-700{elseif a.status=='settled'}bg-blue-100 text-blue-700{elseif a.status=='rejected'}bg-red-100 text-red-700{elseif a.status=='voided'}bg-gray-100 text-gray-700{else}bg-yellow-100 text-yellow-700{/if}">{a.status|capitalize}</span>
                </td>
                <td class="py-2 px-3 text-xs text-gray-500">{a.description|default:'—'}</td>
            </tr>
            {else}
            <tr><td colspan="5" class="py-6 text-center text-gray-600 text-sm">No cash advances found.</td></tr>
            {/for}
        </tbody>
    </table>
</div>