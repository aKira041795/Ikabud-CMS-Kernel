{* PAL Admin Shell — delegates to workbench:app_shell.
   shell_ctx is built in PHP by palBuildShellContext() in helpers.php.
   Title ownership: the page template renders the header via pal_page_header
   or pal_detail_header. The shell does NOT render a competing title. *}

{include "workbench:app_shell" shell=shell_ctx}
    {csrf_field|raw}
    <div class="pal-page">
    {page_body|raw}
    </div>
    {* Lightbox — smooth open/close, keyboard escape/arrow nav *}
    <div id="lightbox" class="wb-lightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
        <button class="wb-lightbox__close" id="lightbox-close-btn" aria-label="Close viewer">&times;</button>
        <button class="wb-lightbox__nav wb-lightbox__nav--prev" id="lightbox-prev-btn" aria-label="Previous image">&#8249;</button>
        <button class="wb-lightbox__nav wb-lightbox__nav--next" id="lightbox-next-btn" aria-label="Next image">&#8250;</button>
        <img id="lightbox-img" class="wb-lightbox__img" src="" alt="">
        <div id="lightbox-caption" class="wb-lightbox__caption"></div>
    </div>

    <script>
    {* Lightbox state *}
    var wbLightboxItems = [];
    var wbLightboxIndex = 0;

    {* Ensure legacy PAL controls expose names while templates are progressively
       migrated to explicit label/for pairs. Dynamic rows are covered too. *}
    function wbEnsureAccessibleNames(root) {
        (root || document).querySelectorAll('input:not([type="hidden"]), select, textarea, button, a[role="button"]').forEach(function(el) {
            if (el.getAttribute('aria-label') || el.getAttribute('aria-labelledby')) return;
            if (el.id && document.querySelector('label[for="' + CSS.escape(el.id) + '"]')) return;
            if (el.closest('label')) return;
            if ((el.matches('button, a[role="button"]')) && (el.textContent || '').trim()) return;

            var container = el.closest('.wb-field, div, td');
            var label = container ? container.querySelector('label') : null;
            var name = label ? (label.textContent || '') : '';
            if (!name) name = el.getAttribute('placeholder') || el.getAttribute('title') || el.getAttribute('data-wb-action') || el.getAttribute('name') || '';
            name = name.replace(/[＊*]/g, '').replace(/[_\[\]]+/g, ' ').replace(/\s+/g, ' ').trim();
            if (name) el.setAttribute('aria-label', name);
        });
    }

    function openLightbox(src, caption) {
        var lb = document.getElementById('lightbox');
        document.getElementById('lightbox-img').src = src;
        document.getElementById('lightbox-caption').textContent = caption || '';
        lb.classList.add('active');
        document.body.style.overflow = 'hidden';

        // Find index in gallery if applicable
        wbLightboxIndex = wbLightboxItems.findIndex(function(i) { return i.src === src; });
        if (wbLightboxIndex < 0) {
            wbLightboxItems = [{src: src, caption: caption || ''}];
            wbLightboxIndex = 0;
        }
        updateLightboxNav();
    }

    function closeLightbox() {
        document.getElementById('lightbox').classList.remove('active');
        document.body.style.overflow = '';
    }

    function updateLightboxNav() {
        var prev = document.getElementById('lightbox-prev-btn');
        var next = document.getElementById('lightbox-next-btn');
        prev.style.display = wbLightboxItems.length > 1 ? '' : 'none';
        next.style.display = wbLightboxItems.length > 1 ? '' : 'none';
    }

    function lightboxPrev() {
        if (wbLightboxItems.length < 2) return;
        wbLightboxIndex = (wbLightboxIndex - 1 + wbLightboxItems.length) % wbLightboxItems.length;
        var item = wbLightboxItems[wbLightboxIndex];
        document.getElementById('lightbox-img').src = item.src;
        document.getElementById('lightbox-caption').textContent = item.caption || '';
    }

    function lightboxNext() {
        if (wbLightboxItems.length < 2) return;
        wbLightboxIndex = (wbLightboxIndex + 1) % wbLightboxItems.length;
        var item = wbLightboxItems[wbLightboxIndex];
        document.getElementById('lightbox-img').src = item.src;
        document.getElementById('lightbox-caption').textContent = item.caption || '';
    }

    {* Reusable lightbox trigger wiring — call after dynamic content loads *}
    function wbInitLightbox() {
        document.querySelectorAll('[data-wb-lightbox]').forEach(function(el) {
            if (el._wbLightboxWired) return;
            el._wbLightboxWired = true;
            el.addEventListener('click', function(e) {
                e.preventDefault();
                var src = el.getAttribute('data-wb-lightbox');
                var cap = el.getAttribute('data-wb-lightbox-caption') || '';
                // Collect gallery siblings
                var parent = el.closest('[data-wb-gallery]');
                wbLightboxItems = [];
                if (parent) {
                    parent.querySelectorAll('[data-wb-lightbox]').forEach(function(s) {
                        wbLightboxItems.push({
                            src: s.getAttribute('data-wb-lightbox'),
                            caption: s.getAttribute('data-wb-lightbox-caption') || ''
                        });
                    });
                }
                openLightbox(src, cap);
            });
        });
    }

    {* Lightbox event listeners *}
    document.addEventListener('DOMContentLoaded', function() {
        wbEnsureAccessibleNames(document);
        new MutationObserver(function(records) {
            records.forEach(function(record) {
                record.addedNodes.forEach(function(node) {
                    if (node.nodeType === 1) wbEnsureAccessibleNames(node);
                });
            });
        }).observe(document.body, {childList:true, subtree:true});
        var lb = document.getElementById('lightbox');
        if (!lb) return;

        // Click outside image to close
        lb.addEventListener('click', function(e) {
            if (e.target === lb) closeLightbox();
        });

        document.getElementById('lightbox-close-btn').addEventListener('click', closeLightbox);

        document.getElementById('lightbox-prev-btn').addEventListener('click', function(e) {
            e.stopPropagation(); lightboxPrev();
        });
        document.getElementById('lightbox-next-btn').addEventListener('click', function(e) {
            e.stopPropagation(); lightboxNext();
        });

        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            if (!lb.classList.contains('active')) return;
            if (e.key === 'Escape') { closeLightbox(); e.preventDefault(); }
            if (e.key === 'ArrowLeft') { lightboxPrev(); e.preventDefault(); }
            if (e.key === 'ArrowRight') { lightboxNext(); e.preventDefault(); }
        });

        // Initial wire up
        wbInitLightbox();
    });
    </script>
{/include}
