<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title} — Project Audit Ledger</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>
        * { border-radius: 3px !important; }
        @media print { body * { visibility: hidden; } .print-area, .print-area * { visibility: visible; } .print-area { position: absolute; left: 0; top: 0; width: 100%; } .no-print { display: none !important; } }
        /* Lightbox */
        .lightbox-overlay { display: none; position: fixed; z-index: 9999; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); justify-content: center; align-items: center; }
        .lightbox-overlay.active { display: flex; }
        .lightbox-overlay img { max-width: min(600px, 90vw); max-height: 85vh; object-fit: contain; border-radius: 6px; }
        .lightbox-close { position: absolute; top: 20px; right: 30px; color: #fff; font-size: 32px; cursor: pointer; font-weight: bold; z-index: 10000; }
        .lightbox-close:hover { color: #ccc; }
        .lightbox-caption { position: absolute; bottom: 20px; left: 0; right: 0; text-align: center; color: #ccc; font-size: 13px; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <aside class="w-64 bg-slate-900 flex flex-col" x-data="{ collapsed: false }">
            <div class="p-4 border-b border-slate-700">
                {if pal_logo_path}<img src="/{pal_logo_path}" class="h-8 mb-1">{/if}
                <h1 class="text-lg font-bold text-white">{pal_app_name}</h1>
                <p class="text-xs text-slate-400">{current_user.full_name}</p>
            </div>
            <nav class="flex-1 overflow-y-auto p-2 space-y-1">
                <a href="/admin/project-audit-ledger" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    📊 Dashboard
                </a>
                <a href="/admin/project-audit-ledger/projects" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    📁 Projects
                </a>
                <a href="/admin/project-audit-ledger/clients" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    👤 Clients
                </a>
                <a href="/admin/project-audit-ledger/suppliers" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    🏭 Suppliers
                </a>
                <a href="/admin/project-audit-ledger/expenses" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    💳 Expenses
                </a>
                <a href="/admin/project-audit-ledger/inventory" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    📦 Inventory
                </a>
                <a href="/admin/project-audit-ledger/inventory/movements" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    📤 Stock Movements
                </a>
                <a href="/admin/project-audit-ledger/purchases" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    🛒 Purchases
                </a>
                <a href="/admin/project-audit-ledger/material-issuance" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    📋 Issuance
                </a>
                <a href="/admin/project-audit-ledger/material-returns" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    🔄 Returns
                </a>
                <a href="/admin/project-audit-ledger/fabrication" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    🔧 Fabrication
                </a>
                <a href="/admin/project-audit-ledger/sales" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    💰 Sales
                </a>
                <a href="/admin/project-audit-ledger/collections" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    💵 Collections
                </a>
                <a href="/admin/project-audit-ledger/approvals" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    ✅ Approvals
                </a>
                <a href="/admin/project-audit-ledger/reports" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    📈 Reports
                </a>
                {if current_user.role == 'admin'}
                <hr class="my-2 border-slate-700">
                <a href="/admin/project-audit-ledger/audit" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    📜 Audit Trail
                </a>
                <a href="/admin/project-audit-ledger/settings" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    ⚙️ Settings
                </a>
                <a href="/admin/project-audit-ledger/users" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors">
                    👥 Users
                </a>
                {/if}
            </nav>
            <div class="p-4 border-t border-slate-700">
                <form method="POST" action="/api/v1/project-audit-ledger/auth/logout">
                    <button type="submit" class="w-full text-left px-3 py-2 rounded-lg text-sm text-slate-400 hover:bg-slate-700 hover:text-white transition-colors">Sign Out</button>
                </form>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 overflow-y-auto">
            <div class="p-6">
                <h1 class="text-2xl font-bold text-gray-900 mb-6">{page_title}</h1>
                {page_body|raw}
            </div>
        </main>
    </div>
<!-- Toast -->
<div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2"></div>
<!-- Lightbox -->
<div id="lightbox" class="lightbox-overlay" onclick="closeLightbox()">
    <span class="lightbox-close" onclick="closeLightbox()">&times;</span>
    <img id="lightbox-img" src="" alt="">
    <div id="lightbox-caption" class="lightbox-caption"></div>
</div>
<script>
function showToast(msg, type) {
    type = type || 'success';
    var colors = { success: 'bg-green-600', error: 'bg-red-600', info: 'bg-blue-600' };
    var el = document.createElement('div');
    el.className = (colors[type] || 'bg-gray-700') + ' text-white px-4 py-2 rounded-lg shadow-lg text-sm transition-opacity duration-300';
    el.textContent = msg;
    document.getElementById('toast-container').appendChild(el);
    setTimeout(function(){ el.style.opacity = '0'; setTimeout(function(){ el.remove(); }, 300); }, 3000);
}
function autocomplete(input, type, opts) {
    opts = opts || {};
    var container = document.createElement('div');
    container.className = 'relative';
    input.parentNode.insertBefore(container, input);
    container.appendChild(input);
    var dropdown = document.createElement('div');
    dropdown.className = 'absolute z-50 w-full bg-white border border-gray-300 rounded shadow-lg max-h-48 overflow-y-auto hidden text-sm';
    container.appendChild(dropdown);
    var hidden = document.createElement('input');
    hidden.type = 'hidden';
    hidden.name = input.name.replace('_autocomplete', '_id');
    container.appendChild(hidden);
    var selectedId = null;
    input.addEventListener('input', function() {
        var q = input.value.trim();
        if (q.length < 1) { dropdown.classList.add('hidden'); dropdown.innerHTML = ''; return; }
        fetch('/api/v1/project-audit-ledger/autocomplete?type=' + encodeURIComponent(type) + '&q=' + encodeURIComponent(q))
        .then(function(r){ return r.json(); })
        .then(function(data){
            dropdown.innerHTML = '';
            if (data.length === 0) {
                var d = document.createElement('div');
                d.className = 'px-3 py-2 text-xs text-gray-600';
                d.textContent = opts.noResults || 'No results. Type to create new.';
                dropdown.appendChild(d);
            } else {
                data.forEach(function(item){
                    var d = document.createElement('div');
                    d.className = 'px-3 py-2 cursor-pointer hover:bg-blue-50 border-b border-gray-100 last:border-b-0';
                    d.innerHTML = '<div class="font-medium text-sm">' + item.label + '</div>' + (item.sublabel ? '<div class="text-xs text-gray-600">' + item.sublabel + '</div>' : '');
                    d.addEventListener('click', function(){
                        input.value = item.label;
                        hidden.value = item.id;
                        selectedId = item.id;
                        dropdown.classList.add('hidden');
                        if (opts.onSelect) opts.onSelect(item);
                    });
                    dropdown.appendChild(d);
                });
            }
            dropdown.classList.remove('hidden');
        })
        .catch(function(){});
    });
    input.addEventListener('blur', function(){ setTimeout(function(){ dropdown.classList.add('hidden'); }, 200); });
    input.addEventListener('focus', function(){ if (dropdown.children.length > 0) dropdown.classList.remove('hidden'); });
    input.dataset.autocomplete = 'true';
    input.name = input.name + '_autocomplete';
}
function makeCreatable(select) {
    var opt = document.createElement('option');
    opt.value = '__other__';
    opt.textContent = '✦ Other: type new...';
    select.appendChild(opt);
    var wrapper = document.createElement('div');
    wrapper.className = 'hidden mt-1';
    wrapper.innerHTML = '<input type="text" placeholder="Type new name" class="w-full px-2 py-1.5 border border-blue-400 rounded text-sm creatable-input">';
    select.parentNode.insertBefore(wrapper, select.nextSibling);
    select.addEventListener('change', function() {
        wrapper.classList.toggle('hidden', select.value !== '__other__');
        if (select.value !== '__other__') wrapper.querySelector('input').value = '';
    });
    var form = select.closest('form');
    if (form) {
        form.addEventListener('submit', function(e) {
            if (select.value !== '__other__') return;
            if (form.dataset.submitting === '1') return;
            e.preventDefault();
            var val = wrapper.querySelector('input').value.trim();
            if (!val) { showToast('Enter a name for the new item', 'error'); return; }
            var btn = form.querySelector('button[type="submit"]');
            var origText = btn.textContent;
            btn.disabled = true; btn.textContent = 'Creating...';
            var fd = new FormData();
            fd.append('type', select.getAttribute('data-creatable') || '');
            fd.append('name', val);
            var csrf = form.querySelector('input[name="_token"]');
            if (csrf) fd.append('_token', csrf.value);
            fetch('/api/v1/project-audit-ledger/quick-create', { method: 'POST', body: fd })
            .then(function(r){ return r.json(); })
            .then(function(d){
                if (d.ok) {
                    var o = document.createElement('option');
                    o.value = d.id; o.textContent = d.label; o.selected = true;
                    select.add(o, select.querySelector('option[value="__other__"]'));
                    select.value = d.id;
                    wrapper.classList.add('hidden');
                    wrapper.querySelector('input').value = '';
                    btn.textContent = origText;
                    ajaxSubmit(form, 'Saved');
                } else { showToast(d.error || 'Failed', 'error'); btn.disabled = false; btn.textContent = origText; }
            })
            .catch(function(){ showToast('Failed to create', 'error'); btn.disabled = false; btn.textContent = origText; });
        });
    }
}
function ajaxSubmit(form, successMsg) {
    if (form.dataset.submitting === '1') return false;
    form.dataset.submitting = '1';
    var btn = form.querySelector('button[type="submit"]');
    var orig = btn.textContent;
    btn.disabled = true; btn.textContent = 'Saving...';
    var data = new FormData(form);
    fetch(form.action, { method: 'POST', body: data })
    .then(function(r){ return r.json(); })
    .then(function(d){
        if (d.ok) {
            if (d.redirect) { window.location.href = d.redirect; return; }
            showToast(successMsg || 'Saved');
            setTimeout(function(){ location.reload(); }, 600);
        } else {
            showToast(d.error || 'Request failed', 'error');
            btn.disabled = false; btn.textContent = orig;
        }
    })
    .catch(function(){
        showToast('Network error', 'error');
        btn.disabled = false; btn.textContent = orig;
    });
    return false;
}
function toggleEdit(id) {
    var el = document.getElementById('edit-user-' + id);
    if (el) el.classList.toggle('hidden');
}
function switchTab(tab) {
    document.getElementById('table-active').classList.toggle('hidden', tab !== 'active');
    document.getElementById('table-inactive').classList.toggle('hidden', tab !== 'inactive');
    document.getElementById('tab-active').className = 'px-4 py-2 text-sm font-medium border-b-2 ' + (tab === 'active' ? 'border-blue-600 text-blue-600' : 'border-transparent text-gray-600 hover:text-gray-700');
    document.getElementById('tab-inactive').className = 'px-4 py-2 text-sm font-medium border-b-2 ' + (tab === 'inactive' ? 'border-blue-600 text-blue-600' : 'border-transparent text-gray-600 hover:text-gray-700');
}
function toggleUser(id) {
    if (!confirm('Toggle this user\'s active status?')) return;
    var csrfInput = document.querySelector('input[name="_token"]');
    var body = '';
    if (csrfInput) body = csrfInput.name + '=' + encodeURIComponent(csrfInput.value);
    fetch('/api/v1/project-audit-ledger/users/' + id + '/delete', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
    .then(function(r){ return r.json(); })
    .then(function(d){
        if (d.ok) { showToast(d.action === 'restored' ? 'User reactivated' : 'User deactivated'); setTimeout(function(){ location.reload(); }, 600); }
        else { showToast(d.error || 'Failed', 'error'); }
    })
    .catch(function(){ showToast('Request failed', 'error'); });
}
function approve(id) {
    if (!confirm('Approve this request?')) return;
    decide(id, 'approved');
}
function reject(id) {
    var remarks = prompt('Rejection reason (optional):');
    decide(id, 'rejected', remarks);
}
function decide(id, decision, remarks) {
    var csrfInput = document.querySelector('input[name="_token"]');
    var body = 'decision=' + encodeURIComponent(decision) + '&remarks=' + encodeURIComponent(remarks || '');
    if (csrfInput) body += '&' + csrfInput.name + '=' + encodeURIComponent(csrfInput.value);
    fetch('/api/v1/project-audit-ledger/approvals/' + id + '/decide', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
    .then(function(r){ return r.json(); })
    .then(function(d){
        if (d.ok) { showToast(decision === 'approved' ? 'Approved' : 'Rejected'); setTimeout(function(){ location.reload(); }, 600); }
        else { showToast(d.error || 'Failed', 'error'); }
    })
    .catch(function(){ showToast('Request failed', 'error'); });
}
function addPoRow() {
    var row = document.querySelector('.po-row');
    if (!row) return;
    var clone = row.cloneNode(true);
    clone.querySelectorAll('input').forEach(function(i){ i.value = ''; });
    clone.querySelectorAll('select').forEach(function(s){ s.selectedIndex = 0; });
    clone.querySelector('.line-total').textContent = '₱0.00';
    document.getElementById('po-items').appendChild(clone);
}
function addCategory(type, inputId) {
    var name = document.getElementById(inputId).value.trim();
    if (!name) { showToast('Enter a name', 'error'); return; }
    ajaxPost('/api/v1/project-audit-ledger/settings/categories', 'type='+encodeURIComponent(type)+'&name='+encodeURIComponent(name), 'Added');
}
function addUnit() {
    var name = document.getElementById('new-unit-name').value.trim();
    if (!name) { showToast('Enter a name', 'error'); return; }
    var abbr = document.getElementById('new-unit-abbr').value.trim();
    ajaxPost('/api/v1/project-audit-ledger/settings/categories', 'type=unit&name='+encodeURIComponent(name)+'&abbreviation='+encodeURIComponent(abbr), 'Added');
}
function addTeamLead() {
    var name = document.getElementById('new-tl-name').value.trim();
    if (!name) { showToast('Enter a name', 'error'); return; }
    var contact = document.getElementById('new-tl-contact').value.trim();
    var email = document.getElementById('new-tl-email').value.trim();
    ajaxPost('/api/v1/project-audit-ledger/settings/categories', 'type=team_lead&name='+encodeURIComponent(name)+'&contact_number='+encodeURIComponent(contact)+'&email='+encodeURIComponent(email), 'Added');
}
function addInvLocation() {
    var name = document.getElementById('new-loc-name').value.trim();
    if (!name) { showToast('Enter a name', 'error'); return; }
    var desc = document.getElementById('new-loc-desc').value.trim();
    ajaxPost('/api/v1/project-audit-ledger/settings/categories', 'type=inventory_location&name='+encodeURIComponent(name)+'&description='+encodeURIComponent(desc), 'Added');
}
function addSupplier() {
    var name = document.getElementById('new-sup-name').value.trim();
    if (!name) { showToast('Enter a name', 'error'); return; }
    var cp = document.getElementById('new-sup-cp').value.trim();
    var email = document.getElementById('new-sup-email').value.trim();
    ajaxPost('/api/v1/project-audit-ledger/settings/suppliers', 'name='+encodeURIComponent(name)+'&contact_person='+encodeURIComponent(cp)+'&email='+encodeURIComponent(email), 'Added');
}
function toggleStatus(type, id) {
    var csrfInput = document.querySelector('input[name="_token"]');
    var body = 'type='+encodeURIComponent(type)+(csrfInput?'&'+csrfInput.name+'='+encodeURIComponent(csrfInput.value):'');
    fetch('/api/v1/project-audit-ledger/settings/toggle/'+id, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
    .then(function(r){ return r.json(); })
    .then(function(d){ if (d.ok) { showToast('Updated'); setTimeout(function(){ location.reload(); }, 400); } else { showToast(d.error||'Failed','error'); } })
    .catch(function(){ showToast('Request failed','error'); });
}
function ajaxPost(url, body, msg) {
    var csrfInput = document.querySelector('input[name="_token"]');
    if (csrfInput) body += '&' + csrfInput.name + '=' + encodeURIComponent(csrfInput.value);
    fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
    .then(function(r){ return r.json(); })
    .then(function(d){ if (d.ok) { showToast(msg||'Saved'); setTimeout(function(){ location.reload(); }, 400); } else { showToast(d.error||'Failed','error'); } })
    .catch(function(){ showToast('Request failed','error'); });
}
function deletePoImage(id) {
    if (!confirm('Delete this PO image?')) return;
    var csrfInput = document.querySelector('input[name="_token"]');
    var body = csrfInput ? csrfInput.name + '=' + encodeURIComponent(csrfInput.value) : '';
    fetch('/api/v1/project-audit-ledger/attachments/' + id + '/delete', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
    .then(function(r){ return r.json(); })
    .then(function(d){ if (d.ok) { showToast('Deleted'); setTimeout(function(){ location.reload(); }, 400); } else { showToast(d.error||'Failed','error'); } })
    .catch(function(){ showToast('Request failed','error'); });
}
function uploadAttachment(form, entityType, entityId) {
    var btn = form.querySelector('button[type="submit"]');
    var orig = btn.textContent;
    btn.disabled = true; btn.textContent = 'Uploading...';
    var data = new FormData(form);
    data.append('entity_type', entityType);
    data.append('entity_id', entityId);
    fetch('/api/v1/project-audit-ledger/attachments', { method: 'POST', body: data })
    .then(function(r){ return r.json(); })
    .then(function(d){
        if (d.ok) { showToast('File uploaded'); setTimeout(function(){ location.reload(); }, 600); }
        else { showToast(d.error || 'Upload failed', 'error'); btn.disabled = false; btn.textContent = orig; }
    })
    .catch(function(){ showToast('Upload failed', 'error'); btn.disabled = false; btn.textContent = orig; });
    return false;
}
function exportCSV(tableId, filename) {
    var table = document.getElementById(tableId);
    if (!table) { showToast('Table not found', 'error'); return; }
    var rows = table.querySelectorAll('tr');
    var csv = '';
    rows.forEach(function(r){
        var cols = r.querySelectorAll('th, td');
        var row = [];
        cols.forEach(function(c){ row.push('"' + (c.textContent||'').trim().replace(/"/g,'""') + '"'); });
        csv += row.join(',') + '\n';
    });
    var blob = new Blob([csv], { type: 'text/csv' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = filename + '.csv';
    a.click();
    URL.revokeObjectURL(a.href);
}
function openLightbox(url, caption) {
    var lb = document.getElementById('lightbox');
    var img = document.getElementById('lightbox-img');
    var cap = document.getElementById('lightbox-caption');
    img.src = url;
    cap.textContent = caption || '';
    lb.classList.add('active');
}
function closeLightbox() {
    document.getElementById('lightbox').classList.remove('active');
}
</script>
</body>
</html>
