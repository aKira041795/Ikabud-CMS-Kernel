{* PAL Admin Shell — delegates to workbench:app_shell.
   shell_ctx is built in PHP by palBuildShellContext() in helpers.php. *}

{include "workbench:app_shell" shell=shell_ctx}
    {csrf_field|raw}
    <h1 class="text-2xl font-bold text-gray-900 mb-6">{page_title}</h1>
    {page_body|raw}
    {* Lightbox *}
    <div id="lightbox" class="lightbox-overlay" role="dialog" aria-modal="true" aria-label="Image viewer" onclick="closeLightbox()" hidden>
        <span class="lightbox-close" role="button" tabindex="0" aria-label="Close viewer">&times;</span>
        <img id="lightbox-img" src="" alt="">
        <div id="lightbox-caption" class="lightbox-caption"></div>
    </div>
{/include}

