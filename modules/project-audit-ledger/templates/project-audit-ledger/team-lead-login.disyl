<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Team Lead Login — Project Audit Ledger</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#f0f2f5] min-h-screen flex items-center justify-center p-4" style="background-image: radial-gradient(ellipse at 20% 50%, rgba(37,99,235,0.04) 0%, transparent 50%), radial-gradient(ellipse at 80% 50%, rgba(5,150,105,0.03) 0%, transparent 50%);">
    <div class="w-full max-w-sm">
        <div class="text-center mb-8">
            <div class="w-12 h-12 bg-blue-600 rounded-xl flex items-center justify-center mx-auto mb-3 shadow-sm">
                <span class="text-lg font-bold text-white">Z</span>
            </div>
            <h1 class="text-xl font-bold text-gray-900">ZAP-ARTS</h1>
            <p class="text-sm text-gray-500">Signage &amp; Printing Solutions</p>
            <p class="text-xs text-gray-400 mt-0.5">Team Lead Portal</p>
        </div>

        {if error}
        <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg p-3 mb-4">{error}</div>
        {/if}

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h2 class="text-sm font-semibold text-gray-900 mb-1">Enter your email</h2>
            <p class="text-xs text-gray-500 mb-4">A 6-digit code will be sent to your email.</p>
            <form onsubmit="return requestOtp(this)" class="space-y-4">
                {csrf_field | raw}
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5" for="tl-email">Email Address</label>
                    <input type="email" name="email" required autocomplete="email" placeholder="team.lead@zap-arts.com" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500" id="tl-email">
                </div>
                <button type="submit" id="tl-submit-btn" class="wb-btn wb-btn--primary wb-btn--lg" style="width:100%;justify-content:center;">
                    Send Verification Code
                </button>
            </form>
        </div>
        <div class="mt-4 text-center">
            <a href="/project-audit-ledger/login" class="text-xs text-gray-400 hover:text-gray-600">Admin Login</a>
        </div>
    </div>

    <script>
    function requestOtp(form) {
        var btn = document.getElementById('tl-submit-btn');
        btn.disabled = true;
        btn.textContent = 'Sending...';

        var formData = new FormData(form);
        fetch('/api/v1/project-audit-ledger/tl/otp-request', { method: 'POST', body: formData })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.ok) {
                window.location = '/project-audit-ledger/team-lead/verify?ticket=' + encodeURIComponent(d.ticket);
            } else {
                btn.disabled = false;
                btn.textContent = 'Send Verification Code';
                alert(d.error || 'Failed to send code.');
            }
        })
        .catch(function() {
            btn.disabled = false;
            btn.textContent = 'Send Verification Code';
            alert('Failed to send code. Please try again.');
        });
        return false;
    }
    </script>
</body>
</html>