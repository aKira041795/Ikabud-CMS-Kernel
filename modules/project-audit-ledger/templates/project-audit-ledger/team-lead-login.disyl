<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Team Lead Login — Project Audit Ledger</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        * { border-radius: 3px !important; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center">
    <div class="max-w-md w-full p-8">
        <div class="text-center mb-8">
            <h1 class="text-2xl font-bold text-gray-900">ZAP-ARTS</h1>
            <p class="text-sm text-gray-600">Signage & Printing Solutions</p>
            <p class="text-xs text-gray-500 mt-1">Team Lead Portal</p>
        </div>

        {if error}
        <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded text-sm text-red-700">{error}</div>
        {/if}

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h2 class="font-semibold text-gray-900 mb-2">Enter your email</h2>
            <p class="text-xs text-gray-600 mb-4">A 6-digit verification code will be sent to your email.</p>
            <form onsubmit="return requestOtp(this)" class="space-y-4">
                {csrf_field | raw}
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
                    <input type="email" name="email" required autocomplete="email" placeholder="team.lead@zap-arts.com" class="w-full px-3 py-2 border border-gray-300 rounded text-sm" id="tl-email">
                </div>
                <button type="submit" id="tl-submit-btn" class="w-full px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700 disabled:opacity-50">
                    Send Verification Code
                </button>
            </form>
        </div>
        <div class="mt-4 text-center">
            <a href="/project-audit-ledger/login" class="text-xs text-gray-500 hover:text-gray-700">Admin Login</a>
        </div>
    </div>

    <script>
    function requestOtp(form) {
        var btn = document.getElementById('tl-submit-btn');
        btn.disabled = true;
        btn.textContent = 'Sending...';

        var formData = new FormData(form);
        fetch('/api/v1/project-audit-ledger/tl/otp-request', { method: 'POST', body: formData })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.ok) {
                window.location = '/project-audit-ledger/team-lead/verify?ticket=' + encodeURIComponent(d.ticket);
            } else {
                btn.disabled = false;
                btn.textContent = 'Send Verification Code';
                alert(d.error || 'Failed to send code.');
            }
        })
        .catch(function() {
            btn.disabled = false;
            btn.textContent = 'Send Verification Code';
            alert('Failed to send code. Please try again.');
        });
        return false;
    }
    </script>
</body>
</html>