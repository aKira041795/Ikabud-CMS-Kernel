<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Team Lead Login — Project Audit Ledger</title>
<link rel="stylesheet" href="/assets/workbench/workbench-tailwind.css?v=6">
<link rel="stylesheet" href="/assets/workbench/workbench.css?v=6">
</head>
<body class="wb-auth-page min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-sm">
        <div class="text-center mb-8">
            <div class="wb-auth-brand mx-auto mb-3">
                <span class="text-lg font-bold text-white">Z</span>
            </div>
            <h1 class="text-xl font-bold text-gray-900">ZAP-ARTS</h1>
            <p class="text-sm text-gray-500">Signage &amp; Printing Solutions</p>
            <p class="text-xs text-gray-400 mt-0.5">Team Lead Portal</p>
        </div>

        {if error}
        <div class="wb-alert wb-alert--danger">{error}</div>
        {/if}

        <div class="wb-auth-card p-6">
            <h2 class="text-sm font-semibold text-gray-900 mb-1">Enter your email</h2>
            <p class="text-xs text-gray-500 mb-4">A 6-digit code will be sent to your email.</p>
            <form onsubmit="return requestOtp(this)" class="wb-form-surface">
                {csrf_field | raw}
                {if redirect}
                <input type="hidden" name="redirect" value="{redirect}">
                {/if}
                <div>
                    <label class="wb-label" for="tl-email">Email Address</label>
                    <input type="email" name="email" required autocomplete="email" placeholder="team.lead@zap-arts.com" class="wb-input" id="tl-email">
                </div>
                <button type="submit" id="tl-submit-btn" class="wb-btn wb-btn--primary wb-btn--lg" style="width:100%;justify-content:center;">
                    Send Verification Code
                </button>
            </form>
        </div>
        <div class="mt-4 text-center">
            <a href="/project-audit-ledger/login" class="wb-auth-link text-xs">Admin Login</a>
        </div>
    </div>

    <script src="/assets/workbench/workbench-core.js?v=6"></script>
    <script>
    function requestOtp(form) {
        var btn = document.getElementById('tl-submit-btn');
        btn.disabled = true;
        btn.textContent = 'Sending...';

        var formData = new FormData(form);
        fetch('/api/v1/project-audit-ledger/tl/otp-request', { method: 'POST', body: formData })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.ok) {
                window.location = '/project-audit-ledger/team-lead/verify?ticket=' + encodeURIComponent(d.ticket);
            } else {
                btn.disabled = false;
                btn.textContent = 'Send Verification Code';
                alert(d.error || 'Failed to send code.');
            }
        })
        .catch(function() {
            btn.disabled = false;
            btn.textContent = 'Send Verification Code';
            alert('Failed to send code. Please try again.');
        });
        return false;
    }
    </script>
</body>
</html>
