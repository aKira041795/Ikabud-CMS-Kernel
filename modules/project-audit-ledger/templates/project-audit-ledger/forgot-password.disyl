<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password — Project Audit Ledger</title>
<link rel="stylesheet" href="/assets/workbench/workbench-tailwind.css?v=4">
<link rel="stylesheet" href="/assets/workbench/workbench.css?v=4">
</head>
<body class="wb-auth-page min-h-screen flex items-center justify-center p-4">
    <div class="wb-auth-card w-full max-w-md p-8">
        <div class="text-center mb-8">
            <h1 class="text-2xl font-bold text-gray-900">Forgot Password</h1>
            <p class="text-sm text-gray-600 mt-1">Enter your email to receive reset instructions</p>
        </div>

        {if error}
        <div class="wb-alert wb-alert--danger">{error}</div>
        {/if}

        <form method="POST" action="{baseUrl}/project-audit-ledger/auth/forgot-password">
            {csrf_field | raw}
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-1" for="email">Email</label>
                <input class="wb-input" type="email" id="email" name="email" required>
            </div>
            <button type="submit" class="wb-btn wb-btn--primary wb-btn--lg" style="width:100%">Send Reset Link</button>
        </form>

        <div class="text-center mt-4">
            <a href="{baseUrl}/project-audit-ledger/login" class="wb-auth-link text-sm">Back to Login</a>
        </div>
    </div>
    <script src="/assets/workbench/workbench-core.js?v=3"></script>
</body>
</html>
