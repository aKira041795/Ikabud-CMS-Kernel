<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password — Project Audit Ledger</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-lg border border-gray-200 w-full max-w-md p-8">
        <div class="text-center mb-8">
            <h1 class="text-2xl font-bold text-gray-900">Forgot Password</h1>
            <p class="text-sm text-gray-600 mt-1">Enter your email to receive reset instructions</p>
        </div>

        {if error}
        <div class="bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg p-3 mb-4">{error}</div>
        {/if}

        <form method="POST" action="{baseUrl}/project-audit-ledger/auth/forgot-password">
            {csrf_field | raw}
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-1" for="email">Email</label>
                <input class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" type="email" id="email" name="email" required>
            </div>
            <button type="submit" class="w-full py-2.5 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 transition">Send Reset Link</button>
        </form>

        <div class="text-center mt-4">
            <a href="{baseUrl}/project-audit-ledger/login" class="text-sm text-blue-600 hover:text-blue-700 font-medium">Back to Login</a>
        </div>
    </div>
</body>
</html>
