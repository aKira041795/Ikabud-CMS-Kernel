<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title} — Project Audit Ledger</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#f0f2f5] min-h-screen flex items-center justify-center p-4" style="background-image: radial-gradient(ellipse at 20% 50%, rgba(37,99,235,0.04) 0%, transparent 50%), radial-gradient(ellipse at 80% 50%, rgba(5,150,105,0.03) 0%, transparent 50%);">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 w-full max-w-sm p-8">
        <div class="text-center mb-7">
            <div class="w-12 h-12 bg-blue-600 rounded-xl flex items-center justify-center mx-auto mb-4 shadow-sm">
                <span class="text-lg font-bold text-white">PL</span>
            </div>
            <h1 class="text-xl font-bold text-gray-900">Project Audit Ledger</h1>
            <p class="text-sm text-gray-500 mt-1">Sign in to your account</p>
        </div>

        {if error}
        <div class="wb-validation-summary">{error}</div>
        {/if}

        {if message}
        <div class="bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg p-3 mb-4">{message}</div>
        {/if}

        <form method="POST" action="{baseUrl}/project-audit-ledger/auth/login" class="space-y-4">
            {csrf_field | raw}
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5" for="username">Username</label>
                <input class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow" type="text" id="username" name="username" required autofocus placeholder="Enter your username">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5" for="password">Password</label>
                <input class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-shadow" type="password" id="password" name="password" required placeholder="Enter your password">
            </div>
            <div class="flex items-center justify-between text-sm">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" name="remember" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" checked>
                    <span class="text-gray-600">Remember me</span>
                </label>
                <a href="{baseUrl}/project-audit-ledger/forgot-password" class="text-blue-600 hover:text-blue-700 font-medium">Forgot password?</a>
            </div>
            <button type="submit" class="wb-btn wb-btn--primary wb-btn--lg" style="width:100%;justify-content:center;">Sign In</button>
        </form>

        <div class="mt-6 pt-5 border-t border-gray-100 text-xs text-gray-500 text-center leading-relaxed">
            <p>Contact your administrator for access.</p>
        </div>
    </div>
</body>
</html>
