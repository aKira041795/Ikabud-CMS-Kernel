{
    "id": "bakeshop",
    "name": "Bakeshop Operations",
    "version": "1.0.0",
    "description": "Stand-alone bakeshop supervisor operations for products, recipes, deliveries, production, and usage reporting.",
    "author": "Ikabud Kernel Team",
    "owns_tables": [
        "bakeshop_users",
        "bakeshop_password_resets",
        "bakeshop_branches",
        "bakeshop_units",
        "bakeshop_ingredients",
        "bakeshop_products",
        "bakeshop_product_recipe",
        "bakeshop_deliveries",
        "bakeshop_delivery_items",
        "bakeshop_branch_product_targets",
        "bakeshop_production_runs",
        "bakeshop_production_items",
        "bakeshop_inventory_adjustments",
        "bakeshop_product_allocations"
    ],
    "reads_tables": [
        "bakeshop_ingredient_usage",
        "audit_logs"
    ],
    "migrations": [
        "database/migrations/001_bakeshop_core.sql",
        "database/migrations/002_bakeshop_users.sql",
        "database/migrations/003_bakeshop_bootstrap_admin.sql",
        "database/migrations/004_bakeshop_user_token_version.sql",
        "database/migrations/005_bakeshop_bootstrap_password_reset.sql",
        "database/migrations/006_bakeshop_password_resets.sql",
        "database/migrations/007_bakeshop_delivery_item_cost_basis.sql",
        "database/migrations/008_bakeshop_production_voiding.sql",
        "database/migrations/009_bakeshop_delivery_coverage.sql",
        "database/migrations/010_bakeshop_branch_product_targets.sql",
        "database/migrations/011_bakeshop_ingredient_pack.sql",
        "database/migrations/012_bakeshop_inventory_adjustments_and_reorder.sql",
        "database/migrations/013_bakeshop_product_allocations.sql",
        "database/migrations/014_bakeshop_production_day_fraction.sql"
    ],
    "capabilities": {
        "exposes": [
            {
                "id": "kernel.auth.authenticate@1",
                "priority": 560,
                "modes": [
                    "pipeline"
                ]
            },
            {
                "id": "bakeshop.read@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "bakeshop.manage@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "bakeshop.product.read@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "bakeshop.ingredient.usage.read@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "entity.list.bakeshop_product@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "List bakeshop products"
            },
            {
                "id": "entity.get.bakeshop_product@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Get single bakeshop product"
            }
        ],
        "depends": [
            "kernel.audit.record@1",
            "kernel.auth.user@1"
        ],
        "policy": {
            "capabilities": {
                "kernel.auth.authenticate@1": {
                    "allow_callers": [
                        "bakeshop",
                        "kernel"
                    ]
                }
            }
        }
    },
    "auth_cookie": "bakeshop_token",
    "auth_owned": {
        "users_table": "bakeshop_users",
        "username_column": "username",
        "email_column": "email",
        "password_column": "password_hash",
        "name_column": "full_name",
        "active_column": "is_active",
        "admin_roles": [
            "admin"
        ],
        "default_admin_role": "admin",
        "requires_named_admin_on_provision": true,
        "blocked_password_hashes": [
            "!bakeshop-bootstrap-password-reset-required!",
            "$2y$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi"
        ],
        "touch_updated_at": true
    },
    "routes": true,
    "events": [
        "bakeshop.branch.created",
        "bakeshop.delivery.created",
        "bakeshop.production.created",
        "bakeshop.production.updated",
        "bakeshop.production.voided",
        "bakeshop.product.created",
        "bakeshop.ingredient.created",
        "bakeshop.recipe.saved"
    ],
    "settings_fields": [
        {
            "key": "store_name",
            "type": "text",
            "label": "Store Name",
            "default": "Julie's Bakeshop",
            "description": "Brand name shown in the bakeshop admin shell and printable summary."
        },
        {
            "key": "store_description",
            "type": "text",
            "label": "Store Description",
            "default": "Production, deliveries, recipes, staff access, and daily reporting inside the bakeshop module.",
            "description": "Short supporting copy shown below the store name in the bakeshop shell and printable summary."
        },
        {
            "key": "store_logo_url",
            "type": "text",
            "label": "Store Logo",
            "default": "",
            "description": "Optional uploaded logo image used for the bakeshop shell and printable summary."
        },
        {
            "key": "usage_decimal_places",
            "type": "number",
            "label": "Usage Decimal Places",
            "default": "2",
            "description": "Number of decimal places used in the ingredient usage summary and printable reports."
        },
        {
            "key": "default_dr_coverage_days",
            "type": "number",
            "label": "Default DR Coverage Days",
            "default": "3",
            "description": "Default number of production days covered by each delivery receipt when staff records a new DR."
        },
        {
            "key": "product_recipe_status",
            "type": "select",
            "label": "Product Recipes",
            "default": "active",
            "description": "Activate or deactivate product recipe maintenance across the bakeshop workspace. When deactivated, production stays output-only even if the recipe policy remains set to required.",
            "options": [
                {
                    "label": "Activate Recipes",
                    "value": "active"
                },
                {
                    "label": "Deactivate Recipes",
                    "value": "inactive"
                }
            ]
        },
        {
            "key": "production_recipe_mode",
            "type": "select",
            "label": "Production Recipe Policy",
            "default": "optional",
            "description": "Choose whether production entries require recipe and standard batch setup or can be saved as output-only entries.",
            "options": [
                {
                    "label": "Recipe Optional",
                    "value": "optional"
                },
                {
                    "label": "Recipe Required",
                    "value": "required"
                }
            ]
        },
        {
            "key": "print_template",
            "type": "select",
            "label": "Print Template",
            "default": "standard",
            "description": "Printable summary layout for per-branch usage reports.",
            "options": [
                {
                    "label": "Standard",
                    "value": "standard"
                }
            ]
        },
        {
            "key": "suggested_reorder_days",
            "type": "number",
            "label": "Suggested Reorder Horizon (Days)",
            "default": "7",
            "description": "Number of forward-looking days used when computing suggested reorder quantities from daily consumption rates."
        },
        {
            "key": "role_permissions",
            "type": "textarea",
            "label": "Role Permissions",
            "default": "",
            "description": "Optional JSON role-to-permission map for bakeshop runtime access. Supported permissions: bakeshop.read, bakeshop.manage."
        }
    ],
    "nav": [
        {
            "label": "Bakeshop",
            "url": "/admin/bakeshop",
            "icon": "package",
            "roles": [
                "admin",
                "supervisor"
            ]
        },
        {
            "label": "Staff",
            "url": "/admin/bakeshop/users",
            "icon": "users",
            "roles": [
                "admin"
            ]
        },
        {
            "label": "My Account",
            "url": "/admin/bakeshop/account",
            "icon": "user",
            "roles": [
                "admin",
                "supervisor"
            ]
        }
    ]
}