    "entity_contexts": {
        "definitions": [
            {
                "id": "commerce",
                "label": "Commerce",
                "capabilities": [
                    "pricing",
                    "inventory",
                    "media_gallery"
                ],
                "priority": 80
            }
        ],
        "extensions": [
            {
                "context": "business",
                "label": "Business Commerce Extension",
                "capabilities": [
                    "pricing"
                ],
                "priority": 70
            }
        ],
