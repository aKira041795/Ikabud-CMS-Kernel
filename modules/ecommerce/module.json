                "entity_type": "product",
                "base": "commerce",
                "priority": 90
            }
        ]
    },
    "settings_fields": [
        {
            "key": "currency",
            "type": "select",
            "label": "Currency",
            "control_class": "font-mono",
            "options": [
                "USD",
                "PHP",
                "EUR",
                "GBP",
                "AUD",
                "CAD",
                "SGD"
            ],
            "default": "USD",
            "description": "Default currency for all prices."
        },
        {
            "key": "currency_symbol",
            "type": "text",
            "label": "Currency Symbol",
            "control_class": "font-mono",
            "default": "$",
            "description": "Symbol shown before prices."
        },
        {
            "key": "enabled_currencies",
            "type": "text",
            "label": "Enabled Currencies",
            "control_class": "font-mono uppercase",
            "default": "USD",
            "description": "Comma-separated ISO currency codes available on the storefront. The base currency above is always enabled."
        },
        {
            "key": "currency_exchange_rates",
            "type": "textarea",
            "label": "Currency Exchange Rates",
            "control_class": "font-mono text-xs",
            "default": "",
            "description": "One currency per line using CODE|RATE, where RATE is the amount of that currency for 1 base-currency unit. Example: EUR|0.92"
        },
        {
            "key": "tax_default_country",
            "type": "text",
            "label": "Default Tax Country",
            "control_class": "font-mono uppercase",
            "default": "",
            "description": "Optional ISO country code used for cart previews before a customer enters a destination."
        },
        {
            "key": "tax_rate",
            "type": "number",
            "label": "Fallback Tax Rate (%)",
            "default": "0",
            "description": "Legacy fallback percentage used when no destination-specific tax rule matches."
        },
        {
            "key": "tax_inclusive",
            "type": "checkbox",
            "label": "Prices are tax-inclusive",
            "default": false,
            "description": "If checked, displayed prices already include tax."
        },
        {
            "key": "tax_standard_rules",
            "type": "textarea",
            "label": "Standard Tax Rules",
            "control_class": "font-mono text-xs",
            "default": "",
            "description": "One rule per line using COUNTRY|STATE|CITY|POSTAL|RATE. Use * as a wildcard."
        },
        {
            "key": "tax_reduced_rules",
            "type": "textarea",
            "label": "Reduced Tax Rules",
            "control_class": "font-mono text-xs",
            "default": "",
            "description": "Destination rules for products assigned to the reduced tax class. Same COUNTRY|STATE|CITY|POSTAL|RATE format."
        },
        {
            "key": "tax_zero_rules",
            "type": "textarea",
            "label": "Zero Tax Rules",
            "control_class": "font-mono text-xs",
            "default": "",
            "description": "Optional destination rules for products assigned to the zero tax class. Leave blank for always-zero fallback."
        },
        {
            "key": "order_number_prefix",
            "type": "text",
            "label": "Order Number Prefix",
            "control_class": "font-mono",
            "default": "EC",
            "description": "Prefix for order numbers, e.g. EC-2026-0001."
        },
        {
            "key": "low_stock_threshold",
            "type": "number",
            "label": "Low Stock Threshold",
            "default": "5",
            "description": "Warn when product stock falls below this number."
        },
        {
            "key": "guest_checkout",
            "type": "checkbox",
            "label": "Allow Guest Checkout",
            "default": true,
            "description": "Allow customers to check out without creating an account."
        },
        {
            "key": "require_account_for_digital",
            "type": "checkbox",
            "label": "Require Account for Digital Downloads",
            "default": true,
            "description": "When a cart contains digital products, guests are automatically registered as customers so they can access downloads from their account. Disable to allow guest digital purchases (licenses emailed only, no account dashboard access)."
        },
        {
            "key": "abandoned_cart_enabled",
            "type": "checkbox",
            "label": "Enable Abandoned Cart Recovery",
            "default": false,
            "description": "Track checkout leads with saved carts and send staged recovery emails until the cart converts or closes."
        },
        {
            "key": "abandoned_cart_first_delay_hours",
            "type": "number",
            "label": "First Recovery Delay (Hours)",
            "default": "1",
            "description": "Hours of inactivity before the first abandoned-cart reminder is sent."
        },
        {
            "key": "abandoned_cart_second_delay_hours",
            "type": "number",
            "label": "Second Recovery Delay (Hours)",
            "default": "24",
            "description": "Hours of inactivity before the second reminder is sent."
        },
        {
            "key": "abandoned_cart_third_delay_hours",
            "type": "number",
            "label": "Third Recovery Delay (Hours)",
            "default": "72",
            "description": "Hours of inactivity before the final reminder is sent."
        },
        {
            "key": "payment_gateway",
            "type": "select",
            "label": "Payment Gateway",
            "default": "manual",
            "options": [
                "manual",
                "paymongo",
                "stripe",
                "paypal"
            ],
            "description": "Active payment gateway. 'manual' uses cash-on-delivery / bank transfer."
        },
        {
            "key": "payment_method_label",
            "type": "text",
            "label": "Payment Method Label",
            "default": "Pay on Delivery",
            "description": "Label shown to customers at checkout for the manual payment method."
        },
        {
            "key": "manual_payment_mode",
            "type": "select",
            "label": "Manual Payment Mode",
            "default": "pay_on_delivery",
            "options": [
                "pay_on_delivery",
                "bank_transfer",
                "offline_manual"
            ],
            "description": "Controls how manual orders are settled. Only pay_on_delivery is auto-completed from WMS cash-collection events."
        },
        {
            "key": "payment_instructions",
            "type": "textarea",
            "label": "Payment Instructions",
            "default": "",
            "description": "Instructions shown after placing order (e.g. bank account details)."
        },
        {
            "key": "payment_gateway_mode",
            "type": "select",
            "label": "Gateway Mode",
            "default": "sandbox",
            "options": [
                "sandbox",
                "live"
            ],
            "description": "Use sandbox for testing, live for real transactions."
        },
        {
            "key": "paymongo_public_key",
            "type": "text",
            "label": "PayMongo Public Key",
            "default": "",
            "description": "PayMongo public API key (pk_test_xxx or pk_live_xxx)."
        },
        {
            "key": "paymongo_secret_key",
            "type": "text",
            "label": "PayMongo Secret Key",
            "default": "",
            "description": "PayMongo secret API key (sk_test_xxx or sk_live_xxx). Never expose to frontend."
        },
        {
            "key": "paymongo_webhook_secret",
            "type": "text",
            "label": "PayMongo Webhook Secret",
            "default": "",
            "description": "Webhook signing secret from PayMongo dashboard for signature verification."
        },
        {
            "key": "paymongo_allowed_methods",
            "type": "text",
            "label": "PayMongo Allowed Methods",
            "default": "card,gcash,maya",
            "description": "Comma-separated payment methods: card, gcash, maya, grab_pay, dob."
        },
        {
            "key": "stripe_publishable_key",
            "type": "text",
            "label": "Stripe Publishable Key",
            "default": "",
            "description": "Stripe publishable API key (pk_test_xxx or pk_live_xxx)."
        },
        {
            "key": "stripe_secret_key",
            "type": "text",
            "label": "Stripe Secret Key",
            "default": "",
            "description": "Stripe secret API key (sk_test_xxx or sk_live_xxx). Never expose to frontend."
        },
        {
            "key": "stripe_webhook_secret",
            "type": "text",
            "label": "Stripe Webhook Secret",
            "default": "",
            "description": "Webhook signing secret from the Stripe dashboard for signature verification."
        },
        {
            "key": "stripe_allowed_payment_methods",
            "type": "text",
            "label": "Stripe Allowed Methods",
            "default": "card",
            "description": "Comma-separated Stripe Checkout payment methods. Use card to enable cards plus Apple Pay and Google Pay where supported."
        },
        {
            "key": "paypal_client_id",
            "type": "text",
            "label": "PayPal Client ID",
            "default": "",
            "description": "PayPal REST app client ID for sandbox or live mode."
        },
        {
            "key": "paypal_secret",
            "type": "text",
            "label": "PayPal Secret",
            "default": "",
            "description": "PayPal REST app secret for sandbox or live mode. Never expose to frontend."
        },
        {
            "key": "paypal_webhook_id",
            "type": "text",
            "label": "PayPal Webhook ID",
            "default": "",
            "description": "Webhook ID from the PayPal developer dashboard used when verifying webhook signatures."
        },
        {
            "key": "license_private_key_pem",
            "type": "textarea",
            "label": "License Signing Key (Private, PEM)",
            "control_class": "font-mono text-xs",
            "default": "",
            "description": "RSA private key (PEM format) used to sign digital software license JWTs. Leave blank to disable license generation. Generate with: openssl genrsa -out private.pem 2048"
        },
        {
            "key": "license_public_key_pem",
            "type": "textarea",
            "label": "License Verify Key (Public, PEM)",
            "control_class": "font-mono text-xs",
            "default": "",
            "description": "RSA public key (PEM format) corresponding to the private key above. Distribute this to module consumers so they can verify license JWTs offline. Generate with: openssl rsa -in private.pem -pubout -out public.pem"
        },
        {
            "key": "shop_page_title",
            "type": "text",
            "label": "Shop Page Title",
            "default": "Shop",
            "description": "Heading displayed on the public shop page."
        },
        {
            "key": "products_per_page",
            "type": "number",
            "label": "Products Per Page",
            "default": "12",
            "description": "How many products to show per page in the shop."
        },
        {
            "key": "cache_enabled",
            "type": "select",
            "label": "Enable Catalog Cache",
            "options": [
                "1",
                "0"
            ],
            "default": "1",
            "description": "Cache product listings and detail pages to reduce database load. Disable during heavy content editing."
        },
        {
            "key": "cache_ttl",
            "type": "number",
            "label": "Cache TTL (seconds)",
            "default": "300",
            "description": "How long cached catalog data remains valid. Set to 0 to disable caching."
        },
        {
            "key": "shipping_default_country",
            "type": "text",
            "label": "Default Shipping Country",
            "control_class": "font-mono uppercase",
            "default": "",
            "description": "Optional ISO country code used to quote shipping before a customer enters a destination. Falls back to the tax default country when blank."
        },
        {
            "key": "shipping_table_rate_rules",
            "type": "textarea",
            "label": "Table Rate Shipping Rules",
            "control_class": "font-mono text-xs",
            "default": "",
            "description": "One rule per line: COUNTRY|STATE|CITY|POSTAL|MIN_SUBTOTAL|MAX_SUBTOTAL|MIN_ITEMS|MAX_ITEMS|RATE|LABEL|CARRIER|ETA. Leave fields blank or use * for wildcards. When a table-rate rule matches, it overrides the flat database rates for that quote."
        },
        {
            "key": "wms_fulfillment_bridge_enabled",
            "type": "checkbox",
            "label": "Enable WMS Fulfillment Bridge",
            "default": false,
            "description": "Provision the default ecommerce↔WMS reserve, order-create, cancellation, and fulfillment-sync bridges."
        },
        {
            "key": "default_wms_warehouse_id",
            "type": "number",
            "label": "Default WMS Warehouse ID",
            "default": "0",
            "description": "Optional warehouse ID injected into ecommerce order events when cart items do not provide a warehouse. Set to 0 to require explicit routing elsewhere."
        },
        {
            "key": "admin_notification_email",
            "type": "email",
            "label": "Admin Order Notification Email",
            "default": "",
            "description": "Email address to notify when a new order is placed. Leave blank to disable."
        },
        {
            "key": "admin_email",
            "type": "email",
            "label": "Admin Email",
            "default": "",
            "description": "General admin email address for store communications."
        },
        {
            "key": "loyalty_earn_rate",
            "type": "number",
            "label": "Loyalty Earn Rate (pts per currency unit)",
            "default": "1",
            "description": "Points earned per 1 unit of order subtotal. Default: 1."
        },
        {
            "key": "loyalty_points_per_currency",
            "type": "number",
            "label": "Loyalty Redemption Rate (pts per currency unit)",
            "default": "100",
            "description": "Points required to redeem 1 currency unit of discount. Default: 100."
        },
        {
            "key": "loyalty_minimum_redeem",
            "type": "number",
            "label": "Minimum Points to Redeem",
            "default": "100",
            "description": "Minimum loyalty point balance required before a customer can redeem. Set to 0 to disable minimum."
        },
        {
            "key": "feature_reviews_enabled",
            "type": "checkbox",
            "label": "Customer Reviews",
            "default": true,
            "description": "Show customer reviews and the review submission form on product pages."
        },
        {
            "key": "feature_loyalty_enabled",
            "type": "checkbox",
            "label": "Loyalty Program",
            "default": true,
            "description": "Enable loyalty point earning, redemption, and the customer rewards account tab."
        },
        {
            "key": "feature_subscriptions_enabled",
            "type": "checkbox",
            "label": "Subscriptions",
            "default": true,
            "description": "Allow subscription products in the catalog and recurring cart and checkout flows."
        },
        {
            "key": "feature_memberships_enabled",
            "type": "checkbox",
            "label": "Memberships",
            "default": true,
            "description": "Enable membership products, membership-gated catalog access, and CMS content gating."
        },
        {
            "key": "feature_bookings_enabled",
            "type": "checkbox",
            "label": "Bookings & Appointments",
            "default": true,
            "description": "Enable bookable service products and appointment slot selection at checkout."
        },
        {
            "key": "feature_pos_enabled",
            "type": "checkbox",
            "label": "Point of Sale (POS)",
            "default": true,
            "description": "Enable the POS terminal for in-store transactions."
        },
        {
            "key": "feature_multistore_enabled",
            "type": "checkbox",
            "label": "Multi-Store",
            "default": true,
            "description": "Enable multi-store mode when more than one active store exists. Disabling hides store admin surfaces and forces single-store behavior."
        },
        {
            "key": "storefront_theme",
            "type": "select",
            "label": "Color Theme",
            "default": "orange",
            "options": [
                "orange",
                "indigo",
                "emerald",
                "rose"
            ],
            "description": "Color scheme applied to buttons, links, and accents across the public storefront."
        },
        {
            "key": "store_banner_enabled",
            "type": "checkbox",
            "label": "Show Store Banner",
            "default": false,
            "description": "Display a hero banner at the top of the shop page."
        },
        {
            "key": "store_banner_headline",
            "type": "text",
            "label": "Banner Headline",
            "default": "",
            "description": "Large heading text shown in the banner."
        },
        {
            "key": "store_banner_subtext",
            "type": "text",
            "label": "Banner Subtext",
            "default": "",
            "description": "Secondary line of text shown below the headline."
        },
        {
            "key": "store_banner_image_url",
            "type": "text",
            "label": "Banner Image URL",
            "default": "",
            "description": "Full URL of the background image for the banner. Leave blank for a solid colour background."
        },
        {
            "key": "store_banner_cta_text",
            "type": "text",
            "label": "CTA Button Text",
            "default": "Shop Now",
            "description": "Label for the call-to-action button in the banner. Leave blank to hide the button."
        },
        {
            "key": "store_banner_cta_url",
            "type": "text",
            "label": "CTA Button URL",
            "default": "",
            "description": "Where the CTA button links to. Defaults to the shop page when blank."
        },
        {
            "key": "social_facebook",
            "type": "text",
            "label": "Facebook URL",
            "default": "",
            "description": "Full URL to your Facebook page (e.g. https://facebook.com/yourpage)."
        },
        {
            "key": "social_instagram",
            "type": "text",
            "label": "Instagram URL",
            "default": "",
            "description": "Full URL to your Instagram profile."
        },
        {
            "key": "social_tiktok",
            "type": "text",
            "label": "TikTok URL",
            "default": "",
            "description": "Full URL to your TikTok profile."
        },
        {
            "key": "social_twitter",
            "type": "text",
            "label": "X / Twitter URL",
            "default": "",
            "description": "Full URL to your X (Twitter) profile."
        },
        {
            "key": "social_youtube",
            "type": "text",
            "label": "YouTube URL",
            "default": "",
            "description": "Full URL to your YouTube channel."
        },
        {
            "key": "store_hours",
            "type": "textarea",
            "label": "Operating Hours (JSON)",
            "default": "",
            "description": "JSON map of weekly hours. Managed via the Hours tab — do not edit manually."
        }
    ],
    "routes": true,
    "events": [
        {
            "key": "ecommerce.order.created",
            "description": "Fired when a new order is placed",
            "available_vars": [
                "order_id",
                "order_number",
                "customer_email",
                "total",
                "source",
                "actor_user_id",
                "idempotency_key",
                "order",
                "order.id",
                "order.order_number",
                "order.customer_name",
                "order.customer_email",
                "order.created_at",
                "order.warehouse_id",
                "order.items"
            ]
        },
        {
            "key": "ecommerce.order.paid",
            "description": "Fired when an order is marked as paid",
            "available_vars": [
                "order_id",
                "order_number",
                "total"
            ]
        },
        {
            "key": "ecommerce.order.shipped",
            "description": "Fired when an order is marked as shipped",
            "available_vars": [
                "order_id",
                "order_number",
                "tracking_number",
                "tracking_carrier",
                "tracking_url"
            ]
        },
        {
            "key": "ecommerce.order.refunded",
            "description": "Fired when a refund is created for an order",
            "available_vars": [
                "order_id",
                "order_number",
                "actor_user_id",
                "idempotency_key",
                "order",
                "order.id",
                "order.order_number",
                "order.customer_email",
                "order.warehouse_id",
                "order.items",
                "refund",
                "refund.id",
                "refund.refund_number",
                "refund.refunded_amount",
                "refund.gateway_refund_id",
                "refund.release_items"
            ]
        },
        {
            "key": "ecommerce.return.requested",
            "description": "Fired when a customer submits a return request for an order",
            "available_vars": [
                "order_id",
                "order_number",
                "customer_id",
                "order",
                "return_request",
                "return_request.id",
                "return_request.request_number",
                "return_request.status",
                "return_request.reason",
                "return_request.items"
            ]
        },
        {
            "key": "ecommerce.return.approved",
            "description": "Fired when an admin approves a customer return request",
            "available_vars": [
                "order_id",
                "order_number",
                "actor_user_id",
                "order",
                "return_request",
                "return_request.id",
                "return_request.request_number",
                "return_request.status",
                "return_request.reason",
                "return_request.wms_return_id",
                "return_request.wms_reference_number"
            ]
        },
        {
            "key": "ecommerce.return.rejected",
            "description": "Fired when an admin rejects a customer return request",
            "available_vars": [
                "order_id",
                "order_number",
                "actor_user_id",
                "order",
                "return_request",
                "return_request.id",
                "return_request.request_number",
                "return_request.status",
                "return_request.reason"
            ]
        },
        {
            "key": "ecommerce.order.cancelled",
            "description": "Fired when an order is cancelled",
            "available_vars": [
                "order_id",
                "order_number",
                "customer_email",
                "source",
                "actor_user_id",
                "idempotency_key",
                "order",
                "order.id",
                "order.order_number",
                "order.customer_email",
                "order.warehouse_id",
                "order.items"
            ]
        },
        {
            "key": "ecommerce.product.created",
            "description": "Fired when a product is created or first synced into ecommerce.",
            "available_vars": [
                "id",
                "product_id",
                "title",
                "slug",
                "excerpt",
                "product_type",
                "status",
                "is_active",
                "sku",
                "track_stock",
                "stock_qty",
                "price",
                "sale_price"
            ]
        },
        {
            "key": "ecommerce.product.updated",
            "description": "Fired when a product is updated or resynced in ecommerce.",
            "available_vars": [
                "id",
                "product_id",
                "title",
                "slug",
                "excerpt",
                "product_type",
                "status",
                "is_active",
                "sku",
                "track_stock",
                "stock_qty",
                "price",
                "sale_price"
            ]
        },
        {
            "key": "ecommerce.product.out_of_stock",
            "description": "Fired when a product stock reaches zero",
            "available_vars": [
                "product_id",
                "product_title",
                "sku"
            ]
        },
        {
            "key": "ecommerce.payment.webhook_received",
            "description": "Fired when a payment gateway webhook is received and processed",
            "available_vars": [
                "gateway",
                "event_type",
                "order_id",
                "intent_id"
            ]
        }
    ],
    "entities": {
        "products": {
            "authority": true
        },
        "orders": {
            "authority": true
        },
        "customers": {
            "authority": true
        }
    },
    "schedules": [
        {
            "frequency": "hourly",
            "handler": "ecommerce:ecProcessDueSubscriptionRenewals",
            "queue": "default"
        },
        {
            "frequency": "daily",
            "handler": "ecommerce:ecMembershipExpiryCleanup",
            "queue": "default"
        },
        {
            "frequency": "every_15_minutes",
            "handler": "ecommerce:ecAbandonedCartProcessDueReminders",
            "queue": "default"
        }
    ]
}