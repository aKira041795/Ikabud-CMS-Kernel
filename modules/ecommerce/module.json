{
    "id": "ecommerce",
    "name": "Ecommerce",
    "version": "1.0.0",
    "description": "Full-featured ecommerce module \u2014 products, cart, checkout, orders, POS, inventory, categories, coupons, and sales reports.",
    "author": "Noah C. Omamalin",
    "depends": [
        "cms"
    ],
    "owns_tables": [
        "ec_carts",
        "ec_cart_items",
        "ec_orders",
        "ec_order_items",
        "ec_order_meta",
        "ec_coupons",
        "ec_payment_transactions",
        "ec_product_variants",
        "ec_wishlist",
        "ec_pos_sessions",
        "ec_shipping_zones",
        "ec_shipping_rates",
        "ec_customer_addresses",
        "ec_order_licenses",
        "ec_order_status_history",
        "rate_limits"
    ],
    "reads_tables": [
        "cms_content",
        "cms_content_meta",
        "cms_categories",
        "cms_content_categories",
        "cms_tags",
        "cms_content_tags",
        "cms_entity_capabilities",
        "cms_media",
        "cms_users",
        "audit_logs"
    ],
    "migrations": [
        "modules/ecommerce/database/migrations/001_ec_core_schema.sql",
        "modules/ecommerce/database/migrations/002_ec_coupons.sql",
        "modules/ecommerce/database/migrations/003_ec_payment.sql",
        "modules/ecommerce/database/migrations/004_ec_pos.sql",
        "modules/ecommerce/database/migrations/005_ec_shipping.sql",
        "modules/ecommerce/database/migrations/006_ec_variants_wishlist.sql",
        "modules/ecommerce/database/migrations/007_ec_customers.sql",
        "modules/ecommerce/database/migrations/008_ec_cms_categories_taxonomy.sql",
        "modules/ecommerce/database/migrations/009_ec_digital_licenses.sql",
        "modules/ecommerce/database/migrations/010_ec_payment_intent_fields.sql",
        "modules/ecommerce/database/migrations/011_ec_digital_license_delivery.sql",
        "modules/ecommerce/database/migrations/012_ec_order_status_history.sql"
    ],
    "capabilities": {
        "exposes": [
            {
                "id": "cms.cart.add@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "ecommerce.products.list@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "schema": {
                    "type": "object",
                    "properties": {
                        "category_id": {
                            "type": "integer"
                        },
                        "search": {
                            "type": "string"
                        },
                        "limit": {
                            "type": "integer"
                        },
                        "offset": {
                            "type": "integer"
                        },
                        "status": {
                            "type": "string"
                        }
                    }
                }
            },
            {
                "id": "ecommerce.products.get@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "schema": {
                    "type": "object",
                    "required": [
                        "id"
                    ],
                    "properties": {
                        "id": {
                            "type": "integer"
                        }
                    }
                }
            },
            {
                "id": "ecommerce.cart.get@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "ecommerce.orders.create@1",
                "priority": 50,
                "modes": [
                    "first"
                ]
            },
            {
                "id": "ecommerce.orders.get@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "schema": {
                    "type": "object",
                    "required": [
                        "id"
                    ],
                    "properties": {
                        "id": {
                            "type": "integer"
                        }
                    }
                }
            },
            {
                "id": "ecommerce.orders.status.sync@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "schema": {
                    "type": "object",
                    "required": [
                        "status"
                    ],
                    "properties": {
                        "order_id": {
                            "type": "integer"
                        },
                        "order_number": {
                            "type": "string"
                        },
                        "external_reference": {
                            "type": "string"
                        },
                        "status": {
                            "type": "string"
                        },
                        "source": {
                            "type": "string"
                        },
                        "history_key": {
                            "type": "string"
                        },
                        "note": {
                            "type": "string"
                        },
                        "actor_user_id": {
                            "type": "integer"
                        },
                        "wms_order_id": {
                            "type": "integer"
                        },
                        "event": {
                            "type": "string"
                        }
                    }
                }
            },
            {
                "id": "ecommerce.orders.payment.sync@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "schema": {
                    "type": "object",
                    "required": [
                        "payment_status"
                    ],
                    "properties": {
                        "order_id": {
                            "type": "integer"
                        },
                        "order_number": {
                            "type": "string"
                        },
                        "external_reference": {
                            "type": "string"
                        },
                        "payment_status": {
                            "type": "string"
                        },
                        "only_if_gateway": {
                            "type": "string"
                        },
                        "only_if_manual_payment_mode": {
                            "type": "string"
                        },
                        "source": {
                            "type": "string"
                        },
                        "history_key": {
                            "type": "string"
                        },
                        "note": {
                            "type": "string"
                        },
                        "actor_user_id": {
                            "type": "integer"
                        },
                        "wms_order_id": {
                            "type": "integer"
                        },
                        "event": {
                            "type": "string"
                        },
                        "payment_method": {
                            "type": "string"
                        },
                        "collected_at": {
                            "type": "string"
                        }
                    }
                }
            }
        ],
        "depends": [],
        "policy": {
            "capabilities": {
                "cms.cart.add@1": {
                    "allow_callers": [
                        "cms",
                        "ecommerce"
                    ]
                },
                "ecommerce.products.list@1": {
                    "allow_callers": [
                        "ecommerce",
                        "cms"
                    ]
                },
                "ecommerce.products.get@1": {
                    "allow_callers": [
                        "ecommerce",
                        "cms"
                    ]
                },
                "ecommerce.cart.get@1": {
                    "allow_callers": [
                        "ecommerce",
                        "cms"
                    ]
                },
                "ecommerce.orders.create@1": {
                    "allow_callers": [
                        "ecommerce"
                    ]
                },
                "ecommerce.orders.get@1": {
                    "allow_callers": [
                        "ecommerce",
                        "cms"
                    ]
                },
                "ecommerce.orders.status.sync@1": {
                    "allow_callers": [
                        "ecommerce",
                        "wms",
                        "kernel"
                    ]
                },
                "ecommerce.orders.payment.sync@1": {
                    "allow_callers": [
                        "ecommerce",
                        "wms",
                        "kernel"
                    ]
                }
            }
        },
        "consumes": []
    },
    "entity_contexts": {
        "definitions": [
            {
                "id": "commerce",
                "label": "Commerce",
                "capabilities": [
                    "pricing",
                    "inventory",
                    "media_gallery"
                ],
                "priority": 80
            }
        ],
        "extensions": [
            {
                "context": "business",
                "label": "Business Commerce Extension",
                "capabilities": [
                    "pricing"
                ],
                "priority": 70
            }
        ],
        "bindings": [
            {
                "entity_type": "product",
                "base": "commerce",
                "priority": 90
            }
        ]
    },
    "settings_fields": [
        {
            "key": "currency",
            "type": "select",
            "label": "Currency",
            "control_class": "font-mono",
            "options": [
                "USD",
                "PHP",
                "EUR",
                "GBP",
                "AUD",
                "CAD",
                "SGD"
            ],
            "default": "USD",
            "description": "Default currency for all prices."
        },
        {
            "key": "currency_symbol",
            "type": "text",
            "label": "Currency Symbol",
            "control_class": "font-mono",
            "default": "$",
            "description": "Symbol shown before prices."
        },
        {
            "key": "tax_rate",
            "type": "number",
            "label": "Tax Rate (%)",
            "default": "0",
            "description": "Default tax percentage applied at checkout."
        },
        {
            "key": "tax_inclusive",
            "type": "checkbox",
            "label": "Prices are tax-inclusive",
            "default": false,
            "description": "If checked, displayed prices already include tax."
        },
        {
            "key": "order_number_prefix",
            "type": "text",
            "label": "Order Number Prefix",
            "control_class": "font-mono",
            "default": "EC",
            "description": "Prefix for order numbers, e.g. EC-2026-0001."
        },
        {
            "key": "low_stock_threshold",
            "type": "number",
            "label": "Low Stock Threshold",
            "default": "5",
            "description": "Warn when product stock falls below this number."
        },
        {
            "key": "guest_checkout",
            "type": "checkbox",
            "label": "Allow Guest Checkout",
            "default": true,
            "description": "Allow customers to check out without creating an account."
        },
        {
            "key": "require_account_for_digital",
            "type": "checkbox",
            "label": "Require Account for Digital Downloads",
            "default": true,
            "description": "When a cart contains digital products, guests are automatically registered as customers so they can access downloads from their account. Disable to allow guest digital purchases (licenses emailed only, no account dashboard access)."
        },
        {
            "key": "payment_gateway",
            "type": "select",
            "label": "Payment Gateway",
            "default": "manual",
            "options": [
                "manual",
                "paymongo"
            ],
            "description": "Active payment gateway. 'manual' uses cash-on-delivery / bank transfer."
        },
        {
            "key": "payment_method_label",
            "type": "text",
            "label": "Payment Method Label",
            "default": "Pay on Delivery",
            "description": "Label shown to customers at checkout for the manual payment method."
        },
        {
            "key": "manual_payment_mode",
            "type": "select",
            "label": "Manual Payment Mode",
            "default": "pay_on_delivery",
            "options": [
                "pay_on_delivery",
                "bank_transfer",
                "offline_manual"
            ],
            "description": "Controls how manual orders are settled. Only pay_on_delivery is auto-completed from WMS cash-collection events."
        },
        {
            "key": "payment_instructions",
            "type": "textarea",
            "label": "Payment Instructions",
            "default": "",
            "description": "Instructions shown after placing order (e.g. bank account details)."
        },
        {
            "key": "payment_gateway_mode",
            "type": "select",
            "label": "Gateway Mode",
            "default": "sandbox",
            "options": [
                "sandbox",
                "live"
            ],
            "description": "Use sandbox for testing, live for real transactions."
        },
        {
            "key": "paymongo_public_key",
            "type": "text",
            "label": "PayMongo Public Key",
            "default": "",
            "description": "PayMongo public API key (pk_test_xxx or pk_live_xxx)."
        },
        {
            "key": "paymongo_secret_key",
            "type": "text",
            "label": "PayMongo Secret Key",
            "default": "",
            "description": "PayMongo secret API key (sk_test_xxx or sk_live_xxx). Never expose to frontend."
        },
        {
            "key": "paymongo_webhook_secret",
            "type": "text",
            "label": "PayMongo Webhook Secret",
            "default": "",
            "description": "Webhook signing secret from PayMongo dashboard for signature verification."
        },
        {
            "key": "paymongo_allowed_methods",
            "type": "text",
            "label": "PayMongo Allowed Methods",
            "default": "card,gcash,maya",
            "description": "Comma-separated payment methods: card, gcash, maya, grab_pay, dob."
        },
        {
            "key": "license_private_key_pem",
            "type": "textarea",
            "label": "License Signing Key (Private, PEM)",
            "control_class": "font-mono text-xs",
            "default": "",
            "description": "RSA private key (PEM format) used to sign digital software license JWTs. Leave blank to disable license generation. Generate with: openssl genrsa -out private.pem 2048"
        },
        {
            "key": "license_public_key_pem",
            "type": "textarea",
            "label": "License Verify Key (Public, PEM)",
            "control_class": "font-mono text-xs",
            "default": "",
            "description": "RSA public key (PEM format) corresponding to the private key above. Distribute this to module consumers so they can verify license JWTs offline. Generate with: openssl rsa -in private.pem -pubout -out public.pem"
        },
        {
            "key": "shop_page_title",
            "type": "text",
            "label": "Shop Page Title",
            "default": "Shop",
            "description": "Heading displayed on the public shop page."
        },
        {
            "key": "products_per_page",
            "type": "number",
            "label": "Products Per Page",
            "default": "12",
            "description": "How many products to show per page in the shop."
        },
        {
            "key": "wms_fulfillment_bridge_enabled",
            "type": "checkbox",
            "label": "Enable WMS Fulfillment Bridge",
            "default": false,
            "description": "Provision the default ecommerce↔WMS reserve, order-create, cancellation, and fulfillment-sync bridges."
        },
        {
            "key": "default_wms_warehouse_id",
            "type": "number",
            "label": "Default WMS Warehouse ID",
            "default": "0",
            "description": "Optional warehouse ID injected into ecommerce order events when cart items do not provide a warehouse. Set to 0 to require explicit routing elsewhere."
        },
        {
            "key": "admin_notification_email",
            "type": "email",
            "label": "Admin Order Notification Email",
            "default": "",
            "description": "Email address to notify when a new order is placed. Leave blank to disable."
        },
        {
            "key": "admin_email",
            "type": "email",
            "label": "Admin Email",
            "default": "",
            "description": "General admin email address for store communications."
        }
    ],
    "events": [
        {
            "key": "ecommerce.order.created",
            "description": "Fired when a new order is placed",
            "available_vars": [
                "order_id",
                "order_number",
                "customer_email",
                "total",
                "source",
                "actor_user_id",
                "idempotency_key",
                "order",
                "order.id",
                "order.order_number",
                "order.customer_name",
                "order.customer_email",
                "order.created_at",
                "order.warehouse_id",
                "order.items"
            ]
        },
        {
            "key": "ecommerce.order.paid",
            "description": "Fired when an order is marked as paid",
            "available_vars": [
                "order_id",
                "order_number",
                "total"
            ]
        },
        {
            "key": "ecommerce.order.shipped",
            "description": "Fired when an order is marked as shipped",
            "available_vars": [
                "order_id",
                "order_number",
                "tracking_number"
            ]
        },
        {
            "key": "ecommerce.order.cancelled",
            "description": "Fired when an order is cancelled",
            "available_vars": [
                "order_id",
                "order_number",
                "customer_email",
                "source",
                "actor_user_id",
                "idempotency_key",
                "order",
                "order.id",
                "order.order_number",
                "order.customer_email",
                "order.warehouse_id",
                "order.items"
            ]
        },
        {
            "key": "ecommerce.product.out_of_stock",
            "description": "Fired when a product stock reaches zero",
            "available_vars": [
                "product_id",
                "product_title",
                "sku"
            ]
        },
        {
            "key": "ecommerce.payment.webhook_received",
            "description": "Fired when a payment gateway webhook is received and processed",
            "available_vars": [
                "gateway",
                "event_type",
                "order_id",
                "intent_id"
            ]
        }
    ],
    "entities": {
        "products": {
            "authority": true
        },
        "orders": {
            "authority": true
        },
        "customers": {
            "authority": true
        }
    }
}