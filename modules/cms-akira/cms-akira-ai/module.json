{
    "id": "cms-akira-ai",
    "name": "CMS Akira AI Assistant",
    "version": "1.0.0",
    "description": "CMS Akira AI assistant extension — generates summaries and keyword suggestions for Akira content.",
    "author": "Ikabud",
    "suite": "cms-akira",
    "kind": "extension",
    "extends": "cms-akira-core",
    "depends": [
        "cms-akira-core"
    ],
    "contributes": [
        {
            "extension_point": "cms.sidebar",
            "provider": "cms-akira-ai.sidebar@1"
        }
    ],
    "admin_contributions": [
        {
            "id": "cms-akira-ai.sidebar",
            "host": "cms",
            "location": "sidebar",
            "group": "assistants",
            "label": "AI Assistant",
            "icon": "sparkles",
            "route": "/admin/cms-akira-ai",
            "permission": "cms.ai.manage",
            "order": 80
        }
    ],
    "owns_tables": [],
    "reads_tables": [],
    "migrations": [
        "database/migrations/001_initial.sql"
    ],
    "capabilities": {
        "exposes": [
            {
                "id": "akira.ai.summary.suggest@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Generate summary and keyword suggestions for Akira content"
            }
        ],
        "depends": [
            "akira.content.get@1"
        ]
    },
    "routes": true,
    "events": [],
    "nav": [
        {
            "label": "Cms Akira Ai",
            "url": "/admin/cms-akira-ai",
            "icon": "box",
            "roles": [
                "admin"
            ]
        }
    ]
}