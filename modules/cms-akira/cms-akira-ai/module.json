{
    "id": "cms-akira-ai",
    "name": "CMS Akira AI Assistant",
    "version": "1.0.0",
    "description": "CMS Akira AI assistant extension — generates summaries and keyword suggestions for Akira content.",
    "author": "Ikabud",
    "suite": "cms-akira",
    "kind": "extension",
    "extends": "cms-akira-core",
    "depends": [
        "cms-akira-core"
    ],
    "owns_tables": [],
    "reads_tables": [],
    "migrations": [
        "database/migrations/001_initial.sql"
    ],
    "capabilities": {
        "exposes": [
            {
                "id": "akira.ai.summary.suggest@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Generate summary and keyword suggestions for Akira content"
            }
        ],
        "depends": [
            "akira.content.get@1"
        ]
    },
    "routes": true,
    "events": []
}