{
    "id": "cms-akira-workflow",
    "name": "CMS Akira Workflow",
    "version": "1.0.0",
    "description": "CMS Akira workflow extension — evaluates content workflow status and allowed transitions.",
    "author": "Ikabud",
    "suite": "cms-akira",
    "kind": "extension",
    "extends": "cms-akira-core",
    "depends": [
        "cms-akira-core"
    ],
    "contributes": [
        {
            "extension_point": "cms.sidebar",
            "provider": "cms-akira-workflow.sidebar@1"
        }
    ],
    "admin_contributions": [
        {
            "id": "cms-akira-workflow.sidebar",
            "host": "cms",
            "location": "sidebar",
            "group": "optimization",
            "label": "Workflow",
            "icon": "workflow",
            "route": "/admin/cms-akira-workflow",
            "permission": "cms.workflow.manage",
            "order": 70
        }
    ],
    "owns_tables": [],
    "reads_tables": [],
    "migrations": [
        "database/migrations/001_initial.sql"
    ],
    "capabilities": {
        "exposes": [
            {
                "id": "akira.workflow.evaluate@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Evaluate content workflow status and allowed transitions"
            }
        ],
        "depends": [
            "akira.content.get@1"
        ]
    },
    "routes": true,
    "events": [],
    "nav": [
        {
            "label": "Cms Akira Workflow",
            "url": "/admin/cms-akira-workflow",
            "icon": "box",
            "roles": [
                "admin"
            ]
        }
    ]
}