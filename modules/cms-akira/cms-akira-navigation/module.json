{
    "id": "cms-akira-navigation",
    "name": "CMS Akira Navigation",
    "version": "1.0.0",
    "description": "CMS Akira navigation extension — resolves navigation context for Akira content pages.",
    "author": "Ikabud",
    "suite": "cms-akira",
    "kind": "extension",
    "extends": "cms-akira-core",
    "depends": [
        "cms-akira-core"
    ],
    "owns_tables": [],
    "reads_tables": [],
    "migrations": [
        "database/migrations/001_initial.sql"
    ],
    "capabilities": {
        "exposes": [
            {
                "id": "akira.navigation.resolve@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Resolve Akira navigation context for content pages"
            }
        ],
        "depends": [
            "akira.content.get@1"
        ]
    },
    "routes": true,
    "events": [],
    "nav": [
        {
            "label": "Cms Akira Navigation",
            "url": "/admin/cms-akira-navigation",
            "icon": "box",
            "roles": [
                "admin"
            ]
        }
    ]
}