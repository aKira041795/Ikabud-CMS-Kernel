{
    "id": "cms-akira-core",
    "name": "CMS Akira Core",
    "version": "1.0.0",
    "description": "CMS Akira product core — authoritative host module for the cms-akira suite. Declares the suite's extension points and product identity.",
    "author": "Ikabud",
    "suite": "cms-akira",
    "kind": "product-core",
    "depends": [
        "cms"
    ],
    "application_profile": {
        "id": "ark.workbench",
        "version": "^0.1"
    },
    "product": {
        "id": "cms-akira",
        "name": "CMS Akira"
    },
    "extension_points": [
        "cms.sidebar",
        "cms.settings.sections",
        "cms.content.processors",
        "cms.editor.tools",
        "cms.dashboard.widgets"
    ],
    "owns_tables": [],
    "reads_tables": [],
    "migrations": [
        "database/migrations/001_initial.sql"
    ],
    "capabilities": {
        "exposes": [
            {
                "id": "akira.content.get@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "CMS Akira content get adapter backed by legacy cms.content.get@1"
            },
            {
                "id": "akira.content.list@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "CMS Akira content list adapter backed by legacy cms.content.list@1"
            },
            {
                "id": "akira.content.create@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "CMS Akira content create adapter backed by legacy cms.content.create@1"
            },
            {
                "id": "akira.content.update@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "CMS Akira content update adapter backed by legacy cms.content.update@1"
            },
            {
                "id": "akira.content.enrich@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "CMS Akira optional SEO/AI enrichment for content previews with fallback behavior"
            },
            {
                "id": "akira.content.compose@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "CMS Akira Phase 5/6 composition context for theme, navigation, workflow, and search providers"
            },
            {
                "id": "akira.providers.status@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "CMS Akira provider boundary runtime status and fallback map"
            }
        ],
        "depends": [
            "cms.content.get@1",
            "cms.content.list@1",
            "cms.content.create@1",
            "cms.content.update@1"
        ]
    },
    "routes": true,
    "events": [],
    "nav": [
        {
            "label": "Cms Akira Core",
            "url": "/admin/cms-akira-core",
            "icon": "box",
            "roles": [
                "admin"
            ]
        }
    ]
}