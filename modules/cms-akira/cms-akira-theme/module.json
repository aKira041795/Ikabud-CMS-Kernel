{
    "id": "cms-akira-theme",
    "name": "CMS Akira Theme",
    "version": "1.0.0",
    "description": "CMS Akira theme extension — resolves theme context for Akira content rendering.",
    "author": "Ikabud",
    "suite": "cms-akira",
    "kind": "extension",
    "extends": "cms-akira-core",
    "depends": [
        "cms-akira-core"
    ],
    "admin_contributions": [
        {
            "id": "cms-akira-theme.sidebar",
            "host": "cms",
            "location": "cms.sidebar",
            "group": "Themes",
            "label": "Theme Studio",
            "icon": "paint-brush",
            "route": "/admin/theme-studio",
            "permission": "theme.customize@1",
            "roles": [
                "admin"
            ],
            "order": 60,
            "active_key": "theme-studio",
            "guidance": "Open the ARK Theme Studio — token editor, presets, theme elements, display contracts, and block definitions."
        }
    ],
    "owns_tables": [],
    "reads_tables": [],
    "migrations": [
        "database/migrations/001_initial.sql"
    ],
    "capabilities": {
        "exposes": [
            {
                "id": "akira.theme.resolve@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Resolve Akira theme context for content rendering"
            }
        ],
        "depends": [
            "akira.content.get@1"
        ]
    },
    "routes": true,
    "events": []
}