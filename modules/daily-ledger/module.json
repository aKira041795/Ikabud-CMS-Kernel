{
  "id": "daily-ledger",
  "name": "Daily Ledger",
  "version": "1.1.0",
  "description": "Daily sales report encoding system \u2014 digital mirror of paper ledger",
  "author": "Noah C. Omamalin",
  "auth_owned": {
    "users_table": "dl_users",
    "username_column": "username",
    "email_column": "email",
    "password_column": "password_hash",
    "name_column": "full_name",
    "active_column": "is_active",
    "deleted_column": "deleted_at",
    "admin_roles": [
      "admin"
    ],
    "default_admin_role": "admin",
    "requires_named_admin_on_provision": false,
    "touch_updated_at": true
  },
  "owns_tables": [
    "dl_users",
    "dl_user_branches",
    "dl_admins",
    "dl_branches",
    "dl_cashiers",
    "dl_supervisors",
    "dl_supervisor_branches",
    "dl_production_incharges",
    "dl_production_incharge_branches",
    "dl_daily_ledger",
    "dl_ledger_day_status",
    "dl_variance_flags",
    "dl_products",
    "dl_product_price_history",
    "dl_branch_products",
    "dl_production_movements",
    "dl_raw_materials",
    "dl_commissary_ledger",
    "dl_selling_account_ledger",
    "dl_selling_account_day_status",
    "dl_cashier_withdrawals",
    "dl_deliveries",
    "dl_delivery_items",
    "dl_branch_receivings",
    "dl_branch_receiving_items",
    "dl_price_groups",
    "dl_product_prices",
    "dl_production_runs",
    "dl_branch_product_supply_rules",
    "dl_selling_accounts",
    "dl_delivery_variance_flags",
    "dl_commissary_product_ledger",
    "dl_password_resets"
  ],
  "co_owns_tables": [
    "audit_logs"
  ],
  "reads_tables": [
    "rate_limits",
    "refresh_tokens",
    "users"
  ],
  "migrations": [
    "database/migrations/002_dl_user_branch_isolation.sql",
    "database/migrations/003_align_dl_prefixed_schema.sql",
    "database/migrations/004_add_production_movements.sql",
    "database/migrations/005_add_production_incharge_role.sql",
    "database/migrations/006_add_product_output_profile.sql",
    "database/migrations/007_fix_withdrawal_ledger_column.sql",
    "database/migrations/008_reconcile_legacy_kernel_tables.sql",
    "database/migrations/009_add_branch_area.sql",
    "database/migrations/010_reconcile_auto_increment_ids.sql",
    "database/migrations/011_add_commissary_production_tables.sql",
    "database/migrations/012_add_product_category.sql",
    "database/migrations/013_add_user_soft_delete.sql",
    "database/migrations/014_consolidate_dl_users.sql",
    "database/migrations/015_add_commissary_movement_bridge.sql",
    "database/migrations/016_add_batch_input_qty.sql",
    "database/migrations/017_add_batch_egg_qty.sql",
    "database/migrations/018_add_commissary_flow_mode.sql",
    "database/migrations/019_audit_logs_actor_columns.sql",
    "database/migrations/020_cashier_withdrawals.sql",
    "database/migrations/021_cashier_withdrawal_receive.sql",
    "database/migrations/022_branch_supply_mode.sql",
    "database/migrations/023_branch_product_supply_rules.sql",
    "database/migrations/024_deliveries_and_receivings.sql",
    "database/migrations/025_backfill_delivery_rows.sql",
    "database/migrations/026_withdrawal_reasons.sql",
    "database/migrations/027_price_groups.sql",
    "database/migrations/028_selling_accounts.sql",
    "database/migrations/029_selling_account_ledger.sql",
    "database/migrations/030_branch_price_groups.sql",
    "database/migrations/031_production_dr_numbers.sql",
    "database/migrations/032_cashier_withdrawal_received_qty.sql",
    "database/migrations/033_delivery_provenance_review.sql",
    "database/migrations/034_add_delivery_status_indexes.sql",
    "database/migrations/035_dl_password_reset_support.sql",
    "database/migrations/036_add_commissary_product_ledger.sql",
    "database/migrations/037_add_wastage_to_commissary_product_ledger.sql"
  ],
  "capabilities": {
    "exposes": [
      {
        "id": "kernel.auth.authenticate@1",
        "priority": 500,
        "modes": [
          "pipeline"
        ],
        "schema": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            }
          }
        }
      }
    ],
    "depends": [],
    "policy": {
      "capabilities": {
        "kernel.auth.authenticate@1": {
          "allow_callers": [
            "daily-ledger",
            "kernel"
          ]
        }
      }
    }
  },
  "settings_fields": [
    {
      "key": "app_name",
      "type": "text",
      "label": "App Name",
      "default": "Daily Ledger",
      "description": "Display name shown on the login page and throughout the app."
    },
    {
      "key": "logo_url",
      "type": "text",
      "label": "Logo URL",
      "default": "",
      "description": "Optional uploaded logo shown in the Daily Ledger sidebar and login screen."
    },
    {
      "key": "favicon_url",
      "type": "text",
      "label": "Favicon URL",
      "default": "",
      "description": "Optional uploaded favicon used across Daily Ledger pages."
    },
    {
      "key": "production_output_enabled",
      "type": "checkbox",
      "label": "Enable Production Output",
      "default": "0",
      "description": "Show the Production Output page and allow production output entries to be recorded."
    },
    {
      "key": "formal_delivery_workflow_enabled",
      "type": "checkbox",
      "label": "Enable Formal Delivery / Receiving Workflow",
      "default": "0",
      "description": "Switch deliveries and branch receipts onto the dl_deliveries / dl_branch_receivings tables with draft/posted/voided status. When off, the legacy cashier-withdrawal delivery flow continues to apply."
    },
    {
      "key": "selling_accounts_enabled",
      "type": "checkbox",
      "label": "Enable Selling Accounts (Mall, Kiosk, Event Booth, etc.)",
      "default": "0",
      "description": "Expose selling-account ledgers, separate price groups, and consolidated branch summaries that include their assigned selling accounts."
    },
    {
      "key": "price_groups_enabled",
      "type": "checkbox",
      "label": "Enable Channel Price Groups",
      "default": "1",
      "description": "Allow product prices to vary by channel (Regular Branch, Mall, Reseller, Event, etc.). Snapshots are recorded on every delivery and ledger entry."
    }
  ],
  "auth_cookie": "daily_ledger_token",
