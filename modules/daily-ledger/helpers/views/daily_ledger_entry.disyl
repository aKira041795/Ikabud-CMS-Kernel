{ikb_entity_view name="daily_ledger_entry" view="table"}
    {field name="id" type="number"}
    {field name="entry_type" type="string" role="title"}
    {field name="amount" type="number" renderer="money:2" role="subtitle"}
    {field name="notes" type="string"}
    {field name="created_at" type="date" renderer="datetime:date"}
    {action name="view" url="{base_url}/admin/daily-ledger/entries/{id}" label="View"}
{/ikb_entity_view}

{ikb_entity_view name="daily_ledger_entry" view="compact"}
    {field name="entry_type" type="string" role="title"}
    {field name="amount" type="number" renderer="money:2"}
    {field name="created_at" type="date" renderer="datetime:date"}
{/ikb_entity_view}

{ikb_entity_view name="daily_ledger_entry" view="card_grid"}
    {field name="entry_type" type="string" role="title"}
    {field name="amount" type="number" renderer="money:2" role="subtitle"}
    {field name="notes" type="string"}
    {field name="created_at" type="date" renderer="datetime:date"}
    {action name="view" url="{base_url}/admin/daily-ledger/entries/{id}" label="View"}
{/ikb_entity_view}
