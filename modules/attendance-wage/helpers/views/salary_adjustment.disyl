{ikb_entity_view name="salary_adjustment" view="table"}
    {field name="employee_name" type="string" role="title"}
    {field name="adjustment_type" type="string"}
    {field name="amount" type="number" renderer="money:2" role="subtitle"}
    {field name="status" type="enum" renderer="badge:{draft|gray|approved|green|rejected|red}"}
    {field name="effective_date" type="date" renderer="datetime:date"}
    {field name="id" type="number" visible="false"}
    {action name="view" url="{base_url}/admin/wage/adjustments/{id}" label="View"}
    {action name="approve" url="{base_url}/admin/wage/adjustments/{id}/approve" label="Approve" method="post"}
{/ikb_entity_view}

{ikb_entity_view name="salary_adjustment" view="compact"}
    {field name="employee_name" type="string" role="title"}
    {field name="amount" type="number" renderer="money:2"}
    {field name="status" type="enum" renderer="badge:{draft|gray|approved|green|rejected|red}"}
{/ikb_entity_view}

{ikb_entity_view name="salary_adjustment" view="card_grid"}
    {field name="employee_name" type="string" role="title"}
    {field name="amount" type="number" renderer="money:2" role="subtitle"}
    {field name="adjustment_type" type="string"}
    {field name="status" type="enum" renderer="badge:{draft|gray|approved|green|rejected|red}"}
    {field name="id" type="number" visible="false"}
    {action name="view" url="{base_url}/admin/wage/adjustments/{id}" label="View"}
{/ikb_entity_view}
