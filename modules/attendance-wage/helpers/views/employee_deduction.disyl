{ikb_entity_view name="employee_deduction" view="table"}
    {field name="employee_name" type="string" role="title"}
    {field name="deduction_count" type="number" role="subtitle"}
    {field name="total_amount" type="number" renderer="money:2"}
    {field name="deduction_types" type="string"}
    {field name="id" type="string" visible="false"}
    {action name="view" url="{base_url}/admin/wage/deductions/{id}" label="View"}
{/ikb_entity_view}

{ikb_entity_view name="employee_deduction" view="compact"}
    {field name="employee_name" type="string" role="title"}
    {field name="total_amount" type="number" renderer="money:2"}
    {field name="deduction_count" type="number"}
{/ikb_entity_view}
