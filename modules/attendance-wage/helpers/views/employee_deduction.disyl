{ikb_entity_view name="employee_deduction" view="table"}
    {field name="employee_name" type="string" role="title"}
    {field name="amount" type="number" renderer="money:2" role="subtitle"}
    {field name="description" type="string"}
    {field name="status" type="enum" renderer="badge:{active|green|paid|blue|cancelled|red}"}
    {field name="deduction_date" type="date" renderer="datetime:date"}
    {field name="source" type="string"}
    {field name="id" type="number" visible="false"}
    {action name="view" url="{base_url}/admin/wage/deductions/{id}" label="View"}
{/ikb_entity_view}

{ikb_entity_view name="employee_deduction" view="compact"}
    {field name="employee_name" type="string" role="title"}
    {field name="amount" type="number" renderer="money:2"}
    {field name="status" type="enum" renderer="badge:{active|green|paid|blue|cancelled|red}"}
{/ikb_entity_view}
