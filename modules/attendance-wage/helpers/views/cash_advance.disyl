{ikb_entity_view name="cash_advance" view="table"}
    {field name="employee_name" type="string" role="title"}
    {field name="amount" type="number" renderer="money:2" role="subtitle"}
    {field name="balance" type="number" renderer="money:2"}
    {field name="status" type="enum" renderer="badge:{pending|amber|approved|green|paid|blue|rejected|red}"}
    {field name="request_date" type="date" renderer="datetime:date"}
    {field name="approved_at" type="date" renderer="datetime:date"}
    {field name="id" type="number" visible="false"}
    {action name="view" url="{base_url}/admin/wage/cash-advances/{id}" label="View"}
    {action name="approve" url="{base_url}/admin/wage/cash-advances/{id}/approve" label="Approve" method="post"}
{/ikb_entity_view}

{ikb_entity_view name="cash_advance" view="compact"}
    {field name="employee_name" type="string" role="title"}
    {field name="amount" type="number" renderer="money:2"}
    {field name="status" type="enum" renderer="badge:{pending|amber|approved|green|paid|blue|rejected|red}"}
{/ikb_entity_view}

{ikb_entity_view name="cash_advance" view="card_grid"}
    {field name="employee_name" type="string" role="title"}
    {field name="amount" type="number" renderer="money:2" role="subtitle"}
    {field name="balance" type="number" renderer="money:2"}
    {field name="status" type="enum" renderer="badge:{pending|amber|approved|green|paid|blue|rejected|red}"}
    {field name="id" type="number" visible="false"}
    {action name="view" url="{base_url}/admin/wage/cash-advances/{id}" label="View"}
{/ikb_entity_view}
