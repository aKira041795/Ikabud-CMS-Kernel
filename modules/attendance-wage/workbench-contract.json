            "id": "payroll-computations",
            "family": "wage",
            "roles": [
                "admin"
            ],
            "required_components": []
        }
    ],
    "workflows": [
        {
            "id": "attendance_clock",
            "states": [
                "not_clocked_in",
                "active",
                "completed"
            ],
            "transitions": []
        },
        {
            "id": "payroll_computation",
            "states": [
                "draft",
                "processing",
                "computed",
                "approved",
                "paid"
            ],
            "transitions": []
        },
        {
            "id": "pal_attendance_bridge",
            "states": [
                "unmapped",
                "mapped",
                "visible"
            ],
            "transitions": []
        }
    ],
    "actions": [],
    "invariants": [
        {
            "id": "routes-contract-parity",
            "severity": "critical",
            "scope": "routes",
            "description": "Workbench route ownership must match attendance-wage routes.php."
        },
        {
            "id": "pal-bridge-read-only",
            "severity": "critical",
            "scope": "integration",
            "description": "PAL can read declared attendance bridge tables and cannot own attendance-wage tables."
        },
        {
            "id": "payroll-immutability",
            "severity": "critical",
            "scope": "payroll",
            "description": "Approved or paid salary computations cannot be overwritten by routine recomputation."
        }
    ],
    "scenarios": [],
    "environments": {
        "browsers": [
