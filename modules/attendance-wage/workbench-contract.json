    "actors": [
        {
            "id": "admin",
            "capabilities": [
                "attendance_wage.admin@1"
            ]
        },
        {
            "id": "supervisor",
            "capabilities": [
                "attendance_wage.manage@1",
                "attendance_wage.approve@1"
            ]
        },
        {
            "id": "employee",
            "capabilities": [
                "attendance_wage.clock@1",
                "attendance_wage.read@1"
            ]
        }
    ],
    "tenancy": {
        "mode": "tenant",
        "isolation_invariants": [
            "attendance and wage records are scoped to the active tenant database",
            "PAL may read attendance bridge tables but must not mutate Attendance & Wage payroll state"
        ]
    },
    "pages": [
        {
            "id": "attendance-records",
            "family": "attendance",
            "roles": [
                "admin",
                "supervisor",
                "employee"
            ],
            "required_components": []
        },
        {
            "id": "wage-dashboard",
            "family": "wage",
            "roles": [
                "admin",
                "supervisor"
            ],
            "required_components": []
