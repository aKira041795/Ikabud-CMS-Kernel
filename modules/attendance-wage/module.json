    "settings_fields": [
        {
            "key": "default_rest_day",
            "type": "select",
            "label": "Default Rest Day",
            "default": "sunday",
            "description": "Default weekly rest day for employees without an individual schedule.",
            "options": [
                {
                    "label": "Sunday",
                    "value": "sunday"
                },
                {
                    "label": "Monday",
                    "value": "monday"
                },
                {
                    "label": "Tuesday",
                    "value": "tuesday"
                },
                {
                    "label": "Wednesday",
                    "value": "wednesday"
                },
                {
                    "label": "Thursday",
                    "value": "thursday"
                },
                {
                    "label": "Friday",
                    "value": "friday"
                },
                {
                    "label": "Saturday",
                    "value": "saturday"
                }
            ]
        },
        {
            "key": "working_days_per_month",
            "type": "number",
            "label": "Working Days Per Month",
            "default": "22",
            "description": "Used for monthly salary pro-rating."
        },
        {
            "key": "working_hours_per_day",
            "type": "number",
            "label": "Working Hours Per Day",
            "default": "8",
            "description": "Standard working hours per day for daily rate calculations."
        },
        {
            "key": "overtime_calculation",
            "type": "select",
            "label": "Overtime Calculation Mode",
            "default": "both",
            "description": "How overtime limits are enforced.",
            "options": [
                {
                    "label": "Daily Only",
                    "value": "daily"
                },
                {
                    "label": "Weekly Only",
                    "value": "weekly"
                },
                {
                    "label": "Both Daily + Weekly",
                    "value": "both"
                }
            ]
        },
        {
            "key": "round_hours_to",
            "type": "select",
            "label": "Round Hours To",
            "default": "0.25",
            "description": "Round worked hours to the nearest increment.",
            "options": [
                {
                    "label": "No Rounding",
                    "value": "none"
                },
                {
                    "label": "15 Minutes (0.25)",
                    "value": "0.25"
                },
                {
                    "label": "30 Minutes (0.5)",
                    "value": "0.5"
                },
                {
                    "label": "1 Hour",
                    "value": "1.0"
                }
            ]
        },
        {
            "key": "pay_frequency",
            "type": "select",
            "label": "Default Pay Frequency",
            "default": "semi_monthly",
            "description": "Default payroll period type for new periods.",
            "options": [
                {
                    "label": "Semi-Monthly",
                    "value": "semi_monthly"
                },
                {
                    "label": "Monthly",
                    "value": "monthly"
                },
                {
                    "label": "Weekly",
                    "value": "weekly"
                },
                {
                    "label": "Bi-Weekly",
                    "value": "bi_weekly"
                }
            ]
        },
        {
            "key": "max_cash_advance_pct",
            "type": "number",
            "label": "Max Cash Advance (% of monthly salary)",
            "default": "50",
            "description": "Maximum cash advance amount as percentage of employee monthly basic salary."
        },
        {
            "key": "max_active_advances",
            "type": "number",
            "label": "Max Active Cash Advances",
            "default": "2",
            "description": "Maximum number of active (unpaid) cash advances per employee."
        },
        {
            "key": "google_maps_api_key",
            "type": "text",
            "label": "Google Maps API Key",
            "default": "",
            "description": "API key for Google Maps (Maps JavaScript API + Geocoding API). Required for the office locations map picker."
        }
    ]
}