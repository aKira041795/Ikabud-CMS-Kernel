{
    "id": "guidance",
    "name": "Guidance Monitoring",
    "version": "1.0.0",
    "description": "School guidance counseling case management and scheduling.",
    "commercial_mode": "freemium",
    "tier_features": {
        "free": [
            "cases",
            "appointments",
            "booking",
            "dashboard",
            "users",
            "colleges",
            "settings",
            "profile"
        ],
        "pro": [
            "notes",
            "tracker",
            "docx_reports",
            "ai_reports",
            "notifications",
            "2fa",
            "attachments",
            "audit",
            "form_fields",
            "analytics",
            "calendar",
            "password_reset",
            "health",
            "availability",
            "appointment_types",
            "rate_limiting"
        ]
    },
    "author": "Noah C. Omamalin",
    "auth_owned": {
        "users_table": "gm_users",
        "username_column": "email",
        "email_column": "email",
        "password_column": "password",
        "name_column": "first_name",
        "active_column": "is_active",
        "deleted_column": "deleted_at",
        "admin_roles": [
            "admin"
        ],
        "default_admin_role": "admin",
        "requires_named_admin_on_provision": false,
        "touch_updated_at": true
    },
    "owns_tables": [
        "gm_users",
        "gm_password_resets",
        "gm_otp_codes",
        "gm_rate_limits",
        "gm_colleges",
        "gm_counselor_assignments",
        "gm_cases",
        "gm_case_status_history",
        "gm_counselor_notes",
        "gm_attachments",
        "gm_appointment_types",
        "gm_appointments",
        "gm_blocked_dates",
        "gm_counselor_availability",
        "gm_notifications",
        "gm_notification_queue",
        "gm_settings",
        "gm_form_fields",
        "gm_audit_logs",
        "gm_sync_queue",
        "gm_trackers",
        "gm_tracker_items",
        "gm_tracker_students",
        "gm_tracker_submissions",
        "gm_tracker_custom_fields",
        "gm_migrations"
    ],
    "reads_tables": [
        "kernel_module_catalog",
        "kernel_tenant_module_access_requests",
        "kernel_tenant_module_entitlements",
        "users",
        "audit_logs",
        "rate_limits"
    ],
    "migrations": [
        "migrations/001_guidance_schema.sql",
        "migrations/002_guidance_seed.sql",
        "migrations/003_guidance_booking_snapshot.sql",
        "migrations/004_guidance_attachments_meta.sql",
        "migrations/005_guidance_note_appointment_link.sql",
        "migrations/006_guidance_case_refactor.sql",
        "migrations/007_guidance_case_mse.sql",
        "migrations/008_guidance_form_fields_required_fix.sql",
        "migrations/009_guidance_unique_active_student_email.sql"
    ],
    "seeds": [
        "seeds/001_guidance_baseline.sql"
    ],
    "routes": true,
    "events": [
        {
            "key": "guidance.booking.created",
            "description": "Fired when a student submits a public booking request.",
            "available_vars": [
                "appointment_id",
                "student_name",
                "student_email",
                "student_phone",
                "to",
                "trigger_ref_id"
            ]
        },
        {
            "key": "guidance.appointment.created",
            "description": "Fired when an admin creates a new appointment for a case.",
            "available_vars": [
                "appointment_id",
                "date",
                "time",
                "student_name",
                "to",
                "trigger_ref_id"
            ]
        }
    ],
    "capabilities": {
        "exposes": [
            {
                "id": "kernel.auth.authenticate@1",
                "priority": 600,
                "modes": [
                    "pipeline"
                ],
                "schema": {
                    "type": "object",
                    "properties": {
                        "username": {
                            "type": "string"
                        },
                        "password": {
                            "type": "string"
                        }
                    }
                }
            },
            {
                "id": "module.license.activate@1",
                "priority": 20,
                "modes": [
                    "first"
                ],
                "description": "Validates an RS256-signed JWT license key issued by the Guidance module author and returns the unlocked tier and expiry.",
                "schema": {
                    "type": "object",
                    "required": [
                        "module_id",
                        "license_key"
                    ],
                    "properties": {
                        "module_id": {
                            "type": "string"
                        },
                        "tenant_id": {
                            "type": "integer"
                        },
                        "license_key": {
                            "type": "string"
                        }
                    }
                }
            },
            {
                "id": "entity.list.guidance_case@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "List guidance cases"
            },
            {
                "id": "entity.get.guidance_case@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Get single guidance case"
            },
            {
                "id": "entity.list.guidance_appointment@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "List guidance appointments"
            },
            {
                "id": "entity.get.guidance_appointment@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Get single guidance appointment"
            },
            {
                "id": "guidance.case.status.update@1",
                "priority": 50,
                "modes": [
                    "first"
                ],
                "description": "Inline update of case status field"
            }
        ],
        "depends": [
            "tinymce.assets.get@1",
            "tinymce.config.get@1",
            "tinymce.html.normalize@1",
            "tinymce.html.sanitize@1"
        ],
        "policy": {
            "default": {
                "deny_providers": []
            },
            "capabilities": {
                "kernel.auth.authenticate@1": {
                    "allow_callers": [
                        "sms",
                        "guidance",
                        "kernel"
                    ]
                }
            }
        }
    },
    "entity_contexts": {
        "definitions": [
            {
                "id": "guidance",
                "label": "Guidance",
                "capabilities": [
                    "lessons_index",
                    "progress_tracking",
                    "media_gallery"
                ],
                "priority": 80
            }
        ],
        "bindings": [
            {
                "entity_type": "course",
                "base": "guidance",
                "extensions": [
                    "commerce"
                ],
                "priority": 90
            }
        ]
    },
    "auth_cookie": "guidance_staff_token",
    "settings_fields": [
        {
            "key": "app_name",
            "type": "text",
            "label": "App Name",
            "default": "Guidance Monitoring System",
            "description": "The name displayed across the application (login page, admin header, etc.)."
        },
        {
            "key": "retention_active_years",
            "type": "number",
            "label": "Active Case Retention Years",
            "default": "7"
        },
        {
            "key": "retention_closed_years",
            "type": "number",
            "label": "Closed Case Retention Years",
            "default": "5"
        },
        {
            "key": "reminder_hours_before",
            "type": "number",
            "label": "Reminder Hours Before",
            "default": "24"
        },
        {
            "key": "email_notifications",
            "type": "select",
            "label": "Email Notifications",
            "default": "1"
        },
        {
            "key": "two_fa_login",
            "type": "select",
            "label": "2FA On Login",
            "default": "0"
        },
        {
            "key": "two_fa_booking",
            "type": "select",
            "label": "2FA On Booking",
            "default": "0"
        },
        {
            "key": "app_country",
            "type": "text",
            "label": "App Country",
            "default": "PH"
        },
        {
            "key": "app_region",
            "type": "text",
            "label": "App Region",
            "default": "Manila"
        },
        {
            "key": "app_timezone",
            "type": "text",
            "label": "App Timezone",
            "default": "Asia/Manila"
        },
        {
            "key": "license_store_url",
            "type": "text",
            "label": "License Store URL",
            "default": "",
            "description": "URL of the store that issues Guidance PRO licenses for this tenant. Shown on upgrade prompts."
        },
        {
            "key": "license_public_key_pem",
            "type": "textarea",
            "label": "License Verify Key (Public, PEM)",
            "control_class": "font-mono text-xs",
            "default": "",
            "description": "Optional Guidance license verification key override. Leave blank to use the bundled module key or the current tenant's ecommerce public key when this tenant is the issuing store."
        }
    ],
    "nav": [
        {
            "label": "Guidance",
            "url": "/admin/guidance",
            "icon": "heart-pulse",
            "roles": [
                "admin",
                "supervisor",
                "counselor"
            ]
        }
    ]
}