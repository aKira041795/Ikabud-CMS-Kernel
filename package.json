{
    "private": true,
    "scripts": {
        "build:tailwind": "php scripts/build-tailwind.php",
        "watch:tailwind": "tailwindcss -i ./public/assets/workbench/workbench-tailwind.src.css -o ./public/assets/workbench/workbench-tailwind.css --watch",
        "test": "npx playwright test",
        "test:pwa": "node tests/browser/modules/daily-ledger/pwa/run-pwa-tests.js",
        "test:ark": "./scripts/ark-test",
        "test:ark:coverage": "./scripts/ark-test --mode coverage",
        "test:ark:triage": "./scripts/ark-test --mode triage",
        "test:steward": "node tests/ai/ArkTestSteward.js --module project-audit-ledger --mode triage",
        "test:steward:coverage": "node tests/ai/ArkTestSteward.js --module project-audit-ledger --mode coverage",
        "workbench:hybrid": "node tests/browser/run-workbench.js --module",
        "workbench:pal": "node tests/browser/run-workbench.js --module=project-audit-ledger --gate=critical",
        "workbench:guidance": "node tests/browser/run-workbench.js --module=guidance --gate=critical"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.12.1",
        "@playwright/test": "^1.62.1",
        "tailwindcss": "^3.4.0"
    }
}