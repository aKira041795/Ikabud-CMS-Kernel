{
    "id": "service-commerce",
    "label": "Sellable Service",
    "description": "A service offer with pricing, booking, inquiry, and media support for commerce-style presentation.",
    "icon": "briefcase",
    "entity_types": [
        "service"
    ],
    "context_bases": [
        "business"
    ],
    "recommendation_priority": 80,
    "default_capabilities": [
        {
            "id": "pricing",
            "config": {
                "currency": "USD"
            }
        },
        {
            "id": "inquiry",
            "config": {
                "label": "Request This Service",
                "form_fields": "name,email,phone,message"
            }
        },
        {
            "id": "booking",
            "config": {
                "slot_duration_minutes": 60,
                "advance_days": 30
            }
        },
        {
            "id": "media_gallery",
            "config": {
                "columns": 2,
                "lightbox": true
            }
        }
    ],
    "token_overrides": {
        "color": {
            "primary": "#16a34a",
            "secondary": "#15803d"
        },
        "component": {
            "button": {
                "radius": "0.25rem"
            }
        }
    },
    "builder_defaults": {
        "layout": "service",
        "show_sidebar": false
    }
}