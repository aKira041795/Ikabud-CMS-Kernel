{
    "id": "education",
    "label": "Online Course",
    "description": "A structured course with lessons index, per-user progress tracking, and optional pricing.",
    "icon": "graduation-cap",
    "default_capabilities": [
        {
            "id": "pricing",
            "config": { "currency": "USD" }
        },
        {
            "id": "lessons_index",
            "config": { "child_type": "lesson", "show_numbers": true }
        },
        {
            "id": "progress_tracking",
            "config": { "unit": "percent" }
        }
    ],
    "token_overrides": {
        "color": {
            "primary":   "#7c3aed",
            "secondary": "#5b21b6"
        },
        "component": {
            "button": { "radius": "0.375rem" }
        }
    },
    "builder_defaults": {
        "layout": "course",
        "show_sidebar": true
    }
}
