{
    "id": "education",
    "label": "Online Course",
    "description": "A structured course with lessons index, per-user progress tracking, and optional pricing.",
    "icon": "graduation-cap",
    "default_capabilities": [
        {
            "id": "pricing",
            "config": { "currency": "USD" }
        },
        {
            "id": "lessonsindex",
            "config": { "child_type": "lesson", "show_numbers": true }
        },
        {
            "id": "progresstracking",
            "config": { "unit": "percent" }
        }
    ],
    "token_overrides": {
        "color-accent":      "#7c3aed",
        "color-accent-dark": "#5b21b6",
        "btn-radius":        "0.375rem"
    },
    "builder_defaults": {
        "layout": "course",
        "show_sidebar": true
    }
}
