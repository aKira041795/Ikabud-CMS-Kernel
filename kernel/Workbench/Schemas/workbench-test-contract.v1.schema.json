{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ark.workbench-test-contract.v1",
  "title": "ARK Workbench Test Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "module", "ownership", "actors", "tenancy", "pages", "workflows", "actions", "invariants", "scenarios", "environments", "evidence", "gates", "test_files", "compatibility"],
  "properties": {
    "schema": {"const": "ark.workbench-test-contract.v1"},
    "contract_version": {"type": "string", "pattern": "^1\\."},
    "module": {
      "type": "object",
      "required": ["id", "version", "application_profile"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "version": {"type": "string"},
        "application_profile": {"type": "string"}
      }
    },
    "ownership": {
      "type": "object",
      "required": ["routes", "navigation_dependencies", "tables", "capabilities", "events"],
      "properties": {
        "routes": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string", "pattern": "^/"}, "uniqueItems": true}},
        "navigation_dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "tables": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "events": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "actors": {"type": "array", "items": {"$ref": "#/$defs/identified"}},
    "tenancy": {"type": "object", "required": ["mode", "isolation_invariants"]},
    "pages": {"type": "array", "items": {"$ref": "#/$defs/identified"}},
    "workflows": {"type": "array", "items": {"$ref": "#/$defs/identified"}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/identified"}},
    "invariants": {"type": "array", "items": {"$ref": "#/$defs/identified"}},
    "scenarios": {"type": "array", "items": {"$ref": "#/$defs/identified"}},
    "environments": {"type": "object", "required": ["browsers", "viewports"], "properties": {"browsers": {"type": "array", "items": {"type": "string"}}, "viewports": {"type": "array", "items": {"type": "string"}}, "timeout_seconds": {"type": "object", "properties": {"php": {"type": "integer", "minimum": 1, "maximum": 3600}, "browser": {"type": "integer", "minimum": 1, "maximum": 3600}}}}},
    "evidence": {"type": "object", "required": ["required_identity_fields", "outcomes"]},
    "gates": {"type": "object", "required": ["required", "release_blocker_severities"]},
    "test_files": {"type": "object", "required": ["php", "browser"]},
    "compatibility": {"type": "object", "required": ["migrated_from", "minimum_workbench"]}
  },
  "$defs": {
    "identified": {
      "type": "object",
      "required": ["id"],
      "properties": {"id": {"type": "string", "minLength": 1}}
    }
  }
}
