{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ikabud:workbench:ai-claim:v1",
  "type": "object",
  "required": ["claim_id", "claim_type", "text", "evidence_ids", "confidence"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "claim_type": {"enum": ["observed", "inferred", "retrieved", "unknown"]},
    "text": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "route_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
