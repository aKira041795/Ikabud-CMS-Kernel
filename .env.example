APP_ENV=development
APP_DEBUG=1
APP_URL=http://applicationos.test
APP_TIMEZONE=Asia/Manila
APP_COOKIE_SAMESITE=Lax

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=baronbakeshop
DB_USERNAME=root
DB_PASSWORD=
DB_COLLATION=utf8mb4_unicode_ci

# Optional control-plane database overrides
CONTROL_DB_HOST=
CONTROL_DB_PORT=
CONTROL_DB_DATABASE=
CONTROL_DB_USERNAME=
CONTROL_DB_PASSWORD=
CONTROL_DB_COLLATION=utf8mb4_unicode_ci
CONTROL_DB_ENC_KEY=

JWT_SECRET=change-me
JWT_EXPIRATION=86400

# Optional cache tuning
# Kernel admin API view cache (seconds). Set 0 to disable.
ADMIN_VIEW_CACHE_TTL=20
# CMS merged settings cache (seconds). Set 0 to disable.
CMS_SETTINGS_CACHE_TTL=30
# Control-host tenant lookup cache (seconds).
TENANT_HOST_CACHE_TTL=30

# Capability runtime tuning
CAP_TIMEOUT_MS=2000
CAP_RETRIES=0
CAP_RETRY_DELAY_MS=100
CAP_BREAKER_THRESHOLD=5
CAP_BREAKER_WINDOW_SEC=30
CAP_BREAKER_COOLDOWN_SEC=60
CAP_METRICS_MAX_SAMPLES=200
CAP_SCHEMA_MODE=warn

# Module loading / routing
APP_EAGER_MODULE_HELPERS=1
APP_ROUTE_AMBIGUITY_MODE=warn

# Optional request/timing diagnostics
# Force HTTPS redirects outside development when needed.
APP_FORCE_HTTPS=
# Global timing logs. Set true to log timing-enabled paths across the app.
APP_TIMING_LOGS=
# Global timing threshold in milliseconds.
APP_TIMING_THRESHOLD_MS=0
# CMS public route timing logs for homepage/public renders.
CMS_PUBLIC_RENDER_TIMING=
CMS_PUBLIC_RENDER_TIMING_THRESHOLD_MS=0
# CMS public context fragment timing logs.
CMS_PUBLIC_CONTEXT_TIMING=
CMS_PUBLIC_CONTEXT_TIMING_THRESHOLD_MS=0
# Set true to emit per-fragment CMS public context timings; otherwise only total is logged.
CMS_PUBLIC_CONTEXT_TIMING_VERBOSE=
# CMS theme lock/render timing logs.
CMS_THEME_TIMING_LOGS=
CMS_THEME_TIMING_THRESHOLD_MS=0

# Kernel update discovery
APP_UPDATES_ENABLED=1
APP_UPDATES_GITHUB_REPO=aKira041795/Ikabud-CMS-Kernel
APP_UPDATES_GITHUB_BRANCH=master
APP_UPDATES_GITHUB_API_BASE=https://api.github.com
APP_UPDATES_CHANNEL=stable
APP_UPDATES_TIMEOUT_SECONDS=10
APP_UPDATES_RELEASE_LIMIT=5
APP_UPDATES_USER_AGENT=Ikabud-Kernel-Updater/1.0
APP_UPDATES_AUTO_CHECK_INTERVAL_MINUTES=60

# Multi-tenant settings
APP_MULTI_TENANT_ENABLED=0
APP_TENANT_STRATEGY=control_host
APP_TENANT_HEADER=X-Tenant
APP_TENANT_DEFAULT=
APP_TENANT_COLUMN=tenant_id

# Optional API CORS allowlist (comma-separated origins)
CORS_ORIGINS=

# ── Email Configuration (SMTP) ────────────────────────────────────────────────
EMAIL_PROTOCOL=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASS=your-gmail-app-password
EMAIL_SMTP_CRYPTO=tls
EMAIL_FROM_EMAIL=noreply@ikabudkernel.com
EMAIL_FROM_NAME="Ikabud Kernel"
EMAIL_MAIL_TYPE=html
EMAIL_CHARSET=utf-8
