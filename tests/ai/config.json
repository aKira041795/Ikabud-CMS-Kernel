{
    "_description": "ARK Test Steward — AI provider configuration. API key via ARK_AI_API_KEY env var. NEVER commit the key.",
    "ai": {
        "enabled": false,
        "provider": "deepseek",
        "model": "deepseek-v4-pro",
        "endpoint": "https://api.deepseek.com/chat/completions",
        "max_tokens": 1000,
        "temperature": 0.1,
        "timeout_ms": 30000,
        "reasoning_effort": "medium"
    },
    "redaction": {
        "max_evidence_bytes": 4096,
        "max_stack_chars": 200,
        "strip_patterns": [
            "password",
            "token",
            "secret",
            "cookie",
            "authorization",
            "bearer"
        ]
    }
}