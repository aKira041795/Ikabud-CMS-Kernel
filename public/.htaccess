<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization header through (required for JWT Bearer tokens)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Route the moto-inventory module root to the front controller. The PWA
    # asset directory public/moto-inventory/ would otherwise shadow the
    # /moto-inventory dashboard route via mod_dir (301 -> directory -> 403).
    RewriteRule ^moto-inventory/?$ index.php [QSA,L]

    # Front controller: route all non-file/non-dir requests to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Disable directory listings
Options -Indexes

# Web app manifest MIME (not guaranteed by every host's default mime.types)
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# Block lock.php after installation (uncomment after install)
# <Files "lock.php">
#     <IfModule mod_authz_core.c>
#         Require all denied
#     </IfModule>
# </Files>

# Block access to hidden files in public dir
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent PHP execution in uploads if any exist
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.php$ - [F,L]
</IfModule>

# Static asset caching.
#
# MEASURED 2026-11-20 on the live host: /daily-ledger/admin/variances references 628 KB of JS/CSS
# (tailwindcss.js 407 KB, FontAwesome all.min.css 102 KB, alpine 47 KB, htmx 48 KB, dl-scroll 12 KB)
# against 43 KB of gzipped HTML. The assets are the page's real weight, and they shipped with NO
# Cache-Control at all - only Last-Modified - so a cashier moving between screens all shift paid a
# revalidation round trip for each one, which is exactly what a slow connection cannot afford.
#
# The max-age for CODE is deliberately short: these URLs are not fingerprinted, so a long max-age
# would serve stale script after a deploy. One hour covers a shift's navigation and keeps deploy
# staleness bounded to an hour. Media gets a week: uploads are stored with a timestamped, unique
# filename (logo_20260507_212944_d1b0867a.png), so a replaced file arrives as a new URL.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|mjs)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
