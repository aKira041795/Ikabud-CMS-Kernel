{
    "name": "ikabud/kernel",
    "description": "Multi-tenant application platform and modular business OS powered by DiSyL, the kernel-native rendering runtime for visual CMS, workflow automation, commerce, and tenant-scoped operations modules. Tenant provisioning is entry-module driven; auth-owned modules must be declared in module.json and may need to be selected per tenant.",
    "type": "project",
    "config": {
        "process-timeout": 1800
    },
    "scripts": {
        "test": "php scripts/run-tests.php",
        "test:single": "php",
        "benchmark:disyl": "php scripts/benchmark-disyl.php",
        "guard:manifests": "php scripts/guard-module-manifests.php",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "coverage": "bash scripts/collect-coverage.sh",
        "build:tailwind": "php scripts/build-tailwind.php"
    },
    "require": {
        "php": "^8.2",
        "phpoffice/phpword": "^1.2",
        "phpmailer/phpmailer": "^7.0",
        "dompdf/dompdf": "^3.1",
        "symfony/yaml": "^6.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "license": [
        "MIT",
        "proprietary"
    ]
}
