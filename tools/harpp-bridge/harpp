def cmd_wake_relay(args):
    config = harpp_wake.harpp_client.load_config()
    wol = config.get("wake_on_lan") or {}
    runners = wol.get("runners") or {}

    if args.check:
        print(f"base_url={config.get('base_url', '')}")
        print(f"tenant_id={config.get('tenant_id', '')}")
        if not runners:
            print("HARPP wake relay: no wake_on_lan.runners configured.")
            print(f"Add to {harpp_client.config_path()}:")
            print('  "wake_on_lan": { "runners": { "<desktop-runner-key>": { "mac": "AA:BB:CC:DD:EE:FF", "broadcast": "192.168.1.255", "port": 9 } } }')
            print("Then: harpp wake-relay --check")
            return
        for runner_key, runner_spec in runners.items():
            spec = runner_spec if isinstance(runner_spec, dict) else {}
            mac = spec.get("mac") or wol.get("mac") or ""
            broadcast = spec.get("broadcast") or wol.get("broadcast") or "255.255.255.255"
            port = spec.get("port") or wol.get("port") or 9
            print(f"runner {runner_key}: mac={mac} broadcast={broadcast} port={port}")
        print("Note: WoL requires the target machine's NIC/BIOS to have Wake-on-LAN (Magic Packet) enabled.")
        return

    runner_keys = list(runners.keys())
    print(f"HARPP wake relay: serving {len(runner_keys)} runner(s) ({', '.join(runner_keys)}). Ctrl-C to stop.", flush=True)
    print("Each pass emits at most one magic packet per runner; raise --interval to throttle WoL further.", flush=True)
    if args.once:
        harpp_wake.wake_relay_pass(own_runner_key=None, config=config)
        return
    try:
        while True:
            try:
                harpp_wake.wake_relay_pass(own_runner_key=None, config=config)
            except Exception as exc:  # noqa: BLE001
                print(f"HARPP wake relay: pass failed: {exc}", flush=True)
            # Sleep outside the pass try so a failure can never skip the interval
            # (avoids a hot-spin if wake_relay_pass ever raised).
            time.sleep(max(1, args.interval))
    except KeyboardInterrupt:
        print("wake relay stopped", flush=True)


def main():
    p = argparse.ArgumentParser(prog="harpp", description="HARPP harness bridge client")
    sub = p.add_subparsers(dest="cmd", required=True)

    cfg = sub.add_parser("config")
    cfg.add_argument("action", choices=["set", "get"])
    cfg.add_argument("key", nargs="?")
    cfg.add_argument("value", nargs="?")

    sub.add_parser("check")
    sub.add_parser("self-test")

    d = sub.add_parser("decision")
    dsub = d.add_subparsers(dest="dcmd", required=True)
    dr = dsub.add_parser("record")
    dr.add_argument("--task", required=True)
    dr.add_argument("--decision", required=True)
    dr.add_argument("--constraint", action="append", default=[])
    dr.add_argument("--additional", action="append", default=[])
