#!/usr/bin/env python3
"""HARPP bridge CLI — talk to the HARPP module from the shell / Pi.

Commands:
  harpp config set <key> <value>      base_url | bridge_key | tenant_id
  harpp config get [key]
  harpp check                         validate config (no network)
  harpp self-test                     run the local unit tests (no network)
  harpp decision record --task T --decision D [--constraint C --additional A --source S --applied-to X]
  harpp decision list [--limit N] [--remote --state S --priority P --workbench-state W]
  harpp decision submit --title T --body B [--context C --requested R --priority P --source S --workbench-state W --decision-key K]
  harpp decision ack <id> [--rationale R]
  harpp decision cancel <id> [--rationale R]
  harpp decision apply <id> [--rationale R]
  harpp msg send --body B [--conversation-id N --title T --harness-session-id S --idempotency-key K]
  harpp msg poll [--conversation-id N --after A --limit N]
  harpp status --message M [--status S --workbench-state W --harness-session-id S]
  harpp job track --pid N --model M --task T --conversation C [verification options]
  harpp job list
  harpp job untrack <id>
  harpp workflow resume <id>

Set HARPP_DRY_RUN=1 to preview requests without sending.
"""
import argparse
import fcntl
import json
import os
import socket
import sys
import threading
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import harpp_client  # noqa: E402
import harpp_wake  # noqa: E402

DEFAULT_INBOX = ".ai/harpp-inbox.jsonl"  # legacy workspace-relative path
RUN_LEASE_RENEW_INTERVAL = 120
_DESKTOP_RUN_LOCK = threading.Lock()


def _default_inbox():
    """Machine-global inbox so monitoring survives workspace switches."""
    return str(harpp_wake.INBOX_FILE)


def _default_log():
    return str(harpp_wake.AUTOPROCESS_LOG)


def _desktop_runner_key():
    hostname = socket.gethostname().strip().lower() or "localhost"
    return f"desktop-{hostname}"


def _run_desktop_pass(*, workspace, wake_command, model, timeout, open_terminal):
    """Claim and synchronously supervise at most one desktop run; never raise."""
    runner_key = _desktop_runner_key()
    run = None
    claim_token = ""
    run_id = 0
    try:
        harpp_client.register_runner(runner_key=runner_key, display_name="HARPP desktop",
                                     capabilities=["desktop"])
        harpp_client.reconcile_runs([], runner_key)
        response = harpp_client.claim_run(runner_key=runner_key, lease_seconds=300)
        data = (response.get("data") or {}) if isinstance(response, dict) else {}
        run = data.get("run")
        if not isinstance(run, dict):
            return
        run_id = int(run.get("id") or 0)
        claim_token = str(data.get("claim_token") or "")
        conversation_id = int(run.get("conversation_id") or 0)
        if not run_id or not claim_token or not conversation_id:
            raise ValueError("claimed run is missing id, claim_token, or conversation_id")

        if harpp_wake._wake_receipt_exists(int(run.get("source_message_id") or 0)):
            try:
                # Self-cancel with our claim token so the run retires cleanly instead
                # of being reconciled to STALLED by the finally block below.
                harpp_client.cancel_run(run_id=run_id, claim_token=claim_token)
            except Exception as exc:
                print(f"harpp watch: run {run_id} already answered; cancel failed: {exc}", flush=True)
            return

        context_response = harpp_client.conversation_context(conversation_id, limit=20)
        context = (context_response.get("data") or {}) if isinstance(context_response, dict) else {}
        task = str(run.get("task") or run.get("message_body") or run.get("body") or "Process the queued HARPP run.")
        prompt = ("You are the local HARPP desktop runner. Complete the claimed task, report any "
                  "required owner-facing response through HARPP, then exit.\n\n"
                  f"Task:\n{task[:4000]}\n\nBounded conversation context:\n"
                  f"{json.dumps(context, ensure_ascii=False)[:12000]}")
        harpp_client.mark_run_running(run_id, claim_token)

        stop_renewal = threading.Event()

        def renew_lease():
            while not stop_renewal.wait(RUN_LEASE_RENEW_INTERVAL):
                try:
                    harpp_client.renew_run(run_id, claim_token, lease_seconds=300)
                except Exception as exc:
                    print(f"harpp watch: run {run_id} lease renewal failed: {exc}", flush=True)
                try:
                    harpp_client.register_runner(runner_key=runner_key, display_name="HARPP desktop",
                                                 capabilities=["desktop"])
                except Exception as exc:
                    print(f"harpp watch: runner {runner_key} heartbeat failed: {exc}", flush=True)

        renewer = threading.Thread(target=renew_lease, daemon=True)
        renewer.start()
        # Run inside the conversation's HARPP workspace folder (base/workspace_key)
        # so the claimed task executes in the right project dir, not the global one.
        run_workspace = harpp_wake.conversation_workspace_dir(conversation_id) or workspace
        try:
            ok, reason = harpp_wake.spawn_agent(
                prompt, command=wake_command, model=model or harpp_wake.DEFAULT_MODEL,
                timeout=timeout, cwd=run_workspace, verify_delivery_receipts=False,
                open_terminal=open_terminal, return_reason=True, require_marker=False)
        finally:
            stop_renewal.set()
            renewer.join(timeout=1)
        result = {"runner_key": runner_key, "reason": reason or ("completed" if ok else "agent failed")}

        def _transition(target: str, payload: dict) -> bool:
            try:
                call = harpp_client.complete_run if target == "SUCCEEDED" else harpp_client.fail_run
                response = call(run_id, claim_token, result=payload)
                return bool((response or {}).get("ok"))
            except Exception as exc:  # noqa: BLE001
                print(f"harpp watch: run {run_id} {target} transition error: {exc}", flush=True)
                return False

        # A failed terminal transition would leave the run RUNNING and silently
        # reconciled to STALLED. Always land on a terminal state; retry FAILED once
        # so a transient 409 can't strand the run.
        if ok and _transition("SUCCEEDED", result):
            pass
        elif not _transition("FAILED", result):
            retried = _transition("FAILED", {**result, "error": "first terminal transition failed"})
            if not retried:
                print(f"harpp watch: run {run_id} could not reach a terminal state (will be reconciled); "
                      f"ok={ok} reason={reason}", flush=True)
    except Exception as exc:
        print(f"harpp watch: desktop runner pass failed: {exc}", flush=True)
        if run_id and claim_token:
            try:
                harpp_client.fail_run(run_id, claim_token, result={"error": str(exc)})
            except Exception as report_exc:
                print(f"harpp watch: run {run_id} failure report failed: {report_exc}", flush=True)
    finally:
        try:
            harpp_client.reconcile_runs([], runner_key)
        except Exception as exc:
            print(f"harpp watch: desktop runner reconciliation failed: {exc}", flush=True)


def _start_desktop_pass(*, workspace, wake_command, model, timeout, open_terminal):
    """Start one desktop runner pass without blocking the watch poll loop."""
    if not _DESKTOP_RUN_LOCK.acquire(blocking=False):
        return False

    def run_pass():
        try:
            _run_desktop_pass(workspace=workspace, wake_command=wake_command, model=model,
                              timeout=timeout, open_terminal=open_terminal)
        except Exception as exc:
            print(f"harpp watch: desktop runner thread failed: {exc}", flush=True)
        finally:
            _DESKTOP_RUN_LOCK.release()

    try:
        threading.Thread(target=run_pass, daemon=True).start()
    except Exception as exc:
        _DESKTOP_RUN_LOCK.release()
        print(f"harpp watch: desktop runner start failed: {exc}", flush=True)
        return False
    return True


def _watch_state_path():
    base = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "harpp"
    return base / "watch-state.json"


def _watch_lock_path():
    return _watch_state_path().with_name("watch.lock")


def _load_watch_state():
    p = _watch_state_path()
    try:
        return json.loads(p.read_text()) if p.exists() else {}
    except Exception:
        return {}


def _save_watch_state(state):
    p = _watch_state_path()
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        tmp = p.with_name(f".{p.name}.{os.getpid()}.tmp")
        with tmp.open("w", encoding="utf-8") as stream:
            stream.write(json.dumps(state))
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(tmp, p)
        return True
    except Exception as e:
        print(f"harpp watch: state save failed: {e}", flush=True)
        return False


def _notify(title, body):
    try:
        import shutil
        import subprocess
        if shutil.which("notify-send"):
            subprocess.Popen(["notify-send", title, body])
    except Exception:
        pass


def _emit(record, inbox):
    line = json.dumps(record, ensure_ascii=False)
    print(line, flush=True)
    if inbox:
        try:
            p = Path(inbox)
            p.parent.mkdir(parents=True, exist_ok=True)
            with p.open("a", encoding="utf-8") as f:
                f.write(line + "\n")
                f.flush()
                os.fsync(f.fileno())
            return True
        except Exception as e:
            print(f"harpp watch: inbox append failed: {e}", flush=True)
            return False
    return True


AUTOPROCESS_MAX_RETRIES = 3


def _autoprocess(records, log, failures=None):
    """Auto-respond and return only records that still need retrying (bounded).

    A record that keeps failing (server 4xx/5xx, closed conversation, unparsable
    response) is dropped after AUTOPROCESS_MAX_RETRIES consecutive failures so the
    watch loop never re-acks the same owner message every poll — that unbounded
    retry loop duplicated "Received" replies and push notifications.
    """
    failures = {} if failures is None else failures
    outcomes = []
    for note in harpp_client.autoprocess(records, outcomes=outcomes):
        print("autoprocess: " + note, flush=True)
        if log:
            try:
                p = Path(log)
                p.parent.mkdir(parents=True, exist_ok=True)
                with harpp_wake._open_capped_log(p) as f:
                    f.write("autoprocess: " + note + "\n")
            except Exception as e:
                print(f"harpp watch: autoprocess log failed: {e}", flush=True)
    keep = []
    for rec, ok in outcomes:
        key = f"{rec.get('kind')}:{rec.get('id')}"
        if ok:
            failures.pop(key, None)
            continue
        count = failures.get(key, 0) + 1
        if count < AUTOPROCESS_MAX_RETRIES:
            failures[key] = count
            keep.append(rec)
        else:
            failures.pop(key, None)
            print(f"autoprocess: dropped {key} after {AUTOPROCESS_MAX_RETRIES} failed ack attempts", flush=True)
    return keep


def watch_loop(once, interval, inbox=None, autoprocess=True, log=None,
               wake=False, wake_command=None, cooldown=60, max_per_hour=20,
               timeout=900, model=None, max_retries=3, open_terminal=True):
    import time
    inbox = inbox or _default_inbox()
    log = log or _default_log()
    workspace = harpp_wake.default_workspace()
    lock_path = _watch_lock_path()
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    watch_lock = lock_path.open("a+", encoding="utf-8")
    try:
        fcntl.flock(watch_lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        watch_lock.close()
        print(f"harpp watch: another watcher owns {lock_path}", flush=True)
        return
    state = _load_watch_state()
    last_msg = int(state.get("last_msg_id", 0))
    last_decided = int(state.get("last_decided_id", 0))
    pending = state.get("pending_autoprocess", []) if autoprocess else []
    failures = state.get("autoprocess_failures", {}) if autoprocess else {}
    while True:
        emitted = []
        try:
            # Page through every owner message newer than the last processed id.
            # The bridge API keys polls by id>cursor and caps each page at `limit`;
            # one uncursored request silently drops messages once the store exceeds
            # the page size, leaving owner messages unresponded (fixed).
            msgs = []
            cursor = last_msg
            while True:
                page = harpp_client.poll_messages(limit=100, after=cursor).get("data", {}).get("messages", [])
                if not page:
                    break
                msgs.extend(page)
                nxt = max(int(m.get("id", 0)) for m in page)
                if nxt <= cursor:
                    break
                cursor = nxt
            for m in sorted(msgs, key=lambda row: int(row.get("id", 0))):
                mid = int(m.get("id", 0))
                if mid > last_msg:
                    # Never receipt/re-wake on the harness's own replies.
                    sender = str(m.get("sender_type") or "owner").lower()
                    if sender not in ("owner", "user"):
                        last_msg = mid
                        continue
                    rec = {"kind": "message", "id": mid, "conversation_id": m.get("conversation_id"), "conversation_title": m.get("conversation_title"), "conversation_version": m.get("conversation_version"), "run_id": m.get("run_id"), "run_state": m.get("run_state"), "sender_type": m.get("sender_type"), "body": m.get("body"), "created_at": m.get("created_at")}
                    if not _emit(rec, inbox):
                        # Do not advance past an unstaged owner message. It will be
                        # fetched and durably appended on the next poll.
                        break
                    last_msg = mid
                    _notify("HARPP message", str(m.get("body", ""))[:120])
                    emitted.append(rec)
        except Exception as e:
            print(f"harpp watch: message poll failed: {e}", flush=True)
        try:
            # Keyset-cursor paging (ADR-6): a single uncursored limit=100 fetch
            # silently drops decisions once the store exceeds a page. Page through
            # ALL of them (no arbitrary cap -> no silent tail loss). Termination is
            # deterministic: each page advances the keyset cursor to strictly older
            # rows, and we stop once everything newer than last_decided is seen.
            ds = []
            _cursor_at = None
            _cursor_id = None
            while True:
                page = harpp_client.list_decisions(limit=100, cursor_created_at=_cursor_at, cursor_id=_cursor_id).get("data", {})
                rows = page.get("decisions", []) or []
                if not rows:
                    break
                ds.extend(rows)
                if max(int(r.get("id", 0)) for r in rows) <= int(last_decided or 0):
                    break
                nxt = page.get("next_cursor") or {}
                if not nxt.get("created_at"):
                    break
                _cursor_at = nxt.get("created_at")
                _cursor_id = int(nxt.get("id", 0))
                if _cursor_id >= max(int(r.get("id", 0)) for r in rows):
                    # Non-advancing cursor (protocol/anomaly): bail loudly so the next
                    # poll re-scans instead of silently looping.
                    print("harpp watch: decision paging cursor did not advance; stopping this poll", flush=True)
                    break
            for d in sorted(ds, key=lambda row: int(row.get("id", 0))):
                did = int(d.get("id", 0))
                if d.get("decided_at") and d.get("lifecycle_state") == "DECIDED" and did > last_decided:
                    rec = {"kind": "decision", "id": did, "decision_key": d.get("decision_key"), "title": d.get("title"), "decision": d.get("decision"), "rationale": d.get("rationale"), "decided_by": d.get("decided_by"), "lifecycle_state": d.get("lifecycle_state")}
                    if not _emit(rec, inbox):
                        break
                    last_decided = did
                    _notify("HARPP decision", f"#{did} {str(d.get('title', ''))[:120]}")
                    emitted.append(rec)
        except Exception as e:
            print(f"harpp watch: decision poll failed: {e}", flush=True)
        if autoprocess:
            known = {(r.get("kind"), r.get("id")) for r in pending}
            pending.extend(r for r in emitted if (r.get("kind"), r.get("id")) not in known)
        # Persist pending receipts before network delivery so a crash cannot lose them.
        _save_watch_state({"last_msg_id": last_msg, "last_decided_id": last_decided,
                           "pending_autoprocess": pending, "autoprocess_failures": failures})
        # Instant confirmation + decisions are deterministic and retried every poll.
        if autoprocess and pending:
            pending = _autoprocess(pending, log, failures)
            _save_watch_state({"last_msg_id": last_msg, "last_decided_id": last_decided,
                               "pending_autoprocess": pending, "autoprocess_failures": failures})
        # Deterministic workflow commands from the messenger: the owner drives
        # multi-stage work directly from HARPP (workflow start/list/status/show,
        # "run the X loop") — no VS Code / LLM needed. Handled commands are marked
        # processed so the wake agent does not double-handle them.
        try:
            recorded = harpp_wake.auto_record_directives(emitted)
            if recorded:
                print(f"harpp watch: recorded {recorded} durable decision(s)", flush=True)
            harpp_wake.route_workflow_commands(emitted)
            # Owner debate requests ("Start debate …") launch the arch-debate tool
            # as a tracked background job, auto-reported on completion.
            harpp_wake.route_debate_commands(emitted)
            # Owner multi-task plans (T1..Tn) are claimed here so they run as a
            # governed workflow instead of being interrupted by the wake agent.
            harpp_wake.route_plan_commands(emitted, default_model=model or harpp_wake.DEFAULT_MODEL)
        except Exception as e:
            print(f"harpp watch: workflow command routing failed: {e}", flush=True)
        # Job monitor: track delegated model processes; when one finishes, verify + commit
        # + report the result to the owner conversation automatically (no reminder needed).
        try:
            harpp_wake.monitor_jobs()
            # Governed multi-stage workflows advance on each stage's real outcome.
            harpp_wake.advance_workflows()
            # Phone-queued deploys: publish inventory + run the deploy worker on demand,
            # so the FTP worker process exists only while a deploy is actually running.
            harpp_wake.sync_deploys()
            # Daemon liveness + workflow summary for the /harpp/status page.
            harpp_wake.report_daemon_status(runner_key=_desktop_runner_key())
            # Claim + satisfy pending wake requests (Nudge) for runners we can serve.
            harpp_wake.wake_relay_pass(own_runner_key=_desktop_runner_key())
            # Provision a local folder for every active HARPP workspace so a
            # workspace created in the UI gets its project folder (base/key) here.
            try:
                harpp_wake.provision_workspaces()
            except Exception as e:
                print(f"harpp watch: workspace provisioning failed: {e}", flush=True)
        except Exception as e:
            print(f"harpp watch: job monitor failed: {e}", flush=True)
        if wake:
            _start_desktop_pass(workspace=workspace, wake_command=wake_command, model=model,
                                timeout=timeout, open_terminal=open_terminal)
        # Substantive processing: the wake agent (when enabled) replies/works in the
        # background, ledger-deduped, bounded by cooldown + max-per-hour.
        if wake:
            wake_kw = dict(enabled=True, command=wake_command,
                           model=model or harpp_wake.DEFAULT_MODEL, cooldown=cooldown,
                           max_per_hour=max_per_hour, timeout=timeout,
                           max_retries=max_retries, workspace=workspace,
                           open_terminal=open_terminal)
            if once:
                harpp_wake.maybe_wake(inbox, **wake_kw)
            else:
                # Agent latency (up to timeout) must never block polling/instant receipts.
                threading.Thread(target=harpp_wake.maybe_wake, args=(inbox,),
                                 kwargs=wake_kw, daemon=True).start()
        if once:
            watch_lock.close()
            return
        time.sleep(max(5, interval))


def inbox_cmd(clear, path=None):
    p = Path(path or _default_inbox())
    if not p.exists():
        print(f"inbox empty ({p})")
        return
    for line in p.read_text(encoding="utf-8").splitlines():
        if line.strip():
            print(line)
    if clear:
        p.unlink()


def cmd_job_track(args):
    workspace = harpp_wake.default_workspace()
    try:
        jid = harpp_wake.track_job(
            pid=args.pid, model=args.model, task=args.task, conversation_id=args.conversation,
            log_path=args.log, verify=args.verify, marker=args.marker,
            repo=args.repo or workspace, commit=args.commit, timeout=args.timeout,
            authority_level=args.authority_level)
    except ValueError as exc:
        sys.exit(f"harpp job track: {exc}")
    print(json.dumps({"job_id": jid, "status": "tracked", "pid": args.pid,
                      "conversation_id": args.conversation}))


def cmd_job_launch(args):
    command = args.command
    if command and command[0] == "--":
        command = command[1:]  # argparse REMAINDER keeps the '--' separator
    command = command[0] if len(command) == 1 else command
    workspace = args.cwd or harpp_wake.default_workspace()
    try:
        jid, proc = harpp_wake.launch_job(
            model=args.model, task=args.task, conversation_id=args.conversation,
            command=command, log_path=args.log, verify=args.verify, marker=args.marker,
            repo=args.repo or workspace, commit=args.commit, quiet=args.quiet,
            timeout=args.timeout, cwd=workspace, open_terminal=not args.no_terminal,
            authority_level=args.authority_level)
    except ValueError as exc:
        sys.exit(f"harpp job launch: {exc}")
    print(json.dumps({"job_id": jid, "status": "tracked", "pid": proc.pid,
                      "conversation_id": args.conversation}))


def cmd_job_list(args):
    jobs = harpp_wake.list_jobs()
    print(json.dumps({"count": len(jobs), "jobs": jobs}, indent=2))


def cmd_job_untrack(args):
    ok = harpp_wake.untrack_job(args.id)
    print(json.dumps({"job_id": args.id, "untracked": ok}))
    if not ok:
        raise SystemExit(1)


def cmd_workflow_start(args):
    try:
        manifest = json.loads(Path(args.manifest).read_text(encoding="utf-8"))
    except Exception as exc:  # noqa: BLE001
        sys.exit(f"harpp workflow start: cannot read manifest {args.manifest}: {exc}")
    stages = manifest.get("stages") if isinstance(manifest, dict) else None
    if not isinstance(stages, list) or not stages:
        sys.exit("harpp workflow start: manifest must contain a non-empty 'stages' array")
    # Deterministic preflight before persisting/launching: invalid or unsafe
    # manifests fail with the exact field identified.
    try:
        harpp_wake.preflight_workflow_manifest(manifest, workspace=args.workspace)
    except ValueError as exc:
        sys.exit(f"harpp workflow start: {exc}")
    title = args.title or (manifest.get("title") if isinstance(manifest, dict) else "") or "Governed HARPP workflow"
    defaults = dict(harpp_client.DEFAULT_WORKFLOW_BUDGETS)
    for key in defaults:
        arg_value = getattr(args, key, None)
        if arg_value is not None:
            defaults[key] = arg_value
        elif isinstance(manifest, dict) and manifest.get(key) is not None:
            defaults[key] = manifest.get(key)
    if getattr(args, "dry_run", False):
        print(json.dumps({"dry_run": True, "manifest": args.manifest, "stages": len(stages),
                          "preflight": "PASS", **defaults}))
        return
    try:
        preferred_model = harpp_wake.requested_model(getattr(args, "model", None))
        if getattr(args, "model", None) and not preferred_model:
            raise ValueError("unknown --model preference; use a supported provider/model or alias")
        wid = harpp_wake.start_workflow(title=title, conversation_id=args.conversation,
                                        stages=stages, workspace=args.workspace,
                                        max_repairs=int(defaults["max_repairs"]),
                                        max_total_cycles=int(defaults["max_total_cycles"]),
                                        max_browser_repairs=int(defaults["max_browser_repairs"]),
                                        max_tool_retries=int(defaults["max_tool_retries"]),
                                        max_network_retries=int(defaults["max_network_retries"]),
                                        contract_revision=int(getattr(args, "contract_revision", 0) or 0),
                                        preferred_model=preferred_model,
                                        authority_level=getattr(args, "authority_level", None))
    except ValueError as exc:
        sys.exit(f"harpp workflow start: {exc}")
    print(json.dumps({"workflow_id": wid, "status": "running", "stages": len(stages), **defaults}))


def cmd_workflow_validate(args):
    try:
        manifest = json.loads(Path(args.manifest).read_text(encoding="utf-8"))
    except Exception as exc:  # noqa: BLE001
        sys.exit(f"harpp workflow validate: cannot read manifest {args.manifest}: {exc}")
    errors = harpp_wake.validate_workflow_manifest(manifest, name=Path(args.manifest).name,
                                                   workspace=args.workspace)
    if errors:
        print(json.dumps({"manifest": args.manifest, "valid": False,
                          "schema_version": harpp_wake.WORKFLOW_MANIFEST_SCHEMA_VERSION,
                          "errors": errors}, indent=2))
        raise SystemExit(1)
    print(json.dumps({"manifest": args.manifest, "valid": True,
