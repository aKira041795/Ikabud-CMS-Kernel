#!/usr/bin/env python3
"""HARPP bridge CLI — talk to the HARPP module from the shell / Pi.

Commands:
  harpp config set <key> <value>      base_url | bridge_key | tenant_id
  harpp config get [key]
  harpp check                         validate config (no network)
  harpp self-test                     run the local unit tests (no network)
  harpp decision submit --title T --body B [--context C --requested R --priority P --source S --workbench-state W --decision-key K]
  harpp decision list [--state S --priority P --workbench-state W --limit N]
  harpp decision ack <id> [--rationale R]
  harpp decision apply <id> [--rationale R]
  harpp msg send --body B [--conversation-id N --title T --harness-session-id S]
  harpp msg poll [--conversation-id N --after A --limit N]
  harpp status --message M [--status S --workbench-state W --harness-session-id S]
  harpp job track --pid N --model M --task T --conversation C [verification options]
  harpp job list
  harpp job untrack <id>

Set HARPP_DRY_RUN=1 to preview requests without sending.
"""
import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import harpp_client  # noqa: E402
import harpp_wake  # noqa: E402

DEFAULT_INBOX = ".ai/harpp-inbox.jsonl"


def _watch_state_path():
    base = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "harpp"
    return base / "watch-state.json"


def _load_watch_state():
    p = _watch_state_path()
    try:
        return json.loads(p.read_text()) if p.exists() else {}
    except Exception:
        return {}


def _save_watch_state(state):
    p = _watch_state_path()
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        tmp = p.with_name(f".{p.name}.{os.getpid()}.tmp")
        tmp.write_text(json.dumps(state))
        os.replace(tmp, p)
    except Exception as e:
        print(f"harpp watch: state save failed: {e}", flush=True)


def _notify(title, body):
    try:
        import shutil
        import subprocess
        if shutil.which("notify-send"):
            subprocess.Popen(["notify-send", title, body])
    except Exception:
        pass


def _emit(record, inbox):
    line = json.dumps(record, ensure_ascii=False)
    print(line, flush=True)
    if inbox:
        try:
            p = Path(inbox)
            p.parent.mkdir(parents=True, exist_ok=True)
            with p.open("a", encoding="utf-8") as f:
                f.write(line + "\n")
        except Exception as e:
            # Staging failure must not suppress the immediate bridge receipt.
            print(f"harpp watch: inbox append failed: {e}", flush=True)


def _autoprocess(records, log):
    """Auto-respond and return only records that still need retrying."""
    outcomes = []
    for note in harpp_client.autoprocess(records, outcomes=outcomes):
        print("autoprocess: " + note, flush=True)
        if log:
            try:
                p = Path(log)
                p.parent.mkdir(parents=True, exist_ok=True)
                with p.open("a", encoding="utf-8") as f:
                    f.write("autoprocess: " + note + "\n")
            except Exception as e:
                print(f"harpp watch: autoprocess log failed: {e}", flush=True)
    return [rec for rec, ok in outcomes if not ok]


def watch_loop(once, interval, inbox, autoprocess=True, log=".ai/harpp-wake.log",
               wake=False, wake_command=None, cooldown=60, max_per_hour=20,
               timeout=900, model=None, max_retries=3):
    import threading
    import time
    state = _load_watch_state()
    last_msg = int(state.get("last_msg_id", 0))
    last_decided = int(state.get("last_decided_id", 0))
    pending = state.get("pending_autoprocess", []) if autoprocess else []
    while True:
        emitted = []
        try:
            msgs = harpp_client.poll_messages(limit=100).get("data", {}).get("messages", [])
            for m in sorted(msgs, key=lambda row: int(row.get("id", 0))):
                mid = int(m.get("id", 0))
                if mid > last_msg:
                    last_msg = mid
                    # Never receipt/re-wake on the harness's own replies.
                    sender = str(m.get("sender_type") or "owner").lower()
                    if sender not in ("owner", "user"):
                        continue
                    rec = {"kind": "message", "id": mid, "conversation_id": m.get("conversation_id"), "sender_type": m.get("sender_type"), "body": m.get("body"), "created_at": m.get("created_at")}
                    _emit(rec, inbox)
                    _notify("HARPP message", str(m.get("body", ""))[:120])
                    emitted.append(rec)
        except Exception as e:
            print(f"harpp watch: message poll failed: {e}", flush=True)
        try:
            ds = harpp_client.list_decisions(limit=100).get("data", {}).get("decisions", [])
            for d in sorted(ds, key=lambda row: int(row.get("id", 0))):
                did = int(d.get("id", 0))
                if d.get("decided_at") and d.get("lifecycle_state") == "DECIDED" and did > last_decided:
                    rec = {"kind": "decision", "id": did, "decision_key": d.get("decision_key"), "title": d.get("title"), "decision": d.get("decision"), "rationale": d.get("rationale"), "decided_by": d.get("decided_by"), "lifecycle_state": d.get("lifecycle_state")}
                    _emit(rec, inbox)
                    _notify("HARPP decision", f"#{did} {str(d.get('title', ''))[:120]}")
                    emitted.append(rec)
                    last_decided = did
        except Exception as e:
            print(f"harpp watch: decision poll failed: {e}", flush=True)
        if autoprocess:
            known = {(r.get("kind"), r.get("id")) for r in pending}
            pending.extend(r for r in emitted if (r.get("kind"), r.get("id")) not in known)
        # Persist pending receipts before network delivery so a crash cannot lose them.
        _save_watch_state({"last_msg_id": last_msg, "last_decided_id": last_decided,
                           "pending_autoprocess": pending})
        # Instant confirmation + decisions are deterministic and retried every poll.
        if autoprocess and pending:
            pending = _autoprocess(pending, log)
            _save_watch_state({"last_msg_id": last_msg, "last_decided_id": last_decided,
                               "pending_autoprocess": pending})
        # Job monitor: track delegated model processes; when one finishes, verify + commit
        # + report the result to the owner conversation automatically (no reminder needed).
        try:
            harpp_wake.monitor_jobs()
        except Exception as e:
            print(f"harpp watch: job monitor failed: {e}", flush=True)
        # Substantive processing: the wake agent (when enabled) replies/works in the
        # background, ledger-deduped, bounded by cooldown + max-per-hour.
        if wake:
            wake_kw = dict(enabled=True, command=wake_command,
                           model=model or harpp_wake.DEFAULT_MODEL, cooldown=cooldown,
                           max_per_hour=max_per_hour, timeout=timeout,
                           max_retries=max_retries)
            if once:
                harpp_wake.maybe_wake(inbox, **wake_kw)
            else:
                # Agent latency (up to timeout) must never block polling/instant receipts.
                threading.Thread(target=harpp_wake.maybe_wake, args=(inbox,),
                                 kwargs=wake_kw, daemon=True).start()
        if once:
            return
        time.sleep(max(5, interval))


def inbox_cmd(clear):
    p = Path(DEFAULT_INBOX)
    if not p.exists():
        print("inbox empty")
        return
    for line in p.read_text(encoding="utf-8").splitlines():
        if line.strip():
            print(line)
    if clear:
        p.unlink()


def cmd_job_track(args):
    try:
        jid = harpp_wake.track_job(
            pid=args.pid, model=args.model, task=args.task, conversation_id=args.conversation,
            log_path=args.log, verify=args.verify, marker=args.marker,
            repo=args.repo, commit=args.commit)
    except ValueError as exc:
        sys.exit(f"harpp job track: {exc}")
    print(json.dumps({"job_id": jid, "status": "tracked", "pid": args.pid,
                      "conversation_id": args.conversation}))


def cmd_job_list(args):
    jobs = harpp_wake.list_jobs()
    print(json.dumps({"count": len(jobs), "jobs": jobs}, indent=2))


def cmd_job_untrack(args):
    ok = harpp_wake.untrack_job(args.id)
    print(json.dumps({"job_id": args.id, "untracked": ok}))
    if not ok:
        raise SystemExit(1)


def main():
    p = argparse.ArgumentParser(prog="harpp", description="HARPP harness bridge client")
    sub = p.add_subparsers(dest="cmd", required=True)

    cfg = sub.add_parser("config")
    cfg.add_argument("action", choices=["set", "get"])
    cfg.add_argument("key", nargs="?")
    cfg.add_argument("value", nargs="?")

    sub.add_parser("check")
    sub.add_parser("self-test")

    d = sub.add_parser("decision")
    dsub = d.add_subparsers(dest="dcmd", required=True)
    ds = dsub.add_parser("submit")
    ds.add_argument("--title", required=True)
    ds.add_argument("--body", required=True)
    ds.add_argument("--context", default="")
    ds.add_argument("--requested", dest="requested_decision", default="")
    ds.add_argument("--priority", default="normal", choices=["low", "normal", "high", "critical"])
    ds.add_argument("--source", default="harness")
    ds.add_argument("--workbench-state", default="ARCHITECTURE_DECISION_REQUIRED")
    ds.add_argument("--decision-key", default="")
    dl = dsub.add_parser("list")
    dl.add_argument("--state", default="")
    dl.add_argument("--priority", default="")
    dl.add_argument("--workbench-state", default="")
    dl.add_argument("--limit", type=int, default=25)
    da = dsub.add_parser("ack")
    da.add_argument("id", type=int)
    da.add_argument("--rationale", default="Harness acknowledged the owner decision.")
    dv = dsub.add_parser("view", help="mark a decision viewed (NOTIFIED -> VIEWED) via the bridge")
    dv.add_argument("id", type=int)
    dv.add_argument("--rationale", default="Owner viewed the decision via messenger.")
    dd = dsub.add_parser("decide", help="record the owner's decision (DECIDED) via the bridge")
    dd.add_argument("id", type=int)
    dd.add_argument("--decision", required=True)
    dd.add_argument("--rationale", default="Owner decision recorded by harness.")
    dp = dsub.add_parser("apply")
    dp.add_argument("id", type=int)
    dp.add_argument("--rationale", default="Harness applied the owner decision.")

    m = sub.add_parser("msg")
    msub = m.add_subparsers(dest="mcmd", required=True)
    ms = msub.add_parser("send")
    ms.add_argument("--body", required=True)
    ms.add_argument("--conversation-id", type=int)
    ms.add_argument("--title", default="")
    ms.add_argument("--harness-session-id", default="")
    mp = msub.add_parser("poll")
    mp.add_argument("--conversation-id", type=int)
    mp.add_argument("--after", type=int, default=0)
    mp.add_argument("--limit", type=int, default=25)

    st = sub.add_parser("status")
    st.add_argument("--message", required=True)
    st.add_argument("--status", default="")
    st.add_argument("--workbench-state", default="")
    st.add_argument("--harness-session-id", default="")

    wt = sub.add_parser("watch", help="actively monitor + auto-process owner messages + decided decisions")
    wt.add_argument("--once", action="store_true", help="single check, then exit")
    wt.add_argument("--interval", type=int, default=60, help="poll interval seconds (default 60)")
    wt.add_argument("--inbox", default=DEFAULT_INBOX, help="append new items to this JSONL file")
    wt.add_argument("--no-autoprocess", action="store_true", help=argparse.SUPPRESS)  # retained compatibility; ignored
    wt.add_argument("--log", default=".ai/harpp-wake.log", help="autoprocess action log (default .ai/harpp-wake.log)")
    wt.add_argument("--wake", action="store_true", help="enable headless Pi-agent wake (mechanism E; env HARPP_WAKE_ENABLED=1)")
    wt.add_argument("--wake-command", default=os.environ.get("HARPP_WAKE_CMD", ""), help="override agent invocation; {model}/{prompt} substituted")
    wt.add_argument("--cooldown", type=int, default=int(os.environ.get("HARPP_WAKE_COOLDOWN", "60")))
    wt.add_argument("--max-per-hour", dest="max_per_hour", type=int, default=int(os.environ.get("HARPP_WAKE_MAX_PER_HOUR", "20")))
    wt.add_argument("--timeout", type=int, default=int(os.environ.get("HARPP_WAKE_TIMEOUT", "900")))
    wt.add_argument("--max-retries", type=int, default=int(os.environ.get("HARPP_WAKE_MAX_RETRIES", "3")))
    wt.add_argument("--model", default=os.environ.get("HARPP_WAKE_MODEL", "deepseek/deepseek-v4-pro"))

    ib = sub.add_parser("inbox", help="read (or clear) the accumulated harness inbox")
    ib.add_argument("--clear", action="store_true")

    jb = sub.add_parser("job", help="track/monitor delegated model jobs (auto-report on completion)")
    jsub = jb.add_subparsers(dest="jcmd", required=True)
    jt = jsub.add_parser("track", help="register an in-flight delegated model job")
    jt.add_argument("--pid", type=int, required=True, help="pid of the running model process")
    jt.add_argument("--model", required=True, help="provider-qualified model id, e.g. openai-codex/gpt-5.6-sol")
    jt.add_argument("--task", required=True, help="short description of the work being done")
    jt.add_argument("--conversation", type=int, required=True, help="conversation id to auto-report to")
    jt.add_argument("--log", default=None, help="path to the model's log file")
    jt.add_argument("--verify", default=None, help="verification command; exit 0 = pass")
    jt.add_argument("--marker", default=None, help="success marker string to search for in the log")
    jt.add_argument("--repo", default=None, help="repo path for git status / auto-commit")
    jt.add_argument("--commit", action="store_true", help="auto commit + push on verified completion")
    jt.set_defaults(func=cmd_job_track)
    jl = jsub.add_parser("list", help="list tracked jobs + status")
    jl.set_defaults(func=cmd_job_list)
    ju = jsub.add_parser("untrack", help="drop a job from the registry")
    ju.add_argument("id", help="job id")
    ju.set_defaults(func=cmd_job_untrack)

    args = p.parse_args()

    if args.cmd == "config":
        if args.action == "set":
            if not args.key or not args.value:
                sys.exit("harpp config set requires KEY and VALUE")
            path = harpp_client.save_config({args.key: args.value})
            print(f"saved {args.key} -> {path}")
        else:
            cfg = harpp_client.load_config()
            if args.key:
                print(cfg.get(args.key, ""))
            else:
                print(json.dumps({k: ("<redacted>" if k == "bridge_key" else v) for k, v in cfg.items()}, indent=2))
    elif args.cmd == "check":
        cfg = harpp_client.load_config()
        print(f"base_url={cfg['base_url']} tenant_id={cfg['tenant_id']} bridge_key=<redacted> OK")
    elif args.cmd == "self-test":
        import unittest
        import tests.test_harpp_bridge as t
        import tests.test_harpp_wake as tw
        suite = unittest.TestSuite([
            unittest.defaultTestLoader.loadTestsFromModule(t),
            unittest.defaultTestLoader.loadTestsFromModule(tw),
        ])
        result = unittest.TextTestRunner(verbosity=2).run(suite)
        sys.exit(0 if result.wasSuccessful() else 1)
    elif args.cmd == "decision":
        if args.dcmd == "submit":
            print(json.dumps(harpp_client.submit_decision(
                title=args.title, body=args.body, context=args.context,
                requested_decision=args.requested_decision, priority=args.priority,
                source=args.source, workbench_state=args.workbench_state, decision_key=args.decision_key), indent=2))
        elif args.dcmd == "list":
            print(json.dumps(harpp_client.list_decisions(
                state=args.state, priority=args.priority, workbench_state=args.workbench_state, limit=args.limit), indent=2))
        elif args.dcmd == "view":
            print(json.dumps(harpp_client.view_decision(args.id, rationale=args.rationale), indent=2))
        elif args.dcmd == "decide":
            print(json.dumps(harpp_client.record_decision(args.id, args.decision, rationale=args.rationale), indent=2))
        elif args.dcmd == "ack":
            print(json.dumps(harpp_client.acknowledge_decision(args.id, rationale=args.rationale), indent=2))
        else:
            print(json.dumps(harpp_client.apply_decision(args.id, rationale=args.rationale), indent=2))
    elif args.cmd == "msg":
        if args.mcmd == "send":
            print(json.dumps(harpp_client.send_message(
                body=args.body, conversation_id=args.conversation_id, title=args.title,
                harness_session_id=args.harness_session_id), indent=2))
        else:
            print(json.dumps(harpp_client.poll_messages(
                conversation_id=args.conversation_id, after=args.after, limit=args.limit), indent=2))
    elif args.cmd == "status":
        print(json.dumps(harpp_client.post_status(
            message=args.message, status=args.status, workbench_state=args.workbench_state,
            harness_session_id=args.harness_session_id), indent=2))
    elif args.cmd == "watch":
        watch_loop(once=args.once, interval=args.interval, inbox=args.inbox,
                   autoprocess=True, log=args.log,
                   wake=args.wake or os.environ.get("HARPP_WAKE_ENABLED", "") == "1",
                   wake_command=args.wake_command or None, cooldown=args.cooldown,
                   max_per_hour=args.max_per_hour, timeout=args.timeout,
                   model=args.model or None, max_retries=args.max_retries)
    elif args.cmd == "inbox":
        inbox_cmd(clear=args.clear)
    elif args.cmd == "job":
        args.func(args)


if __name__ == "__main__":
    try:
        main()
    except harpp_client.HarppError as exc:
        sys.stderr.write(f"harpp: {exc}\n")
        sys.exit(1)
