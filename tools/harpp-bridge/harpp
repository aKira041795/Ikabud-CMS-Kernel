    jl2.add_argument("--timeout", type=int, default=0, help="hard kill the job after N seconds (0 = no deadline)")
    jl2.add_argument("--cwd", default=None, help="working directory for the spawned command (default: configured workspace)")
    jl2.add_argument("--no-terminal", action="store_true", help="do not open a visible terminal for live feedback")
    jl2.add_argument("--authority-level", default=None, help="job authority level (default: configured HARPP authority, else L2)")
    jl2.add_argument("command", nargs=argparse.REMAINDER, help="command to run, after --")
    jl2.set_defaults(func=cmd_job_launch)
    jt = jsub.add_parser("track", help="register an already-running model process")
    jt.add_argument("--pid", type=int, required=True, help="pid of the running model process")
    jt.add_argument("--model", required=True, help="provider-qualified model id, e.g. openai-codex/gpt-5.6-sol")
    jt.add_argument("--task", required=True, help="short description of the work being done")
    jt.add_argument("--conversation", type=int, required=True, help="conversation id to auto-report to")
    jt.add_argument("--log", default=None, help="path to the model's log file")
    jt.add_argument("--verify", default=None, help="verification command; exit 0 = pass")
    jt.add_argument("--marker", default=None, help="success marker string to search for in the log")
    jt.add_argument("--repo", default=None, help="repo path for git status / auto-commit")
    jt.add_argument("--commit", action="store_true", help="auto commit + push on verified completion")
    jt.add_argument("--timeout", type=int, default=0, help="hard kill the job after N seconds (0 = no deadline)")
    jt.add_argument("--authority-level", default=None, help="job authority level (default: configured HARPP authority, else L2)")
    jt.set_defaults(func=cmd_job_track)
    jl = jsub.add_parser("list", help="list tracked jobs + status")
    jl.set_defaults(func=cmd_job_list)
    ju = jsub.add_parser("untrack", help="drop a job from the registry")
    ju.add_argument("id", help="job id")
    ju.set_defaults(func=cmd_job_untrack)

    wf = sub.add_parser("workflow", help="governed multi-stage workflows (architect->implement->review->gate)")
    wsub = wf.add_subparsers(dest="wcmd", required=True)
    ws = wsub.add_parser("start", help="start a multi-stage workflow from a JSON manifest")
    ws.add_argument("--title", default="")
    ws.add_argument("--conversation", type=int, required=True, help="conversation id to report to")
    ws.add_argument("--manifest", required=True, help="JSON manifest with a non-empty 'stages' array")
    ws.add_argument("--workspace", default=None, help="working dir for stages (default: configured workspace)")
    ws.add_argument("--model", default=None, help="temporary model preference for every workflow stage")
    ws.add_argument("--max-repairs", type=int, default=None,
                    help="bounded auto-repair rounds on stage failure (default from manifest, else 3; 0 disables)")
    ws.add_argument("--max-total-cycles", type=int, default=None)
    ws.add_argument("--max-browser-repairs", type=int, default=None)
    ws.add_argument("--max-tool-retries", type=int, default=None)
    ws.add_argument("--max-network-retries", type=int, default=None)
    ws.add_argument("--contract-revision", type=int, default=0)
    ws.add_argument("--authority-level", default=None,
                    help="configured workflow authority (default from config harpp_authority, else L2)")
    ws.add_argument("--dry-run", action="store_true",
                    help="run schema + runtime preflight and report, without persisting/launching")
    ws.set_defaults(func=cmd_workflow_start)
    wv = wsub.add_parser("validate", help="validate a workflow manifest against the versioned schema + preflight")
    wv.add_argument("--manifest", required=True, help="JSON workflow manifest to validate")
    wv.add_argument("--workspace", default=None, help="workspace to preflight against")
    wv.set_defaults(func=cmd_workflow_validate)
    wl = wsub.add_parser("list", help="list workflows + status")
    wl.set_defaults(func=cmd_workflow_list)
    wh = wsub.add_parser("show", help="show a workflow's full state")
    wh.add_argument("id")
    wh.set_defaults(func=cmd_workflow_show)
    wr = wsub.add_parser("resume", help="reconstruct and re-land a workflow after a crash")
    wr.add_argument("id")
    wr.set_defaults(func=cmd_workflow_resume)

    args = p.parse_args()

    if args.cmd == "config":
        if args.action == "set":
            if not args.key or not args.value:
                sys.exit("harpp config set requires KEY and VALUE")
            path = harpp_client.save_config({args.key: args.value})
            print(f"saved {args.key} -> {path}")
        else:
            cfg = harpp_client.load_config()
            if args.key:
                print(cfg.get(args.key, ""))
            else:
                print(json.dumps({k: ("<redacted>" if k == "bridge_key" else v) for k, v in cfg.items()}, indent=2))
    elif args.cmd == "check":
        cfg = harpp_client.load_config()
        print(f"base_url={cfg['base_url']} tenant_id={cfg['tenant_id']} bridge_key=<redacted> OK")
    elif args.cmd == "self-test":
        import unittest
        import tests.test_harpp_bridge as t
        import tests.test_harpp_wake as tw
        suite = unittest.TestSuite([
            unittest.defaultTestLoader.loadTestsFromModule(t),
            unittest.defaultTestLoader.loadTestsFromModule(tw),
        ])
        result = unittest.TextTestRunner(verbosity=2).run(suite)
        sys.exit(0 if result.wasSuccessful() else 1)
    elif args.cmd == "decision":
        if args.dcmd == "record":
            print(json.dumps(harpp_wake.record_local_decision(
                task=args.task, decision=args.decision, constraints=args.constraint,
                additional_requirements=args.additional, source=args.source,
                applied_to=args.applied_to), indent=2))
        elif args.dcmd == "submit":
            print(json.dumps(harpp_client.submit_decision(
                title=args.title, body=args.body, context=args.context,
                requested_decision=args.requested_decision, priority=args.priority,
                source=args.source, workbench_state=args.workbench_state, decision_key=args.decision_key), indent=2))
        elif args.dcmd == "list":
            if args.remote or args.state or args.priority or args.workbench_state:
                print(json.dumps(harpp_client.list_decisions(
                    state=args.state, priority=args.priority, workbench_state=args.workbench_state, limit=args.limit), indent=2))
            else:
                records = harpp_wake.load_decisions()
                print(json.dumps({"count": len(records[-args.limit:]), "decisions": records[-args.limit:]}, indent=2))
        elif args.dcmd == "view":
            print(json.dumps(harpp_client.view_decision(args.id, rationale=args.rationale), indent=2))
        elif args.dcmd == "decide":
            print(json.dumps(harpp_client.record_decision(args.id, args.decision, rationale=args.rationale), indent=2))
        elif args.dcmd == "ack":
            print(json.dumps(harpp_client.acknowledge_decision(args.id, rationale=args.rationale), indent=2))
        elif args.dcmd == "cancel":
            print(json.dumps(harpp_client.cancel_decision(args.id, rationale=args.rationale), indent=2))
        else:
            print(json.dumps(harpp_client.apply_decision(args.id, rationale=args.rationale), indent=2))
    elif args.cmd == "msg":
        if args.mcmd == "send":
            print(json.dumps(harpp_client.send_message(
                body=args.body, conversation_id=args.conversation_id, title=args.title,
                harness_session_id=args.harness_session_id,
                idempotency_key=args.idempotency_key), indent=2))
        else:
            print(json.dumps(harpp_client.poll_messages(
                conversation_id=args.conversation_id, after=args.after, limit=args.limit), indent=2))
    elif args.cmd == "status":
        print(json.dumps(harpp_client.post_status(
            message=args.message, status=args.status, workbench_state=args.workbench_state,
            harness_session_id=args.harness_session_id), indent=2))
    elif args.cmd == "watch":
        watch_loop(once=args.once, interval=args.interval, inbox=args.inbox,
                   autoprocess=True, log=args.log,
                   wake=args.wake or os.environ.get("HARPP_WAKE_ENABLED", "") == "1",
                   wake_command=args.wake_command or None, cooldown=args.cooldown,
                   max_per_hour=args.max_per_hour, timeout=args.timeout,
                   model=args.model or None, max_retries=args.max_retries,
                   open_terminal=not args.no_terminal and os.environ.get("HARPP_WAKE_TERMINAL", "1") != "0")
    elif args.cmd == "wake-relay":
        cmd_wake_relay(args)
    elif args.cmd == "inbox":
        inbox_cmd(clear=args.clear, path=args.inbox)
    elif args.cmd == "idempotency":
        if args.icmd == "release":
            print(json.dumps(harpp_client.release_idempotency(
                scope=args.scope, idempotency_key=args.key), indent=2))
    elif args.cmd == "job":
        args.func(args)
    elif args.cmd == "workflow":
        args.func(args)


if __name__ == "__main__":
    try:
        main()
    except harpp_client.HarppError as exc:
        sys.stderr.write(f"harpp: {exc}\n")
        sys.exit(1)
