    dv.add_argument("id", type=int)
    dv.add_argument("--rationale", default="Owner viewed the decision via messenger.")
    dd = dsub.add_parser("decide", help="record the owner's decision (DECIDED) via the bridge")
    dd.add_argument("id", type=int)
    dd.add_argument("--decision", required=True)
    dd.add_argument("--rationale", default="Owner decision recorded by harness.")
    dp = dsub.add_parser("apply")
    dp.add_argument("id", type=int)
    dp.add_argument("--rationale", default="Harness applied the owner decision.")

    m = sub.add_parser("msg")
    msub = m.add_subparsers(dest="mcmd", required=True)
    ms = msub.add_parser("send")
    ms.add_argument("--body", required=True)
    ms.add_argument("--conversation-id", type=int)
    ms.add_argument("--title", default="")
    ms.add_argument("--harness-session-id", default="")
    ms.add_argument("--idempotency-key", default="")
    mp = msub.add_parser("poll")
    mp.add_argument("--conversation-id", type=int)
    mp.add_argument("--after", type=int, default=0)
    mp.add_argument("--limit", type=int, default=25)

    st = sub.add_parser("status")
    st.add_argument("--message", required=True)
    st.add_argument("--status", default="")
    st.add_argument("--workbench-state", default="")
    st.add_argument("--harness-session-id", default="")

    wt = sub.add_parser("watch", help="actively monitor + auto-process owner messages + decided decisions")
    wt.add_argument("--once", action="store_true", help="single check, then exit")
    wt.add_argument("--interval", type=int, default=60, help="poll interval seconds (default 60)")
    wt.add_argument("--inbox", default=None, help=f"append new items to this JSONL file (default {_default_inbox()})")
    wt.add_argument("--no-autoprocess", action="store_true", help=argparse.SUPPRESS)  # retained compatibility; ignored
    wt.add_argument("--log", default=None, help=f"autoprocess action log (default {_default_log()})")
    wt.add_argument("--wake", action="store_true", help="enable headless Pi-agent wake (mechanism E; env HARPP_WAKE_ENABLED=1)")
