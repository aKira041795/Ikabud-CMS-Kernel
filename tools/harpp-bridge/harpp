    wt.add_argument("--no-terminal", action="store_true",
                    help="do not open a visible terminal for wake feedback (default: on)")

    w = sub.add_parser("wake-relay", help="run as a LAN Wake-on-LAN relay: claim HARPP wake requests for configured runners and emit WoL magic packets")
    w.add_argument("--interval", type=int, default=5, help="seconds between relay passes (default 5)")
    w.add_argument("--once", action="store_true", help="run a single relay pass and exit (cron/testing)")
    w.add_argument("--check", action="store_true", help="print relay configuration and exit")

    ib = sub.add_parser("inbox", help="read (or clear) the accumulated harness inbox")
    ib.add_argument("--clear", action="store_true")
    ib.add_argument("--inbox", default=None, help="override the inbox path (default machine-global)")

    idem = sub.add_parser("idempotency", help="manage server-side idempotency keys")
    idemsub = idem.add_subparsers(dest="icmd", required=True)
    idr = idemsub.add_parser("release", help="delete a stuck idempotency key (owner/admin) so its scope can be re-claimed")
    idr.add_argument("--key", required=True, help="the idempotency key to release, e.g. wake-message-566")
    idr.add_argument("--scope", default="harpp_message", help="idempotency scope (default harpp_message)")

    jb = sub.add_parser("job", help="track/monitor delegated model jobs (auto-report on completion)")
    jsub = jb.add_subparsers(dest="jcmd", required=True)
    jl2 = jsub.add_parser("launch", help="spawn a delegated model command AND track it in one step (auto-report on completion)")
    jl2.add_argument("--model", required=True, help="provider-qualified model id, e.g. openai-codex/gpt-5.6-sol")
