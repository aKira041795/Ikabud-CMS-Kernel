{
    "title": "Governed loop (Deepseek flash delegated): architect -> implement -> review -> release-gate",
    "stages": [
        {
            "name": "architect",
            "model": "deepseek/deepseek-v4-flash",
            "prompt_file": "stages/architect.md",
            "marker": "SOL_ARCH status=PASS",
            "verify": "test -s ARCHITECTURE.md && test \"$(tail -n 1 ARCHITECTURE.md)\" = \"status: READY_FOR_IMPLEMENTATION\"",
            "timeout": 1800
        },
        {
            "name": "implement",
            "model": "deepseek/deepseek-v4-flash",
            "prompt_file": "stages/implement.md",
            "marker": "SOL_IMPL status=PASS",
            "verify": "git diff --check",
            "timeout": 2400
        },
        {
            "name": "review",
            "model": "deepseek/deepseek-v4-flash",
            "prompt_file": "stages/review.md",
            "marker": "SOL_REVIEW status=PASS",
            "verify": "git diff --check",
            "timeout": 1800
        },
        {
            "name": "release-gate",
            "model": "deepseek/deepseek-v4-flash",
            "prompt_file": "stages/release-gate.md",
            "marker": "SOL_GATE status=PASS",
            "verify": "git diff --check",
            "timeout": 1800
        }
    ]
}
