{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ikabud.local/schemas/session-resume/session-v1.schema.json",
  "title": "Ikabud last-session snapshot",
  "description": "Secret-free identity and environment snapshot used by the fail-closed session resume pilot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adaptor_versions",
    "generation",
    "sequence",
    "boot_id",
    "timestamps",
    "approved_realpaths",
    "workspace",
    "chat",
    "cwd",
    "git",
    "venv",
    "pi",
    "contract",
    "workbench"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "adaptor_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture", "vscode", "chat", "terminal", "pi", "workbench"],
      "properties": {
        "capture": { "$ref": "#/definitions/version" },
        "vscode": { "$ref": "#/definitions/version" },
        "chat": { "$ref": "#/definitions/version" },
        "terminal": { "$ref": "#/definitions/version" },
        "pi": { "$ref": "#/definitions/version" },
        "workbench": { "$ref": "#/definitions/version" }
      }
    },
    "generation": { "$ref": "#/definitions/uuid" },
    "sequence": { "type": "integer", "minimum": 1 },
    "boot_id": { "$ref": "#/definitions/uuid" },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_started_at", "captured_at", "heartbeat_at"],
      "properties": {
        "generation_started_at": { "$ref": "#/definitions/timestamp" },
        "captured_at": { "$ref": "#/definitions/timestamp" },
        "heartbeat_at": { "$ref": "#/definitions/timestamp" }
      }
    },
    "approved_realpaths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workspace", "cwd", "venv", "pi_executable", "contract", "workbench_task"],
      "properties": {
        "repository": { "$ref": "#/definitions/absolutePath" },
        "workspace": { "$ref": "#/definitions/absolutePath" },
        "cwd": { "$ref": "#/definitions/absolutePath" },
        "venv": { "$ref": "#/definitions/absolutePath" },
        "pi_executable": { "$ref": "#/definitions/absolutePath" },
        "contract": { "$ref": "#/definitions/absolutePath" },
        "workbench_task": { "$ref": "#/definitions/absolutePath" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "profile"],
      "properties": {
        "path": { "$ref": "#/definitions/absolutePath" },
        "kind": { "enum": ["folder", "workspace"] },
        "profile": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f]+$" }
      }
    },
    "chat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extension_id", "extension_version", "session_id"],
      "properties": {
        "extension_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*\\.[A-Za-z0-9][A-Za-z0-9.-]*$", "maxLength": 255 },
        "extension_version": { "$ref": "#/definitions/version" },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9._:/-]+$" }
      }
    },
    "cwd": { "$ref": "#/definitions/absolutePath" },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "head"],
      "properties": {
        "branch": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!.*(?:^|/)\\.\\.?($|/))(?!.*\\.\\.)(?!.*[~^:?*\\[\\]\\\\ ])(?!.*//)(?!.*@$)(?!.*\\.$).+$" },
        "head": { "type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$" }
      }
    },
    "venv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "python"],
      "properties": {
        "root": { "$ref": "#/definitions/absolutePath" },
        "python": { "$ref": "#/definitions/absolutePath" }
      }
    },
    "pi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "sha256", "version", "identity", "argv"],
      "properties": {
        "executable": { "$ref": "#/definitions/absolutePath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "version": { "$ref": "#/definitions/version" },
        "identity": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^\\u0000-\\u001f]+$" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 4096, "pattern": "^[^\\u0000]+$" }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/definitions/absolutePath" },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "workbench": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_path", "sha256", "task_id", "state"],
      "properties": {
        "task_path": { "$ref": "#/definitions/absolutePath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "task_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 255 },
        "state": {
          "enum": [
            "REQUESTED", "ARCHITECTING", "READY_FOR_IMPLEMENTATION", "IMPLEMENTING",
            "READY_FOR_REVIEW", "REVIEWING", "CHANGES_REQUIRED", "REVIEW_PASSED",
            "RELEASE_GATE", "READY_FOR_RELEASE", "BLOCKED", "FAILED", "REVIEW_REQUIRED",
            "ARCHITECTURE_DECISION_REQUIRED", "RELEASE_BLOCKED"
          ]
        }
      }
    }
  },
  "definitions": {
    "absolutePath": { "type": "string", "minLength": 2, "maxLength": 4096, "pattern": "^/(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}(?:[-+][0-9A-Za-z.-]+)?$" }
  }
}
