    // ── migrate:status ───────────────────────────────────────────
    case 'migrate:status':
        banner();
        try {
            $runner = new MigrationRunner(app()->db());

            if (!empty($params[0])) {
                $stat = $runner->status($params[0]);
                out('  Module: ' . bold($params[0]));
