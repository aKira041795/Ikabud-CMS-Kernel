/**
 * Validate a single theme: manifest, tokens, templates, anti-patterns.
 *
 * @param string $slug       Theme directory name
 * @param string $themesPath Path to the cms-themes directory
 * @return array{error_count: int, warning_count: int}
 */
function validateSingleTheme(string $slug, string $themesPath): array
{
    $themeDir = $themesPath . '/' . $slug;
    $errorCount = 0;
    $warningCount = 0;

    if (!is_dir($themeDir)) {
        out('  ' . red("✗ Theme '{$slug}' not found at {$themeDir}"));
        return ['error_count' => 1, 'warning_count' => 0];
    }

    banner();
    out('  ' . bold('Theme Validate: ') . cyan($slug));
    out('');

    // ── 1. Load manifest ─────────────────────────────────────────
    out('  ' . bold('Manifest'));
    $manifestFile = $themeDir . '/theme.manifest.json';
    $isNewFormat = true;
    if (!is_file($manifestFile)) {
        $manifestFile = $themeDir . '/theme.json';
        $isNewFormat = false;
    }
    if (!is_file($manifestFile)) {
        out('    ' . red('✗') . ' No theme.manifest.json or theme.json found');
        out('');
        return ['error_count' => 1, 'warning_count' => 0];
    }

    $decoded = kernelReadJsonFile($manifestFile);
    if (!is_array($decoded) || empty($decoded)) {
        out('    ' . red('✗') . ' Failed to parse manifest JSON');
        return ['error_count' => 1, 'warning_count' => 0];
    }

    $manifest = $decoded;
    $manifest['slug'] = $slug;
    out('    ' . green('✓') . ' Loaded ' . ($isNewFormat ? 'theme.manifest.json' : 'theme.json (legacy)'));

    // ── 2. Schema validation via ThemeManifestValidator ────────────
    out('  ' . bold('Schema'));

    if (class_exists('\\Ikabud\\Kernel\\Services\\ThemeManifestValidator')) {
        $validation = \Ikabud\Kernel\Services\ThemeManifestValidator::validate($slug, $manifest, $themeDir);

        foreach ($validation['errors'] as $err) {
            out('    ' . red('✗') . ' ' . $err);
            $errorCount++;
        }
        foreach ($validation['warnings'] as $warn) {
            out('    ' . yellow('⚠') . ' ' . $warn);
            $warningCount++;
        }

        if (empty($validation['errors'])) {
            out('    ' . green('✓') . ' Schema valid');
        }
    } else {
        out('    ' . yellow('⚠') . ' ThemeManifestValidator not available — basic checks only');
    }

    // ── 3. Template file audit ────────────────────────────────────
    out('  ' . bold('Templates'));
    $templateDirs = ['layouts', 'public', 'components', 'entity-views', 'patterns', 'admin'];
    $templateCount = 0;
    $missingDirCount = 0;
    foreach ($templateDirs as $dir) {
        $fullDir = $themeDir . '/' . $dir;
        if (!is_dir($fullDir)) {
            if (in_array($dir, ['layouts', 'public'], true)) {
                out('    ' . red('✗') . " Required '{$dir}/' directory not found");
                $errorCount++;
            }
            continue;
        }
        $files = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($fullDir, FilesystemIterator::SKIP_DOTS)
        );
        $dirCount = 0;
        foreach ($files as $finfo) {
            if ($finfo->isFile()) {
                $dirCount++;
            }
        }
        $templateCount += $dirCount;
        if ($dirCount === 0) {
            out('    ' . yellow('⚠') . " '{$dir}/' is empty");
            $warningCount++;
        }
    }
    out('    ' . green('✓') . " {$templateCount} template(s) found in " . count(array_filter($templateDirs, fn($d) => is_dir($themeDir . '/' . $d))) . ' directories');

    // ── 4. Anti-pattern scan ──────────────────────────────────────
    out('  ' . bold('Anti-pattern scan'));
    $scannedDirs = array_filter($templateDirs, fn($d) => is_dir($themeDir . '/' . $d));
    $antiPatterns = themeScanAntiPatterns($themeDir, $scannedDirs);

    if (empty($antiPatterns)) {
        out('    ' . green('✓') . ' No anti-patterns detected');
    } else {
        foreach ($antiPatterns as $ap) {
            out('    ' . red('✗') . ' ' . $ap);
            $errorCount++;
        }
    }

    // ── 5. Performance budget (CSS/JS file sizes) ─────────────────
    out('  ' . bold('Performance budget'));

    // Check required CSS files
    $requiredAssets = $manifest['required_assets'] ?? [];
    $cssFiles = is_array($requiredAssets['css'] ?? null) ? $requiredAssets['css'] : [];
    $allCssSize = 0;
    foreach ($cssFiles as $css) {
        $cssPath = $themeDir . '/' . ltrim((string)$css, '/');
        if (is_file($cssPath)) {
            $size = filesize($cssPath);
            $allCssSize += $size;
            if ($size > 51200) { // 50KB
                out('    ' . yellow('⚠') . " '{$css}' is " . round($size / 1024) . 'KB (budget: 50KB)');
                $warningCount++;
            }
        }
    }
    if ($allCssSize > 0) {
        out('    ' . green('✓') . ' Core CSS: ' . round($allCssSize / 1024) . 'KB compressed');
    } else {
        out('    ' . green('✓') . ' No required CSS assets declared');
    }

    // Check required JS files
    $jsFiles = is_array($requiredAssets['js'] ?? null) ? $requiredAssets['js'] : [];
    $allJsSize = 0;
    foreach ($jsFiles as $js) {
        $jsPath = $themeDir . '/' . ltrim((string)$js, '/');
        if (is_file($jsPath)) {
            $size = filesize($jsPath);
            $allJsSize += $size;
            if ($size > 20480) { // 20KB
                out('    ' . yellow('⚠') . " '{$js}' is " . round($size / 1024) . 'KB (budget: 20KB)');
                $warningCount++;
            }
        }
    }
    if ($allJsSize > 0) {
        out('    ' . green('✓') . ' Core JS: ' . round($allJsSize / 1024) . 'KB');
    }

    // ── 6. DiSyL lint on theme templates ──────────────────────────
    $themeHasDisyl = false;
    foreach ($templateDirs as $dir) {
        $fullDir = $themeDir . '/' . $dir;
        if (!is_dir($fullDir)) { continue; }
        $iter = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($fullDir, FilesystemIterator::SKIP_DOTS)
        );
        foreach ($iter as $finfo) {
            if ($finfo->isFile() && str_ends_with($finfo->getFilename(), '.disyl')) {
                $themeHasDisyl = true;
                break 2;
            }
        }
    }

    if ($themeHasDisyl) {
        out('  ' . bold('DiSyL lint'));
        // Run the linter via _lint_disyl.php on the theme directory
        $lintCmd = escapeshellcmd(PHP_BINARY) . ' ' . escapeshellarg(__DIR__ . '/_lint_disyl.php')
            . ' --path ' . escapeshellarg($themeDir)
            . ' --ci 2>&1';
        $lintOutput = shell_exec($lintCmd);
        $lintExitCode = (int)(shell_exec($lintCmd . '; echo $?') ?? 0);

        if ($lintExitCode !== 0) {
            out('    ' . red('✗') . ' DiSyL lint found errors in theme templates');
            $errorCount++;
        } else {
            out('    ' . green('✓') . ' All .disyl templates pass lint');
        }
    }

    // ── Summary ───────────────────────────────────────────────────
    out('');
    if ($errorCount > 0) {
        out('  ' . red('✗ ' . $errorCount . ' errors') . ($warningCount > 0 ? ', ' . yellow($warningCount . ' warnings') : ''));
    } elseif ($warningCount > 0) {
        out('  ' . yellow('⚠ ' . $warningCount . ' warnings, no errors'));
    } else {
        out('  ' . green('✓ All checks passed'));
    }
    out('');

    return ['error_count' => $errorCount, 'warning_count' => $warningCount];
}

/**
 * Scan theme template files for anti-patterns: DB access, module queries,
 * business logic, hardcoded branding, and unsafe raw output.
 */
function themeScanAntiPatterns(string $themeDir, array $scannedDirs): array
{
    $violations = [];

    // Patterns that indicate business logic / DB access in a theme
    $patterns = [
        '/\b(SELECT\s+[A-Z_`]\w*\s+FROM\s+\w+|INSERT\s+INTO\s+\w+|UPDATE\s+\w+\s+SET\s+\w+|DELETE\s+FROM\s+\w+|CREATE\s+TABLE\s+\w+|ALTER\s+TABLE\s+\w+|DROP\s+TABLE\s+\w+)\b/i' => 'Direct SQL query detected — themes must not access the database',
        '/\b(?:app\(\)\s*->\s*db|module\(\)\s*->\s*db|\$pdo|\$dbh)\b/i' => 'Direct database handle access — themes must not call app()->db()',
        '/\bquery\(|->query\(|->prepare\(/i' => 'Direct database query method call',
        '/\b(?:module\(\)\s*->\s*cap\s*\(|capability\s*::)/i' => 'Direct capability call — themes should not invoke capabilities directly',
        '/\b(?:authorize|is_allowed|can_access|has_permission)\b/i' => 'Authorization check in theme — belongs in handler/module layer',
        '/\b(?:tenant_id|tenant\(\)|app\(\)\s*->\s*tenant)\b/i' => 'Tenant resolution in theme — belongs in Kernel OS layer',
    ];

    foreach ($scannedDirs as $dir) {
        $fullDir = $themeDir . '/' . $dir;
        if (!is_dir($fullDir)) { continue; }

        $iter = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($fullDir, FilesystemIterator::SKIP_DOTS)
        );

        foreach ($iter as $finfo) {
            if (!$finfo->isFile()) { continue; }
            $ext = $finfo->getExtension();
            if (!in_array($ext, ['disyl', 'php', 'html', 'css', 'js'], true)) { continue; }

            $content = @file_get_contents($finfo->getPathname());
            if ($content === false || $content === '') { continue; }

            $relPath = str_replace($themeDir . '/', '', $finfo->getPathname());

            foreach ($patterns as $pattern => $description) {
                if (!preg_match($pattern, $content)) {
                    continue;
                }

                // Skip false positives
                if ($ext === 'css') {
                    continue; // CSS uses SELECT, FROM, JOIN as attribute selectors
                }
                if ($ext === 'js' && str_contains($pattern, 'SELECT')) {
                    continue; // JS may contain SELECT in DOM queries
                }
                // .disyl files with inline CSS style blocks
                if (str_contains($content, 'class="en-') || str_contains($content, '/* ──')) {
                    if (str_contains($pattern, 'FROM') || str_contains($pattern, 'SELECT')) {
                        continue; // Likely CSS embedded in template
                    }
                }

                $violations[] = "{$relPath}: {$description}";
                break; // One violation per file is enough
            }
        }
    }

    return $violations;
}

