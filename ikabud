    // ── routes ───────────────────────────────────────────────────
    case 'routes':
        banner();
        $routes = [
            'GET' => [
                '/' => 'pageHome',
                '/login' => 'pageLogin',
                '/auth/logout' => 'authLogout',
                '/api/v1/auth/logout' => 'authLogout',
