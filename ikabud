    echo {$shortPrefix}Render('pages/home.disyl', [
        'page_title' => '{$label}',
    ]);
}

// Example API handler (uncomment route in routes.php):
//
// /**
//  * POST /api/v1/{$id}/example
//  */
// function api{$funcPrefix}Example(array \$params = []): void
// {
//     header('Content-Type: application/json');
//     {$shortPrefix}Ctx()->requireAnyRole('admin');
//
//     \$input = {$shortPrefix}Input();
//     \$name = trim((string)(\$input['name'] ?? ''));
//     if (\$name === '') {
//         http_response_code(422);
//         echo json_encode(['ok' => false, 'error' => 'Name is required']);
//         return;
//     }
//
//     \$db = {$shortPrefix}Db();
//     \$db->prepare('INSERT INTO {$tablePrefix}items (name) VALUES (:name)')->execute([':name' => \$name]);
//
//     app()->events()->fire('{$id}.item.created', [
//         'id' => (int)\$db->lastInsertId(),
//         'name' => \$name,
//     ]);
//
//     echo json_encode(['ok' => true, 'id' => (int)\$db->lastInsertId()]);
// }
PHP;
        file_put_contents($modulePath . '/handlers.php', $handlersContent . "\n");
        out('  ' . green('✓') . ' create handlers.php');

        // ── helpers.php ──────────────────────────────────────────
        $helpersContent = <<<PHP
<?php
/**
 * {$label} Module — Helpers
 *
 * This file is auto-loaded when the module is enabled.
 * Scoped helper functions provide isolated access to module context,
 * database, input, and rendering. Register event listeners here too.
 *
 * @see docs/module-development-guide.md
 * @see docs/module-quickstart.md
 */

declare(strict_types=1);

// ── Scoped Context Helpers ───────────────────────────────────────

function {$shortPrefix}Ctx(): \Ikabud\Kernel\Contracts\ModuleContext
{
    \$ctx = module('{$id}');
    if (!\$ctx) {
        throw new \RuntimeException('{$label} module context unavailable');
    }
    return \$ctx;
}

function {$shortPrefix}Db(): \Ikabud\Kernel\Contracts\ModuleDB
{
    return {$shortPrefix}Ctx()->db();
}

function {$shortPrefix}Input(?string \$key = null, mixed \$default = null): mixed
{
    return {$shortPrefix}Ctx()->input(\$key, \$default);
}

function {$shortPrefix}Render(string \$template, array \$context = []): string
{
    \$resolved = str_starts_with(\$template, 'modules/{$id}/')
        ? \$template
        : 'modules/{$id}/' . ltrim(\$template, '/');

    return {$shortPrefix}Ctx()->render(\$resolved, kernelPrepareRenderContext(\$resolved, \$context));
}

// ── Event Listeners ──────────────────────────────────────────────
// Register inter-module event listeners here. Examples:
//
// app()->events()->listen('order.placed', function (array \$payload, string \$event) {
//     // React to events from other modules
// }, 10, '{$id}');
PHP;
        file_put_contents($modulePath . '/helpers.php', $helpersContent . "\n");
        out('  ' . green('✓') . ' create helpers.php');

        // ── Initial migration ────────────────────────────────────
        $migrationContent = <<<SQL
-- {$label} Module — Initial Schema
-- Created: DATE_PLACEHOLDER

-- Add your tables here. Example:
-- CREATE TABLE IF NOT EXISTS {$tablePrefix}items (
--     id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
--     name VARCHAR(255) NOT NULL,
--     is_active TINYINT(1) NOT NULL DEFAULT 1,
--     created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
--     updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
-- ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
--
-- Then add '{$tablePrefix}items' to owns_tables in module.json.
SQL;
        $migrationContent = str_replace('DATE_PLACEHOLDER', date('Y-m-d'), $migrationContent);
        file_put_contents($modulePath . '/database/migrations/001_initial.sql', $migrationContent . "\n");
        out('  ' . green('✓') . ' create database/migrations/001_initial.sql');

        // ── Template: home page ──────────────────────────────────
        $templateContent = <<<DISYL
{extends "layouts/app.disyl"}

{block head}
<style>
    .{$id}-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
