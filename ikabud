            if (!is_string($content)) continue;

            // Check for ikb_entity_list source usage
            if (preg_match_all('/\bikb_entity_list\b[^}]*\bsource\s*=\s*["\']([^"\']+)["\']/', $content, $srcMatches)) {
                foreach ($srcMatches[1] as $srcVal) {
                    // Check if source is in this module's entity_sources
                    $allowedSources = $moduleEntitySources[$moduleId] ?? [];
                    if ($allowedSources !== [] && !in_array($srcVal, $allowedSources, true)) {
                        // Source may be from kernel or CMS (common cross-module sources)
                        $kernelSources = $moduleEntitySources['kernel'] ?? $moduleEntitySources['cms'] ?? [];
                        if (!in_array($srcVal, $kernelSources, true)) {
                            $templateViolations[] = [
                                'file' => $rel,
                                'source' => $srcVal,
                                'module' => $moduleId,
                            ];
                        }
                    }
                }
            }
        }
        $totalChecks++;

        if (empty($templateViolations)) {
            out('    ' . green('✓') . ' No template entity source violations');
        } else {
            foreach ($templateViolations as $v) {
                $failCount++;
                out('    ' . red('✗') . ' ' . $v['file']);
                out('      ' . yellow("Uses entity source '{$v['source']}' not declared in module's entity_sources"));
            }
        }

        // Summary
        out('');
        if ($failCount === 0) {
            out('  ' . green('✓') . " All architecture checks passed ({$totalChecks} checks)");
            out('');
        } else {
            out('  ' . red("✗ {$failCount} architecture violation(s) found"));
            out('  ' . yellow('Fix violations before merge. Use module:validate for per-module details.'));
            out('');
            exit(1);
        }
        break;

    case 'module:check-boundaries':
        banner();
        $scanExtensions = ['php'];
        $allowedFileIoModuleIds = ['gui-settings'];
        $forbiddenPatterns = [
            '/\$_SESSION\b/' => 'Direct $_SESSION access is forbidden. Use module()->... session/service API.',
            '/\$_COOKIE\b/'  => 'Direct $_COOKIE access is forbidden. Use kernel context accessors.',
            '/\$_REQUEST\b/' => 'Direct $_REQUEST access is forbidden. Use module()->input().',
            '/\$_GET\b/'     => 'Direct $_GET access is forbidden. Use module()->input().',
            '/\$_POST\b/'    => 'Direct $_POST access is forbidden. Use module()->input().',
            '/\$_FILES\b/'   => 'Direct $_FILES access is forbidden. Use a storage/upload service.',
            '/\$_ENV\b/'     => 'Direct $_ENV access is forbidden in modules.',
            '/\$GLOBALS\b/'  => 'Direct $GLOBALS access is forbidden in modules.',
            '/app\(\)\s*->\s*db\s*\(/i' => 'Raw app()->db() is forbidden in modules. Use module()->db().',
            '/\b(file_put_contents|fopen|fwrite|file_get_contents|unlink|rename|copy|mkdir|rmdir|chmod|chown|touch)\s*\(/i'
                => 'Raw file IO is forbidden in modules. Use a storage service/gateway.',
        ];

        $ignorePathMarkers = ['/vendor/', '/node_modules/'];
        $root = BASE_PATH . '/modules';
        $violations = [];

        $iterator = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS)
        );

        foreach ($iterator as $fileInfo) {
            /** @var SplFileInfo $fileInfo */
            if (!$fileInfo->isFile()) {
                continue;
            }

            $path = (string) $fileInfo->getPathname();
            $ext = strtolower((string) $fileInfo->getExtension());
            if (!in_array($ext, $scanExtensions, true)) {
                continue;
            }

            $skip = false;
            foreach ($ignorePathMarkers as $marker) {
                if (str_contains($path, $marker)) {
                    $skip = true;
                    break;
                }
            }
            if ($skip) {
                continue;
            }

            $content = @file_get_contents($path);
            if (!is_string($content) || $content === '') {
                continue;
            }

            // Determine module id from path: modules/.../{id}/...
            $rel = str_replace(BASE_PATH . '/', '', $path);
            $moduleId = null;
            if (preg_match('#^modules/(?:.+/)?([^/]+)/#', $rel, $mm)) {
                $moduleId = $mm[1];
            }

            $lines = preg_split('/\R/', $content) ?: [];
            foreach ($lines as $lineNo => $line) {
                $trimmedLine = trim($line);
                if ($trimmedLine === '' || str_starts_with($trimmedLine, '//') || str_starts_with($trimmedLine, '/*') || str_starts_with($trimmedLine, '*') || str_starts_with($trimmedLine, '*/')) {
                    continue;
                }

                foreach ($forbiddenPatterns as $regex => $message) {
                    if (preg_match($regex, $line)) {
                        // Pragmatic allowlist: gui-settings is filesystem-backed
                        if ($moduleId && in_array($moduleId, $allowedFileIoModuleIds, true)) {
                            if ($regex === '/\b(file_put_contents|fopen|fwrite|file_get_contents|unlink|rename|copy|mkdir|rmdir|chmod|chown|touch)\s*\(/i') {
                                continue;
                            }
                        }

                        // Pragmatic allowlist: module.json reads are permitted (module manifests)
                        if ($regex === '/\b(file_put_contents|fopen|fwrite|file_get_contents|unlink|rename|copy|mkdir|rmdir|chmod|chown|touch)\s*\(/i') {
                            if (str_contains($line, "'/module.json'") || str_contains($line, '"/module.json"') || str_contains($line, '/module.json')) {
                                continue;
                            }
                        }

                        // Pragmatic allowlist: SMS gateway may fall back to app()->db() for non-module call sites
                        if ($regex === '/app\(\)\s*->\s*db\s*\(/i' && $moduleId === 'sms') {
                            if (str_contains($rel, 'modules/sms/helpers/sms-gateway.php')) {
                                continue;
                            }
                        }

                        $violations[] = [
                            'file' => str_replace(BASE_PATH . '/', '', $path),
                            'line' => $lineNo + 1,
                            'message' => $message,
                            'snippet' => trim($line),
                        ];
                    }
                }
            }
        }

        if (empty($violations)) {
            out('  ' . green('✓') . ' No boundary violations found in modules/.');
            out('');
            break;
        }

        out('  ' . red('✗ Boundary violations found: ' . count($violations)));
        out('');
        foreach ($violations as $v) {
            out('  ' . red('•') . ' ' . $v['file'] . ':' . $v['line']);
            out('    ' . yellow($v['message']));
            out('    ' . dim($v['snippet']));
        }
        out('');
        out('  ' . yellow('Fix violations before merge. This command is intended for CI gating.'));
        out('');
        exit(1);

    // ── event:list ───────────────────────────────────────────────
    case 'event:list':
        banner();
        // Load module helpers to register events
        foreach (getEnabledModules() as $m) {
            $helpersFile = ($m['_path'] ?? '') . '/helpers.php';
            if (is_file($helpersFile)) {
                require_once $helpersFile;
            }
        }
        $events = app()->events()->registeredEvents();
        if (empty($events)) {
            out('  ' . dim('No event listeners registered.'));
        } else {
            out('  ' . bold('Registered event listeners:'));
            foreach ($events as $event) {
                $count = app()->events()->listenerCount($event);
                out('  ' . cyan($event) . dim(" ({$count} listener" . ($count !== 1 ? 's' : '') . ')'));
            }
        }
        out('');
        break;

    // ── event:trace ──────────────────────────────────────────────
    case 'event:trace':
        $clean = paramsWithoutFlags($params);
        $eventName = $clean[0] ?? '';
        if ($eventName === '') {
            out(red('  ✗ Event name required.'));
            out('  Usage: php ikabud event:trace <event-name>');
            out('  Example: php ikabud event:trace ecommerce.order.paid');
            exit(1);
        }

        banner();
        out('  ' . bold('Event Trace: ') . cyan($eventName));
        out('');

        // Load module helpers for listener registration
        foreach (getEnabledModules() as $m) {
            $helpersFile = ($m['_path'] ?? '') . '/helpers.php';
            if (is_file($helpersFile)) {
                require_once $helpersFile;
            }
        }

        // ── 1. Listeners ──────────────────────────────────────────
        out('  ' . bold('Listeners'));

        // Get EventBus internal listeners via reflection
        $bus = app()->events();
        $refProp = new ReflectionProperty($bus, 'listeners');
        $refProp->setAccessible(true);
        $allListeners = $refProp->getValue($bus);

        $matched = [];
        // Exact match
        if (isset($allListeners[$eventName])) {
            foreach ($allListeners[$eventName] as $entry) {
                $matched[] = [
                    'module'   => (string)($entry['module'] ?? ''),
                    'priority' => (int)($entry['priority'] ?? 10),
                    'pattern'  => $eventName,
                ];
            }
        }
        // Wildcard matches
        foreach ($allListeners as $pattern => $entries) {
            if (!str_contains($pattern, '*')) continue;
            $regex = '/^' . str_replace(['.', '*'], ['\\.', '[^.]*'], $pattern) . '$/';
            if (preg_match($regex, $eventName)) {
                foreach ($entries as $entry) {
                    $matched[] = [
                        'module'   => (string)($entry['module'] ?? ''),
                        'priority' => (int)($entry['priority'] ?? 10),
                        'pattern'  => $pattern,
                    ];
                }
            }
        }

        // Sort by priority DESC
        usort($matched, fn($a, $b) => $b['priority'] <=> $a['priority']);

        if (empty($matched)) {
            out('    ' . dim('none'));
        } else {
            foreach ($matched as $l) {
                $modLabel = $l['module'] !== '' ? cyan($l['module']) : dim('(anonymous)');
                $patLabel = $l['pattern'] !== $eventName ? dim(' via ' . $l['pattern']) : '';
                out('    ' . green('→') . ' ' . $modLabel . '  priority=' . $l['priority'] . $patLabel);
            }
        }
        out('');

        // ── 2. Emitters ───────────────────────────────────────────
        out('  ' . bold('Emitters') . dim(' (who fires this event)'));

        // Search module.json events declarations
        $mods = discoverModules();
        $declaredEmitters = [];
        foreach ($mods as $mid => $manifest) {
            foreach ((array)($manifest['events'] ?? []) as $ev) {
                if ((string)$ev === $eventName) {
                    $declaredEmitters[] = $mid;
                }
            }
        }

        // Search code for fire('event-name...) / fireEvent('event-name...) / fireDeferred('event-name...)
        $codeEmitters = [];
        $escapedName = preg_quote($eventName, '/');
        $firePattern = "/(->fire|->fireEvent|->fireDeferred)\(\s*['\"]" . $escapedName . "['\"]/";

        $root = BASE_PATH . '/modules';
        $it = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS)
        );
        foreach ($it as $f) {
            /** @var SplFileInfo $f */
            if (!$f->isFile() || strtolower($f->getExtension()) !== 'php') continue;
            $path = (string)$f->getRealPath();
            if (str_contains($path, '/vendor/') || str_contains($path, '/node_modules/')) continue;
            $content = @file_get_contents($path);
            if (!is_string($content)) continue;
            if (preg_match($firePattern, $content)) {
                $rel = str_replace(BASE_PATH . '/', '', $path);
                $mid = null;
                if (preg_match('#^modules/(?:.+/)?([^/]+)/#', $rel, $mm)) {
                    $mid = $mm[1];
                }
                $codeEmitters[] = ['module' => $mid ?? 'unknown', 'file' => $rel];
            }
        }

        if (empty($declaredEmitters) && empty($codeEmitters)) {
            out('    ' . dim('none found'));
        } else {
            if (!empty($declaredEmitters)) {
                out('    ' . dim('declared in module.json:'));
                foreach ($declaredEmitters as $mid) {
                    out('      ' . cyan($mid));
                }
            }
            if (!empty($codeEmitters)) {
                out('    ' . dim('found in code:'));
                foreach ($codeEmitters as $ce) {
                    out('      ' . cyan($ce['module']) . '  ' . dim($ce['file']));
                }
            }
        }
        out('');

        // ── 3. Flow summary ───────────────────────────────────────
        out('  ' . bold('Flow'));
        $emitterNames = array_unique(array_merge($declaredEmitters, array_column($codeEmitters, 'module')));
        if (!empty($emitterNames) && !empty($matched)) {
            $listenerNames = array_unique(array_column($matched, 'module'));
            foreach ($emitterNames as $e) {
                foreach ($listenerNames as $l) {
                    if ($l === '' || $l === $e) continue;
                    out('    ' . cyan($e) . dim(' --[') . $eventName . dim(']--> ') . cyan($l));
                }
            }
        } else {
            out('    ' . dim('incomplete — need both emitters and listeners to draw flow'));
        }
        out('');
        break;

    // ── trigger:trace ────────────────────────────────────────────────
    case 'trigger:trace':
        $clean = paramsWithoutFlags($params);
        $triggerName = $clean[0] ?? '';
        if ($triggerName === '') {
            out(red('  ✗ Trigger name or event name required.'));
            out('  Usage: php ikabud trigger:trace <event-name>');
            out('  Example: php ikabud trigger:trace cms.content.published');
            exit(1);
        }

        banner();
        out('  ' . bold('Trigger Trace: ') . cyan($triggerName));
        out('');

        // Load module helpers for trigger registration
        foreach (getEnabledModules() as $m) {
            $helpersFile = ($m['_path'] ?? '') . '/helpers.php';
            if (is_file($helpersFile)) {
                require_once $helpersFile;
            }
        }

        // ── 1. Event subscriptions (workflow auto-start) ─────────
        out('  ' . bold('Workflow Subscriptions'));
        try {
            $stmt = app()->db()->prepare(
                'SELECT ws.*, wd.initial_state, wd.states_json FROM workflow_subscriptions ws '
                . 'LEFT JOIN workflow_definitions wd ON wd.workflow_key = ws.workflow_key AND wd.module = ws.module '
                . 'WHERE ws.event_id = :evt AND ws.is_active = 1'
            );
            $stmt->execute([':evt' => $triggerName]);
            $subs = $stmt->fetchAll(\PDO::FETCH_ASSOC);

            if (empty($subs)) {
                out('    ' . dim('none — no workflow subscribes to this event'));
            } else {
                foreach ($subs as $sub) {
                    $wf = (string)($sub['workflow_key'] ?? '?');
                    $mod = (string)($sub['module'] ?? '?');
                    $filter = json_decode((string)($sub['filter_json'] ?? 'null'), true);
                    $filterStr = is_array($filter) && $filter !== [] ? ' filter=' . json_encode($filter) : '';
                    out('    ' . green('→') . ' ' . cyan($mod) . dim('/') . yellow($wf) . $filterStr);
                }
            }
        } catch (\Throwable $e) {
            out('    ' . red('error: ' . $e->getMessage()));
        }
        out('');

        // ── 2. Workflow runs triggered by this event ─────────────
        out('  ' . bold('Recent Runs'));
        try {
            $stmt = app()->db()->prepare(
                'SELECT wr.id, wr.workflow_key, wr.module, wr.status, wr.entity_type, wr.entity_id, '
                . 'wr.created_at, wr.finished_at, wr.cancel_reason '
                . 'FROM workflow_runs wr '
                . 'INNER JOIN workflow_subscriptions ws ON ws.workflow_key = wr.workflow_key AND ws.module = wr.module '
                . 'WHERE ws.event_id = :evt '
                . 'ORDER BY wr.created_at DESC LIMIT 20'
            );
            $stmt->execute([':evt' => $triggerName]);
            $runs = $stmt->fetchAll(\PDO::FETCH_ASSOC);

            if (empty($runs)) {
                out('    ' . dim('none'));
            } else {
                foreach ($runs as $run) {
                    $status = $run['status'] ?? '?';
                    $statusColor = match ($status) {
                        'completed' => green('completed'),
                        'running' => yellow('running'),
                        'failed' => red('failed'),
                        'cancelled' => dim('cancelled'),
                        default => $status,
                    };
                    $entity = $run['entity_type'] && $run['entity_id']
                        ? dim(' [' . $run['entity_type'] . '#' . $run['entity_id'] . ']') : '';
                    out('    #' . $run['id'] . ' ' . $statusColor . ' ' . cyan($run['workflow_key']) . $entity);
                }
            }
        } catch (\Throwable $e) {
            out('    ' . dim('(no workflow runs table — workflow engine not installed)'));
        }
        out('');
        break;

    // ── routes ───────────────────────────────────────────────────
    case 'routes':
        banner();
        $routes = [
            'GET' => [
                '/' => 'pageHome',
                '/login' => 'pageLogin',
                '/auth/logout' => 'authLogout',
                '/api/v1/auth/logout' => 'authLogout',
                '/api/v1/health' => 'apiHealth',
                '/api/v1/me' => 'apiMe',
                '/api/v1/audit-log' => 'apiAuditLog',
                '/admin/modules' => 'pageAdminModules',
                '/api/v1/admin/modules' => 'apiListModules',
            ],
            'POST' => [
                '/auth/login' => 'authLogin',
                '/api/v1/auth/login' => 'authLogin',
                '/api/v1/auth/refresh' => 'authRefresh',
                '/api/v1/admin/modules/install' => 'apiInstallModule',
                '/api/v1/admin/modules/enable' => 'apiEnableModule',
                '/api/v1/admin/modules/disable' => 'apiDisableModule',
            ],
            'PUT' => [],
            'DELETE' => [],
        ];
        $routes = loadModuleRoutes($routes);

        $total = 0;
        foreach (['GET', 'POST', 'PUT', 'DELETE'] as $method) {
            $methodRoutes = $routes[$method] ?? [];
            if (empty($methodRoutes)) continue;
            out('  ' . bold($method));
            foreach ($methodRoutes as $pattern => $handler) {
                $source = str_contains($handler, ':') ? dim('(module)') : dim('(kernel)');
                out("    {$pattern}  →  {$handler} {$source}");
                $total++;
            }
            out('');
        }
        out("  Total: {$total} route(s)");
        out('');
        break;

    // ── openapi:generate ─────────────────────────────────────────
    case 'openapi:generate':
        banner();
        out('  ' . bold('OpenAPI 3.0 Spec Generator'));
        out('');

        // Load route maps
        $openApiRoutes = kernelCoreRoutes();
        $openApiRoutes = loadModuleRoutes($openApiRoutes);

        $gen = new \Ikabud\Kernel\Services\OpenApiGenerator(
            $openApiRoutes,
            trim((string)(getFlagValue('--title=') ?? 'Ikabud Platform API')),
            trim((string)(getFlagValue('--version=') ?? '1.0.0'))
        );

        $outFile = getFlagValue('--output=');
        $spec = $gen->toJson();

        if ($outFile !== null) {
            $outFile = trim($outFile);
            $dir = dirname($outFile);
            if ($dir !== '' && !is_dir($dir)) {
                mkdir($dir, 0755, true);
            }
            file_put_contents($outFile, $spec);
            out('  ' . green('✓') . ' Spec written to ' . bold($outFile));
            $decoded = json_decode($spec, true);
            $pathCount = is_array($decoded['paths'] ?? null) ? count($decoded['paths']) : 0;
            out('  Paths: ' . cyan((string)$pathCount));
        } else {
            echo $spec . "\n";
        }
        out('');
        break;

    // ── tinker ───────────────────────────────────────────────────
    case 'tinker':
        $sql = implode(' ', $params);
        if ($sql === '') {
            out(red('  ✗ SQL query required.'));
            out('  Usage: php ikabud tinker "SELECT * FROM users LIMIT 5"');
            exit(1);
        }
        try {
            $stmt = app()->db()->query($sql);
            $rows = $stmt->fetchAll(PDO::FETCH_ASSOC);
            if (empty($rows)) {
                out(dim('  (empty result set)'));
            } else {
                // Print as simple table
                $cols = array_keys($rows[0]);
                $widths = [];
                foreach ($cols as $c) {
                    $widths[$c] = strlen((string) $c);
                }
                foreach ($rows as $row) {
                    foreach ($cols as $c) {
                        $widths[$c] = max($widths[$c], strlen((string) ($row[$c] ?? 'NULL')));
                    }
                }
                // Cap at 40
                foreach ($widths as &$w) { $w = min($w, 40); }
                unset($w);

                // Header
                $header = '';
                $sep = '';
                foreach ($cols as $c) {
                    $header .= str_pad((string) $c, $widths[$c] + 2);
                    $sep .= str_repeat('─', $widths[$c] + 2);
                }
                out('  ' . bold($header));
                out('  ' . $sep);

                foreach ($rows as $row) {
                    $line = '';
                    foreach ($cols as $c) {
                        $val = $row[$c] ?? 'NULL';
                        $val = (string) $val;
                        if (strlen($val) > 40) $val = substr($val, 0, 37) . '...';
                        $line .= str_pad($val, $widths[$c] + 2);
                    }
                    out('  ' . $line);
                }
                out('');
                out(dim('  ' . count($rows) . ' row(s)'));
            }
        } catch (\Throwable $e) {
            out(red('  ✗ SQL error: ') . $e->getMessage());
            exit(1);
        }
        break;

    // ── platform:describe ─────────────────────────────────────────
    case 'platform:describe':
        loadModuleRoutes(['GET' => [], 'POST' => [], 'PUT' => [], 'DELETE' => []]);

        $platformId = app()->platformIdentity();

        // Modules
        $allMods = discoverModules();
        $enabledMods = [];
        $disabledMods = [];
        foreach ($allMods as $m) {
            $entry = [
                'id' => (string)($m['id'] ?? ''),
                'name' => (string)($m['name'] ?? $m['id'] ?? ''),
                'version' => (string)($m['version'] ?? '0.0.0'),
                'status' => $m['status'] ?? null,
                'requires_kernel' => $m['requires_kernel'] ?? null,
            ];
            if (!empty($m['_enabled'])) {
                $enabledMods[] = $entry;
            } else {
                $disabledMods[] = $entry;
            }
        }

        // Capabilities
        $capIds = app()->capabilities()->capabilityIds();
        $capEntries = [];
        foreach ($capIds as $cid) {
            $provs = app()->capabilities()->providers($cid);
            $providerNames = [];
            foreach ($provs as $p) {
                $providerNames[] = (string)($p['provider'] ?? '');
            }
            $capEntries[] = [
                'id' => $cid,
                'providers' => $providerNames,
                'effective_schema_mode' => app()->cap()->resolveSchemaMode($cid),
            ];
        }

        // Events
        $eventsCount = 0;
        try {
            $stmt = app()->db()->query('SELECT COUNT(*) FROM kernel_events');
            $eventsCount = $stmt ? (int)$stmt->fetchColumn() : 0;
        } catch (Throwable $e) {
        }

        // Triggers
        $triggersTotal = 0;
        $triggersEnabled = 0;
        try {
            $stmt = app()->db()->query('SELECT COUNT(*) as total, SUM(is_enabled) as enabled FROM kernel_event_triggers');
            $row = $stmt ? $stmt->fetch(PDO::FETCH_ASSOC) : null;
            if (is_array($row)) {
                $triggersTotal = (int)($row['total'] ?? 0);
                $triggersEnabled = (int)($row['enabled'] ?? 0);
            }
        } catch (Throwable $e) {
        }

        // Health
        $health = app()->cap()->healthAll();
        $healthSummary = ['total_calls' => 0, 'total_errors' => 0, 'breakers_open' => 0];
        foreach ($health as $h) {
            $healthSummary['total_calls'] += (int)($h['count'] ?? 0);
            $healthSummary['total_errors'] += (int)($h['errors'] ?? 0);
            if (!empty($h['breaker_open'])) {
                $healthSummary['breakers_open']++;
            }
        }

        $manifest = [
            'platform' => $platformId,
            'modules' => [
                'enabled_count' => count($enabledMods),
                'disabled_count' => count($disabledMods),
                'enabled' => $enabledMods,
                'disabled' => $disabledMods,
            ],
            'capabilities' => [
                'count' => count($capEntries),
                'entries' => $capEntries,
            ],
            'events' => ['count' => $eventsCount],
            'triggers' => ['total' => $triggersTotal, 'enabled' => $triggersEnabled],
            'health' => $healthSummary,
            'generated_at' => gmdate('c'),
        ];

        echo json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
        break;

    // ── work:queue ───────────────────────────────────────────────
    case 'work:queue':
        $queue = paramsWithoutFlags($params)[0] ?? 'default';
        $sleep = (int)(getFlagValue('--sleep=') ?? 3);
        $once = hasFlag('--once');

        out(bold('  Queue Worker'));
        out('  Queue: ' . cyan($queue) . '  Sleep: ' . cyan((string)$sleep . 's') . ($once ? '  ' . yellow('(single run)') : ''));
        out('  Press Ctrl+C to stop.');
        out('');

