#!/usr/bin/env php
<?php
/**
 * Ikabud Kernel — CLI Tool
 * 
 * Commands:
 *   php ikabud make:module <name>        Scaffold a new module
 *   php ikabud make:migration <mod> <n>  Create next numbered migration
 *   php ikabud make:handler <mod> <fn>   Add handler + route to module
 *   php ikabud migrate                   Run all pending migrations
 *   php ikabud migrate <module>          Run pending migrations for one module
 *   php ikabud migrate:control           Run control-plane migrations (CONTROL DB)
 *   php ikabud migrate:status            Show migration status
 *   php ikabud migrate:rollback <module> Rollback last batch for a module
 *   php ikabud module:list               List all modules and their status
 *   php ikabud module:enable <id>        Enable a module
 *   php ikabud module:disable <id>       Disable a module
 *   php ikabud module:check-boundaries   Enforce module boundary rules
 *   php ikabud capability:validate       Validate capability versions and schemas
 *   php ikabud event:list                List registered event listeners
 *   php ikabud routes                    List all registered routes
 *   php ikabud disyl:lint [path]         Lint templates for errors
 *   php ikabud tinker <sql>              Run a raw SQL query
 * 
 * @package Ikabud\Kernel
 * @version 1.0.0
 */

declare(strict_types=1);

// Ensure CLI only
if (php_sapi_name() !== 'cli') {
    echo "CLI only.\n";
    exit(1);
}

require_once __DIR__ . '/bootstrap.php';
require_once __DIR__ . '/src/helpers/module-manager.php';

use Ikabud\Kernel\Database\MigrationRunner;
use Ikabud\Kernel\Capabilities\CapabilityTestRunner;
use Ikabud\Kernel\Crypto;

$args = array_slice($argv, 1);
$command = $args[0] ?? 'help';
$params = array_slice($args, 1);

function hasFlag(string $flag): bool
{
    global $params;
    return in_array($flag, $params, true);
}

function paramsWithoutFlags(array $params): array
{
    return array_values(array_filter($params, fn($p) => !is_string($p) || !str_starts_with($p, '--')));
}

function getFlagValue(string $prefix): ?string
{
    global $params;
    foreach ($params as $p) {
        if (!is_string($p)) continue;
        if (str_starts_with($p, $prefix)) {
            return substr($p, strlen($prefix));
        }
    }
    return null;
}

// ── Styling helpers ──────────────────────────────────────────────────

function out(string $msg): void { echo $msg . "\n"; }
function green(string $msg): string { return "\033[32m{$msg}\033[0m"; }
function red(string $msg): string { return "\033[31m{$msg}\033[0m"; }
function yellow(string $msg): string { return "\033[33m{$msg}\033[0m"; }
function cyan(string $msg): string { return "\033[36m{$msg}\033[0m"; }
function bold(string $msg): string { return "\033[1m{$msg}\033[0m"; }
function dim(string $msg): string { return "\033[2m{$msg}\033[0m"; }

function banner(): void
{
    $v = \Ikabud\Kernel\App::KERNEL_VERSION;
    out('');
    out(bold('  ╔══════════════════════════════════════╗'));
    out(bold('  ║') . cyan('  Ikabud Kernel CLI ') . dim("v{$v}") . bold('          ║'));
    out(bold('  ╚══════════════════════════════════════╝'));
    out('');
}

// ── Commands ─────────────────────────────────────────────────────────

switch ($command) {

    // ── help ──────────────────────────────────────────────────────
    case 'help':
    case '--help':
    case '-h':
        banner();
        out('  ' . bold('Usage:') . ' php ikabud <command> [arguments]');
        out('');
        out('  ' . bold('Scaffolding'));
        out('    ' . green('make:module') . ' <name>          Create a new module skeleton');
        out('    ' . green('make:migration') . ' <mod> <name>  Create next numbered migration');
        out('    ' . green('make:handler') . ' <mod> <fn> [M]  Add handler + route to a module');
        out('');
        out('  ' . bold('Migrations'));
        out('    ' . green('migrate') . '                     Run all pending migrations');
        out('    ' . green('migrate') . ' <module>            Run pending for one module');
        out('    ' . green('migrate:control') . '            Run control-plane migrations (CONTROL DB)');
        out('    ' . green('migrate:status') . '              Show migration status');
        out('    ' . green('migrate:rollback') . ' <module>   Rollback last batch');
        out('');

        out('  ' . bold('Tenancy (control plane)'));
        out('    ' . green('tenant:list') . '                 List tenants');
        out('    ' . green('tenant:create') . ' <key> <domain> [--entry=<module_id>]');
        out('    ' . green('tenant:domain:add') . ' <tenant_id> <domain>');
        out('    ' . green('tenant:domain:remove') . ' <tenant_id> <domain>');
        out('    ' . green('tenant:db:set') . ' <tenant_id> --host=.. --name=.. --user=.. [--port=3306] [--driver=mysql] [--charset=utf8mb4] [--pass=..]');
        out('    ' . green('tenant:db:check') . ' <tenant_id>    Show DB config + pass status');
        out('    ' . green('tenant:provision') . ' <tenant_id> [--skip-db-create] [--admin-user=..] [--admin-pass=..] [--admin-name=..]');
        out('    ' . green('tenant:verify') . ' <tenant_id>      Health-check a tenant (DB, tables, isolation, admin user)');
        out('');
        out('  ' . bold('Modules'));
        out('    ' . green('module:list') . '                 List all modules');
        out('    ' . green('module:enable') . ' <id>          Enable a module');
        out('    ' . green('module:disable') . ' <id>         Disable a module');
        out('    ' . green('module:pack') . ' <id> [zip]     Create an installable module zip');
        out('    ' . green('module:uninstall') . ' <id>       Remove module files and disable it');
        out('    ' . green('module:check-boundaries') . '     Validate module boundary rules');
        out('    ' . green('module:graph') . ' [id]           Dependency graph + impact analysis');
        out('');
        out('  ' . bold('Capabilities'));
        out('    ' . green('capability:list') . '             List capabilities + providers + origins');
        out('    ' . green('capability:call') . ' <id> "<json>"  Call a capability');
        out('    ' . green('capability:validate') . '         Validate versions + schemas');
        out('');
        out('  ' . bold('Platform'));
        out('    ' . green('platform:describe') . '           Full platform manifest (JSON)');
        out('');
        out('  ' . bold('Templates'));
        out('    ' . green('disyl:lint') . ' [path]           Lint templates for syntax errors');
        out('    ' . green('disyl:lint') . ' --verbose        Show passing files too');
        out('');
        out('  ' . bold('Debug'));
        out('    ' . green('event:list') . '                  List registered event listeners');
        out('    ' . green('routes') . '                      List all routes');
        out('    ' . green('tinker') . ' "<sql>"              Run a raw SQL query');
        out('');
        break;

    // ── migrate:control ───────────────────────────────────────────
    case 'migrate:control':
        banner();
        try {
            $runner = new MigrationRunner(app()->controlDb());
            out('  Running control-plane migrations...');
            out('');
            $executed = $runner->migrate('_control');
            if (empty($executed)) {
                out('  ' . dim('Nothing to migrate.'));
            } else {
                foreach ($executed as $f) {
                    out('  ' . green('✓') . " {$f}");
                }
                out('');
                out('  ' . green('✓') . bold(' ' . count($executed) . ' migration(s) executed.'));
            }
        } catch (\Throwable $e) {
            out('  ' . red('✗ Migration failed: ') . $e->getMessage());
            exit(1);
        }
        out('');
        break;

    // ── tenant:list ───────────────────────────────────────────────
    case 'tenant:list':
        banner();
        try {
            $pdo = app()->controlDb();

            $tStmt = $pdo->query('SELECT id, tenant_key, status, entry_module_id FROM kernel_tenants ORDER BY id DESC');
            $tenants = $tStmt ? ($tStmt->fetchAll(PDO::FETCH_ASSOC) ?: []) : [];

            $dStmt = $pdo->query('SELECT tenant_id, domain FROM kernel_tenant_domains ORDER BY tenant_id ASC, domain ASC');
            $domains = $dStmt ? ($dStmt->fetchAll(PDO::FETCH_ASSOC) ?: []) : [];
            $domainsByTenant = [];
            foreach ($domains as $d) {
                if (!is_array($d)) continue;
                $tid = (int)($d['tenant_id'] ?? 0);
                $dom = trim((string)($d['domain'] ?? ''));
                if ($tid <= 0 || $dom === '') continue;
                if (!isset($domainsByTenant[$tid])) $domainsByTenant[$tid] = [];
                $domainsByTenant[$tid][] = $dom;
            }

            if (empty($tenants)) {
                out('  ' . dim('No tenants found.'));
                out('');
                break;
            }

            out('  ' . bold('Tenants'));
            out('');
            foreach ($tenants as $t) {
                if (!is_array($t)) continue;
                $tid = (int)($t['id'] ?? 0);
                $key = (string)($t['tenant_key'] ?? '');
                $status = (string)($t['status'] ?? 'active');
                $entry = $t['entry_module_id'] !== null ? (string)$t['entry_module_id'] : '';
                $doms = $domainsByTenant[$tid] ?? [];

                out('  ' . cyan('#' . $tid) . '  ' . bold($key) . '  ' . dim($status) . ($entry !== '' ? ('  ' . dim('entry=') . $entry) : ''));
                if (!empty($doms)) out('      ' . dim('domains: ') . implode(', ', $doms));
            }
            out('');
        } catch (\Throwable $e) {
            out('  ' . red('✗ Failed: ') . $e->getMessage());
            exit(1);
        }
        break;

    // ── tenant:create ─────────────────────────────────────────────
    case 'tenant:create':
        $clean = paramsWithoutFlags($params);
        $tenantKey = strtolower(trim((string)($clean[0] ?? '')));
        $domain = strtolower(trim((string)($clean[1] ?? '')));
        $entryModuleId = trim((string)(getFlagValue('--entry=') ?? ''));

        banner();
        if ($tenantKey === '' || $domain === '') {
            out('  ' . red('✗ Usage: ') . 'php ikabud tenant:create <key> <domain> [--entry=<module_id>]');
            out('');
            exit(1);
        }
        if (!preg_match('/^[a-z0-9][a-z0-9\-]{1,78}[a-z0-9]$/', $tenantKey)) {
            out('  ' . red('✗ Invalid tenant key.'));
            out('  ' . dim('Expected: lowercase letters/numbers and hyphens, 3-80 chars, must start/end with alnum.'));
            out('');
            exit(1);
        }
        if (!preg_match('/^[a-z0-9][a-z0-9\.\-]{1,253}[a-z0-9]$/', $domain)) {
            out('  ' . red('✗ Invalid domain.'));
            out('');
            exit(1);
        }
        if ($entryModuleId !== '' && !preg_match('/^[a-z0-9_\-\.]{1,100}$/i', $entryModuleId)) {
            out('  ' . red('✗ Invalid entry module id.'));
            out('');
            exit(1);
        }

        try {
            $pdo = app()->controlDb();
            $pdo->beginTransaction();

            $stmt = $pdo->prepare('INSERT INTO kernel_tenants (tenant_key, status, entry_module_id) VALUES (:k, :s, :e)');
            $stmt->execute([
                ':k' => $tenantKey,
                ':s' => 'active',
                ':e' => ($entryModuleId !== '' ? $entryModuleId : null),
            ]);
            $tenantId = (int)$pdo->lastInsertId();
            if ($tenantId <= 0) {
                throw new \RuntimeException('Failed to create tenant (no id returned).');
            }

            $stmt = $pdo->prepare('INSERT INTO kernel_tenant_domains (tenant_id, domain) VALUES (:tid, :d)');
            $stmt->execute([':tid' => $tenantId, ':d' => $domain]);

            $pdo->commit();
            out('  ' . green('✓') . ' Created tenant ' . cyan('#' . (string)$tenantId) . ' ' . bold($tenantKey));
            out('    ' . dim('domain: ') . $domain);
            if ($entryModuleId !== '') {
                out('    ' . dim('entry: ') . $entryModuleId);
            }
            out('');
        } catch (\Throwable $e) {
            try {
                $pdo = app()->controlDb();
                if ($pdo->inTransaction()) {
                    $pdo->rollBack();
                }
            } catch (\Throwable $ignored) {
            }
            out('  ' . red('✗ Failed: ') . $e->getMessage());
            out('');
            exit(1);
        }
        break;

    // ── tenant:domain:add ─────────────────────────────────────────
    case 'tenant:domain:add':
        $clean = paramsWithoutFlags($params);
        $tenantId = (int)($clean[0] ?? 0);
        $domain = strtolower(trim((string)($clean[1] ?? '')));
        banner();
        if ($tenantId <= 0 || $domain === '') {
            out('  ' . red('✗ Usage: ') . 'php ikabud tenant:domain:add <tenant_id> <domain>');
            out('');
            exit(1);
        }
        if (!preg_match('/^[a-z0-9][a-z0-9\.\-]{1,253}[a-z0-9]$/', $domain)) {
            out('  ' . red('✗ Invalid domain.'));
            out('');
            exit(1);
        }
        try {
            $pdo = app()->controlDb();

            $stmt = $pdo->prepare('SELECT id FROM kernel_tenants WHERE id = :tid LIMIT 1');
            $stmt->execute([':tid' => $tenantId]);
            $row = $stmt->fetch(PDO::FETCH_ASSOC);
            if (!is_array($row)) {
                out('  ' . red('✗ Tenant not found: ') . (string)$tenantId);
                out('');
                exit(1);
            }

            $stmt = $pdo->prepare('INSERT INTO kernel_tenant_domains (tenant_id, domain) VALUES (:tid, :d)');
            $stmt->execute([':tid' => $tenantId, ':d' => $domain]);

            out('  ' . green('✓') . ' Added domain to tenant ' . cyan('#' . (string)$tenantId));
            out('    ' . dim('domain: ') . $domain);
            out('');
        } catch (\Throwable $e) {
            out('  ' . red('✗ Failed: ') . $e->getMessage());
            out('');
            exit(1);
        }
        break;

    // ── tenant:domain:remove ─────────────────────────────────────
    case 'tenant:domain:remove':
        $clean = paramsWithoutFlags($params);
        $tenantId = (int)($clean[0] ?? 0);
        $domain = strtolower(trim((string)($clean[1] ?? '')));
        banner();
        if ($tenantId <= 0 || $domain === '') {
            out('  ' . red('✗ Usage: ') . 'php ikabud tenant:domain:remove <tenant_id> <domain>');
            out('');
            exit(1);
        }
        if (!preg_match('/^[a-z0-9][a-z0-9\.\-]{1,253}[a-z0-9]$/', $domain)) {
            out('  ' . red('✗ Invalid domain.'));
            out('');
            exit(1);
        }
        try {
            $pdo = app()->controlDb();
            $stmt = $pdo->prepare('DELETE FROM kernel_tenant_domains WHERE tenant_id = :tid AND domain = :d');
            $stmt->execute([':tid' => $tenantId, ':d' => $domain]);
            $deleted = (int)$stmt->rowCount();
            if ($deleted <= 0) {
                out('  ' . yellow('!') . ' No matching domain row found.');
                out('    ' . dim('tenant: ') . (string)$tenantId);
                out('    ' . dim('domain: ') . $domain);
                out('');
                break;
            }
            out('  ' . green('✓') . ' Removed domain from tenant ' . cyan('#' . (string)$tenantId));
            out('    ' . dim('domain: ') . $domain);
            out('');
        } catch (\Throwable $e) {
            out('  ' . red('✗ Failed: ') . $e->getMessage());
            out('');
            exit(1);
        }
        break;

    // ── tenant:db:set ─────────────────────────────────────────────
    case 'tenant:db:set':
        $clean = paramsWithoutFlags($params);
        $tenantId = (int)($clean[0] ?? 0);
        $driver = trim((string)(getFlagValue('--driver=') ?? 'mysql'));
        $host = trim((string)(getFlagValue('--host=') ?? ''));
        $name = trim((string)(getFlagValue('--name=') ?? ''));
        $user = trim((string)(getFlagValue('--user=') ?? ''));
        $port = trim((string)(getFlagValue('--port=') ?? '3306'));
        $charset = trim((string)(getFlagValue('--charset=') ?? 'utf8mb4'));
        $passFlag = getFlagValue('--pass=');
        $pass = (string)($passFlag ?? '');
        banner();
        if ($tenantId <= 0 || $host === '' || $name === '' || $user === '') {
            out('  ' . red('✗ Usage: ') . 'php ikabud tenant:db:set <tenant_id> --host=... --name=... --user=... [--port=3306] [--driver=mysql] [--charset=utf8mb4] [--pass=...]');
            out('');
            exit(1);
        }
        try {
            $pdo = app()->controlDb();
            $stmt = $pdo->prepare('SELECT id FROM kernel_tenants WHERE id = :tid LIMIT 1');
            $stmt->execute([':tid' => $tenantId]);
            if (!is_array($stmt->fetch(PDO::FETCH_ASSOC))) throw new \RuntimeException('Tenant not found.');
            $cipher = null; $iv = null; $tag = null;
            if ($passFlag !== null && $pass !== '') {
                $enc = (new Crypto())->encryptString($pass);
                $cipher = (string)($enc['ciphertext'] ?? '');
                $iv = (string)($enc['iv'] ?? '');
                $tag = (string)($enc['tag'] ?? '');
                if ($cipher === '' || $iv === '' || $tag === '') throw new \RuntimeException('Encryption failed.');
            }
            if ($passFlag !== null && $pass !== '') {
                $sql = 'INSERT INTO kernel_tenant_db_connections (tenant_id, db_driver, db_host, db_port, db_name, db_user, db_pass, db_charset, db_pass_ciphertext, db_pass_iv, db_pass_tag) '
                    . 'VALUES (:tid,:drv,:h,:p,:n,:u,NULL,:cs,:c,:iv,:t) '
                    . 'ON DUPLICATE KEY UPDATE db_driver=VALUES(db_driver), db_host=VALUES(db_host), db_port=VALUES(db_port), db_name=VALUES(db_name), db_user=VALUES(db_user), db_pass=NULL, db_charset=VALUES(db_charset), db_pass_ciphertext=VALUES(db_pass_ciphertext), db_pass_iv=VALUES(db_pass_iv), db_pass_tag=VALUES(db_pass_tag)';
                $pdo->prepare($sql)->execute([':tid'=>$tenantId,':drv'=>$driver,':h'=>$host,':p'=>$port,':n'=>$name,':u'=>$user,':cs'=>$charset,':c'=>$cipher,':iv'=>$iv,':t'=>$tag]);
            } else {
                $sql = 'INSERT INTO kernel_tenant_db_connections (tenant_id, db_driver, db_host, db_port, db_name, db_user, db_pass, db_charset) '
                    . 'VALUES (:tid,:drv,:h,:p,:n,:u,NULL,:cs) '
                    . 'ON DUPLICATE KEY UPDATE db_driver=VALUES(db_driver), db_host=VALUES(db_host), db_port=VALUES(db_port), db_name=VALUES(db_name), db_user=VALUES(db_user), db_pass=NULL, db_charset=VALUES(db_charset)';
                $pdo->prepare($sql)->execute([':tid'=>$tenantId,':drv'=>$driver,':h'=>$host,':p'=>$port,':n'=>$name,':u'=>$user,':cs'=>$charset]);
            }
            out('  ' . green('✓') . ' Updated tenant DB connection for ' . cyan('#' . (string)$tenantId));
            out('');
        } catch (\Throwable $e) {
            out('  ' . red('✗ Failed: ') . $e->getMessage());
            out('');
            exit(1);
        }
        break;

    // ── tenant:db:check ───────────────────────────────────────────
    case 'tenant:db:check':
        $clean = paramsWithoutFlags($params);
        $tenantId = (int)($clean[0] ?? 0);
        banner();
        if ($tenantId <= 0) {
            out('  ' . red('✗ Usage: ') . 'php ikabud tenant:db:check <tenant_id>');
            out('');
            exit(1);
        }
        try {
            $pdo = app()->controlDb();
            $stmt = $pdo->prepare(
                'SELECT db_driver, db_host, db_port, db_name, db_user, db_pass, db_charset, '
                . 'db_pass_ciphertext, db_pass_iv, db_pass_tag '
                . 'FROM kernel_tenant_db_connections WHERE tenant_id = :tid LIMIT 1'
            );
            $stmt->execute([':tid' => $tenantId]);
            $row = $stmt->fetch(PDO::FETCH_ASSOC);
            if (!is_array($row)) {
                out('  ' . yellow('!') . ' No DB connection row found for tenant ' . cyan('#' . (string)$tenantId));
                out('');
                break;
            }

            $driver = (string)($row['db_driver'] ?? 'mysql');
            $host = (string)($row['db_host'] ?? '');
            $port = (string)($row['db_port'] ?? '');
            $name = (string)($row['db_name'] ?? '');
            $user = (string)($row['db_user'] ?? '');
            $charset = (string)($row['db_charset'] ?? 'utf8mb4');
            $plain = (string)($row['db_pass'] ?? '');
            $cipher = (string)($row['db_pass_ciphertext'] ?? '');
            $iv = (string)($row['db_pass_iv'] ?? '');
            $tag = (string)($row['db_pass_tag'] ?? '');

            $hasEncrypted = ($cipher !== '' && $iv !== '' && $tag !== '');
            $hasPlain = ($plain !== '');

            out('  ' . bold('Tenant DB connection') . ' ' . cyan('#' . (string)$tenantId));
            out('');
            out('    ' . dim('driver: ') . $driver);
            out('    ' . dim('host:   ') . $host);
            out('    ' . dim('port:   ') . $port);
            out('    ' . dim('name:   ') . $name);
            out('    ' . dim('user:   ') . $user);
            out('    ' . dim('charset:') . ' ' . $charset);
            out('');

            if ($hasEncrypted) {
                out('  ' . green('✓') . ' Encrypted password present');
            } else {
                out('  ' . yellow('!') . ' Encrypted password missing');
            }

            if ($hasPlain) {
                out('  ' . red('✗') . ' Plaintext db_pass is NOT empty (should be NULL/empty)');
            } else {
                out('  ' . green('✓') . ' Plaintext db_pass empty');
            }
            out('');
        } catch (\Throwable $e) {
            out('  ' . red('✗ Failed: ') . $e->getMessage());
            out('');
            exit(1);
        }
        break;

    // ── tenant:provision ──────────────────────────────────────────
    case 'tenant:provision':
        $clean = paramsWithoutFlags($params);
        $tenantId = (int)($clean[0] ?? 0);
        $skipDbCreate = hasFlag('--skip-db-create');
        $adminUser = trim((string)(getFlagValue('--admin-user=') ?? ''));
        $adminPass = trim((string)(getFlagValue('--admin-pass=') ?? ''));
        $adminName = trim((string)(getFlagValue('--admin-name=') ?? 'Admin'));

        banner();
        if ($tenantId <= 0) {
            out('  ' . red('✗ Usage: ') . 'php ikabud tenant:provision <tenant_id> [--skip-db-create] [--admin-user=...] [--admin-pass=...] [--admin-name=...]');
            out('');
            exit(1);
        }

        try {
            $controlPdo = app()->controlDb();

            // 1. Validate tenant record exists
            $stmt = $controlPdo->prepare(
                'SELECT t.id, t.tenant_key, t.status, t.entry_module_id, '
                . 'c.db_driver, c.db_host, c.db_port, c.db_name, c.db_user, c.db_pass, c.db_charset, '
                . 'c.db_pass_ciphertext, c.db_pass_iv, c.db_pass_tag '
                . 'FROM kernel_tenants t '
                . 'LEFT JOIN kernel_tenant_db_connections c ON c.tenant_id = t.id '
                . 'WHERE t.id = :tid LIMIT 1'
            );
            $stmt->execute([':tid' => $tenantId]);
            $tenant = $stmt->fetch(PDO::FETCH_ASSOC);
            if (!is_array($tenant)) {
                out('  ' . red('✗ Tenant not found: ') . (string)$tenantId);
                out('');
                exit(1);
            }

            $tenantKey = (string)($tenant['tenant_key'] ?? '');
            $dbHost = (string)($tenant['db_host'] ?? '');
            $dbPort = (string)($tenant['db_port'] ?? '3306');
            $dbName = (string)($tenant['db_name'] ?? '');
            $dbUser = (string)($tenant['db_user'] ?? '');
            $dbCharset = (string)($tenant['db_charset'] ?? 'utf8mb4');

            if ($dbHost === '' || $dbName === '' || $dbUser === '') {
                out('  ' . red('✗ No DB connection configured for tenant ' . (string)$tenantId . '.'));
                out('  ' . dim('Run: php ikabud tenant:db:set ' . (string)$tenantId . ' --host=... --name=... --user=... --pass=...'));
                out('');
                exit(1);
            }

            // Decrypt password
            $dbPass = (string)($tenant['db_pass'] ?? '');
            $cipher = (string)($tenant['db_pass_ciphertext'] ?? '');
            $iv = (string)($tenant['db_pass_iv'] ?? '');
            $tag = (string)($tenant['db_pass_tag'] ?? '');
            if ($cipher !== '' && $iv !== '' && $tag !== '') {
                $dbPass = (new Crypto())->decryptString($cipher, $iv, $tag);
            }

            out('  ' . bold('Provisioning tenant') . ' ' . cyan('#' . (string)$tenantId) . ' ' . bold($tenantKey));
            out('    ' . dim('db: ') . $dbUser . '@' . $dbHost . ':' . $dbPort . '/' . $dbName);
            out('');

            // 2. Create database (unless --skip-db-create)
            if (!$skipDbCreate) {
                out('  Creating database...');
                try {
                    $rootDsn = 'mysql:host=' . $dbHost . ';port=' . $dbPort . ';charset=' . $dbCharset;
                    $rootPdo = new PDO($rootDsn, $dbUser, $dbPass, [
                        PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
                    ]);
                    $safeName = preg_replace('/[^a-zA-Z0-9_]/', '', $dbName);
                    $rootPdo->exec('CREATE DATABASE IF NOT EXISTS `' . $safeName . '` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci');
                    out('  ' . green('✓') . ' Database created (or already exists)');
                } catch (\Throwable $e) {
                    out('  ' . yellow('!') . ' Could not create database: ' . $e->getMessage());
                    out('  ' . dim('Use --skip-db-create if database was pre-created (e.g. cPanel).'));
                    out('');
                    exit(1);
                }
            } else {
                out('  ' . dim('Skipping database creation (--skip-db-create)'));
            }

            // 3. Connect to tenant database
            $tenantDsn = 'mysql:host=' . $dbHost . ';port=' . $dbPort . ';dbname=' . $dbName . ';charset=' . $dbCharset;
            $tenantPdo = new PDO($tenantDsn, $dbUser, $dbPass, [
                PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
                PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
                PDO::ATTR_EMULATE_PREPARES => false,
            ]);
            out('  ' . green('✓') . ' Connected to tenant database');

            // 4. Set tenant context so app()->db() returns tenant DB for downstream code
            app()->tenant()->setTenantId($tenantId);

            // 5. Run tenant-appropriate module migrations against the tenant database
            out('  Running migrations...');
            $runner = new MigrationRunner($tenantPdo);
            $entryModule = trim((string)($tenant['entry_module_id'] ?? ''));
            $modulePlan = tenantProvisionModulePlan($entryModule !== '' ? $entryModule : null);
            $results = [];
            foreach ($modulePlan as $moduleId) {
                $moduleResult = $runner->migrate($moduleId);
                if (!empty($moduleResult)) {
                    $results[$moduleId] = $moduleResult;
                }
            }
            $totalCount = 0;
            if (empty($results)) {
                out('  ' . dim('  Nothing to migrate.'));
            } else {
                out('  ' . dim('  module plan: ') . implode(', ', $modulePlan));
                foreach ($results as $mod => $files) {
                    out('    ' . bold($mod));
                    foreach ($files as $f) {
                        out('      ' . green('✓') . " {$f}");
                        $totalCount++;
                    }
                }
                out('  ' . green('✓') . bold(" {$totalCount} migration(s) executed across " . count($results) . ' module(s).'));
            }

            // 6. Run tenant-safe kernel migrations only (never control-plane schema)
            $kernelApplied = tenantSyncKernelMigrations($tenantPdo);
            if (!empty($kernelApplied)) {
                out('    ' . bold('kernel'));
                foreach ($kernelApplied as $artifactName) {
                    out('      ' . green('✓') . " {$artifactName}");
                }
            }

            // 7. Seed admin user (if --admin-user provided and entry module is CMS)
            if ($adminUser !== '' && $adminPass !== '') {
                out('');
                out('  Seeding admin user...');

                $usersTable = 'users';
                if ($entryModule === 'cms') {
                    $usersTable = 'cms_users';
                }

                // Check if users table exists
                $tableCheck = $tenantPdo->query("SHOW TABLES LIKE '{$usersTable}'")->fetchColumn();
                if ($tableCheck !== false) {
                    $existStmt = $tenantPdo->prepare("SELECT id FROM `{$usersTable}` WHERE username = :u LIMIT 1");
                    $existStmt->execute([':u' => $adminUser]);
                    if ($existStmt->fetch()) {
                        out('  ' . yellow('!') . " User '{$adminUser}' already exists in {$usersTable}");
                    } else {
                        $hash = password_hash($adminPass, PASSWORD_BCRYPT);
                        if ($usersTable === 'cms_users') {
                            // CMS users table uses password_hash, display_name, email, and ENUM roles
                            $insertStmt = $tenantPdo->prepare(
                                "INSERT INTO `cms_users` (username, email, password_hash, display_name, role, is_active) "
                                . "VALUES (:u, :e, :p, :n, 'administrator', 1)"
                            );
                            $insertStmt->execute([
                                ':u' => $adminUser,
                                ':e' => $adminUser . '@localhost',
                                ':p' => $hash,
                                ':n' => $adminName,
                            ]);
                        } else {
                            // Kernel users table
                            $insertStmt = $tenantPdo->prepare(
                                "INSERT INTO `users` (username, password, full_name, role, status) "
                                . "VALUES (:u, :p, :n, 'admin', 'active')"
                            );
                            $insertStmt->execute([
                                ':u' => $adminUser,
                                ':p' => $hash,
                                ':n' => $adminName,
                            ]);
                        }
                        out('  ' . green('✓') . " Admin user '{$adminUser}' created in {$usersTable}");
                    }
                } else {
                    out('  ' . yellow('!') . " Table '{$usersTable}' does not exist yet — skip user seed");
                }
            } elseif ($adminUser !== '' && $adminPass === '') {
                out('  ' . yellow('!') . ' --admin-user provided but --admin-pass missing — skipping user seed');
            }

            out('');
            out('  ' . green('✓') . bold(' Provisioning complete for tenant #' . (string)$tenantId . ' (' . $tenantKey . ')'));
            out('');
        } catch (\Throwable $e) {
            out('  ' . red('✗ Provisioning failed: ') . $e->getMessage());
            if (app()->config('app.debug', false)) {
                out('  ' . dim($e->getFile() . ':' . $e->getLine()));
            }
            out('');
            exit(1);
        }
        break;

    // ── tenant:verify ─────────────────────────────────────────────
    case 'tenant:verify':
        $clean = paramsWithoutFlags($params);
        $verifyTenantId = (int)($clean[0] ?? 0);
        banner();

        if ($verifyTenantId <= 0) {
            out('  ' . red('✗ Usage: ') . 'php ikabud tenant:verify <tenant_id>');
            out('  Runs a health check confirming the tenant is properly set up and isolated.');
            out('');
            exit(1);
        }

        $verifyPassed = 0;
        $verifyFailed = 0;
        $verifyWarnings = 0;

        $verifyPass = function (string $msg) use (&$verifyPassed): void {
            $verifyPassed++;
            out('  ' . green('✓') . ' ' . $msg);
        };
        $verifyFail = function (string $msg) use (&$verifyFailed): void {
            $verifyFailed++;
            out('  ' . red('✗') . ' ' . $msg);
        };
        $verifyWarn = function (string $msg) use (&$verifyWarnings): void {
            $verifyWarnings++;
            out('  ' . yellow('!') . ' ' . $msg);
        };

        try {
            $controlPdo = app()->controlDb();

            // ── 1. Control plane tenant record ────────────────────────
            out('');
            out('  ' . bold('1. Control Plane Record'));
            $stmt = $controlPdo->prepare(
                'SELECT t.id, t.tenant_key, t.status, t.entry_module_id, '
                . 'c.db_host, c.db_port, c.db_name, c.db_user, c.db_pass, c.db_charset, '
                . 'c.db_pass_ciphertext, c.db_pass_iv, c.db_pass_tag '
                . 'FROM kernel_tenants t '
                . 'LEFT JOIN kernel_tenant_db_connections c ON c.tenant_id = t.id '
                . 'WHERE t.id = :tid LIMIT 1'
            );
            $stmt->execute([':tid' => $verifyTenantId]);
            $vTenant = $stmt->fetch(PDO::FETCH_ASSOC);

            if (!is_array($vTenant)) {
                $verifyFail('Tenant #' . $verifyTenantId . ' not found in kernel_tenants');
                throw new RuntimeException('Cannot continue without tenant record.');
            }
            $verifyPass('Tenant record found: key=' . ($vTenant['tenant_key'] ?? '?') . ', status=' . ($vTenant['status'] ?? '?'));

            if (($vTenant['status'] ?? '') !== 'active') {
                $verifyWarn('Tenant status is "' . ($vTenant['status'] ?? '') . '" (expected "active")');
            }

            $vEntryModule = trim((string)($vTenant['entry_module_id'] ?? ''));
            if ($vEntryModule !== '') {
                $verifyPass('Entry module: ' . $vEntryModule);
            } else {
                $verifyWarn('No entry_module_id set');
            }

            // ── 2. Domain bindings ────────────────────────────────────
            out('');
            out('  ' . bold('2. Domain Bindings'));
            $dStmt = $controlPdo->prepare(
                'SELECT domain FROM kernel_tenant_domains WHERE tenant_id = :tid ORDER BY domain'
            );
            $dStmt->execute([':tid' => $verifyTenantId]);
            $domains = $dStmt->fetchAll(PDO::FETCH_COLUMN);
            if (empty($domains)) {
                $verifyFail('No domains bound to this tenant — requests cannot be routed');
            } else {
                foreach ($domains as $d) {
                    $verifyPass('Domain: ' . $d);
                }
            }

            // Check for domain conflicts (same domain on multiple tenants)
            foreach ($domains as $d) {
                $cStmt = $controlPdo->prepare(
                    'SELECT tenant_id FROM kernel_tenant_domains WHERE domain = :d AND tenant_id != :tid'
                );
                $cStmt->execute([':d' => $d, ':tid' => $verifyTenantId]);
                $conflict = $cStmt->fetchColumn();
                if ($conflict !== false) {
                    $verifyFail('Domain "' . $d . '" also bound to tenant #' . $conflict . ' (CONFLICT)');
                }
            }

            // ── 3. Database connection ────────────────────────────────
            out('');
            out('  ' . bold('3. Database Connection'));
            $vDbHost = (string)($vTenant['db_host'] ?? '');
            $vDbPort = (string)($vTenant['db_port'] ?? '3306');
            $vDbName = (string)($vTenant['db_name'] ?? '');
            $vDbUser = (string)($vTenant['db_user'] ?? '');
            $vDbCharset = (string)($vTenant['db_charset'] ?? 'utf8mb4');

            if ($vDbHost === '' || $vDbName === '' || $vDbUser === '') {
                $verifyFail('Incomplete DB connection config (host/name/user missing)');
                throw new RuntimeException('Cannot continue without DB connection.');
            }
            $verifyPass('DB config: ' . $vDbUser . '@' . $vDbHost . ':' . $vDbPort . '/' . $vDbName);

            // Decrypt password
            $vDbPass = (string)($vTenant['db_pass'] ?? '');
            $cipher = (string)($vTenant['db_pass_ciphertext'] ?? '');
            $iv = (string)($vTenant['db_pass_iv'] ?? '');
            $tag = (string)($vTenant['db_pass_tag'] ?? '');
            if ($cipher !== '' && $iv !== '' && $tag !== '') {
                try {
                    $vDbPass = (new Crypto())->decryptString($cipher, $iv, $tag);
                    $verifyPass('DB password decrypted from encrypted store');
                } catch (Throwable $e) {
                    $verifyFail('DB password decryption failed: ' . $e->getMessage());
                    throw new RuntimeException('Cannot continue without DB password.');
                }
            } elseif ($vDbPass !== '') {
                $verifyWarn('DB password stored in plaintext (consider encrypting)');
            } else {
                $verifyFail('No DB password configured');
                throw new RuntimeException('Cannot continue without DB password.');
            }

            // Test connection
            try {
                $vDsn = 'mysql:host=' . $vDbHost . ';port=' . $vDbPort . ';dbname=' . $vDbName . ';charset=' . $vDbCharset;
                $vPdo = new PDO($vDsn, $vDbUser, $vDbPass, [
                    PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
                    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
                ]);
                $verifyPass('DB connection successful');
            } catch (Throwable $e) {
                $verifyFail('DB connection failed: ' . $e->getMessage());
                throw new RuntimeException('Cannot continue without DB connection.');
            }

            // Check this DB is NOT the control DB (isolation check)
            $controlDbName = (string)($controlPdo->query('SELECT DATABASE()')->fetchColumn());
            if ($vDbName === $controlDbName && $vDbHost === (string)app()->config('control_database.host', '')) {
                $verifyWarn('Tenant DB is same as control DB — OK for dev, not recommended for production');
            }

            // ── 4. Required tables ────────────────────────────────────
            out('');
            out('  ' . bold('4. Required Tables'));

            // Core kernel tables
            $requiredKernel = ['tenant_module_settings'];
            // Entry-module-specific tables
            $requiredCms = [
                'cms_users', 'cms_content', 'cms_content_meta', 'cms_media',
                'cms_password_resets', 'cms_builder_documents',
                'cms_categories', 'cms_tags', 'cms_menus', 'cms_menu_items',
                'cms_theme_customizer', 'cms_revisions',
            ];

            $allTables = $vPdo->query('SHOW TABLES')->fetchAll(PDO::FETCH_COLUMN);
            $tableSet = array_flip($allTables);

            foreach ($requiredKernel as $rt) {
                if (isset($tableSet[$rt])) {
                    $verifyPass('Kernel table: ' . $rt);
                } else {
                    $verifyFail('Missing kernel table: ' . $rt);
                }
            }

            if ($vEntryModule === 'cms') {
                foreach ($requiredCms as $rt) {
                    if (isset($tableSet[$rt])) {
                        $verifyPass('CMS table: ' . $rt);
                    } else {
                        $verifyFail('Missing CMS table: ' . $rt);
                    }
                }
            }

            // ── 5. Migrations status ──────────────────────────────────
            out('');
            out('  ' . bold('5. Migrations'));

            if (isset($tableSet['kernel_migrations'])) {
                $mStmt = $vPdo->query('SELECT COUNT(*) FROM kernel_migrations');
                $mCount = (int)$mStmt->fetchColumn();
                $verifyPass('kernel_migrations: ' . $mCount . ' recorded');
            } else {
                $verifyWarn('kernel_migrations table missing — kernel migrations not tracked');
            }

            // Check tenant_module_settings has records for this tenant
            if (isset($tableSet['tenant_module_settings'])) {
                $tmsStmt = $vPdo->prepare(
                    'SELECT COUNT(*) FROM tenant_module_settings WHERE tenant_id = :tid'
                );
                $tmsStmt->execute([':tid' => $verifyTenantId]);
                $tmsCount = (int)$tmsStmt->fetchColumn();
                if ($tmsCount > 0) {
                    $verifyPass('tenant_module_settings: ' . $tmsCount . ' rows for tenant #' . $verifyTenantId);
                } else {
                    $verifyWarn('tenant_module_settings has 0 rows for tenant #' . $verifyTenantId . ' (modules may use global fallback)');
                }
            }

            // ── 6. Module state isolation ─────────────────────────────
            out('');
            out('  ' . bold('6. Module State Isolation'));

            // Check which modules are enabled via tenant settings
            if (isset($tableSet['tenant_module_settings'])) {
                $enStmt = $vPdo->prepare(
                    'SELECT module_id, JSON_UNQUOTE(setting_value) AS val '
                    . 'FROM tenant_module_settings WHERE tenant_id = :tid AND setting_key = :sk'
                );
                $enStmt->execute([':tid' => $verifyTenantId, ':sk' => '_module_enabled']);
                $enabledModules = $enStmt->fetchAll(PDO::FETCH_ASSOC);
                if (!empty($enabledModules)) {
                    $discoveredModules = array_keys(discoverModules());
                    foreach ($enabledModules as $em) {
                        $st = ($em['val'] === 'true' || $em['val'] === '1') ? green('enabled') : yellow('disabled');
                        // Warn if the module state references a module that no longer exists on disk
                        if (!in_array($em['module_id'], $discoveredModules, true)) {
                            $verifyWarn('Module state: ' . $em['module_id'] . ' → ' . $st . ' (module NOT on disk — ghost entry)');
                        } else {
                            $verifyPass('Module state: ' . $em['module_id'] . ' → ' . $st);
                        }
                    }
                } else {
                    $verifyWarn('No per-tenant module enable/disable state — using global defaults');
                }
            }

            // ── 7. CMS sub-module registry ────────────────────────────
            out('');
            out('  ' . bold('7. CMS Sub-Module Registry'));

            if ($vEntryModule === 'cms' && isset($tableSet['tenant_module_settings'])) {
                $srStmt = $vPdo->prepare(
                    'SELECT JSON_UNQUOTE(setting_value) AS val '
                    . 'FROM tenant_module_settings WHERE tenant_id = :tid AND module_id = :mid AND setting_key = :sk'
                );
                $srStmt->execute([':tid' => $verifyTenantId, ':mid' => 'cms', ':sk' => '_installed_submodules']);
                $srRow = $srStmt->fetch(PDO::FETCH_ASSOC);
                if (is_array($srRow) && ($srRow['val'] ?? '') !== '') {
                    $subModules = json_decode($srRow['val'], true);
                    if (is_array($subModules) && !empty($subModules)) {
                        foreach ($subModules as $sm) {
                            $smDir = BASE_PATH . '/modules/' . $sm;
                            $onDisk = is_dir($smDir) ? green('on disk') : red('MISSING from disk');
                            $verifyPass('CMS sub-module: ' . $sm . ' (' . $onDisk . ')');
                        }
                    } else {
                        $verifyPass('No CMS sub-modules installed (empty registry)');
                    }
                } else {
                    $verifyPass('No CMS sub-module registry (no sub-modules installed)');
                }

                // Cross-check: global file registry should NOT be authoritative
                $globalRegistryPath = STORAGE_PATH . '/cms-installed-modules.json';
                if (is_file($globalRegistryPath)) {
                    $globalList = json_decode((string)file_get_contents($globalRegistryPath), true);
                    if (is_array($globalList) && !empty($globalList)) {
                        $verifyWarn('Global file registry exists at storage/cms-installed-modules.json with ' . count($globalList) . ' entries (should be empty in multi-tenant mode)');
                    }
                }
            } else {
                $verifyPass('Skipped (not a CMS tenant)');
            }

            // ── 8. Admin user exists ──────────────────────────────────
            out('');
            out('  ' . bold('8. Admin User'));
            if ($vEntryModule === 'cms' && isset($tableSet['cms_users'])) {
                $uStmt = $vPdo->query(
                    "SELECT id, username, role, is_active FROM cms_users WHERE role IN ('administrator','superadmin') AND is_active = 1 LIMIT 5"
                );
                $admins = $uStmt->fetchAll(PDO::FETCH_ASSOC);
                if (!empty($admins)) {
                    foreach ($admins as $adm) {
                        $verifyPass('Admin: ' . $adm['username'] . ' (role=' . $adm['role'] . ', id=' . $adm['id'] . ')');
                    }
                } else {
                    $verifyFail('No active admin users found in cms_users — cannot log in');
                }
            } elseif (isset($tableSet['users'])) {
                $uStmt = $vPdo->query(
                    "SELECT id, username, role, status FROM users WHERE role = 'admin' AND status = 'active' LIMIT 5"
                );
                $admins = $uStmt->fetchAll(PDO::FETCH_ASSOC);
                if (!empty($admins)) {
                    foreach ($admins as $adm) {
                        $verifyPass('Admin: ' . $adm['username'] . ' (role=' . $adm['role'] . ', id=' . $adm['id'] . ')');
                    }
                } else {
                    $verifyFail('No active admin users found in users table');
                }
            }

            // ── 9. Cross-tenant DB isolation ──────────────────────────
            out('');
            out('  ' . bold('9. Cross-Tenant DB Isolation'));
            $otStmt = $controlPdo->prepare(
                'SELECT t.id, t.tenant_key, c.db_name, c.db_host '
                . 'FROM kernel_tenants t '
                . 'JOIN kernel_tenant_db_connections c ON c.tenant_id = t.id '
                . 'WHERE t.id != :tid AND c.db_name = :dbname AND c.db_host = :dbhost'
            );
            $otStmt->execute([':tid' => $verifyTenantId, ':dbname' => $vDbName, ':dbhost' => $vDbHost]);
            $sharedDbTenants = $otStmt->fetchAll(PDO::FETCH_ASSOC);
            if (!empty($sharedDbTenants)) {
                foreach ($sharedDbTenants as $sdt) {
                    $verifyWarn('Shares DB "' . $vDbName . '" with tenant #' . $sdt['id'] . ' (' . $sdt['tenant_key'] . ') — isolation depends on tenant_id scoping in queries');
                }
            } else {
                $verifyPass('Database "' . $vDbName . '" not shared with other tenants');
            }

            // ── 10. File-system isolation ─────────────────────────────
            out('');
            out('  ' . bold('10. File System'));
            $uploadsDir = BASE_PATH . '/modules/cms/assets/uploads/t' . $verifyTenantId;
            if (is_dir($uploadsDir)) {
                $verifyPass('Tenant uploads dir exists: modules/cms/assets/uploads/t' . $verifyTenantId);
                if (is_writable($uploadsDir)) {
                    $verifyPass('Uploads dir is writable');
                } else {
                    $verifyFail('Uploads dir is NOT writable');
                }
            } else {
                $verifyWarn('Tenant uploads dir does not exist yet (will be created on first upload)');
            }

        } catch (RuntimeException $e) {
            out('');
            out('  ' . red('Verification stopped: ') . $e->getMessage());
        } catch (Throwable $e) {
            out('');
            $verifyFail('Unexpected error: ' . $e->getMessage());
        }

        // ── Summary ───────────────────────────────────────────────
        out('');
        out('  ═══════════════════════════════════════════');
        out('  ' . bold('Summary for tenant #' . $verifyTenantId));
        out('    Passed:   ' . green((string)$verifyPassed));
        if ($verifyWarnings > 0) {
            out('    Warnings: ' . yellow((string)$verifyWarnings));
        }
        if ($verifyFailed > 0) {
            out('    Failed:   ' . red((string)$verifyFailed));
        }
        if ($verifyFailed === 0) {
            out('  ' . green('✓ Tenant is healthy'));
        } else {
            out('  ' . red('✗ ' . $verifyFailed . ' issue(s) must be resolved'));
        }
        out('');
        exit($verifyFailed > 0 ? 1 : 0);

    // ── capability:test ──────────────────────────────────────────
    case 'capability:test':
        $clean = paramsWithoutFlags($params);
        $capIdOrFile = $clean[0] ?? '';

        if (hasFlag('--with-modules')) {
            loadModuleRoutes(['GET' => [], 'POST' => [], 'PUT' => [], 'DELETE' => []]);
        }

        $mode = getFlagValue('--mode=');
        $provider = getFlagValue('--provider=');

        $fixtureFiles = [];
        $fixturesDir = BASE_PATH . '/tests/capability_fixtures';

        if ($capIdOrFile === '') {
            // Run all fixtures
            if (is_dir($fixturesDir)) {
                foreach (scandir($fixturesDir) as $f) {
                    if ($f === '.' || $f === '..') continue;
                    if (!str_ends_with($f, '.json')) continue;
                    $fixtureFiles[] = $fixturesDir . '/' . $f;
                }
            }
        } else {
            // If argument looks like a path or ends with .json, treat as file
            if (str_ends_with($capIdOrFile, '.json') || str_contains($capIdOrFile, '/')) {
                $path = $capIdOrFile;
                if (!str_starts_with($path, '/')) {
                    $path = BASE_PATH . '/' . ltrim($path, '/');
                }
                $fixtureFiles[] = $path;
            } else {
                // Treat as capability id -> map to fixture file name
                $fixtureFiles[] = $fixturesDir . '/' . $capIdOrFile . '.json';
            }
        }

        banner();
        out('  ' . bold('Capability Tests'));
        out('');

        if (empty($fixtureFiles)) {
            out(yellow('  No fixture files found.'));
            exit(0);
        }

        $runner = new CapabilityTestRunner(app()->cap());
        $totalPassed = 0;
        $totalFailed = 0;

        foreach ($fixtureFiles as $file) {
            if (!is_file($file)) {
                out('  ' . red('✗') . ' ' . dim($file) . ' (missing)');
                $totalFailed++;
                continue;
            }

            $fixture = json_decode((string)file_get_contents($file), true);
            if (!is_array($fixture)) {
                out('  ' . red('✗') . ' ' . dim($file) . ' (invalid JSON)');
                $totalFailed++;
                continue;
            }

            // Apply CLI overrides to all cases if provided
            if ($mode !== null && $mode !== '') {
                $fixture['mode'] = $mode;
            }
            if ($provider !== null && $provider !== '') {
                foreach (($fixture['cases'] ?? []) as $i => $c) {
                    if (!is_array($c)) continue;
                    $fixture['cases'][$i]['options'] = array_merge((array)($c['options'] ?? []), ['provider' => $provider]);
                }
            }

            $res = $runner->runFixture($fixture);
            $capabilityId = (string)($fixture['capability_id'] ?? basename($file));
            if (!empty($res['ok'])) {
                out('  ' . green('✓') . ' ' . cyan($capabilityId) . '  ' . dim("passed={$res['passed']}") );
            } else {
                out('  ' . red('✗') . ' ' . cyan($capabilityId) . '  ' . dim("passed={$res['passed']} failed={$res['failed']}") );
                foreach (($res['failures'] ?? []) as $f) {
                    if (!is_array($f)) continue;
                    out('      - ' . (string)($f['name'] ?? 'case') . ': ' . (string)($f['error'] ?? 'failed'));
                }
            }

            $totalPassed += (int)($res['passed'] ?? 0);
            $totalFailed += (int)($res['failed'] ?? 0);
        }

        out('');
        if ($totalFailed === 0) {
            out(green("  ✓ ALL PASSED  (passed={$totalPassed})"));
            exit(0);
        }
        out(red("  ✗ FAILURES  (passed={$totalPassed} failed={$totalFailed})"));
        exit(1);

    // ── capability:list ──────────────────────────────────────────
    case 'capability:list':
        banner();
        out('  ' . bold('Registered Capabilities'));
        out('');

        if (hasFlag('--with-modules')) {
            // Load enabled modules (helpers.php) so their capability providers register.
            // We trigger module boot logic by calling loadModuleRoutes() with an empty routes array.
            loadModuleRoutes(['GET' => [], 'POST' => [], 'PUT' => [], 'DELETE' => []]);
        }

        // Note: CLI does not load module routes, so only kernel providers are guaranteed
        // unless a user manually requires module helpers.
        $capabilities = app()->capabilities()->inspectAll();
        if (count($capabilities) === 0) {
            out('  ' . yellow('No capabilities registered.'));
            exit(0);
        }

        foreach ($capabilities as $capability) {
            if (!is_array($capability)) {
                continue;
            }
            $capId = (string)($capability['id'] ?? '');
            if ($capId === '') {
                continue;
            }
            $baseId = (string)($capability['base_id'] ?? '');
            $version = $capability['major_version'] ?? null;
            $latestId = (string)($capability['latest_id'] ?? '');
            $isLatest = !empty($capability['is_latest']);

            $suffix = [];
            if ($baseId !== '' && $baseId !== $capId) {
                $suffix[] = 'base=' . $baseId;
            }
            if ($version !== null) {
                $suffix[] = 'v=' . (string)$version;
            }
            if ($latestId !== '' && !$isLatest) {
                $suffix[] = 'latest=' . $latestId;
            }

            out('  ' . cyan($capId) . (!empty($suffix) ? ('  ' . dim(implode('  ', $suffix))) : ''));
            $providers = is_array($capability['providers'] ?? null) ? $capability['providers'] : [];
            foreach ($providers as $p) {
                if (!is_array($p)) {
                    continue;
                }
                $prov = (string)($p['provider'] ?? '');
                $pri = (int)($p['priority'] ?? 0);
                $modes = implode(',', (array)($p['modes'] ?? []));
                $origin = is_array($p['origin'] ?? null) ? $p['origin'] : [];
                $originType = trim((string)($origin['type'] ?? 'runtime_register'));
                $originSymbol = trim((string)($origin['symbol'] ?? ''));
                $originLabel = $originType . ($originSymbol !== '' ? ':' . $originSymbol : '');
                out('    - ' . green($prov) . '  priority=' . $pri . '  modes=' . dim($modes) . '  origin=' . dim($originLabel));
            }
            out('');
        }
        break;

    // ── capability:call ──────────────────────────────────────────
    case 'capability:call':
        $clean = paramsWithoutFlags($params);
        $capId = $clean[0] ?? '';
        $json = $clean[1] ?? null;
        if ($capId === '') {
            out(red('  ✗ Capability id required.'));
            out('  Usage: php ikabud capability:call <capabilityId> "<jsonPayload>" [--mode=pipeline] [--provider=id] [--with-modules]');
            exit(1);
        }

        if (hasFlag('--with-modules')) {
            loadModuleRoutes(['GET' => [], 'POST' => [], 'PUT' => [], 'DELETE' => []]);
        }

        $payload = null;
        if ($json !== null) {
            $payload = json_decode((string)$json, true);
            if ($payload === null && trim((string)$json) !== 'null') {
                out(red('  ✗ Invalid JSON payload.'));
                exit(1);
            }
        }

        $mode = getFlagValue('--mode=') ?? 'first';
        $provider = getFlagValue('--provider=');

        banner();
        out('  ' . bold('Capability Call'));
        out('');
        out('  id: ' . cyan($capId));
        out('  mode: ' . dim($mode));
        if ($provider !== null && $provider !== '') {
            out('  provider: ' . dim($provider));
        }
        out('');

        $opts = ['mode' => $mode];
        if ($provider !== null && $provider !== '') {
            $opts['provider'] = $provider;
        }

        try {
            $result = app()->cap()->call($capId, $payload, $opts);
            out(green('  ✓ ok'));
            out('');
            out(json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) ?: 'null');
        } catch (Throwable $e) {
            out(red('  ✗ failed: ') . $e->getMessage());
            exit(1);
        }
        break;

    // ── capability:validate ─────────────────────────────────────
    case 'capability:validate':
        banner();
        out('  ' . bold('Capability Validation'));
        out('');

        $modules = discoverModules();
        if (count($modules) === 0) {
            out(yellow('  No modules found.'));
            exit(0);
        }

        $providers = [];
        $providerSchemas = [];
        $moduleDepends = [];
        $invalid = [];

        // Kernel providers
        foreach (app()->capabilities()->capabilityIds() as $capId) {
            foreach (app()->capabilities()->providers($capId) as $p) {
                $pid = (string)($p['provider'] ?? 'kernel');
                $providers[$capId][$pid] = true;
            }
        }

        foreach ($modules as $moduleId => $manifest) {
            $check = validateModuleCapabilities($manifest);
            if (empty($check['ok'])) {
                $invalid[$moduleId] = $check['error'] ?? 'invalid capabilities manifest';
                continue;
            }

            foreach (($check['exposes'] ?? []) as $e) {
                $capId = (string)($e['id'] ?? '');
                if ($capId === '') continue;
                $providers[$capId][$moduleId] = true;
                if (is_array($e['schema'] ?? null)) {
                    $providerSchemas[$capId][$moduleId] = $e['schema'];
                }
            }

            $moduleDepends[$moduleId] = array_values($check['depends'] ?? []);
        }

        $errors = [];
        $warnings = [];

        foreach ($moduleDepends as $moduleId => $deps) {
            foreach ($deps as $depId) {
                $depId = (string)$depId;
                if ($depId === '') continue;

                if (!isset($providers[$depId])) {
                    $base = preg_replace('/@\d+$/', '', $depId);
                    $alt = [];
                    foreach (array_keys($providers) as $cap) {
                        if (str_starts_with($cap, $base . '@')) {
                            $alt[] = $cap;
                        }
                    }
                    if (!empty($alt)) {
                        sort($alt);
                        $warnings[] = "{$moduleId} depends on {$depId} but available versions are: " . implode(', ', $alt);
                    } else {
                        $errors[] = "{$moduleId} depends on {$depId} with no providers";
                    }
                }
            }
        }

        foreach ($providerSchemas as $capId => $schemas) {
            if (count($schemas) <= 1) continue;
            $encoded = [];
            foreach ($schemas as $providerId => $schema) {
                $encoded[$providerId] = json_encode($schema, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
            }
            $unique = array_unique(array_values($encoded));
            if (count($unique) > 1) {
                $warnings[] = "{$capId} has divergent schemas across providers: " . implode(', ', array_keys($schemas));
            }
        }

        if (!empty($invalid)) {
            out(red('  ✗ invalid capability manifests'));
            foreach ($invalid as $mid => $err) {
                out('    - ' . cyan($mid) . ': ' . $err);
            }
            out('');
        }

        if (!empty($errors)) {
            out(red('  ✗ missing providers'));
            foreach ($errors as $err) {
                out('    - ' . $err);
            }
            out('');
        }

        if (!empty($warnings)) {
            out(yellow('  ! warnings'));
            foreach ($warnings as $warn) {
                out('    - ' . $warn);
            }
            out('');
        }

        if (empty($invalid) && empty($errors) && empty($warnings)) {
            out(green('  ✓ ok'));
            exit(0);
        }

        if (!empty($errors) || !empty($invalid)) {
            exit(2);
        }

        exit(1);

    // ── module:validate ──────────────────────────────────────────
    case 'module:disable':
        $clean = paramsWithoutFlags($params);
        $moduleId = $clean[0] ?? '';
        if ($moduleId === '') {
            out(red('  ✗ Module id required.'));
            out('  Usage: php ikabud module:disable <id>');
            exit(1);
        }
        disableModule($moduleId);
        out(green("  ✓ module '{$moduleId}' disabled"));
        break;

    // ── module:pack ─────────────────────────────────────────────
    case 'module:pack':
        $clean = paramsWithoutFlags($params);
        $moduleId = $clean[0] ?? '';
        $zipOut = $clean[1] ?? '';
        if ($moduleId === '') {
            out(red('  ✗ Module id required.'));
            out('  Usage: php ikabud module:pack <id> [zip-output-path]');
            exit(1);
        }
        if (!class_exists('ZipArchive')) {
            out(red('  ✗ PHP zip extension is required.'));
            exit(1);
        }
        $modDir = modulesPath() . '/' . $moduleId;
        if (!is_dir($modDir)) {
            out(red("  ✗ Module '{$moduleId}' not found in modules/."));
            exit(1);
        }

        if ($zipOut === '') {
            $zipOut = BASE_PATH . '/storage/' . $moduleId . '-' . date('Ymd-His') . '.zip';
        } elseif (!str_starts_with($zipOut, '/')) {
            $zipOut = BASE_PATH . '/' . ltrim($zipOut, '/');
        }
        $zipDir = dirname($zipOut);
        if (!is_dir($zipDir)) {
            @mkdir($zipDir, 0775, true);
        }

        $zip = new ZipArchive();
        if ($zip->open($zipOut, ZipArchive::CREATE | ZipArchive::OVERWRITE) !== true) {
            out(red('  ✗ Cannot create zip file.'));
            exit(1);
        }

        $rootLen = strlen(rtrim($modDir, '/')) + 1;
        $it = new RecursiveDirectoryIterator($modDir, FilesystemIterator::SKIP_DOTS);
        $files = new RecursiveIteratorIterator($it);
        foreach ($files as $f) {
            /** @var SplFileInfo $f */
            if (!$f->isFile()) continue;
            $fullPath = $f->getRealPath();
            if ($fullPath === false) continue;
            $rel = substr($fullPath, $rootLen);
            $rel = str_replace('\\', '/', $rel);
            $zip->addFile($fullPath, $rel);
        }
        $zip->close();

        out(green('  ✓ packed') . ' ' . cyan($moduleId) . ' → ' . dim($zipOut));
        break;

    // ── module:uninstall ────────────────────────────────────────
    case 'module:uninstall':
        $clean = paramsWithoutFlags($params);
        $moduleId = $clean[0] ?? '';
        if ($moduleId === '') {
            out(red('  ✗ Module id required.'));
            out('  Usage: php ikabud module:uninstall <id> [--purge] [--export] [--export-dir=path]');
            exit(1);
        }

        $opts = [];
        if (hasFlag('--purge')) {
            $opts['purge'] = true;
        }
        if (hasFlag('--export')) {
            $opts['export'] = true;
        }
        $exportDir = getFlagValue('--export-dir=');
        if ($exportDir !== null && $exportDir !== '') {
            $opts['export_dir'] = $exportDir;
        }

        $res = uninstallModule($moduleId, $opts);
        if (!empty($res['ok'])) {
            out(green("  ✓ module '{$moduleId}' uninstalled"));
            if (!empty($res['export']) && is_array($res['export'])) {
                $dir = (string)($res['export']['dir'] ?? '');
                $count = is_array($res['export']['files'] ?? null) ? count($res['export']['files']) : 0;
                if ($dir !== '') {
                    out('  ' . green('✓') . ' exported ' . $count . ' table(s) → ' . dim($dir));
                }
            }
            break;
        }
        out(red('  ✗ uninstall failed: ') . ($res['error'] ?? 'unknown'));
        exit(1);

    // ── module:validate ──────────────────────────────────────────
    case 'module:validate':
        $clean = paramsWithoutFlags($params);
        $moduleId = $clean[0] ?? '';
        if ($moduleId === '') {
            out(red('  ✗ Module id required.'));
            out('  Usage: php ikabud module:validate <module-id>');
            exit(1);
        }

        if (hasFlag('--with-modules')) {
            loadModuleRoutes(['GET' => [], 'POST' => [], 'PUT' => [], 'DELETE' => []]);
        }
        $mods = discoverModules();
        if (!isset($mods[$moduleId])) {
            out(red("  ✗ Module '{$moduleId}' not found."));
            exit(1);
        }

        $check = validateModuleCapabilities($mods[$moduleId]);
        banner();
        out('  ' . bold('Module Validate: ') . cyan($moduleId));
        out('');

        if (empty($check['ok'])) {
            out('  ' . red('✗ invalid capabilities manifest') . ' — ' . ($check['error'] ?? 'unknown'));
            exit(1);
        }

        $deps = $check['depends'] ?? [];
        $exposes = $check['exposes'] ?? [];

        out('  ' . bold('exposes') . ': ' . dim((string)count($exposes)));
        foreach ($exposes as $e) {
            $id = (string)($e['id'] ?? '');
            $pri = (int)($e['priority'] ?? 10);
            $modes = implode(',', (array)($e['modes'] ?? []));
            out('    - ' . cyan($id) . ' priority=' . $pri . ' modes=' . dim($modes));
        }
        out('');

        out('  ' . bold('depends') . ': ' . dim((string)count($deps)));
        $missing = [];
        foreach ($deps as $d) {
            $d = (string)$d;
            $ok = app()->capabilities()->has($d);
            out('    - ' . ($ok ? green('✓') : red('✗')) . ' ' . cyan($d));
            if (!$ok) $missing[] = $d;
        }
        out('');

        if (!empty($missing)) {
            out(red('  ✗ missing required capability providers'));
            exit(2);
        }
        out(green('  ✓ ok'));
        break;

    // ── module:graph ─────────────────────────────────────────────
    case 'module:graph':
        banner();
        out('  ' . bold('Module Dependency Graph'));
        out('');

        loadModuleRoutes(['GET' => [], 'POST' => [], 'PUT' => [], 'DELETE' => []]);

        $allMods = discoverModules();
        $registry = app()->capabilities();

        // Build provider map: capabilityId => [providerId, ...]
        $providerMap = [];
        foreach ($registry->capabilityIds() as $cid) {
            foreach ($registry->providers($cid) as $p) {
                $pid = (string)($p['provider'] ?? '');
                if ($pid !== '') {
                    $providerMap[$cid][] = $pid;
                }
            }
        }

        // Build dependency map: moduleId => [capabilityId, ...]
        $dependsMap = [];
        $exposesMap = [];
        foreach ($allMods as $mid => $manifest) {
            $check = validateModuleCapabilities($manifest);
            if (empty($check['ok'])) continue;
            $dependsMap[$mid] = array_values($check['depends'] ?? []);
            foreach (($check['exposes'] ?? []) as $e) {
                $cid = (string)($e['id'] ?? '');
                if ($cid !== '') {
                    $exposesMap[$mid][] = $cid;
                }
            }
        }

        // Compute edges: moduleA depends on moduleB if moduleA depends on a capability that moduleB provides
        $edges = [];
        foreach ($dependsMap as $mid => $deps) {
            foreach ($deps as $capId) {
                $providers = $providerMap[$capId] ?? [];
                foreach ($providers as $pid) {
                    if ($pid !== $mid && $pid !== 'kernel') {
                        $edges[$mid][$pid] = true;
                    }
                }
            }
        }

        // Also track kernel dependencies
        $kernelDeps = [];
        foreach ($dependsMap as $mid => $deps) {
            foreach ($deps as $capId) {
                $providers = $providerMap[$capId] ?? [];
                if (in_array('kernel', $providers, true)) {
                    $kernelDeps[$mid][] = $capId;
                }
            }
        }

        // Display graph
        $targetModule = paramsWithoutFlags($params)[0] ?? '';

        if ($targetModule !== '') {
            out('  ' . bold('Impact analysis: ') . cyan($targetModule));
            out('');

            $exposes = $exposesMap[$targetModule] ?? [];
            if (!empty($exposes)) {
                out('  ' . bold('Provides:'));
                foreach ($exposes as $cid) {
                    out('    ' . green($cid));
                }
                out('');
            }

            $deps = $dependsMap[$targetModule] ?? [];
            if (!empty($deps)) {
                out('  ' . bold('Depends on:'));
                foreach ($deps as $cid) {
                    $providers = $providerMap[$cid] ?? ['?'];
                    out('    ' . cyan($cid) . ' → ' . dim(implode(', ', $providers)));
                }
                out('');
            }

            $dependents = [];
            foreach ($edges as $dependent => $providers) {
                if (isset($providers[$targetModule])) {
                    $dependents[] = $dependent;
                }
            }
            if (!empty($dependents)) {
                out('  ' . bold('Depended on by:'));
                foreach ($dependents as $dep) {
                    out('    ' . yellow($dep));
                }
                out('');
                out('  ' . red('⚠ Disabling ' . $targetModule . ' would break: ' . implode(', ', $dependents)));
            } else {
                out('  ' . green('✓ No modules depend on ' . $targetModule));
            }
            out('');
        } else {
            $hasEdges = false;
            foreach ($allMods as $mid => $manifest) {
                $exp = $exposesMap[$mid] ?? [];
                $moduleEdges = $edges[$mid] ?? [];
                $kDeps = $kernelDeps[$mid] ?? [];

                if (empty($exp) && empty($moduleEdges) && empty($kDeps)) {
                    continue;
                }

                $hasEdges = true;
                out('  ' . cyan($mid));
                if (!empty($exp)) {
                    out('    provides: ' . dim(implode(', ', $exp)));
                }
                if (!empty($kDeps)) {
                    out('    kernel deps: ' . dim(implode(', ', $kDeps)));
                }
                if (!empty($moduleEdges)) {
                    out('    module deps: ' . yellow(implode(', ', array_keys($moduleEdges))));
                }
                out('');
            }

            if (!$hasEdges) {
                out('  ' . dim('No inter-module dependencies found.'));
            }
        }
        break;

    // ── make:module ──────────────────────────────────────────────
    case 'make:module':
        $name = $params[0] ?? '';
        if ($name === '') {
            out(red('  ✗ Module name required.'));
            out('  Usage: php ikabud make:module <name>');
            out('  Example: php ikabud make:module hr');
            exit(1);
        }

        // Normalize: lowercase, hyphens
        $id = strtolower(preg_replace('/[^a-zA-Z0-9\-]/', '-', $name));
        $id = preg_replace('/-+/', '-', trim($id, '-'));

        // Pretty label
        $label = ucwords(str_replace('-', ' ', $id));

        $modulePath = BASE_PATH . '/modules/' . $id;
        $templatePath = BASE_PATH . '/templates/modules/' . $id;

        if (is_dir($modulePath)) {
            out(red("  ✗ Module '{$id}' already exists at {$modulePath}"));
            exit(1);
        }

        banner();
        out('  Creating module: ' . bold($id));
        out('');

        // Create directories
        $dirs = [
            $modulePath,
            $modulePath . '/migrations',
            $modulePath . '/helpers',
            $templatePath . '/pages',
            $templatePath . '/partials',
        ];
        foreach ($dirs as $dir) {
            @mkdir($dir, 0775, true);
            out('  ' . green('✓') . ' mkdir ' . dim(str_replace(BASE_PATH . '/', '', $dir)));
        }

        // module.json
        $manifest = [
            'id' => $id,
            'name' => $label,
            'version' => '1.0.0',
            'description' => "{$label} module for Ikabud Kernel",
            'author' => '',
            'requires_tables' => [],
            'owns_tables' => [],
            'reads_tables' => [],
            'migrations' => [],
            'settings' => [],
            'hooks' => [],
            'nav' => [
                [
                    'label' => $label,
                    'url' => '/admin/' . $id,
                    'icon' => 'box',
                    'roles' => ['admin'],
                ],
            ],
        ];
        file_put_contents(
            $modulePath . '/module.json',
            json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n"
        );
        out('  ' . green('✓') . ' create module.json');

        $funcPrefix = str_replace('-', '', ucwords($id, '-'));

        // routes.php
        $routesContent = <<<PHP
<?php
/**
 * {$label} Module — Routes
 */

return [
    'GET' => [
        '/admin/{$id}' => '{$id}:page{$funcPrefix}Home',
    ],
    'POST' => [
        // '/api/v1/modules/{$id}/action' => '{$id}:apiAction',
    ],
];
PHP;
        file_put_contents($modulePath . '/routes.php', $routesContent . "\n");
        out('  ' . green('✓') . ' create routes.php');

        // handlers.php
        $handlersContent = <<<PHP
<?php
/**
 * {$label} Module — Handlers
 */

declare(strict_types=1);

/**
 * GET /admin/{$id} — Main page
 */
function page{$funcPrefix}Home(array \$params = []): void
{
    \$ctx = module();
    if (!\$ctx) {
        http_response_code(500);
        echo 'Module context unavailable';
        return;
    }

    \$ctx->requireAnyRole('admin', 'supervisor');

    echo \$ctx->render('modules/{$id}/pages/home.disyl', [
        'page_title' => '{$label}',
    ]);
}
PHP;
        file_put_contents($modulePath . '/handlers.php', $handlersContent . "\n");
        out('  ' . green('✓') . ' create handlers.php');

        // helpers.php (optional, loaded at boot)
        $helpersContent = <<<PHP
<?php
/**
 * {$label} Module — Helpers
 * 
 * This file is auto-loaded when the module is enabled.
 * Register event listeners, hook callbacks, and shared functions here.
 */

declare(strict_types=1);

// Example: listen to inter-module events
// app()->events()->listen('order.placed', function (array \$payload, string \$event) {
//     // handle event
// }, 10, '{$id}');
PHP;
        file_put_contents($modulePath . '/helpers.php', $helpersContent . "\n");
        out('  ' . green('✓') . ' create helpers.php');

        // Initial migration
        $migrationContent = <<<SQL
-- {$label} Module — Initial Schema
-- Created: DATE_PLACEHOLDER

-- Add your tables here. Example:
-- CREATE TABLE IF NOT EXISTS {$id}_items (
--     id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
--     name VARCHAR(100) NOT NULL,
--     is_active TINYINT(1) NOT NULL DEFAULT 1,
--     created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
--     updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
-- ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
SQL;
        $migrationContent = str_replace('DATE_PLACEHOLDER', date('Y-m-d'), $migrationContent);
        file_put_contents($modulePath . '/migrations/001_initial.sql', $migrationContent . "\n");
        out('  ' . green('✓') . ' create migrations/001_initial.sql');

        // Template: home page
        $templateContent = <<<DISYL
{extends "layouts/app.disyl"}

{block head}
<style>
    .{$id}-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    .{$id}-header h2 { font-size: var(--font-size-h2); font-weight: 700; }
</style>
{/block}

{block content}
<div class="{$id}-header">
    <div>
        <h2>{$label}</h2>
        <span class="text-sm text-muted">Module is ready. Start building!</span>
    </div>
</div>

<div class="card">
    <div class="card-body" style="padding:32px;text-align:center;color:var(--text-muted);">
        <div style="font-size:48px;margin-bottom:12px;">📦</div>
        <div style="font-weight:600;">Module scaffolded successfully</div>
        <div class="text-sm" style="margin-top:4px;">
            Edit <code>modules/{$id}/handlers.php</code> and
            <code>templates/modules/{$id}/pages/home.disyl</code> to get started.
        </div>
    </div>
</div>
{/block}
DISYL;
        file_put_contents($templatePath . '/pages/home.disyl', $templateContent . "\n");
        out('  ' . green('✓') . ' create templates/pages/home.disyl');

