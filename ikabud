        }

        banner();
        out('  ' . green('✓') . ' Added handler: ' . cyan($handlerName) . ' to ' . dim("modules/{$moduleId}/handlers.php"));
        if ($routeAdded) {
            out('  ' . green('✓') . ' Added route:   ' . cyan("{$method} {$routePath}") . ' to ' . dim("modules/{$moduleId}/routes.php"));
        } else {
            out('  ' . yellow('⚠') . ' Could not auto-add route. Add manually to routes.php:');
            out("    '{$routePath}' => '{$moduleId}:{$handlerName}'");
        }
        out('');
        break;

    // ── disyl:lint ───────────────────────────────────────────────
    case 'disyl:lint':
        banner();
        $clean = paramsWithoutFlags($params);
        $targetPath = $clean[0] ?? '';
        $verbose = hasFlag('--verbose');
        $fixSuggestions = hasFlag('--fix');

        // Determine files to lint
        $files = [];
        if ($targetPath !== '') {
            $fullPath = realpath(BASE_PATH . '/' . $targetPath) ?: realpath($targetPath);
            if (!$fullPath) {
                out(red("  ✗ Path not found: {$targetPath}"));
                exit(1);
            }
            if (is_file($fullPath) && str_ends_with($fullPath, '.disyl')) {
                $files[] = $fullPath;
            } elseif (is_dir($fullPath)) {
                $iter = new RecursiveIteratorIterator(
                    new RecursiveDirectoryIterator($fullPath, FilesystemIterator::SKIP_DOTS)
                );
                foreach ($iter as $finfo) {
                    if ($finfo->isFile() && str_ends_with($finfo->getFilename(), '.disyl')) {
                        $files[] = $finfo->getPathname();
                    }
                }
            } else {
                out(red("  ✗ Not a .disyl file or directory: {$targetPath}"));
                exit(1);
            }
        } else {
            // Scan all template directories
            $scanDirs = [
                BASE_PATH . '/templates',
            ];
            // Add module template dirs and module public dirs (ecommerce, cms, etc.)
            foreach (glob(BASE_PATH . '/modules/*/') as $modDir) {
                $modTemplates = $modDir . 'templates';
                if (is_dir($modTemplates)) {
                    $scanDirs[] = $modTemplates;
                }
                // Also scan module public/ and other top-level .disyl locations
                foreach (['public', 'views', 'pages'] as $subDir) {
                    $candidate = rtrim($modDir, '/') . '/' . $subDir;
                    if (is_dir($candidate)) {
                        $scanDirs[] = $candidate;
                    }
                }
            }
            foreach ($scanDirs as $dir) {
                if (!is_dir($dir)) continue;
                $iter = new RecursiveIteratorIterator(
                    new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS)
                );
                foreach ($iter as $finfo) {
                    if ($finfo->isFile() && str_ends_with($finfo->getFilename(), '.disyl')) {
                        $files[] = $finfo->getPathname();
                    }
                }
            }
        }

        sort($files);
        $fileCount = count($files);

        // ── Contract map builder ─────────────────────────────────
        // Statically extract template-to-declared-key mappings from module
        // helper files that call kernelRegisterRenderContextContract().
        // Only contracts with explicit 'required' or 'defaults' keys are
        // included — contracts that rely solely on a normalize callback are
        // skipped to avoid false-positive warnings.

        /** Find the contents of a PHP array block starting at $openPos.
         *  Returns the full substring from '[' to its matching ']'. */
        function disylExtractArrayBlock(string $src, int $openPos): string
        {
            $depth = 0;
            $end = -1;
            for ($i = $openPos, $len = strlen($src); $i < $len; $i++) {
                if ($src[$i] === '[') {
                    $depth++;
                } elseif ($src[$i] === ']') {
                    $depth--;
                    if ($depth === 0) {
                        $end = $i;
                        break;
                    }
                }
            }
            return $end !== -1 ? substr($src, $openPos, $end - $openPos + 1) : '';
        }

        /**
         * @return array<string, list<string>>  key is template path or 'prefix:pfx',
         *                                       value is list of declared variable root names
         */
        function disylBuildContractMap(): array
        {
            $contractMap = [];
            $sources = [];

            if (is_dir(BASE_PATH . '/modules')) {
                $phpFiles = new RecursiveIteratorIterator(
                    new RecursiveDirectoryIterator(BASE_PATH . '/modules', FilesystemIterator::SKIP_DOTS)
                );
                foreach ($phpFiles as $phpFile) {
                    if (!$phpFile->isFile() || $phpFile->getExtension() !== 'php') {
                        continue;
                    }
                    $src = file_get_contents($phpFile->getPathname());
                    if (strpos($src, 'kernelRegisterRenderContextContract(') !== false) {
                        $sources[] = $src;
                    }
                }
            }

            foreach ($sources as $src) {
                $offset = 0;
                while (($pos = strpos($src, 'kernelRegisterRenderContextContract(', $offset)) !== false) {
                    // Find the opening '[' of the definition array
                    $bracketStart = strpos($src, '[', $pos);
                    if ($bracketStart === false) {
                        $offset = $pos + 1;
                        continue;
                    }
                    $defBlock = disylExtractArrayBlock($src, $bracketStart);
                    if ($defBlock === '') {
                        $offset = $pos + 1;
                        continue;
                    }

                    // Extract template path matchers
                    $templates = [];
                    $prefixes  = [];
                    if (preg_match("/'template'\s*=>\s*'([^']+)'/", $defBlock, $m)) {
                        $templates[] = $m[1];
                    }
                    if (preg_match("/'templates'\s*=>\s*(\[)/", $defBlock, $m, PREG_OFFSET_CAPTURE)) {
                        $tplBlock = disylExtractArrayBlock($defBlock, $m[1][1]);
                        preg_match_all("/'([^']+\.disyl)'/", $tplBlock, $ms);
                        $templates = array_merge($templates, $ms[1]);
                    }
                    if (preg_match("/'prefix'\s*=>\s*'([^']+)'/", $defBlock, $m)) {
                        $prefixes[] = $m[1];
                    }
                    if (preg_match("/'prefixes'\s*=>\s*(\[)/", $defBlock, $m, PREG_OFFSET_CAPTURE)) {
                        $pfxBlock = disylExtractArrayBlock($defBlock, $m[1][1]);
                        preg_match_all("/'([^']+)'/", $pfxBlock, $ms);
                        $prefixes = array_merge($prefixes, $ms[1]);
                    }

                    if ($templates === [] && $prefixes === []) {
                        $offset = $bracketStart + strlen($defBlock);
                        continue;
                    }

                    // Extract declared keys from 'required' and 'defaults'
                    $declaredKeys = [];
                    if (preg_match("/'required'\s*=>\s*(\[)/", $defBlock, $m, PREG_OFFSET_CAPTURE)) {
                        $reqBlock = disylExtractArrayBlock($defBlock, $m[1][1]);
                        preg_match_all("/'([a-zA-Z_][a-zA-Z0-9_]*)'/", $reqBlock, $ms);
                        $declaredKeys = array_merge($declaredKeys, $ms[1]);
                    }
                    if (preg_match("/'defaults'\s*=>\s*(\[)/", $defBlock, $m, PREG_OFFSET_CAPTURE)) {
                        $dflBlock = disylExtractArrayBlock($defBlock, $m[1][1]);
                        preg_match_all("/'([a-zA-Z_][a-zA-Z0-9_]*)'\s*=>/", $dflBlock, $ms);
                        $declaredKeys = array_merge($declaredKeys, $ms[1]);
                    }

                    // Skip contracts with no explicit declared keys — normalize-only
                    // contracts are opaque to static analysis
                    if (empty($declaredKeys)) {
                        $offset = $bracketStart + strlen($defBlock);
                        continue;
                    }

                    $declaredKeys = array_values(array_unique($declaredKeys));
                    foreach ($templates as $tpl) {
                        $contractMap[$tpl] = array_values(array_unique(
                            array_merge($contractMap[$tpl] ?? [], $declaredKeys)
                        ));
                    }
                    foreach ($prefixes as $pfx) {
                        $key = 'prefix:' . $pfx;
                        $contractMap[$key] = array_values(array_unique(
                            array_merge($contractMap[$key] ?? [], $declaredKeys)
                        ));
                    }

                    $offset = $bracketStart + strlen($defBlock);
                }
            }

            return $contractMap;
        }

        $contractMap = disylBuildContractMap();

        out('  ' . bold('DiSyL Template Linter'));
        out('  Scanning ' . cyan((string)$fileCount) . ' template(s)...');
        out('');

        $totalErrors = 0;
        $totalWarnings = 0;
        $filesWithIssues = 0;

        // Tag pairs that must be balanced
        $tagPairs = [
            'if'      => '/if',
            'for'     => '/for',
            'foreach' => '/foreach',
            'each'    => '/each',
            'verbatim'=> '/verbatim',
            'literal' => '/literal',
        ];

        foreach ($files as $file) {
            $relPath = str_replace(BASE_PATH . '/', '', $file);
            $content = file_get_contents($file);
            $lines = explode("\n", $content);
            $issues = [];

            // Strip DiSyL comments and JS single-line comments to avoid false positives
            $lintContent = preg_replace('/\{!--.*?--\}/s', '', $content);  // DiSyL comments
            $lintContent = preg_replace('#//[^\n]*#', '', $lintContent);   // JS single-line comments

            // ── Check 1: Unmatched control structure tags ──
            foreach ($tagPairs as $open => $close) {
                $openPattern  = '/\{' . preg_quote($open, '/') . '[\s}]/';
                $closePattern = '/\{\/' . preg_quote($open, '/') . '\}/';

                preg_match_all($openPattern, $lintContent, $openMatches, PREG_OFFSET_CAPTURE);
                preg_match_all($closePattern, $lintContent, $closeMatches, PREG_OFFSET_CAPTURE);

                $openCount = count($openMatches[0]);
                $closeCount = count($closeMatches[0]);

                if ($openCount > $closeCount) {
                    $diff = $openCount - $closeCount;
                    // Find line of last unmatched open
                    $lastOpen = end($openMatches[0]);
                    $lineNum = $lastOpen ? substr_count($content, "\n", 0, $lastOpen[1]) + 1 : 0;
                    $issues[] = ['type' => 'error', 'line' => $lineNum,
                        'msg' => "{$diff} unclosed {" . $open . "} tag(s) — missing {" . $close . "}"];
                } elseif ($closeCount > $openCount) {
                    $diff = $closeCount - $openCount;
                    $lastClose = end($closeMatches[0]);
                    $lineNum = $lastClose ? substr_count($content, "\n", 0, $lastClose[1]) + 1 : 0;
                    $issues[] = ['type' => 'error', 'line' => $lineNum,
                        'msg' => "{$diff} extra {" . $close . "} tag(s) without matching {" . $open . "}"];
                }
            }

            // ── Check 2: {elseif}/{else} without enclosing {if} ──
            // Simple heuristic: every {else} or {elseif} should appear between an {if} and {/if}
            if (preg_match_all('/\{else(?:if\s[^}]*)?\}/', $lintContent, $elseMatches, PREG_OFFSET_CAPTURE)) {
                $ifOpens  = [];
                $ifCloses = [];
                preg_match_all('/\{if\s/', $lintContent, $ifO, PREG_OFFSET_CAPTURE);
                preg_match_all('/\{\/if\}/', $lintContent, $ifC, PREG_OFFSET_CAPTURE);
                foreach ($ifO[0] as $m) $ifOpens[] = $m[1];
                foreach ($ifC[0] as $m) $ifCloses[] = $m[1];

                foreach ($elseMatches[0] as $em) {
                    $pos = $em[1];
                    // Count opens before this pos and closes before this pos
                    $opensBefore = count(array_filter($ifOpens, fn($p) => $p < $pos));
                    $closesBefore = count(array_filter($ifCloses, fn($p) => $p < $pos));
                    if ($opensBefore <= $closesBefore) {
                        $lineNum = substr_count($content, "\n", 0, $pos) + 1;
                        $tag = trim($em[0], '{}');
                        $issues[] = ['type' => 'error', 'line' => $lineNum,
                            'msg' => "{{$tag}} appears outside any {if} block"];
                    }
                }
            }

            // ── Check 3: Unclosed component tags ──
            if (preg_match_all('/\{(ikb_\w+)[\s}]/', $lintContent, $compMatches)) {
                foreach (array_unique($compMatches[1]) as $comp) {
                    // Count opens (non-self-closing) and closes
                    // Self-closing: {ikb_foo ... /}
                    preg_match_all('/\{' . preg_quote($comp, '/') . '(?:\s[^}]*)?\}/', $lintContent, $allOpens);
                    preg_match_all('/\{' . preg_quote($comp, '/') . '(?:\s[^}]*)?\s*\/\s*\}/', $lintContent, $selfClosing);
                    preg_match_all('/\{\/' . preg_quote($comp, '/') . '\}/', $lintContent, $compCloses);

                    $opens = count($allOpens[0]) - count($selfClosing[0]);
                    $closes = count($compCloses[0]);

                    if ($opens > $closes) {
                        $issues[] = ['type' => 'warning', 'line' => 0,
                            'msg' => ($opens - $closes) . " unclosed {{$comp}} component(s) — missing {/{$comp}}"];
                    }
                }
            }

            // ── Check 4: {include} references check ──
            if (preg_match_all('/\{include\s+"([^"]+)"/', $content, $incMatches)) {
                $templateDirs = [
                    BASE_PATH . '/templates',
                ];
                foreach ($incMatches[1] as $incRef) {
                    $found = false;
                    foreach ($templateDirs as $tdir) {
                        $incPath = $tdir . '/' . $incRef;
                        if (!str_ends_with($incPath, '.disyl')) $incPath .= '.disyl';
                        if (file_exists($incPath)) {
                            $found = true;
                            break;
                        }
                    }
                    if (!$found) {
                        $issues[] = ['type' => 'warning', 'line' => 0,
                            'msg' => "Include not found: \"{$incRef}\" — file may be missing or in a module template dir"];
                    }
                }
            }

            // ── Check 5: {extends} layout reference ──
            if (preg_match('/\{extends\s+"([^"]+)"\s*\}/', $content, $extMatch)) {
                $layoutRef = $extMatch[1];
                $layoutPath = BASE_PATH . '/templates/' . $layoutRef;
                if (!str_ends_with($layoutPath, '.disyl')) $layoutPath .= '.disyl';
                if (!file_exists($layoutPath)) {
                    $issues[] = ['type' => 'warning', 'line' => 1,
                        'msg' => "Layout not found: \"{$layoutRef}\""];
                }
            }

            // ── Check 6: Empty control structure bodies ──
            foreach (['if', 'for', 'foreach', 'each'] as $tag) {
                $pattern = '/\{' . $tag . '\s+[^}]+\}\s*\{\/' . $tag . '\}/s';
                if (preg_match_all($pattern, $lintContent, $emptyMatches, PREG_OFFSET_CAPTURE)) {
                    foreach ($emptyMatches[0] as $em) {
                        $lineNum = substr_count($content, "\n", 0, $em[1]) + 1;
                        $issues[] = ['type' => 'warning', 'line' => $lineNum,
                            'msg' => "Empty {{$tag}} body — control structure has no content"];
                    }
                }
            }

            // ── Check 7: Likely typos — {/foreach} closing wrong tag ──
            // For each close tag, verify there's a matching open before it
            foreach (['for' => 'foreach', 'foreach' => 'for'] as $closeTag => $confusedWith) {
                preg_match_all('/\{\/' . preg_quote($closeTag, '/') . '\}/', $lintContent, $cMatches, PREG_OFFSET_CAPTURE);
                preg_match_all('/\{' . preg_quote($closeTag, '/') . '\s/', $lintContent, $oMatches, PREG_OFFSET_CAPTURE);
                // If there are closes but no opens, it's likely a typo
                if (count($cMatches[0]) > 0 && count($oMatches[0]) === 0) {
                    $lineNum = substr_count($content, "\n", 0, $cMatches[0][0][1]) + 1;
                    $issues[] = ['type' => 'warning', 'line' => $lineNum,
                        'msg' => "{/{$closeTag}} found but no {{$closeTag}} — did you mean {/{$confusedWith}}?"];
                }
            }

            // ── Check 8: Contract-aware variable root check ──
            // Fires only when a contract with explicit required/defaults keys
            // matches the current template; warns about variable roots that are
            // not declared in the contract or provided by the kernel base context.
            $matchedDeclaredKeys = null;
            if (isset($contractMap[$relPath])) {
                $matchedDeclaredKeys = $contractMap[$relPath];
            }
            if ($matchedDeclaredKeys === null) {
                foreach ($contractMap as $mapKey => $mapKeys) {
                    if (str_starts_with($mapKey, 'prefix:')) {
                        $pfx = substr($mapKey, 7);
                        if ($pfx !== '' && str_starts_with($relPath, $pfx)) {
                            $matchedDeclaredKeys = array_values(array_unique(
                                array_merge($matchedDeclaredKeys ?? [], $mapKeys)
                            ));
                        }
                    }
                }
            }

            if ($matchedDeclaredKeys !== null) {
                // Kernel base context always provides these roots
                $kernelBaseKeys = [
                    'user', 'nav_items', 'gui', 'base_url', 'request_uri',
                    'page_meta', 'module_settings', 'csrf_token', 'flash',
                    'errors', 'site_name', 'loop',
                ];

                // Collect loop-scoped variable names declared inside the template
                $loopVars = [];
                preg_match_all('/\{foreach\s+\S+\s+as\s+([a-zA-Z_][a-zA-Z0-9_]*)\s*\}/', $lintContent, $lm);
                $loopVars = array_merge($loopVars, $lm[1] ?? []);
                preg_match_all('/\{each\s+\S+\s+as\s+([a-zA-Z_][a-zA-Z0-9_]*)\s*\}/', $lintContent, $lm);
                $loopVars = array_merge($loopVars, $lm[1] ?? []);
                preg_match_all('/\{for\s+([a-zA-Z_][a-zA-Z0-9_]*)\s+in\s+/', $lintContent, $lm);
                $loopVars = array_merge($loopVars, $lm[1] ?? []);

                // Collect {set}-declared variable names
                $setVars = [];
                preg_match_all('/\{set\s+([a-zA-Z_][a-zA-Z0-9_]*)\s*=/', $lintContent, $sm);
                $setVars = $sm[1] ?? [];

                // DiSyL keywords that look like variables but are not data roots
                $disylKeywords = [
                    'if', 'elseif', 'else', 'endif', 'for', 'foreach', 'each',
                    'set', 'include', 'extends', 'block', 'endblock', 'literal',
                    'verbatim', 'empty', 'component', 'slot', 'props', 'end',
                    'partial', 'yield', 'true', 'false', 'null',
                ];

                // Extract all bare variable root names from the template
                preg_match_all('/\{([a-zA-Z_][a-zA-Z0-9_]*)[\s.\|}\[]/m', $lintContent, $vm);
                $usedRoots = array_unique($vm[1] ?? []);

                $allAllowed = array_merge($kernelBaseKeys, $matchedDeclaredKeys, $loopVars, $setVars);
                foreach ($usedRoots as $root) {
                    if (in_array($root, $disylKeywords, true)) {
                        continue;
                    }
                    if (in_array($root, $allAllowed, true)) {
                        continue;
                    }
                    $issues[] = [
                        'type' => 'warning',
                        'line' => 0,
                        'msg'  => "Variable root \"{$root}\" is not declared in the matched render contract (not in required/defaults)",
                    ];
                }
            }

            // ── Check 9: Nested {block} detection ──
            // The regex-based DiSyL compiler cannot handle {block} tags nested
            // inside other {block} bodies.  Catch this at lint time.
            $blockBodies = [];
            preg_match_all('/\{block\s+([a-zA-Z_][a-zA-Z0-9_]*)\s*\}(.*?)\{\/block\}/s', $lintContent, $bm, PREG_SET_ORDER);
            foreach ($bm as $blockMatch) {
                $innerContent = $blockMatch[2];
                if (preg_match('/\{block\s+[a-zA-Z_][a-zA-Z0-9_]*\s*\}/', $innerContent)) {
                    $lineNum = substr_count($content, "\n", 0, (int)$blockMatch[0][1]) + 1;
                    $issues[] = [
                        'type' => 'error',
                        'line' => $lineNum,
                        'msg'  => "Nested {block} inside '{$blockMatch[1]}' — the DiSyL compiler does not support nested blocks",
                    ];
                }
            }

            // ── Report ──
            if (!empty($issues)) {
                $filesWithIssues++;
                out('  ' . bold($relPath));
                usort($issues, fn($a, $b) => $a['line'] <=> $b['line']);
                foreach ($issues as $issue) {
                    $icon = $issue['type'] === 'error' ? red('✗') : yellow('⚠');
                    $lineLabel = $issue['line'] > 0 ? dim("L{$issue['line']}") . ' ' : '';
                    $typeLabel = $issue['type'] === 'error' ? red('error') : yellow('warn');
                    out("    {$icon} {$lineLabel}{$typeLabel}: {$issue['msg']}");

                    if ($issue['type'] === 'error') $totalErrors++;
                    else $totalWarnings++;
                }
                out('');
            } elseif ($verbose) {
                out('  ' . green('✓') . ' ' . dim($relPath));
            }
        }

        // ── Check 10: Entity view ↔ handler field cross-reference ──
        // After scanning all templates, cross-check entity view field
        // declarations against EntityListQuery column maps.
        {
            $entityViewMap = [];  // "entity_type.view" => ['fields' => [...], 'file' => ...]
            $handlerColMap = [];  // "entity.list.entity_type" => ['columns' => [...], 'file' => ...]

            // Scan entity-views.php files for registered views
            foreach (glob(BASE_PATH . '/modules/*/helpers/entity-views.php') as $evFile) {
                $evContent = file_get_contents($evFile);
                preg_match_all(
                    "/'([a-zA-Z_][a-zA-Z0-9_]*)'\s*=>\s*\[(.*?)\]\s*\]/s",
                    $evContent, $evMatches, PREG_SET_ORDER
                );
                foreach ($evMatches as $m) {
                    $viewName = $m[1];
                    $viewBlock = $m[2];
                    if (preg_match("/'fields'\s*=>\s*\[([^\]]*)\]/s", $viewBlock, $fm)) {
                        preg_match_all("/'([a-zA-Z_][a-zA-Z0-9_]*)'/", $fm[1], $fieldNames);
                        $fields = $fieldNames[1] ?? [];
                        if (!empty($fields) && $fields !== ['*']) {
                            if (preg_match("/function\s+(\w+)_entity_views/", $evContent, $fnMatch)) {
                                $entityType = str_replace('_', '.', $fnMatch[1]);
                            } else {
                                $entityType = basename(dirname(dirname($evFile)));
                            }
                            $entityViewMap["{$entityType}.{$viewName}"] = ['fields' => $fields, 'file' => $evFile];
                        }
                    }
                }
            }

            // Scan helpers.php files for EntityListQuery::run( column maps
            foreach (glob(BASE_PATH . '/modules/*/helpers.php') as $hlpFile) {
                $hlpContent = file_get_contents($hlpFile);
                preg_match_all(
                    '/EntityListQuery::run\s*\(\s*[^,]+,\s*[^,]+,\s*\[(.*?)\]\s*,/s',
                    $hlpContent, $qMatches, PREG_SET_ORDER
                );
                foreach ($qMatches as $qm) {
                    $mapBlock = $qm[1];
                    preg_match_all("/'([a-zA-Z_][a-zA-Z0-9_]*)'\s*=>/", $mapBlock, $colNames);
                    $columns = $colNames[1] ?? [];
                    if (preg_match('/function\s+\w+_cap_entity_list_(\w+)_\d+\s*\(/', $hlpContent, $capMatch)) {
                        $capEntity = str_replace('_', '.', $capMatch[1]);
                        $handlerColMap["entity.list.{$capEntity}"] = ['columns' => $columns, 'file' => $hlpFile];
                    }
                }
            }

            // Cross-reference: view fields vs handler columns
            $xrefIssues = [];
            foreach ($entityViewMap as $evKey => $evInfo) {
                $parts = explode('.', $evKey, 2);
                $entityType = $parts[0];
                $capId = "entity.list.{$entityType}";

                if (isset($handlerColMap[$capId])) {
                    $handlerCols = $handlerColMap[$capId]['columns'];
                    $viewFields = $evInfo['fields'];
                    $missing = array_diff($viewFields, $handlerCols);
                    if (!empty($missing)) {
                        $relView = str_replace(BASE_PATH . '/', '', $evInfo['file']);
                        $relHdlr = str_replace(BASE_PATH . '/', '', $handlerColMap[$capId]['file']);
                        $xrefIssues[] = "  " . yellow('⚠') . " warn: entity view '{$evKey}' fields [" . implode(', ', $missing) . "] not in handler column map (view: {$relView}, handler: {$relHdlr})";
                        $totalWarnings++;
                    }
                }
            }

            if (!empty($xrefIssues)) {
                out('');
                out('  ' . bold('Entity View ↔ Handler Cross-Reference'));
                foreach ($xrefIssues as $issue) {
                    out($issue);
                }
            }
        }

        // Summary
        out('  ─────────────────────────────────────────────');
        out('  Scanned: ' . cyan((string)$fileCount) . ' files');
        if ($totalErrors === 0 && $totalWarnings === 0) {
            out('  ' . green('✓ No issues found'));
        } else {
            if ($totalErrors > 0) {
                out('  Errors:   ' . red((string)$totalErrors));
            }
            if ($totalWarnings > 0) {
                out('  Warnings: ' . yellow((string)$totalWarnings));
            }
            out('  Files with issues: ' . bold((string)$filesWithIssues));
        }
        out('');
        exit($totalErrors > 0 ? 1 : 0);

    // ── disyl:list-sources ─────────────────────────────────────────
