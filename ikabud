            $modId = basename(dirname($manifestPath));
            $manifest = json_decode((string)file_get_contents($manifestPath), true);
            if (!is_array($manifest)) continue;

            $exposes = $manifest['capabilities']['exposes'] ?? [];
            foreach ($exposes as $capId => $capVer) {
                if (str_starts_with((string)$capId, 'entity.list.')) {
                    $entityType = substr((string)$capId, strlen('entity.list.'));
                    $entityType = str_replace('@' . $capVer, '', $entityType);
                    $sources[$entityType] ??= ['module' => $modId, 'views' => []];
                }
            }
        }

        // Also scan helpers/views/ directories for DiSyL view configs
        // that may declare views without explicit entity.list capabilities
