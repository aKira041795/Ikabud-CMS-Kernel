        }

        banner();
        out('  ' . bold('Module Validate: ') . cyan($moduleId));
        out('');

        $manifest = $mods[$moduleId];
        $modPath = (string)($manifest['_path'] ?? '');
        $validateFails = 0;

        // ── 1. Manifest completeness ─────────────────────────────
        out('  ' . bold('Manifest'));
        $requiredFields = ['id', 'name', 'version', 'description'];
        foreach ($requiredFields as $field) {
            $present = isset($manifest[$field]) && $manifest[$field] !== '';
            out('    ' . ($present ? green('✓') : red('✗')) . ' ' . $field . ($present ? '' : ' — missing or empty'));
            if (!$present) $validateFails++;
        }
        // id must match directory name
        $idMatch = ($manifest['id'] ?? '') === $moduleId && basename($modPath) === $moduleId;
        out('    ' . ($idMatch ? green('✓') : red('✗')) . ' id matches directory' . ($idMatch ? '' : " — manifest id '{$manifest['id']}' ≠ directory '{$moduleId}'"));
        if (!$idMatch) $validateFails++;
        // owns_tables / reads_tables must be arrays
        foreach (['owns_tables', 'reads_tables'] as $tField) {
            $isArr = isset($manifest[$tField]) && is_array($manifest[$tField]);
            out('    ' . ($isArr ? green('✓') : red('✗')) . ' ' . $tField . ' is array' . ($isArr ? '' : ' — missing or not an array'));
            if (!$isArr) $validateFails++;
        }
        out('');

        // ── 2. Capability schema + dependency resolution ──────────
        out('  ' . bold('Capabilities'));
        $check = validateModuleCapabilities($manifest);
        if (empty($check['ok'])) {
            out('    ' . red('✗') . ' invalid schema — ' . ($check['error'] ?? 'unknown'));
            $validateFails++;
        } else {
            // Register capability providers using the same module boot path as runtime.
            loadModuleRoutes(['GET' => [], 'POST' => [], 'PUT' => [], 'DELETE' => []]);

            out('    ' . green('✓') . ' schema valid');
            $deps = $check['depends'] ?? [];
            $exposes = $check['exposes'] ?? [];
            if (!empty($exposes)) {
                out('    ' . dim('exposes:'));
                foreach ($exposes as $e) {
                    $cid = (string)($e['id'] ?? '');
                    out('      ' . green('✓') . ' ' . cyan($cid));
                }
            }
            if (!empty($deps)) {
                out('    ' . dim('depends:'));
                foreach ($deps as $d) {
                    $d = (string)$d;
                    $capOk = app()->capabilities()->has($d);
                    out('      ' . ($capOk ? green('✓') : red('✗')) . ' ' . cyan($d) . ($capOk ? '' : ' — NOT satisfied'));
                    if (!$capOk) $validateFails++;
                }
            }
        }
        out('');

        // ── 3. Table ownership consistency ───────────────────────
        out('  ' . bold('Table Ownership'));
        $allOwnedTables = [];
        foreach ($mods as $mid => $m) {
            foreach ((array)($m['owns_tables'] ?? []) as $tbl) {
                $allOwnedTables[(string)$tbl][] = $mid;
            }
        }
        $ownedByThis = (array)($manifest['owns_tables'] ?? []);
        $readsByThis = (array)($manifest['reads_tables'] ?? []);
        if (empty($ownedByThis) && empty($readsByThis)) {
            out('    ' . dim('✓ no table declarations'));
        } else {
            // Check for conflicts: table owned by multiple modules
            foreach ($ownedByThis as $tbl) {
                $tbl = (string)$tbl;
                $owners = $allOwnedTables[$tbl] ?? [];
                $conflict = count($owners) > 1;
                $others = array_filter($owners, fn($o) => $o !== $moduleId);
                out('    ' . ($conflict ? red('✗') : green('✓')) . ' owns ' . cyan($tbl) . ($conflict ? ' — CONFLICT with ' . implode(', ', $others) : ''));
                if ($conflict) $validateFails++;
            }
            // Check reads_tables: must be owned by some module or note if unclaimed
            foreach ($readsByThis as $tbl) {
                $tbl = (string)$tbl;
                $owners = array_filter($allOwnedTables[$tbl] ?? [], fn($o) => $o !== $moduleId);
                $claimed = !empty($owners) || isset($allOwnedTables[$tbl]);
                out('    ' . ($claimed ? green('✓') : yellow('⚠')) . ' reads ' . cyan($tbl) . ($claimed ? '' : ' — no module declares ownership (may be a kernel table)'));
            }
        }
        out('');

        // ── 4. Route handler resolution ───────────────────────────
        out('  ' . bold('Route Handlers'));
        $routesFile = $modPath . '/routes.php';
        $handlersFile = $modPath . '/handlers.php';
        if (!is_file($routesFile)) {
            out('    ' . red('✗') . ' routes.php not found');
            $validateFails++;
        } elseif (!is_file($handlersFile)) {
            out('    ' . red('✗') . ' handlers.php not found');
            $validateFails++;
        } else {
            $moduleRoutes = require $routesFile;
            if (!is_array($moduleRoutes)) {
                out('    ' . red('✗') . ' routes.php must return an array');
                $validateFails++;
            } else {
                // Collect all handler references
                $handlerRefs = [];
                foreach ($moduleRoutes as $method => $routeMap) {
                    if (!is_array($routeMap)) continue;
                    foreach ($routeMap as $path => $handler) {
                        if (is_string($handler)) {
                            $handlerRefs[$handler] = $method . ' ' . $path;
                        }
                    }
                }

                if (empty($handlerRefs)) {
                    out('    ' . dim('✓ no routes declared'));
                } else {
                    // Load handlers file to discover functions
                    $fnsBefore = array_flip(get_defined_functions()['user'] ?? []);
                    @include_once $handlersFile;
                    $fnsAfter = array_flip(get_defined_functions()['user'] ?? []);

                    // Check each handler reference
                    foreach ($handlerRefs as $handler => $routeDesc) {
                        if (!str_contains($handler, ':')) {
                            out('    ' . red('✗') . ' ' . cyan($handler) . ' — invalid format (expected module-id:functionName)');
                            $validateFails++;
                            continue;
                        }
                        [, $fnName] = explode(':', $handler, 2);
                        $fnExists = function_exists($fnName);
                        out('    ' . ($fnExists ? green('✓') : red('✗')) . ' ' . cyan($handler) . dim(' (' . $routeDesc . ')') . ($fnExists ? '' : ' — function not found'));
                        if (!$fnExists) $validateFails++;
                    }
                }
            }
        }
        out('');

        // ── 5. Migrations declared vs present ─────────────────────
        out('  ' . bold('Migrations'));
        $declaredMigrations = (array)($manifest['migrations'] ?? []);
        if (empty($declaredMigrations)) {
            out('    ' . dim('✓ no migrations declared'));
        } else {
            foreach ($declaredMigrations as $migRel) {
                $migAbs = $modPath . '/' . ltrim((string)$migRel, '/');
                $migExists = is_file($migAbs);
                out('    ' . ($migExists ? green('✓') : red('✗')) . ' ' . $migRel . ($migExists ? '' : ' — file missing'));
                if (!$migExists) $validateFails++;
            }
        }
        out('');

        // ── 6. Auth / login layout contract ─────────────────────
        out('  ' . bold('Auth Experience'));
        $requiresModuleLoginContext = trim((string)($manifest['auth_cookie'] ?? '')) !== ''
            || is_array($manifest['auth_owned'] ?? null);
        if (!$requiresModuleLoginContext) {
            out('    ' . dim('✓ no auth-owned login contract required'));
        } else {
            $helpersFile = $modPath . '/helpers.php';
            if (is_file($helpersFile)) {
                @include_once $helpersFile;
            }

            $loginContextFn = preg_replace('/[^a-z0-9]+/i', '_', $moduleId) . 'LoginPageContext';
            $loginContextFn = is_string($loginContextFn) ? $loginContextFn : '';
            $hasLoginContext = $loginContextFn !== '' && function_exists($loginContextFn);

            out('    ' . ($hasLoginContext ? green('✓') : red('✗')) . ' module login context ' . cyan($loginContextFn)
                . ($hasLoginContext ? '' : ' — missing; auth/entry modules must define their own login layout context to avoid falling back to the kernel default skin'));
            if (!$hasLoginContext) {
                $validateFails++;
            }
        }
        out('');

        // ── Summary ───────────────────────────────────────────────
        if ($validateFails === 0) {
            out(green('  ✓ all checks passed'));
        } else {
            out(red("  ✗ {$validateFails} check(s) failed"));
            exit(2);
        }
        break;

    // ── module:graph ─────────────────────────────────────────────
    case 'module:graph':
        banner();
        out('  ' . bold('Module Dependency Graph'));
        out('');

        loadModuleRoutes(['GET' => [], 'POST' => [], 'PUT' => [], 'DELETE' => []]);

        $allMods = discoverModules();
        $registry = app()->capabilities();

        // Build provider map: capabilityId => [providerId, ...]
        $providerMap = [];
        foreach ($registry->capabilityIds() as $cid) {
            foreach ($registry->providers($cid) as $p) {
                $pid = (string)($p['provider'] ?? '');
                if ($pid !== '') {
                    $providerMap[$cid][] = $pid;
                }
            }
        }

        // Build dependency map: moduleId => [capabilityId, ...]
        $dependsMap = [];
        $exposesMap = [];
        foreach ($allMods as $mid => $manifest) {
            $check = validateModuleCapabilities($manifest);
            if (empty($check['ok'])) continue;
            $dependsMap[$mid] = array_values($check['depends'] ?? []);
            foreach (($check['exposes'] ?? []) as $e) {
                $cid = (string)($e['id'] ?? '');
                if ($cid !== '') {
                    $exposesMap[$mid][] = $cid;
                }
            }
        }

        // Compute edges: moduleA depends on moduleB if moduleA depends on a capability that moduleB provides
        $edges = [];
        foreach ($dependsMap as $mid => $deps) {
            foreach ($deps as $capId) {
                $providers = $providerMap[$capId] ?? [];
                foreach ($providers as $pid) {
                    if ($pid !== $mid && $pid !== 'kernel') {
                        $edges[$mid][$pid] = true;
                    }
                }
            }
        }

        // Also track kernel dependencies
        $kernelDeps = [];
        foreach ($dependsMap as $mid => $deps) {
            foreach ($deps as $capId) {
                $providers = $providerMap[$capId] ?? [];
                if (in_array('kernel', $providers, true)) {
                    $kernelDeps[$mid][] = $capId;
                }
            }
        }

        // Display graph
        $targetModule = paramsWithoutFlags($params)[0] ?? '';
        $format = getFlagValue('--format=') ?? 'text';

        // 4.5: Machine-readable graph output formats
        if ($format === 'mermaid') {
            out('graph TD');
            foreach ($allMods as $mid => $manifest) {
                $nodeId = str_replace('-', '_', $mid);
                $exp = $exposesMap[$mid] ?? [];
                $label = $mid . ($exp ? '\\n(' . count($exp) . ' caps)' : '');
                out('    ' . $nodeId . '["' . $label . '"]');
            }
            foreach ($edges as $from => $targets) {
                $fromId = str_replace('-', '_', $from);
                foreach (array_keys($targets) as $to) {
                    $toId = str_replace('-', '_', $to);
                    out('    ' . $fromId . ' --> ' . $toId);
                }
            }
            foreach ($kernelDeps as $mid => $deps) {
                $nodeId = str_replace('-', '_', $mid);
                out('    ' . $nodeId . ' -.-> kernel');
            }
            out('    kernel["kernel"]');
            out('    style kernel fill:#f9f,stroke:#333');
            break;
        }

        if ($format === 'dot') {
            out('digraph modules {');
            out('    rankdir=LR;');
            out('    node [shape=box, style=filled, fillcolor="#e8f4fd"];');
            out('    kernel [fillcolor="#ffe0f0"];');
            foreach ($allMods as $mid => $manifest) {
                $nodeId = str_replace('-', '_', $mid);
                out('    ' . $nodeId . ' [label="' . $mid . '"];');
            }
            foreach ($edges as $from => $targets) {
                $fromId = str_replace('-', '_', $from);
                foreach (array_keys($targets) as $to) {
                    $toId = str_replace('-', '_', $to);
                    out('    ' . $fromId . ' -> ' . $toId . ';');
                }
            }
            foreach ($kernelDeps as $mid => $deps) {
                $nodeId = str_replace('-', '_', $mid);
                out('    ' . $nodeId . ' -> kernel [style=dashed];');
            }
            out('}');
            break;
        }

        if ($format === 'json') {
            $graphJson = [
                'modules' => [],
                'edges' => [],
                'kernel_deps' => [],
            ];
            foreach ($allMods as $mid => $manifest) {
                $graphJson['modules'][] = [
                    'id' => $mid,
                    'exposes' => $exposesMap[$mid] ?? [],
                    'depends' => $dependsMap[$mid] ?? [],
                ];
            }
            foreach ($edges as $from => $targets) {
                foreach (array_keys($targets) as $to) {
                    $graphJson['edges'][] = ['from' => $from, 'to' => $to];
                }
            }
            foreach ($kernelDeps as $mid => $deps) {
                $graphJson['kernel_deps'][] = ['module' => $mid, 'capabilities' => $deps];
            }
            out(json_encode($graphJson, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
            break;
        }

        if ($targetModule !== '') {
            out('  ' . bold('Impact analysis: ') . cyan($targetModule));
            out('');

            $exposes = $exposesMap[$targetModule] ?? [];
            if (!empty($exposes)) {
                out('  ' . bold('Provides:'));
                foreach ($exposes as $cid) {
                    out('    ' . green($cid));
                }
                out('');
            }

            $deps = $dependsMap[$targetModule] ?? [];
            if (!empty($deps)) {
                out('  ' . bold('Depends on:'));
                foreach ($deps as $cid) {
                    $providers = $providerMap[$cid] ?? ['?'];
                    out('    ' . cyan($cid) . ' → ' . dim(implode(', ', $providers)));
                }
                out('');
            }

            $dependents = [];
            foreach ($edges as $dependent => $providers) {
                if (isset($providers[$targetModule])) {
                    $dependents[] = $dependent;
                }
            }
            if (!empty($dependents)) {
                out('  ' . bold('Depended on by:'));
                foreach ($dependents as $dep) {
                    out('    ' . yellow($dep));
                }
                out('');
                out('  ' . red('⚠ Disabling ' . $targetModule . ' would break: ' . implode(', ', $dependents)));
            } else {
                out('  ' . green('✓ No modules depend on ' . $targetModule));
            }
            out('');
        } else {
            $hasEdges = false;
            foreach ($allMods as $mid => $manifest) {
                $exp = $exposesMap[$mid] ?? [];
                $moduleEdges = $edges[$mid] ?? [];
                $kDeps = $kernelDeps[$mid] ?? [];

                if (empty($exp) && empty($moduleEdges) && empty($kDeps)) {
                    continue;
                }

                $hasEdges = true;
                out('  ' . cyan($mid));
                if (!empty($exp)) {
                    out('    provides: ' . dim(implode(', ', $exp)));
                }
                if (!empty($kDeps)) {
                    out('    kernel deps: ' . dim(implode(', ', $kDeps)));
                }
                if (!empty($moduleEdges)) {
                    out('    module deps: ' . yellow(implode(', ', array_keys($moduleEdges))));
                }
                out('');
            }

            if (!$hasEdges) {
                out('  ' . dim('No inter-module dependencies found.'));
            }
        }
        break;

    // ── make:module ──────────────────────────────────────────────
    case 'make:module':
        $name = $params[0] ?? '';
        if ($name === '') {
            out(red('  ✗ Module name required.'));
            out('  Usage: php ikabud make:module <name>');
            out('  Example: php ikabud make:module hr');
            exit(1);
        }

        // Normalize: lowercase, hyphens
        $id = strtolower(preg_replace('/[^a-zA-Z0-9\-]/', '-', $name));
        $id = preg_replace('/-+/', '-', trim($id, '-'));

        // Pretty label
        $label = ucwords(str_replace('-', ' ', $id));

        // Function prefix: daily-ledger → DailyLedger
        $funcPrefix = str_replace('-', '', ucwords($id, '-'));

        // Short prefix for scoped helpers: daily-ledger → dl, contact-form → cf
        $shortPrefix = implode('', array_map(fn($w) => $w[0] ?? '', explode('-', $id)));

        // Table prefix: daily-ledger → dl_ (underscore-joined initials)
        $tablePrefix = $shortPrefix . '_';

        $modulePath = modulesPath() . '/' . $id;
        $templatePath = BASE_PATH . '/templates/modules/' . $id;
        $testPath = BASE_PATH . '/tests/' . str_replace('-', '_', $id) . '_module_test.php';

        if (is_dir($modulePath)) {
            out(red("  ✗ Module '{$id}' already exists at {$modulePath}"));
            exit(1);
        }

        banner();
        out('  Creating module: ' . bold($id));
        out('');

        // Create directories
        $dirs = [
            $modulePath,
            $modulePath . '/database/migrations',
            $templatePath . '/pages',
            $templatePath . '/partials',
        ];
        foreach ($dirs as $dir) {
            @mkdir($dir, 0775, true);
            out('  ' . green('✓') . ' mkdir ' . dim(str_replace(BASE_PATH . '/', '', $dir)));
        }

        // ── module.json ──────────────────────────────────────────
        $manifest = [
            'id' => $id,
            'name' => $label,
            'version' => '1.0.0',
            'description' => "{$label} module for Ikabud Kernel",
            'author' => '',
            'owns_tables' => [],
            'reads_tables' => [],
            'migrations' => [
                "database/migrations/001_initial.sql",
            ],
            'capabilities' => [
                'exposes' => [],
                'depends' => [
                    'kernel.auth.user@1',
                    'kernel.audit.record@1',
                ],
            ],
            'events' => [],
            'nav' => [
                [
                    'label' => $label,
                    'url' => '/admin/' . $id,
                    'icon' => 'box',
                    'roles' => ['admin'],
                ],
            ],
        ];
        file_put_contents(
            $modulePath . '/module.json',
            json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n"
        );
        out('  ' . green('✓') . ' create module.json');

        // ── routes.php ───────────────────────────────────────────
        $routesContent = <<<PHP
<?php
/**
 * {$label} Module — Routes
 *
 * Format: 'METHOD' => [ '/path' => 'module-id:handlerFunction' ]
 * URL parameters: '/path/{id}' passes \$params['id'] to the handler.
 */

declare(strict_types=1);

return [
    'GET' => [
        '/admin/{$id}' => '{$id}:page{$funcPrefix}Home',
    ],
    'POST' => [
        // '/api/v1/{$id}/example' => '{$id}:api{$funcPrefix}Example',
    ],
];
PHP;
        file_put_contents($modulePath . '/routes.php', $routesContent . "\n");
        out('  ' . green('✓') . ' create routes.php');

        // ── handlers.php ─────────────────────────────────────────
        $handlersContent = <<<PHP
<?php
/**
 * {$label} Module — Handlers
 *
 * Each function is a route handler. Signature: function name(array \$params = []): void
 * Access module context via the scoped helpers in helpers.php (e.g. {$shortPrefix}Ctx(), {$shortPrefix}Db()).
 */

declare(strict_types=1);

require_once __DIR__ . '/helpers.php';

