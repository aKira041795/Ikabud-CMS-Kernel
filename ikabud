            $exposes = (array)($caps['exposes'] ?? []);
            foreach ($exposes as $cap) {
                $cid = is_string($cap) ? $cap : ($cap['id'] ?? '');
                if ($cid !== '' && (str_contains($cid, $sourceId) || str_contains($cid, explode('.', $sourceId)[0] ?? ''))) {
                    $mode = is_array($cap) ? ($cap['mode'] ?? 'first') : 'first';
                    out('    ' . green('→') . ' ' . cyan($cid) . dim(" ({$mode})") . ' — ' . cyan($mid));
                    $found = true;
                }
            }
        }
        if (!$found) {
            out('    ' . dim('none found'));
        }

        // 4. Template usage across modules
        out('');
        out('  ' . dim('Template usage'));
        $tmplDir = defined('TEMPLATES_PATH') ? TEMPLATES_PATH : (BASE_PATH . '/templates');
        $usage = [];
        $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($tmplDir, FilesystemIterator::SKIP_DOTS));
        foreach ($it as $fi) {
            if (!$fi->isFile() || $fi->getExtension() !== 'disyl') continue;
            $content = @file_get_contents((string)$fi->getRealPath());
            if (is_string($content) && str_contains($content, $sourceId)) {
                $rel = str_replace(BASE_PATH . '/', '', (string)$fi->getRealPath());
                $usage[] = $rel;
            }
        }
        if (!empty($usage)) {
            foreach ($usage as $u) {
                out('    ' . dim($u));
            }
        } else {
            out('    ' . dim('no templates reference this source'));
        }

        out('');
        exit(0);
    }