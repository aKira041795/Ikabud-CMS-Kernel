    // ── tinker ───────────────────────────────────────────────────
    case 'tinker':
        $sql = implode(' ', $params);
        if ($sql === '') {
            out(red('  ✗ SQL query required.'));
            out('  Usage: php ikabud tinker "SELECT * FROM users LIMIT 5"');
            exit(1);
        }
        try {
            $stmt = app()->db()->query($sql);
            $rows = $stmt->fetchAll(PDO::FETCH_ASSOC);
            if (empty($rows)) {
                out(dim('  (empty result set)'));
            } else {
                // Print as simple table
                $cols = array_keys($rows[0]);
                $widths = [];
                foreach ($cols as $c) {
                    $widths[$c] = strlen((string) $c);
                }
                foreach ($rows as $row) {
                    foreach ($cols as $c) {
                        $widths[$c] = max($widths[$c], strlen((string) ($row[$c] ?? 'NULL')));
                    }
                }
                // Cap at 40
                foreach ($widths as &$w) { $w = min($w, 40); }
                unset($w);

                // Header
                $header = '';
                $sep = '';
                foreach ($cols as $c) {
                    $header .= str_pad((string) $c, $widths[$c] + 2);
                    $sep .= str_repeat('─', $widths[$c] + 2);
                }
                out('  ' . bold($header));
                out('  ' . $sep);

                foreach ($rows as $row) {
                    $line = '';
                    foreach ($cols as $c) {
                        $val = $row[$c] ?? 'NULL';
                        $val = (string) $val;
                        if (strlen($val) > 40) $val = substr($val, 0, 37) . '...';
                        $line .= str_pad($val, $widths[$c] + 2);
                    }
                    out('  ' . $line);
                }
                out('');
                out(dim('  ' . count($rows) . ' row(s)'));
            }
        } catch (\Throwable $e) {
            out(red('  ✗ SQL error: ') . $e->getMessage());
            exit(1);
        }
        break;

    // ── platform:describe ─────────────────────────────────────────
    case 'platform:describe':
        loadModuleRoutes(['GET' => [], 'POST' => [], 'PUT' => [], 'DELETE' => []]);

        $platformId = app()->platformIdentity();

        // Modules
        $allMods = discoverModules();
        $enabledMods = [];
        $disabledMods = [];
        foreach ($allMods as $m) {
            $entry = [
                'id' => (string)($m['id'] ?? ''),
                'name' => (string)($m['name'] ?? $m['id'] ?? ''),
                'version' => (string)($m['version'] ?? '0.0.0'),
                'status' => $m['status'] ?? null,
                'requires_kernel' => $m['requires_kernel'] ?? null,
            ];
            if (!empty($m['_enabled'])) {
                $enabledMods[] = $entry;
            } else {
                $disabledMods[] = $entry;
            }
        }

        // Capabilities
        $capIds = app()->capabilities()->capabilityIds();
        $capEntries = [];
        foreach ($capIds as $cid) {
            $provs = app()->capabilities()->providers($cid);
            $providerNames = [];
            foreach ($provs as $p) {
                $providerNames[] = (string)($p['provider'] ?? '');
            }
            $capEntries[] = [
                'id' => $cid,
                'providers' => $providerNames,
                'effective_schema_mode' => app()->cap()->resolveSchemaMode($cid),
            ];
        }

        // Events
        $eventsCount = 0;
        try {
            $stmt = app()->db()->query('SELECT COUNT(*) FROM kernel_events');
            $eventsCount = $stmt ? (int)$stmt->fetchColumn() : 0;
        } catch (Throwable $e) {
        }

        // Triggers
        $triggersTotal = 0;
        $triggersEnabled = 0;
        try {
            $stmt = app()->db()->query('SELECT COUNT(*) as total, SUM(is_enabled) as enabled FROM kernel_event_triggers');
            $row = $stmt ? $stmt->fetch(PDO::FETCH_ASSOC) : null;
            if (is_array($row)) {
                $triggersTotal = (int)($row['total'] ?? 0);
                $triggersEnabled = (int)($row['enabled'] ?? 0);
            }
        } catch (Throwable $e) {
        }

        // Health
        $health = app()->cap()->healthAll();
        $healthSummary = ['total_calls' => 0, 'total_errors' => 0, 'breakers_open' => 0];
        foreach ($health as $h) {
            $healthSummary['total_calls'] += (int)($h['count'] ?? 0);
            $healthSummary['total_errors'] += (int)($h['errors'] ?? 0);
            if (!empty($h['breaker_open'])) {
                $healthSummary['breakers_open']++;
            }
        }

        $manifest = [
            'platform' => $platformId,
            'modules' => [
                'enabled_count' => count($enabledMods),
                'disabled_count' => count($disabledMods),
                'enabled' => $enabledMods,
                'disabled' => $disabledMods,
            ],
            'capabilities' => [
                'count' => count($capEntries),
                'entries' => $capEntries,
            ],
            'events' => ['count' => $eventsCount],
            'triggers' => ['total' => $triggersTotal, 'enabled' => $triggersEnabled],
            'health' => $healthSummary,
            'generated_at' => gmdate('c'),
        ];

        echo json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
        break;

    default:
        out(red("  Unknown command: {$command}"));
        out("  Run " . cyan('php ikabud help') . " for available commands.");
        exit(1);

    // ── make:migration ───────────────────────────────────────────
    case 'make:migration':
        $clean = paramsWithoutFlags($params);
        $moduleId = $clean[0] ?? '';
        $slug = $clean[1] ?? '';

        if ($moduleId === '' || $slug === '') {
            out(red('  ✗ Module id and migration name required.'));
            out('  Usage: php ikabud make:migration <module-id> <name>');
            out('  Example: php ikabud make:migration daily-ledger add_discount_column');
            exit(1);
        }

        $migrDir = BASE_PATH . '/modules/' . $moduleId . '/database/migrations';
        if (!is_dir(BASE_PATH . '/modules/' . $moduleId)) {
            out(red("  ✗ Module '{$moduleId}' not found."));
            exit(1);
        }

        // Create migrations dir if it doesn't exist
        if (!is_dir($migrDir)) {
            @mkdir($migrDir, 0775, true);
        }

        // Determine next sequence number
        $existing = glob($migrDir . '/*.sql');
        $maxNum = 0;
        foreach ($existing as $f) {
            $base = basename($f);
            if (preg_match('/^(\d+)_/', $base, $m)) {
                $maxNum = max($maxNum, (int)$m[1]);
            }
        }
        $nextNum = str_pad((string)($maxNum + 1), 3, '0', STR_PAD_LEFT);

        // Normalize slug: lowercase, underscores
        $slug = strtolower(preg_replace('/[^a-zA-Z0-9_]/', '_', $slug));
        $slug = preg_replace('/_+/', '_', trim($slug, '_'));

        $filename = "{$nextNum}_{$slug}.sql";
        $label = ucwords(str_replace('-', ' ', $moduleId));
        $today = date('Y-m-d');

        $content = <<<SQL
-- {$label} Module — {$slug}
-- Created: {$today}

-- Write your migration SQL below.

SQL;
        file_put_contents($migrDir . '/' . $filename, $content);

        banner();
        out('  ' . green('✓') . ' Created migration: ' . cyan("modules/{$moduleId}/database/migrations/{$filename}"));
        out('');
        out('  Next: edit the file, then run ' . cyan("php ikabud migrate {$moduleId}"));
        out('');
        break;

    // ── make:handler ─────────────────────────────────────────────
    case 'make:handler':
        $clean = paramsWithoutFlags($params);
        $moduleId = $clean[0] ?? '';
        $handlerName = $clean[1] ?? '';
        $method = strtoupper($clean[2] ?? 'GET');

        if ($moduleId === '' || $handlerName === '') {
            out(red('  ✗ Module id and handler name required.'));
            out('  Usage: php ikabud make:handler <module-id> <handler-name> [GET|POST]');
            out('  Example: php ikabud make:handler daily-ledger handleAdminReports');
            exit(1);
        }

        $modDir = BASE_PATH . '/modules/' . $moduleId;
        if (!is_dir($modDir)) {
            out(red("  ✗ Module '{$moduleId}' not found."));
            exit(1);
        }

        $handlersFile = $modDir . '/handlers.php';
        $routesFile = $modDir . '/routes.php';

        if (!file_exists($handlersFile)) {
            out(red("  ✗ handlers.php not found in module '{$moduleId}'."));
            exit(1);
        }

        // Check that the function doesn't already exist
        $existingCode = file_get_contents($handlersFile);
        if (preg_match('/function\s+' . preg_quote($handlerName, '/') . '\s*\(/', $existingCode)) {
            out(red("  ✗ Function '{$handlerName}' already exists in handlers.php."));
            exit(1);
        }

        // Determine if it's a page handler or API handler
        $isApi = str_starts_with($handlerName, 'api');
        $label = ucwords(str_replace('-', ' ', $moduleId));

        // Generate route path
        if ($isApi) {
            // apiGetSomething → /module-id/api/v1/something
            $routeSlug = preg_replace('/^api(Get|Post|Put|Delete|Save|Create|Update|List)?/', '', $handlerName);
            $routeSlug = strtolower(preg_replace('/([A-Z])/', '-$1', $routeSlug));
            $routeSlug = trim($routeSlug, '-');
            $routePath = "/{$moduleId}/api/v1/{$routeSlug}";
        } else {
            // handleAdminSomething → /module-id/admin/something
            $routeSlug = preg_replace('/^(handle|page)/', '', $handlerName);
            $routeSlug = strtolower(preg_replace('/([A-Z])/', '-$1', $routeSlug));
            $routeSlug = trim($routeSlug, '-');
            $routePath = "/{$moduleId}/{$routeSlug}";
        }

        // Append handler function to handlers.php
        if ($isApi) {
            $handlerCode = <<<PHP


/**
 * {$method} {$routePath}
 */
function {$handlerName}(array \$params = []): void
{
    header('Content-Type: application/json');

    // TODO: implement API logic
    echo json_encode(['ok' => true]);
}
PHP;
        } else {
            $templateRelPath = "modules/{$moduleId}/pages/" . str_replace('-', '_', $routeSlug) . '.disyl';
            $handlerCode = <<<PHP


/**
 * {$method} {$routePath}
 */
function {$handlerName}(array \$params = []): void
{
    \$ctx = module();
    if (!\$ctx) {
        http_response_code(500);
        echo 'Module context unavailable';
        return;
    }

    // TODO: implement page logic
    echo \$ctx->render('{$templateRelPath}', [
        'page_title' => '{$label}',
    ]);
}
PHP;
        }

        file_put_contents($handlersFile, $handlerCode . "\n", FILE_APPEND);

        // Append route to routes.php
        $routeAdded = false;
        if (file_exists($routesFile)) {
            $routesCode = file_get_contents($routesFile);
            $methodKey = "'{$method}'";

            // Find the closing bracket of the method array
            if (preg_match('/([\'"]' . preg_quote($method, '/') . '[\'"]\s*=>\s*\[)(.*?)(\n\s*\])/s', $routesCode, $rm, PREG_OFFSET_CAPTURE)) {
                $insertPos = $rm[3][1];
                $routeLine = "\n        '{$routePath}' => '{$moduleId}:{$handlerName}',";
                $routesCode = substr($routesCode, 0, $insertPos) . $routeLine . substr($routesCode, $insertPos);
                file_put_contents($routesFile, $routesCode);
                $routeAdded = true;
            }
        }

        banner();
        out('  ' . green('✓') . ' Added handler: ' . cyan($handlerName) . ' to ' . dim("modules/{$moduleId}/handlers.php"));
        if ($routeAdded) {
            out('  ' . green('✓') . ' Added route:   ' . cyan("{$method} {$routePath}") . ' to ' . dim("modules/{$moduleId}/routes.php"));
        } else {
            out('  ' . yellow('⚠') . ' Could not auto-add route. Add manually to routes.php:');
            out("    '{$routePath}' => '{$moduleId}:{$handlerName}'");
        }
        out('');
        break;

    // ── disyl:lint ───────────────────────────────────────────────
    case 'disyl:lint':
        banner();
        $clean = paramsWithoutFlags($params);
        $targetPath = $clean[0] ?? '';
        $verbose = hasFlag('--verbose');
        $fixSuggestions = hasFlag('--fix');

        // Determine files to lint
        $files = [];
        if ($targetPath !== '') {
            $fullPath = realpath(BASE_PATH . '/' . $targetPath) ?: realpath($targetPath);
            if (!$fullPath) {
                out(red("  ✗ Path not found: {$targetPath}"));
                exit(1);
            }
            if (is_file($fullPath) && str_ends_with($fullPath, '.disyl')) {
                $files[] = $fullPath;
            } elseif (is_dir($fullPath)) {
                $iter = new RecursiveIteratorIterator(
                    new RecursiveDirectoryIterator($fullPath, FilesystemIterator::SKIP_DOTS)
                );
                foreach ($iter as $finfo) {
                    if ($finfo->isFile() && str_ends_with($finfo->getFilename(), '.disyl')) {
                        $files[] = $finfo->getPathname();
                    }
                }
            } else {
                out(red("  ✗ Not a .disyl file or directory: {$targetPath}"));
                exit(1);
            }
        } else {
            // Scan all template directories
            $scanDirs = [
                BASE_PATH . '/templates',
            ];
            // Add module template dirs
            foreach (glob(BASE_PATH . '/modules/*/') as $modDir) {
                $modTemplates = $modDir . 'templates';
                if (is_dir($modTemplates)) {
                    $scanDirs[] = $modTemplates;
                }
            }
            foreach ($scanDirs as $dir) {
                if (!is_dir($dir)) continue;
                $iter = new RecursiveIteratorIterator(
                    new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS)
                );
                foreach ($iter as $finfo) {
                    if ($finfo->isFile() && str_ends_with($finfo->getFilename(), '.disyl')) {
                        $files[] = $finfo->getPathname();
                    }
                }
            }
        }

        sort($files);
        $fileCount = count($files);

        out('  ' . bold('DiSyL Template Linter'));
        out('  Scanning ' . cyan((string)$fileCount) . ' template(s)...');
        out('');

        $totalErrors = 0;
        $totalWarnings = 0;
        $filesWithIssues = 0;

        // Tag pairs that must be balanced
        $tagPairs = [
            'if'      => '/if',
            'for'     => '/for',
            'foreach' => '/foreach',
            'each'    => '/each',
            'verbatim'=> '/verbatim',
            'literal' => '/literal',
        ];

        foreach ($files as $file) {
            $relPath = str_replace(BASE_PATH . '/', '', $file);
            $content = file_get_contents($file);
            $lines = explode("\n", $content);
            $issues = [];

            // Strip DiSyL comments and JS single-line comments to avoid false positives
            $lintContent = preg_replace('/\{!--.*?--\}/s', '', $content);  // DiSyL comments
            $lintContent = preg_replace('#//[^\n]*#', '', $lintContent);   // JS single-line comments

            // ── Check 1: Unmatched control structure tags ──
            foreach ($tagPairs as $open => $close) {
                $openPattern  = '/\{' . preg_quote($open, '/') . '[\s}]/';
                $closePattern = '/\{\/' . preg_quote($open, '/') . '\}/';

                preg_match_all($openPattern, $lintContent, $openMatches, PREG_OFFSET_CAPTURE);
                preg_match_all($closePattern, $lintContent, $closeMatches, PREG_OFFSET_CAPTURE);

                $openCount = count($openMatches[0]);
                $closeCount = count($closeMatches[0]);

                if ($openCount > $closeCount) {
                    $diff = $openCount - $closeCount;
                    // Find line of last unmatched open
                    $lastOpen = end($openMatches[0]);
                    $lineNum = $lastOpen ? substr_count($content, "\n", 0, $lastOpen[1]) + 1 : 0;
                    $issues[] = ['type' => 'error', 'line' => $lineNum,
                        'msg' => "{$diff} unclosed {" . $open . "} tag(s) — missing {" . $close . "}"];
                } elseif ($closeCount > $openCount) {
                    $diff = $closeCount - $openCount;
                    $lastClose = end($closeMatches[0]);
                    $lineNum = $lastClose ? substr_count($content, "\n", 0, $lastClose[1]) + 1 : 0;
                    $issues[] = ['type' => 'error', 'line' => $lineNum,
                        'msg' => "{$diff} extra {" . $close . "} tag(s) without matching {" . $open . "}"];
                }
            }

            // ── Check 2: {elseif}/{else} without enclosing {if} ──
            // Simple heuristic: every {else} or {elseif} should appear between an {if} and {/if}
            if (preg_match_all('/\{else(?:if\s[^}]*)?\}/', $lintContent, $elseMatches, PREG_OFFSET_CAPTURE)) {
                $ifOpens  = [];
                $ifCloses = [];
                preg_match_all('/\{if\s/', $lintContent, $ifO, PREG_OFFSET_CAPTURE);
                preg_match_all('/\{\/if\}/', $lintContent, $ifC, PREG_OFFSET_CAPTURE);
                foreach ($ifO[0] as $m) $ifOpens[] = $m[1];
                foreach ($ifC[0] as $m) $ifCloses[] = $m[1];

                foreach ($elseMatches[0] as $em) {
                    $pos = $em[1];
                    // Count opens before this pos and closes before this pos
                    $opensBefore = count(array_filter($ifOpens, fn($p) => $p < $pos));
                    $closesBefore = count(array_filter($ifCloses, fn($p) => $p < $pos));
                    if ($opensBefore <= $closesBefore) {
                        $lineNum = substr_count($content, "\n", 0, $pos) + 1;
                        $tag = trim($em[0], '{}');
                        $issues[] = ['type' => 'error', 'line' => $lineNum,
                            'msg' => "{{$tag}} appears outside any {if} block"];
                    }
                }
            }

            // ── Check 3: Unclosed component tags ──
            if (preg_match_all('/\{(ikb_\w+)[\s}]/', $lintContent, $compMatches)) {
                foreach (array_unique($compMatches[1]) as $comp) {
                    // Count opens (non-self-closing) and closes
                    // Self-closing: {ikb_foo ... /}
                    preg_match_all('/\{' . preg_quote($comp, '/') . '(?:\s[^}]*)?\}/', $lintContent, $allOpens);
                    preg_match_all('/\{' . preg_quote($comp, '/') . '(?:\s[^}]*)?\s*\/\s*\}/', $lintContent, $selfClosing);
                    preg_match_all('/\{\/' . preg_quote($comp, '/') . '\}/', $lintContent, $compCloses);

                    $opens = count($allOpens[0]) - count($selfClosing[0]);
                    $closes = count($compCloses[0]);

                    if ($opens > $closes) {
                        $issues[] = ['type' => 'warning', 'line' => 0,
                            'msg' => ($opens - $closes) . " unclosed {{$comp}} component(s) — missing {/{$comp}}"];
                    }
                }
            }

            // ── Check 4: {include} references check ──
            if (preg_match_all('/\{include\s+"([^"]+)"/', $content, $incMatches)) {
                $templateDirs = [
                    BASE_PATH . '/templates',
                ];
                foreach ($incMatches[1] as $incRef) {
                    $found = false;
                    foreach ($templateDirs as $tdir) {
                        $incPath = $tdir . '/' . $incRef;
                        if (!str_ends_with($incPath, '.disyl')) $incPath .= '.disyl';
                        if (file_exists($incPath)) {
                            $found = true;
                            break;
                        }
                    }
                    if (!$found) {
                        $issues[] = ['type' => 'warning', 'line' => 0,
                            'msg' => "Include not found: \"{$incRef}\" — file may be missing or in a module template dir"];
                    }
                }
            }

            // ── Check 5: {extends} layout reference ──
            if (preg_match('/\{extends\s+"([^"]+)"\s*\}/', $content, $extMatch)) {
                $layoutRef = $extMatch[1];
                $layoutPath = BASE_PATH . '/templates/' . $layoutRef;
                if (!str_ends_with($layoutPath, '.disyl')) $layoutPath .= '.disyl';
                if (!file_exists($layoutPath)) {
                    $issues[] = ['type' => 'warning', 'line' => 1,
                        'msg' => "Layout not found: \"{$layoutRef}\""];
                }
            }

            // ── Check 6: Empty control structure bodies ──
            foreach (['if', 'for', 'foreach', 'each'] as $tag) {
                $pattern = '/\{' . $tag . '\s+[^}]+\}\s*\{\/' . $tag . '\}/s';
                if (preg_match_all($pattern, $lintContent, $emptyMatches, PREG_OFFSET_CAPTURE)) {
                    foreach ($emptyMatches[0] as $em) {
                        $lineNum = substr_count($content, "\n", 0, $em[1]) + 1;
                        $issues[] = ['type' => 'warning', 'line' => $lineNum,
                            'msg' => "Empty {{$tag}} body — control structure has no content"];
                    }
                }
            }

            // ── Check 7: Likely typos — {/foreach} closing wrong tag ──
            // For each close tag, verify there's a matching open before it
            foreach (['for' => 'foreach', 'foreach' => 'for'] as $closeTag => $confusedWith) {
                preg_match_all('/\{\/' . preg_quote($closeTag, '/') . '\}/', $lintContent, $cMatches, PREG_OFFSET_CAPTURE);
                preg_match_all('/\{' . preg_quote($closeTag, '/') . '\s/', $lintContent, $oMatches, PREG_OFFSET_CAPTURE);
                // If there are closes but no opens, it's likely a typo
                if (count($cMatches[0]) > 0 && count($oMatches[0]) === 0) {
                    $lineNum = substr_count($content, "\n", 0, $cMatches[0][0][1]) + 1;
                    $issues[] = ['type' => 'warning', 'line' => $lineNum,
                        'msg' => "{/{$closeTag}} found but no {{$closeTag}} — did you mean {/{$confusedWith}}?"];
                }
            }

            // ── Report ──
            if (!empty($issues)) {
                $filesWithIssues++;
                out('  ' . bold($relPath));
                usort($issues, fn($a, $b) => $a['line'] <=> $b['line']);
                foreach ($issues as $issue) {
                    $icon = $issue['type'] === 'error' ? red('✗') : yellow('⚠');
                    $lineLabel = $issue['line'] > 0 ? dim("L{$issue['line']}") . ' ' : '';
                    $typeLabel = $issue['type'] === 'error' ? red('error') : yellow('warn');
                    out("    {$icon} {$lineLabel}{$typeLabel}: {$issue['msg']}");

                    if ($issue['type'] === 'error') $totalErrors++;
                    else $totalWarnings++;
                }
                out('');
            } elseif ($verbose) {
                out('  ' . green('✓') . ' ' . dim($relPath));
            }
        }

        // Summary
        out('  ─────────────────────────────────────────────');
        out('  Scanned: ' . cyan((string)$fileCount) . ' files');
        if ($totalErrors === 0 && $totalWarnings === 0) {
            out('  ' . green('✓ No issues found'));
        } else {
            if ($totalErrors > 0) {
                out('  Errors:   ' . red((string)$totalErrors));
            }
            if ($totalWarnings > 0) {
                out('  Warnings: ' . yellow((string)$totalWarnings));
            }
            out('  Files with issues: ' . bold((string)$filesWithIssues));
        }
        out('');
        exit($totalErrors > 0 ? 1 : 0);
}
