    // ── module:list ──────────────────────────────────────────────
    case 'module:list':
        banner();
        $modules = discoverModules();
        if (empty($modules)) {
            out('  ' . dim('No modules found.'));
        } else {
            out('  ' . bold(str_pad('ID', 22)) . bold(str_pad('VERSION', 10)) . bold(str_pad('STATUS', 12)) . bold('NAME'));
            out('  ' . str_repeat('─', 70));
            foreach ($modules as $m) {
                $status = $m['_enabled'] ? green('enabled') . ' ' : red('disabled');
                $version = str_pad($m['version'] ?? '-', 10);
