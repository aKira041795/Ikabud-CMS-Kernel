function hasFlag(string $flag): bool
{
    global $params;
    return in_array($flag, $params, true);
}

function paramsWithoutFlags(array $params): array
{
    return array_values(array_filter($params, fn($p) => !is_string($p) || !str_starts_with($p, '--')));
}

function getFlagValue(string $prefix): ?string
{
    global $params;
    foreach ($params as $p) {
        if (!is_string($p)) continue;
        if (str_starts_with($p, $prefix)) {
            return substr($p, strlen($prefix));
        }
    }
    return null;
}

function cliResolveTenantId(string $selector): ?int
{
    $selector = trim($selector);
    if ($selector === '') {
        return null;
    }

    if (ctype_digit($selector)) {
        $tenantId = (int)$selector;
        return $tenantId > 0 ? $tenantId : null;
    }

    try {
        $pdo = app()->controlDb();

        $stmt = $pdo->prepare('SELECT id FROM kernel_tenants WHERE tenant_key = :selector LIMIT 1');
        $stmt->execute([':selector' => $selector]);
        $tenantId = (int)($stmt->fetchColumn() ?: 0);
        if ($tenantId > 0) {
            return $tenantId;
        }

        $stmt = $pdo->prepare('SELECT tenant_id FROM kernel_tenant_domains WHERE domain = :selector LIMIT 1');
        $stmt->execute([':selector' => $selector]);
        $tenantId = (int)($stmt->fetchColumn() ?: 0);
        return $tenantId > 0 ? $tenantId : null;
    } catch (Throwable $e) {
        return null;
    }
}

function cliModuleManifest(string $moduleId): ?array
{
    $modules = discoverModules();
    $manifest = $modules[$moduleId] ?? null;
    return is_array($manifest) ? $manifest : null;
}

function cliModuleTenantTargets(?string $moduleId = null): array
{
    if (!function_exists('tenantSeparateDatabaseMigrationTargets')) {
        return [];
    }

    $targets = tenantSeparateDatabaseMigrationTargets();
    $moduleId = trim((string)$moduleId);
    if ($moduleId === '') {
        return $targets;
    }

    $filtered = [];
    foreach ($targets as $target) {
        if (!is_array($target)) {
            continue;
        }

        $entryModuleId = trim((string)($target['entry_module_id'] ?? ''));
        $plan = function_exists('tenantProvisionModulePlan')
            ? tenantProvisionModulePlan($entryModuleId !== '' ? $entryModuleId : null)
            : [];
        if (in_array($moduleId, $plan, true)) {
            $filtered[] = $target;
        }
    }

    return $filtered;
}

function cliDbHasAnyOwnedModuleTable(PDO $db, ?array $manifest): bool
{
    if (!is_array($manifest)) {
        return false;
    }

    $tables = $manifest['owns_tables'] ?? [];
    if (!is_array($tables) || $tables === []) {
        return false;
    }

    foreach ($tables as $table) {
        $table = trim((string)$table);
        if ($table === '') {
            continue;
        }

        try {
            $exists = $db->query('SHOW TABLES LIKE ' . $db->quote($table))->fetchColumn();
            if ($exists !== false) {
                return true;
            }
        } catch (Throwable $e) {
            return false;
        }
    }

    return false;
}

function cliModuleHasMigrationHistory(PDO $db, string $moduleId): bool
{
    try {
        $stmt = $db->prepare('SELECT 1 FROM `_migrations` WHERE module = :module LIMIT 1');
        $stmt->execute([':module' => $moduleId]);
        return $stmt->fetchColumn() !== false;
    } catch (Throwable $e) {
        return false;
    }
}

function cliShouldTreatBaseMigrationFailureAsTenantOnly(PDO $db, string $moduleId, ?array $manifest, array $tenantTargets, Throwable $e): bool
{
    if ($tenantTargets === []) {
        return false;
    }

    $message = $e->getMessage();
    if (!str_contains($message, 'SQLSTATE[42S02]') && !str_contains($message, 'Base table or view not found')) {
        return false;
    }

    if (cliDbHasAnyOwnedModuleTable($db, $manifest)) {
        return false;
    }

    return cliModuleHasMigrationHistory($db, $moduleId);
}

function cliRunBaseModuleMigration(MigrationRunner $runner, PDO $baseDb, string $moduleId): array
{
    if ($moduleId === '_kernel' || $moduleId === '_control') {
        return [
            'executed' => $runner->migrate($moduleId),
            'skipped' => false,
            'warning' => '',
        ];
    }

    $manifest = cliModuleManifest($moduleId);
    $tenantTargets = cliModuleTenantTargets($moduleId);

    try {
        return [
            'executed' => $runner->migrate($moduleId),
            'skipped' => false,
            'warning' => '',
        ];
    } catch (Throwable $e) {
        if (!cliShouldTreatBaseMigrationFailureAsTenantOnly($baseDb, $moduleId, $manifest, $tenantTargets, $e)) {
            throw $e;
        }

        return [
            'executed' => [],
            'skipped' => true,
            'warning' => $e->getMessage(),
        ];
    }
}

