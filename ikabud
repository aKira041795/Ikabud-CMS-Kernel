        // Directly load view configs from all modules' helpers/views/ directories
        // This registers {ikb_entity_view} contracts with EntityViewResolver
        if (class_exists('Ikabud\\Kernel\\DiSyL\\TemplateEngine', true)) {
            foreach (glob(BASE_PATH . '/modules/*/helpers/views/') as $viewsDir) {
                \Ikabud\Kernel\DiSyL\TemplateEngine::loadViewConfigs($viewsDir);
