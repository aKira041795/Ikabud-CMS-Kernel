            $modId = basename(dirname(dirname(dirname($viewFile))));
            $content = (string)file_get_contents($viewFile);
            if (preg_match('/\{ikb_entity_view\s+name="([^"]+)"/', $content, $m)) {
                $name = $m[1];
                if (!isset($sources[$name])) {
                    $sources[$name] ??= ['module' => $modId, 'views' => []];
                }
            }
        }

        // Query EntityViewResolver for view contract details
