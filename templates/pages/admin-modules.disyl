{extends "layouts/kernel-admin.disyl"}

{block head}
<style>
    .module-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 18px; }
    .module-card { background: #fff; border: 1px solid var(--kernel-panel-border); border-radius: var(--radius); padding: 18px 18px 14px; display: flex; flex-direction: column; gap: 12px; box-shadow: 0 1px 3px rgba(0,0,0,.05); transition: box-shadow .15s; }
    .module-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.08); }
    .module-card-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
    .module-card-title { display: flex; align-items: flex-start; gap: 12px; min-width: 0; }
    .module-icon { flex: 0 0 40px; width: 40px; height: 40px; border-radius: 9px; background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; }
    .module-icon svg { width: 20px; height: 20px; }
    .module-title-text { min-width: 0; }
    .module-name { font-size: 16px; font-weight: 700; color: #0f172a; line-height: 1.25; word-break: break-word; }
    .module-id { font-size: 12px; color: #64748b; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; margin-top: 2px; }
    .module-head-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .module-version { font-size: 11px; color: #475569; background: #f1f5f9; padding: 2px 8px; border-radius: 999px; font-weight: 600; }
    .status-dot { width: 6px; height: 6px; border-radius: 2px; display: inline-block; }
    .status-pill { font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; padding: 3px 9px; border-radius: 999px; }
    .status-pill.enabled { color: #047857; background: #ecfdf5; }
    .status-pill.enabled .status-dot { background: #059669; }
    .status-pill.disabled { color: #b91c1c; background: #fef2f2; }
    .status-pill.disabled .status-dot { background: #dc2626; }
    .module-desc { font-size: 13px; color: #475569; line-height: 1.55; }
    .module-meta { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 12px; color: #64748b; }
    .entity-authority-badge { font-size: 11px; font-weight: 600; color: #1d4ed8; background: #eff6ff; border: 1px solid #bfdbfe; padding: 2px 8px; border-radius: 6px; display: inline-flex; align-items: center; }
    .cap-warning { font-size: 12px; color: #92400e; background: #fffbeb; border: 1px solid #fde68a; border-radius: 6px; padding: 8px 10px; }
    .module-actions { display: flex; gap: 8px; margin-top: auto; padding-top: 2px; }
    .btn-enable { background: var(--primary); color: #fff; border: 1px solid var(--primary); }
    .btn-enable:hover { opacity: .92; }
    .btn-enable.btn-disabled { background: #cbd5e1; border-color: #cbd5e1; color: #fff; cursor: not-allowed; opacity: 1; }
    .btn-disable { background: #fff; color: #b91c1c; border: 1px solid #fca5a5; }
    .btn-disable:hover { background: #fef2f2; border-color: #f87171; }
    .optin-row { display: flex; align-items: center; gap: 8px; font-size: 12px; color: #64748b; margin-top: 2px; padding-top: 12px; border-top: 1px solid #f1f5f9; }
    .optin-hint { color: #94a3b8; font-size: 11px; }
</style>
<script>
    var BASE = '{base_url}';
    var CSRF = '{csrf_token}';

    function showToast(message, type) {
        window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: message || '', type: type || 'success' } }));
    }

    function toggleModule(moduleId, enable) {
        var endpoint = enable ? '/api/v1/admin/modules/enable' : '/api/v1/admin/modules/disable';
        var btn = document.querySelector('#mod-' + moduleId + ' .btn-enable, #mod-' + moduleId + ' .btn-disable');
        if (btn) { btn.disabled = true; btn.textContent = enable ? 'Enabling…' : 'Disabling…'; }

        var fd = new FormData();
        fd.append('module_id', moduleId);
        fd.append('_token', CSRF);

        fetch(endpoint, {
            method: 'POST',
            body: fd
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res.ok) {
                showToast('Module ' + (enable ? 'enabled' : 'disabled'), 'success');
                setTimeout(function() { window.location.reload(); }, 600);
            } else {
                showToast(res.error || 'Failed to toggle module', 'error');
                if (btn) { btn.disabled = false; btn.textContent = enable ? 'Enable' : 'Disable'; }
            }
        })
        .catch(function() {
            showToast('Network error', 'error');
            if (btn) { btn.disabled = false; btn.textContent = enable ? 'Enable' : 'Disable'; }
        });
    }

    function toggleAdminOptin(moduleId, checked) {
        var fd = new FormData();
        fd.append('module_id', moduleId);
        fd.append('settings[allow_kernel_admin]', checked ? '1' : '0');
        fd.append('_token', CSRF);

        fetch('/api/v1/admin/modules/settings', {
            method: 'POST',
            body: fd
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res.ok) {
                showToast('Admin access ' + (checked ? 'allowed' : 'revoked'), 'success');
            } else {
                showToast(res.error || 'Failed to update', 'error');
                var cb = document.getElementById('optin-' + moduleId);
                if (cb) cb.checked = !checked;
            }
        })
        .catch(function() {
            showToast('Network error', 'error');
            var cb = document.getElementById('optin-' + moduleId);
            if (cb) cb.checked = !checked;
        });
    }

    function installModule(file) {
        if (!file) return;
        var progress = document.getElementById('upload-progress');
        var diagnostics = document.getElementById('install-diagnostics');
        if (progress) progress.style.display = 'block';
        if (diagnostics) diagnostics.innerHTML = '';

        var fd = new FormData();
        fd.append('module_zip', file);
        fd.append('_token', CSRF);

        fetch('/api/v1/admin/modules/install', {
            method: 'POST',
            body: fd
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (progress) progress.style.display = 'none';
            if (res.ok) {
                showToast('Module ' + (res.module_id || '') + ' installed', 'success');
                setTimeout(function() { window.location.reload(); }, 800);
            } else {
                showToast(res.error || 'Install failed', 'error');
                if (diagnostics) diagnostics.innerHTML = '<div class="install-error">' + (res.error || 'Install failed') + '</div>';
            }
        })
        .catch(function() {
            if (progress) progress.style.display = 'none';
            showToast('Network error', 'error');
        });
    }
</script>
{/block}

{block content}
<div class="page-header">
    <div>
        <h2>Module Manager</h2>
        <div class="page-desc">Install, enable, and manage module access. Module settings are configured by the tenant admin on the tenant domain.</div>
    </div>
</div>

<!-- Upload zone -->
<div class="upload-zone" id="upload-zone" onclick="document.getElementById('zip-input').click()">
    <div class="upload-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg></div>
    <strong style="font-size:14px;">Install Module</strong>
    <p>Drag &amp; drop a module .zip file here, or click to browse</p>
    <input type="file" id="zip-input" accept=".zip" onchange="installModule(this.files[0])">
</div>
<div class="upload-progress" id="upload-progress">Installing module...</div>
<div class="install-diagnostics" id="install-diagnostics"></div>

<!-- Module list -->
<div style="margin-top:24px;">
    {if modules | count == 0}
    <div class="empty-state">
        <h3>No modules installed</h3>
        <p>Upload a module .zip file above to get started.</p>
    </div>
    {else}
    <div class="module-grid" id="module-grid">
        {foreach modules as mod}
        <div class="module-card" id="mod-{mod.id}">
            <div class="module-card-header">
                <div class="module-card-title">
                    <span class="module-icon">{include "layouts/kernel-admin-icon.disyl" with {icon: mod.icon|default:'box'}}</span>
                    <div class="module-title-text">
                        <div class="module-name">{mod.name}</div>
                        <div class="module-id">{mod.id}</div>
                    </div>
                </div>
                <div class="module-head-right">
                    <span class="module-version">v{mod.version}</span>
                    {if mod.enabled}
                    <span class="status-pill enabled"><span class="status-dot"></span> Enabled</span>
                    {else}
                    <span class="status-pill disabled"><span class="status-dot"></span> Disabled</span>
                    {/if}
                </div>
            </div>

            {if mod.description}
            <div class="module-desc">{mod.description}</div>
            {/if}

            <div class="module-meta" style="margin-bottom: 8px;">
                {if mod.author}<span>By {mod.author}</span>{/if}
                <span>{mod.route_count} routes</span>
                <span>{mod.nav_count} nav items</span>
            </div>

            <div class="module-actions">
                {if mod.enabled}
                <button class="btn-sm btn-disable" onclick="toggleModule('{mod.id}', false)">Disable</button>
                {else}
                <button class="btn-sm btn-enable" onclick="toggleModule('{mod.id}', true)">Enable</button>
                {/if}
                {if mod.tenant_admin_url}
                <a class="btn-sm btn-outline" href="{mod.tenant_admin_url}" style="margin-left:auto;">Tenant settings</a>
                {/if}
            </div>

            <div style="margin-top:10px;font-size:12px;color:var(--text-muted);">Module settings are configured by the admin on the tenant domain.</div>

            {if mod.show_allow_kernel_admin}
            <div class="optin-row">
                <input type="checkbox" id="optin-{mod.id}" {if mod.kernel_admin_guaranteed}disabled{/if} {if mod.allow_kernel_admin}checked{/if} onchange="toggleAdminOptin('{mod.id}', this.checked)">
                <label for="optin-{mod.id}">Allow kernel admin access{if mod.kernel_admin_guaranteed} <span class="optin-hint">(always allowed — module uses kernel auth)</span>{/if}</label>
            </div>
            {/if}
        </div>
        {/foreach}
    </div>
    {/if}
</div>

{/block}
