{extends "layouts/app.disyl"}

{block head}
<style>
    .sa-header { margin-bottom: 24px; }
    .sa-header h2 { font-size: 20px; font-weight: 700; color: var(--text); }
    .sa-header .sa-desc { font-size: 13px; color: var(--text-muted); margin-top: 4px; }
    .sa-catalog { margin-bottom: 20px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
    .sa-catalog-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--border); background: var(--bg); }
    .sa-catalog-title { font-size: 15px; font-weight: 700; color: var(--text); }
    .sa-catalog-desc { font-size: 12px; color: var(--text-muted); margin-top: 4px; }
    .sa-catalog-count { font-size: 11px; color: var(--text-muted); }
    .sa-catalog-table { width: 100%; border-collapse: collapse; }
    .sa-catalog-table th, .sa-catalog-table td { padding: 12px 16px; border-top: 1px solid var(--border); vertical-align: top; font-size: 12px; }
    .sa-catalog-table th { text-align: left; color: var(--text-muted); font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: .3px; }
    .sa-catalog-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
    .sa-catalog-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: flex-end; }
    .sa-tenant-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; padding: 12px 16px; background: var(--surface); border: 1px solid var(--border); border-radius: 10px; }
    .sa-tenant-bar label { font-size: 13px; font-weight: 600; color: var(--text); white-space: nowrap; }
    .sa-tenant-select { flex: 1; max-width: 360px; border: 1px solid var(--border); border-radius: 8px; padding: 7px 10px; font-size: 13px; color: var(--text); background: var(--bg); }
    .sa-module-list { display: grid; gap: 20px; }
    .sa-module { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; transition: opacity .2s; }
    .sa-module.sa-disabled { opacity: .65; }
    .sa-module-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--border); background: var(--bg); }
    .sa-module-left { display: flex; align-items: center; gap: 12px; }
    .sa-module-right { display: flex; align-items: center; gap: 10px; }
    .sa-module-name { font-size: 15px; font-weight: 700; color: var(--text); }
    .sa-module-version { font-size: 11px; font-weight: 600; color: var(--text-muted); background: var(--surface); padding: 2px 8px; border-radius: 8px; }
    .sa-module-collapse { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); color: var(--text-muted); padding: 6px 10px; cursor: pointer; transition: border-color .15s, color .15s, background .15s; }
    .sa-module-collapse:hover { border-color: var(--primary, #2563eb); color: var(--text); background: var(--bg); }
    .sa-module-collapse-label { font-size: 11px; font-weight: 600; }
    .sa-module-chevron { width: 8px; height: 8px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); transition: transform .15s ease; margin-top: -2px; }
    .sa-module-desc { font-size: 12px; color: var(--text-muted); padding: 4px 20px 0; }
    .sa-entitlement-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 20px 0; }
    .sa-entitlement-meta { display: flex; flex-wrap: wrap; gap: 6px; }
    .sa-module-body { display: block; }
    .sa-module[data-expanded="0"] .sa-module-body { display: none; }
    .sa-module[data-expanded="0"] .sa-module-header { border-bottom: none; }
    .sa-module[data-expanded="0"] .sa-module-chevron { transform: rotate(-45deg); margin-top: 1px; }
    .sa-badge { font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 6px; text-transform: uppercase; letter-spacing: .3px; }
    .sa-badge-on { background: #d1fae5; color: #065f46; }
    .sa-badge-off { background: #fee2e2; color: #991b1b; }
    .sa-badge-neutral { background: #e2e8f0; color: #334155; }
    .sa-toggle { position: relative; display: inline-block; width: 38px; height: 22px; flex-shrink: 0; }
    .sa-toggle input { opacity: 0; width: 0; height: 0; }
    .sa-toggle .sa-slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background: #ccc; border-radius: 22px; transition: .2s; }
    .sa-toggle .sa-slider::before { position: absolute; content: ""; height: 16px; width: 16px; left: 3px; bottom: 3px; background: #fff; border-radius: 50%; transition: .2s; }
    .sa-toggle input:checked + .sa-slider { background: var(--primary, #2563eb); }
    .sa-toggle input:checked + .sa-slider::before { transform: translateX(16px); }
    .sa-toggle input:disabled + .sa-slider { opacity: .5; cursor: not-allowed; }
    .sa-fields { padding: 16px 20px; display: grid; gap: 14px; }
    .sa-field { display: flex; flex-direction: column; gap: 6px; }
    .sa-field-inline { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--text); }
    .sa-field-label { font-size: 12px; font-weight: 600; color: var(--text); }
    .sa-field-help { font-size: 11px; color: var(--text-muted); }
    .sa-input, .sa-select { width: 100%; border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; font-size: 13px; color: var(--text); background: var(--surface); }
    .sa-actions { display: flex; justify-content: flex-end; gap: 8px; padding: 12px 20px; border-top: 1px solid var(--border); }
    .sa-btn-save { background: var(--primary); color: #fff; border: none; padding: 8px 18px; font-size: 12px; font-weight: 600; border-radius: 8px; cursor: pointer; transition: filter .15s; }
    .sa-btn-save:hover { filter: brightness(.92); }
    .sa-btn-save:disabled { opacity: .55; cursor: not-allowed; }
    .sa-btn-secondary { background: var(--surface); color: var(--text); border: 1px solid var(--border); padding: 7px 12px; font-size: 12px; font-weight: 600; border-radius: 8px; cursor: pointer; transition: border-color .15s, background .15s; }
    .sa-btn-secondary:hover { border-color: var(--primary, #2563eb); background: var(--bg); }
    .sa-modal { position: fixed; inset: 0; z-index: 1200; display: none; }
    .sa-modal.show { display: block; }
    .sa-modal-backdrop { position: absolute; inset: 0; background: rgba(15, 23, 42, .45); }
    .sa-modal-dialog { position: absolute; top: 10vh; left: 50%; transform: translateX(-50%); width: min(640px, 94vw); max-height: 80vh; overflow: hidden; border-radius: 14px; border: 1px solid var(--border); background: var(--surface); box-shadow: 0 18px 38px rgba(2, 6, 23, .25); display: flex; flex-direction: column; }
    .sa-modal-header { display: flex; align-items: start; justify-content: space-between; gap: 12px; padding: 16px 18px; border-bottom: 1px solid var(--border); background: var(--bg); }
    .sa-modal-title { font-size: 14px; font-weight: 700; color: var(--text); }
    .sa-modal-subtitle { margin-top: 4px; font-size: 12px; color: var(--text-muted); }
    .sa-modal-body { padding: 18px; overflow-y: auto; display: grid; gap: 14px; }
    .sa-modal-section { border: 1px solid var(--border); border-radius: 12px; background: var(--bg); padding: 14px; }
    .sa-modal-grid { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
    .sa-modal-label { font-size: 11px; font-weight: 700; letter-spacing: .3px; text-transform: uppercase; color: var(--text-muted); }
    .sa-modal-value { margin-top: 4px; font-size: 13px; color: var(--text); }
    .sa-modal-actions { display: flex; justify-content: flex-end; gap: 8px; padding: 14px 18px; border-top: 1px solid var(--border); }
    .sa-textarea { width: 100%; min-height: 120px; resize: vertical; border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; font-size: 13px; color: var(--text); background: var(--surface); }
    .sa-review-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .sa-status { font-size: 12px; padding: 0 20px 12px; }
    .sa-status.ok { color: var(--success, #059669); }
    .sa-status.err { color: var(--danger, #dc2626); }
    .sa-empty { text-align: center; padding: 48px 20px; color: var(--text-muted); font-size: 14px; }
    .sa-tenant-info { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: var(--text-muted); margin-left: 12px; }
    .sa-tenant-badge { font-size: 10px; font-weight: 600; padding: 2px 7px; border-radius: 6px; background: var(--surface); border: 1px solid var(--border); color: var(--text-muted); }
    .sa-module-count { font-size: 12px; color: var(--text-muted); margin-bottom: 16px; }
    .sa-module-notice { font-size: 12px; color: var(--text-muted); padding: 20px; text-align: center; }
    .sa-db-warning { background: #fef3c7; border: 1px solid #f59e0b; border-radius: 10px; padding: 12px 16px; margin-bottom: 20px; font-size: 13px; color: #92400e; display: flex; align-items: center; gap: 8px; }
    .sa-db-warning strong { font-weight: 700; }
</style>
{/block}

{block content}
<div class="sa-header">
    <h2>Feature Settings</h2>
    {if multi_tenant}
    <div class="sa-desc">Manage module feature flags and settings per tenant. Select a tenant, then enable/disable modules and adjust settings below.</div>
    {else}
    <div class="sa-desc">Manage module feature flags and settings. Changes take effect immediately.</div>
    {/if}
</div>

{if catalog_entries | count > 0}
<div class="sa-catalog">
    <div class="sa-catalog-header">
        <div>
            <div class="sa-catalog-title">Catalog Review</div>
            <div class="sa-catalog-desc">Approve or reject tenant-originated module packages for reuse across tenants, and set the catalog commercial mode.</div>
        </div>
        <div class="sa-catalog-count">{catalog_pending_count} pending of {catalog_entries | count} catalog entries</div>
    </div>
    <table class="sa-catalog-table">
        <thead>
            <tr>
                <th>Module</th>
                <th>Status</th>
                <th>Origin</th>
                <th style="text-align:right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {foreach catalog_entries as entry}
            <tr>
                <td>
                    <div style="font-weight:600;color:var(--text);">{entry.name}</div>
                    <div style="color:var(--text-muted);margin-top:4px;">{entry.id} · v{entry.version}</div>
                    <div class="sa-catalog-meta">
                        <span class="sa-badge {if entry.approval_status == 'approved'}sa-badge-on{elseif entry.approval_status == 'rejected'}sa-badge-off{else}sa-badge-neutral{/if}">{entry.approval_status}</span>
                        <span class="sa-badge sa-badge-neutral">{entry.commercial_mode}</span>
                        {if not entry.exists_on_disk}
                        <span class="sa-badge sa-badge-off">Missing Files</span>
                        {/if}
                    </div>
                </td>
                <td>
                    <div style="color:var(--text);">Source: {entry.source}</div>
                    {if entry.approved_at}
                    <div style="color:var(--text-muted);margin-top:4px;">Approved: {entry.approved_at}</div>
                    {/if}
                </td>
                <td>
                    {if entry.origin_tenant_label}
                    <div style="color:var(--text);">{entry.origin_tenant_label}</div>
                    {else}
                    <div style="color:var(--text-muted);">No tenant origin recorded</div>
                    {/if}
                </td>
                <td>
                    <div class="sa-catalog-actions">
                        <select id="sa-catalog-mode-{entry.id}" class="sa-select" style="width:auto;min-width:120px;">
                            <option value="free" {if entry.commercial_mode == 'free'}selected{/if}>Free</option>
                            <option value="freemium" {if entry.commercial_mode == 'freemium'}selected{/if}>Freemium</option>
                            <option value="paid" {if entry.commercial_mode == 'paid'}selected{/if}>Paid</option>
                        </select>
                        <button type="button" class="sa-btn-secondary" onclick="updateCatalogApproval('{entry.id}', 'approved')">Approve</button>
                        <button type="button" class="sa-btn-secondary" onclick="updateCatalogApproval('{entry.id}', 'rejected')">Reject</button>
                    </div>
                </td>
            </tr>
            {/foreach}
        </tbody>
    </table>
</div>
{/if}

{if access_requests | count > 0}
<div class="sa-catalog">
    <div class="sa-catalog-header">
        <div>
            <div class="sa-catalog-title">Tenant Access Requests</div>
            <div class="sa-catalog-desc">Review tenant requests for paid or pro access. Approving a request grants entitlement and invokes module license activation when a provider is available.</div>
        </div>
        <div class="sa-catalog-count">{access_request_pending_count} pending of {access_requests | count} requests</div>
    </div>
    <table class="sa-catalog-table">
        <thead>
            <tr>
                <th>Tenant / Module</th>
                <th>Request</th>
                <th>Status</th>
                <th style="text-align:right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {foreach access_requests as request}
            <tr>
                <td>
                    <div style="font-weight:600;color:var(--text);">{request.module_name}</div>
                    <div style="color:var(--text-muted);margin-top:4px;">{request.module_id}</div>
                    <div class="sa-catalog-meta">
                        <span class="sa-badge sa-badge-neutral">{request.tenant_label}</span>
                        <span class="sa-badge sa-badge-neutral">{request.requested_mode}</span>
                        {if request.license_ref}
                        <span class="sa-badge sa-badge-neutral">{request.license_ref}</span>
                        {/if}
                        {if request.has_license_key}
                        <span class="sa-badge sa-badge-neutral">Key on file</span>
                        {/if}
                    </div>
                </td>
                <td>
                    {if request.request_notes}
                    <div style="color:var(--text);">{request.request_notes}</div>
                    {else}
                    <div style="color:var(--text-muted);">No request notes supplied.</div>
                    {/if}
                    <div style="color:var(--text-muted);margin-top:4px;">Requested: {request.created_at}</div>
                </td>
                <td>
                    <span class="sa-badge {if request.status == 'approved'}sa-badge-on{elseif request.status == 'rejected'}sa-badge-off{else}sa-badge-neutral{/if}">{request.status}</span>
                    {if request.review_notes}
                    <div style="color:var(--text-muted);margin-top:6px;">{request.review_notes}</div>
                    {/if}
                    <div class="sa-review-meta">
                        {if request.activation_status}
                        <span class="sa-badge {if request.activation_status == 'active'}sa-badge-on{elseif request.activation_status == 'error'}sa-badge-off{else}sa-badge-neutral{/if}">License: {request.activation_status}</span>
                        {/if}
                        {if request.activation_provider}
                        <span class="sa-badge sa-badge-neutral">Provider: {request.activation_provider}</span>
                        {/if}
                    </div>
                    {if request.activation_error}
                    <div style="color:var(--danger, #dc2626);margin-top:6px;">{request.activation_error}</div>
                    {/if}
                    {if request.reviewed_at}
                    <div style="color:var(--text-muted);margin-top:4px;">Reviewed: {request.reviewed_at}</div>
                    {/if}
                    {if request.activation_at}
                    <div style="color:var(--text-muted);margin-top:4px;">License updated: {request.activation_at}</div>
                    {/if}
                </td>
                <td>
                    <div class="sa-catalog-actions">
                        {if request.status == 'pending'}
                        <button type="button" class="sa-btn-secondary" onclick="openAccessRequestReview({request.id}, 'approved')">Approve</button>
                        <button type="button" class="sa-btn-secondary" onclick="openAccessRequestReview({request.id}, 'rejected')">Reject</button>
                        {else}
                        <span class="sa-badge sa-badge-neutral">Reviewed</span>
                        {/if}
                    </div>
                </td>
            </tr>
            {/foreach}
        </tbody>
    </table>
</div>
{/if}

<div id="sa-access-request-modal" class="sa-modal" aria-hidden="true">
    <div class="sa-modal-backdrop" onclick="closeAccessRequestReview()"></div>
    <div class="sa-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="sa-access-request-title">
        <div class="sa-modal-header">
            <div>
                <div id="sa-access-request-title" class="sa-modal-title">Review Access Request</div>
                <div id="sa-access-request-subtitle" class="sa-modal-subtitle">Approve or reject a tenant module access request.</div>
            </div>
            <button type="button" class="sa-btn-secondary" onclick="closeAccessRequestReview()">Close</button>
        </div>
        <div class="sa-modal-body">
            <div class="sa-modal-section">
                <div class="sa-modal-grid">
                    <div>
                        <div class="sa-modal-label">Module</div>
                        <div id="sa-access-request-module" class="sa-modal-value"></div>
                    </div>
                    <div>
                        <div class="sa-modal-label">Tenant</div>
                        <div id="sa-access-request-tenant" class="sa-modal-value"></div>
                    </div>
                    <div>
                        <div class="sa-modal-label">Requested Mode</div>
                        <div id="sa-access-request-mode" class="sa-modal-value"></div>
                    </div>
                    <div>
                        <div class="sa-modal-label">License</div>
                        <div id="sa-access-request-license" class="sa-modal-value"></div>
                    </div>
                </div>
            </div>
            <div class="sa-modal-section">
                <div class="sa-modal-label">Tenant Note</div>
                <div id="sa-access-request-note" class="sa-modal-value"></div>
            </div>
            <div class="sa-modal-section">
                <div class="sa-modal-label">Review Note</div>
                <textarea id="sa-access-request-review-notes" class="sa-textarea" placeholder="Record why this request is being approved or rejected."></textarea>
            </div>
        </div>
        <div class="sa-modal-actions">
            <button type="button" class="sa-btn-secondary" onclick="closeAccessRequestReview()">Cancel</button>
            <button type="button" id="sa-access-request-submit" class="sa-btn-save" onclick="submitAccessRequestReview()">Submit</button>
        </div>
    </div>
</div>

{if multi_tenant}
<div class="sa-tenant-bar">
    <label for="sa-tenant-picker">Tenant:</label>
    <select id="sa-tenant-picker" class="sa-tenant-select" onchange="switchTenant(this.value)">
        {foreach tenants as t}
        <option value="{t.id}" {if t.selected}selected{/if}>{t.label}</option>
        {/foreach}
    </select>
</div>
{/if}

{if not tenant_db_ok}
<div class="sa-db-warning">
    <strong>Warning:</strong> This tenant has no database connection configured. Module toggles and settings are unavailable until a database is set up.
</div>
{/if}

{if modules | count == 0}
<div class="sa-empty">
    {if multi_tenant}
    <p>No modules are relevant for this tenant.</p>
    <p style="font-size:12px;margin-top:8px;">Select a different tenant above, or check the tenant's entry module configuration.</p>
    {else}
    <p>No modules discovered.</p>
    {/if}
</div>
{else}
{if multi_tenant}
<div class="sa-module-count">{module_count} module(s) for this tenant.</div>
{/if}
<div class="sa-module-list">
    {foreach modules as mod}
    <div class="sa-module {if not mod.is_enabled}sa-disabled{/if}" id="sa-mod-{mod.id}" data-expanded="1">
        <div class="sa-module-header">
            <div class="sa-module-left">
                {if tenant_db_ok}
                <label class="sa-toggle" title="{if mod.is_enabled}Disable{else}Enable{/if} {mod.name}">
                    <input type="checkbox" onchange="toggleModule('{mod.id}', this.checked)" {if mod.is_enabled}checked{/if} {if mod.entitlement_required and not mod.entitlement_allowed and not mod.is_enabled}disabled{/if}>
                    <span class="sa-slider"></span>
                </label>
                {/if}
                <div>
                    <span class="sa-module-name">{mod.name}</span>
                    {if mod.is_enabled}
                    <span class="sa-badge sa-badge-on">Enabled</span>
                    {else}
                    <span class="sa-badge sa-badge-off">Disabled</span>
                    {/if}
                </div>
            </div>
            <div class="sa-module-right">
                <span class="sa-module-version">v{mod.version}</span>
                <button type="button" class="sa-module-collapse" aria-expanded="true" aria-controls="sa-body-{mod.id}" onclick="toggleModulePanel('{mod.id}')">
                    <span class="sa-module-collapse-label">Collapse</span>
                    <span class="sa-module-chevron"></span>
                </button>
            </div>
        </div>
        <div class="sa-module-body" id="sa-body-{mod.id}">
        {if mod.description}
        <div class="sa-module-desc">{mod.description}</div>
        {/if}

        {if mod.catalog_managed}
        <div class="sa-entitlement-bar">
            <div class="sa-entitlement-meta">
                <span class="sa-badge sa-badge-neutral">Catalog: {mod.catalog_status}</span>
                <span class="sa-badge sa-badge-neutral">Mode: {mod.commercial_mode}</span>
                {if mod.entitlement_required}
                <span class="sa-badge {if mod.entitlement_allowed}sa-badge-on{else}sa-badge-off{/if}">Access: {mod.entitlement_status}</span>
                {/if}
            </div>
            {if multi_tenant and mod.entitlement_required}
            <button type="button" class="sa-btn-secondary" onclick="setModuleEntitlement('{mod.id}', {if mod.entitlement_allowed}false{else}true{/if})">
                {if mod.entitlement_allowed}Revoke Access{else}Grant Access{/if}
            </button>
            {/if}
        </div>
        {/if}

        {if not tenant_db_ok}
        <div class="sa-module-notice">This tenant needs a working database connection before module settings can be updated.</div>
        {elseif mod.catalog_managed and mod.catalog_status != 'approved'}
        <div class="sa-module-notice">This package is tracked in the platform catalog, but it is not approved for tenant reuse yet.</div>
        {elseif not mod.has_fields}
        <div class="sa-module-notice">This module has no configurable settings.</div>
        {else}
        {if mod.entitlement_required and not mod.entitlement_allowed}
        <div class="sa-module-notice">This tenant is not currently entitled to use this catalog-managed module. Grant access before enabling it.</div>
        {/if}
        {if not mod.is_enabled}
        <div class="sa-module-notice">This module is disabled for this tenant. You can still save settings now; they will apply when enabled.</div>
        {/if}
        <div class="sa-fields" id="sa-fields-{mod.id}">
            {foreach mod.fields as field}
            {if field.is_checkbox}
            <div class="sa-field">
                <label class="sa-field-inline">
                    <input type="checkbox" data-sa-module="{mod.id}" data-sa-key="{field.key}" data-sa-type="checkbox" {if field.is_checked}checked{/if}>
                    <span>{field.label}</span>
                </label>
                {if field.description}
                <div class="sa-field-help">{field.description}</div>
                {/if}
            </div>
            {elseif field.is_select}
            <div class="sa-field">
                <label class="sa-field-label">{field.label}</label>
                <select class="sa-select" data-sa-module="{mod.id}" data-sa-key="{field.key}" data-sa-type="select">
                    {foreach field.options as opt}
                    <option value="{opt.value}" {if opt.selected}selected{/if}>{opt.label}</option>
                    {/foreach}
                </select>
                {if field.description}
                <div class="sa-field-help">{field.description}</div>
                {/if}
            </div>
            {else}
            <div class="sa-field">
                <label class="sa-field-label">{field.label}</label>
                <input class="sa-input" type="{field.input_type}" data-sa-module="{mod.id}" data-sa-key="{field.key}" data-sa-type="{field.type}" value="{field.current_value}">
                {if field.description}
                <div class="sa-field-help">{field.description}</div>
                {/if}
            </div>
            {/if}
            {/foreach}
        </div>
        <div class="sa-status" id="sa-status-{mod.id}"></div>
        <div class="sa-actions">
            {if mod.settings_url}
            <a href="{mod.settings_url}" style="font-size:12px;color:var(--text-muted);text-decoration:none;padding:8px 14px;">Advanced Settings &rarr;</a>
            {/if}
            <button class="sa-btn-save" onclick="saveModuleSettings('{mod.id}')">Save</button>
        </div>
        {/if}
        </div>
    </div>
    {/foreach}
</div>
{/if}
{/block}

{block scripts}
<script>
var CSRF = '{csrf_token}';
var MULTI_TENANT = {if multi_tenant}true{else}false{/if};
var SELECTED_TENANT_ID = {selected_tenant_id};
var MODULE_PANEL_STORAGE_KEY = 'superadmin-feature-settings:panels:' + (SELECTED_TENANT_ID || 'global');
var ACCESS_REQUESTS = {access_requests_json|raw};
var openAccessRequestReviewState = null;

function readModulePanelState() {
    try {
        var raw = window.localStorage.getItem(MODULE_PANEL_STORAGE_KEY);
        var parsed = raw ? JSON.parse(raw) : {};
        return parsed && typeof parsed === 'object' ? parsed : {};
    } catch (e) {
        return {};
    }
}

function writeModulePanelState(state) {
    try {
        window.localStorage.setItem(MODULE_PANEL_STORAGE_KEY, JSON.stringify(state || {}));
    } catch (e) {
    }
}

function setModulePanelExpanded(moduleId, expanded) {
    var root = document.getElementById('sa-mod-' + moduleId);
    if (!root) return;

    root.setAttribute('data-expanded', expanded ? '1' : '0');

    var btn = root.querySelector('.sa-module-collapse');
    if (btn) {
        btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        var label = btn.querySelector('.sa-module-collapse-label');
        if (label) label.textContent = expanded ? 'Collapse' : 'Expand';
    }
}

function toggleModulePanel(moduleId) {
    var root = document.getElementById('sa-mod-' + moduleId);
    if (!root) return;

    var expanded = root.getAttribute('data-expanded') !== '0';
    var nextExpanded = !expanded;
    setModulePanelExpanded(moduleId, nextExpanded);

    var state = readModulePanelState();
    state[moduleId] = nextExpanded ? 1 : 0;
    writeModulePanelState(state);
}

function restoreModulePanels() {
    var state = readModulePanelState();
    document.querySelectorAll('.sa-module[id^="sa-mod-"]').forEach(function(root) {
        var moduleId = root.id.replace(/^sa-mod-/, '');
        var expanded = !Object.prototype.hasOwnProperty.call(state, moduleId) || state[moduleId] !== 0;
        setModulePanelExpanded(moduleId, expanded);
    });
}

function switchTenant(tenantId) {
    window.location.href = '/superadmin/settings?tenant_id=' + encodeURIComponent(tenantId);
}

function setStatus(moduleId, message, type) {
    var el = document.getElementById('sa-status-' + moduleId);
    if (!el) return;
    el.className = 'sa-status' + (type ? ' ' + type : '');
    el.textContent = message || '';
}

function updateCatalogApproval(moduleId, approvalStatus) {
    var modeSelect = document.getElementById('sa-catalog-mode-' + moduleId);
    var commercialMode = modeSelect ? modeSelect.value : 'free';

    fetch('/api/v1/superadmin/modules/catalog', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            module_id: moduleId,
            approval_status: approvalStatus,
            commercial_mode: commercialMode,
            _token: CSRF,
        })
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
        if (res.ok) {
            window.location.reload();
        } else {
            alert(res.error || 'Catalog update failed');
        }
    })
    .catch(function() {
        alert('Network error');
    });
}

function openAccessRequestReview(requestId, status) {
    var request = null;
    for (var i = 0; i < ACCESS_REQUESTS.length; i++) {
        if (Number(ACCESS_REQUESTS[i].id) === Number(requestId)) {
            request = ACCESS_REQUESTS[i];
            break;
        }
    }
    if (!request) {
        return;
    }

    openAccessRequestReviewState = {
        requestId: requestId,
        status: status,
    };

    document.getElementById('sa-access-request-title').textContent = status === 'approved' ? 'Approve Access Request' : 'Reject Access Request';
    document.getElementById('sa-access-request-subtitle').textContent = status === 'approved'
        ? 'Grant entitlement and record the license activation state for this tenant.'
        : 'Record the rejection and keep the request in the review history.';
    document.getElementById('sa-access-request-module').textContent = request.module_name + ' (' + request.module_id + ')';
    document.getElementById('sa-access-request-tenant').textContent = request.tenant_label;
    document.getElementById('sa-access-request-mode').textContent = request.requested_mode;
    document.getElementById('sa-access-request-license').textContent = request.license_ref || (request.has_license_key ? 'License key on file' : 'No license key supplied');
    document.getElementById('sa-access-request-note').textContent = request.request_notes || 'No request note supplied.';
    document.getElementById('sa-access-request-review-notes').value = request.review_notes || '';
    document.getElementById('sa-access-request-submit').textContent = status === 'approved' ? 'Approve Request' : 'Reject Request';

    var modal = document.getElementById('sa-access-request-modal');
    modal.classList.add('show');
    modal.setAttribute('aria-hidden', 'false');
}

function closeAccessRequestReview() {
    var modal = document.getElementById('sa-access-request-modal');
    if (!modal) {
        return;
    }

    openAccessRequestReviewState = null;
    modal.classList.remove('show');
    modal.setAttribute('aria-hidden', 'true');
}

function submitAccessRequestReview() {
    if (!openAccessRequestReviewState) {
        return;
    }

    var reviewNotes = document.getElementById('sa-access-request-review-notes').value;

    fetch('/api/v1/superadmin/modules/access-request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            request_id: openAccessRequestReviewState.requestId,
            status: openAccessRequestReviewState.status,
            review_notes: reviewNotes,
            _token: CSRF,
        })
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
        if (res.ok) {
            closeAccessRequestReview();
            window.location.reload();
        } else {
            alert(res.error || 'Access request review failed');
        }
    })
    .catch(function() {
        alert('Network error');
    });
}

function toggleModule(moduleId, enabled) {
    var payload = { module_id: moduleId, enabled: enabled, _token: CSRF };
    if (MULTI_TENANT && SELECTED_TENANT_ID) {
        payload.tenant_id = SELECTED_TENANT_ID;
    }
    fetch('/api/v1/superadmin/modules/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
        if (res.ok) {
            window.location.reload();
        } else {
            alert(res.error || 'Toggle failed');
            window.location.reload();
        }
    })
    .catch(function() {
        alert('Network error');
        window.location.reload();
    });
}

function setModuleEntitlement(moduleId, entitled) {
    if (!MULTI_TENANT || !SELECTED_TENANT_ID) {
        return;
    }

    setStatus(moduleId, entitled ? 'Granting access...' : 'Revoking access...', '');
    fetch('/api/v1/superadmin/modules/entitlement', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            module_id: moduleId,
            tenant_id: SELECTED_TENANT_ID,
            entitled: entitled,
            _token: CSRF,
        })
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
        if (res.ok) {
            window.location.reload();
        } else {
            setStatus(moduleId, res.error || 'Entitlement update failed', 'err');
        }
    })
    .catch(function() {
        setStatus(moduleId, 'Network error', 'err');
    });
}

function saveModuleSettings(moduleId) {
    var container = document.getElementById('sa-fields-' + moduleId);
    if (!container) return;

    var settings = {};
    var controls = container.querySelectorAll('[data-sa-key]');
    controls.forEach(function(el) {
        var key = el.getAttribute('data-sa-key');
        var type = (el.getAttribute('data-sa-type') || 'text').toLowerCase();
        if (!key) return;
        if (type === 'checkbox') {
            settings[key] = !!el.checked;
        } else {
            settings[key] = el.value;
        }
    });

    setStatus(moduleId, 'Saving...', '');
    var btn = container.closest('.sa-module').querySelector('.sa-btn-save');
    if (btn) btn.disabled = true;

    var payload = { module_id: moduleId, settings: settings, _token: CSRF };
    if (MULTI_TENANT && SELECTED_TENANT_ID) {
        payload.tenant_id = SELECTED_TENANT_ID;
    }

    fetch('/api/v1/superadmin/modules/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
        if (res.ok) {
            setStatus(moduleId, 'Settings saved.', 'ok');
            if (typeof showToast === 'function') showToast('Settings saved');
        } else {
            setStatus(moduleId, res.error || 'Save failed', 'err');
        }
    })
    .catch(function() {
        setStatus(moduleId, 'Network error', 'err');
    })
    .finally(function() {
        if (btn) btn.disabled = false;
    });
}

restoreModulePanels();
</script>
{/block}
