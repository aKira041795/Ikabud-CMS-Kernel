{extends "layouts/app.disyl"}

{block title}Platform Dashboard{/block}

{block content}
<style>
.platform-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 28px; }
.platform-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; }
.platform-card h3 { margin: 0 0 14px 0; font-size: 15px; font-weight: 600; color: var(--text); display: flex; align-items: center; gap: 8px; }
.platform-card h3 .badge { font-size: 11px; font-weight: 500; padding: 2px 8px; border-radius: 10px; }
.badge-ok { background: var(--success-light); color: var(--success); }
.badge-warn { background: var(--warning-light); color: var(--warning); }
.badge-err { background: var(--danger-light); color: var(--danger); }
.badge-info { background: var(--primary-light); color: var(--primary); }
.stat-row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid var(--border); font-size: 13px; }
.stat-row:last-child { border-bottom: none; }
.stat-label { color: var(--text-muted); }
.stat-value { font-weight: 600; color: var(--text); font-family: monospace; }
.cap-list { max-height: 420px; overflow-y: auto; }
.cap-row { padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 12px; }
.cap-row:last-child { border-bottom: none; }
.cap-top { display: flex; justify-content: space-between; align-items: center; }
.cap-id { font-family: monospace; color: var(--primary); font-weight: 600; }
.cap-label { font-size: 13px; font-weight: 600; color: var(--text); }
.cap-desc { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
.mod-row { padding: 6px 0; border-bottom: 1px solid var(--border); font-size: 13px; }
.mod-row:last-child { border-bottom: none; }
.mod-name { font-weight: 600; }
.mod-version { font-family: monospace; font-size: 11px; color: var(--text-muted); margin-left: 6px; }
.mod-compat { font-size: 11px; margin-left: 8px; }
.section-title { font-size: 16px; font-weight: 700; margin: 24px 0 14px 0; color: var(--text); }
.section-title:first-child { margin-top: 0; }
#platform-data { min-height: 200px; }
.platform-loading { text-align: center; padding: 40px; color: var(--text-muted); }
.trace-row { padding: 6px 0; border-bottom: 1px solid var(--border); font-size: 12px; display: flex; gap: 10px; align-items: flex-start; }
.trace-row:last-child { border-bottom: none; }
.trace-ts { font-family: monospace; color: var(--text-muted); font-size: 11px; white-space: nowrap; min-width: 130px; }
.trace-ok { color: var(--success); font-weight: 700; }
.trace-err { color: var(--danger); font-weight: 700; }
.trace-detail { flex: 1; }
.trace-ids { font-family: monospace; font-size: 11px; color: var(--text-light); margin-top: 2px; }
.trace-timeline-grid { display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 14px; }
.trace-timeline-card { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); padding: 14px; }
.trace-timeline-top { display:flex; justify-content:space-between; gap:10px; align-items:flex-start; }
.trace-timeline-key { font-family: monospace; font-size: 12px; color: var(--primary); font-weight: 700; }
.trace-timeline-meta { font-size: 11px; color: var(--text-muted); margin-top: 4px; }
.trace-status-pill { display:inline-flex; align-items:center; border-radius:999px; padding:3px 8px; font-size:11px; font-weight:700; }
.trace-status-pill.success { background: var(--success-light); color: var(--success); }
.trace-status-pill.failed { background: var(--danger-light); color: var(--danger); }
.trace-status-pill.rate_limited { background: var(--warning-light); color: var(--warning); }
.trace-status-pill.skipped_invalid { background: color-mix(in srgb, var(--surface) 75%, var(--primary-light)); color: var(--text); }
.trace-status-pill.unknown { background: color-mix(in srgb, var(--surface) 80%, var(--border)); color: var(--text); }
.trace-counts { display:flex; gap:6px; flex-wrap:wrap; margin-top:10px; }
.trace-mini-list { display:grid; gap:8px; margin-top:12px; }
.trace-mini-item { border-top: 1px solid var(--border); padding-top: 8px; }
.trace-mini-item:first-child { border-top: none; padding-top: 0; }
.trace-mini-main { font-size: 12px; color: var(--text); }
.trace-mini-sub { font-family: monospace; font-size: 11px; color: var(--text-muted); margin-top: 3px; }
.trace-actions { display:flex; gap:8px; flex-wrap:wrap; margin-top:12px; }
.glossary-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
.glossary-item { padding: 10px 14px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); }
.glossary-term { font-weight: 700; font-size: 13px; color: var(--primary); }
.glossary-plain { font-size: 12px; color: var(--text-muted); margin-top: 3px; }
.warn-list { display: flex; flex-direction: column; gap: 10px; }
.warn-item { padding: 10px 12px; border: 1px solid var(--warning); border-radius: var(--radius); background: var(--warning-light); }
.warn-item-title { font-size: 12px; font-weight: 700; color: var(--warning); }
.warn-item-meta { font-size: 11px; color: var(--text-muted); margin-top: 4px; }
.warn-item pre { margin: 8px 0 0 0; font-size: 11px; color: var(--text); white-space: pre-wrap; word-break: break-word; }
.flow-card { background: linear-gradient(180deg, var(--surface), color-mix(in srgb, var(--surface) 92%, var(--primary-light))); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; margin-bottom: 18px; }
.flow-title { font-size: 14px; font-weight: 700; margin-bottom: 8px; }
.flow-sub { font-size: 12px; color: var(--text-muted); margin-bottom: 12px; }
.flow-steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 10px; }
.flow-step { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); padding: 10px; }
.flow-step-num { font-family: monospace; font-size: 11px; color: var(--primary); font-weight: 700; }
.flow-step-label { font-size: 12px; font-weight: 700; color: var(--text); margin-top: 2px; }
.flow-step-note { font-size: 11px; color: var(--text-muted); margin-top: 4px; line-height: 1.4; }
.action-list { margin-top: 12px; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px; }
.action-item { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); padding: 10px; }
.action-item h4 { margin: 0; font-size: 12px; font-weight: 700; }
.action-item p { margin: 6px 0 0 0; font-size: 11px; color: var(--text-muted); line-height: 1.45; }
.section-help { font-size: 12px; color: var(--text-muted); margin: -4px 0 10px 0; }
.term-guide-card { padding: 0; overflow: hidden; }
.term-guide-summary { list-style: none; cursor: pointer; padding: 14px 16px; font-size: 13px; font-weight: 700; color: var(--text); border-bottom: 1px solid var(--border); background: var(--surface); }
.term-guide-summary::-webkit-details-marker { display: none; }
.term-guide-summary::before { content: '▸'; display: inline-block; margin-right: 8px; color: var(--primary); transition: transform .15s ease; }
.term-guide-card[open] .term-guide-summary::before { transform: rotate(90deg); }
.term-guide-body { padding: 14px 16px 16px; }
.cache-actions { display: flex; align-items: center; gap: 10px; margin: 12px 0 2px; }
.cache-action-msg { font-size: 11px; color: var(--text-muted); min-height: 14px; }
.updates-actions { display: flex; gap: 10px; align-items: center; margin-top: 12px; flex-wrap: wrap; }
.updates-msg { font-size: 11px; color: var(--text-muted); min-height: 14px; }
.update-list { display: flex; flex-direction: column; gap: 8px; margin-top: 10px; }
.update-item { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); padding: 10px 12px; }
.update-item-top { display: flex; justify-content: space-between; gap: 12px; align-items: center; }
.update-item-title { font-size: 12px; font-weight: 700; color: var(--text); }
.update-item-meta { font-size: 11px; color: var(--text-muted); margin-top: 4px; }
.update-empty { color: var(--text-muted); font-size: 12px; margin-top: 8px; }
</style>

<div class="page-header">
    <div>
        <h2>Platform Dashboard</h2>
        <div class="page-desc">Unified operator view of kernel identity, health, modules, capabilities, and automations — all from kernel-owned truth.</div>
    </div>
    <div class="page-actions">
        <button class="btn btn-outline btn-sm" onclick="window.location.reload()">Refresh</button>
    </div>
</div>

<div id="platform-data">
    <div class="platform-loading">Loading platform state...</div>
</div>

<script>
(function() {
    var BASE = '{base_url}';
    var GLOSSARY = {};

    Promise.all([
        fetch(BASE + '/api/v1/platform', { headers: { 'Accept': 'application/json' } }).then(function(r) { return r.json(); }),
        fetch(BASE + '/api/v1/admin/cache/health', { headers: { 'Accept': 'application/json' } })
            .then(function(r) { return r.json(); })
            .catch(function() { return { ok: false }; })
    ])
    .then(function(results) {
        var data = results[0] || {};
        var cacheData = results[1] || {};
        if (!data.ok) {
            document.getElementById('platform-data').innerHTML =
                '<div class="platform-loading" style="color:var(--danger)">Failed to load: ' + (data.error || 'unknown') + '</div>';
            return;
        }

        GLOSSARY = data.glossary || {};
        var p = data.platform || {};
        var k = p.kernel || {};
        var a = p.app || {};
        var rt = p.runtime || {};
        var mods = data.modules || {};
        var caps = data.capabilities || {};
        var evts = data.events || {};
        var trigs = data.triggers || {};
        var health = data.health || {};
        var runtime = data.runtime || {};
        var updates = data.updates || {};
        var traces = data.traces || [];
        var timelines = data.trace_timelines || [];
        var skipped = Array.isArray(mods.skipped) ? mods.skipped : [];
        var cache = cacheData.ok ? (cacheData.cache || {}) : null;
        var hostCache = cacheData.ok ? (cacheData.tenant_host_lookup_cache || {}) : null;
        var hostMetrics = hostCache && hostCache.metrics ? hostCache.metrics : {};

        var html = '';

        // Process explainer
        html += '<div class="flow-card">';
        html += '<div class="flow-title">How A Visit Is Processed</div>';
        html += '<div class="flow-sub">Use this quick map to understand where a page request can fail and what to check next.</div>';
        html += '<div class="flow-steps">';
        html += flowStep('01', 'Find Tenant', rt.multi_tenant_enabled ? 'The incoming domain is matched to a tenant before any page logic runs.' : 'Single-site mode is active, so tenant lookup is skipped.');
        html += flowStep('02', 'Open Tenant Entry', 'The tenant entry module must exist and be loadable, or traffic is safely blocked with an unavailable page.');
        html += flowStep('03', 'Pick Route', routeModeExplain(runtime.route_ambiguity_mode || rt.route_ambiguity_mode || 'warn'));
        html += flowStep('04', 'Run Service Call', 'The platform chooses the right provider and applies safety checks before running service logic.');
        html += flowStep('05', 'Record Outcome', 'Success/failure, timings, and automation activity are added to health and trace diagnostics.');
        html += '</div>';

        html += '<div class="action-list">';
        html += actionItem('If homepage returns 404 or 503', 'Open Tenants, check the selected entry module, and make sure it is enabled and loadable. Then review Safety Checks below for exact skip reasons.');
        html += actionItem('If route warnings keep repeating', 'Switch ambiguity handling from warn to block in a controlled rollout, then fix overlapping route patterns reported in logs.');
        html += actionItem('If errors spike or breakers open', 'Review Service Registry and recent traces, then temporarily disable unstable module integrations until calls stabilize.');
        html += '</div>';
        html += '</div>';

        html += '<div class="platform-grid">';

        // Identity card
        html += '<div class="platform-card">';
        html += '<h3>Kernel Identity <span class="badge badge-ok">v' + esc(k.version || '?') + '</span></h3>';
        html += statRow('Codename', k.codename || '');
        html += statRow('PHP', k.php_version || '');
        html += statRow('App', esc(a.name || '') + ' v' + esc(a.version || ''));
        html += statRow('Environment', a.env || '');
        html += statRow('Input Validation Mode', rt.schema_enforcement_mode || 'warn');
        html += statRow('Multi-Tenant', rt.multi_tenant_enabled ? 'Yes' : 'No');
        html += '</div>';

        // Health card
        var breakers = health.breakers_open || 0;
        var healthBadge = breakers > 0 ? 'badge-err' : (health.total_errors > 0 ? 'badge-warn' : 'badge-ok');
        var healthLabel = breakers > 0 ? (breakers + ' breaker(s) open') : (health.total_errors > 0 ? 'has errors' : 'healthy');
        html += '<div class="platform-card">';
        html += '<h3>System Health <span class="badge ' + healthBadge + '">' + healthLabel + '</span></h3>';
        html += statRow('Total ' + glossTip('_term.capability', 'Service') + ' Calls', health.total_calls || 0);
        html += statRow('Total Errors', health.total_errors || 0);
        html += statRow(glossTip('_term.breaker', 'Breakers') + ' Open', breakers);
        html += statRow(glossTip('_term.capability', 'Services') + ' Registered', rt.capabilities_count || 0);
        html += statRow(glossTip('_term.provider', 'Providers'), rt.providers_count || 0);
        html += statRow('Skipped Modules', mods.skipped_count || 0);
        html += '</div>';

        // Cache health card
        html += '<div class="platform-card">';
        if (cache) {
            var cacheErrors = Number(cache.errors || 0);
            var cacheBadge = cacheErrors > 0 ? 'badge-warn' : 'badge-ok';
            var cacheLabel = cacheErrors > 0 ? ('errors: ' + cacheErrors) : 'stable';
            html += '<h3>Cache Health <span class="badge ' + cacheBadge + '">' + cacheLabel + '</span></h3>';
            html += statRow('Hit Rate', cache.hit_rate || '0%');
            html += statRow('Cached Files', cache.cached_files || 0);
            html += statRow('Active Files', cache.active_files || 0);
            html += statRow('Expired Files', cache.expired_files || 0);
            html += statRow('Cache Size (MB)', cache.total_size_mb || 0);
            html += statRow('APCu Available', cache.apcu_available ? 'Yes' : 'No');
            html += statRow('Host Lookup Memory Hits', hostMetrics.memory_hits || 0);
            html += statRow('Host Lookup APCu Hits', hostMetrics.apcu_hits || 0);
            html += statRow('Host Lookup DB Hits', hostMetrics.db_hits || 0);
            html += statRow('Host Lookup Misses', hostMetrics.misses || 0);
            html += statRow('Host Cache TTL (sec)', hostCache && hostCache.ttl_seconds ? hostCache.ttl_seconds : 0);
            html += '<div class="cache-actions">';
            html += '<button id="clear-platform-cache-btn" class="btn btn-outline btn-sm">Clear Cache</button>';
            html += '<span id="clear-platform-cache-msg" class="cache-action-msg"></span>';
            html += '</div>';
        } else {
            html += '<h3>Cache Health <span class="badge badge-warn">unavailable</span></h3>';
            html += '<div class="section-help" style="margin:0;">Cache diagnostics endpoint is unreachable or returned an error.</div>';
        }
        html += '</div>';

        // Modules card
        html += '<div class="platform-card">';
        html += '<h3>Modules <span class="badge badge-info">' + (mods.enabled_count || 0) + ' enabled</span></h3>';
        var allMods = (mods.enabled || []).concat(mods.disabled || []);
        allMods.forEach(function(m) {
            var enabled = (mods.enabled || []).some(function(e) { return e.id === m.id; });
            var statusBadge = enabled ? '<span class="badge badge-ok" style="font-size:10px;">on</span>' : '<span class="badge badge-warn" style="font-size:10px;">off</span>';
            var compat = '';
            if (m.requires_kernel) { compat = '<span class="mod-compat badge badge-info">requires &ge; ' + esc(m.requires_kernel) + '</span>'; }
            if (m.status === 'legacy_compatibility') { compat += '<span class="mod-compat badge badge-warn">legacy</span>'; }
            html += '<div class="mod-row">' + statusBadge + ' <span class="mod-name">' + esc(m.name || m.id) + '</span><span class="mod-version">' + esc(m.version || '') + '</span>' + compat + '</div>';
        });
        html += '</div>';

        // Updates card
        var kernelUpdate = updates.kernel || {};
        var moduleUpdatesCount = Number(updates.module_updates_count || 0);
        var updatesBadge = kernelUpdate.update_available || moduleUpdatesCount > 0 ? 'badge-warn' : 'badge-ok';
        var updatesLabel = 'up to date';
        if (kernelUpdate.update_available && moduleUpdatesCount > 0) {
            updatesLabel = 'kernel + ' + String(moduleUpdatesCount) + ' module updates';
        } else if (kernelUpdate.update_available) {
            updatesLabel = 'kernel update';
        } else if (moduleUpdatesCount > 0) {
            updatesLabel = String(moduleUpdatesCount) + ' module update' + (moduleUpdatesCount === 1 ? '' : 's');
        }
        html += '<div class="platform-card">';
        html += '<h3>Updates <span class="badge ' + updatesBadge + '">' + esc(updatesLabel) + '</span></h3>';
        html += statRow('Source Repo', updates.repo || 'not configured');
        html += statRow('Catalog Ready', updates.catalog_ready ? 'Yes' : 'No');
        html += statRow('Installed Kernel', kernelUpdate.installed_version || '');
        html += statRow('Available Kernel', kernelUpdate.available_version || 'none');
        html += statRow('Module Updates', moduleUpdatesCount);
        html += statRow('Manifest Support', updates.manifest_support ? 'Yes' : 'No');
        html += statRow('Last Checked', updates.last_sync && updates.last_sync.updated_at ? updates.last_sync.updated_at : 'never');
        html += '<div class="updates-actions">';
        html += '<button id="check-updates-btn" class="btn btn-outline btn-sm">Check Now</button>';
        if (kernelUpdate.release_url) {
            html += '<a class="btn btn-sm" href="' + escAttr(kernelUpdate.release_url) + '" target="_blank" rel="noreferrer">Open Release</a>';
        }
        html += '</div>';
        html += '<div id="check-updates-msg" class="updates-msg"></div>';
        if (kernelUpdate.summary) {
            html += '<div class="section-help" style="margin-top:10px;">' + esc(kernelUpdate.summary) + '</div>';
        }
        var moduleUpdates = (updates.modules || []).filter(function(mod) { return !!mod.update_available; });
        if (moduleUpdates.length > 0) {
            html += '<div class="update-list">';
            moduleUpdates.slice(0, 6).forEach(function(mod) {
                html += '<div class="update-item">';
                html += '<div class="update-item-top"><div class="update-item-title">' + esc(mod.name || mod.id) + '</div><div class="badge badge-warn">' + esc(mod.installed_version || '') + ' → ' + esc(mod.available_version || '') + '</div></div>';
                html += '<div class="update-item-meta">' + esc(mod.summary || 'Update metadata loaded from the latest release manifest.') + '</div>';
                html += '</div>';
            });
            html += '</div>';
        } else {
            html += '<div class="update-empty">No module updates are currently advertised by the release catalog.</div>';
        }
        html += '</div>';

        // Runtime safeguards card
        var runtimeBadge = skipped.length > 0 ? 'badge-warn' : 'badge-ok';
        var runtimeLabel = skipped.length > 0 ? (skipped.length + ' warning(s)') : 'stable';
        html += '<div class="platform-card">';
        html += '<h3>Safety Checks <span class="badge ' + runtimeBadge + '">' + runtimeLabel + '</span></h3>';
        html += statRow('Route Ambiguity Mode', runtime.route_ambiguity_mode || rt.route_ambiguity_mode || 'warn');
        html += statRow('Skipped Modules', skipped.length);
        if (skipped.length === 0) {
            html += '<div class="cap-empty" style="margin-top:8px;">No modules were skipped during this request.</div>';
        } else {
            html += '<div class="warn-list" style="margin-top:10px;">';
            skipped.forEach(function(item) {
                var ctx = item.context || {};
                html += '<div class="warn-item">';
                html += '<div class="warn-item-title">' + esc(item.module || '?') + ' — ' + esc(item.reason || 'skipped') + '</div>';
                html += '<div class="warn-item-meta">This module was excluded from runtime loading for safety. ' + esc(skipReasonHint(item.reason || '')) + '</div>';
                if (Object.keys(ctx).length > 0) {
                    html += '<pre>' + esc(JSON.stringify(ctx, null, 2)) + '</pre>';
                }
                html += '</div>';
            });
            html += '</div>';
        }
        html += '</div>';

        // Events & Triggers card
        html += '<div class="platform-card">';
        html += '<h3>' + glossTip('_term.event', 'Events') + ' & ' + glossTip('_term.trigger', 'Automations') + '</h3>';
        html += statRow('Registered ' + glossTip('_term.event', 'Events'), evts.count || 0);
        html += statRow('Total ' + glossTip('_term.trigger', 'Automations'), trigs.total || 0);
        html += statRow('Active ' + glossTip('_term.trigger', 'Automations'), trigs.enabled || 0);
        html += statRow('Recorded Runs', trigs.executions || 0);
        html += statRow('Active Trace Timelines', trigs.timelines || 0);
        html += '</div>';

        html += '</div>'; // end grid

        // Capabilities table with glossary labels
        html += '<h2 class="section-title">' + glossTip('_term.capability', 'Service') + ' Registry</h2>';
        html += '<div class="section-help">Use this list to confirm which service IDs are live and how strictly their input validation is enforced.</div>';
        html += '<div class="platform-card"><div class="cap-list">';
        var entries = caps.entries || [];
        if (entries.length === 0) {
            html += '<div style="color:var(--text-muted); font-size:13px;">No services registered.</div>';
        }
        entries.forEach(function(c) {
            var g = GLOSSARY[c.id] || {};
            var mode = c.effective_schema_mode || 'warn';
            var modeClass = mode === 'enforce' ? 'badge-ok' : (mode === 'off' ? 'badge-warn' : 'badge-info');
            var modeG = GLOSSARY['_term.schema_mode.' + mode] || {};
            html += '<div class="cap-row">';
            html += '<div class="cap-top">';
            html += '<span>' + (g.label ? '<span class="cap-label">' + esc(g.label) + '</span> ' : '') + '<span class="cap-id">' + esc(c.id) + '</span></span>';
            html += '<span><span class="badge ' + modeClass + '" title="' + esc(modeG.description || mode) + '">' + (modeG.label || mode) + '</span> <span style="color:var(--text-muted); font-size:11px;">' + (c.provider_count || 0) + ' ' + glossTip('_term.provider', 'provider') + '(s)</span></span>';
            html += '</div>';
            html += '</div>';
        });
        html += '</div></div>';

        if (timelines.length > 0) {
            html += '<h2 class="section-title">Recent Trace Timelines</h2>';
            html += '<div class="section-help">Grouped execution chains keyed by external reference, correlation id, request id, or trigger fallback.</div>';
            html += '<div class="trace-timeline-grid">';
            timelines.forEach(function(timeline) {
                html += '<div class="trace-timeline-card">';
                html += '<div class="trace-timeline-top">';
                html += '<div>';
                html += '<div class="trace-timeline-key">' + esc(timeline.label || timeline.key || 'Timeline') + '</div>';
                html += '<div class="trace-timeline-meta">Latest: ' + esc(timeline.last_execution_at || '—') + '</div>';
                html += '</div>';
                html += traceStatusPill(timeline.latest_status || 'unknown');
                html += '</div>';
                html += '<div class="trace-counts">';
                html += '<span class="badge badge-info">' + esc(String(timeline.execution_count || 0)) + ' runs</span>';
                if (timeline.success_count) html += '<span class="badge badge-ok">' + esc(String(timeline.success_count)) + ' success</span>';
                if (timeline.failed_count) html += '<span class="badge badge-err">' + esc(String(timeline.failed_count)) + ' failed</span>';
                if (timeline.rate_limited_count) html += '<span class="badge badge-warn">' + esc(String(timeline.rate_limited_count)) + ' rate limited</span>';
                if (timeline.skipped_invalid_count) html += '<span class="badge badge-info">' + esc(String(timeline.skipped_invalid_count)) + ' skipped invalid</span>';
                html += '</div>';
                html += '<div class="trace-mini-list">';
                (timeline.executions || []).forEach(function(item) {
                    var evtG = GLOSSARY[item.event_key] || {};
                    var capG = GLOSSARY[item.capability_id] || {};
                    html += '<div class="trace-mini-item">';
                    html += '<div class="trace-mini-main">' + traceStatusPill(item.status || 'unknown') + ' <strong>' + (evtG.label || esc(item.event_key || '')) + '</strong> → <strong>' + (capG.label || esc(item.capability_id || '')) + '</strong></div>';
                    html += '<div class="trace-mini-sub">' + esc(item.created_at || '—') + ' · ' + esc(String(item.duration_ms || 0)) + 'ms';
                    if (item.external_reference) html += ' · ref ' + esc(item.external_reference);
                    else if (item.correlation_id) html += ' · corr ' + esc(item.correlation_id);
                    else if (item.request_id) html += ' · req ' + esc(item.request_id);
                    html += '</div>';
                    if (item.error_message) {
                        html += '<div class="trace-mini-sub" style="color:var(--danger);">' + esc(item.error_message) + '</div>';
                    }
                    html += '</div>';
                });
                html += '</div>';
                html += '<div class="trace-actions"><a class="btn btn-outline btn-sm" href="' + escAttr(buildTriggerTraceUrl({
                    external_reference: timeline.external_reference || '',
                    correlation_id: timeline.correlation_id || '',
                    request_id: timeline.request_id || '',
                    trigger_id: timeline.key_type === 'trigger_id' ? (timeline.key || '') : ''
                })) + '">Open In Automation Rules</a></div>';
                html += '</div>';
            });
            html += '</div>';
        }

        // Trigger execution traces
        if (traces.length > 0) {
            html += '<h2 class="section-title">' + glossTip('_term.trigger', 'Automation') + ' Execution Traces</h2>';
            html += '<div class="platform-card">';
            traces.forEach(function(t) {
                var evtG = GLOSSARY[t.event] || {};
                var capG = GLOSSARY[t.capability] || {};
                html += '<div class="trace-row">';
                html += '<span class="trace-ts">' + esc(t._timestamp || '') + '</span>';
                html += traceStatusPill(t.status || (t.ok ? 'success' : 'failed'));
                html += '<div class="trace-detail">';
                html += '<strong>' + (evtG.label || esc(t.event || '')) + '</strong> → <strong>' + (capG.label || esc(t.capability || '')) + '</strong>';
                if (t.error) { html += ' <span style="color:var(--danger); font-size:11px;">— ' + esc(t.error) + '</span>'; }
                html += '<div class="trace-ids">' + glossTip('_term.correlation_id', 'Trace') + ': ' + esc(t.correlation_id || '?') + ' · req: ' + esc(t.request_id || '?') + ' · ' + (t.duration_ms || 0) + 'ms · module: ' + esc(t.module || '?');
                if (t.external_reference) html += ' · ref: ' + esc(t.external_reference);
                html += '</div>';
                html += '<div class="trace-actions"><a class="btn btn-outline btn-sm" href="' + escAttr(buildTriggerTraceUrl({
                    external_reference: t.external_reference || '',
                    correlation_id: t.correlation_id || '',
                    request_id: t.request_id || '',
                    trigger_id: t.trigger_id || ''
                })) + '">Open In Automation Rules</a></div>';
                html += '</div></div>';
            });
            html += '</div>';
        }

        // Platform concepts glossary (optional)
        html += '<h2 class="section-title">Term Guide</h2>';
        html += '<details class="platform-card term-guide-card">';
        html += '<summary class="term-guide-summary">Show quick definitions</summary>';
        html += '<div class="term-guide-body">';
        html += '<div class="section-help">Optional reference for platform terms used above. Keep collapsed during normal monitoring.</div>';
        html += '<div class="glossary-grid">';
        var termKeys = Object.keys(GLOSSARY).filter(function(k) { return k.indexOf('_term.') === 0; }).sort();
        termKeys.forEach(function(k) {
            var g = GLOSSARY[k];
            html += '<div class="glossary-item">';
            html += '<div class="glossary-term">' + esc(g.label || k) + '</div>';
            html += '<div class="glossary-plain">' + esc(g.description || '') + '</div>';
            html += '</div>';
        });
        html += '</div>';
        html += '</div>';
        html += '</details>';

        document.getElementById('platform-data').innerHTML = html;
        bindCacheClearAction(BASE);
        bindUpdateCheckAction(BASE);
    })
    .catch(function(err) {
        document.getElementById('platform-data').innerHTML =
            '<div class="platform-loading" style="color:var(--danger)">Network error loading platform data.</div>';
    });

    function esc(s) { var d = document.createElement('div'); d.textContent = String(s); return d.innerHTML; }
    function statRow(label, value) { return '<div class="stat-row"><span class="stat-label">' + label + '</span><span class="stat-value">' + esc(String(value)) + '</span></div>'; }
    function flowStep(num, label, note) {
        return '<div class="flow-step">'
            + '<div class="flow-step-num">' + esc(num) + '</div>'
            + '<div class="flow-step-label">' + esc(label) + '</div>'
            + '<div class="flow-step-note">' + esc(note) + '</div>'
            + '</div>';
    }
    function traceStatusLabel(status) {
        var s = String(status || 'unknown');
        if (s === 'rate_limited') return 'Rate limited';
        if (s === 'skipped_invalid') return 'Skipped invalid';
        if (s.length === 0) return 'Unknown';
        return s.charAt(0).toUpperCase() + s.slice(1).replace(/_/g, ' ');
    }
    function traceStatusPill(status) {
        var s = String(status || 'unknown');
        return '<span class="trace-status-pill ' + escAttr(s) + '">' + esc(traceStatusLabel(s)) + '</span>';
    }
    function buildTriggerTraceUrl(filters) {
        var params = [];
        Object.keys(filters || {}).forEach(function(key) {
            var value = String((filters || {})[key] || '').trim();
            if (!value) return;
            params.push(encodeURIComponent(key) + '=' + encodeURIComponent(value));
        });
        var suffix = params.length ? ('?' + params.join('&')) : '';
        return BASE + '/admin/kernel/triggers' + suffix;
    }
    function bindCacheClearAction(base) {
        var btn = document.getElementById('clear-platform-cache-btn');
        var msg = document.getElementById('clear-platform-cache-msg');
        if (!btn || !msg) {
            return;
        }

        btn.addEventListener('click', function() {
            if (!window.confirm('Clear kernel cache now? This will remove cached entries and refresh diagnostics.')) {
                return;
            }

            btn.disabled = true;
            msg.textContent = 'Clearing...';

            fetch(base + '/api/v1/admin/cache/clear', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ _token: '{csrf_token}' })
            })
            .then(function(r) { return r.json(); })
            .then(function(payload) {
                if (!payload || !payload.ok) {
                    msg.textContent = (payload && payload.error) ? payload.error : 'Cache clear failed';
                    btn.disabled = false;
                    return;
                }

                msg.textContent = 'Cleared ' + String(payload.cleared || 0) + ' cache files.';
                window.setTimeout(function() {
                    window.location.reload();
                }, 500);
            })
            .catch(function() {
                msg.textContent = 'Network error while clearing cache';
                btn.disabled = false;
            });
        });
    }
    function bindUpdateCheckAction(base) {
        var btn = document.getElementById('check-updates-btn');
        var msg = document.getElementById('check-updates-msg');
        if (!btn || !msg) {
            return;
        }

        btn.addEventListener('click', function() {
            btn.disabled = true;
            msg.textContent = 'Checking GitHub releases...';

            fetch(base + '/api/v1/admin/updates/check', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ _token: '{csrf_token}' })
            })
            .then(function(r) { return r.json(); })
            .then(function(payload) {
                if (!payload || !payload.ok) {
                    msg.textContent = (payload && payload.error) ? payload.error : 'Update check failed';
                    btn.disabled = false;
                    return;
                }

                msg.textContent = 'Update catalog refreshed.';
                window.setTimeout(function() {
                    window.location.reload();
                }, 500);
            })
            .catch(function() {
                msg.textContent = 'Network error while checking updates';
                btn.disabled = false;
            });
        });
    }
    function actionItem(title, note) {
        return '<div class="action-item">'
            + '<h4>' + esc(title) + '</h4>'
            + '<p>' + esc(note) + '</p>'
            + '</div>';
    }
    function routeModeExplain(mode) {
        var m = String(mode || 'warn');
        if (m === 'block') {
            return 'If two routes overlap, the request is blocked early to prevent unclear behavior.';
        }
        return 'If two routes overlap, the platform logs a warning and continues with safest available match.';
    }
    function skipReasonHint(reason) {
        var key = String(reason || '');
        if (key === 'requires_kernel') return 'Upgrade kernel or reduce module version requirement.';
        if (key === 'invalid_capabilities') return 'Fix module.json capabilities schema and re-run manifest guard.';
        if (key === 'missing_capability_providers') return 'Enable or install modules providing required capabilities.';
        return 'Review module diagnostics and fix dependency or manifest issues.';
    }
    function glossTip(key, fallback) {
        var g = GLOSSARY[key];
        if (!g) return esc(fallback || key);
        return '<span title="' + esc(g.description || '') + '" style="border-bottom:1px dotted var(--text-muted); cursor:help;">' + esc(g.label || fallback || key) + '</span>';
    }
    function escAttr(s) { return esc(s).replace(/"/g, '&quot;'); }
})();
</script>
{/block}
