{extends "layouts/app.disyl"}

{block head}
<style>
    .profile-layout { max-width: 640px; margin: 0 auto; }
    .profile-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 24px; }
    .profile-card + .profile-card { margin-top: 16px; }
    .profile-identity { display: flex; align-items: center; gap: 16px; margin-bottom: 8px; }
    .profile-avatar { width: 56px; height: 56px; border-radius: 50%; background: var(--primary); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 700; flex-shrink: 0; }
    .profile-name { font-size: 16px; font-weight: 700; color: var(--text); }
    .profile-username { font-size: 13px; color: var(--text-muted); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
    .profile-meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border); }
    .profile-meta-item { font-size: 12px; }
    .profile-meta-label { color: var(--text-muted); font-weight: 600; margin-bottom: 2px; }
    .profile-meta-value { color: var(--text); font-weight: 500; }
</style>
{/block}

{block content}
<div class="profile-layout">
    <div class="page-header">
        <div>
            <h2>Profile</h2>
            <div class="page-desc">View your account details and update your name or password.</div>
        </div>
    </div>

    <div class="profile-card">
        <div class="profile-identity">
            <div class="profile-avatar" id="profile-avatar">
                {if user.full_name}{user.full_name | slice:0:1 | upper}{else}{user.name | slice:0:1 | upper}{/if}
            </div>
            <div>
                <div class="profile-name">{if user.full_name}{user.full_name}{else}{user.name}{/if}</div>
                <div class="profile-username">@{user.name}</div>
            </div>
        </div>
        <div class="profile-meta">
            <div class="profile-meta-item">
                <div class="profile-meta-label">Role</div>
                <div class="profile-meta-value"><span class="role-pill {user.role}">{user.role}</span></div>
            </div>
            <div class="profile-meta-item">
                <div class="profile-meta-label">Account Status</div>
                <div class="profile-meta-value"><span class="status-pill active">Active</span></div>
            </div>
        </div>
    </div>

    <div class="profile-card">
        <strong style="font-size:14px; display:block; margin-bottom:14px;">Update Profile</strong>

        <div id="profile-msg" style="display:none;"></div>

        <form id="profile-form" onsubmit="return submitProfile(event)">
            {csrf_field | raw}

            <div class="form-group">
                <label class="form-label" for="full_name">Full Name</label>
                <input class="form-input" type="text" id="full_name" name="full_name" value="{if user.full_name}{user.full_name}{else}{user.name}{/if}" required />
            </div>

            <div class="form-group">
                <label class="form-label" for="password">New Password</label>
                <input class="form-input" type="password" id="password" name="password" placeholder="Leave blank to keep current password" />
                <div class="hint">Leave blank if you don't want to change your password.</div>
            </div>

            <div style="margin-top: 18px; display:flex; gap:10px; align-items:center;">
                <button class="btn btn-primary" type="submit" id="profile-save-btn">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<script>
async function submitProfile(e) {
    e.preventDefault();

    var msg = document.getElementById('profile-msg');
    var btn = document.getElementById('profile-save-btn');
    msg.style.display = 'none';
    msg.className = '';
    msg.textContent = '';

    var fullName = document.getElementById('full_name').value.trim();
    var password = document.getElementById('password').value;
    var csrf = (document.querySelector('input[name="_token"]') || {}).value || '';

    btn.disabled = true;
    btn.textContent = 'Saving…';

    try {
        var res = await fetch('{base_url}/api/v1/admin/profile/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ full_name: fullName, password: password, _token: csrf })
        });
        var data = await res.json().catch(function() { return {}; });

        if (!res.ok || !data.ok) {
            msg.style.display = 'block';
            msg.className = 'alert alert-danger';
            msg.textContent = data.error || 'Failed to update profile';
            btn.disabled = false;
            btn.textContent = 'Save Changes';
            return false;
        }

        msg.style.display = 'block';
        msg.className = 'alert alert-success';
        msg.textContent = 'Profile updated successfully.';
        showToast('Profile updated');

        document.getElementById('password').value = '';
        btn.disabled = false;
        btn.textContent = 'Save Changes';
        setTimeout(function() { window.location.reload(); }, 1200);
        return false;
    } catch (err) {
        msg.style.display = 'block';
        msg.className = 'alert alert-danger';
        msg.textContent = 'Failed to update profile';
        btn.disabled = false;
        btn.textContent = 'Save Changes';
        return false;
    }
}
</script>
{/block}
