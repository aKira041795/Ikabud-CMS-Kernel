{extends "modules/cms/layouts/admin.disyl"}

{block head}
<script>
    var BASE = '{base_url}';
    var CSRF = '{csrf_token}';
    var ENTRY_MODULE_OPTIONS = {entry_module_options_json|raw};
    var TENANT_VIEW_STORAGE_KEY = 'kernel-admin-tenants:view';
    var TENANT_VIEW_STATE = {
// END OF FILE

    function readSavedTenantView() {
        try {
            var saved = window.localStorage ? window.localStorage.getItem(TENANT_VIEW_STORAGE_KEY) : '';
            return saved === 'list' ? 'list' : 'grid';
        } catch (e) {
            return 'grid';
        }
    }

    function writeSavedTenantView(view) {
        try {
            if (window.localStorage) window.localStorage.setItem(TENANT_VIEW_STORAGE_KEY, view);
        } catch (e) {
        }
    }

    function openModal(id) {
        var el = document.getElementById(id);
        if (el) el.style.display = 'flex';
    }

    function moduleLabel(option) {
        if (!option) return '-';
        var name = String(option.name || option.id || '-');
        var id = String(option.id || '');
        return id && name !== id ? (name + ' (' + id + ')') : name;
    }

    function refreshEntryModuleOptions(options) {
        ENTRY_MODULE_OPTIONS = Array.isArray(options) ? options : [];
    }

    function updateTenantViewButtons() {
        var gridBtn = document.getElementById('tenant-view-grid');
        var listBtn = document.getElementById('tenant-view-list');
        if (gridBtn) {
            gridBtn.classList.toggle('bg-blue-600', TENANT_VIEW_STATE.view === 'grid');
            gridBtn.classList.toggle('text-white', TENANT_VIEW_STATE.view === 'grid');
            gridBtn.classList.toggle('shadow-lg', TENANT_VIEW_STATE.view === 'grid');
            gridBtn.classList.toggle('text-gray-400', TENANT_VIEW_STATE.view !== 'grid');
            gridBtn.classList.toggle('bg-transparent', TENANT_VIEW_STATE.view !== 'grid');
        }
        if (listBtn) {
            listBtn.classList.toggle('bg-blue-600', TENANT_VIEW_STATE.view === 'list');
            listBtn.classList.toggle('text-white', TENANT_VIEW_STATE.view === 'list');
            listBtn.classList.toggle('shadow-lg', TENANT_VIEW_STATE.view === 'list');
            listBtn.classList.toggle('text-gray-400', TENANT_VIEW_STATE.view !== 'list');
            listBtn.classList.toggle('bg-transparent', TENANT_VIEW_STATE.view !== 'list');
        }
    }

    function setTenantView(view) {
        TENANT_VIEW_STATE.view = (view === 'list') ? 'list' : 'grid';
        writeSavedTenantView(TENANT_VIEW_STATE.view);
        applyTenantFilters();
    }

    function renderTenantModuleOptions(list) {
        var select = document.getElementById('tenant-module-filter');
        if (!select) return;
        var seen = {};
        var modules = [];
        (Array.isArray(list) ? list : []).forEach(function(tenant) {
            var moduleId = String((tenant && tenant.entry_module_id) || '').trim();
            if (!moduleId || seen[moduleId]) return;
            seen[moduleId] = true;
            modules.push(moduleId);
        });
        modules.sort();

        var html = '<option value="all">All modules</option>';
        modules.forEach(function(moduleId) {
            var selected = TENANT_VIEW_STATE.module === moduleId ? ' selected' : '';
            html += '<option value="' + escapeHtml(moduleId) + '"' + selected + '>' + escapeHtml(moduleId) + '</option>';
        });
        select.innerHTML = html;
        if (TENANT_VIEW_STATE.module !== 'all' && !seen[TENANT_VIEW_STATE.module]) {
            TENANT_VIEW_STATE.module = 'all';
            select.value = 'all';
        }
    }

    function syncTenantFiltersFromUi() {
        var queryEl = document.getElementById('tenant-search');
        var statusEl = document.getElementById('tenant-status-filter');
        var moduleEl = document.getElementById('tenant-module-filter');
        TENANT_VIEW_STATE.query = String((queryEl && queryEl.value) || '').trim().toLowerCase();
        TENANT_VIEW_STATE.status = String((statusEl && statusEl.value) || 'all').trim().toLowerCase() || 'all';
        TENANT_VIEW_STATE.module = String((moduleEl && moduleEl.value) || 'all').trim() || 'all';
    }

    function clearTenantFilters() {
        var queryEl = document.getElementById('tenant-search');
        var statusEl = document.getElementById('tenant-status-filter');
        var moduleEl = document.getElementById('tenant-module-filter');
        if (queryEl) queryEl.value = '';
        if (statusEl) statusEl.value = 'all';
        if (moduleEl) moduleEl.value = 'all';
        TENANT_VIEW_STATE.query = '';
        TENANT_VIEW_STATE.status = 'all';
        TENANT_VIEW_STATE.module = 'all';
        applyTenantFilters();
    }

    function updateTenantResultsMeta(filteredCount, totalCount) {
        var meta = document.getElementById('tenant-results-meta');
        if (!meta) return;
        if (totalCount <= 0) {
            meta.textContent = 'No tenants are currently configured.';
            return;
        }
        if (filteredCount === totalCount) {
            meta.textContent = 'Showing all ' + totalCount + ' tenant' + (totalCount === 1 ? '' : 's') + '.';
            return;
        }
        meta.textContent = 'Showing ' + filteredCount + ' of ' + totalCount + ' tenants.';
    }

    function applyTenantFilters() {
        var grid = document.getElementById('tenants-grid');
        var empty = document.getElementById('tenants-empty');
        var emptyTitle = document.getElementById('tenants-empty-title');
        var emptyCopy = document.getElementById('tenants-empty-copy');
        var loading = document.getElementById('tenants-loading');
        var list = Array.isArray(TENANT_VIEW_STATE.list) ? TENANT_VIEW_STATE.list : [];
        if (!grid) return;
        if (loading) loading.style.display = 'none';

        syncTenantFiltersFromUi();
        updateTenantViewButtons();

        var filtered = list.filter(function(tenant) {
            var status = String((tenant && tenant.status) || 'active').toLowerCase();
            var moduleId = String((tenant && tenant.entry_module_id) || '');
            var searchHaystack = [
                tenant && tenant.tenant_key,
                tenant && tenant.admin_email,
                moduleId,
                Array.isArray(tenant && tenant.domains) ? tenant.domains.join(' ') : ''
            ].join(' ').toLowerCase();

            if (TENANT_VIEW_STATE.status !== 'all' && status !== TENANT_VIEW_STATE.status) return false;
            if (TENANT_VIEW_STATE.module !== 'all' && moduleId !== TENANT_VIEW_STATE.module) return false;
            if (TENANT_VIEW_STATE.query && searchHaystack.indexOf(TENANT_VIEW_STATE.query) === -1) return false;
            return true;
        });

        grid.className = 'grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4' + (TENANT_VIEW_STATE.view === 'list' ? ' !grid-cols-1' : '');
        updateTenantResultsMeta(filtered.length, list.length);

        if (list.length === 0) {
            grid.innerHTML = '';
            if (emptyTitle) emptyTitle.textContent = 'No tenants found';
            if (emptyCopy) emptyCopy.textContent = 'Create your first tenant to begin.';
            if (empty) empty.style.display = 'block';
            return;
        }

        if (filtered.length === 0) {
            grid.innerHTML = '';
            if (emptyTitle) emptyTitle.textContent = 'No tenants match the current filters';
            if (emptyCopy) emptyCopy.textContent = 'Clear or adjust the search, status, or module filters.';
            if (empty) empty.style.display = 'block';
            return;
        }

        if (empty) empty.style.display = 'none';

        var html = '';
        filtered.forEach(function(t) {
            var status = String(t.status || 'active');
            var pillCls = (status === 'active') ? 'active' : 'suspended';
            var domains = Array.isArray(t.domains) ? t.domains : [];
            var db = (t && t.db) ? t.db : null;
            var dbSummary = (db && (db.db_host || db.db_name || db.db_user))
                ? ('host=' + escapeHtml(db.db_host || '-') + ', db=' + escapeHtml(db.db_name || '-') + ', user=' + escapeHtml(db.db_user || '-'))
                : '-';
            var dbBtn = t.db_configured ? 'Edit DB' : 'Add DB';
            var statusBtnLabel = (status === 'active') ? 'Disable' : 'Enable';
            var statusBtnCls = (status === 'active') ? '' : 'primary';
            var entryDisplay = escapeHtml(t.entry_module_id || '-');
            var adminEmailDisplay = t.admin_email ? escapeHtml(t.admin_email) : '';
            var domHtml = '';
            domains.forEach(function(d) {
                domHtml += '<span class="inline-flex items-center gap-2 px-2.5 py-1.5 rounded border border-gray-200 bg-gray-50 text-xs"><code class="font-mono text-xs">' + escapeHtml(d) + '</code>'
                    + '<button title="Remove" class="border-none bg-transparent cursor-pointer text-red-600 font-bold" onclick="removeDomain(' + (t.id||0) + ',\'' + escapeHtml(d) + '\')">×</button>'
                    + '</span>';
            });

            html += ''
                + '<div class="grid grid-cols-1 gap-3.5 bg-white border border-gray-200/20 rounded-lg p-4 shadow-sm hover:shadow-md hover:-translate-y-px transition-all duration-150' + (TENANT_VIEW_STATE.view === 'list' ? ' md:grid-cols-[1.2fr_0.8fr] md:items-start' : '') + '">'
                + '  <div class="min-w-0">'
                + '    <div class="flex items-start justify-between gap-2.5 mb-2.5">'
                + '      <div>'
                + '        <div class="font-extrabold text-xl tracking-tight">' + escapeHtml(t.tenant_key || '') + '</div>'
                + '        <div class="font-mono text-xs text-gray-400 mt-0.5">tenant_id=' + escapeHtml(t.id) + '</div>'
                + '      </div>'
                + '      <span class="status-pill ' + pillCls + '">' + escapeHtml(status) + '</span>'
                + '    </div>'
                +      (adminEmailDisplay
                            ? '    <div class="text-xs text-gray-400">Admin email: <code class="text-xs">' + adminEmailDisplay + '</code></div>'
                            : '    <div class="text-xs text-gray-400">No admin email set yet.</div>')
                + '    <div class="text-xs font-bold uppercase tracking-wider text-gray-400 mt-3">Domains</div>'
                + '    <div class="flex flex-wrap gap-1.5 mt-2.5">' + (domHtml || '<span class="text-xs text-gray-400 mt-1.5">No domains</span>') + '</div>'
                + '  </div>'
                + '  <div class="min-w-0">'
                + '    <div class="bg-blue-50/40 border border-blue-200/20 rounded-lg p-3.5 grid gap-2.5">'
                + '      <div class="grid gap-0.5">'
                + '        <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Entry module</span>'
                + '        <span class="text-sm text-gray-900 break-words"><code class="text-sm">' + entryDisplay + '</code></span>'
                + '      </div>'
                + '      <div class="grid gap-0.5">'
                + '        <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Database</span>'
                + '        <span class="text-sm text-gray-900 break-words">' + (t.db_configured ? 'Configured' : 'Missing') + '</span>'
                + '      </div>'
                + '      <div class="grid gap-0.5">'
                + '        <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Connection</span>'
                + '        <span class="text-sm text-gray-900 break-words"><code class="text-sm">' + dbSummary + '</code></span>'
                + '      </div>'
                + '    </div>'
                + '  </div>'
                + '  <div class="flex gap-2 flex-wrap col-span-1 md:col-span-2 mt-0.5">'
                + '    <button class="btn btn-outline btn-sm" onclick="openAddDomain(' + (t.id||0) + ')">Add domain</button>'
                + '    <button class="btn btn-primary btn-sm" onclick="openDbConn(' + (t.id||0) + ')">' + dbBtn + '</button>'
                + '    <button class="btn btn-outline btn-sm" onclick="openEntryModule(' + (t.id||0) + ')">Edit entry</button>'
                + '    <button class="btn btn-outline btn-sm" onclick="openAdminEmail(' + (t.id||0) + ')">Admin email</button>'
                + '    <button class="btn btn-outline btn-sm" onclick="openAdminPassword(' + (t.id||0) + ')">Password</button>'
                + (t.entry_module_id === 'bakeshop' && t.db_configured
                    ? '    <button class="btn btn-outline btn-sm" onclick="runTenantSeed(' + (t.id||0) + ',\'bakeshop_julies_bread_pastry\',\'Julie\\\'s seed\')">Run Julie\'s seed</button>'
                    : '')
                + '    <button class="btn btn-sm ' + (statusBtnCls ? 'btn-primary' : 'btn-outline') + '" onclick="toggleTenantStatus(' + (t.id||0) + ',\'' + escapeHtml(status) + '\')">' + statusBtnLabel + '</button>'
                + '    <button class="btn btn-outline btn-sm text-red-600 border-red-600" onclick="deleteTenant(' + (t.id||0) + ',\'' + escapeHtml(t.tenant_key || '') + '\')">Delete</button>'
                + '  </div>'
                + '</div>';
        });

        grid.innerHTML = html;
    }

    function renderEntryModuleOptions(selectedId) {
        var select = document.getElementById('entry-module-select');
        if (!select) return;
        var html = '<option value="">No entry module</option>';
        ENTRY_MODULE_OPTIONS.forEach(function(option) {
            var id = String(option.id || '');
            if (!id) return;
            var selected = (String(selectedId || '') === id) ? ' selected' : '';
            var disabled = (option.loadable === false) ? ' disabled' : '';
            var suffix = [];
            if (option.enabled === false) suffix.push('disabled');
            if (option.loadable === false) suffix.push('not loadable');
            html += '<option value="' + escapeHtml(id) + '"' + selected + disabled + '>'
                + escapeHtml(moduleLabel(option) + (suffix.length ? ' [' + suffix.join(', ') + ']' : ''))
                + '</option>';
        });
        select.innerHTML = html;
    }

    function toggleTenantStatus(tenantId, currentStatus) {
        var tid = parseInt(tenantId || 0, 10);
        if (tid <= 0) return;
        currentStatus = String(currentStatus || 'active');
        var next = (currentStatus === 'active') ? 'suspended' : 'active';
        var verb = (next === 'suspended') ? 'disable' : 'enable';
        if (!window.confirm('Confirm ' + verb + ' tenant #' + tid + '?')) return;
        fetch(BASE + '/api/v1/admin/tenants/status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: tid, status: next, _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Tenant status updated', type: 'success' } }));
                reloadTenants();
            } else {
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: res.error || 'Update failed', type: 'error' } }));
            }
        })
        .catch(function(){ window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Network error', type: 'error' } })); });
    }
    function closeModal(id) {
        var el = document.getElementById(id);
        if (el) el.style.display = 'none';
    }
    function onBackdrop(ev, id) {
        if (ev.target && ev.target.id === id) closeModal(id);
    }

    function openCreateTenant() {
        document.getElementById('ct-key').value = '';
        document.getElementById('ct-domain').value = '';
        document.getElementById('ct-admin-email').value = '';
        renderCreateEntryModuleOptions('');
        openModal('modal-create');
    }

    function renderCreateEntryModuleOptions(selectedId) {
        var select = document.getElementById('ct-entry');
        if (!select) return;
        var html = '<option value="">No entry module</option>';
        ENTRY_MODULE_OPTIONS.forEach(function(option) {
            var id = String(option.id || '');
            if (!id) return;
            var selected = (String(selectedId || '') === id) ? ' selected' : '';
            var disabled = (option.loadable === false) ? ' disabled' : '';
            var suffix = [];
            if (option.enabled === false) suffix.push('disabled');
            if (option.loadable === false) suffix.push('not loadable');
            html += '<option value="' + escapeHtml(id) + '"' + selected + disabled + '>'
                + escapeHtml(moduleLabel(option) + (suffix.length ? ' [' + suffix.join(', ') + ']' : ''))
                + '</option>';
        });
        select.innerHTML = html;
    }

    function openEntryModule(tenantId) {
        var tenant = (window.__tenantsById && window.__tenantsById[String(tenantId || '')]) ? window.__tenantsById[String(tenantId || '')] : null;
        document.getElementById('entry-tenant-id').value = String(tenantId || '');
        renderEntryModuleOptions(tenant && tenant.entry_module_id ? String(tenant.entry_module_id) : '');
        openModal('modal-entry-module');
    }

    function openAddDomain(tenantId) {
        document.getElementById('dom-tenant-id').value = String(tenantId || '');
        document.getElementById('dom-domain').value = '';
        openModal('modal-domain');
    }

    function openDbConn(tenantId) {
        document.getElementById('db-tenant-id').value = String(tenantId || '');
        var t = (window.__tenantsById && window.__tenantsById[String(tenantId || '')]) ? window.__tenantsById[String(tenantId || '')] : null;
        var db = t && t.db ? t.db : null;
        document.getElementById('db-host').value = db && db.db_host ? String(db.db_host) : '';
        document.getElementById('db-port').value = '3306';
        document.getElementById('db-name').value = db && db.db_name ? String(db.db_name) : '';
        document.getElementById('db-user').value = db && db.db_user ? String(db.db_user) : '';
        document.getElementById('db-pass').value = '';
        openModal('modal-db');
    }

    function escapeHtml(s) {
        return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function renderTenants(list) {
        list = Array.isArray(list) ? list : [];

        window.__tenantsById = {};
        list.forEach(function(t) {
            if (t && t.id != null) window.__tenantsById[String(t.id)] = t;
        });

        TENANT_VIEW_STATE.list = list;
        renderTenantModuleOptions(list);
        applyTenantFilters();
    }

    function openAdminEmail(tenantId) {
        var t = (window.__tenantsById && window.__tenantsById[String(tenantId || '')]) ? window.__tenantsById[String(tenantId || '')] : null;
        document.getElementById('ae-tenant-id').value = String(tenantId || '');
        document.getElementById('ae-email').value = (t && t.admin_email) ? String(t.admin_email) : '';
        openModal('modal-admin-email');
    }

    function saveAdminEmail() {
        var tenantId = parseInt(document.getElementById('ae-tenant-id').value || '0', 10);
        var email = document.getElementById('ae-email').value.trim();
        fetch(BASE + '/api/v1/admin/tenants/admin-email', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: tenantId, admin_email: email, _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                closeModal('modal-admin-email');
                var pushed = Array.isArray(res.pushed) && res.pushed.length > 0 ? ' Pushed to: ' + res.pushed.join(', ') + '.' : '';
                var skipped = Array.isArray(res.skipped) && res.skipped.length > 0 ? ' Skipped: ' + res.skipped.join(', ') + '.' : '';
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Admin email saved.' + pushed + skipped, type: 'success' } }));
                reloadTenants();
            } else {
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: res.error || 'Save failed', type: 'error' } }));
            }
        })
        .catch(function(){ window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Network error', type: 'error' } })); });
    }

    function openAdminPassword(tenantId) {
        document.getElementById('ap-tenant-id').value = String(tenantId || '');
        document.getElementById('ap-password').value = '';
        openModal('modal-admin-password');
    }

    function runTenantSeed(tenantId, seedId, label) {
        var tid = parseInt(tenantId || 0, 10);
        if (tid <= 0) return;
        var seedLabel = String(label || 'seed data');
        if (!window.confirm('Run ' + seedLabel + ' for tenant #' + tid + '? This applies data to the tenant\'s own database.')) return;

        fetch(BASE + '/api/v1/admin/tenants/seed-data', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: tid, seed_id: String(seedId || ''), _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                var counts = res && res.counts ? res.counts : null;
                var summary = counts
                    ? ' branches=' + String(counts.branches || 0)
                        + ', products=' + String(counts.products || 0)
                        + ', ingredients=' + String(counts.ingredients || 0)
                    : '';
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Seed completed.' + summary, type: 'success' } }));
                reloadTenants();
            } else {
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: res.error || 'Seed failed', type: 'error' } }));
            }
        })
        .catch(function(){ window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Network error', type: 'error' } })); });
    }

    function saveAdminPassword() {
        var tenantId = parseInt(document.getElementById('ap-tenant-id').value || '0', 10);
        var password = document.getElementById('ap-password').value;
        fetch(BASE + '/api/v1/admin/tenants/admin-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: tenantId, admin_password: password, _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                closeModal('modal-admin-password');
                var pushed = Array.isArray(res.pushed) && res.pushed.length > 0 ? ' Pushed to: ' + res.pushed.join(', ') + '.' : '';
                var skipped = Array.isArray(res.skipped) && res.skipped.length > 0 ? ' Skipped: ' + res.skipped.join(', ') + '.' : '';
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Admin password saved.' + pushed + skipped, type: 'success' } }));
            } else {
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: res.error || 'Save failed', type: 'error' } }));
            }
        })
        .catch(function(){ window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Network error', type: 'error' } })); });
    }

    function reloadTenants() {
        fetch(BASE + '/api/v1/admin/tenants', { headers: { 'Accept': 'application/json' } })
            .then(function(r){ return r.json(); })
            .then(function(res){
                if (!res.ok) {
                    window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: res.error || 'Failed to load tenants', type: 'error' } }));
                    return;
                }
                refreshEntryModuleOptions(res.entry_module_options || []);
                renderTenants(res.tenants || []);
            })
            .catch(function(){ window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Network error', type: 'error' } })); });
    }

    function createTenant() {
        var key = document.getElementById('ct-key').value.trim();
        var domain = document.getElementById('ct-domain').value.trim().toLowerCase();
        var adminEmail = document.getElementById('ct-admin-email').value.trim();
        var entry = document.getElementById('ct-entry').value;
        fetch(BASE + '/api/v1/admin/tenants/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_key: key, domain: domain, admin_email: adminEmail, entry_module_id: entry, _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                closeModal('modal-create');
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Tenant created', type: 'success' } }));
                reloadTenants();
            } else {
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: res.error || 'Create failed', type: 'error' } }));
            }
        })
        .catch(function(){ window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Network error', type: 'error' } })); });
    }

    function saveEntryModule() {
        var tenantId = parseInt(document.getElementById('entry-tenant-id').value || '0', 10);
        var entryModuleId = document.getElementById('entry-module-select').value;

        fetch(BASE + '/api/v1/admin/tenants/entry-module', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: tenantId, entry_module_id: entryModuleId, _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                closeModal('modal-entry-module');
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Entry module saved', type: 'success' } }));
                reloadTenants();
            } else {
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: res.error || 'Save failed', type: 'error' } }));
            }
        })
        .catch(function(){ window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Network error', type: 'error' } })); });
    }

    function addDomain() {
        var tenantId = parseInt(document.getElementById('dom-tenant-id').value || '0', 10);
        var domain = document.getElementById('dom-domain').value.trim().toLowerCase();
        fetch(BASE + '/api/v1/admin/tenants/domain/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: tenantId, domain: domain, _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                closeModal('modal-domain');
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Domain added', type: 'success' } }));
                reloadTenants();
            } else {
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: res.error || 'Add failed', type: 'error' } }));
            }
        })
        .catch(function(){ window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Network error', type: 'error' } })); });
    }

    function removeDomain(tenantId, domain) {
        if (!window.confirm('Remove domain ' + domain + '?')) return;
        fetch(BASE + '/api/v1/admin/tenants/domain/remove', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: parseInt(tenantId||0,10), domain: String(domain||''), _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Domain removed', type: 'success' } }));
                reloadTenants();
            } else {
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: res.error || 'Remove failed', type: 'error' } }));
            }
        })
        .catch(function(){ window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Network error', type: 'error' } })); });
    }

    function saveDbConn() {
        var tenantId = parseInt(document.getElementById('db-tenant-id').value || '0', 10);
        var host = document.getElementById('db-host').value.trim();
        var port = document.getElementById('db-port').value.trim() || '3306';
        var name = document.getElementById('db-name').value.trim();
        var user = document.getElementById('db-user').value.trim();
        var pass = document.getElementById('db-pass').value;

        fetch(BASE + '/api/v1/admin/tenants/db/upsert', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: tenantId, db_host: host, db_port: port, db_name: name, db_user: user, db_pass: pass, _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                closeModal('modal-db');
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'DB saved', type: 'success' } }));
                reloadTenants();
            } else {
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: res.error || 'Save failed', type: 'error' } }));
            }
        })
        .catch(function(){ window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Network error', type: 'error' } })); });
    }

    function deleteTenant(tenantId, tenantKey) {
        var tid = parseInt(tenantId || 0, 10);
        if (tid <= 0) return;
        if (!window.confirm('Permanently delete tenant "' + String(tenantKey || tid) + '" and all its data (domains, DB config, entitlements)? This cannot be undone.')) return;
        fetch(BASE + '/api/v1/admin/tenants/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: tid, _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Tenant deleted', type: 'success' } }));
                reloadTenants();
            } else {
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: res.error || 'Delete failed', type: 'error' } }));
            }
        })
        .catch(function(){ window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Network error', type: 'error' } })); });
    }

    reloadTenants();
</script>
{/block}

{block content}
<div class="page-header">
    <div>
        <h2>Tenants</h2>
        <div class="page-desc">Manage multi-tenant deployments. Domain routing maps HTTP hosts to tenants, and DB credentials are stored encrypted-at-rest.</div>
    </div>
    <div class="page-actions">
        <button class="btn btn-outline btn-sm" onclick="reloadTenants()">Reload</button>
        <button class="btn btn-primary btn-sm" onclick="openCreateTenant()">+ Create Tenant</button>
    </div>
</div>

<div class="grid gap-4">
    <div class="bg-white rounded-lg border border-gray-200 p-4 grid gap-3">
        <div class="grid grid-cols-1 md:grid-cols-[minmax(280px,1.5fr)_minmax(150px,.55fr)_minmax(180px,.7fr)_auto] gap-3 items-end">
            <div>
                <label class="block text-xs font-semibold text-gray-500 mb-1" for="tenant-search">Search</label>
                <input class="w-full px-3 py-2 text-sm border border-gray-200 rounded bg-white text-gray-900" id="tenant-search" type="text" placeholder="Search tenants, domains, emails, modules..." oninput="applyTenantFilters()" autocomplete="off">
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-500 mb-1" for="tenant-status-filter">Status</label>
                <select class="w-full px-3 py-2 text-sm border border-gray-200 rounded bg-white text-gray-900" id="tenant-status-filter" onchange="applyTenantFilters()">
                    <option value="all">All</option>
                    <option value="active">Active</option>
                    <option value="suspended">Suspended</option>
                </select>
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-500 mb-1" for="tenant-module-filter">Module</label>
                <select class="w-full px-3 py-2 text-sm border border-gray-200 rounded bg-white text-gray-900" id="tenant-module-filter" onchange="applyTenantFilters()">
                    <option value="all">All modules</option>
                </select>
            </div>
            <div class="flex flex-col gap-1 items-end">
                <label class="block text-xs font-semibold text-gray-500 mb-1">View</label>
                <div class="inline-flex items-center gap-1 p-1 bg-white/84 border border-gray-200/20 rounded" role="group" aria-label="Tenant view mode">
                    <button type="button" id="tenant-view-grid" class="border-none bg-transparent text-gray-400 px-3 py-2 rounded text-xs font-bold cursor-pointer" onclick="setTenantView('grid')">Grid</button>
                    <button type="button" id="tenant-view-list" class="border-none bg-transparent text-gray-400 px-3 py-2 rounded text-xs font-bold cursor-pointer" onclick="setTenantView('list')">List</button>
                </div>
            </div>
        </div>
        <div class="flex items-center justify-between gap-2.5 flex-wrap">
            <div id="tenant-results-meta" class="text-xs text-gray-400">Loading tenants…</div>
            <button class="btn btn-outline btn-sm" type="button" onclick="clearTenantFilters()">Clear filters</button>
        </div>
    </div>

    <div id="tenants-loading" class="text-center py-8 text-sm text-gray-400">Loading tenants…</div>

    <div id="tenants-empty" class="text-center py-16" style="display:none;">
        <h3 id="tenants-empty-title" class="text-base font-semibold text-gray-700">No tenants found</h3>
        <p id="tenants-empty-copy" class="text-sm text-gray-400 mt-2">Create your first tenant to begin.</p>
    </div>

    <div id="tenants-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4"></div>
</div>

<!-- Create tenant modal -->
<div class="modal-overlay" id="modal-create" onclick="onBackdrop(event, 'modal-create')">
    <div class="modal" onclick="event.stopPropagation()">
        <h3>Create Tenant</h3>
        <div class="form-group">
            <label class="form-label">Tenant Key</label>
            <input class="form-input" id="ct-key" placeholder="client-001" autocomplete="off">
            <div class="hint">Stable identifier (no spaces). Used for ops, not customer-facing.</div>
        </div>
        <div class="form-group">
            <label class="form-label">Primary Domain</label>
            <input class="form-input" id="ct-domain" placeholder="client-domain.tld" autocomplete="off">
            <div class="hint">Used for host-based tenant resolution.</div>
        </div>
        <div class="form-group">
            <label class="form-label">Admin Email (optional)</label>
            <input class="form-input" id="ct-admin-email" placeholder="admin@example.com" type="email" autocomplete="off">
            <div class="hint">Stored for password reset on first run. Not required at creation.</div>
        </div>
        <div class="form-group">
            <label class="form-label">Entry Module ID (optional)</label>
            <select class="form-input" id="ct-entry"></select>
            <div class="hint">Use a known module ID to avoid tenant root routing failures.</div>
        </div>
        <div class="modal-actions">
            <button class="btn btn-outline" onclick="closeModal('modal-create')">Cancel</button>
            <button class="btn btn-primary" onclick="createTenant()">Create</button>
        </div>
    </div>
</div>

<!-- Entry module modal -->
<div class="modal-overlay" id="modal-entry-module" onclick="onBackdrop(event, 'modal-entry-module')">
    <div class="modal" onclick="event.stopPropagation()">
        <h3>Edit Entry Module</h3>
        <input type="hidden" id="entry-tenant-id">
        <div class="form-group">
            <label class="form-label">Entry Module</label>
            <select class="form-input" id="entry-module-select"></select>
            <div class="hint">Choose the module that should receive tenant root traffic. Leave blank to disable entry-module routing for this tenant.</div>
        </div>
        <div class="modal-actions">
            <button class="btn btn-outline" onclick="closeModal('modal-entry-module')">Cancel</button>
            <button class="btn btn-primary" onclick="saveEntryModule()">Save</button>
        </div>
    </div>
</div>

<!-- Add domain modal -->
<div class="modal-overlay" id="modal-domain" onclick="onBackdrop(event, 'modal-domain')">
    <div class="modal" onclick="event.stopPropagation()">
        <h3>Add Domain</h3>
        <input type="hidden" id="dom-tenant-id">
        <div class="form-group">
            <label class="form-label">Domain</label>
            <input class="form-input" id="dom-domain" placeholder="guidance.client-domain.tld" autocomplete="off">
        </div>
        <div class="modal-actions">
            <button class="btn btn-outline" onclick="closeModal('modal-domain')">Cancel</button>
            <button class="btn btn-primary" onclick="addDomain()">Add</button>
        </div>
    </div>
</div>

<!-- DB connection modal -->
<div class="modal-overlay" id="modal-db" onclick="onBackdrop(event, 'modal-db')">
    <div class="modal" onclick="event.stopPropagation()">
        <h3>Tenant Database Connection</h3>
        <input type="hidden" id="db-tenant-id">
        <div class="grid-2">
            <div class="form-group">
                <label class="form-label">Host</label>
                <input class="form-input" id="db-host" placeholder="127.0.0.1" autocomplete="off">
            </div>
            <div class="form-group">
                <label class="form-label">Port</label>
                <input class="form-input" id="db-port" placeholder="3306" autocomplete="off">
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">Database</label>
            <input class="form-input" id="db-name" placeholder="tenant_db_001" autocomplete="off">
        </div>
        <div class="grid-2">
            <div class="form-group">
                <label class="form-label">Username</label>
                <input class="form-input" id="db-user" placeholder="dbuser" autocomplete="off">
            </div>
            <div class="form-group">
                <label class="form-label">Password</label>
                <input class="form-input" id="db-pass" type="password" placeholder="(will be encrypted)" autocomplete="new-password">
            </div>
        </div>
        <div class="hint">Password is stored encrypted-at-rest in the control DB. Leave blank to keep existing password.</div>
        <div class="modal-actions">
            <button class="btn btn-outline" onclick="closeModal('modal-db')">Cancel</button>
            <button class="btn btn-primary" onclick="saveDbConn()">Save</button>
        </div>
    </div>
</div>

<!-- Admin email modal -->
<div class="modal-overlay" id="modal-admin-email" onclick="onBackdrop(event, 'modal-admin-email')">
    <div class="modal" onclick="event.stopPropagation()">
        <h3>Set Admin Email</h3>
        <input type="hidden" id="ae-tenant-id">
        <div class="form-group">
            <label class="form-label">Admin Email</label>
            <input class="form-input" id="ae-email" type="email" placeholder="admin@example.com" autocomplete="off">
            <div class="hint">Saves here and pushes directly into the tenant's <code>cms_users</code> / <code>gm_users</code> admin row — so forgot-password works immediately without touching phpMyAdmin.</div>
        </div>
        <div class="modal-actions">
            <button class="btn btn-outline" onclick="closeModal('modal-admin-email')">Cancel</button>
            <button class="btn btn-primary" onclick="saveAdminEmail()">Save &amp; Push</button>
        </div>
    </div>
</div>

<!-- Admin password modal -->
<div class="modal-overlay" id="modal-admin-password" onclick="onBackdrop(event, 'modal-admin-password')">
    <div class="modal" onclick="event.stopPropagation()">
        <h3>Set Admin Password</h3>
        <input type="hidden" id="ap-tenant-id">
        <div class="form-group">
            <label class="form-label">New Password</label>
            <input class="form-input" id="ap-password" type="password" placeholder="Min 6 chars" autocomplete="new-password">
            <div class="hint">Pushes directly into the tenant's <code>cms_users</code>, <code>gm_users</code>, and <code>users</code> admin row so you can regain admin access immediately.</div>
        </div>
        <div class="modal-actions">
            <button class="btn btn-outline" onclick="closeModal('modal-admin-password')">Cancel</button>
            <button class="btn btn-primary" onclick="saveAdminPassword()">Save &amp; Push</button>
        </div>
    </div>
</div>
{/block}
        module: 'all',
        view: readSavedTenantView()
    };

    function readSavedTenantView() {
        try {
            var saved = window.localStorage ? window.localStorage.getItem(TENANT_VIEW_STORAGE_KEY) : '';
            return saved === 'list' ? 'list' : 'grid';
        } catch (e) {
            return 'grid';
        }
    }

    function writeSavedTenantView(view) {
        try {
            if (window.localStorage) window.localStorage.setItem(TENANT_VIEW_STORAGE_KEY, view);
        } catch (e) {
        }
    }

    function openModal(id) {
        var el = document.getElementById(id);
        if (el) el.style.display = 'flex';
    }

    function moduleLabel(option) {
        if (!option) return '-';
        var name = String(option.name || option.id || '-');
        var id = String(option.id || '');
        return id && name !== id ? (name + ' (' + id + ')') : name;
    }

    function refreshEntryModuleOptions(options) {
        ENTRY_MODULE_OPTIONS = Array.isArray(options) ? options : [];
    }

    function updateTenantViewButtons() {
        var gridBtn = document.getElementById('tenant-view-grid');
        var listBtn = document.getElementById('tenant-view-list');
        if (gridBtn) {
            gridBtn.classList.toggle('bg-blue-600', TENANT_VIEW_STATE.view === 'grid');
            gridBtn.classList.toggle('text-white', TENANT_VIEW_STATE.view === 'grid');
            gridBtn.classList.toggle('shadow-lg', TENANT_VIEW_STATE.view === 'grid');
            gridBtn.classList.toggle('text-gray-400', TENANT_VIEW_STATE.view !== 'grid');
            gridBtn.classList.toggle('bg-transparent', TENANT_VIEW_STATE.view !== 'grid');
        }
        if (listBtn) {
            listBtn.classList.toggle('bg-blue-600', TENANT_VIEW_STATE.view === 'list');
            listBtn.classList.toggle('text-white', TENANT_VIEW_STATE.view === 'list');
            listBtn.classList.toggle('shadow-lg', TENANT_VIEW_STATE.view === 'list');
            listBtn.classList.toggle('text-gray-400', TENANT_VIEW_STATE.view !== 'list');
            listBtn.classList.toggle('bg-transparent', TENANT_VIEW_STATE.view !== 'list');
        }
    }

    function setTenantView(view) {
        TENANT_VIEW_STATE.view = (view === 'list') ? 'list' : 'grid';
        writeSavedTenantView(TENANT_VIEW_STATE.view);
        applyTenantFilters();
    }

    function renderTenantModuleOptions(list) {
        var select = document.getElementById('tenant-module-filter');
        if (!select) return;
        var seen = {};
        var modules = [];
        (Array.isArray(list) ? list : []).forEach(function(tenant) {
            var moduleId = String((tenant && tenant.entry_module_id) || '').trim();
            if (!moduleId || seen[moduleId]) return;
            seen[moduleId] = true;
            modules.push(moduleId);
        });
        modules.sort();

        var html = '<option value="all">All modules</option>';
        modules.forEach(function(moduleId) {
            var selected = TENANT_VIEW_STATE.module === moduleId ? ' selected' : '';
            html += '<option value="' + escapeHtml(moduleId) + '"' + selected + '>' + escapeHtml(moduleId) + '</option>';
        });
        select.innerHTML = html;
        if (TENANT_VIEW_STATE.module !== 'all' && !seen[TENANT_VIEW_STATE.module]) {
            TENANT_VIEW_STATE.module = 'all';
            select.value = 'all';
        }
    }

    function syncTenantFiltersFromUi() {
        var queryEl = document.getElementById('tenant-search');
        var statusEl = document.getElementById('tenant-status-filter');
        var moduleEl = document.getElementById('tenant-module-filter');
        TENANT_VIEW_STATE.query = String((queryEl && queryEl.value) || '').trim().toLowerCase();
        TENANT_VIEW_STATE.status = String((statusEl && statusEl.value) || 'all').trim().toLowerCase() || 'all';
        TENANT_VIEW_STATE.module = String((moduleEl && moduleEl.value) || 'all').trim() || 'all';
    }

    function clearTenantFilters() {
        var queryEl = document.getElementById('tenant-search');
        var statusEl = document.getElementById('tenant-status-filter');
        var moduleEl = document.getElementById('tenant-module-filter');
        if (queryEl) queryEl.value = '';
        if (statusEl) statusEl.value = 'all';
        if (moduleEl) moduleEl.value = 'all';
        TENANT_VIEW_STATE.query = '';
        TENANT_VIEW_STATE.status = 'all';
        TENANT_VIEW_STATE.module = 'all';
        applyTenantFilters();
    }

    function updateTenantResultsMeta(filteredCount, totalCount) {
        var meta = document.getElementById('tenant-results-meta');
        if (!meta) return;
        if (totalCount <= 0) {
            meta.textContent = 'No tenants are currently configured.';
            return;
        }
        if (filteredCount === totalCount) {
            meta.textContent = 'Showing all ' + totalCount + ' tenant' + (totalCount === 1 ? '' : 's') + '.';
            return;
        }
        meta.textContent = 'Showing ' + filteredCount + ' of ' + totalCount + ' tenants.';
    }

    function applyTenantFilters() {
        var grid = document.getElementById('tenants-grid');
        var empty = document.getElementById('tenants-empty');
        var emptyTitle = document.getElementById('tenants-empty-title');
        var emptyCopy = document.getElementById('tenants-empty-copy');
        var loading = document.getElementById('tenants-loading');
        var list = Array.isArray(TENANT_VIEW_STATE.list) ? TENANT_VIEW_STATE.list : [];
        if (!grid) return;
        if (loading) loading.style.display = 'none';

        syncTenantFiltersFromUi();
        updateTenantViewButtons();

        var filtered = list.filter(function(tenant) {
            var status = String((tenant && tenant.status) || 'active').toLowerCase();
            var moduleId = String((tenant && tenant.entry_module_id) || '');
            var searchHaystack = [
                tenant && tenant.tenant_key,
                tenant && tenant.admin_email,
                moduleId,
                Array.isArray(tenant && tenant.domains) ? tenant.domains.join(' ') : ''
            ].join(' ').toLowerCase();

            if (TENANT_VIEW_STATE.status !== 'all' && status !== TENANT_VIEW_STATE.status) return false;
            if (TENANT_VIEW_STATE.module !== 'all' && moduleId !== TENANT_VIEW_STATE.module) return false;
            if (TENANT_VIEW_STATE.query && searchHaystack.indexOf(TENANT_VIEW_STATE.query) === -1) return false;
            return true;
        });

        grid.className = 'tenant-grid' + (TENANT_VIEW_STATE.view === 'list' ? ' list-view' : '');
        updateTenantResultsMeta(filtered.length, list.length);

        if (list.length === 0) {
            grid.innerHTML = '';
            if (emptyTitle) emptyTitle.textContent = 'No tenants found';
            if (emptyCopy) emptyCopy.textContent = 'Create your first tenant to begin.';
            if (empty) empty.style.display = 'block';
            return;
        }

        if (filtered.length === 0) {
            grid.innerHTML = '';
            if (emptyTitle) emptyTitle.textContent = 'No tenants match the current filters';
            if (emptyCopy) emptyCopy.textContent = 'Clear or adjust the search, status, or module filters.';
            if (empty) empty.style.display = 'block';
            return;
        }

        if (empty) empty.style.display = 'none';

        var html = '';
        filtered.forEach(function(t) {
            var status = String(t.status || 'active');
            var pillCls = (status === 'active') ? 'active' : 'suspended';
            var domains = Array.isArray(t.domains) ? t.domains : [];
            var db = (t && t.db) ? t.db : null;
            var dbSummary = (db && (db.db_host || db.db_name || db.db_user))
                ? ('host=' + escapeHtml(db.db_host || '-') + ', db=' + escapeHtml(db.db_name || '-') + ', user=' + escapeHtml(db.db_user || '-'))
                : '-';
            var dbBtn = t.db_configured ? 'Edit DB' : 'Add DB';
            var statusBtnLabel = (status === 'active') ? 'Disable' : 'Enable';
            var statusBtnCls = (status === 'active') ? '' : 'primary';
            var entryDisplay = escapeHtml(t.entry_module_id || '-');
            var adminEmailDisplay = t.admin_email ? escapeHtml(t.admin_email) : '';
            var domHtml = '';
            domains.forEach(function(d) {
                domHtml += '<span class="inline-flex items-center gap-2 px-2.5 py-1.5 rounded border border-gray-200 bg-gray-50 text-xs"><code class="font-mono text-xs">' + escapeHtml(d) + '</code>'
                    + '<button title="Remove" class="border-none bg-transparent cursor-pointer text-red-600 font-bold" onclick="removeDomain(' + (t.id||0) + ',\'' + escapeHtml(d) + '\')">×</button>'
                    + '</span>';
            });

            html += ''
                + '<div class="grid grid-cols-1 gap-3.5 bg-white border border-gray-200/20 rounded-lg p-4 shadow-sm hover:shadow-md hover:-translate-y-px transition-all duration-150' + (TENANT_VIEW_STATE.view === 'list' ? ' md:grid-cols-[1.2fr_0.8fr] md:items-start' : '') + '">'
                + '  <div class="min-w-0">'
                + '    <div class="flex items-start justify-between gap-2.5 mb-2.5">'
                + '      <div>'
                + '        <div class="font-extrabold text-xl tracking-tight">' + escapeHtml(t.tenant_key || '') + '</div>'
                + '        <div class="font-mono text-xs text-gray-400 mt-0.5">tenant_id=' + escapeHtml(t.id) + '</div>'
                + '      </div>'
                + '      <span class="status-pill ' + pillCls + '">' + escapeHtml(status) + '</span>'
                + '    </div>'
                +      (adminEmailDisplay
                            ? '    <div class="text-xs text-gray-400">Admin email: <code class="text-xs">' + adminEmailDisplay + '</code></div>'
                            : '    <div class="text-xs text-gray-400">No admin email set yet.</div>')
                + '    <div class="text-xs font-bold uppercase tracking-wider text-gray-400 mt-3">Domains</div>'
                + '    <div class="flex flex-wrap gap-1.5 mt-2.5">' + (domHtml || '<span class="text-xs text-gray-400 mt-1.5">No domains</span>') + '</div>'
                + '  </div>'
                + '  <div class="min-w-0">'
                + '    <div class="bg-blue-50/40 border border-blue-200/20 rounded-lg p-3.5 grid gap-2.5">'
                + '      <div class="grid gap-0.5">'
                + '        <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Entry module</span>'
                + '        <span class="text-sm text-gray-900 break-words"><code class="text-sm">' + entryDisplay + '</code></span>'
                + '      </div>'
                + '      <div class="grid gap-0.5">'
                + '        <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Database</span>'
                + '        <span class="text-sm text-gray-900 break-words">' + (t.db_configured ? 'Configured' : 'Missing') + '</span>'
                + '      </div>'
                + '      <div class="grid gap-0.5">'
                + '        <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Connection</span>'
                + '        <span class="text-sm text-gray-900 break-words"><code class="text-sm">' + dbSummary + '</code></span>'
                + '      </div>'
                + '    </div>'
                + '  </div>'
                + '  <div class="flex gap-2 flex-wrap col-span-1 md:col-span-2 mt-0.5">'
                + '    <button class="btn btn-outline btn-sm" onclick="openAddDomain(' + (t.id||0) + ')">Add domain</button>'
                + '    <button class="btn btn-primary btn-sm" onclick="openDbConn(' + (t.id||0) + ')">' + dbBtn + '</button>'
                + '    <button class="btn btn-outline btn-sm" onclick="openEntryModule(' + (t.id||0) + ')">Edit entry</button>'
                + '    <button class="btn btn-outline btn-sm" onclick="openAdminEmail(' + (t.id||0) + ')">Admin email</button>'
                + '    <button class="btn btn-outline btn-sm" onclick="openAdminPassword(' + (t.id||0) + ')">Password</button>'
                + (t.entry_module_id === 'bakeshop' && t.db_configured
                    ? '    <button class="btn btn-outline btn-sm" onclick="runTenantSeed(' + (t.id||0) + ',\'bakeshop_julies_bread_pastry\',\'Julie\\\'s seed\')">Run Julie\'s seed</button>'
                    : '')
                + '    <button class="btn btn-sm ' + (statusBtnCls ? 'btn-primary' : 'btn-outline') + '" onclick="toggleTenantStatus(' + (t.id||0) + ',\'' + escapeHtml(status) + '\')">' + statusBtnLabel + '</button>'
                + '    <button class="btn btn-outline btn-sm text-red-600 border-red-600" onclick="deleteTenant(' + (t.id||0) + ',\'' + escapeHtml(t.tenant_key || '') + '\')">Delete</button>'
                + '  </div>'
                + '</div>';
        });

        grid.innerHTML = html;
    }

    function renderEntryModuleOptions(selectedId) {
        var select = document.getElementById('entry-module-select');
        if (!select) return;
        var html = '<option value="">No entry module</option>';
        ENTRY_MODULE_OPTIONS.forEach(function(option) {
            var id = String(option.id || '');
            if (!id) return;
            var selected = (String(selectedId || '') === id) ? ' selected' : '';
            var disabled = (option.loadable === false) ? ' disabled' : '';
            var suffix = [];
            if (option.enabled === false) suffix.push('disabled');
            if (option.loadable === false) suffix.push('not loadable');
            html += '<option value="' + escapeHtml(id) + '"' + selected + disabled + '>'
                + escapeHtml(moduleLabel(option) + (suffix.length ? ' [' + suffix.join(', ') + ']' : ''))
                + '</option>';
        });
        select.innerHTML = html;
    }

    function toggleTenantStatus(tenantId, currentStatus) {
        var tid = parseInt(tenantId || 0, 10);
        if (tid <= 0) return;
        currentStatus = String(currentStatus || 'active');
        var next = (currentStatus === 'active') ? 'suspended' : 'active';
        var verb = (next === 'suspended') ? 'disable' : 'enable';
        if (!window.confirm('Confirm ' + verb + ' tenant #' + tid + '?')) return;
        fetch(BASE + '/api/v1/admin/tenants/status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: tid, status: next, _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                showToast('Tenant status updated');
                reloadTenants();
            } else {
                showToast(res.error || 'Update failed');
            }
        })
        .catch(function(){ showToast('Network error'); });
    }
    function closeModal(id) {
        var el = document.getElementById(id);
        if (el) el.style.display = 'none';
    }
    function onBackdrop(ev, id) {
        if (ev.target && ev.target.id === id) closeModal(id);
    }

    function openCreateTenant() {
        document.getElementById('ct-key').value = '';
        document.getElementById('ct-domain').value = '';
        document.getElementById('ct-admin-email').value = '';
        renderCreateEntryModuleOptions('');
        openModal('modal-create');
    }

    function renderCreateEntryModuleOptions(selectedId) {
        var select = document.getElementById('ct-entry');
        if (!select) return;
        var html = '<option value="">No entry module</option>';
        ENTRY_MODULE_OPTIONS.forEach(function(option) {
            var id = String(option.id || '');
            if (!id) return;
            var selected = (String(selectedId || '') === id) ? ' selected' : '';
            var disabled = (option.loadable === false) ? ' disabled' : '';
            var suffix = [];
            if (option.enabled === false) suffix.push('disabled');
            if (option.loadable === false) suffix.push('not loadable');
            html += '<option value="' + escapeHtml(id) + '"' + selected + disabled + '>'
                + escapeHtml(moduleLabel(option) + (suffix.length ? ' [' + suffix.join(', ') + ']' : ''))
                + '</option>';
        });
        select.innerHTML = html;
    }

    function openEntryModule(tenantId) {
        var tenant = (window.__tenantsById && window.__tenantsById[String(tenantId || '')]) ? window.__tenantsById[String(tenantId || '')] : null;
        document.getElementById('entry-tenant-id').value = String(tenantId || '');
        renderEntryModuleOptions(tenant && tenant.entry_module_id ? String(tenant.entry_module_id) : '');
        openModal('modal-entry-module');
    }

    function openAddDomain(tenantId) {
        document.getElementById('dom-tenant-id').value = String(tenantId || '');
        document.getElementById('dom-domain').value = '';
        openModal('modal-domain');
    }

    function openDbConn(tenantId) {
        document.getElementById('db-tenant-id').value = String(tenantId || '');
        var t = (window.__tenantsById && window.__tenantsById[String(tenantId || '')]) ? window.__tenantsById[String(tenantId || '')] : null;
        var db = t && t.db ? t.db : null;
        document.getElementById('db-host').value = db && db.db_host ? String(db.db_host) : '';
        document.getElementById('db-port').value = '3306';
        document.getElementById('db-name').value = db && db.db_name ? String(db.db_name) : '';
        document.getElementById('db-user').value = db && db.db_user ? String(db.db_user) : '';
        document.getElementById('db-pass').value = '';
        openModal('modal-db');
    }

    function escapeHtml(s) {
        return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function renderTenants(list) {
        list = Array.isArray(list) ? list : [];

        window.__tenantsById = {};
        list.forEach(function(t) {
            if (t && t.id != null) window.__tenantsById[String(t.id)] = t;
        });

        TENANT_VIEW_STATE.list = list;
        renderTenantModuleOptions(list);
        applyTenantFilters();
    }

    function openAdminEmail(tenantId) {
        var t = (window.__tenantsById && window.__tenantsById[String(tenantId || '')]) ? window.__tenantsById[String(tenantId || '')] : null;
        document.getElementById('ae-tenant-id').value = String(tenantId || '');
        document.getElementById('ae-email').value = (t && t.admin_email) ? String(t.admin_email) : '';
        openModal('modal-admin-email');
    }

    function saveAdminEmail() {
        var tenantId = parseInt(document.getElementById('ae-tenant-id').value || '0', 10);
        var email = document.getElementById('ae-email').value.trim();
        fetch(BASE + '/api/v1/admin/tenants/admin-email', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: tenantId, admin_email: email, _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                closeModal('modal-admin-email');
                var pushed = Array.isArray(res.pushed) && res.pushed.length > 0 ? ' Pushed to: ' + res.pushed.join(', ') + '.' : '';
                var skipped = Array.isArray(res.skipped) && res.skipped.length > 0 ? ' Skipped: ' + res.skipped.join(', ') + '.' : '';
                showToast('Admin email saved.' + pushed + skipped);
                reloadTenants();
            } else {
                showToast(res.error || 'Save failed');
            }
        })
        .catch(function(){ showToast('Network error'); });
    }

    function openAdminPassword(tenantId) {
        document.getElementById('ap-tenant-id').value = String(tenantId || '');
        document.getElementById('ap-password').value = '';
        openModal('modal-admin-password');
    }

    function runTenantSeed(tenantId, seedId, label) {
        var tid = parseInt(tenantId || 0, 10);
        if (tid <= 0) return;
        var seedLabel = String(label || 'seed data');
        if (!window.confirm('Run ' + seedLabel + ' for tenant #' + tid + '? This applies data to the tenant\'s own database.')) return;

        fetch(BASE + '/api/v1/admin/tenants/seed-data', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: tid, seed_id: String(seedId || ''), _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                var counts = res && res.counts ? res.counts : null;
                var summary = counts
                    ? ' branches=' + String(counts.branches || 0)
                        + ', products=' + String(counts.products || 0)
                        + ', ingredients=' + String(counts.ingredients || 0)
                    : '';
                showToast('Seed completed.' + summary);
                reloadTenants();
            } else {
                showToast(res.error || 'Seed failed');
            }
        })
        .catch(function(){ showToast('Network error'); });
    }

    function saveAdminPassword() {
        var tenantId = parseInt(document.getElementById('ap-tenant-id').value || '0', 10);
        var password = document.getElementById('ap-password').value;
        fetch(BASE + '/api/v1/admin/tenants/admin-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: tenantId, admin_password: password, _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                closeModal('modal-admin-password');
                var pushed = Array.isArray(res.pushed) && res.pushed.length > 0 ? ' Pushed to: ' + res.pushed.join(', ') + '.' : '';
                var skipped = Array.isArray(res.skipped) && res.skipped.length > 0 ? ' Skipped: ' + res.skipped.join(', ') + '.' : '';
                showToast('Admin password saved.' + pushed + skipped);
            } else {
                showToast(res.error || 'Save failed');
            }
        })
        .catch(function(){ showToast('Network error'); });
    }

    function reloadTenants() {
        fetch(BASE + '/api/v1/admin/tenants', { headers: { 'Accept': 'application/json' } })
            .then(function(r){ return r.json(); })
            .then(function(res){
                if (!res.ok) {
                    showToast(res.error || 'Failed to load tenants');
                    return;
                }
                refreshEntryModuleOptions(res.entry_module_options || []);
                renderTenants(res.tenants || []);
            })
            .catch(function(){ showToast('Network error'); });
    }

    function createTenant() {
        var key = document.getElementById('ct-key').value.trim();
        var domain = document.getElementById('ct-domain').value.trim().toLowerCase();
        var adminEmail = document.getElementById('ct-admin-email').value.trim();
        var entry = document.getElementById('ct-entry').value;
        fetch(BASE + '/api/v1/admin/tenants/create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_key: key, domain: domain, admin_email: adminEmail, entry_module_id: entry, _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                closeModal('modal-create');
                showToast('Tenant created');
                reloadTenants();
            } else {
                showToast(res.error || 'Create failed');
            }
        })
        .catch(function(){ showToast('Network error'); });
    }

    function saveEntryModule() {
        var tenantId = parseInt(document.getElementById('entry-tenant-id').value || '0', 10);
        var entryModuleId = document.getElementById('entry-module-select').value;

        fetch(BASE + '/api/v1/admin/tenants/entry-module', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: tenantId, entry_module_id: entryModuleId, _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                closeModal('modal-entry-module');
                showToast('Entry module saved');
                reloadTenants();
            } else {
                showToast(res.error || 'Save failed');
            }
        })
        .catch(function(){ showToast('Network error'); });
    }

    function addDomain() {
        var tenantId = parseInt(document.getElementById('dom-tenant-id').value || '0', 10);
        var domain = document.getElementById('dom-domain').value.trim().toLowerCase();
        fetch(BASE + '/api/v1/admin/tenants/domain/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: tenantId, domain: domain, _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                closeModal('modal-domain');
                showToast('Domain added');
                reloadTenants();
            } else {
                showToast(res.error || 'Add failed');
            }
        })
        .catch(function(){ showToast('Network error'); });
    }

    function removeDomain(tenantId, domain) {
        if (!window.confirm('Remove domain ' + domain + '?')) return;
        fetch(BASE + '/api/v1/admin/tenants/domain/remove', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: parseInt(tenantId||0,10), domain: String(domain||''), _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                showToast('Domain removed');
                reloadTenants();
            } else {
                showToast(res.error || 'Remove failed');
            }
        })
        .catch(function(){ showToast('Network error'); });
    }

    function saveDbConn() {
        var tenantId = parseInt(document.getElementById('db-tenant-id').value || '0', 10);
        var host = document.getElementById('db-host').value.trim();
        var port = document.getElementById('db-port').value.trim() || '3306';
        var name = document.getElementById('db-name').value.trim();
        var user = document.getElementById('db-user').value.trim();
        var pass = document.getElementById('db-pass').value;

        fetch(BASE + '/api/v1/admin/tenants/db/upsert', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: tenantId, db_host: host, db_port: port, db_name: name, db_user: user, db_pass: pass, _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                closeModal('modal-db');
                showToast('DB saved');
                reloadTenants();
            } else {
                showToast(res.error || 'Save failed');
            }
        })
        .catch(function(){ showToast('Network error'); });
    }

    function deleteTenant(tenantId, tenantKey) {
        var tid = parseInt(tenantId || 0, 10);
        if (tid <= 0) return;
        if (!window.confirm('Permanently delete tenant "' + String(tenantKey || tid) + '" and all its data (domains, DB config, entitlements)? This cannot be undone.')) return;
        fetch(BASE + '/api/v1/admin/tenants/delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tenant_id: tid, _token: CSRF })
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (res.ok) {
                showToast('Tenant deleted');
                reloadTenants();
            } else {
                showToast(res.error || 'Delete failed');
            }
        })
        .catch(function(){ showToast('Network error'); });
    }

    reloadTenants();
</script>
{/block}
