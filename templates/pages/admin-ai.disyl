{extends "layouts/kernel-admin.disyl"}

{block head}
<script>
    function setStatus(msg) {
        var s = document.getElementById('status');
        if (!s) return;
        s.textContent = msg;
    }

    function toggleTierFields() {
        var tier = document.getElementById('tier').value;
        document.getElementById('openaiCustom').style.display = (tier === 'custom') ? 'block' : 'none';
        document.getElementById('ollamaCustom').style.display = (tier === 'custom') ? 'block' : 'none';
        document.getElementById('groqCustom').style.display = (tier === 'custom') ? 'block' : 'none';
    }

    function toggleProviderFields() {
        var p = document.getElementById('provider').value;
        document.getElementById('openaiFields').style.display = (p === 'openai') ? 'block' : 'none';
        document.getElementById('groqFields').style.display = (p === 'groq') ? 'block' : 'none';
        document.getElementById('ollamaFields').style.display = (p === 'ollama') ? 'block' : 'none';
    }

    function loadSettings() {
        setStatus('Loading…');
        fetch('/api/v1/admin/ai/settings')
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (!res || !res.ok) {
                    window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: (res && res.error) ? res.error : 'Failed to load', type: 'error' } }));
                    setStatus('Error');
                    return;
                }
                var s = res.settings || {};

                document.getElementById('provider').value = s.provider || 'openai';
                document.getElementById('tier').value = s.tier || 'free';

                document.getElementById('openai_model_free').value = s.openai_model_free || 'gpt-4o-mini';
                document.getElementById('openai_model_paid').value = s.openai_model_paid || 'gpt-4o';
                document.getElementById('openai_model').value = s.openai_model || '';

                document.getElementById('groq_model_free').value = s.groq_model_free || 'llama-3.1-8b-instant';
                document.getElementById('groq_model_paid').value = s.groq_model_paid || 'llama-3.3-70b-versatile';
                document.getElementById('groq_model').value = s.groq_model || '';

                document.getElementById('ollama_base_url').value = s.ollama_base_url || 'http://localhost:11434';
                document.getElementById('ollama_model_free').value = s.ollama_model_free || 'llama3.2:3b';
                document.getElementById('ollama_model_paid').value = s.ollama_model_paid || 'llama3.1:8b';
                document.getElementById('ollama_model').value = s.ollama_model || '';

                document.getElementById('openai_api_key').value = '';
                document.getElementById('openai_key_masked').textContent = s.openai_api_key_set ? (s.openai_api_key_masked || '***') : '(not set)';

                document.getElementById('groq_api_key').value = '';
                document.getElementById('groq_key_masked').textContent = s.groq_api_key_set ? (s.groq_api_key_masked || '***') : '(not set)';

                document.getElementById('search_grounding_provider').value = s.search_grounding_provider || '';
                document.getElementById('search_grounding_api_key').value = '';
                document.getElementById('search_key_masked').textContent = s.search_grounding_key_set ? (s.search_grounding_key_masked || '***') : '(not set)';
                document.getElementById('search_grounding_max_results').value = s.search_grounding_max_results || 5;

                toggleProviderFields();
                toggleTierFields();

                setStatus('Loaded');
            })
            .catch(function() {
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Network error', type: 'error' } }));
                setStatus('Error');
            });
    }

    function saveSettings() {
        var settings = {
            provider: document.getElementById('provider').value,
            tier: document.getElementById('tier').value,

            openai_model_free: document.getElementById('openai_model_free').value,
            openai_model_paid: document.getElementById('openai_model_paid').value,
            openai_model: document.getElementById('openai_model').value,

            groq_model_free: document.getElementById('groq_model_free').value,
            groq_model_paid: document.getElementById('groq_model_paid').value,
            groq_model: document.getElementById('groq_model').value,

            ollama_base_url: document.getElementById('ollama_base_url').value,
            ollama_model_free: document.getElementById('ollama_model_free').value,
            ollama_model_paid: document.getElementById('ollama_model_paid').value,
            ollama_model: document.getElementById('ollama_model').value,
        };

        var key = document.getElementById('openai_api_key').value;
        if (key && key.trim() !== '') {
            settings.openai_api_key = key.trim();
        }

        var gkey = document.getElementById('groq_api_key').value;
        if (gkey && gkey.trim() !== '') {
            settings.groq_api_key = gkey.trim();
        }

        settings.search_grounding_provider = document.getElementById('search_grounding_provider').value;
        settings.search_grounding_max_results = parseInt(document.getElementById('search_grounding_max_results').value, 10) || 5;
        var skey = document.getElementById('search_grounding_api_key').value;
        if (skey && skey.trim() !== '') {
            settings.search_grounding_api_key = skey.trim();
        }

        setStatus('Saving…');
        fetch('/api/v1/admin/ai/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ settings: settings, _token: '{csrf_token}' })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res && res.ok) {
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'AI settings saved', type: 'success' } }));
                loadSettings();
            } else {
                window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: (res && res.error) ? res.error : 'Save failed', type: 'error' } }));
                setStatus('Error');
            }
        })
        .catch(function() {
            window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Network error', type: 'error' } }));
            setStatus('Error');
        });
    }

    function testConnection() {
        var el = document.getElementById('test-result');
        el.className = 'block text-xs px-3.5 py-2.5 rounded mt-3 bg-gray-50 text-gray-500 border border-gray-200';
        el.textContent = 'Testing connection…';

        fetch('/api/v1/admin/kernel/triggers/suggest', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ module: 'kernel', event_key: 'test.ping', _token: '{csrf_token}', _test: true })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res && (res.ok || res.suggestions)) {
                el.className = 'block text-xs px-3.5 py-2.5 rounded mt-3 bg-green-50 text-green-700 border border-green-500';
                el.textContent = 'Connection successful — AI provider is reachable and responding.';
            } else {
                el.className = 'block text-xs px-3.5 py-2.5 rounded mt-3 bg-red-50 text-red-700 border border-red-500';
                el.textContent = 'Connection failed: ' + ((res && res.error) ? res.error : 'No response from AI provider.');
            }
        })
        .catch(function() {
            el.className = 'block text-xs px-3.5 py-2.5 rounded mt-3 bg-red-50 text-red-700 border border-red-500';
            el.textContent = 'Network error — could not reach the server.';
        });
    }

    loadSettings();
</script>
{/block}

{block content}
<div class="page-header">
    <div>
        <h2>AI Configuration</h2>
        <div class="page-desc">Configure the AI provider, model tier, and API keys for AI-powered capabilities like trigger suggestions and explanations.</div>
    </div>
    <div class="page-actions">
        <span class="badge" id="status">Loading…</span>
        <button class="btn btn-outline btn-sm" onclick="loadSettings()">Reload</button>
        <button class="btn btn-primary btn-sm" onclick="saveSettings()">Save</button>
    </div>
</div>

<div class="panel">
    <div class="flex items-center justify-between gap-3 flex-wrap mb-2.5">
        <div>
            <strong class="text-sm">Provider & Model</strong>
            <div class="text-xs text-gray-400 mt-1.5 leading-relaxed">Select which AI backend to use and the model quality tier.</div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3.5">
        <div>
            <div class="mb-3">
                <label class="block text-xs font-bold text-gray-400 mb-1.5">Provider</label>
                <select class="w-full text-xs px-2.5 py-2 rounded border border-gray-200 bg-gray-50 text-gray-900" id="provider" onchange="toggleProviderFields()">
                    <option value="openai">OpenAI</option>
                    <option value="groq">Groq (OpenAI-compatible)</option>
                    <option value="ollama">Ollama (local)</option>
                </select>
                <div class="text-xs text-gray-400 mt-1.5 leading-relaxed">OpenAI requires an API key. Ollama requires a local Ollama server.</div>
            </div>

            <div class="mb-3">
                <label class="block text-xs font-bold text-gray-400 mb-1.5">Tier</label>
                <select class="w-full text-xs px-2.5 py-2 rounded border border-gray-200 bg-gray-50 text-gray-900" id="tier" onchange="toggleTierFields()">
                    <option value="free">Free tier</option>
                    <option value="paid">Paid tier</option>
                    <option value="custom">Custom</option>
                </select>
                <div class="text-xs text-gray-400 mt-1.5 leading-relaxed">Tier controls which model preset is used by default.</div>
            </div>
        </div>

        <div id="openaiFields">
            <div class="mb-3">
                <label class="block text-xs font-bold text-gray-400 mb-1.5">OpenAI API Key</label>
                <input class="w-full text-xs px-2.5 py-2 rounded border border-gray-200 bg-gray-50 text-gray-900 font-mono" id="openai_api_key" placeholder="sk-... (leave blank to keep existing)">
                <div class="text-xs text-gray-400 mt-1.5 leading-relaxed">Current: <span class="font-mono" id="openai_key_masked">(unknown)</span></div>
            </div>

            <div class="mb-3">
                <label class="block text-xs font-bold text-gray-400 mb-1.5">OpenAI Free Model (preset)</label>
                <select class="w-full text-xs px-2.5 py-2 rounded border border-gray-200 bg-gray-50 text-gray-900" id="openai_model_free">
                    <option value="gpt-4o-mini">gpt-4o-mini</option>
                    <option value="gpt-4.1-mini">gpt-4.1-mini</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="block text-xs font-bold text-gray-400 mb-1.5">OpenAI Paid Model (preset)</label>
                <select class="w-full text-xs px-2.5 py-2 rounded border border-gray-200 bg-gray-50 text-gray-900" id="openai_model_paid">
                    <option value="gpt-4o">gpt-4o</option>
                    <option value="gpt-4.1">gpt-4.1</option>
                </select>
            </div>

            <div class="mb-3" id="openaiCustom">
                <label class="block text-xs font-bold text-gray-400 mb-1.5">OpenAI Custom Model</label>
                <input class="w-full text-xs px-2.5 py-2 rounded border border-gray-200 bg-gray-50 text-gray-900 font-mono" id="openai_model" placeholder="e.g. gpt-4o, gpt-4o-mini">
                <div class="text-xs text-gray-400 mt-1.5 leading-relaxed">Used only when Tier = Custom.</div>
            </div>
        </div>

        <div id="groqFields" style="display:none;">
            <div class="mb-3">
                <label class="block text-xs font-bold text-gray-400 mb-1.5">Groq API Key</label>
                <input class="w-full text-xs px-2.5 py-2 rounded border border-gray-200 bg-gray-50 text-gray-900 font-mono" id="groq_api_key" placeholder="gsk_... (leave blank to keep existing)">
                <div class="text-xs text-gray-400 mt-1.5 leading-relaxed">Current: <span class="font-mono" id="groq_key_masked">(unknown)</span></div>
            </div>

            <div class="mb-3">
                <label class="block text-xs font-bold text-gray-400 mb-1.5">Groq Free Model (preset)</label>
                <input class="w-full text-xs px-2.5 py-2 rounded border border-gray-200 bg-gray-50 text-gray-900 font-mono" id="groq_model_free" placeholder="llama-3.1-8b-instant">
            </div>

            <div class="mb-3">
                <label class="block text-xs font-bold text-gray-400 mb-1.5">Groq Paid Model (preset)</label>
                <input class="w-full text-xs px-2.5 py-2 rounded border border-gray-200 bg-gray-50 text-gray-900 font-mono" id="groq_model_paid" placeholder="llama-3.3-70b-versatile">
            </div>

            <div class="mb-3" id="groqCustom">
                <label class="block text-xs font-bold text-gray-400 mb-1.5">Groq Custom Model</label>
                <input class="w-full text-xs px-2.5 py-2 rounded border border-gray-200 bg-gray-50 text-gray-900 font-mono" id="groq_model" placeholder="e.g. llama-3.3-70b-versatile">
                <div class="text-xs text-gray-400 mt-1.5 leading-relaxed">Used only when Tier = Custom.</div>
            </div>
        </div>

        <div id="ollamaFields" style="display:none;">
            <div class="mb-3">
                <label class="block text-xs font-bold text-gray-400 mb-1.5">Ollama Base URL</label>
                <input class="w-full text-xs px-2.5 py-2 rounded border border-gray-200 bg-gray-50 text-gray-900 font-mono" id="ollama_base_url" placeholder="http://localhost:11434">
            </div>

            <div class="mb-3">
                <label class="block text-xs font-bold text-gray-400 mb-1.5">Ollama Free Model (preset)</label>
                <input class="w-full text-xs px-2.5 py-2 rounded border border-gray-200 bg-gray-50 text-gray-900 font-mono" id="ollama_model_free" placeholder="llama3.2:3b">
            </div>

            <div class="mb-3">
                <label class="block text-xs font-bold text-gray-400 mb-1.5">Ollama Paid Model (preset)</label>
                <input class="w-full text-xs px-2.5 py-2 rounded border border-gray-200 bg-gray-50 text-gray-900 font-mono" id="ollama_model_paid" placeholder="llama3.1:8b">
            </div>

            <div class="mb-3" id="ollamaCustom">
                <label class="block text-xs font-bold text-gray-400 mb-1.5">Ollama Custom Model</label>
                <input class="w-full text-xs px-2.5 py-2 rounded border border-gray-200 bg-gray-50 text-gray-900 font-mono" id="ollama_model" placeholder="e.g. llama3.1:8b">
                <div class="text-xs text-gray-400 mt-1.5 leading-relaxed">Used only when Tier = Custom.</div>
            </div>
        </div>
    </div>
</div>

<div class="panel">
    <div class="font-semibold text-sm">Web Search Grounding</div>
    <div class="text-xs text-gray-400 leading-relaxed mb-3.5">
        When enabled, AI automation fetches live search results before generating content. The model cites real sources as inline links. Requires an API key from one of the supported providers.
    </div>
    <div>
        <div class="mb-3">
            <label class="block text-xs font-bold text-gray-400 mb-1.5">Search Provider</label>
            <select class="w-full text-xs px-2.5 py-2 rounded border border-gray-200 bg-gray-50 text-gray-900" id="search_grounding_provider">
                <option value="">Disabled</option>
                <option value="brave">Brave Search</option>
                <option value="tavily">Tavily (AI-optimized)</option>
                <option value="serper">Serper.dev (Google)</option>
            </select>
            <div class="text-xs text-gray-400 mt-1.5 leading-relaxed">Brave and Serper have free tiers. Tavily is designed specifically for LLM grounding.</div>
        </div>
        <div class="mb-3">
            <label class="block text-xs font-bold text-gray-400 mb-1.5">Search API Key <span class="font-normal text-gray-400">— current: <span id="search_key_masked">(not set)</span></span></label>
            <input class="w-full text-xs px-2.5 py-2 rounded border border-gray-200 bg-gray-50 text-gray-900 font-mono" id="search_grounding_api_key" placeholder="Leave blank to keep existing key">
        </div>
        <div class="mb-3">
            <label class="block text-xs font-bold text-gray-400 mb-1.5">Max Results per Generation</label>
            <input class="w-full text-xs px-2.5 py-2 rounded border border-gray-200 bg-gray-50 text-gray-900" id="search_grounding_max_results" type="number" min="1" max="10" placeholder="5">
            <div class="text-xs text-gray-400 mt-1.5 leading-relaxed">How many search results to fetch and inject as grounding context (1–10).</div>
        </div>
    </div>
</div>

<div class="panel">
    <div class="flex items-center justify-between gap-3 flex-wrap mb-2.5">
        <div>
            <strong class="text-sm">Connection Test</strong>
            <div class="text-xs text-gray-400 mt-1.5 leading-relaxed">Verify that the AI provider is reachable with current settings.</div>
        </div>
        <button class="btn btn-outline btn-sm" onclick="testConnection()">Test Connection</button>
    </div>
    <div id="test-result" class="hidden text-xs px-3.5 py-2.5 rounded mt-3"></div>
</div>
{/block}
