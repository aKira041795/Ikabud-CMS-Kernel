{extends "layouts/app.disyl"}

{block head}
<style>
    .ai-grid { display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 14px; }
    .field { margin-bottom: 12px; }
    .field label { display:block; font-size: 12px; font-weight: 700; color: var(--text-muted); margin-bottom: 6px; }
    .help { font-size: 12px; color: var(--text-muted); margin-top: 6px; line-height: 1.4; }
    .input, .select { width: 100%; font-size: 12px; padding: 8px 10px; border-radius: 8px; border: 1px solid var(--border); background: var(--bg); color: var(--text); }
    .row { display:flex; align-items:center; justify-content:space-between; gap: 12px; flex-wrap: wrap; }
    .test-result { font-size: 12px; padding: 10px 14px; border-radius: 8px; margin-top: 12px; display: none; }
    .test-result.ok { display: block; background: var(--success-light); color: var(--success); border: 1px solid var(--success); }
    .test-result.err { display: block; background: var(--danger-light); color: var(--danger); border: 1px solid var(--danger); }
    .test-result.loading { display: block; background: var(--bg); color: var(--text-muted); border: 1px solid var(--border); }
</style>
{/block}

{block content}
<div class="page-header">
    <div>
        <h2>AI Configuration</h2>
        <div class="page-desc">Configure the AI provider, model tier, and API keys for AI-powered capabilities like trigger suggestions and explanations.</div>
    </div>
    <div class="page-actions">
        <span class="badge" id="status">Loading…</span>
        <button class="btn btn-outline btn-sm" onclick="loadSettings()">Reload</button>
        <button class="btn btn-primary btn-sm" onclick="saveSettings()">Save</button>
    </div>
</div>

<div class="panel">
    <div class="row" style="margin-bottom:10px;">
        <div>
            <strong style="font-size:13px;">Provider & Model</strong>
            <div class="help">Select which AI backend to use and the model quality tier.</div>
        </div>
    </div>

    <div class="ai-grid">
        <div>
            <div class="field">
                <label>Provider</label>
                <select class="select" id="provider" onchange="toggleProviderFields()">
                    <option value="openai">OpenAI</option>
                    <option value="groq">Groq (OpenAI-compatible)</option>
                    <option value="ollama">Ollama (local)</option>
                </select>
                <div class="help">OpenAI requires an API key. Ollama requires a local Ollama server.</div>
            </div>

            <div class="field">
                <label>Tier</label>
                <select class="select" id="tier" onchange="toggleTierFields()">
                    <option value="free">Free tier</option>
                    <option value="paid">Paid tier</option>
                    <option value="custom">Custom</option>
                </select>
                <div class="help">Tier controls which model preset is used by default.</div>
            </div>
        </div>

        <div id="openaiFields">
            <div class="field">
                <label>OpenAI API Key</label>
                <input class="input mono" id="openai_api_key" placeholder="sk-... (leave blank to keep existing)">
                <div class="help">Current: <span class="mono" id="openai_key_masked">(unknown)</span></div>
            </div>

            <div class="field">
                <label>OpenAI Free Model (preset)</label>
                <select class="select" id="openai_model_free">
                    <option value="gpt-4o-mini">gpt-4o-mini</option>
                    <option value="gpt-4.1-mini">gpt-4.1-mini</option>
                </select>
            </div>

            <div class="field">
                <label>OpenAI Paid Model (preset)</label>
                <select class="select" id="openai_model_paid">
                    <option value="gpt-4o">gpt-4o</option>
                    <option value="gpt-4.1">gpt-4.1</option>
                </select>
            </div>

            <div class="field" id="openaiCustom">
                <label>OpenAI Custom Model</label>
                <input class="input mono" id="openai_model" placeholder="e.g. gpt-4o, gpt-4o-mini">
                <div class="help">Used only when Tier = Custom.</div>
            </div>
        </div>

        <div id="groqFields" style="display:none;">
            <div class="field">
                <label>Groq API Key</label>
                <input class="input mono" id="groq_api_key" placeholder="gsk_... (leave blank to keep existing)">
                <div class="help">Current: <span class="mono" id="groq_key_masked">(unknown)</span></div>
            </div>

            <div class="field">
                <label>Groq Free Model (preset)</label>
                <input class="input mono" id="groq_model_free" placeholder="llama-3.1-8b-instant">
            </div>

            <div class="field">
                <label>Groq Paid Model (preset)</label>
                <input class="input mono" id="groq_model_paid" placeholder="llama-3.3-70b-versatile">
            </div>

            <div class="field" id="groqCustom">
                <label>Groq Custom Model</label>
                <input class="input mono" id="groq_model" placeholder="e.g. llama-3.3-70b-versatile">
                <div class="help">Used only when Tier = Custom.</div>
            </div>
        </div>

        <div id="ollamaFields" style="display:none;">
            <div class="field">
                <label>Ollama Base URL</label>
                <input class="input mono" id="ollama_base_url" placeholder="http://localhost:11434">
            </div>

            <div class="field">
                <label>Ollama Free Model (preset)</label>
                <input class="input mono" id="ollama_model_free" placeholder="llama3.2:3b">
            </div>

            <div class="field">
                <label>Ollama Paid Model (preset)</label>
                <input class="input mono" id="ollama_model_paid" placeholder="llama3.1:8b">
            </div>

            <div class="field" id="ollamaCustom">
                <label>Ollama Custom Model</label>
                <input class="input mono" id="ollama_model" placeholder="e.g. llama3.1:8b">
                <div class="help">Used only when Tier = Custom.</div>
            </div>
        </div>
    </div>
</div>

<div class="panel">
    <div class="row" style="margin-bottom:10px;">
        <div>
            <strong style="font-size:13px;">Connection Test</strong>
            <div class="help">Verify that the AI provider is reachable with current settings.</div>
        </div>
        <button class="btn btn-outline btn-sm" onclick="testConnection()">Test Connection</button>
    </div>
    <div id="test-result" class="test-result"></div>
</div>
{/block}

{block scripts}
<script>
    function setStatus(msg) {
        var s = document.getElementById('status');
        if (!s) return;
        s.textContent = msg;
    }

    function toggleTierFields() {
        var tier = document.getElementById('tier').value;
        document.getElementById('openaiCustom').style.display = (tier === 'custom') ? 'block' : 'none';
        document.getElementById('ollamaCustom').style.display = (tier === 'custom') ? 'block' : 'none';
        document.getElementById('groqCustom').style.display = (tier === 'custom') ? 'block' : 'none';
    }

    function toggleProviderFields() {
        var p = document.getElementById('provider').value;
        document.getElementById('openaiFields').style.display = (p === 'openai') ? 'block' : 'none';
        document.getElementById('groqFields').style.display = (p === 'groq') ? 'block' : 'none';
        document.getElementById('ollamaFields').style.display = (p === 'ollama') ? 'block' : 'none';
    }

    function loadSettings() {
        setStatus('Loading…');
        fetch('/api/v1/admin/ai/settings')
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (!res || !res.ok) {
                    showToast((res && res.error) ? res.error : 'Failed to load');
                    setStatus('Error');
                    return;
                }
                var s = res.settings || {};

                document.getElementById('provider').value = s.provider || 'openai';
                document.getElementById('tier').value = s.tier || 'free';

                document.getElementById('openai_model_free').value = s.openai_model_free || 'gpt-4o-mini';
                document.getElementById('openai_model_paid').value = s.openai_model_paid || 'gpt-4o';
                document.getElementById('openai_model').value = s.openai_model || '';

                document.getElementById('groq_model_free').value = s.groq_model_free || 'llama-3.1-8b-instant';
                document.getElementById('groq_model_paid').value = s.groq_model_paid || 'llama-3.3-70b-versatile';
                document.getElementById('groq_model').value = s.groq_model || '';

                document.getElementById('ollama_base_url').value = s.ollama_base_url || 'http://localhost:11434';
                document.getElementById('ollama_model_free').value = s.ollama_model_free || 'llama3.2:3b';
                document.getElementById('ollama_model_paid').value = s.ollama_model_paid || 'llama3.1:8b';
                document.getElementById('ollama_model').value = s.ollama_model || '';

                document.getElementById('openai_api_key').value = '';
                document.getElementById('openai_key_masked').textContent = s.openai_api_key_set ? (s.openai_api_key_masked || '***') : '(not set)';

                document.getElementById('groq_api_key').value = '';
                document.getElementById('groq_key_masked').textContent = s.groq_api_key_set ? (s.groq_api_key_masked || '***') : '(not set)';

                toggleProviderFields();
                toggleTierFields();

                setStatus('Loaded');
            })
            .catch(function() {
                showToast('Network error');
                setStatus('Error');
            });
    }

    function saveSettings() {
        var settings = {
            provider: document.getElementById('provider').value,
            tier: document.getElementById('tier').value,

            openai_model_free: document.getElementById('openai_model_free').value,
            openai_model_paid: document.getElementById('openai_model_paid').value,
            openai_model: document.getElementById('openai_model').value,

            groq_model_free: document.getElementById('groq_model_free').value,
            groq_model_paid: document.getElementById('groq_model_paid').value,
            groq_model: document.getElementById('groq_model').value,

            ollama_base_url: document.getElementById('ollama_base_url').value,
            ollama_model_free: document.getElementById('ollama_model_free').value,
            ollama_model_paid: document.getElementById('ollama_model_paid').value,
            ollama_model: document.getElementById('ollama_model').value,
        };

        var key = document.getElementById('openai_api_key').value;
        if (key && key.trim() !== '') {
            settings.openai_api_key = key.trim();
        }

        var gkey = document.getElementById('groq_api_key').value;
        if (gkey && gkey.trim() !== '') {
            settings.groq_api_key = gkey.trim();
        }

        setStatus('Saving…');
        fetch('/api/v1/admin/ai/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ settings: settings, _token: '{csrf_token}' })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res && res.ok) {
                showToast('AI settings saved');
                loadSettings();
            } else {
                showToast((res && res.error) ? res.error : 'Save failed');
                setStatus('Error');
            }
        })
        .catch(function() {
            showToast('Network error');
            setStatus('Error');
        });
    }

    function testConnection() {
        var el = document.getElementById('test-result');
        el.className = 'test-result loading';
        el.textContent = 'Testing connection…';

        fetch('/api/v1/admin/kernel/triggers/suggest', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ module: 'kernel', event_key: 'test.ping', _token: '{csrf_token}', _test: true })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res && (res.ok || res.suggestions)) {
                el.className = 'test-result ok';
                el.textContent = 'Connection successful — AI provider is reachable and responding.';
            } else {
                el.className = 'test-result err';
                el.textContent = 'Connection failed: ' + ((res && res.error) ? res.error : 'No response from AI provider.');
            }
        })
        .catch(function() {
            el.className = 'test-result err';
            el.textContent = 'Network error — could not reach the server.';
        });
    }

    loadSettings();
</script>
{/block}
