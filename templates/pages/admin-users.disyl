{extends "layouts/kernel-admin.disyl"}

{block head}
<script>
    var BASE = '{base_url}';

    function openAddUser() {
        document.getElementById('add-full-name').value = '';
        document.getElementById('add-username').value = '';
        document.getElementById('add-password').value = '';
        document.getElementById('add-role').value = 'manager';
        openModal('add-modal');
    }

    function openEditUser(id, name, role, active) {
        document.getElementById('edit-id').value = id;
        document.getElementById('edit-full-name').value = name || '';
        document.getElementById('edit-role').value = role || 'manager';
        document.getElementById('edit-active').value = String(active || 1);
        document.getElementById('edit-password').value = '';
        openModal('edit-modal');
    }

    function openModal(id) {
        var el = document.getElementById(id);
        if (el) el.style.display = 'flex';
    }

    function closeModal(id) {
        var el = document.getElementById(id);
        if (el) el.style.display = 'none';
    }

    function submitAddUser() {
        var fullName = document.getElementById('add-full-name').value.trim();
        var username = document.getElementById('add-username').value.trim();
        var password = document.getElementById('add-password').value;
        var role = document.getElementById('add-role').value;

        if (!fullName || !username || !password) {
            window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'All fields required', type: 'error' } }));
            return;
        }

        var btn = document.getElementById('add-submit');
        btn.disabled = true; btn.textContent = 'Adding...';

        fetch(BASE + '/api/v1/admin/users', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ full_name: fullName, username: username, password: password, role: role })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res.ok) { window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'User added', type: 'success' } })); setTimeout(function() { window.location.reload(); }, 600); }
            else { window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: res.error || 'Failed', type: 'error' } })); btn.disabled = false; btn.textContent = 'Add User'; }
        })
        .catch(function() { window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Network error', type: 'error' } })); btn.disabled = false; btn.textContent = 'Add User'; });
    }

    function submitEditUser() {
        var userId = parseInt(document.getElementById('edit-id').value || '0');
        var fullName = document.getElementById('edit-full-name').value.trim();
        var role = document.getElementById('edit-role').value;
        var isActive = parseInt(document.getElementById('edit-active').value || '1');
        var password = document.getElementById('edit-password').value;

        if (!userId || !fullName) {
            window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Invalid input', type: 'error' } }));
            return;
        }

        var btn = document.getElementById('edit-submit');
        btn.disabled = true; btn.textContent = 'Saving...';

        fetch(BASE + '/api/v1/admin/users/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ user_id: userId, full_name: fullName, role: role, is_active: isActive, password: password })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res.ok) { window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Saved', type: 'success' } })); setTimeout(function() { window.location.reload(); }, 600); }
            else { window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: res.error || 'Failed', type: 'error' } })); btn.disabled = false; btn.textContent = 'Save'; }
        })
        .catch(function() { window.dispatchEvent(new CustomEvent('cms-toast', { detail: { message: 'Network error', type: 'error' } })); btn.disabled = false; btn.textContent = 'Save'; });
    }
</script>
{/block}

{block content}
<div class="page-header">
    <div>
        <h2>Users</h2>
        <div class="page-desc">Manage kernel-level admin accounts. Module users are managed within each module.</div>
    </div>
    <div class="page-actions">
        <form style="display:flex;gap:8px;align-items:center;" method="GET" action="{base_url}/admin/users">
            <input type="text" class="form-input" name="q" value="{search}" placeholder="Search name or username..." style="width:220px;">
            <button type="submit" class="btn btn-outline btn-sm">Search</button>
        </form>
        <button class="btn btn-primary btn-sm" onclick="openAddUser()">+ Add User</button>
    </div>
</div>

<div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr>
                    <th class="px-3.5 py-2.5 text-left text-xs font-semibold text-gray-500 border-b border-gray-200">ID</th>
                    <th class="px-3.5 py-2.5 text-left text-xs font-semibold text-gray-500 border-b border-gray-200">Full Name</th>
                    <th class="px-3.5 py-2.5 text-left text-xs font-semibold text-gray-500 border-b border-gray-200">Username</th>
                    <th class="px-3.5 py-2.5 text-left text-xs font-semibold text-gray-500 border-b border-gray-200">Role</th>
                    <th class="px-3.5 py-2.5 text-left text-xs font-semibold text-gray-500 border-b border-gray-200">Status</th>
                    <th class="px-3.5 py-2.5 text-left text-xs font-semibold text-gray-500 border-b border-gray-200">Actions</th>
                </tr>
            </thead>
            <tbody>
                {if users | count == 0}
                <tr>
                    <td colspan="6" class="text-gray-400 px-3.5 py-5">No kernel users found.</td>
                </tr>
                {else}
                {foreach users as u}
                <tr class="border-b border-gray-100 last:border-0">
                    <td class="px-3.5 py-2.5 font-mono text-xs text-gray-400">{u.id}</td>
                    <td class="px-3.5 py-2.5 font-semibold">{u.full_name}</td>
                    <td class="px-3.5 py-2.5 font-mono text-xs">{u.username}</td>
                    <td class="px-3.5 py-2.5"><span class="role-pill {u.role}">{u.role}</span></td>
                    <td class="px-3.5 py-2.5">
                        <span class="inline-flex items-center gap-1.5">
                            <span class="inline-block w-[7px] h-[7px] rounded {if u.is_active == 1}bg-green-500{else}bg-red-500{/if}"></span>
                            {if u.is_active == 1}Active{else}Inactive{/if}
                        </span>
                    </td>
                    <td class="px-3.5 py-2.5">
                        <button class="btn btn-outline btn-sm" onclick="openEditUser({u.id}, '{u.full_name | escape}', '{u.role}', {u.is_active})">Edit</button>
                    </td>
                </tr>
                {/foreach}
                {/if}
            </tbody>
        </table>
    </div>
</div>

<!-- Add User Modal -->
<div class="modal-overlay" id="add-modal" onclick="if(event.target===this)closeModal('add-modal')">
    <div class="modal" onclick="event.stopPropagation()">
        <h3>Add User</h3>
        <div class="form-group">
            <label class="form-label">Full Name</label>
            <input class="form-input" type="text" id="add-full-name" autocomplete="off">
        </div>
        <div class="form-group">
            <label class="form-label">Username</label>
            <input class="form-input" type="text" id="add-username" autocomplete="off">
        </div>
        <div class="form-group">
            <label class="form-label">Password</label>
            <input class="form-input" type="password" id="add-password" autocomplete="new-password">
        </div>
        <div class="form-group">
            <label class="form-label">Role</label>
            <select class="form-input" id="add-role">
                <option value="admin">admin</option>
                <option value="superadmin">superadmin</option>
                <option value="manager">manager</option>
                <option value="viewer">viewer</option>
            </select>
        </div>
        <div class="modal-actions">
            <button class="btn btn-outline" onclick="closeModal('add-modal')">Cancel</button>
            <button class="btn btn-primary" id="add-submit" onclick="submitAddUser()">Add User</button>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal-overlay" id="edit-modal" onclick="if(event.target===this)closeModal('edit-modal')">
    <div class="modal" onclick="event.stopPropagation()">
        <h3>Edit User</h3>
        <input type="hidden" id="edit-id">
        <div class="form-group">
            <label class="form-label">Full Name</label>
            <input class="form-input" type="text" id="edit-full-name" autocomplete="off">
        </div>
        <div class="form-group">
            <label class="form-label">Role</label>
            <select class="form-input" id="edit-role">
                <option value="admin">admin</option>
                <option value="superadmin">superadmin</option>
                <option value="manager">manager</option>
                <option value="viewer">viewer</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Status</label>
            <select class="form-input" id="edit-active">
                <option value="1">Active</option>
                <option value="0">Inactive</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">New Password (optional)</label>
            <input class="form-input" type="password" id="edit-password" autocomplete="new-password">
            <div class="hint">Leave blank to keep the existing password.</div>
        </div>
        <div class="modal-actions">
            <button class="btn btn-outline" onclick="closeModal('edit-modal')">Cancel</button>
            <button class="btn btn-primary" id="edit-submit" onclick="submitEditUser()">Save</button>
        </div>
    </div>
</div>

{/block}
