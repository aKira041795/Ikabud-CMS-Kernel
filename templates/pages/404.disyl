{extends "layouts/app.disyl"}

{block content}
<style>
    .kernel-404 {
        position: relative;
        max-width: 1140px;
        margin: 0 auto;
        padding: 36px 12px 24px;
    }
    .kernel-404-shell {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(148, 163, 184, 0.22);
        border-radius: 28px;
        background:
            radial-gradient(circle at top left, rgba(37, 99, 235, 0.18), transparent 34%),
            radial-gradient(circle at right center, rgba(14, 165, 233, 0.12), transparent 28%),
            linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(243, 247, 255, 0.96));
        box-shadow: 0 30px 70px rgba(15, 23, 42, 0.12);
    }
    .kernel-404-glow {
        position: absolute;
        border-radius: 999px;
        filter: blur(12px);
        pointer-events: none;
    }
    .kernel-404-glow.one {
        width: 260px;
        height: 260px;
        top: -110px;
        right: -70px;
        background: rgba(37, 99, 235, 0.18);
    }
    .kernel-404-glow.two {
        width: 220px;
        height: 220px;
        bottom: -90px;
        left: -70px;
        background: rgba(14, 165, 233, 0.14);
    }
    .kernel-404-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.95fr);
        gap: 22px;
        padding: 34px;
    }
    .kernel-404-hero {
        padding: 12px 6px 12px 4px;
    }
    .kernel-404-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(37, 99, 235, 0.08);
        border: 1px solid rgba(37, 99, 235, 0.16);
        color: #1d4ed8;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }
    .kernel-404-kicker-dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: linear-gradient(180deg, #2563eb, #0ea5e9);
        box-shadow: 0 0 0 6px rgba(37, 99, 235, 0.12);
    }
    .kernel-404-code {
        margin-top: 22px;
        font-size: clamp(82px, 16vw, 148px);
        line-height: 0.9;
        font-weight: 900;
        letter-spacing: -0.08em;
        color: #d4deef;
        text-shadow: 0 12px 30px rgba(148, 163, 184, 0.18);
    }
    .kernel-404-title {
        margin-top: 18px;
        max-width: 11ch;
        font-size: clamp(34px, 5vw, 58px);
        line-height: 0.95;
        letter-spacing: -0.05em;
        font-weight: 900;
        color: var(--text);
    }
    .kernel-404-copy {
        margin-top: 18px;
        max-width: 640px;
        font-size: 16px;
        line-height: 1.75;
        color: var(--text-muted);
    }
    .kernel-404-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }
    .kernel-404-actions .btn {
        min-width: 160px;
        min-height: 46px;
        border-radius: 14px;
        box-shadow: 0 14px 26px rgba(15, 23, 42, 0.08);
    }
    .kernel-404-actions .btn-outline {
        background: rgba(255, 255, 255, 0.74);
    }
    .kernel-404-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
    }
    .kernel-404-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.78);
        border: 1px solid rgba(148, 163, 184, 0.2);
        font-size: 12px;
        font-weight: 700;
        color: var(--text-muted);
    }
    .kernel-404-chip strong {
        color: var(--text);
    }
    .kernel-404-panel {
        position: relative;
        padding: 24px;
        border-radius: 24px;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.97), rgba(15, 23, 42, 0.9));
        border: 1px solid rgba(148, 163, 184, 0.14);
        color: #dbe7ff;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }
    .kernel-404-panel-label {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(219, 231, 255, 0.68);
    }
    .kernel-404-panel-title {
        margin-top: 10px;
        font-size: 28px;
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -0.04em;
        color: #ffffff;
    }
    .kernel-404-panel-copy {
        margin-top: 10px;
        font-size: 14px;
        line-height: 1.7;
        color: rgba(219, 231, 255, 0.76);
    }
    .kernel-404-steps {
        margin-top: 22px;
        display: grid;
        gap: 12px;
    }
    .kernel-404-step {
        display: grid;
        grid-template-columns: 38px minmax(0, 1fr);
        gap: 12px;
        align-items: start;
        padding: 14px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(148, 163, 184, 0.1);
    }
    .kernel-404-step-index {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 14px;
        background: linear-gradient(180deg, rgba(59, 130, 246, 0.22), rgba(14, 165, 233, 0.14));
        color: #ffffff;
        font-size: 13px;
        font-weight: 800;
    }
    .kernel-404-step-title {
        font-size: 14px;
        font-weight: 800;
        color: #ffffff;
    }
    .kernel-404-step-copy {
        margin-top: 4px;
        font-size: 13px;
        line-height: 1.65;
        color: rgba(219, 231, 255, 0.74);
    }
    .kernel-404-links {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        padding: 0 34px 34px;
    }
    .kernel-404-link {
        padding: 18px 18px 16px;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid rgba(148, 163, 184, 0.18);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85);
    }
    .kernel-404-link-label {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--text-light);
    }
    .kernel-404-link-title {
        margin-top: 8px;
        font-size: 18px;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--text);
    }
    .kernel-404-link-copy {
        margin-top: 8px;
        font-size: 14px;
        line-height: 1.7;
        color: var(--text-muted);
    }
    .kernel-404-link a {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        font-size: 13px;
        font-weight: 800;
        color: var(--primary);
    }
    .kernel-404-link a:hover {
        color: var(--primary-hover);
    }
    @media (max-width: 980px) {
        .kernel-404-grid,
        .kernel-404-links {
            grid-template-columns: 1fr;
        }
    }
    @media (max-width: 720px) {
        .kernel-404 {
            padding-top: 10px;
        }
        .kernel-404-grid {
            padding: 24px 18px;
        }
        .kernel-404-links {
            padding: 0 18px 18px;
        }
        .kernel-404-shell {
            border-radius: 24px;
        }
        .kernel-404-panel,
        .kernel-404-link {
            border-radius: 20px;
        }
        .kernel-404-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="kernel-404">
    <div class="kernel-404-shell">
        <div class="kernel-404-glow one"></div>
        <div class="kernel-404-glow two"></div>

        <div class="kernel-404-grid">
            <section class="kernel-404-hero" aria-labelledby="kernel-404-title">
                <div class="kernel-404-kicker">
                    <span class="kernel-404-kicker-dot"></span>
                    Kernel OS Recovery View
                </div>

                <div class="kernel-404-code">404</div>

                <h1 id="kernel-404-title" class="kernel-404-title">We could not find that page.</h1>

                <p class="kernel-404-copy">
                    The address may be outdated, the page may have moved, or the resource may no longer be available from this route.
                    Start from the main workspace or return to the previous screen to continue safely.
                </p>

                <div class="kernel-404-actions">
                    <a href="{base_url}/" class="btn btn-primary">Open Home</a>
                    <button type="button" class="btn btn-outline" onclick="window.history.length > 1 ? window.history.back() : window.location.href='{base_url}/';">Go Back</button>
                </div>

                <div class="kernel-404-meta">
                    <span class="kernel-404-chip">Status <strong>Not Found</strong></span>
                    <span class="kernel-404-chip">Experience <strong>{gui.app_name}</strong></span>
                    <span class="kernel-404-chip">Response <strong>HTTP 404</strong></span>
                </div>
            </section>

            <aside class="kernel-404-panel" aria-label="Recovery guidance">
                <div class="kernel-404-panel-label">Recommended next steps</div>
                <div class="kernel-404-panel-title">Recover quickly without losing context.</div>
                <p class="kernel-404-panel-copy">
                    Most 404s are routing mistakes, stale bookmarks, or expired links. Use the steps below to get back to a valid path.
                </p>

                <div class="kernel-404-steps">
                    <div class="kernel-404-step">
                        <div class="kernel-404-step-index">01</div>
                        <div>
                            <div class="kernel-404-step-title">Review the address</div>
                            <div class="kernel-404-step-copy">Check the URL for typos, missing segments, or copied query strings that no longer apply.</div>
                        </div>
                    </div>

                    <div class="kernel-404-step">
                        <div class="kernel-404-step-index">02</div>
                        <div>
                            <div class="kernel-404-step-title">Return to a trusted starting point</div>
                            <div class="kernel-404-step-copy">Open the main workspace and navigate again using the current menus instead of an old bookmark.</div>
                        </div>
                    </div>

                    <div class="kernel-404-step">
                        <div class="kernel-404-step-index">03</div>
                        <div>
                            <div class="kernel-404-step-title">Re-authenticate if needed</div>
                            <div class="kernel-404-step-copy">If access changed or the session expired, signing in again can restore the expected route map.</div>
                        </div>
                    </div>
                </div>
            </aside>
        </div>

        <div class="kernel-404-links" aria-label="Helpful links">
            <section class="kernel-404-link">
                <div class="kernel-404-link-label">Primary route</div>
                <div class="kernel-404-link-title">Return to the main workspace</div>
                <div class="kernel-404-link-copy">Use the default landing page for this installation and continue from a known-good route.</div>
                <a href="{base_url}/">Open home</a>
            </section>

            <section class="kernel-404-link">
                <div class="kernel-404-link-label">Access recovery</div>
                <div class="kernel-404-link-title">Open the sign-in screen</div>
                <div class="kernel-404-link-copy">If you arrived from an expired session or protected route, re-enter through the login flow.</div>
                {if base_url == '/cms'}
                    <a href="{base_url}/login">Go to login</a>
                {elseif base_url == '/guidance'}
                    <a href="{base_url}/login">Go to login</a>
                {elseif base_url == '/shop'}
                    <a href="/cms/login?redirect=/shop">Go to login</a>
                {else}
                    <a href="/login">Go to login</a>
                {/if}
            </section>

            <section class="kernel-404-link">
                <div class="kernel-404-link-label">Navigation fallback</div>
                <div class="kernel-404-link-title">Resume where you came from</div>
                <div class="kernel-404-link-copy">Go back one step if this page was opened from an internal link or the browser history.</div>
                <a href="#" onclick="event.preventDefault(); window.history.length > 1 ? window.history.back() : window.location.href='{base_url}/';">Go back now</a>
            </section>
        </div>
    </div>
</div>
{/block}
