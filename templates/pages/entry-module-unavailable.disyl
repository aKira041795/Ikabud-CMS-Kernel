{extends "layouts/app.disyl"}

{block content}
<div style="max-width: 720px; margin: 0 auto; padding: 80px 20px; text-align: center;">
    <h1 style="font-size: calc(var(--font-size-h1) * 2.1); font-weight: 800; color: var(--danger);">Tenant Unavailable</h1>
    <p style="font-size: var(--font-size-h2); color: var(--text-muted); margin-top: 10px;">The tenant entry module is currently unavailable.</p>
    <p style="color: var(--text-light); margin-top: 8px;">The configured entry module{if !empty($entry_module_id)} <strong>{entry_module_id}</strong>{/if} could not be loaded safely. Please check module health and recent runtime logs.</p>
    <div style="margin-top: 22px; display:flex; gap: 10px; justify-content:center; flex-wrap:wrap;">
        <a href="{base_url}/" class="btn btn-primary">Go Home</a>
        <a href="{base_url}/admin/modules" class="btn btn-outline">Admin: Modules</a>
        <a href="{base_url}/admin/tenants" class="btn btn-outline">Admin: Tenants</a>
    </div>
</div>
{/block}
