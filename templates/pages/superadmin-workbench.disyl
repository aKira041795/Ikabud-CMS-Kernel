{extends "layouts/kernel-admin.disyl"}

{block head}
<script>
function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }

// Set by DiSyL — used inside verbatim blocks where { } is safe
var wbBaseUrl = '{base_url}';
var wbCsrfToken = '{csrf_token}';

{verbatim}
// ── API Keys ──────────────────────────────────────────────────
async function wbCreateKey() {
    var btn = document.querySelector('.wb-btn-create-key');
    if (btn) { btn.disabled = true; btn.textContent = 'Creating...'; }
    var name = prompt('Key name (e.g. "CI runner", "dev local"):');
    if (!name) { if (btn) { btn.disabled = false; btn.textContent = '+ New Key'; } return; }
    try {
        var res = await fetch(wbBaseUrl + '/api/v1/superadmin/workbench/keys', {
            method: 'POST', credentials: 'same-origin',
            headers: {'Content-Type': 'application/json', 'X-CSRF-Token': wbCsrfToken},
            body: JSON.stringify({action: 'create', name: name, scopes: ['*']}),
        });
        var data = await res.json();
        if (!data.ok) { alert('Error: ' + (data.error || 'Unknown')); if (btn) { btn.disabled = false; btn.textContent = '+ New Key'; } return; }
        var keyEl = document.getElementById('wb-new-key');
        var codeEl = document.createElement('code');
        codeEl.className = 'text-xs text-green-900 break-all select-all';
        codeEl.textContent = data.key;
        keyEl.innerHTML = '<div class="p-4 bg-green-50 border border-green-200 rounded-lg"><div class="text-sm font-bold text-green-800 mb-1">Key Created — Copy Now (shown once)</div>';
        keyEl.firstChild.appendChild(codeEl);
        keyEl.firstChild.innerHTML += '<div class="text-xs text-green-600 mt-1">Prefix: ' + escHtml(data.prefix) + ' | Name: ' + escHtml(data.name) + '</div></div>';
        setTimeout(function(){ location.reload(); }, 5000);
    } catch(e) { alert('Error: ' + e.message); if (btn) { btn.disabled = false; btn.textContent = '+ New Key'; } }
}
async function wbRevokeKey(id, row) {
    if (!confirm('Revoke key #' + id + '? This cannot be undone.')) return;
    if (row) { row.style.opacity = '0.5'; row.style.pointerEvents = 'none'; }
    try {
        var res = await fetch(wbBaseUrl + '/api/v1/superadmin/workbench/keys', {
            method: 'POST', credentials: 'same-origin',
            headers: {'Content-Type': 'application/json', 'X-CSRF-Token': wbCsrfToken},
            body: JSON.stringify({action: 'revoke', id: id}),
        });
        var data = await res.json();
        if (!data.ok) { alert('Error: ' + (data.error || 'Unknown')); if (row) { row.style.opacity = '1'; row.style.pointerEvents = ''; } return; }
        location.reload();
    } catch(e) { alert('Error: ' + e.message); if (row) { row.style.opacity = '1'; row.style.pointerEvents = ''; } }
}

// ── Test Runner ───────────────────────────────────────────────
async function wbRunTests(target) {
    var label = target === 'all' ? 'all test suites' : target;
    if (!confirm('Run ' + label + '? This executes PHP tests on the server.')) return;
    var outEl = document.getElementById('wb-test-output');
    var btns = document.querySelectorAll('.wb-btn-test');
    for (var i = 0; i < btns.length; i++) { btns[i].disabled = true; }
    outEl.innerHTML = '<div class="text-sm text-gray-500 animate-pulse">Running ' + escHtml(label) + '...</div>';
    try {
        var res = await fetch(wbBaseUrl + '/api/v1/superadmin/workbench/trigger-tests', {
            method: 'POST', credentials: 'same-origin',
            headers: {'Content-Type': 'application/json', 'X-CSRF-Token': wbCsrfToken},
            body: JSON.stringify({target: target}),
        });
        var data = await res.json();
        var cls = data.ok ? 'bg-green-50 border-green-200' : 'bg-red-50 border-red-200';
        var hdr = data.ok ? 'Tests Passed (exit ' + data.exit_code + ')' : 'Tests Failed (exit ' + data.exit_code + ')';
        var logs = '';
        if (data.app_log_bytes > 0) logs += '<div class="text-xs text-gray-600 mt-1">app.log: ' + data.app_log_bytes + ' bytes</div>';
        if (data.error_log_bytes > 0) logs += '<div class="text-xs text-red-600 mt-1">error.log: ' + data.error_log_bytes + ' bytes</div>';
        var preEl = document.createElement('pre');
        preEl.className = 'text-xs whitespace-pre-wrap overflow-auto max-h-96';
        preEl.textContent = data.output || '';
        var div = document.createElement('div');
        div.className = 'p-4 border rounded-lg ' + cls;
        var hdrEl = document.createElement('div');
        hdrEl.className = 'text-sm font-bold mb-1';
        hdrEl.textContent = hdr;
        div.appendChild(hdrEl);
        div.appendChild(preEl);
        if (logs) { var logDiv = document.createElement('div'); logDiv.innerHTML = logs; div.appendChild(logDiv); }
        var refreshDiv = document.createElement('div');
        refreshDiv.className = 'mt-2';
        refreshDiv.innerHTML = '<button onclick="location.reload()" class="text-xs px-3 py-1 rounded bg-gray-600 text-white hover:bg-gray-700">Refresh Page</button>';
        div.appendChild(refreshDiv);
        outEl.innerHTML = '';
        outEl.appendChild(div);
        // Auto-refresh results table
        setTimeout(function(){ location.reload(); }, 2000);
    } catch(e) {
        outEl.innerHTML = '<div class="p-4 border border-red-200 rounded-lg bg-red-50 text-sm text-red-800">Error: ' + escHtml(e.message) + '</div>';
    } finally {
        for (var i = 0; i < btns.length; i++) { btns[i].disabled = false; }
    }
}
async function wbViewResult(suite) {
    var el = document.getElementById('wb-result-detail');
    el.innerHTML = '<div class="text-sm text-gray-500 animate-pulse">Loading results...</div>';
    try {
        var res = await fetch(wbBaseUrl + '/api/v1/superadmin/workbench/test-results?suite=' + encodeURIComponent(suite));
        var data = await res.json();
        if (!data.ok) { el.innerHTML = '<div class="text-sm text-red-600">' + escHtml(data.error || 'Not found') + '</div>'; return; }
        var preEl = document.createElement('pre');
        preEl.className = 'text-xs whitespace-pre-wrap overflow-auto max-h-96 bg-gray-900 text-green-400 p-4 rounded-lg';
        preEl.textContent = JSON.stringify(data.results, null, 2);
        el.innerHTML = '';
        el.appendChild(preEl);
    } catch(e) { el.innerHTML = '<div class="text-sm text-red-600">Error loading results: ' + escHtml(e.message) + '</div>'; }
}
{/verbatim}
</script>
{/block}

{block content}
<div class="p-4 lg:p-6 space-y-6">

    <!-- Header -->
    <div class="flex items-start justify-between">
        <div>
            <h1 class="text-xl font-bold text-slate-900">ARK Workbench</h1>
            <p class="text-sm text-gray-500 mt-1">Developer observability — API keys, AI models, test runner, and test results.</p>
        </div>
    </div>

    <!-- ──────────── API KEYS ──────────── -->
    <div class="panel">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-semibold text-slate-700">API Keys</h2>
            <button onclick="wbCreateKey()" class="kernel-btn kernel-btn-primary text-xs wb-btn-create-key">+ New Key</button>
        </div>

        <div id="wb-new-key"></div>

        {if api_keys | count > 0}
        <table class="data w-full">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Prefix</th>
                    <th>Scopes</th>
                    <th>Last Used</th>
                    <th>Status</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                {foreach api_keys as key}
                <tr>
                    <td class="font-medium">{key.name}</td>
                    <td class="mono text-xs">{key.key_prefix}</td>
                    <td class="text-xs">
                        {if (key.scopes | count) > 0}
                            {foreach key.scopes as scope}<span class="badge">{scope}</span> {/foreach}
                        {else}
                            <span class="text-gray-400">—</span>
                        {/if}
                    </td>
                    <td class="text-xs text-gray-500">{key.last_used_at|default:'Never'}</td>
                    <td>
                        {if key.is_active}
                            <span class="badge" style="color:#059669;border-color:#059669">Active</span>
                        {else}
                            <span class="badge" style="color:#e03131;border-color:#e03131">Revoked</span>
                        {/if}
                    </td>
                    <td class="text-right">
                        {if key.is_active}
                        <button onclick="wbRevokeKey({key.id}, this.closest('tr'))" class="kernel-btn kernel-btn-danger text-xs">Revoke</button>
                        {/if}
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
        {else}
        <div class="empty-state">
            <h3>No API Keys</h3>
            <p>Create a key for headless API access (CI, external services, dev tools).</p>
        </div>
        {/if}
    </div>

    <!-- ──────────── AI MODELS ──────────── -->
    <div class="panel">
        <h2 class="text-sm font-semibold text-slate-700 mb-4">AI Models</h2>
        {if ai_module_enabled}
        <table class="data w-full">
            <thead>
                <tr>
                    <th>Provider</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {foreach models as m}
                <tr>
                    <td class="font-medium">{m.provider}</td>
                    <td>
                        {if m.configured}
                            <span class="badge" style="color:#059669;border-color:#059669">Ready</span>
                        {else}
                            <span class="badge" style="color:#d97706;border-color:#d97706">No API key</span>
                        {/if}
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
        {else}
        <div class="empty-state">
            <h3>AI Module Not Enabled</h3>
            <p>Enable the AI module in <a href="{base_url}/superadmin/settings" class="text-blue-600 underline">Feature Settings</a> to see model status.</p>
        </div>
        {/if}
    </div>

    <!-- ──────────── TEST RUNNER ──────────── -->
    <div class="panel">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-semibold text-slate-700">Test Runner</h2>
            <button onclick="wbRunTests('all')" class="kernel-btn kernel-btn-primary text-xs wb-btn-test">Run All Tests</button>
        </div>
        <p class="hint mb-3">Run PHP test suites directly from the browser. Output appears below.</p>

        {if discoverable_tests | count > 0}
        <div class="space-y-1 mb-3">
            <div class="text-xs font-semibold text-gray-500 uppercase mb-1">Run Individual Test</div>
            {foreach discoverable_tests as dt}
            <button onclick="wbRunTests('{dt.path | esc_js}')" class="kernel-btn kernel-btn-outline text-xs mr-1 mb-1 wb-btn-test" title="Run {dt.path | esc_attr}">{dt.module}/{dt.file}</button>
            {/foreach}
        </div>
        {/if}

        <div id="wb-test-output"></div>
    </div>

    <!-- ──────────── TEST RESULTS ──────────── -->
    <div class="panel">
        <h2 class="text-sm font-semibold text-slate-700 mb-4">Test Results</h2>
        {if test_results | count > 0}
        <table class="data w-full">
            <thead>
                <tr>
                    <th>Suite</th>
                    <th>Passed</th>
                    <th>Failed</th>
                    <th>Gaps</th>
                    <th>Time</th>
                    <th>Finished</th>
                    <th>View</th>
                </tr>
            </thead>
            <tbody>
                {foreach test_results as tr}
                <tr>
                    <td class="font-medium text-xs">{tr.suite}</td>
                    <td class="text-green-700 font-semibold">{tr.passed}</td>
                    <td class="{if tr.failed > 0}text-red-700 font-semibold{else}text-gray-500{/if}">{tr.failed}</td>
                    <td class="text-gray-500">{tr.gaps}</td>
                    <td class="text-xs text-gray-500">{tr.elapsed}ms</td>
                    <td class="text-xs text-gray-500">{tr.finished}</td>
                    <td>
                        <button onclick="wbViewResult('{tr.suite}')" class="kernel-btn kernel-btn-outline text-xs">View</button>
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
        {else}
        <div class="empty-state">
            <h3>No Test Results</h3>
            <p>Run tests using the Test Runner above to generate results.</p>
        </div>
        {/if}
        <div id="wb-result-detail" class="mt-3"></div>
    </div>

</div>
{/block}
