{extends "modules/academic-similarity/layouts/admin"}

{block "title"}Academic Similarity Dashboard{/block}

{block "content"}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Academic Similarity Dashboard</h1>

    {if processed_now !== null}
    <div class="mb-6 rounded-lg border {if failed_now|default:0 > 0}border-yellow-200 bg-yellow-50 text-yellow-900{else}border-green-200 bg-green-50 text-green-900{/if} px-4 py-3 text-sm">
        Processed {processed_now|default:0} pending submission(s). Failed {failed_now|default:0}.
    </div>
    {/if}

    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4 mb-8">
        <div class="bg-white rounded-lg shadow p-4 border border-gray-200">
            <p class="text-sm text-gray-500 uppercase tracking-wide">Total Submissions</p>
            <p class="text-3xl font-bold text-gray-900">{total_submissions|default:0}</p>
        </div>
        <div class="bg-white rounded-lg shadow p-4 border border-yellow-200">
            <p class="text-sm text-yellow-600 uppercase tracking-wide">Pending</p>
            <p class="text-3xl font-bold text-yellow-600">{pending_submissions|default:0}</p>
            {if pending_submissions|default:0 > 0}
            <form method="POST" action="/admin/academic-similarity/submissions/process-all-pending" class="mt-3">
                <input type="hidden" name="_token" value="{csrf_token}">
                <button type="submit" class="w-full text-xs bg-yellow-100 hover:bg-yellow-200 text-yellow-800 font-medium py-2 px-3 rounded-lg transition-colors">
                    Process {pending_submissions} Pending
                </button>
            </form>
            {/if}
        </div>
        <div class="bg-white rounded-lg shadow p-4 border border-green-200">
            <p class="text-sm text-green-600 uppercase tracking-wide">Processed</p>
            <p class="text-3xl font-bold text-green-600">{processed_submissions|default:0}</p>
        </div>
        <div class="bg-white rounded-lg shadow p-4 border border-blue-200">
            <p class="text-sm text-blue-600 uppercase tracking-wide">Sources</p>
            <p class="text-3xl font-bold text-blue-600">{total_sources|default:0}</p>
        </div>
        <div class="bg-white rounded-lg shadow p-4 border border-purple-200">
            <p class="text-sm text-purple-600 uppercase tracking-wide">Matches</p>
            <p class="text-3xl font-bold text-purple-600">{total_matches|default:0}</p>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Recent Submissions</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-gray-50">
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Title</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Status</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Words</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Submitted</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {if recent_submissions|count > 0}
                    {for sub in recent_submissions}
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 font-medium text-gray-900">{sub.submission_title}</td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                {if sub.status == 'processed'}bg-green-100 text-green-800
                                {else if sub.status == 'processing'}bg-yellow-100 text-yellow-800
                                {else if sub.status == 'failed'}bg-red-100 text-red-800
                                {else}bg-gray-100 text-gray-800{/if}">
                                {sub.status|default:pending}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-gray-500">{sub.word_count|default:0}</td>
                        <td class="px-6 py-4 text-gray-500">{sub.created_at}</td>
                        <td class="px-6 py-4">
                            <a href="/admin/academic-similarity/submissions/{sub.submission_id}" class="text-brand-600 hover:text-brand-900 font-medium mr-3">View</a>
                            {if sub.status == 'pending'}
                            <form method="POST" action="/api/v1/academic-similarity/submissions/{sub.submission_id}/process" class="inline">
                                <input type="hidden" name="_token" value="{csrf_token}">
                                <button type="submit" class="text-yellow-700 hover:text-yellow-900 font-medium">Process</button>
                            </form>
                            {/if}
                        </td>
                    </tr>
                    {/for}
                    {else}
                    <tr>
                        <td colspan="5" class="px-6 py-8 text-center text-gray-500">No submissions yet. <a href="/admin/academic-similarity/submissions" class="text-brand-600 hover:underline">Upload your first submission</a>.</td>
                    </tr>
                    {/if}
                </tbody>
            </table>
        </div>
    </div>
</div>
{/block}
