{extends "modules/academic-similarity/layouts/admin"}

{block "title"}Collection{/block}

{block "content"}
<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
        <a href="/admin/academic-similarity/collections" class="text-brand-600 hover:text-brand-900 text-sm">&larr; Back to Collections</a>
    </div>

    <div class="bg-white rounded-lg shadow border border-gray-200 p-6">
        <h1 class="text-2xl font-bold text-gray-900 mb-6">{if collection.id}Edit Collection{else}New Collection{/if}</h1>

        {if error}
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{error}</div>
        {/if}

        <form method="POST" action="/api/v1/academic-similarity/collections" class="space-y-5">
            <input type="hidden" name="_token" value="{csrf_token}">
            <input type="hidden" name="institution_id" value="{collection.institution_id|default:0}">

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Name</label>
                <input type="text" name="name" value="{collection.collection_name}" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                <textarea name="description" rows="5" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">{collection.description}</textarea>
            </div>

            <div class="flex justify-end gap-3">
                <a href="/admin/academic-similarity/collections" class="px-4 py-2 rounded-lg border border-gray-300 text-sm text-gray-700">Cancel</a>
                <button type="submit" class="px-4 py-2 rounded-lg bg-brand-600 text-white text-sm font-medium hover:bg-brand-700">Save Collection</button>
            </div>
        </form>
    </div>
</div>
{/block}
