{extends "modules/academic-similarity/layouts/admin"}

{block "title"}Collections{/block}

{block "content"}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Collections</h1>
        <a href="/admin/academic-similarity/collections/new" class="bg-brand-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-brand-700">New Collection</a>
    </div>

    <div class="bg-white rounded-lg shadow border border-gray-200">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-gray-50">
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Name</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Description</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Sources</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Type</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Created</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {if collections|count > 0}
                    {for col in collections}
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 font-medium text-gray-900">{col.collection_name}</td>
                        <td class="px-6 py-4 text-gray-500 max-w-xs truncate">{col.description|default:—}</td>
                        <td class="px-6 py-4 text-gray-500">{col.source_count|default:0}</td>
                        <td class="px-6 py-4"><span class="text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded">{col.collection_type|default:general}</span></td>
                        <td class="px-6 py-4 text-gray-500">{col.created_at}</td>
                        <td class="px-6 py-4">
                            <a href="/admin/academic-similarity/collections/{col.collection_id}" class="text-brand-600 hover:text-brand-900 font-medium mr-3">View</a>
                            <a href="/admin/academic-similarity/collections/{col.collection_id}/edit" class="text-gray-500 hover:text-gray-700 font-medium mr-3">Edit</a>
                            <a href="/admin/academic-similarity/sources?collection_id={col.collection_id}" class="text-gray-500 hover:text-gray-700 font-medium">Sources</a>
                        </td>
                    </tr>
                    {/for}
                    {else}
                    <tr>
                        <td colspan="6" class="px-6 py-8 text-center text-gray-500">No collections yet. <a href="/admin/academic-similarity/collections/new" class="text-brand-600 hover:underline">Create your first collection</a>.</td>
                    </tr>
                    {/if}
                </tbody>
            </table>
        </div>
    </div>
</div>
{/block}
