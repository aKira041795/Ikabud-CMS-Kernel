{extends "modules/academic-similarity/layouts/admin"}

{block "title"}Submission Detail{/block}

{block "content"}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
        <a href="/admin/academic-similarity/submissions" class="text-brand-600 hover:text-brand-900 text-sm">&larr; Back to Submissions</a>
    </div>

    <div class="bg-white rounded-lg shadow border border-gray-200 p-6 mb-6">
        <div class="flex justify-between items-start">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">{submission.submission_title}</h1>
                <p class="text-gray-500 mt-1">by {submission.author_name} ({submission.author_identifier})</p>
            </div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium
                {if submission.status == 'processed'}bg-green-100 text-green-800
                {else if submission.status == 'processing'}bg-yellow-100 text-yellow-800
                {else if submission.status == 'failed'}bg-red-100 text-red-800
                {else}bg-gray-100 text-gray-800{/if}">
                {submission.status}
            </span>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
            <div><span class="text-sm text-gray-500">Words</span><p class="font-semibold">{submission.word_count|default:0}</p></div>
            <div><span class="text-sm text-gray-500">File</span><p class="font-semibold">{submission.original_filename}</p></div>
            <div><span class="text-sm text-gray-500">Type</span><p class="font-semibold">{submission.source_type}</p></div>
            <div><span class="text-sm text-gray-500">Submitted</span><p class="font-semibold">{submission.submitted_at}</p></div>
        </div>

        {if submission.status == 'pending'}
        <div class="mt-6">
            <form method="POST" action="/api/v1/academic-similarity/submissions/{submission.submission_id}/process">
                <input type="hidden" name="_token" value="{csrf_token}">
                <button type="submit" class="bg-brand-600 text-white px-6 py-2 rounded-lg text-sm font-medium hover:bg-brand-700">Process Submission</button>
            </form>
        </div>
        {/if}

        <div class="mt-6 rounded-lg border border-gray-200 bg-gray-50 p-4">
            <div class="flex items-center justify-between gap-4">
                <div>
                    <p class="text-sm font-semibold text-gray-900">AI Internet Check</p>
                    <p class="text-sm text-gray-600">Discovers bounded public sources, imports retrieved evidence, then lets AISS compare against those sources.</p>
                    {if internet_run.id}
                    <p class="text-xs text-gray-500 mt-2">Last run: {internet_run.status} · candidates {internet_run.candidate_count|default:0} · imported {internet_run.imported_count|default:0}</p>
                    {if internet_run.disclosure}<p class="text-xs text-gray-500 mt-1">{internet_run.disclosure}</p>{/if}
                    {/if}
                </div>
                {if internet_check_enabled}
                <form method="POST" action="/api/v1/academic-similarity/submissions/{submission.submission_id}/internet-check">
                    <input type="hidden" name="_token" value="{csrf_token}">
                    <button type="submit" class="bg-gray-900 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-800">Run Internet Check</button>
                </form>
                {else}
                <span class="text-xs rounded-full bg-yellow-100 text-yellow-800 px-3 py-1">Disabled in settings</span>
                {/if}
            </div>
        </div>

        {if submission.processing_error}
        <div class="mt-4 p-4 bg-red-50 border border-red-200 rounded-lg">
            <p class="text-sm text-red-700"><strong>Error:</strong> {submission.processing_error}</p>
        </div>
        {/if}

        {if submission.raw_similarity_score !== null}
        <div class="mt-6 flex gap-4">
            <div class="bg-gray-50 rounded-lg p-4 text-center">
                <p class="text-2xl font-bold">{submission.raw_similarity_score}%</p>
                <p class="text-xs text-gray-500 uppercase">Raw Score</p>
            </div>
            <div class="bg-green-50 rounded-lg p-4 text-center">
                <p class="text-2xl font-bold">{submission.adjusted_similarity_score}%</p>
                <p class="text-xs text-gray-500 uppercase">Adjusted Score</p>
            </div>
        </div>
        {/if}
    </div>

    {if matches|count > 0}
    <div class="bg-white rounded-lg shadow border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Matched Passages ({matches|count})</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-gray-50">
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Type</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Words</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Confidence</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Status</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {for match in matches}
                    <tr class="{if match.is_excluded}opacity-50{/if}">
                        <td class="px-6 py-4">{match.match_type}</td>
                        <td class="px-6 py-4">{match.matched_word_count}</td>
                        <td class="px-6 py-4">{match.match_confidence * 100}%</td>
                        <td class="px-6 py-4">{if match.is_excluded}Excluded{else}Active{/if}</td>
                        <td class="px-6 py-4">
                            {if !match.is_excluded}
                            <button onclick="excludeMatch({match.id})" class="text-red-600 hover:text-red-900 text-sm">Exclude</button>
                            {/if}
                        </td>
                    </tr>
                    {/for}
                </tbody>
            </table>
        </div>
    </div>
    {/if}

    {if report}
    <div class="mt-6">
        <a href="/admin/academic-similarity/reports/{report.id}" class="bg-brand-600 text-white px-6 py-2 rounded-lg text-sm font-medium hover:bg-brand-700">View Full Report</a>
        <a href="/admin/academic-similarity/reports/{report.id}/download" class="ml-3 bg-gray-100 text-gray-700 px-6 py-2 rounded-lg text-sm font-medium hover:bg-gray-200">Download Report</a>
    </div>
    {/if}
</div>
{/block}
