{extends "modules/academic-similarity/layouts/admin"}

{block "title"}Submission Detail{/block}

{block "content"}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
        <a href="/admin/academic-similarity/submissions" class="text-brand-600 hover:text-brand-900 text-sm">&larr; Back to Submissions</a>
    </div>

    {if internet_check_query == 'failed'}
    <div class="mb-6 rounded-lg border border-red-200 bg-red-50 text-red-900 px-4 py-3 text-sm">
        <strong>Internet check failed.</strong> The internet search could not complete. Check the error log for details or try again.
    </div>
    {else if internet_check_query == 'queued'}
    <div class="mb-6 rounded-lg border border-blue-200 bg-blue-50 text-blue-900 px-4 py-3 text-sm">
        Internet check queued — will run in the background. Results will appear when processing completes.
    </div>
    {else if internet_check_query == 'completed_partial'}
    <div class="mb-6 rounded-lg border border-yellow-200 bg-yellow-50 text-yellow-900 px-4 py-3 text-sm">
        Internet check completed. Some sources could not be imported — see details below.
    </div>
    {else if internet_check_query != ''}
    <div class="mb-6 rounded-lg border border-green-200 bg-green-50 text-green-900 px-4 py-3 text-sm">
        Internet check completed with status: <strong>{internet_check_query}</strong>.
    </div>
    {/if}

    {if process_query == 'failed'}
    <div class="mb-6 rounded-lg border border-red-200 bg-red-50 text-red-900 px-4 py-3 text-sm">
        <strong>Processing failed.</strong> The similarity analysis could not complete. Check the error details below or try again.
    </div>
    {else if process_query == 'processed'}
    <div class="mb-6 rounded-lg border border-green-200 bg-green-50 text-green-900 px-4 py-3 text-sm">
        Submission processed successfully.
    </div>
    {/if}

    <div class="bg-white rounded-lg shadow border border-gray-200 p-6 mb-6">
        <div class="flex justify-between items-start">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">{submission.submission_title}</h1>
                <p class="text-gray-500 mt-1">by {submission.author_name} ({submission.author_identifier})</p>
            </div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium
                {if submission.status == 'processed'}bg-green-100 text-green-800
                {else if submission.status == 'processing'}bg-yellow-100 text-yellow-800
                {else if submission.status == 'failed'}bg-red-100 text-red-800
                {else}bg-gray-100 text-gray-800{/if}">
                {submission.status}
            </span>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-6">
            <div><span class="text-sm text-gray-500">Words</span><p class="font-semibold">{submission.word_count|default:0}</p></div>
            <div><span class="text-sm text-gray-500">File</span><p class="font-semibold">{submission.original_filename}</p></div>
            <div><span class="text-sm text-gray-500">Type</span><p class="font-semibold">{submission.source_type}</p></div>
            <div><span class="text-sm text-gray-500">Submitted</span><p class="font-semibold">{submission.submitted_at}</p></div>
        </div>

        {if submission.status == 'pending' or submission.status == 'processing' or submission.status == 'failed'}
        <div class="mt-6">
            <form method="POST" action="/api/v1/academic-similarity/submissions/{submission.submission_id}/process">
                <input type="hidden" name="_token" value="{csrf_token}">
                <button type="submit" class="bg-brand-600 text-white px-6 py-2 rounded-lg text-sm font-medium hover:bg-brand-700">
                    {if submission.status == 'processing'}Restart Processing{else}Process Submission{/if}
                </button>
            </form>
        </div>
        {/if}

        <div class="mt-6 rounded-lg border border-gray-200 bg-gray-50 p-4">
            <div class="flex items-center justify-between gap-4">
                <div>
                    <p class="text-sm font-semibold text-gray-900">AI Internet Check</p>
                    <p class="text-sm text-gray-600">Discovers bounded public sources, imports retrieved evidence, then lets AISS compare against those sources.</p>
                    {if internet_run.id}
                    <p class="text-xs text-gray-500 mt-2">
                        {if internet_run.status == 'completed'}
                            <span class="inline-block w-2 h-2 bg-green-500 rounded-full mr-1"></span>
                        {else if internet_run.status == 'completed_partial'}
                            <span class="inline-block w-2 h-2 bg-yellow-400 rounded-full mr-1"></span>
                        {else if internet_run.status == 'completed_none'}
                            <span class="inline-block w-2 h-2 bg-orange-400 rounded-full mr-1"></span>
                        {else if internet_run.status == 'queued'}
                            <span class="inline-block w-2 h-2 bg-blue-400 rounded-full mr-1 animate-pulse"></span>
                        {else if internet_run.status == 'skipped'}
                            <span class="inline-block w-2 h-2 bg-gray-400 rounded-full mr-1"></span>
                        {else if internet_run.status == 'failed'}
                            <span class="inline-block w-2 h-2 bg-red-500 rounded-full mr-1"></span>
                        {/if}
                        {if internet_run.status == 'completed'}
                            All {internet_run.imported_count|default:0} source(s) imported.
                        {else if internet_run.status == 'completed_partial'}
                            {internet_run.imported_count|default:0} of {internet_run.candidate_count|default:0} sources imported ({internet_run.candidate_count - internet_run.imported_count} not importable).
                        {else if internet_run.status == 'completed_none'}
                            Found {internet_run.candidate_count|default:0} candidate(s) but none were importable.
                        {else if internet_run.status == 'queued'}                            <span class="inline-block w-2 h-2 bg-blue-400 rounded-full mr-1 animate-pulse"></span>                            Internet discovery queued — will run in background.
                        {else}
                            {internet_run.status}: candidates {internet_run.candidate_count|default:0} · imported {internet_run.imported_count|default:0}
                        {/if}
                    </p>
                    {if internet_run.disclosure}<p class="text-xs text-gray-500 mt-1">{internet_run.disclosure}</p>{/if}
                    {/if}
                </div>
                {if internet_check_enabled}
                <form method="POST" action="/api/v1/academic-similarity/submissions/{submission.submission_id}/internet-check">
                    <input type="hidden" name="_token" value="{csrf_token}">
                    <button type="submit" class="bg-gray-900 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-800">Run Internet Check</button>
                </form>
                {else}
                <span class="text-xs rounded-full bg-yellow-100 text-yellow-800 px-3 py-1">Disabled in settings</span>
                {/if}
            </div>
        </div>

        {if submission.processing_error}
        <div class="mt-4 p-4 bg-red-50 border border-red-200 rounded-lg">
            <p class="text-sm text-red-700"><strong>Error:</strong> {submission.processing_error}</p>
        </div>
        {/if}

        {if submission.raw_similarity_score !== null}
        <div class="mt-6 flex gap-4">
            <div class="bg-gray-50 rounded-lg p-4 text-center">
                <p class="text-2xl font-bold">{submission.raw_similarity_score}%</p>
                <p class="text-xs text-gray-500 uppercase">Raw Score</p>
            </div>
            <div class="bg-green-50 rounded-lg p-4 text-center">
                <p class="text-2xl font-bold">{submission.adjusted_similarity_score}%</p>
                <p class="text-xs text-gray-500 uppercase">Adjusted Score</p>
            </div>
        </div>
        {/if}
    </div>

    {if matches|count > 0}
    <div class="bg-white rounded-lg shadow border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Matched Passages ({matches|count})</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-gray-50">
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Type</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Words</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Confidence</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Status</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {for match in matches}
                    <tr class="{if match.is_excluded}opacity-50{/if}">
                        <td class="px-6 py-4">{match.match_type}</td>
                        <td class="px-6 py-4">{match.matched_word_count}</td>
                        <td class="px-6 py-4">{match.match_confidence * 100}%</td>
                        <td class="px-6 py-4">{if match.is_excluded}Excluded{else}Active{/if}</td>
                        <td class="px-6 py-4">
                            {if !match.is_excluded}
                            <button onclick="excludeMatch({match.id})" class="text-red-600 hover:text-red-900 text-sm">Exclude</button>
                            {/if}
                        </td>
                    </tr>
                    {/for}
                </tbody>
            </table>
        </div>
    </div>
    {/if}

    {if assessment_query == 'generated'}
    <div class="mt-6 p-4 bg-green-50 border border-green-200 rounded-lg">
        <p class="text-sm text-green-800">Assessment bundle generated. The profile below is reviewer-assist evidence; it is not an authenticity, plagiarism, novelty, or pass/fail decision.</p>
    </div>
    {else if assessment_query == 'failed'}
    <div class="mt-6 p-4 bg-red-50 border border-red-200 rounded-lg">
        <p class="text-sm text-red-800">Assessment bundle generation failed. No partial run was saved.</p>
    </div>
    {/if}

    <div id="assessment" class="mt-6 bg-white rounded-lg shadow border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 class="text-lg font-semibold text-gray-900">Document Assessment</h2>
                <p class="text-xs text-gray-500 mt-1">Independent evidence profiles: integrity, relevance, contribution, and reviewer suggestions. No machine verdicts.</p>
            </div>
            <form method="POST" action="/api/v1/academic-similarity/submissions/{submission.submission_id}/assessment">
                <input type="hidden" name="_token" value="{csrf_token}">
                <button type="submit" class="bg-gray-800 text-white px-5 py-2 rounded-lg text-sm font-medium hover:bg-gray-900">
                    {if assessment and assessment.ok}Regenerate Assessment{else}Generate Assessment{/if}
                </button>
            </form>
        </div>

        {if !assessment or !assessment.ok}
        <div class="px-6 py-8 text-center text-gray-500">
            No assessment run exists for this manuscript yet. Generate one to inspect document structure, evidence profiles, and reviewer suggestions.
        </div>
        {else}
        <div class="px-6 py-5">
            <div class="flex flex-wrap gap-2 mb-5">
                {for dim, level in assessment.maturity}
                <span class="px-2.5 py-1 rounded-full text-xs font-medium
                    {if level == 'stable'}bg-green-100 text-green-800
                    {else if level == 'beta'}bg-blue-100 text-blue-800
                    {else if level == 'experimental'}bg-purple-100 text-purple-800
                    {else if level == 'partial'}bg-amber-100 text-amber-800
                    {else if level == 'unavailable'}bg-gray-100 text-gray-600
                    {else}bg-gray-100 text-gray-600{/if}">
                    {dim|replace:"_":" "}: {level}
                </span>
                {/for}
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-5">
                <div class="bg-gray-50 rounded-lg p-3">
                    <p class="text-xs text-gray-500 uppercase">Run</p>
                    <p class="font-semibold">#{assessment.assessment_run_id}</p>
                </div>
                <div class="bg-gray-50 rounded-lg p-3">
                    <p class="text-xs text-gray-500 uppercase">Coverage</p>
                    <p class="font-semibold">{assessment.coverage.status|default:'unknown'}</p>
                </div>
                <div class="bg-gray-50 rounded-lg p-3">
                    <p class="text-xs text-gray-500 uppercase">Imported sources</p>
                    <p class="font-semibold">{assessment.coverage.imported_count|default:0} / {assessment.coverage.candidate_count|default:0}</p>
                </div>
                <div class="bg-gray-50 rounded-lg p-3">
                    <p class="text-xs text-gray-500 uppercase">Extracted claims</p>
                    <p class="font-semibold">{assessment.structure.claims|length|default:0}</p>
                </div>
            </div>

            {if assessment.limitations|default:[]|length > 0}
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-5">
                <p class="text-sm font-semibold text-yellow-800">Limitations &amp; Cautions</p>
                <ul class="mt-1 list-disc list-inside text-xs text-yellow-700">
                    {for limitation in assessment.limitations}
                    <li>{limitation}</li>
                    {/for}
                </ul>
            </div>
            {/if}

            {* Structure: sections *}
            <h3 class="text-sm font-semibold text-gray-900 mb-2">Document Structure</h3>
            {if assessment.structure.sections|default:[]|length > 0}
            <div class="overflow-x-auto border border-gray-200 rounded-lg mb-5">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-gray-50 text-left">
                            <th class="px-4 py-2 text-xs font-medium text-gray-500 uppercase">Section</th>
                            <th class="px-4 py-2 text-xs font-medium text-gray-500 uppercase">Confidence</th>
                            <th class="px-4 py-2 text-xs font-medium text-gray-500 uppercase">Maturity</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {for section in assessment.structure.sections}
                        <tr>
                            <td class="px-4 py-2">{section.heading|default:section.section_key}</td>
                            <td class="px-4 py-2">{(section.extraction_confidence * 100)|round}%</td>
                            <td class="px-4 py-2 text-xs">{section.maturity|default:'beta'}</td>
                        </tr>
                        {/for}
                    </tbody>
                </table>
            </div>
            {else}
            <p class="text-xs text-gray-500 mb-5">No sections detected. Structure extraction may require a reviewer-corrected version.</p>
            {/if}

            {* Claims *}
            {if assessment.structure.claims|default:[]|length > 0}
            <details class="border border-gray-200 rounded-lg mb-5">
                <summary class="px-4 py-3 cursor-pointer text-sm font-semibold text-gray-900 hover:bg-gray-50">
                    Extracted Research Claims ({assessment.structure.claims|length})
                </summary>
                <div class="px-4 pb-4 space-y-2">
                    {for claim in assessment.structure.claims}
                    <div class="p-3 bg-gray-50 rounded text-sm">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-xs font-medium uppercase text-gray-500">{claim.claim_type|replace:"_":" "}</span>
                            <span class="text-xs text-gray-400">offset {claim.start_offset}–{claim.end_offset}</span>
                        </div>
                        <p class="mt-1 text-gray-800">{claim.claim_text}</p>
                    </div>
                    {/for}
                </div>
            </details>
            {/if}

            {* Evidence *}
            {if assessment.evidence|default:[]|length > 0}
            <details class="border border-gray-200 rounded-lg mb-5">
                <summary class="px-4 py-3 cursor-pointer text-sm font-semibold text-gray-900 hover:bg-gray-50">
                    Evidence Items ({assessment.evidence|length})
                </summary>
                <div class="px-4 pb-4 space-y-2">
                    {for item in assessment.evidence}
                    <div class="p-3 bg-gray-50 rounded text-sm">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-xs font-medium uppercase text-gray-500">{item.dimension|replace:"_":" "}</span>
                            <span class="text-xs text-gray-400">{item.status}</span>
                        </div>
                        <p class="mt-1 text-gray-800">{item.rationale}</p>
                        {if item.limitations|default:[]|length > 0}
                        <ul class="mt-1 list-disc list-inside text-xs text-gray-500">
                            {for lim in item.limitations}
                            <li>{lim}</li>
                            {/for}
                        </ul>
                        {/if}
                    </div>
                    {/for}
                </div>
            </details>
            {/if}

            {* Suggestions *}
            {if assessment.suggestions|default:[]|length > 0}
            <h3 class="text-sm font-semibold text-gray-900 mb-2">Reviewer Suggestions ({assessment.suggestions|length})</h3>
            <div class="space-y-3">
                {for suggestion in assessment.suggestions}
                <div class="border border-gray-200 rounded-lg p-4">
                    <div class="flex items-center justify-between gap-2">
                        <p class="text-sm font-semibold text-gray-900">{suggestion.title}</p>
                        <span class="px-2 py-0.5 rounded-full text-xs font-medium
                            {if suggestion.priority == 'high'}bg-red-100 text-red-800
                            {else if suggestion.priority == 'medium'}bg-amber-100 text-amber-800
                            {else}bg-gray-100 text-gray-700{/if}">
                            {suggestion.priority}
                        </span>
                    </div>
                    <p class="text-sm text-gray-600 mt-1">{suggestion.rationale}</p>
                    <div class="mt-2 flex flex-wrap gap-2 text-xs text-gray-500">
                        <span class="bg-gray-100 rounded px-2 py-0.5">Action: {suggestion.reviewer_action|default:'verify'}</span>
                        <span class="bg-gray-100 rounded px-2 py-0.5">Category: {suggestion.category|default:'—'}</span>
                        <span class="bg-gray-100 rounded px-2 py-0.5">Uncertainty: {suggestion.uncertainty|default:'—'}</span>
                        <span class="bg-gray-100 rounded px-2 py-0.5">Maturity: {suggestion.maturity|default:'beta'}</span>
                    </div>
                    {if suggestion.limitations|default:[]|length > 0}
                    <ul class="mt-2 list-disc list-inside text-xs text-gray-500">
                        {for lim in suggestion.limitations}
                        <li>{lim}</li>
                        {/for}
                    </ul>
                    {/if}
                </div>
                {/for}
            </div>
            {else}
            <p class="text-xs text-gray-500">No suggestions generated for this manuscript yet.</p>
            {/if}
        </div>
        {/if}
    </div>

    {if report}
    <div class="mt-6">
        <a href="/admin/academic-similarity/reports/{report.id}" class="bg-brand-600 text-white px-6 py-2 rounded-lg text-sm font-medium hover:bg-brand-700">View Full Report</a>
        <a href="/admin/academic-similarity/reports/{report.id}/download" class="ml-3 bg-gray-100 text-gray-700 px-6 py-2 rounded-lg text-sm font-medium hover:bg-gray-200">Download Report</a>
    </div>
    {/if}
</div>
{/block}

{block "scripts"}
<script>
function excludeMatch(matchId) {
    if (!confirm('Exclude this match from the similarity score?')) return;
    fetch('/api/v1/academic-similarity/reviews/' + matchId + '/exclude', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json'
        },
        body: '_token=' + encodeURIComponent('{csrf_token}')
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.ok) {
            location.reload();
        } else {
            alert('Failed to exclude match: ' + (data.error || 'Unknown error'));
        }
    })
    .catch(function(e) {
        alert('Network error: ' + e.message);
    });
}
</script>
{/block}
