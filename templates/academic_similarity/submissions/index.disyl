{extends "modules/academic-similarity/layouts/admin"}

{block "title"}Submissions{/block}

{block "content"}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Submissions</h1>
        <a href="/admin/academic-similarity/submissions/new" class="bg-brand-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-brand-700">New Submission</a>
    </div>

    <div class="bg-white rounded-lg shadow border border-gray-200">
        <div class="p-4 border-b border-gray-200">
            <form method="GET" class="flex gap-4">
                <input type="text" name="search" value="{search_query}" placeholder="Search by title or author..." class="flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm">
                <select name="status" class="rounded-lg border border-gray-300 px-3 py-2 text-sm">
                    <option value="">All Status</option>
                    <option value="pending" {if current_status == 'pending'}selected{/if}>Pending</option>
                    <option value="processing" {if current_status == 'processing'}selected{/if}>Processing</option>
                    <option value="processed" {if current_status == 'processed'}selected{/if}>Processed</option>
                    <option value="failed" {if current_status == 'failed'}selected{/if}>Failed</option>
                </select>
                <button type="submit" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-200">Filter</button>
            </form>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-gray-50">
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Title</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Author</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Status</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Score</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Words</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Submitted</th>
                        <th class="px-6 py-3 text-left font-medium text-gray-500 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {if submissions|count > 0}
                    {for sub in submissions}
                    <tr class="hover:bg-gray-50">
                        <td class="px-6 py-4 font-medium text-gray-900">{sub.submission_title}</td>
                        <td class="px-6 py-4 text-gray-600">{sub.author_name}</td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                {if sub.status == 'processed'}bg-green-100 text-green-800
                                {else if sub.status == 'processing'}bg-yellow-100 text-yellow-800
                                {else if sub.status == 'failed'}bg-red-100 text-red-800
                                {else}bg-gray-100 text-gray-800{/if}">
                                {sub.status}
                            </span>
                        </td>
                        <td class="px-6 py-4">{sub.raw_similarity_score}{if sub.raw_similarity_score !== null}%{/if}</td>
                        <td class="px-6 py-4 text-gray-500">{sub.word_count|default:0}</td>
                        <td class="px-6 py-4 text-gray-500">{sub.submitted_at}</td>
                        <td class="px-6 py-4">
                            <a href="/admin/academic-similarity/submissions/{sub.submission_id}" class="text-brand-600 hover:text-brand-900 font-medium mr-3">View</a>
                            {if sub.status == 'pending'}
                            <form method="POST" action="/api/v1/academic-similarity/submissions/{sub.submission_id}/process" class="inline">
                                <input type="hidden" name="_token" value="{csrf_token}">
                                <button type="submit" class="text-yellow-700 hover:text-yellow-900 font-medium mr-3">Process</button>
                            </form>
                            {/if}
                            <a href="/admin/academic-similarity/reports?submission_id={sub.submission_id}" class="text-brand-600 hover:text-brand-900 font-medium">Report</a>
                        </td>
                    </tr>
                    {/for}
                    {else}
                    <tr>
                        <td colspan="7" class="px-6 py-8 text-center text-gray-500">No submissions found.</td>
                    </tr>
                    {/if}
                </tbody>
            </table>
        </div>
    </div>
</div>
{/block}
