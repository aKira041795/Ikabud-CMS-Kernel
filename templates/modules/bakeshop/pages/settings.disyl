{extends "modules/bakeshop/layouts/app.disyl"}

{block head}
<style>
    .bakeshop-settings-shell { display: grid; gap: 20px; }
    .bakeshop-settings-header { display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap; }
    .bakeshop-settings-header h2 { margin: 0 0 6px; font-size: var(--font-size-h2); }
    .bakeshop-settings-header p { margin: 0; color: var(--text-muted); max-width: 56rem; }
    .bakeshop-settings-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .bakeshop-settings-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 2px;
        border: 1px solid #1d4ed8;
        background: #2563eb;
        color: #ffffff;
        padding: 10px 16px;
        text-decoration: none;
        font-size: 0.92rem;
        cursor: pointer;
    }
    .bakeshop-settings-button:hover { background: #1d4ed8; }
    .bakeshop-settings-button.secondary {
        background: #fff;
        color: #111827;
        border-color: #d1d5db;
    }
    .bakeshop-settings-button.danger {
        background: #dc2626;
        border-color: #b91c1c;
        color: #ffffff;
    }
    .bakeshop-settings-button.danger:hover {
        background: #b91c1c;
    }
    .bakeshop-settings-banner {
        display: none;
        padding: 14px 16px;
        border-radius: 14px;
        border: 1px solid transparent;
    }
    .bakeshop-settings-banner.show { display: block; }
    .bakeshop-settings-banner.ok { background: #eff6ff; border-color: #bfdbfe; color: #1d4ed8; }
    .bakeshop-settings-banner.error { background: #fff3f2; border-color: #fecaca; color: #991b1b; }
    .bakeshop-settings-panel {
        border: 1px solid var(--border-color);
        border-radius: 14px;
        background: var(--surface-color, #fff);
        overflow: hidden;
        box-shadow: 0 14px 32px rgba(37, 99, 235, 0.05);
    }
    .bakeshop-settings-panel-head {
        padding: 18px 20px 12px;
        border-bottom: 1px solid color-mix(in srgb, var(--border-color) 85%, transparent);
    }
    .bakeshop-settings-panel-head h3 { margin: 0 0 6px; }
    .bakeshop-settings-panel-head p { margin: 0; color: var(--text-muted); }
    .bakeshop-settings-panel-body { padding: 18px 20px 20px; display: grid; gap: 16px; }
    .bakeshop-settings-table { width: 100%; border-collapse: collapse; }
    .bakeshop-settings-table th,
    .bakeshop-settings-table td { padding: 12px 14px; border-bottom: 1px solid var(--border-color); text-align: left; vertical-align: top; }
    .bakeshop-settings-table th { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); }
    .bakeshop-settings-table tr:last-child td { border-bottom: none; }
    .bakeshop-settings-note { color: var(--text-muted); font-size: 0.88rem; }
    .bakeshop-settings-actions-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
    .bakeshop-settings-check { width: 18px; height: 18px; }
    .bakeshop-settings-table-wrap { overflow: auto; }
    .bakeshop-settings-field-grid { display: grid; gap: 14px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bakeshop-settings-field { display: grid; gap: 6px; }
    .bakeshop-settings-field label { font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); }
    .bakeshop-settings-field input,
    .bakeshop-settings-field select,
    .bakeshop-settings-field textarea { width: 100%; border-radius: 2px; border: 1px solid #d1d5db; padding: 11px 12px; background: #fff; color: #111827; }
    .bakeshop-settings-field textarea { min-height: 104px; resize: vertical; }
    .bakeshop-settings-field.is-invalid input,
    .bakeshop-settings-field.is-invalid select,
    .bakeshop-settings-field.is-invalid textarea,
    .bakeshop-settings-logo-controls input.is-invalid { border-color: #dc2626; box-shadow: 0 0 0 1px rgba(220, 38, 38, 0.16); }
    .bakeshop-settings-field-error { display: none; font-size: 0.82rem; color: #b91c1c; line-height: 1.4; }
    .bakeshop-settings-field-error.show { display: block; }
    .bakeshop-settings-field.span-2 { grid-column: span 2; }
    .bakeshop-settings-field-grid.units { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .bakeshop-settings-row-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .bakeshop-settings-logo-shell { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 14px; align-items: start; }
    .bakeshop-settings-logo-preview {
        width: 110px;
        height: 110px;
        border-radius: 14px;
        border: 1px solid #d1d5db;
        background: #ffffff;
        color: #1d4ed8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.4rem;
        font-weight: 800;
        overflow: hidden;
    }
    .bakeshop-settings-logo-preview img { width: 100%; height: 100%; object-fit: contain; display: block; padding: 8px; }
    .bakeshop-settings-logo-controls { display: grid; gap: 10px; }
    .bakeshop-settings-logo-status { color: var(--text-muted); font-size: 0.88rem; }
    @media (max-width: 760px) {
        .bakeshop-settings-field-grid { grid-template-columns: 1fr; }
        .bakeshop-settings-field.span-2 { grid-column: auto; }
        .bakeshop-settings-logo-shell { grid-template-columns: 1fr; }
    }
</style>
{/block}

{block content}
<div class="bakeshop-settings-shell">
    <div class="bakeshop-settings-header">
        <div>
            <p>Use the panels below to manage access, store branding, print defaults, and unit setup without returning to the operations workspace.</p>
        </div>
        <div class="bakeshop-settings-actions">
            <a class="bakeshop-settings-button secondary" href="{base_url}{workspace_overview_url}">Back to Workspace</a>
            <a class="bakeshop-settings-button secondary" href="{base_url}{workspace_account_url}">My Account</a>
        </div>
    </div>

    <div class="bakeshop-settings-banner" id="bakeshop-settings-banner"></div>

    <section class="bakeshop-settings-panel">
        <div class="bakeshop-settings-panel-head">
            <h3>Access Settings</h3>
            <p>Supervisor access is configurable here. Admin access remains fixed so this page cannot lock itself out of future settings changes.</p>
        </div>
        <div class="bakeshop-settings-panel-body">
            <form id="permissions-form">
                <table class="bakeshop-settings-table">
                    <thead>
                        <tr>
                            <th>Role</th>
                            <th>Read</th>
                            <th>Manage</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Admin</strong><div class="bakeshop-settings-note">Always enabled</div></td>
                            <td><input class="bakeshop-settings-check" type="checkbox" checked disabled></td>
                            <td><input class="bakeshop-settings-check" type="checkbox" checked disabled></td>
                        </tr>
                        <tr>
                            <td><strong>Supervisor</strong><div class="bakeshop-settings-note">Controls page read access and mutation access.</div></td>
                            <td><input class="bakeshop-settings-check" type="checkbox" name="supervisor_read" value="1" {if permission_matrix.supervisor.read}checked{/if} {if !can_manage_settings}disabled{/if}></td>
                            <td><input class="bakeshop-settings-check" type="checkbox" name="supervisor_manage" value="1" {if permission_matrix.supervisor.manage}checked{/if} {if !can_manage_settings}disabled{/if}></td>
                        </tr>
                    </tbody>
                </table>
                <div class="bakeshop-settings-actions-row" style="margin-top:16px;">
                    <span class="bakeshop-settings-note">{if can_manage_settings}Changes apply to future bakeshop requests immediately after saving.{else}You have bakeshop read access only. Settings changes require bakeshop.manage.{/if}</span>
                    {if can_manage_settings}
                    <button class="bakeshop-settings-button" type="submit">Save Access Settings</button>
                    {/if}
                </div>
            </form>
        </div>
    </section>

    <section class="bakeshop-settings-panel">
        <div class="bakeshop-settings-panel-head">
            <h3>Branding, Usage, and Print Defaults</h3>
            <p>Update the Bakeshop name, supporting description, optional logo, and the defaults used by workspace totals and the printable summary.</p>
        </div>
        <div class="bakeshop-settings-panel-body">
            <form id="display-settings-form">
                <div class="bakeshop-settings-field-grid">
                    <div class="bakeshop-settings-field">
                        <label for="store-name">Store Name</label>
                        <input id="store-name" name="store_name" maxlength="120" value="{settings.store_name}" {if !can_manage_settings}disabled{/if}>
                        <div class="bakeshop-settings-field-error" data-field-error="store_name"></div>
                    </div>
                    <div class="bakeshop-settings-field span-2">
                        <label for="store-logo-file">Upload Logo</label>
                        <input type="hidden" name="store_logo_url" value="{settings.store_logo_url}">
                        <div class="bakeshop-settings-logo-shell">
                            <div class="bakeshop-settings-logo-preview" id="store-logo-preview">{if settings.store_logo_url}<img src="{settings.store_logo_url}" alt="{settings.store_name} logo">{else}{brand_settings.store_initial}{/if}</div>
                            <div class="bakeshop-settings-logo-controls">
                                <input id="store-logo-file" name="store_logo_file" type="file" accept="image/*" {if !can_manage_settings}disabled{/if}>
                                <div class="bakeshop-settings-logo-status" id="store-logo-status">{if settings.store_logo_url}Current uploaded logo will stay in place until you choose a new one or switch back to the lettermark. Oversized raster logos are reduced to fit within {if brand_settings.store_logo_url}512{/if}512x512 before display.{else}No uploaded logo yet. The generated lettermark is currently in use. Oversized raster logos are reduced to fit within 512x512 before display.{/if}</div>
                                <div class="bakeshop-settings-field-error" data-field-error="store_logo_file"></div>
                                {if can_manage_settings}
                                <div class="bakeshop-settings-actions">
                                    <button class="bakeshop-settings-button secondary" type="button" id="store-logo-remove" {if !settings.store_logo_url}hidden{/if}>Use Lettermark</button>
                                </div>
                                {/if}
                            </div>
                        </div>
                    </div>
                    <div class="bakeshop-settings-field span-2">
                        <label for="store-description">Store Description</label>
                        <textarea id="store-description" name="store_description" maxlength="280" {if !can_manage_settings}disabled{/if}>{settings.store_description}</textarea>
                        <div class="bakeshop-settings-field-error" data-field-error="store_description"></div>
                    </div>
                    <div class="bakeshop-settings-field">
                        <label for="usage-decimal-places">Usage Decimal Places</label>
                        <input id="usage-decimal-places" name="usage_decimal_places" type="number" min="0" max="4" step="1" value="{settings.usage_decimal_places}" {if !can_manage_settings}disabled{/if}>
                        <div class="bakeshop-settings-field-error" data-field-error="usage_decimal_places"></div>
                    </div>
                    <div class="bakeshop-settings-field">
                        <label for="default-dr-coverage-days">Default DR Coverage Days</label>
                        <input id="default-dr-coverage-days" name="default_dr_coverage_days" type="number" min="1" max="31" step="1" value="{settings.default_dr_coverage_days}" {if !can_manage_settings}disabled{/if}>
                        <div class="bakeshop-settings-field-error" data-field-error="default_dr_coverage_days"></div>
                    </div>
                    <div class="bakeshop-settings-field">
                        <label for="product-recipe-status">Product Recipes</label>
                        <select id="product-recipe-status" name="product_recipe_status" {if !can_manage_settings}disabled{/if}>
                            <option value="active" {if settings.product_recipe_status == 'active'}selected{/if}>Activate Recipes</option>
                            <option value="inactive" {if settings.product_recipe_status == 'inactive'}selected{/if}>Deactivate Recipes</option>
                        </select>
                        <div class="bakeshop-settings-note">When deactivated, recipe maintenance is hidden in the workspace and production is locked to output-only until recipes are reactivated.</div>
                        <div class="bakeshop-settings-field-error" data-field-error="product_recipe_status"></div>
                    </div>
                    <div class="bakeshop-settings-field">
                        <label for="production-recipe-mode">Production Recipe Policy</label>
                        <select id="production-recipe-mode" name="production_recipe_mode" {if !can_manage_settings || settings.product_recipe_status != 'active'}disabled{/if}>
                            <option value="optional" {if settings.production_recipe_mode == 'optional'}selected{/if}>Recipe Optional</option>
                            <option value="required" {if settings.production_recipe_mode == 'required'}selected{/if}>Recipe Required</option>
                        </select>
                        <div class="bakeshop-settings-note">This policy applies only while Product Recipes is active.</div>
                        <div class="bakeshop-settings-field-error" data-field-error="production_recipe_mode"></div>
                    </div>
                    <div class="bakeshop-settings-field">
                        <label for="print-template">Print Template</label>
                        <select id="print-template" name="print_template" {if !can_manage_settings}disabled{/if}>
                            <option value="standard" {if settings.print_template == 'standard'}selected{/if}>Standard</option>
                        </select>
                        <div class="bakeshop-settings-field-error" data-field-error="print_template"></div>
                    </div>
                </div>
                <div class="bakeshop-settings-actions-row" style="margin-top:16px;">
                    <span class="bakeshop-settings-note">Current branding uses "{settings.store_name}" with {if settings.store_logo_url}a custom logo{else}the generated lettermark{/if}. Usage output stays at {settings.usage_decimal_places} decimal place(s), delivery receipts default to {settings.default_dr_coverage_days} day(s), product recipes are {if settings.product_recipe_status == 'active'}active{else}deactivated{/if}, and production is currently set to {if settings.product_recipe_status != 'active'}locked to output-only while recipes are off{elseif settings.production_recipe_mode == 'required'}require a recipe{else}allow output-only entries{/if}.</span>
                    {if can_manage_settings}
                    <button class="bakeshop-settings-button" type="submit">Save Branding and Display Defaults</button>
                    {/if}
                </div>
            </form>
        </div>
    </section>

    <section class="bakeshop-settings-panel">
        <div class="bakeshop-settings-panel-head">
            <h3>Units</h3>
            <p>Seeded defaults and any units you add here are available in product, ingredient, and delivery forms, plus recipe forms when Product Recipes is active.</p>
        </div>
        <div class="bakeshop-settings-panel-body">
            {if can_manage_settings}
            <form id="units-form">
                <input type="hidden" name="id" value="">
                <div class="bakeshop-settings-field-grid units">
                    <div class="bakeshop-settings-field">
                        <label for="unit-code">Code</label>
                        <input id="unit-code" name="code" maxlength="20" placeholder="box">
                    </div>
                    <div class="bakeshop-settings-field">
                        <label for="unit-name">Name</label>
                        <input id="unit-name" name="name" maxlength="100" placeholder="Box">
                    </div>
                    <div class="bakeshop-settings-field">
                        <label for="unit-dimension">Dimension</label>
                        <select id="unit-dimension" name="dimension">
                            <option value="mass">Mass</option>
                            <option value="volume">Volume</option>
                            <option value="count" selected>Count</option>
                        </select>
                    </div>
                    <div class="bakeshop-settings-field">
                        <label for="unit-factor-to-base">Factor To Base</label>
                        <input id="unit-factor-to-base" name="factor_to_base" type="number" min="0.000001" step="0.000001" value="1.000000">
                    </div>
                </div>
                <div class="bakeshop-settings-actions-row" style="margin-top:16px;">
                    <span class="bakeshop-settings-note">Use 1.000000 for a base unit in the chosen dimension, or enter a conversion factor relative to that dimension's base unit. Units already used in recipes, deliveries, production, or dependent conversions can still be renamed, but their dimension and conversion factor stay locked by validation.</span>
                    <div class="bakeshop-settings-actions" style="justify-content:flex-end;">
                        <button class="bakeshop-settings-button danger" type="button" id="unit-cancel" hidden>Cancel Edit</button>
                        <button class="bakeshop-settings-button" type="submit" id="unit-submit">Add Unit</button>
                    </div>
                </div>
            </form>
            {/if}
            <div class="bakeshop-settings-table-wrap">
                <table class="bakeshop-settings-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Dimension</th>
                            <th>Factor To Base</th>
                            {if can_manage_settings}<th>Actions</th>{/if}
                        </tr>
                    </thead>
                    <tbody id="units-table-body">
                        {each units as unit}
                        <tr>
                            <td>{unit.code}</td>
                            <td>{unit.name}</td>
                            <td>{unit.dimension}</td>
                            <td>{unit.factor_to_base}</td>
                            {if can_manage_settings}
                            <td>
                                <div class="bakeshop-settings-row-actions">
                                    <button class="bakeshop-settings-button secondary" type="button" data-unit-edit="1" data-unit-id="{unit.id}" data-unit-code="{unit.code}" data-unit-name="{unit.name}" data-unit-dimension="{unit.dimension}" data-unit-factor="{unit.factor_to_base}">Edit</button>
                                </div>
                            </td>
                            {/if}
                        </tr>
                        {/each}
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    {if can_manage_settings}
    <section class="bakeshop-settings-panel">
        <div class="bakeshop-settings-panel-head">
            <h3>Runtime Diagnostics</h3>
            <p>Read-only kernel connection policy and request-level DB runtime status for this Bakeshop session.</p>
        </div>
        <div class="bakeshop-settings-panel-body">
            <div class="bakeshop-settings-table-wrap">
                <table class="bakeshop-settings-table">
                    <thead>
                        <tr>
                            <th>Diagnostic</th>
                            <th>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Primary Request DB Target</strong><div class="bakeshop-settings-note">Whether the current request resolves to the shared primary DB or a tenant DB.</div></td>
                            <td>{if db_runtime.primary_request_target == 'tenant'}Tenant DB{else}Primary DB{/if}</td>
                        </tr>
                        <tr>
                            <td><strong>Current Tenant</strong><div class="bakeshop-settings-note">Resolved tenant id for this request, when multi-tenant routing is active.</div></td>
                            <td>{if db_runtime.request_tenant_id}{db_runtime.request_tenant_id}{else}None{/if}</td>
                        </tr>
                        <tr>
                            <td><strong>Tenant DB Pool</strong><div class="bakeshop-settings-note">Active cross-tenant connections cached inside the kernel for this request.</div></td>
                            <td>{db_runtime.tenant_pool.active} active / {db_runtime.tenant_pool.max} max</td>
                        </tr>
                        <tr>
                            <td><strong>Tenant DB Config Cache</strong><div class="bakeshop-settings-note">How tenant DB connection rows are cached before the kernel reaches the control plane.</div></td>
                            <td>{db_runtime.tenant_config_cache.backend}, TTL {db_runtime.tenant_config_cache.ttl_seconds}s</td>
                        </tr>
                        <tr>
                            <td><strong>Prepared Statement Policy</strong><div class="bakeshop-settings-note">Kernel DB manager enforces native prepares and typed fetch behavior on every connection.</div></td>
                            <td>{if !db_runtime.primary_policy.emulate_prepares}Native prepares enforced{/if}, stringify fetches {if db_runtime.primary_policy.stringify_fetches}on{else}off{/if}</td>
                        </tr>
                        <tr>
                            <td><strong>Connection Timeout</strong><div class="bakeshop-settings-note">Primary and control DB timeouts after central kernel policy normalization.</div></td>
                            <td>Primary {db_runtime.primary_policy.timeout_seconds}s, control {db_runtime.control_policy.timeout_seconds}s</td>
                        </tr>
                        <tr>
                            <td><strong>Persistent Connections</strong><div class="bakeshop-settings-note">Whether the kernel keeps PDO connections persistent for primary and control-plane access.</div></td>
                            <td>Primary {if db_runtime.primary_policy.persistent}enabled{else}disabled{/if}, control {if db_runtime.control_policy.persistent}enabled{else}disabled{/if}</td>
                        </tr>
                        <tr>
                            <td><strong>Encrypted Tenant Credentials</strong><div class="bakeshop-settings-note">Control-plane tenant DB passwords can be required to stay encrypted at rest.</div></td>
                            <td>{if db_runtime.primary_policy.encrypted_tenant_passwords_enforced}Required{else}Allowed but not enforced{/if}</td>
                        </tr>
                        <tr>
                            <td><strong>DB TLS</strong><div class="bakeshop-settings-note">Primary and control-plane MySQL transport security posture after kernel normalization.</div></td>
                            <td>Primary {if db_runtime.primary_policy.ssl_enabled}enabled{if db_runtime.primary_policy.ssl_verify_server_cert}, verified{/if}{if db_runtime.primary_policy.ssl_has_ca}, CA configured{/if}{else}disabled{/if}; control {if db_runtime.control_policy.ssl_enabled}enabled{if db_runtime.control_policy.ssl_verify_server_cert}, verified{/if}{if db_runtime.control_policy.ssl_has_ca}, CA configured{/if}{else}disabled{/if}</td>
                        </tr>
                        <tr>
                            <td><strong>Request Counters</strong><div class="bakeshop-settings-note">Connection and cache activity seen by the kernel during this request.</div></td>
                            <td>Primary connects {db_runtime.counters.primary_connects}, control connects {db_runtime.counters.control_connects}, tenant connects {db_runtime.counters.tenant_connects}, tenant pool hits {db_runtime.counters.tenant_pool_hits}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
    {/if}
</div>

<script>
(() => {
    const canManageSettings = {if can_manage_settings}true{else}false{/if};
    const csrfToken = '{csrf_token}';
    const permissionForm = document.getElementById('permissions-form');
    const displayForm = document.getElementById('display-settings-form');
    const unitsForm = document.getElementById('units-form');
    const unitsTableBody = document.getElementById('units-table-body');
    const unitSubmitButton = document.getElementById('unit-submit');
    const unitCancelButton = document.getElementById('unit-cancel');
    const logoUrlInput = displayForm?.querySelector('[name="store_logo_url"]');
    const logoFileInput = document.getElementById('store-logo-file');
    const logoPreview = document.getElementById('store-logo-preview');
    const logoStatus = document.getElementById('store-logo-status');
    const logoRemoveButton = document.getElementById('store-logo-remove');
    const storeNameInput = displayForm?.querySelector('[name="store_name"]');
    const productRecipeStatusInput = displayForm?.querySelector('[name="product_recipe_status"]');
    const productionRecipeModeInput = displayForm?.querySelector('[name="production_recipe_mode"]');
    const banner = document.getElementById('bakeshop-settings-banner');
    const displayErrorNames = ['store_name', 'store_logo_file', 'store_description', 'usage_decimal_places', 'default_dr_coverage_days', 'product_recipe_status', 'production_recipe_mode', 'print_template'];

    function showBanner(message, ok = true) {
        banner.textContent = message;
        banner.className = 'bakeshop-settings-banner show ' + (ok ? 'ok' : 'error');
    }

    function clearDisplayFieldError(name) {
        if (!displayForm) {
            return;
        }

        const errorNode = displayForm.querySelector('[data-field-error="' + name + '"]');
        if (errorNode) {
            errorNode.textContent = '';
            errorNode.classList.remove('show');
        }

        const field = displayForm.querySelector('[name="' + name + '"]');
        if (field instanceof HTMLElement) {
            field.classList.remove('is-invalid');
            field.removeAttribute('aria-invalid');
        }

        const fieldShell = errorNode?.closest('.bakeshop-settings-field');
        if (fieldShell) {
            fieldShell.classList.remove('is-invalid');
        }
    }

    function clearDisplayFieldErrors() {
        displayErrorNames.forEach(clearDisplayFieldError);
    }

    function showDisplayFieldError(name, message) {
        if (!displayForm) {
            return;
        }

        const errorNode = displayForm.querySelector('[data-field-error="' + name + '"]');
        if (!errorNode) {
            return;
        }

        errorNode.textContent = message;
        errorNode.classList.add('show');

        const field = displayForm.querySelector('[name="' + name + '"]');
        if (field instanceof HTMLElement) {
            field.classList.add('is-invalid');
            field.setAttribute('aria-invalid', 'true');
        }

        const fieldShell = errorNode.closest('.bakeshop-settings-field');
        if (fieldShell) {
            fieldShell.classList.add('is-invalid');
        }
    }

    function inferDisplayFieldFromMessage(message) {
        const normalized = String(message || '').toLowerCase();
        if (normalized.includes('logo') || normalized.includes('image') || normalized.includes('upload')) {
            return 'store_logo_file';
        }
        if (normalized.includes('store name')) {
            return 'store_name';
        }
        if (normalized.includes('description')) {
            return 'store_description';
        }
        if (normalized.includes('decimal')) {
            return 'usage_decimal_places';
        }
        if (normalized.includes('coverage')) {
            return 'default_dr_coverage_days';
        }
        if (normalized.includes('product recipes') || normalized.includes('active or inactive') || normalized.includes('active') && normalized.includes('inactive')) {
            return 'product_recipe_status';
        }
        if (normalized.includes('recipe policy') || normalized.includes('recipe mode') || normalized.includes('optional or required')) {
            return 'production_recipe_mode';
        }
        if (normalized.includes('print template') || normalized.includes('template')) {
            return 'print_template';
        }

        return null;
    }

    function buildRequestError(payload, fallbackMessage) {
        const error = new Error(payload.error || fallbackMessage);
        error.field = inferDisplayFieldFromMessage(payload.error || '');
        return error;
    }

    async function postJson(url, body) {
        const response = await fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json',
                'X-CSRF-Token': csrfToken
            },
            body: JSON.stringify({ _token: csrfToken, ...body })
        });

        const payload = await response.json().catch(() => ({ ok: false, error: 'Invalid server response' }));
        if (!response.ok || payload.ok === false) {
            throw buildRequestError(payload, 'Request failed');
        }

        return payload;
    }

    async function uploadLogo(file) {
        const formData = new FormData();
        formData.append('_token', csrfToken);
        formData.append('logo_file', file);

        const response = await fetch('{base_url}/api/v1/bakeshop/settings/logo', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Accept': 'application/json',
                'X-CSRF-Token': csrfToken
            },
            body: formData,
        });

        const payload = await response.json().catch(() => ({ ok: false, error: 'Invalid server response' }));
        if (!response.ok || payload.ok === false) {
            throw buildRequestError(payload, 'Logo upload failed');
        }

        return payload.data || {};
    }

    function storeInitial(value) {
        const text = String(value || '').trim();
        return text ? text.charAt(0).toUpperCase() : 'B';
    }

    function renderLogoPreview(url) {
        if (!logoPreview) {
            return;
        }

        logoPreview.replaceChildren();
        if (url) {
            const image = document.createElement('img');
            image.src = url;
            image.alt = (storeNameInput?.value || 'Bakeshop') + ' logo';
            logoPreview.appendChild(image);
            if (logoStatus) {
                logoStatus.textContent = 'Current uploaded logo will stay in place until you choose a new one or switch back to the lettermark. Oversized raster logos are reduced to fit within 512x512 before display.';
            }
            if (logoRemoveButton) {
                logoRemoveButton.hidden = false;
            }
            return;
        }

        logoPreview.textContent = storeInitial(storeNameInput?.value);
        if (logoStatus) {
            logoStatus.textContent = 'No uploaded logo yet. The generated lettermark is currently in use. Oversized raster logos are reduced to fit within 512x512 before display.';
        }
        if (logoRemoveButton) {
            logoRemoveButton.hidden = true;
        }
    }

    function syncProductionRecipeModeField() {
        if (!(productionRecipeModeInput instanceof HTMLSelectElement)) {
            return;
        }

        const recipesActive = productRecipeStatusInput instanceof HTMLSelectElement
            ? productRecipeStatusInput.value === 'active'
            : true;

        if (!recipesActive) {
            productionRecipeModeInput.value = 'optional';
        }

        productionRecipeModeInput.disabled = !canManageSettings || !recipesActive;
        if (productionRecipeModeInput.disabled) {
            productionRecipeModeInput.setAttribute('aria-disabled', 'true');
            clearDisplayFieldError('production_recipe_mode');
            return;
        }

        productionRecipeModeInput.removeAttribute('aria-disabled');
    }

    function resetUnitsForm() {
        if (!unitsForm) {
            return;
        }

        unitsForm.reset();
        const idField = unitsForm.querySelector('[name="id"]');
        if (idField) {
            idField.value = '';
        }
        if (unitSubmitButton) {
            unitSubmitButton.textContent = 'Add Unit';
        }
        if (unitCancelButton) {
            unitCancelButton.hidden = true;
        }
    }

    permissionForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const body = {
            supervisor_read: permissionForm.querySelector('[name="supervisor_read"]')?.checked ? 1 : 0,
            supervisor_manage: permissionForm.querySelector('[name="supervisor_manage"]')?.checked ? 1 : 0,
        };

        try {
            const payload = await postJson('{base_url}/api/v1/bakeshop/settings/permissions', body);

            showBanner(payload.data?.message || 'Access settings saved.');
        } catch (error) {
            showBanner(error.message || 'Unable to save access settings.', false);
        }
    });

    displayForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        clearDisplayFieldErrors();
        try {
            let logoUrl = logoUrlInput?.value || '';
            const selectedLogo = logoFileInput?.files?.[0] || null;
            if (selectedLogo) {
                showBanner('Uploading store logo...');
                const uploadPayload = await uploadLogo(selectedLogo);
                logoUrl = uploadPayload.store_logo_url || '';
                if (logoUrlInput) {
                    logoUrlInput.value = logoUrl;
                }
                renderLogoPreview(logoUrl);
            }

            const productRecipeStatus = productRecipeStatusInput?.value || 'active';
            const body = {
            store_name: displayForm.querySelector('[name="store_name"]')?.value || '',
            store_description: displayForm.querySelector('[name="store_description"]')?.value || '',
            store_logo_url: logoUrl,
            usage_decimal_places: displayForm.querySelector('[name="usage_decimal_places"]')?.value || '2',
            default_dr_coverage_days: displayForm.querySelector('[name="default_dr_coverage_days"]')?.value || '3',
            product_recipe_status: productRecipeStatus,
            production_recipe_mode: productRecipeStatus === 'active'
                ? (productionRecipeModeInput?.value || 'optional')
                : 'optional',
            print_template: displayForm.querySelector('[name="print_template"]')?.value || 'standard',
            };

            await postJson('{base_url}/api/v1/bakeshop/settings/display', body);
            if (logoFileInput) {
                logoFileInput.value = '';
            }
            renderLogoPreview(logoUrl);

            showBanner('Branding and display defaults saved.');
        } catch (error) {
            const fieldName = String(error?.field || '').trim();
            if (fieldName !== '') {
                showDisplayFieldError(fieldName, error.message || 'Please review this field.');
            }
            showBanner(error.message || 'Unable to save branding and display defaults.', false);
        }
    });

    logoRemoveButton?.addEventListener('click', () => {
        if (logoUrlInput) {
            logoUrlInput.value = '';
        }
        if (logoFileInput) {
            logoFileInput.value = '';
        }
        renderLogoPreview('');
    });

    storeNameInput?.addEventListener('input', () => {
        clearDisplayFieldError('store_name');
        if (!logoUrlInput?.value) {
            renderLogoPreview('');
        }
    });

    displayForm?.querySelector('[name="store_description"]')?.addEventListener('input', () => clearDisplayFieldError('store_description'));
    displayForm?.querySelector('[name="usage_decimal_places"]')?.addEventListener('input', () => clearDisplayFieldError('usage_decimal_places'));
    displayForm?.querySelector('[name="default_dr_coverage_days"]')?.addEventListener('input', () => clearDisplayFieldError('default_dr_coverage_days'));
    displayForm?.querySelector('[name="product_recipe_status"]')?.addEventListener('change', () => {
        clearDisplayFieldError('product_recipe_status');
        syncProductionRecipeModeField();
    });
    displayForm?.querySelector('[name="production_recipe_mode"]')?.addEventListener('change', () => clearDisplayFieldError('production_recipe_mode'));
    displayForm?.querySelector('[name="print_template"]')?.addEventListener('change', () => clearDisplayFieldError('print_template'));
    logoFileInput?.addEventListener('change', () => clearDisplayFieldError('store_logo_file'));

    renderLogoPreview(logoUrlInput?.value || '');
    syncProductionRecipeModeField();

    unitsForm?.addEventListener('submit', async (event) => {
        event.preventDefault();

        const body = {
            id: unitsForm.querySelector('[name="id"]')?.value || '',
            code: unitsForm.querySelector('[name="code"]')?.value || '',
            name: unitsForm.querySelector('[name="name"]')?.value || '',
            dimension: unitsForm.querySelector('[name="dimension"]')?.value || 'count',
            factor_to_base: unitsForm.querySelector('[name="factor_to_base"]')?.value || '1.000000',
        };

        try {
            await postJson('{base_url}/api/v1/bakeshop/units', body);
            showBanner(body.id ? 'Unit updated.' : 'Unit added.');
            resetUnitsForm();
            window.location.reload();
        } catch (error) {
            showBanner(error.message || (body.id ? 'Unable to update unit.' : 'Unable to add unit.'), false);
        }
    });

    unitsTableBody?.addEventListener('click', (event) => {
        const button = event.target.closest('[data-unit-edit]');
        if (!button || !unitsForm) {
            return;
        }

        unitsForm.querySelector('[name="id"]').value = button.getAttribute('data-unit-id') || '';
        unitsForm.querySelector('[name="code"]').value = button.getAttribute('data-unit-code') || '';
        unitsForm.querySelector('[name="name"]').value = button.getAttribute('data-unit-name') || '';
        unitsForm.querySelector('[name="dimension"]').value = button.getAttribute('data-unit-dimension') || 'count';
        unitsForm.querySelector('[name="factor_to_base"]').value = button.getAttribute('data-unit-factor') || '1.000000';

        if (unitSubmitButton) {
            unitSubmitButton.textContent = 'Save Unit';
        }
        if (unitCancelButton) {
            unitCancelButton.hidden = false;
        }

        unitsForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    unitCancelButton?.addEventListener('click', resetUnitsForm);
})();
</script>
{/block}