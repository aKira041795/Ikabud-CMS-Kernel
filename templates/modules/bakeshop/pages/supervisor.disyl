    async function voidProductionRun(row) {
        if (!confirmDelete('Void this saved entry and remove its ingredient use from usage and inventory?')) {
            return;
        }

        const voidReason = promptRequiredValue('Why is this saved entry being voided?', 'Duplicate or incorrect entry');
        if (voidReason === null) {
            return;
        }

        await submitJson(api.productionVoid, {
            id: row.id,
            void_reason: voidReason
        }, 'Saved entry voided.', async () => {
            await loadProduction(true);
            await loadUsage();
        });
    }

    async function toggleActive(kind, row) {
        const rowId = normalizedRowId(kind, row);
        if (!Number.isFinite(rowId) || rowId <= 0) {
            showBanner('Selected ' + String(kind || 'record') + ' could not be resolved.', false);
            return;
        }

        const nextActive = Number(row.is_active) === 0 ? 1 : 0;
        if (kind === 'branch') {
            await submitJson(api.branchStatus.replace('[id]', encodeURIComponent(String(rowId))), {
                is_active: nextActive
            }, nextActive === 1 ? 'Branch restored.' : 'Branch archived.', async () => {
                if (branchForm.elements.namedItem('id').value === String(row.id)) {
                    resetBranchForm();
                }
                await loadBranches(true);
            });
            return;
        }

        if (kind === 'product') {
            await submitJson(api.productStatus.replace('[id]', encodeURIComponent(String(rowId))), {
                is_active: nextActive
            }, nextActive === 1 ? 'Product restored.' : 'Product archived.', async () => {
                if (productForm.elements.namedItem('id').value === String(row.id)) {
                    resetProductForm();
                }
                await loadProducts(true);
                await loadRecipes(true);
            });
            return;
        }

        if (kind === 'ingredient') {
            await submitJson(api.ingredientStatus.replace('[id]', encodeURIComponent(String(rowId))), {
                is_active: nextActive
            }, nextActive === 1 ? 'Ingredient restored.' : 'Ingredient archived.', async () => {
                if (ingredientForm.elements.namedItem('id').value === String(row.id)) {
                    resetIngredientForm();
                }
                await loadIngredients(true);
                await loadRecipes(true);
            });
        }
    }

    function findStateRow(kind, id) {
        const numericId = Number(id);
        if (kind === 'branch') {
            return state.branches.find((row) => Number(row.id) === numericId) || null;
        }
        if (kind === 'product') {
            return state.products.find((row) => Number(row.id) === numericId) || null;
        }
        if (kind === 'ingredient') {
            return state.ingredients.find((row) => Number(row.id) === numericId) || null;
        }
        if (kind === 'recipe') {
            return state.recipes.find((row) => Number(row.id) === numericId) || null;
        }
        if (kind === 'delivery') {
            return state.deliveries.find((row) => Number(row.id) === numericId) || null;
        }
        if (kind === 'production') {
            return state.production.find((row) => Number(row.id) === numericId) || null;
        }
        return null;
    }

    function bindMaintenanceActions(selector) {
        $(selector).addEventListener('click', async (event) => {
            const button = event.target.closest('[data-action]');
            if (!button) {
                return;
            }

            if (!canManageWorkspace) {
                showBanner('This work area is read only for your role.', false);
                return;
            }

            const kind = button.getAttribute('data-kind');
            const buttonRowId = Number(button.getAttribute('data-id') || '0');
            if (!Number.isFinite(buttonRowId) || buttonRowId <= 0) {
                showBanner('Selected record could not be resolved.', false);
                return;
            }

            const row = findStateRow(kind, buttonRowId);
            if (!row) {
                showBanner('Selected record could not be found.', false);
                return;
            }

            if (button.getAttribute('data-action') === 'edit') {
                if (kind === 'branch') {
                    editBranch(row);
                } else if (kind === 'product') {
                    editProduct(row);
                } else if (kind === 'ingredient') {
                    editIngredient(row);
                }
                clearBanner();
                return;
            }

            if (button.getAttribute('data-action') === 'delete') {
                if (kind === 'product') {
                    await deleteProduct(row);
                    return;
                }
                if (kind === 'ingredient') {
                    await deleteIngredient(row);
                    return;
                }
            }

            await toggleActive(kind, row);
        });
    }

    $('#branch-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        await submitJson(api.branches, {
            id: form.elements.namedItem('id').value,
            is_active: form.elements.namedItem('is_active').value,
            code: form.elements.namedItem('code').value,
            name: form.elements.namedItem('name').value,
            address: form.elements.namedItem('address').value
        }, form.elements.namedItem('id').value ? 'Branch updated.' : 'Branch saved.', async () => {
            resetBranchForm();
            await loadBranches();
        });
    });

    $('#product-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        await submitJson(api.products, {
            id: form.elements.namedItem('id').value,
            is_active: form.elements.namedItem('is_active').value,
            name: form.elements.namedItem('name').value,
            sku: form.elements.namedItem('sku').value,
            category: form.elements.namedItem('category').value,
            default_yield_qty: normalizeTwoDecimalQuantity(form.elements.namedItem('default_yield_qty').value, '1.00'),
            default_yield_unit_id: form.elements.namedItem('default_yield_unit_id').value
        }, form.elements.namedItem('id').value ? 'Product updated.' : 'Product saved.', async () => {
            const savedProductId = Number(form.elements.namedItem('id').value || 0);
            await loadProducts(true);
            await loadRecipes(true);
            if (savedProductId > 0) {
                const savedRow = state.products.find((row) => Number(row.id) === savedProductId);
                if (savedRow) {
                    editProduct(savedRow);
                    return;
                }
            }
            resetProductForm();
        });
    });

    $('#ingredient-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        await submitJson(api.ingredients, {
            id: form.elements.namedItem('id').value,
            is_active: form.elements.namedItem('is_active').value,
            name: form.elements.namedItem('name').value,
            sku: form.elements.namedItem('sku').value,
            default_unit_id: form.elements.namedItem('default_unit_id').value
        }, form.elements.namedItem('id').value ? 'Ingredient updated.' : 'Ingredient saved.', async () => {
            resetIngredientForm();
            await loadIngredients(true);
            await loadRecipes(true);
        });
    });

    $('#branch-cancel').addEventListener('click', resetBranchForm);
    $('#product-add').addEventListener('click', () => {
        resetProductForm();
        productForm.elements.namedItem('name').focus();
    });
    $('#product-cancel').addEventListener('click', resetProductForm);
    deleteConfirmCancel?.addEventListener('click', () => {
        closeDeleteConfirm(false);
    });
    deleteConfirmSubmit?.addEventListener('click', () => {
        closeDeleteConfirm(true);
    });
    deleteConfirm?.addEventListener('click', (event) => {
        if (event.target === deleteConfirm) {
            closeDeleteConfirm(false);
        }
    });
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && deleteConfirm && !deleteConfirm.hidden) {
            event.preventDefault();
            closeDeleteConfirm(false);
        }
    });
    $('#products-select-visible')?.addEventListener('click', () => {
        productDeleteEligibleRows().forEach((row) => {
            const rowId = Number(row.id);
            if (Number.isFinite(rowId) && rowId > 0) {
                state.selectedProductIds.add(rowId);
            }
        });
        renderCatalogTables();
    });
    $('#products-clear-selection')?.addEventListener('click', () => {
        state.selectedProductIds.clear();
        renderCatalogTables();
    });
    $('#products-delete-selected')?.addEventListener('click', async () => {
        await deleteProductsByIds(Array.from(state.selectedProductIds));
    });
    $('#products-select-all')?.addEventListener('change', (event) => {
        const checked = event.currentTarget.checked;
        productDeleteEligibleRows().forEach((row) => {
            const rowId = Number(row.id);
            if (!Number.isFinite(rowId) || rowId <= 0) {
                return;
            }
            if (checked) {
                state.selectedProductIds.add(rowId);
            } else {
                state.selectedProductIds.delete(rowId);
            }
        });
        renderCatalogTables();
    });
    $('#products-table')?.addEventListener('change', (event) => {
        const checkbox = event.target.closest('[data-product-select]');
        if (!checkbox) {
            return;
        }

        const rowId = Number(checkbox.getAttribute('data-product-select') || '0');
        if (!Number.isFinite(rowId) || rowId <= 0) {
            return;
        }

        if (checkbox.checked) {
            state.selectedProductIds.add(rowId);
        } else {
            state.selectedProductIds.delete(rowId);
        }
        syncProductSelectionControls(filteredProductRows());
    });
    document.querySelectorAll('[data-product-view]').forEach((button) => {
        button.addEventListener('click', () => {
            const nextView = button.getAttribute('data-product-view') === 'archived' ? 'archived' : 'active';
            if (state.productListView === nextView) {
                return;
            }

            state.productListView = nextView;
            state.selectedProductIds.clear();
            if (state.activeProductId > 0) {
                const activeProduct = state.products.find((row) => Number(row.id) === Number(state.activeProductId));
                if (activeProduct && ((nextView === 'archived') !== (Number(activeProduct.is_active) === 0))) {
                    resetProductForm();
                    return;
                }
            }
            renderCatalogTables();
        });
    });
    $('#ingredient-add').addEventListener('click', () => {
        resetIngredientForm();
        ingredientForm.elements.namedItem('name').focus();
    });
    $('#ingredient-cancel').addEventListener('click', resetIngredientForm);
    document.querySelectorAll('[data-ingredient-view]').forEach((button) => {
        button.addEventListener('click', () => {
            const nextView = button.getAttribute('data-ingredient-view') === 'archived' ? 'archived' : 'active';
            if (state.ingredientListView === nextView) {
                return;
            }

            state.ingredientListView = nextView;
            state.selectedIngredientIds.clear();
            renderCatalogTables();
        });
    });
    $('#ingredients-select-visible')?.addEventListener('click', () => {
        ingredientDeleteEligibleRows().forEach((row) => {
            const rowId = Number(row.id);
            if (Number.isFinite(rowId) && rowId > 0) {
                state.selectedIngredientIds.add(rowId);
            }
        });
        renderCatalogTables();
    });
    $('#ingredients-clear-selection')?.addEventListener('click', () => {
        state.selectedIngredientIds.clear();
        renderCatalogTables();
    });
    $('#ingredients-delete-selected')?.addEventListener('click', async () => {
        await deleteIngredientsByIds(Array.from(state.selectedIngredientIds));
    });
    $('#ingredients-select-all')?.addEventListener('change', (event) => {
        const checked = event.currentTarget.checked;
        ingredientDeleteEligibleRows().forEach((row) => {
            const rowId = Number(row.id);
            if (!Number.isFinite(rowId) || rowId <= 0) {
                return;
            }
            if (checked) {
                state.selectedIngredientIds.add(rowId);
            } else {
                state.selectedIngredientIds.delete(rowId);
            }
        });
        renderCatalogTables();
    });
    $('#ingredients-table')?.addEventListener('change', (event) => {
        const checkbox = event.target.closest('[data-ingredient-select]');
        if (!checkbox) {
            return;
        }

        const rowId = Number(checkbox.getAttribute('data-ingredient-select') || '0');
        if (!Number.isFinite(rowId) || rowId <= 0) {
            return;
        }

        if (checkbox.checked) {
            state.selectedIngredientIds.add(rowId);
        } else {
            state.selectedIngredientIds.delete(rowId);
        }
        syncIngredientSelectionControls(filteredIngredientRows());
    });
    $('#recipe-cancel').addEventListener('click', resetRecipeForm);

    $('#recipe-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        await submitJson(api.recipes, {
            product_id: form.product_id.value,
            ingredient_id: form.ingredient_id.value,
            unit_id: form.unit_id.value,
            qty: normalizeTwoDecimalQuantity(form.qty.value, '1.00'),
            notes: form.notes.value
        }, form.dataset.recipeId ? 'Recipe line updated.' : 'Recipe line saved.', async () => {
            resetRecipeForm();
            await loadRecipes(true);
            await loadProducts(true);
        });
    });

    $('#delivery-sheet-filter').addEventListener('input', filterDeliverySheet);
    ['#branches-filter'].forEach((selector) => {
        const input = $(selector);
        if (input) {
            input.addEventListener('input', renderBranchTables);
        }
    });
    ['#recipes-filter', '#ingredients-filter', '#production-products-filter'].forEach((selector) => {
        const input = $(selector);
        if (input) {
            input.addEventListener('input', renderCatalogTables);
        }
    });
    ['#deliveries-filter', '#production-filter'].forEach((selector) => {
        const input = $(selector);
        if (input) {
            input.addEventListener('input', renderOperationalTables);
        }
    });
    ['#usage-filter', '#inventory-filter'].forEach((selector) => {
        const input = $(selector);
        if (input) {
            input.addEventListener('input', renderUsage);
        }
    });
    $('#delivery-sheet-clear').addEventListener('click', () => {
        clearDeliverySheetValues();
        showBanner('Daily delivery sheet cleared.', true);
    });
    $('#delivery-csv-template').addEventListener('click', downloadDeliveryCsvTemplate);
    deliveryCsvFile.addEventListener('change', async (event) => {
        const file = event.currentTarget.files && event.currentTarget.files[0];
        if (!file) {
            return;
        }

        try {
            const text = await file.text();
            importDeliveryCsv(text);
        } catch (error) {
            showBanner(error.message || 'Unable to import CSV.', false);
        }
    });

    $('#delivery-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        const items = collectDeliveryItems();
        if (!items.length) {
            showBanner('Enter at least one received quantity or import a CSV before saving.', false);
            return;
        }

        const preservedBranch = form.branch_id.value;
        const preservedDeliveredAt = form.delivered_at.value;
        const preservedReceivedBy = form.received_by.value;
        const preservedSourceType = form.source_type.value;
        const preservedSourceName = form.source_name.value;
        await submitJson(api.deliveries, {
            branch_id: form.branch_id.value,
            delivered_at: form.delivered_at.value,
            reference: form.reference.value,
            source_type: form.source_type.value,
            source_name: form.source_name.value,
            received_by: form.received_by.value,
            notes: form.notes.value,
            items: items
        }, 'Delivery saved.', async () => {
            form.reference.value = '';
            form.notes.value = '';
            form.branch_id.value = preservedBranch;
            form.delivered_at.value = preservedDeliveredAt || nowLocalDate();
            form.received_by.value = preservedReceivedBy;
            form.source_type.value = preservedSourceType || 'commissary';
            form.source_name.value = preservedSourceName;
            syncDeliverySourceField();
            clearDeliverySheetValues();
            await loadDeliveries(true);
            await loadUsage();
        });
    });
    $('#deliveries-select-visible')?.addEventListener('click', () => {
        filteredDeliveryRows().forEach((row) => {
            const rowId = Number(row.id);
            if (Number.isFinite(rowId) && rowId > 0) {
                state.selectedDeliveryIds.add(rowId);
            }
        });
        renderOperationalTables();
    });
    $('#deliveries-clear-selection')?.addEventListener('click', () => {
        state.selectedDeliveryIds.clear();
        renderOperationalTables();
    });
    $('#deliveries-delete-selected')?.addEventListener('click', async () => {
        await deleteDeliveriesByIds(Array.from(state.selectedDeliveryIds));
    });
    $('#deliveries-select-all')?.addEventListener('change', (event) => {
        const checked = event.currentTarget.checked;
        filteredDeliveryRows().forEach((row) => {
            const rowId = Number(row.id);
            if (!Number.isFinite(rowId) || rowId <= 0) {
                return;
            }
            if (checked) {
                state.selectedDeliveryIds.add(rowId);
            } else {
                state.selectedDeliveryIds.delete(rowId);
            }
        });
        renderOperationalTables();
    });
    $('#deliveries-table')?.addEventListener('change', (event) => {
        const checkbox = event.target.closest('[data-delivery-select]');
        if (!checkbox) {
            return;
        }

        const rowId = Number(checkbox.getAttribute('data-delivery-select') || '0');
        if (!Number.isFinite(rowId) || rowId <= 0) {
            return;
        }

        if (checkbox.checked) {
            state.selectedDeliveryIds.add(rowId);
        } else {
            state.selectedDeliveryIds.delete(rowId);
        }
        syncDeliverySelectionControls(filteredDeliveryRows());
    });

    $('#production-products-table').addEventListener('click', (event) => {
        const qtyInput = event.target.closest('[data-production-qty-input]');
        if (qtyInput) {
            return;
        }

        const rowElement = event.target.closest('tr[data-row-kind="production-product"]');
        if (!rowElement) {
            return;
        }

        const row = state.products.find((item) => Number(item.id) === Number(rowElement.getAttribute('data-row-id') || '0') && Number(item.is_active) !== 0);
        if (!row) {
            showBanner('Selected product could not be found.', false);
            return;
        }

        focusProductionDraftInput(row);
    });

    $('#production-products-table').addEventListener('input', (event) => {
        const qtyInput = event.target.closest('[data-production-qty-input]');
        if (!(qtyInput instanceof HTMLInputElement)) {
            return;
        }

        const productId = Number(qtyInput.getAttribute('data-production-qty-input') || '0');
        if (!Number.isFinite(productId) || productId <= 0) {
            return;
        }

        const rawValue = String(qtyInput.value || '').trim();
        const numericValue = Number.parseFloat(rawValue);
        if (rawValue === '' || !Number.isFinite(numericValue) || numericValue <= 0) {
            delete state.productionDraftQuantities[String(productId)];
        } else {
            state.productionDraftQuantities[String(productId)] = rawValue;
        }

        syncProductionProductSelection();
    });

    $('#production-products-table').addEventListener('change', async (event) => {
        const qtyInput = event.target.closest('[data-production-qty-input]');
        if (!(qtyInput instanceof HTMLInputElement)) {
            return;
        }

        const productId = Number(qtyInput.getAttribute('data-production-qty-input') || '0');
        if (!Number.isFinite(productId) || productId <= 0) {
            return;
        }

        await autosaveProductionDraft(productId, qtyInput.value, qtyInput);
    });

    $('#production-products-table').addEventListener('keydown', (event) => {
        const qtyInput = event.target.closest('[data-production-qty-input]');
        if (!(qtyInput instanceof HTMLInputElement)) {
            return;
        }

        if (event.key === 'Enter') {
            event.preventDefault();
            qtyInput.blur();
        }
    });

    $('#production-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        const productionRunId = Number(form.elements.namedItem('id').value || '0');
        if (productionRunId > 0) {
            await submitJson(api.production, {
                id: productionRunId,
                produced_at: form.produced_at.value,
                produced_by: form.produced_by.value,
                notes: form.notes.value
            }, 'Saved entry updated.', async (data) => {
                await loadProduction(true);
                const updatedId = Number((data && data.item && data.item.id) || productionRunId || 0);
                const updatedSavedRow = state.production.find((row) => Number(row.id) === updatedId);
                if (updatedSavedRow) {
                    rememberLastSavedProduction(updatedSavedRow);
                }
                await loadUsage();
                const updatedRow = state.production.find((row) => Number(row.id) === productionRunId);
                if (updatedRow) {
                    editProduction(updatedRow);
                    return;
                }
                resetProductionForm();
            });
            return;
        }

        showBanner('Enter the amount made in the item list. Each row saves when you leave the box.', false);
    });

    if (permissionsForm && canManageSettings) {
        permissionsForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            await submitJson(api.permissionsSettings, {
                role_permissions: {
                    supervisor: [
                        permissionsForm.elements.namedItem('supervisor_read').checked ? 'bakeshop.read' : '',
                        permissionsForm.elements.namedItem('supervisor_manage').checked ? 'bakeshop.manage' : ''
                    ].filter(Boolean)
                }
            }, 'Access settings updated.');
        });
    }

    $('#usage-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        try {
            await loadUsage();
            showBanner('Usage summary refreshed.', true);
        } catch (error) {
            showBanner(error.message || 'Unable to load usage summary.', false);
        }
    });

    $('#bakeshop-refresh').addEventListener('click', async () => {
        try {
            await ensureTabData(window.location.hash.slice(1) || defaultTab, { force: true });
            showBanner('The current work area has been refreshed.', true);
        } catch (error) {
            showBanner(error.message || 'Unable to refresh data.', false);
        }
    });

    ['#usage-branch', '#usage-from', '#usage-to', '#summary-branch-filter', '#summary-from-filter', '#summary-to-filter'].forEach((selector) => {
        $(selector).addEventListener('change', () => {
            if (selector.startsWith('#summary-')) {
                syncReportScopeInputs('summary');
            }
            syncPrintLink();
        });
    });

    bindMaintenanceActions('#branches-table');
    bindMaintenanceActions('#products-table');
    bindMaintenanceActions('#ingredients-table');
    $('#recipes-table').addEventListener('click', async (event) => {
        const button = event.target.closest('[data-action]');
        if (!button) {
            return;
        }

        if (!canManageWorkspace) {
            showBanner('This work area is read only for your role.', false);
            return;
        }

        const row = findStateRow('recipe', button.getAttribute('data-id'));
        if (!row) {
            showBanner('Selected recipe line could not be found.', false);
            return;
        }

        if (button.getAttribute('data-action') === 'edit-recipe') {
            editRecipe(row);
            clearBanner();
            return;
        }

        await deleteRecipe(row);
    });

    $('#deliveries-table').addEventListener('click', async (event) => {
        const detailButton = event.target.closest('[data-action="toggle-delivery-detail"]');
        if (detailButton) {
            const row = findStateRow('delivery', detailButton.getAttribute('data-id'));
            if (!row) {
                showBanner('Selected delivery could not be found.', false);
                return;
            }

            const rowId = Number(row.id || 0);
            state.expandedDeliveryId = Number(state.expandedDeliveryId || 0) === rowId ? 0 : rowId;
            renderOperationalTables();
            return;
        }

        const button = event.target.closest('[data-action="delete-delivery"]');
        if (!button) {
            return;
        }

        if (!canManageWorkspace) {
            showBanner('This work area is read only for your role.', false);
            return;
        }

        const row = findStateRow('delivery', button.getAttribute('data-id'));
        if (!row) {
            showBanner('Selected delivery could not be found.', false);
            return;
        }

        await deleteDelivery(row);
    });

    $('#production-table').addEventListener('click', async (event) => {
        if (!canManageWorkspace) {
            const readonlyButton = event.target.closest('[data-action="edit-production"], [data-action="void-production"]');
            if (readonlyButton) {
                showBanner('This work area is read only for your role.', false);
            }
            return;
        }

        const editButton = event.target.closest('[data-action="edit-production"]');
        if (editButton) {
            const editRow = findStateRow('production', editButton.getAttribute('data-id'));
            if (!editRow) {
                showBanner('That saved entry could not be found.', false);
                return;
            }

            activateProductionSectionTab('record');
            editProduction(editRow);
            return;
        }

        const button = event.target.closest('[data-action="void-production"]');
        if (!button) {
            return;
        }

        const row = findStateRow('production', button.getAttribute('data-id'));
        if (!row) {
            showBanner('That saved entry could not be found.', false);
            return;
        }

        await voidProductionRun(row);
    });

    $('#delivery-at').value = nowLocalDate();
    $('#delivery-source-type').value = 'commissary';
    syncDeliverySourceField();
    applyWorkspaceAccessMode();
    syncEditorActionButtons({ cancelSelector: '#branch-cancel', editing: false });
    syncEditorActionButtons({ addSelector: '#product-add', cancelSelector: '#product-cancel', editing: false });
    syncEditorActionButtons({ addSelector: '#ingredient-add', cancelSelector: '#ingredient-cancel', editing: false });
    syncEditorActionButtons({ cancelSelector: '#recipe-cancel', editing: false });
    syncEditorActionButtons({ cancelSelector: '#production-cancel', editing: false });
    $('#delivery-source-type').addEventListener('change', syncDeliverySourceField);
    deliverySectionTabs.forEach((button) => {
        button.addEventListener('click', () => {
            activateDeliverySectionTab(button.getAttribute('data-delivery-section-tab') || 'receive');
        });
    });
    $('#production-cancel').addEventListener('click', resetProductionForm);
    productionSectionTabs.forEach((button) => {
        button.addEventListener('click', () => {
            activateProductionSectionTab(button.getAttribute('data-production-section-tab') || 'record');
        });
    });
    productionGuardToggle?.addEventListener('click', () => {
        if (productionMetadataEditActive()) {
            showBanner('Testing override is only available while recording a new batch.', false);
            return;
        }

        state.productionGuardOverride = !state.productionGuardOverride;
        syncProductionGuardOverrideControls();
        syncProductionProductSelection();
        renderCatalogTables();
    });
    productionReviewLastSaved?.addEventListener('click', () => {
        activateProductionSectionTab('saved', { scrollToRecent: true });
    });
    productionEditLastSaved?.addEventListener('click', () => {
        const row = state.production.find((item) => Number(item.id) === Number(state.lastSavedProductionId || 0));
        if (!row) {
            showBanner('The last saved entry could not be found. Refresh the list and try again.', false);
            return;
        }

        editProduction(row);
    });
    resetProductionForm();
    resetBranchForm();
    resetProductForm();
    resetIngredientForm();
    resetRecipeForm();
    syncReportScopeInputs('summary');
    syncPrintLink();

    if (searchParams.get('onboarding') === 'bootstrap') {
        showBanner('Bootstrap onboarding is still active. You can review live workspace data here while finishing the staff handoff.', true);
    }

    ensureTabData(window.location.hash.slice(1) || defaultTab).catch((error) => {
        showBanner(error.message || 'Unable to load initial bakeshop data.', false);
    });
});
</script>
{/block}