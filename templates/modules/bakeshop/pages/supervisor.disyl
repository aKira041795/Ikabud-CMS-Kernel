    async function deleteRecipe(row) {
        if (!confirmDelete('Delete this recipe line? This cannot be undone.')) {
            return;
        }

        await submitJson(api.recipesDelete, {
            id: row.id
        }, 'Recipe line deleted.', async () => {
            if (recipeForm.dataset.recipeId === String(row.id)) {
                resetRecipeForm();
            }
            await loadRecipes(true);
            await loadProducts(true);
        });
    }

    async function deleteProductsByIds(ids) {
        const normalizedIds = Array.from(new Set((ids || []).map((id) => Number(id)).filter((id) => Number.isFinite(id) && id > 0)));
        if (!normalizedIds.length) {
            return;
        }

        const message = normalizedIds.length === 1
            ? 'Delete this product? Its recipe lines will also be deleted. This cannot be undone.'
            : 'Delete ' + String(normalizedIds.length) + ' selected products? Their recipe lines will also be deleted. This cannot be undone.';
        const shouldDelete = normalizedIds.length === 1
            ? confirmDelete(message)
            : await confirmBulkDelete({
                title: 'Delete selected products?',
                message,
                impact: 'Each selected product also removes its recipe lines.',
                items: normalizedIds.map((id) => productDeletePreviewLabel(findStateRow('product', id), id)),
                confirmLabel: 'Delete Products'
            });
        if (!shouldDelete) {
            return;
        }

        let deletedCount = 0;
        const failedLabels = [];
        for (const id of normalizedIds) {
            const row = findStateRow('product', id);
            try {
                await request(api.productsDelete, {
                    method: 'POST',
                    body: JSON.stringify({ _token: csrfToken, id })
                });
                deletedCount += 1;
                state.selectedProductIds.delete(id);
                if (productForm.elements.namedItem('id').value === String(id) || Number(state.activeProductId) === id) {
                    resetProductForm();
                }
            } catch (error) {
                failedLabels.push((row && row.name) ? row.name : ('ID ' + String(id)));
            }
        }

        await loadProducts(true);
        await loadRecipes(true);

        if (deletedCount > 0 && failedLabels.length === 0) {
            showBanner(deletedCount === 1 ? 'Product deleted.' : ('Deleted ' + String(deletedCount) + ' products.'), true);
            return;
        }
        if (deletedCount > 0) {
            showBanner('Deleted ' + String(deletedCount) + ' products. Failed: ' + failedLabels.slice(0, 3).join(', ') + (failedLabels.length > 3 ? '...' : '') + '.', false);
            return;
        }

        showBanner('Unable to delete the selected products.', false);
    }

    async function deleteProduct(row) {
        await deleteProductsByIds([row.id]);
    }

