    function resetRecipeForm() {
        recipeForm.reset();
        recipeForm.dataset.recipeId = '';
        recipeForm.elements.namedItem('qty').value = '1.00';
        if (state.activeProductId > 0) {
            recipeForm.elements.namedItem('product_id').value = String(state.activeProductId);
        }
        setFocusNote('#recipe-focus-note', '');
        $('#recipe-submit').textContent = 'Save Recipe Line';
        $('#recipe-cancel').hidden = true;
        syncRecipePanel();
    }

    function editRecipe(row, source = 'table') {
        if (Number(row.product_id) > 0 && Number(state.activeProductId) !== Number(row.product_id)) {
            state.activeProductId = Number(row.product_id);
            renderCatalogTables();
        }
        recipeForm.dataset.recipeId = String(row.id || '');
        recipeForm.elements.namedItem('product_id').value = row.product_id || '';
        recipeForm.elements.namedItem('ingredient_id').value = row.ingredient_id || '';
        recipeForm.elements.namedItem('unit_id').value = row.unit_id || '';
        recipeForm.elements.namedItem('qty').value = normalizeTwoDecimalQuantity(row.qty, '1.00');
        recipeForm.elements.namedItem('notes').value = row.notes || '';
        setFocusNote('#recipe-focus-note', source === 'history' ? 'Reviewing this recipe line from activity history. Confirm the product, ingredient, and quantity before saving.' : '');
        $('#recipe-submit').textContent = 'Update Recipe Line';
        $('#recipe-cancel').hidden = false;
        syncRecipePanel();
        recipeForm.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    async function deleteRecipe(row) {
        if (!confirmDelete('Delete this recipe line? This cannot be undone.')) {
            return;
        }

        await submitJson(api.recipesDelete, {
            id: row.id
        }, 'Recipe line deleted.', async () => {
            if (recipeForm.dataset.recipeId === String(row.id)) {
                resetRecipeForm();
            }
            await loadRecipes();
            await loadProducts();
        });
    }

    async function deleteProduct(row) {
        if (!confirmDelete('Delete this product? Its recipe lines will also be deleted. This cannot be undone.')) {
            return;
        }

        await submitJson(api.productsDelete, {
            id: row.id
        }, 'Product deleted.', async () => {
            if (productForm.elements.namedItem('id').value === String(row.id)) {
                resetProductForm();
            }
            await loadProducts();
            await loadRecipes();
        });
    }

    async function deleteIngredient(row) {
        if (!confirmDelete('Delete this ingredient? This cannot be undone.')) {
            return;
        }

        await submitJson(api.ingredientsDelete, {
            id: row.id
        }, 'Ingredient deleted.', async () => {
            if (ingredientForm.elements.namedItem('id').value === String(row.id)) {
                resetIngredientForm();
            }
            await loadIngredients();
            await loadRecipes();
        });
    }

    async function deleteDelivery(row) {
        if (!confirmDelete('Delete this delivery and its item lines? This cannot be undone.')) {
            return;
        }

        await submitJson(api.deliveriesDelete, {
            id: row.id
        }, 'Delivery deleted.', async () => {
            await loadDeliveries();
            await loadUsage();
        });
    }

    async function deleteProductionRun(row) {
        if (!confirmDelete('Delete this production run and its snapshot lines? This cannot be undone.')) {
            return;
        }

        await submitJson(api.productionDelete, {
            id: row.id
        }, 'Production run deleted.', async () => {
            await loadProduction();
            await loadUsage();
        });
    }

    async function toggleActive(kind, row) {
        const rowId = normalizedRowId(kind, row);
        if (!Number.isFinite(rowId) || rowId <= 0) {
            showBanner('Selected ' + String(kind || 'record') + ' could not be resolved.', false);
            return;
        }

        const nextActive = Number(row.is_active) === 0 ? 1 : 0;
        if (kind === 'branch') {
            await submitJson(api.branchStatus.replace('[id]', encodeURIComponent(String(rowId))), {
                is_active: nextActive
            }, nextActive === 1 ? 'Branch restored.' : 'Branch archived.', async () => {
                if (branchForm.elements.namedItem('id').value === String(row.id)) {
                    resetBranchForm();
                }
                await loadBranches();
            });
            return;
        }

        if (kind === 'product') {
            await submitJson(api.productStatus.replace('[id]', encodeURIComponent(String(rowId))), {
                is_active: nextActive
            }, nextActive === 1 ? 'Product restored.' : 'Product archived.', async () => {
                if (productForm.elements.namedItem('id').value === String(row.id)) {
                    resetProductForm();
                }
                await loadProducts();
                await loadRecipes();
            });
            return;
        }

        if (kind === 'ingredient') {
            await submitJson(api.ingredientStatus.replace('[id]', encodeURIComponent(String(rowId))), {
                is_active: nextActive
            }, nextActive === 1 ? 'Ingredient restored.' : 'Ingredient archived.', async () => {
                if (ingredientForm.elements.namedItem('id').value === String(row.id)) {
                    resetIngredientForm();
                }
                await loadIngredients();
                await loadRecipes();
            });
        }
    }

    function findStateRow(kind, id) {
        const numericId = Number(id);
        if (kind === 'branch') {
            return state.branches.find((row) => Number(row.id) === numericId) || null;
        }
        if (kind === 'product') {
            return state.products.find((row) => Number(row.id) === numericId) || null;
        }
        if (kind === 'ingredient') {
            return state.ingredients.find((row) => Number(row.id) === numericId) || null;
        }
        if (kind === 'recipe') {
            return state.recipes.find((row) => Number(row.id) === numericId) || null;
        }
        if (kind === 'delivery') {
            return state.deliveries.find((row) => Number(row.id) === numericId) || null;
        }
        if (kind === 'production') {
            return state.production.find((row) => Number(row.id) === numericId) || null;
        }
        return null;
    }

    function bindMaintenanceActions(selector) {
        $(selector).addEventListener('click', async (event) => {
            const button = event.target.closest('[data-action]');
            if (!button) {
                return;
            }

            const kind = button.getAttribute('data-kind');
            const buttonRowId = Number(button.getAttribute('data-id') || '0');
            if (!Number.isFinite(buttonRowId) || buttonRowId <= 0) {
                showBanner('Selected record could not be resolved.', false);
                return;
            }

            const row = findStateRow(kind, buttonRowId);
            if (!row) {
                showBanner('Selected record could not be found.', false);
                return;
            }

            if (button.getAttribute('data-action') === 'edit') {
                if (kind === 'branch') {
                    editBranch(row);
                } else if (kind === 'product') {
                    editProduct(row);
                } else if (kind === 'ingredient') {
                    editIngredient(row);
                }
                clearBanner();
                return;
            }

            if (button.getAttribute('data-action') === 'delete') {
                if (kind === 'product') {
                    await deleteProduct(row);
                    return;
                }
                if (kind === 'ingredient') {
                    await deleteIngredient(row);
                    return;
                }
            }

            await toggleActive(kind, row);
        });
    }

    $('#branch-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        await submitJson(api.branches, {
            id: form.elements.namedItem('id').value,
            is_active: form.elements.namedItem('is_active').value,
            code: form.elements.namedItem('code').value,
            name: form.elements.namedItem('name').value,
            address: form.elements.namedItem('address').value
        }, form.elements.namedItem('id').value ? 'Branch updated.' : 'Branch saved.', async () => {
            resetBranchForm();
            await loadBranches();
        });
    });

    $('#product-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        await submitJson(api.products, {
            id: form.elements.namedItem('id').value,
            is_active: form.elements.namedItem('is_active').value,
            name: form.elements.namedItem('name').value,
            sku: form.elements.namedItem('sku').value,
            category: form.elements.namedItem('category').value,
            default_yield_qty: normalizeTwoDecimalQuantity(form.elements.namedItem('default_yield_qty').value, '1.00'),
            default_yield_unit_id: form.elements.namedItem('default_yield_unit_id').value
        }, form.elements.namedItem('id').value ? 'Product updated.' : 'Product saved.', async () => {
            const savedProductId = Number(form.elements.namedItem('id').value || 0);
            await loadProducts();
            await loadRecipes();
            if (savedProductId > 0) {
                const savedRow = state.products.find((row) => Number(row.id) === savedProductId);
                if (savedRow) {
                    editProduct(savedRow);
                    return;
                }
            }
            resetProductForm();
        });
    });

    $('#ingredient-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        await submitJson(api.ingredients, {
            id: form.elements.namedItem('id').value,
            is_active: form.elements.namedItem('is_active').value,
            name: form.elements.namedItem('name').value,
            sku: form.elements.namedItem('sku').value,
            default_unit_id: form.elements.namedItem('default_unit_id').value
        }, form.elements.namedItem('id').value ? 'Ingredient updated.' : 'Ingredient saved.', async () => {
            resetIngredientForm();
            await loadIngredients();
            await loadRecipes();
        });
    });

    $('#branch-cancel').addEventListener('click', resetBranchForm);
    $('#product-add').addEventListener('click', () => {
        resetProductForm();
        productForm.elements.namedItem('name').focus();
    });
    $('#product-cancel').addEventListener('click', resetProductForm);
    $('#ingredient-cancel').addEventListener('click', resetIngredientForm);
    $('#recipe-cancel').addEventListener('click', resetRecipeForm);

    $('#recipe-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        await submitJson(api.recipes, {
            product_id: form.product_id.value,
            ingredient_id: form.ingredient_id.value,
            unit_id: form.unit_id.value,
            qty: normalizeTwoDecimalQuantity(form.qty.value, '1.00'),
            notes: form.notes.value
        }, form.dataset.recipeId ? 'Recipe line updated.' : 'Recipe line saved.', async () => {
            resetRecipeForm();
            await loadRecipes();
            await loadProducts();
        });
    });

    $('#delivery-sheet-filter').addEventListener('input', filterDeliverySheet);
    ['#branches-filter'].forEach((selector) => {
        const input = $(selector);
        if (input) {
            input.addEventListener('input', renderBranchTables);
        }
    });
    ['#recipes-filter', '#ingredients-filter', '#production-products-filter'].forEach((selector) => {
        const input = $(selector);
        if (input) {
            input.addEventListener('input', renderCatalogTables);
        }
    });
    ['#deliveries-filter', '#production-filter'].forEach((selector) => {
        const input = $(selector);
        if (input) {
            input.addEventListener('input', renderOperationalTables);
        }
    });
    ['#usage-filter', '#inventory-filter'].forEach((selector) => {
        const input = $(selector);
        if (input) {
            input.addEventListener('input', renderUsage);
        }
    });
    $('#delivery-sheet-clear').addEventListener('click', () => {
        clearDeliverySheetValues();
        showBanner('Daily delivery sheet cleared.', true);
    });
    $('#delivery-csv-template').addEventListener('click', downloadDeliveryCsvTemplate);
    deliveryCsvFile.addEventListener('change', async (event) => {
        const file = event.currentTarget.files && event.currentTarget.files[0];
        if (!file) {
            return;
        }

        try {
            const text = await file.text();
            importDeliveryCsv(text);
        } catch (error) {
            showBanner(error.message || 'Unable to import CSV.', false);
        }
    });

    $('#delivery-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        const items = collectDeliveryItems();
        if (!items.length) {
            showBanner('Enter at least one received quantity or import a CSV before saving.', false);
            return;
        }

        const preservedBranch = form.branch_id.value;
        const preservedDeliveredAt = form.delivered_at.value;
        const preservedReceivedBy = form.received_by.value;
        const preservedSourceType = form.source_type.value;
        const preservedSourceName = form.source_name.value;
        await submitJson(api.deliveries, {
            branch_id: form.branch_id.value,
            delivered_at: form.delivered_at.value,
            reference: form.reference.value,
            source_type: form.source_type.value,
            source_name: form.source_name.value,
            received_by: form.received_by.value,
            notes: form.notes.value,
            items: items
        }, 'Delivery saved.', async () => {
            form.reference.value = '';
            form.notes.value = '';
            form.branch_id.value = preservedBranch;
            form.delivered_at.value = preservedDeliveredAt || nowLocalDate();
            form.received_by.value = preservedReceivedBy;
            form.source_type.value = preservedSourceType || 'commissary';
            form.source_name.value = preservedSourceName;
            syncDeliverySourceField();
            clearDeliverySheetValues();
            await loadDeliveries();
            await loadUsage();
        });
    });

    $('#production-products-table').addEventListener('click', (event) => {
        const qtyInput = event.target.closest('input[data-production-qty-id]');
        if (qtyInput) {
            const row = state.products.find((item) => Number(item.id) === Number(qtyInput.getAttribute('data-production-qty-id') || '0') && Number(item.is_active) !== 0);
            if (!row) {
                showBanner('Selected product could not be found.', false);
                return;
            }

            selectProductionProduct(row);
            return;
        }

        const rowElement = event.target.closest('tr[data-row-kind="production-product"]');
        if (!rowElement) {
            return;
        }

        const row = state.products.find((item) => Number(item.id) === Number(rowElement.getAttribute('data-row-id') || '0') && Number(item.is_active) !== 0);
        if (!row) {
            showBanner('Selected product could not be found.', false);
            return;
        }

        selectProductionProduct(row, { focusQty: true });
    });

    $('#production-products-table').addEventListener('input', (event) => {
        const qtyInput = event.target.closest('input[data-production-qty-id]');
        if (!qtyInput) {
            return;
        }

        const row = state.products.find((item) => Number(item.id) === Number(qtyInput.getAttribute('data-production-qty-id') || '0') && Number(item.is_active) !== 0);
        if (!row) {
            return;
        }

        selectProductionProduct(row);
    });

    $('#production-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        const selectedProduct = selectedProductionProductRecord();
        if (!selectedProduct || !form.product_id.value) {
            showBanner('Select a product from the table before saving a production run.', false);
            return;
        }

        const selectedQtyInput = productionQtyInputFor(selectedProduct.id);
        const qtyProduced = selectedQtyInput ? selectedQtyInput.value : '';
        if (!qtyProduced) {
            showBanner('Enter the quantity to produce in the selected product row before saving.', false);
            return;
        }

        await submitJson(api.production, {
            branch_id: form.branch_id.value,
            product_id: form.product_id.value,
            produced_at: form.produced_at.value,
            qty_produced: qtyProduced,
            produced_by: form.produced_by.value,
            notes: form.notes.value
        }, 'Production run saved.', async () => {
            form.reset();
            form.produced_at.value = nowLocalDateTime();
            document.querySelectorAll('#production-products-table tbody input[data-production-qty-id]').forEach((input) => {
                input.value = '';
            });
            syncProductionProductSelection();
            await loadProduction();
            await loadUsage();
        });
    });

    if (permissionsForm && canManageSettings) {
        permissionsForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            await submitJson(api.permissionsSettings, {
                role_permissions: {
                    supervisor: [
                        permissionsForm.elements.namedItem('supervisor_read').checked ? 'bakeshop.read' : '',
                        permissionsForm.elements.namedItem('supervisor_manage').checked ? 'bakeshop.manage' : ''
                    ].filter(Boolean)
                }
            }, 'Access settings updated.');
        });
    }

    $('#usage-form').addEventListener('submit', async (event) => {
        event.preventDefault();
        try {
            await loadUsage();
            showBanner('Usage summary refreshed.', true);
        } catch (error) {
            showBanner(error.message || 'Unable to load usage summary.', false);
        }
    });

    $('#bakeshop-refresh').addEventListener('click', async () => {
        try {
            await loadEverything();
            showBanner('Bakeshop data refreshed.', true);
        } catch (error) {
            showBanner(error.message || 'Unable to refresh data.', false);
        }
    });

    ['#usage-branch', '#usage-from', '#usage-to', '#summary-branch-filter', '#summary-from-filter', '#summary-to-filter'].forEach((selector) => {
        $(selector).addEventListener('change', syncPrintLink);
    });

    bindMaintenanceActions('#branches-table');
    bindMaintenanceActions('#products-table');
    bindMaintenanceActions('#ingredients-table');
    $('#recipes-table').addEventListener('click', async (event) => {
        const button = event.target.closest('[data-action]');
        if (!button) {
            return;
        }

        const row = findStateRow('recipe', button.getAttribute('data-id'));
        if (!row) {
            showBanner('Selected recipe line could not be found.', false);
            return;
        }

        if (button.getAttribute('data-action') === 'edit-recipe') {
            editRecipe(row);
            clearBanner();
            return;
        }

        await deleteRecipe(row);
    });

    $('#deliveries-table').addEventListener('click', async (event) => {
        const button = event.target.closest('[data-action="delete-delivery"]');
        if (!button) {
            return;
        }

        const row = findStateRow('delivery', button.getAttribute('data-id'));
        if (!row) {
            showBanner('Selected delivery could not be found.', false);
            return;
        }

        await deleteDelivery(row);
    });

    $('#production-table').addEventListener('click', async (event) => {
        const button = event.target.closest('[data-action="delete-production"]');
        if (!button) {
            return;
        }

        const row = findStateRow('production', button.getAttribute('data-id'));
        if (!row) {
            showBanner('Selected production run could not be found.', false);
            return;
        }

        await deleteProductionRun(row);
    });

    $('#delivery-at').value = nowLocalDate();
    $('#delivery-source-type').value = 'commissary';
    syncDeliverySourceField();
    $('#delivery-source-type').addEventListener('change', syncDeliverySourceField);
    $('#production-at').value = nowLocalDateTime();
    resetBranchForm();
    resetProductForm();
    resetIngredientForm();
    resetRecipeForm();
    syncPrintLink();

    if (searchParams.get('onboarding') === 'bootstrap') {
        showBanner('Bootstrap onboarding is still active. You can review live workspace data here while finishing the staff handoff.', true);
    }

    loadEverything().catch((error) => {
        showBanner(error.message || 'Unable to load initial bakeshop data.', false);
    });
});
</script>
{/block}