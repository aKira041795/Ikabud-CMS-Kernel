        }

        const message = normalizedIds.length === 1
            ? 'Delete this delivery and its item lines? This cannot be undone.'
            : 'Delete ' + String(normalizedIds.length) + ' selected deliveries and their item lines? This cannot be undone.';
        const shouldDelete = normalizedIds.length === 1
            ? confirmDelete(message)
            : await confirmBulkDelete({
                title: 'Delete selected deliveries?',
                message,
                impact: 'Each selected delivery also removes its received ingredient lines from daily receiving history.',
                items: normalizedIds.map((id) => deliveryDeletePreviewLabel(findStateRow('delivery', id), id)),
                confirmLabel: 'Delete Deliveries'
            });
        if (!shouldDelete) {
            return;
        }

        let deletedCount = 0;
        const failedLabels = [];
        for (const id of normalizedIds) {
            const row = findStateRow('delivery', id);
            try {
                await request(api.deliveriesDelete, {
                    method: 'POST',
                    body: JSON.stringify({ _token: csrfToken, id })
                });
                deletedCount += 1;
                state.selectedDeliveryIds.delete(id);
                if (Number(state.expandedDeliveryId || 0) === id) {
                    state.expandedDeliveryId = 0;
                }
            } catch (error) {
                failedLabels.push((row && row.reference) ? row.reference : ('ID ' + String(id)));
            }
        }

        await loadDeliveries(true);
        await loadUsage();

        if (deletedCount > 0 && failedLabels.length === 0) {
            showBanner(deletedCount === 1 ? 'Delivery deleted.' : ('Deleted ' + String(deletedCount) + ' deliveries.'), true);
            return;
        }
        if (deletedCount > 0) {
            showBanner('Deleted ' + String(deletedCount) + ' deliveries. Failed: ' + failedLabels.slice(0, 3).join(', ') + (failedLabels.length > 3 ? '...' : '') + '.', false);
            return;
        }

        showBanner('Unable to delete the selected deliveries.', false);
    }

