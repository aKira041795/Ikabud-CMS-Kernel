{extends "modules/bakeshop/layouts/app.disyl"}

{block head}
<style>
    .bakeshop-shell { display: grid; gap: 24px; }
    .bakeshop-header { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px; }
    .bakeshop-header h2 { font-size: var(--font-size-h2); font-weight: 700; margin-bottom: 6px; }
    .bakeshop-header p { color: var(--text-muted); margin: 0; max-width: 56rem; }
    .bakeshop-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .bakeshop-shell,
    .bakeshop-shell * {
        color: var(--text-color);
    }
    .bakeshop-flow {
        display: grid;
        gap: 14px;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }
    .bakeshop-flow-step {
        border: 1px solid var(--border-color);
        border-radius: 14px;
        background: linear-gradient(180deg, #f7faff 0%, #ffffff 100%);
        padding: 18px;
        box-shadow: 0 10px 24px rgba(37, 99, 235, 0.05);
    }
    .bakeshop-flow-step strong {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 999px;
        background: var(--accent);
        color: #fff;
        font-size: 0.86rem;
        margin-bottom: 10px;
    }
    .bakeshop-flow-step h3 {
        margin: 0 0 8px;
        font-size: 0.98rem;
    }
    .bakeshop-flow-step p {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.9rem;
        line-height: 1.5;
    }
    .bakeshop-button,
    .bakeshop-shell button,
    .bakeshop-shell input,
    .bakeshop-shell select,
    .bakeshop-shell textarea { font: inherit; }
    .bakeshop-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 2px;
        border: 1px solid #1d4ed8;
        background: #2563eb;
        color: #ffffff;
        padding: 10px 16px;
        text-decoration: none;
        font-size: 0.92rem;
        cursor: pointer;
    }
    .bakeshop-button:hover {
        background: #1d4ed8;
    }
    .bakeshop-button.secondary {
        background: #2563eb;
        color: #ffffff;
        border-color: #1d4ed8;
    }
    .bakeshop-button.secondary:hover {
        background: #1d4ed8;
    }
    .bakeshop-button.print {
        background: #6b7280;
        border-color: #6b7280;
        color: #ffffff;
    }
    .bakeshop-button.print:hover {
        background: #4b5563;
    }
    .bakeshop-button.staff {
        background: #eab308;
        border-color: #ca8a04;
        color: #111827;
    }
    .bakeshop-button.staff:hover {
        background: #ca8a04;
        color: #111827;
    }
    .bakeshop-button.refresh {
        background: #f97316;
        border-color: #ea580c;
        color: #ffffff;
    }
    .bakeshop-button.refresh:hover {
        background: #ea580c;
    }
    .bakeshop-button.success {
        background: #16a34a;
        border-color: #15803d;
        color: #ffffff;
    }
    .bakeshop-button.success:hover {
        background: #15803d;
    }
    .bakeshop-button.danger {
        background: #dc2626;
        border-color: #b91c1c;
        color: #ffffff;
    }
    .bakeshop-button.danger:hover {
        background: #b91c1c;
    }
    .bakeshop-button:disabled,
    .bakeshop-button.secondary:disabled,
    .bakeshop-button.print:disabled,
    .bakeshop-button.staff:disabled,
    .bakeshop-button.refresh:disabled,
    .bakeshop-button.success:disabled,
    .bakeshop-button.danger:disabled {
        background: #d1d5db;
        border-color: #cbd5e1;
        color: #6b7280;
        cursor: not-allowed;
        box-shadow: none;
        opacity: 0.72;
        pointer-events: none;
    }
    .bakeshop-button:disabled:hover,
    .bakeshop-button.secondary:disabled:hover,
    .bakeshop-button.print:disabled:hover,
    .bakeshop-button.staff:disabled:hover,
    .bakeshop-button.refresh:disabled:hover,
    .bakeshop-button.success:disabled:hover,
    .bakeshop-button.danger:disabled:hover {
        background: #d1d5db;
        border-color: #cbd5e1;
        color: #6b7280;
    }
    .bakeshop-banner {
        display: none;
        padding: 14px 16px;
        border-radius: 14px;
        border: 1px solid transparent;
        font-size: 0.92rem;
    }
    .bakeshop-banner.show { display: block; }
    .bakeshop-banner.ok { background: #eff6ff; border-color: #bfdbfe; color: #1d4ed8; }
    .bakeshop-banner.error { background: #fff3f2; border-color: #fecaca; color: #991b1b; }
    .bakeshop-readonly-note {
        padding: 14px 16px;
        border-radius: 14px;
        border: 1px solid #fde68a;
        background: #fffbeb;
        color: #92400e;
        line-height: 1.55;
    }
    .bakeshop-onboarding {
        display: grid;
        gap: 10px;
        padding: 16px 18px;
        border-radius: 14px;
        border: 1px solid #f3d7a5;
        background: linear-gradient(135deg, #fff7ed, #fffbeb);
        box-shadow: 0 14px 30px rgba(180, 83, 9, 0.08);
    }
    .bakeshop-onboarding h3 { margin: 0; }
    .bakeshop-onboarding p { margin: 0; color: #7c5a32; line-height: 1.6; }
    .bakeshop-onboarding strong { color: #92400e; }
    .bakeshop-stats { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
    .bakeshop-stat {
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 18px;
        background: linear-gradient(180deg, #ffffff 0%, #f3f8ff 100%);
    }
    .bakeshop-stat strong { display: block; font-size: 1.7rem; line-height: 1; }
    .bakeshop-stat span { display: block; margin-top: 8px; color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; }
    .bakeshop-layout { display: grid; gap: 20px; grid-template-columns: minmax(0, 1fr); }
    .bakeshop-column { display: grid; gap: 20px; align-content: start; }
    .bakeshop-panel {
        border: 1px solid var(--border-color);
        border-radius: 14px;
        background: var(--surface-color, #fff);
        overflow: hidden;
        box-shadow: 0 14px 32px rgba(37, 99, 235, 0.05);
        transition: background 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
    }
    .bakeshop-panel-subdued {
        box-shadow: none;
        border: 1px dashed var(--border-color);
        margin-top: 8px;
    }
    .bakeshop-panel.is-editing {
        border-color: #93c5fd;
        background: linear-gradient(180deg, #f7fbff 0%, #eef6ff 100%);
        box-shadow: 0 18px 40px rgba(37, 99, 235, 0.12);
    }
    .bakeshop-panel.is-editing .bakeshop-panel-head {
        background: linear-gradient(180deg, rgba(219, 234, 254, 0.7) 0%, rgba(239, 246, 255, 0.25) 100%);
    }
    .bakeshop-panel.is-editing .bakeshop-panel-body {
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.55) 0%, rgba(239, 246, 255, 0.85) 100%);
    }
    .bakeshop-panel-head {
        padding: 18px 20px 12px;
        border-bottom: 1px solid color-mix(in srgb, var(--border-color) 85%, transparent);
    }
    .bakeshop-panel-head h3 { margin: 0 0 6px; font-size: 1rem; }
    .bakeshop-panel-head p { margin: 0; color: var(--text-muted); font-size: 0.9rem; }
    .bakeshop-panel-body { padding: 18px 20px 20px; display: grid; gap: 16px; }
    .bakeshop-grid-2 { display: grid; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bakeshop-grid-3 { display: grid; gap: 12px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .bakeshop-field { display: grid; gap: 6px; }
    .bakeshop-field label { font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); }
    .bakeshop-field input,
    .bakeshop-field select,
    .bakeshop-field textarea {
        width: 100%;
        border-radius: 2px;
        border: 1px solid #d1d5db;
        background: #fff;
        color: #111827;
        padding: 11px 12px;
    }
    .bakeshop-field textarea { min-height: 92px; resize: vertical; }
    .bakeshop-form-actions { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
    .bakeshop-form-actions.bakeshop-view-tabs { justify-content: flex-start; align-items: center; gap: 14px; }
    .bakeshop-view-tabs .bakeshop-help { margin: 0; }
    .bakeshop-help { font-size: 0.82rem; color: var(--text-muted); }
    .bakeshop-setup-shell { display: grid; gap: 18px; }
    .bakeshop-tabs {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        padding: 8px;
        border-radius: 14px;
        background: #eef4ff;
        border: 1px solid #d6e4ff;
    }
    .bakeshop-tab {
        border: 1px solid transparent;
        background: transparent;
        color: #35517a;
        border-radius: 10px;
        padding: 10px 14px;
        font-weight: 600;
        cursor: pointer;
    }
    .bakeshop-tab.active {
        background: #ffffff;
        border-color: #bfd5ff;
        color: var(--accent-strong);
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.08);
    }
    .bakeshop-tab-panel { display: none; }
    .bakeshop-tab-panel.active { display: block; }
    .bakeshop-section-tabs {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        padding: 8px;
        border-radius: 14px;
        background: linear-gradient(180deg, #ecfdf3 0%, #f8fffb 100%);
        border: 1px solid #b7e4c7;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }
    .bakeshop-section-tab {
        border: 1px solid #a7d7b5;
        background: linear-gradient(180deg, #f4fff7 0%, #e8f8ee 100%);
        color: #21543a;
        border-radius: 10px;
        padding: 10px 16px;
        font-weight: 700;
        box-shadow: 0 4px 12px rgba(22, 101, 52, 0.08);
        cursor: pointer;
        transition: transform 120ms ease, box-shadow 120ms ease, background 120ms ease, border-color 120ms ease, color 120ms ease;
    }
    .bakeshop-section-tab:hover,
    .bakeshop-section-tab:focus-visible {
        border-color: #63b37d;
        box-shadow: 0 10px 22px rgba(22, 101, 52, 0.14);
        transform: translateY(-1px);
        outline: none;
    }
    .bakeshop-section-tab.active {
        background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
        border-color: #1d4ed8;
        color: #ffffff;
        box-shadow: 0 12px 26px rgba(37, 99, 235, 0.24);
    }
    .bakeshop-section-panel { display: none; }
    .bakeshop-section-panel.active { display: grid; gap: 16px; }
    .bakeshop-tab-summary {
        display: grid;
        gap: 6px;
        padding: 0 2px;
    }
    .bakeshop-tab-summary h3 {
        margin: 0;
        font-size: 1.02rem;
    }
    .bakeshop-tab-summary p {
        margin: 0;
        color: var(--text-muted);
        max-width: 58rem;
    }
    .bakeshop-table-wrap { overflow: auto; }
    .bakeshop-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    .bakeshop-table th,
    .bakeshop-table td { padding: 10px 12px; border-bottom: 1px solid var(--border-color); text-align: left; vertical-align: top; }
    .bakeshop-table th { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); }
    .bakeshop-table th.bakeshop-checkbox-cell,
    .bakeshop-table td.bakeshop-checkbox-cell { width: 44px; padding-right: 8px; padding-left: 12px; text-align: center; }
    .bakeshop-table tr:last-child td { border-bottom: none; }
    .bakeshop-table tr.bakeshop-row-selectable { cursor: pointer; }
    .bakeshop-table tr.bakeshop-row-selectable:hover td {
        background: #f8fbff;
    }
    .bakeshop-table-input {
        width: 100%;
        min-width: 110px;
        border-radius: 2px;
        border: 1px solid #d1d5db;
        background: #fff;
        color: #111827;
        padding: 8px 10px;
        font: inherit;
    }
    .bakeshop-table tr.bakeshop-row-focus td {
        background: #fff8db;
        box-shadow: inset 0 0 0 1px rgba(234, 179, 8, 0.22);
    }
    .bakeshop-table tr.bakeshop-row-editing td {
        background: #eef6ff;
        box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.18);
    }
    .bakeshop-table tr.bakeshop-row-recent td {
        background: linear-gradient(180deg, rgba(220, 252, 231, 0.95) 0%, rgba(240, 253, 244, 0.75) 100%);
    }
    .bakeshop-muted { color: var(--text-muted); }
    .bakeshop-delivery-sheet input[type="number"] { min-width: 110px; }
    .bakeshop-delivery-sheet tr.is-imported td { background: #effaf4; }
    .bakeshop-inline-note { font-size: 0.82rem; color: var(--text-muted); }
    .bakeshop-inline-note.ok { color: #15803d; }
    .bakeshop-inline-note.error { color: #b91c1c; }
    .bakeshop-review-card {
        display: grid;
        gap: 10px;
        padding: 16px 18px;
        border-radius: 14px;
        border: 1px solid #bbf7d0;
        background: linear-gradient(180deg, #f0fdf4 0%, #ffffff 100%);
    }
    .bakeshop-review-card strong {
        display: block;
        margin-bottom: 4px;
    }
    .bakeshop-review-card p {
        margin: 0;
        color: var(--text-muted);
        line-height: 1.5;
    }
    .bakeshop-detail-stack { display: grid; gap: 6px; }
    .bakeshop-detail-list { display: grid; gap: 4px; margin-top: 2px; }
    .bakeshop-detail-list span { display: block; color: var(--text-muted); font-size: 0.82rem; }
    .bakeshop-row-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .bakeshop-checkbox {
        width: 16px;
        height: 16px;
        cursor: pointer;
        accent-color: #2563eb;
    }
    .bakeshop-bulk-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }
    .bakeshop-bulk-actions .bakeshop-help { margin: 0; }
    .bakeshop-inline-tabs {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 8px;
        border-radius: 14px;
        background: linear-gradient(180deg, #ecfdf3 0%, #f8fffb 100%);
        border: 1px solid #b7e4c7;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
    }
    .bakeshop-inline-tab {
        border: 1px solid #a7d7b5;
        background: linear-gradient(180deg, #f4fff7 0%, #e8f8ee 100%);
        color: #21543a;
        border-radius: 10px;
        padding: 9px 14px;
        font-weight: 700;
        box-shadow: 0 4px 12px rgba(22, 101, 52, 0.08);
        cursor: pointer;
        transition: transform 120ms ease, box-shadow 120ms ease, background 120ms ease, border-color 120ms ease, color 120ms ease;
    }
    .bakeshop-inline-tab:hover,
    .bakeshop-inline-tab:focus-visible {
        border-color: #63b37d;
        box-shadow: 0 10px 22px rgba(22, 101, 52, 0.14);
        transform: translateY(-1px);
        outline: none;
    }
    .bakeshop-inline-tab.active {
        background: linear-gradient(180deg, #2563eb 0%, #1d4ed8 100%);
        border-color: #1d4ed8;
        color: #ffffff;
        box-shadow: 0 12px 26px rgba(37, 99, 235, 0.24);
    }
    .bakeshop-inline-tab-count {
        color: var(--text-muted);
        font-weight: 500;
        margin-left: 6px;
    }
    .bakeshop-inline-tab.active .bakeshop-inline-tab-count {
        color: rgba(255, 255, 255, 0.88);
    }
    body.bakeshop-confirm-open { overflow: hidden; }
    .bakeshop-confirm-backdrop {
        position: fixed;
        inset: 0;
        z-index: 80;
        display: grid;
        place-items: center;
        padding: 24px;
        background: rgba(15, 23, 42, 0.46);
    }
    .bakeshop-confirm-backdrop[hidden] {
        display: none;
    }
    .bakeshop-confirm-panel {
        width: min(100%, 560px);
        display: grid;
        gap: 16px;
        border-radius: 16px;
        border: 1px solid rgba(248, 113, 113, 0.35);
        background: #ffffff;
        box-shadow: 0 28px 70px rgba(15, 23, 42, 0.28);
        padding: 22px;
    }
    .bakeshop-confirm-panel h3 {
        margin: 0;
        font-size: 1.08rem;
    }
    .bakeshop-confirm-panel p {
        margin: 0;
        color: var(--text-muted);
        line-height: 1.55;
    }
    .bakeshop-confirm-impact {
        padding: 10px 12px;
        border-radius: 12px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #9a3412;
        font-size: 0.86rem;
    }
    .bakeshop-confirm-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 8px;
    }
    .bakeshop-confirm-list li {
        padding: 10px 12px;
        border-radius: 12px;
        border: 1px solid var(--border-color);
        background: #f8fafc;
        color: #0f172a;
        font-size: 0.9rem;
    }
    .bakeshop-confirm-overflow {
        font-size: 0.84rem;
        color: var(--text-muted);
    }
    .bakeshop-link-button {
        border: none;
        background: transparent;
        color: var(--accent-strong);
        cursor: pointer;
        padding: 0;
        font: inherit;
    }
    .bakeshop-link-button.warn { color: #b91c1c; }
    .bakeshop-chip {
        display: inline-flex;
        align-items: center;
        padding: 4px 9px;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .bakeshop-chip.active { background: #eff6ff; color: #1d4ed8; }
    .bakeshop-chip.inactive { background: #eef2f7; color: #51627b; }
    .bakeshop-chip.recent { background: #dcfce7; color: #166534; }
    .bakeshop-focus-note {
        padding: 10px 12px;
        border-radius: 12px;
        background: #fff8db;
        color: #854d0e;
        font-size: 0.85rem;
    }
    .bakeshop-summary-meta { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); }
    .bakeshop-summary-meta div { border: 1px solid var(--border-color); border-radius: 12px; padding: 12px; background: #fff; }
    .bakeshop-summary-note {
        padding: 12px 14px;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        background: #fff;
        color: var(--text-muted);
        line-height: 1.55;
    }
    .bakeshop-summary-groups { display: grid; gap: 16px; }
    .bakeshop-summary-group {
        border: 1px solid var(--border-color);
        border-radius: 12px;
        background: #fff;
        overflow: hidden;
    }
    .bakeshop-summary-group-head {
        padding: 14px 16px 10px;
        border-bottom: 1px solid var(--border-color);
        display: grid;
        gap: 4px;
    }
    .bakeshop-summary-group-head h4 {
        margin: 0;
        font-size: 1rem;
    }
    .bakeshop-summary-group-head p {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.88rem;
    }
    .bakeshop-summary-ingredient strong {
        display: block;
    }
    .bakeshop-summary-ingredient span {
        color: var(--text-muted);
        font-size: 0.84rem;
    }
    .bakeshop-summary-meta p { margin: 6px 0 0; color: var(--text-muted); }
    .bakeshop-empty {
        padding: 18px;
        border: 1px dashed var(--border-color);
        border-radius: 12px;
        color: var(--text-muted);
        background: #fff;
    }
    @media (max-width: 1100px) {
        .bakeshop-layout { grid-template-columns: 1fr; }
    }
    @media (max-width: 760px) {
        .bakeshop-tabs { display: grid; grid-template-columns: 1fr; }
        .bakeshop-grid-2,
        .bakeshop-grid-3,
        .bakeshop-delivery-line { grid-template-columns: 1fr; }
    }
</style>
{/block}

{block content}
<div class="bakeshop-shell">
    <div class="bakeshop-header" style="justify-content:flex-end;">
        <div class="bakeshop-actions">
            {if can_manage_users}
            <a class="bakeshop-button staff" href="{base_url}/admin/bakeshop/users">Manage Staff</a>
            {/if}
            <a class="bakeshop-button print" id="bakeshop-print-link" href="{if current_page == 'dashboard'}{base_url}{summary_report.print_url}{else}{base_url}/admin/bakeshop/print{/if}" target="_blank" rel="noopener">Open Print Summary</a>
            <button class="bakeshop-button refresh" type="button" id="bakeshop-refresh">Refresh Data</button>
        </div>
    </div>

    <div class="bakeshop-banner" id="bakeshop-banner"></div>

    <div class="bakeshop-confirm-backdrop" id="bakeshop-delete-confirm" hidden>
        <div class="bakeshop-confirm-panel" role="dialog" aria-modal="true" aria-labelledby="bakeshop-delete-confirm-title" aria-describedby="bakeshop-delete-confirm-message">
            <div class="bakeshop-shell" style="gap: 12px;">
                <h3 id="bakeshop-delete-confirm-title">Delete selected records?</h3>
                <p id="bakeshop-delete-confirm-message">Review the selected items before confirming this delete.</p>
                <div class="bakeshop-confirm-impact" id="bakeshop-delete-confirm-impact" hidden></div>
                <ul class="bakeshop-confirm-list" id="bakeshop-delete-confirm-list" hidden></ul>
                <p class="bakeshop-confirm-overflow" id="bakeshop-delete-confirm-overflow" hidden></p>
            </div>
            <div class="bakeshop-actions" style="justify-content: flex-end;">
                <button class="bakeshop-button secondary" type="button" id="bakeshop-delete-confirm-cancel">Cancel</button>
                <button class="bakeshop-button danger" type="button" id="bakeshop-delete-confirm-submit">Delete Selected</button>
            </div>
        </div>
    </div>

    {if !can_manage_workspace}
    <div class="bakeshop-readonly-note">This workspace is currently read only for your role. You can review setup, deliveries, production, and usage here, but saving changes requires <strong>bakeshop.manage</strong>.</div>
    {/if}

    {if bootstrap_onboarding.required && can_manage_users}
    <section class="bakeshop-onboarding">
        <h3>Bootstrap Admin Handoff</h3>
        <p>{if is_bootstrap_user}You are signed in as the bootstrap admin <strong>@{bootstrap_onboarding.bootstrap_user.username}</strong>. Follow the same checklist here that appears on staff and account pages so the real operator ends up on a named admin login.{else}The bootstrap admin <strong>@{bootstrap_onboarding.bootstrap_user.username}</strong> is still active. Finish the handoff below so daily work stays on a named admin instead of the setup account.{/if}</p>
        <div class="bakeshop-onboarding-checklist">
            {each bootstrap_onboarding_guide.steps as step}
            <article class="bakeshop-onboarding-step {step.status}">
                <div class="bakeshop-onboarding-step-head">
                    <h4>{step.title}</h4>
                    <span class="bakeshop-step-status {step.status}">{step.status_label}</span>
                </div>
                <p>{step.description}</p>
                <a class="bakeshop-step-action" href="{base_url}{step.action_url}">{step.action_label}</a>
            </article>
            {/each}
        </div>
    </section>
    {/if}

    <div class="bakeshop-stats" style="{dashboard_visibility_style}">
        <div class="bakeshop-stat">
            <strong id="stat-branches">{stats.branches}</strong>
            <span>Active Branches</span>
        </div>
        <div class="bakeshop-stat">
            <strong id="stat-products">{stats.products}</strong>
            <span>Products</span>
        </div>
        <div class="bakeshop-stat">
            <strong id="stat-ingredients">{stats.ingredients}</strong>
            <span>Ingredients</span>
        </div>
        <div class="bakeshop-stat">
            <strong id="stat-recipes">{stats.recipes}</strong>
            <span>Recipe Lines</span>
        </div>
    </div>

    <section class="bakeshop-panel" style="{dashboard_visibility_style}">
        <div class="bakeshop-panel-head">
            <h3>Start Here</h3>
            <p>Follow this order so first-time setup stays predictable and the daily routine is easy to repeat.</p>
        </div>
        <div class="bakeshop-panel-body">
            <div class="bakeshop-flow">
                <article class="bakeshop-flow-step">
                    <strong>1</strong>
                    <h3>Set up branches</h3>
                    <p>Create the store locations you report against. Everything else connects back to these branches.</p>
                </article>
                <article class="bakeshop-flow-step">
                    <strong>2</strong>
                    <h3>Define products and recipes</h3>
                    <p>Add your finished goods and ingredient recipe lines before you record actual stock movement.</p>
                </article>
                <article class="bakeshop-flow-step">
                    <strong>3</strong>
                    <h3>Receive inventory and record production</h3>
                    <p>Use the same workspace for incoming ingredient inventory and production output so stock-in and stock-out stay connected.</p>
                </article>
                <article class="bakeshop-flow-step">
                    <strong>4</strong>
                    <h3>Review usage and print</h3>
                    <p>Check the branch usage summary, then open the printable report when you need a clean handoff.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="bakeshop-panel" style="{summary_visibility_style}">
        <div class="bakeshop-panel-head">
            <h3>Summary Report</h3>
            <p>Branch ingredient balance summary for handoff: beginning stock, delivery source, total delivery, production usage, and remaining balance.</p>
        </div>
        <div class="bakeshop-panel-body bakeshop-setup-shell">
            <form class="bakeshop-shell" method="get" action="{base_url}{summary_report.dashboard_url}" style="gap: 12px;">
                <div class="bakeshop-grid-3">
                    <div class="bakeshop-field">
                        <label for="summary-branch-filter">Branch</label>
                        <select id="summary-branch-filter" name="branch_id">
                            <option value="">All branches</option>
                            {each summary_report.branches as branch}
                            <option value="{branch.id}"{if summary_report.filters.branch_id == branch.id} selected{/if}>{if branch.code}{branch.code} - {/if}{branch.name}</option>
                            {/each}
                        </select>
                    </div>
                    <div class="bakeshop-field">
                        <label for="summary-from-filter">From</label>
                        <input id="summary-from-filter" name="from_date" type="date" value="{summary_report.filters.from_date}">
                    </div>
                    <div class="bakeshop-field">
                        <label for="summary-to-filter">To</label>
                        <input id="summary-to-filter" name="to_date" type="date" value="{summary_report.filters.to_date}">
                    </div>
                </div>
                <div class="bakeshop-form-actions">
                    <span class="bakeshop-help">Filters you apply here also carry into the usage work area and printable report.</span>
                    <div class="bakeshop-actions">
                        {if summary_report.has_active_filters}
                        <a class="bakeshop-button secondary" href="{base_url}{summary_report.dashboard_url}">Reset</a>
                        {/if}
                        <a class="bakeshop-button print" href="{base_url}{summary_report.print_url}" target="_blank" rel="noopener">Open Print View</a>
                        <button class="bakeshop-button" type="submit">Apply Filters</button>
                    </div>
                </div>
            </form>

            <div class="bakeshop-summary-meta">
                <div>
                    <strong>Branch</strong>
                    <p>{summary_report.branch_scope_label}</p>
                </div>
                <div>
                    <strong>From</strong>
                    <p>{if summary_report.display_from_date}{summary_report.display_from_date}{else}No activity yet{/if}</p>
                </div>
                <div>
                    <strong>To</strong>
                    <p>{if summary_report.display_to_date}{summary_report.display_to_date}{else}No activity yet{/if}</p>
                </div>
            </div>

            <div class="bakeshop-stats">
                <div class="bakeshop-stat">
                    <strong>{summary_report.factual_summary.ingredient_count | default:'0'}</strong>
                    <span>Tracked Ingredients</span>
                </div>
                <div class="bakeshop-stat">
                    <strong>{summary_report.factual_summary.delivery_item_count | default:'0'}</strong>
                    <span>Delivery Lines</span>
                </div>
                <div class="bakeshop-stat">
                    <strong>{summary_report.factual_summary.production_run_count | default:'0'}</strong>
                    <span>Saved Batches</span>
                </div>
                <div class="bakeshop-stat">
                    <strong>{summary_report.factual_summary.inventory_on_hand_display | default:usage_zero_value}</strong>
                    <span>On Hand At Scope End</span>
                </div>
            </div>

            <div class="bakeshop-summary-note">
                Beginning balance reflects stock before the first visible report date. Usage comes from saved batches through recipe quantities, and all displayed values follow the configured {usage_decimal_places}-decimal output setting.
            </div>

            {if summary_report.groups}
            <div class="bakeshop-summary-groups">
                {each summary_report.groups as group}
                <section class="bakeshop-summary-group">
                    <div class="bakeshop-summary-group-head">
                        <h4>{group.branch_label}</h4>
                        <p>Ingredient movement summary for this branch.</p>
                    </div>
                    <div class="bakeshop-table-wrap">
                        <table class="bakeshop-table">
                            <thead>
                                <tr>
                                    <th>Ingredient</th>
                                    <th>Unit</th>
                                    <th>Beginning Balance</th>
                                    <th>Delivery Source</th>
                                    <th>Total Delivery</th>
                                    <th>Usage</th>
                                    <th>Remaining Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                {each group.rows as row}
                                <tr>
                                    <td class="bakeshop-summary-ingredient">
                                        <strong>{row.ingredient_name}</strong>
                                        <span>{row.dimension}</span>
                                    </td>
                                    <td>{row.unit_code}</td>
                                    <td>{row.beginning_balance}</td>
                                    <td>{row.supplier_label}</td>
                                    <td>{row.total_delivery}</td>
                                    <td>{row.total_usage}</td>
                                    <td>{row.remaining_balance}</td>
                                </tr>
                                {/each}
                                <tr>
                                    <td colspan="2"><strong>Branch Totals</strong></td>
                                    <td><strong>{group.totals.beginning_balance}</strong></td>
                                    <td><strong>—</strong></td>
                                    <td><strong>{group.totals.total_delivery}</strong></td>
                                    <td><strong>{group.totals.total_usage}</strong></td>
                                    <td><strong>{group.totals.remaining_balance}</strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>
                {/each}
            </div>
            {else}
            <div class="bakeshop-empty">No delivery or production activity matched the current summary scope.</div>
            {/if}
        </div>
    </section>

    <section class="bakeshop-panel" style="{workspace_visibility_style}" id="work-areas-panel">
        <div class="bakeshop-panel-head" style="{workspace_head_visibility_style}">
            <h3>Work Areas</h3>
            <p>Use one work area at a time so setup, receiving, production, and reporting stay separate instead of competing for attention on one long page.</p>
            {if focused_workspace_mode}
            <div class="bakeshop-actions" style="margin-top: 10px;">
                <a class="bakeshop-button secondary" href="{base_url}{workspace_overview_url}">Back to Full Overview</a>
            </div>
            {/if}
        </div>
        <div class="bakeshop-panel-body bakeshop-setup-shell">
            <div class="bakeshop-tabs" role="tablist" aria-label="Bakeshop setup sections" style="{workspace_tabs_visibility_style}">
                <a class="bakeshop-tab active" href="{base_url}{work_area_routes.branches}" data-tab="branches" data-workspace-title="{work_area_meta.branches.title}" data-workspace-intro="{work_area_meta.branches.intro}" role="tab" aria-selected="true">Branches</a>
                <a class="bakeshop-tab" href="{base_url}{work_area_routes.catalog}" data-tab="catalog" data-workspace-title="{work_area_meta.catalog.title}" data-workspace-intro="{work_area_meta.catalog.intro}" role="tab" aria-selected="false">Products</a>
                <a class="bakeshop-tab" href="{base_url}{work_area_routes.ingredients}" data-tab="ingredients" data-workspace-title="{work_area_meta.ingredients.title}" data-workspace-intro="{work_area_meta.ingredients.intro}" role="tab" aria-selected="false">Ingredients</a>
                <a class="bakeshop-tab" href="{base_url}{work_area_routes.deliveries}" data-tab="deliveries" data-workspace-title="{work_area_meta.deliveries.title}" data-workspace-intro="{work_area_meta.deliveries.intro}" role="tab" aria-selected="false">Ingredient Deliveries</a>
                <a class="bakeshop-tab" href="{base_url}{work_area_routes.production}" data-tab="production" data-workspace-title="{work_area_meta.production.title}" data-workspace-intro="{work_area_meta.production.intro}" role="tab" aria-selected="false">Baking Log</a>
                <a class="bakeshop-tab" href="{base_url}{work_area_routes.usage}" data-tab="usage" data-workspace-title="{work_area_meta.usage.title}" data-workspace-intro="{work_area_meta.usage.intro}" role="tab" aria-selected="false">Usage Summary</a>
            </div>

            <section class="bakeshop-tab-panel active" data-tab-panel="branches">
                <div class="bakeshop-panel">
                    <div class="bakeshop-panel-body">
                        <form id="branch-form" class="bakeshop-grid-3" data-manage-required="true">
                            <div class="bakeshop-focus-note" id="branch-focus-note" style="grid-column: 1 / -1;" hidden></div>
                            <input type="hidden" name="id" value="">
                            <input type="hidden" name="is_active" value="1">
                            <div class="bakeshop-field">
                                <label for="branch-code">Code</label>
                                <input id="branch-code" name="code" placeholder="MAIN">
                            </div>
                            <div class="bakeshop-field">
                                <label for="branch-name">Name</label>
                                <input id="branch-name" name="name" placeholder="Main Branch">
                            </div>
                            <div class="bakeshop-field">
                                <label for="branch-address">Address</label>
                                <input id="branch-address" name="address" placeholder="Branch address">
                            </div>
                            <div class="bakeshop-form-actions" style="grid-column: 1 / -1;">
                                <span class="bakeshop-help">Branch IDs are owned by this module. No ecommerce or WMS bridge is wired in v1.</span>
                                <div class="bakeshop-actions">
                                    <button class="bakeshop-button danger" type="button" id="branch-cancel" hidden disabled>Cancel Edit</button>
                                    <button class="bakeshop-button" type="submit" id="branch-submit">Save Branch</button>
                                </div>
                            </div>
                        </form>

                        <div class="bakeshop-field">
                            <label for="branches-filter">Find Branch</label>
                            <input id="branches-filter" type="search" placeholder="Search by branch code, name, or address">
                        </div>

                        <div class="bakeshop-table-wrap">
                            <table class="bakeshop-table" id="branches-table">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Name</th>
                                        <th>Address</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>

            <section class="bakeshop-tab-panel" data-tab-panel="catalog">
                <div class="bakeshop-column">
                    <section class="bakeshop-panel" id="product-editor-panel">
                        <div class="bakeshop-panel-head">
                            <p>Define your finished goods. Click a product row to edit it; its recipe lines appear in the sub-section below.</p>
                        </div>
                        <div class="bakeshop-panel-body">
                            <form id="product-form" class="bakeshop-shell" style="gap: 16px;" data-manage-required="true">
                                <div class="bakeshop-focus-note" id="product-focus-note" hidden></div>
                                <input type="hidden" name="id" value="">
                                <input type="hidden" name="is_active" value="1">
                                <div class="bakeshop-grid-3">
                                    <div class="bakeshop-field">
                                        <label for="product-name">Name</label>
                                        <input id="product-name" name="name" placeholder="Pandesal">
                                    </div>
                                    <div class="bakeshop-field">
                                        <label for="product-sku">SKU</label>
                                        <input id="product-sku" name="sku" placeholder="PRD-001">
                                    </div>
                                    <div class="bakeshop-field">
                                        <label for="product-category">Category</label>
                                        <input id="product-category" name="category" placeholder="Bread">
                                    </div>
                                    <div class="bakeshop-field">
                                        <label for="product-yield-qty">Default Yield Qty</label>
                                        <input id="product-yield-qty" name="default_yield_qty" type="number" min="0.01" step="0.01" value="1.00">
                                    </div>
                                    <div class="bakeshop-field" style="grid-column: span 2;">
                                        <label for="product-yield-unit">Default Yield Unit</label>
                                        <select id="product-yield-unit" name="default_yield_unit_id"></select>
                                    </div>
                                </div>
                                <div class="bakeshop-form-actions">
                                    <span class="bakeshop-help">Default yield drives recipe scaling for saved batch records.</span>
                                    <div class="bakeshop-actions">
                                            <button class="bakeshop-button success" type="button" id="product-add">Add Product</button>
                                        <button class="bakeshop-button danger" type="button" id="product-cancel" hidden disabled>Cancel Edit</button>
                                        <button class="bakeshop-button" type="submit" id="product-submit">Save Product</button>
                                    </div>
                                </div>
                            </form>

                            <div class="bakeshop-grid-2">
                                <div class="bakeshop-field" style="grid-column: 2 / 3;">
                                    <label for="recipes-filter">Find Recipe Line</label>
                                    <input id="recipes-filter" type="search" placeholder="Search by ingredient, unit, or notes">
                                </div>
                            </div>

                            <section class="bakeshop-panel bakeshop-panel-subdued" id="recipe-panel">
                                <div class="bakeshop-panel-head">
                                    <h3 id="recipe-panel-title">Recipe</h3>
                                    <p id="recipe-form-description">Edit a product first to view and maintain its recipe lines.</p>
                                </div>
                                <div class="bakeshop-panel-body">
                                    <div id="recipe-panel-empty" class="bakeshop-muted">Select Edit on a product to open that product's recipe.</div>
                                    <div id="recipe-panel-details" hidden>
                                    <form id="recipe-form" class="bakeshop-grid-3" data-manage-required="true">
                                        <div class="bakeshop-focus-note" id="recipe-focus-note" style="grid-column: 1 / -1;" hidden></div>
                                        <input id="recipe-product" name="product_id" type="hidden" value="">
                                        <div class="bakeshop-field">
                                            <label for="recipe-ingredient">Ingredient</label>
                                            <select id="recipe-ingredient" name="ingredient_id"></select>
                                        </div>
                                        <div class="bakeshop-field">
                                            <label for="recipe-unit">Unit</label>
                                            <select id="recipe-unit" name="unit_id"></select>
                                        </div>
                                        <div class="bakeshop-field">
                                            <label for="recipe-qty">Quantity</label>
                                            <input id="recipe-qty" name="qty" type="number" min="0.01" step="0.01" value="1.00">
                                        </div>
                                        <div class="bakeshop-field" style="grid-column: span 2;">
                                            <label for="recipe-notes">Notes</label>
                                            <input id="recipe-notes" name="notes" placeholder="Optional preparation note">
                                        </div>
                                        <div class="bakeshop-form-actions" style="grid-column: 1 / -1;">
                                            <span class="bakeshop-help">Update the ingredient usage for this product.</span>
                                            <div class="bakeshop-actions">
                                                <button class="bakeshop-button danger" type="button" id="recipe-cancel" hidden disabled>Cancel Edit</button>
                                                <button class="bakeshop-button" type="submit" id="recipe-submit">Save Recipe Line</button>
                                            </div>
                                        </div>
                                    </form>

                                    <div class="bakeshop-table-wrap">
                                        <table class="bakeshop-table" id="recipes-table">
                                            <thead>
                                                <tr>
                                                    <th>Ingredient</th>
                                                    <th>Qty</th>
                                                    <th>Unit</th>
                                                    <th>Notes</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                    </div>
                                </div>
                            </section>

                            <div class="bakeshop-form-actions bakeshop-view-tabs">
                                <div class="bakeshop-inline-tabs" role="tablist" aria-label="Product status views">
                                    <button class="bakeshop-inline-tab active" type="button" id="products-view-active" data-product-view="active" aria-selected="true">Active <span class="bakeshop-inline-tab-count" id="products-active-count">0</span></button>
                                    <button class="bakeshop-inline-tab" type="button" id="products-view-archived" data-product-view="archived" aria-selected="false">Archived <span class="bakeshop-inline-tab-count" id="products-archived-count">0</span></button>
                                </div>
                                <span class="bakeshop-help" id="products-view-summary">View active products used for current batch recording.</span>
                            </div>

                            <div class="bakeshop-form-actions bakeshop-bulk-actions">
                                <span class="bakeshop-help" id="products-selection-summary">No products selected.</span>
                                {if can_manage_workspace}
                                <div class="bakeshop-actions">
                                    <button class="bakeshop-button secondary" type="button" id="products-select-visible">Select Visible</button>
                                    <button class="bakeshop-button secondary" type="button" id="products-clear-selection" hidden>Clear Selection</button>
                                    <button class="bakeshop-button danger" type="button" id="products-delete-selected" hidden>Delete Selected</button>
                                </div>
                                {/if}
                            </div>

                            <div class="bakeshop-table-wrap">
                                <table class="bakeshop-table" id="products-table">
                                    <thead>
                                        <tr>
                                            <th class="bakeshop-checkbox-cell">{if can_manage_workspace}<input class="bakeshop-checkbox" id="products-select-all" type="checkbox" aria-label="Select visible products">{/if}</th>
                                            <th>Product</th>
                                            <th>Category</th>
                                            <th>Yield</th>
                                            <th>Recipe Lines</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </section>

                </div>
            </section>

            <section class="bakeshop-tab-panel" data-tab-panel="ingredients">
                <div class="bakeshop-column">
                    <section class="bakeshop-panel">
                        <div class="bakeshop-panel-head">
                            <p>Maintain the ingredient master list and its base unit before using items in deliveries or recipe lines.</p>
                        </div>
                        <div class="bakeshop-panel-body">
                            <form id="ingredient-form" class="bakeshop-shell" style="gap: 16px;" data-manage-required="true">
                                <div class="bakeshop-focus-note" id="ingredient-focus-note" hidden></div>
                                <input type="hidden" name="id" value="">
                                <input type="hidden" name="is_active" value="1">
                                <div class="bakeshop-grid-3">
                                    <div class="bakeshop-field">
                                        <label for="ingredient-name">Name</label>
                                        <input id="ingredient-name" name="name" placeholder="Flour">
                                    </div>
                                    <div class="bakeshop-field">
                                        <label for="ingredient-sku">SKU</label>
                                        <input id="ingredient-sku" name="sku" placeholder="ING-001">
                                    </div>
                                    <div class="bakeshop-field">
                                        <label for="ingredient-unit">Default Unit</label>
                                        <select id="ingredient-unit" name="default_unit_id"></select>
                                    </div>
                                </div>
                                <div class="bakeshop-form-actions">
                                    <span class="bakeshop-help">Units are seeded globally as `kg`, `g`, `L`, `mL`, `pc`, and `pack`.</span>
                                    <div class="bakeshop-actions">
                                            <button class="bakeshop-button success" type="button" id="ingredient-add">Add Ingredient</button>
                                        <button class="bakeshop-button danger" type="button" id="ingredient-cancel" hidden disabled>Cancel Edit</button>
                                        <button class="bakeshop-button" type="submit" id="ingredient-submit">Save Ingredient</button>
                                    </div>
                                </div>
                            </form>

                            <div class="bakeshop-field">
                                <label for="ingredients-filter">Find Ingredient</label>
                                <input id="ingredients-filter" type="search" placeholder="Search by ingredient, SKU, or unit">
                            </div>

                            <div class="bakeshop-form-actions bakeshop-view-tabs">
                                <div class="bakeshop-inline-tabs" role="tablist" aria-label="Ingredient status views">
                                    <button class="bakeshop-inline-tab active" type="button" id="ingredients-view-active" data-ingredient-view="active" aria-selected="true">Active <span class="bakeshop-inline-tab-count" id="ingredients-active-count">0</span></button>
                                    <button class="bakeshop-inline-tab" type="button" id="ingredients-view-archived" data-ingredient-view="archived" aria-selected="false">Archived <span class="bakeshop-inline-tab-count" id="ingredients-archived-count">0</span></button>
                                </div>
                                <span class="bakeshop-help" id="ingredients-view-summary">View active ingredients used in current operations.</span>
                            </div>

                            <div class="bakeshop-form-actions bakeshop-bulk-actions">
                                <span class="bakeshop-help" id="ingredients-selection-summary">No ingredients selected.</span>
                                {if can_manage_workspace}
                                <div class="bakeshop-actions">
                                    <button class="bakeshop-button secondary" type="button" id="ingredients-select-visible">Select Visible</button>
                                    <button class="bakeshop-button secondary" type="button" id="ingredients-clear-selection" hidden>Clear Selection</button>
                                    <button class="bakeshop-button danger" type="button" id="ingredients-delete-selected" hidden>Delete Selected</button>
                                </div>
                                {/if}
                            </div>

                            <div class="bakeshop-table-wrap">
                                <table class="bakeshop-table" id="ingredients-table">
                                    <thead>
                                        <tr>
                                            <th class="bakeshop-checkbox-cell">{if can_manage_workspace}<input class="bakeshop-checkbox" id="ingredients-select-all" type="checkbox" aria-label="Select visible ingredients">{/if}</th>
                                            <th>Ingredient</th>
                                            <th>SKU</th>
                                            <th>Default Unit</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </section>
                </div>
            </section>

            <section class="bakeshop-tab-panel" data-tab-panel="deliveries">
                <section class="bakeshop-panel">
                    <div class="bakeshop-panel-head">
                        <p>Set the day's received quantities for one branch at a time. Every ingredient is listed below so encoding stays predictable.</p>
                    </div>
                    <div class="bakeshop-panel-body">
                        <div class="bakeshop-section-panel active" data-delivery-section-panel="receive">
                        <form id="delivery-form" class="bakeshop-shell" style="gap: 16px;" data-manage-required="true">
                            <div class="bakeshop-grid-2">
                                <div class="bakeshop-field">
                                    <label for="delivery-branch">Branch</label>
                                    <select id="delivery-branch" name="branch_id"></select>
                                </div>
                                <div class="bakeshop-field">
                                    <label for="delivery-at">Delivery Date</label>
                                    <input id="delivery-at" name="delivered_at" type="date">
                                </div>
                                <div class="bakeshop-field">
                                    <label for="delivery-reference">Reference</label>
                                    <input id="delivery-reference" name="reference" placeholder="DR-2026-001">
                                </div>
                                <div class="bakeshop-field">
                                    <label for="delivery-received-by">Received By</label>
                                    <input id="delivery-received-by" name="received_by" placeholder="Supervisor name">
                                </div>
                            </div>
                            <div class="bakeshop-grid-2">
                                <div class="bakeshop-field">
                                    <label for="delivery-source-type">Delivery Source</label>
                                    <select id="delivery-source-type" name="source_type">
                                        <option value="commissary">Commissary</option>
                                        <option value="other">Other Supplier</option>
                                    </select>
                                </div>
                                <div class="bakeshop-field" id="delivery-source-name-field" hidden>
                                    <label for="delivery-source-name">Other Supplier Name</label>
                                    <input id="delivery-source-name" name="source_name" placeholder="Specify supplier name">
                                </div>
                            </div>
                            <div class="bakeshop-field">
                                <label for="delivery-notes">Notes</label>
                                <textarea id="delivery-notes" name="notes" placeholder="Optional receiving note"></textarea>
                            </div>
                            <div class="bakeshop-grid-2">
                                <div class="bakeshop-field">
                                    <label for="delivery-sheet-filter">Find Ingredient</label>
                                    <input id="delivery-sheet-filter" type="search" placeholder="Search by ingredient or SKU">
                                </div>
                                <div class="bakeshop-field">
                                    <label for="delivery-csv-file">Import CSV</label>
                                    <input id="delivery-csv-file" type="file" accept=".csv,text/csv">
                                </div>
                            </div>
                            <div>
                                <div class="bakeshop-form-actions bakeshop-view-tabs" style="margin-bottom: 10px;">
                                    <div class="bakeshop-section-tabs" role="tablist" aria-label="Delivery sections">
                                        <button class="bakeshop-section-tab active" type="button" data-delivery-section-tab="receive" role="tab" aria-selected="true">Daily Receiving</button>
                                        <button class="bakeshop-section-tab" type="button" data-delivery-section-tab="saved" role="tab" aria-selected="false">Saved Receipts</button>
                                    </div>
                                    <span class="bakeshop-help">Set one branch's received quantities for the day and save a single receipt.</span>
                                </div>
                                <div class="bakeshop-form-actions" style="margin-bottom: 10px;">
                                    <span class="bakeshop-help">Every ingredient is listed below in its default unit. Enter received quantities directly, or import a CSV with `sku` or `ingredient`, `qty`, optional `unit_cost`, and optional `cost_basis` columns.</span>
                                    <div class="bakeshop-actions">
                                        <button class="bakeshop-button secondary" type="button" id="delivery-csv-template">Download CSV Template</button>
                                        <button class="bakeshop-button secondary" type="button" id="delivery-sheet-clear">Clear Quantities</button>
                                    </div>
                                </div>
                                <div class="bakeshop-table-wrap bakeshop-delivery-sheet">
                                    <table class="bakeshop-table">
                                        <thead>
                                            <tr>
                                                <th>Ingredient</th>
                                                <th>SKU</th>
                                                <th>Default Unit</th>
                                                <th>Qty Received</th>
                                                <th>Unit Cost</th>
                                                <th>Cost Basis</th>
                                            </tr>
                                        </thead>
                                        <tbody id="delivery-lines"></tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="bakeshop-form-actions">
                                <span class="bakeshop-help">Saving posts one daily branch receipt and includes only ingredients with a quantity greater than zero.</span>
                                <button class="bakeshop-button" type="submit">Save Delivery</button>
                            </div>
                        </form>
                        </div>

                        <div class="bakeshop-section-panel" data-delivery-section-panel="saved">
                        <div class="bakeshop-form-actions bakeshop-view-tabs">
                            <div class="bakeshop-section-tabs" role="tablist" aria-label="Delivery sections">
                                <button class="bakeshop-section-tab" type="button" data-delivery-section-tab="receive" role="tab" aria-selected="false">Daily Receiving</button>
                                <button class="bakeshop-section-tab active" type="button" data-delivery-section-tab="saved" role="tab" aria-selected="true">Saved Receipts</button>
                            </div>
                            <span class="bakeshop-help">Review saved branch receipts by date, source, receiver, and delivery detail.</span>
                        </div>
                        <div class="bakeshop-field">
                            <label for="deliveries-filter">Find Delivery</label>
                            <input id="deliveries-filter" type="search" placeholder="Search by branch, source, reference, receiver, or date">
                        </div>

                        <div class="bakeshop-form-actions bakeshop-bulk-actions">
                            <span class="bakeshop-help" id="deliveries-selection-summary">No deliveries selected.</span>
                            {if can_manage_workspace}
                            <div class="bakeshop-actions">
                                <button class="bakeshop-button secondary" type="button" id="deliveries-select-visible">Select Visible</button>
                                <button class="bakeshop-button secondary" type="button" id="deliveries-clear-selection" hidden>Clear Selection</button>
                                <button class="bakeshop-button danger" type="button" id="deliveries-delete-selected" hidden>Delete Selected</button>
                            </div>
                            {/if}
                        </div>

                        <div class="bakeshop-table-wrap">
                            <table class="bakeshop-table" id="deliveries-table">
                                <thead>
                                    <tr>
                                        <th class="bakeshop-checkbox-cell">{if can_manage_workspace}<input class="bakeshop-checkbox" id="deliveries-select-all" type="checkbox" aria-label="Select visible deliveries">{/if}</th>
                                        <th>Branch</th>
                                        <th>Delivered At</th>
                                        <th>Reference</th>
                                        <th>Delivery Detail</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        </div>
                    </div>
                </section>
            </section>

            <section class="bakeshop-tab-panel" data-tab-panel="production">
                <section class="bakeshop-panel">
                    <div class="bakeshop-panel-head">
                        <p>Record what was made, keep saved entries easy to review, and preserve the ingredient-use detail that belonged to each finished batch.</p>
                    </div>
                    <div class="bakeshop-panel-body">
                        <div class="bakeshop-section-panel active" data-production-section-panel="record">
                        <form id="production-form" class="bakeshop-grid-2" data-manage-required="true">
                            <input name="id" type="hidden" value="">
                            <input id="production-product" name="product_id" type="hidden" value="">
                            <input id="production-qty-produced" name="qty_produced" type="hidden" value="">
                            <div class="bakeshop-field">
                                <label for="production-branch">Branch</label>
                                <select id="production-branch" name="branch_id"></select>
                            </div>
                            <div class="bakeshop-field">
                                <label for="production-at">Finished At</label>
                                <input id="production-at" name="produced_at" type="datetime-local">
                            </div>
                            <div class="bakeshop-field">
                                <label for="production-by">Made By</label>
                                <input id="production-by" name="produced_by" placeholder="Baker or supervisor name">
                            </div>
                            <div class="bakeshop-field">
                                <label for="production-notes">Batch Note</label>
                                <input id="production-notes" name="notes" placeholder="Optional note for this saved entry">
                            </div>
                            <div style="grid-column: 1 / -1; display: grid; gap: 10px;">
                                <div class="bakeshop-form-actions bakeshop-view-tabs">
                                    <div class="bakeshop-section-tabs" role="tablist" aria-label="Production sections">
                                        <button class="bakeshop-section-tab active" type="button" data-production-section-tab="record" role="tab" aria-selected="true">Record Batch</button>
                                        <button class="bakeshop-section-tab" type="button" data-production-section-tab="saved" role="tab" aria-selected="false">Saved Entries</button>
                                    </div>
                                    <span class="bakeshop-help">Record batches one item at a time and keep the latest saved entry ready to review.</span>
                                </div>
                                <div class="bakeshop-form-actions">
                                    <span class="bakeshop-help" id="production-focus-note" hidden></span>
                                    <span class="bakeshop-help" id="production-product-note">Choose the branch, finished time, and who made it. Then enter the amount made in the item list below. Leaving a box blank means nothing was made for that item.</span>
                                </div>
                                {if allow_production_guard_override}
                                <div class="bakeshop-form-actions">
                                    <span class="bakeshop-help" id="production-guard-note">Temporary non-production testing override. When enabled, an entry can still be saved even if the item setup is incomplete.</span>
                                    <button class="bakeshop-button secondary" type="button" id="production-guard-toggle">Testing Override: Off</button>
                                </div>
                                {/if}
                                <div class="bakeshop-field">
                                    <label for="production-products-filter">Find Item To Record</label>
                                    <input id="production-products-filter" type="search" placeholder="Search by item, SKU, or category">
                                </div>
                                <div class="bakeshop-table-wrap">
                                    <table class="bakeshop-table" id="production-products-table">
                                        <thead>
                                            <tr>
                                                <th>Item</th>
                                                <th>Category</th>
                                                <th>Standard Batch</th>
                                                <th>Amount Made</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="bakeshop-form-actions" style="grid-column: 1 / -1;">
                                <span class="bakeshop-help">When you review a saved entry later, only the time, person, and note can be updated from this form.</span>
                                <button class="bakeshop-button" type="submit" id="production-submit" hidden>Update Saved Entry</button>
                                <button class="bakeshop-button secondary" type="button" id="production-cancel" hidden disabled>Cancel</button>
                            </div>
                        </form>

                        <div class="bakeshop-review-card" id="production-last-saved" hidden>
                            <div>
                                <strong>Last Saved Entry</strong>
                                <p id="production-last-saved-summary">The next saved batch will appear here so it can be reviewed right away.</p>
                            </div>
                            <div class="bakeshop-actions">
                                <button class="bakeshop-button secondary" type="button" id="production-review-last-saved">Review In Saved Entries</button>
                                <button class="bakeshop-button secondary" type="button" id="production-edit-last-saved">Edit This Entry</button>
                            </div>
                        </div>
                        </div>

                        <div class="bakeshop-section-panel" data-production-section-panel="saved">
                        <div class="bakeshop-form-actions bakeshop-view-tabs">
                            <div class="bakeshop-section-tabs" role="tablist" aria-label="Production sections">
                                <button class="bakeshop-section-tab" type="button" data-production-section-tab="record" role="tab" aria-selected="false">Record Batch</button>
                                <button class="bakeshop-section-tab active" type="button" data-production-section-tab="saved" role="tab" aria-selected="true">Saved Entries</button>
                            </div>
                            <span class="bakeshop-help">Review saved batch entries by branch, item, time, and ingredient-use detail.</span>
                        </div>
                        <div class="bakeshop-stats" id="production-saved-summary">
                            <div class="bakeshop-stat">
                                <strong id="production-saved-count">0</strong>
                                <span>Visible Saved Entries</span>
                            </div>
                            <div class="bakeshop-stat">
                                <strong id="production-saved-latest-item">None yet</strong>
                                <span>Last Saved Item</span>
                            </div>
                            <div class="bakeshop-stat">
                                <strong id="production-saved-latest-branch">No branch yet</strong>
                                <span>Last Saved Branch</span>
                            </div>
                        </div>
                        <div class="bakeshop-field">
                            <label for="production-filter">Find Saved Entry</label>
                            <input id="production-filter" type="search" placeholder="Search by branch, item, finished time, person, or note">
                        </div>

                        <div class="bakeshop-table-wrap">
                            <table class="bakeshop-table" id="production-table">
                                <thead>
                                    <tr>
                                        <th>Branch</th>
                                        <th>Item</th>
                                        <th>Finished At</th>
                                        <th>Amount Made</th>
                                        <th>Ingredients Used</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        </div>
                    </div>
                </section>
            </section>

            <section class="bakeshop-tab-panel" data-tab-panel="usage">
                <section class="bakeshop-panel">
                    <div class="bakeshop-panel-head">
                        <p>Read the inventory movement view: received deliveries minus recipe-based production consumption, grouped by branch, ingredient, and date.</p>
                    </div>
                    <div class="bakeshop-panel-body">
                        <form id="usage-form" class="bakeshop-grid-3">
                            <div class="bakeshop-field">
                                <label for="usage-branch">Branch</label>
                                <select id="usage-branch" name="branch_id" data-report-scope="branch_id"></select>
                            </div>
                            <div class="bakeshop-field">
                                <label for="usage-from">From Date</label>
                                <input id="usage-from" name="from_date" type="date" value="{summary_report.filters.from_date}" data-report-scope="from_date">
                            </div>
                            <div class="bakeshop-field">
                                <label for="usage-to">To Date</label>
                                <input id="usage-to" name="to_date" type="date" value="{summary_report.filters.to_date}" data-report-scope="to_date">
                            </div>
                            <div class="bakeshop-form-actions" style="grid-column: 1 / -1;">
                                <span class="bakeshop-help">These filters mirror any applied dashboard summary filters and drive the printable report.</span>
                                <button class="bakeshop-button" type="submit">Refresh Usage</button>
                            </div>
                        </form>

                        <div class="bakeshop-grid-3">
                            <div class="bakeshop-stat">
                                <strong id="usage-total-delivered">{usage_zero_value | default:'0.00'}</strong>
                                <span>Delivered By Unit</span>
                            </div>
                            <div class="bakeshop-stat">
                                <strong id="usage-total-consumed">{usage_zero_value | default:'0.00'}</strong>
                                <span>Consumed By Unit</span>
                            </div>
                            <div class="bakeshop-stat">
                                <strong id="usage-total-variance">{usage_zero_value | default:'0.00'}</strong>
                                <span>Variance By Unit</span>
                            </div>
                        </div>

                        <div class="bakeshop-stats">
                            <div class="bakeshop-stat">
                                <strong id="usage-factual-ingredients">0</strong>
                                <span>Tracked Ingredients</span>
                            </div>
                            <div class="bakeshop-stat">
                                <strong id="usage-factual-deliveries">0</strong>
                                <span>Delivery Lines</span>
                            </div>
                            <div class="bakeshop-stat">
                                <strong id="usage-factual-runs">0</strong>
                                <span>Saved Batches</span>
                            </div>
                        </div>

                        <div class="bakeshop-field">
                            <label for="usage-filter">Find Usage Row</label>
                            <input id="usage-filter" type="search" placeholder="Search by branch, ingredient, date, or unit">
                        </div>

                        <div class="bakeshop-table-wrap">
                            <table class="bakeshop-table" id="usage-table">
                                <thead>
                                    <tr>
                                        <th>Branch</th>
                                        <th>Date</th>
                                        <th>Ingredient</th>
                                        <th>Unit</th>
                                        <th>Delivered</th>
                                        <th>Consumed</th>
                                        <th>Variance</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>

                        <section class="bakeshop-panel" style="box-shadow:none;">
                            <div class="bakeshop-panel-head">
                                <h3>Ingredient Inventory As Of Scope End</h3>
                                <p>Shows net stock up to the selected end date. The branch filter always applies, and if only a from date is set it is used as the as-of date.</p>
                            </div>
                            <div class="bakeshop-panel-body">
                                <div class="bakeshop-grid-2">
                                    <div class="bakeshop-stat">
                                        <strong id="inventory-total-on-hand">{usage_zero_value | default:'0.00'}</strong>
                                        <span>On-Hand By Unit At Scope End</span>
                                    </div>
                                    <div class="bakeshop-stat">
                                        <strong id="inventory-total-lines">0</strong>
                                        <span>Tracked Ingredient Lines</span>
                                    </div>
                                </div>

                                <div class="bakeshop-field">
                                    <label for="inventory-filter">Find Inventory Row</label>
                                    <input id="inventory-filter" type="search" placeholder="Search by branch, ingredient, or unit">
                                </div>

                                <div class="bakeshop-table-wrap">
                                    <table class="bakeshop-table" id="inventory-table">
                                        <thead>
                                            <tr>
                                                <th>Branch</th>
                                                <th>Ingredient</th>
                                                <th>Unit</th>
                                                <th>Received To Date</th>
                                                <th>Consumed To Date</th>
                                                <th>On Hand</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </section>
                    </div>
                </section>
            </section>
        </div>
    </section>

</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const csrfToken = '{csrf_token}';
    const baseUrl = '{base_url}';

    function normalizePathPrefix(value) {
        if (!value) {
            return '';
        }

        let pathname = String(value || '').trim();
        if (pathname === '') {
            return '';
        }

        try {
            pathname = new URL(pathname, window.location.origin).pathname || '';
        } catch (error) {
            pathname = String(value || '').trim();
        }

        pathname = pathname.replace(/\/+$/, '');
        if (pathname === '/' || pathname === '.') {
            return '';
        }

        return pathname;
    }

    function bakeshopAppBasePath() {
        const candidates = [window.location.pathname, baseUrl];
        for (const candidate of candidates) {
            const normalized = normalizePathPrefix(candidate);
            if (normalized === '') {
                continue;
            }

            const match = normalized.match(/^(.*?)(\/admin\/bakeshop(?:\/.*)?|\/bakeshop(?:\/.*)?)$/);
            if (match) {
                return match[1] || '';
            }

            if (!normalized.startsWith('/api/')) {
                return normalized;
            }
        }

        return '';
    }

    function bakeshopApiPath(path) {
        return bakeshopAppBasePath() + String(path || '');
    }

    function normalizedRowId(kind, row) {
        if (!row || typeof row !== 'object') {
            return 0;
        }

        const candidates = [row.id];
        if (kind === 'product') {
            candidates.push(row.product_id);
        } else if (kind === 'ingredient') {
            candidates.push(row.ingredient_id);
        } else if (kind === 'branch') {
            candidates.push(row.branch_id);
        }

        for (const candidate of candidates) {
            const numericId = Number(candidate);
            if (Number.isFinite(numericId) && numericId > 0) {
                return numericId;
            }
        }

        return 0;
    }

    function normalizeMaintenanceRows(kind, rows) {
        if (!Array.isArray(rows)) {
            return [];
        }

        return rows.map((row) => {
            if (!row || typeof row !== 'object') {
                return row;
            }

            const resolvedId = normalizedRowId(kind, row);
            return {
                ...row,
                id: resolvedId > 0 ? resolvedId : row.id
            };
        });
    }

    const api = {
        branches: bakeshopApiPath('/api/v1/bakeshop/branches'),
        units: bakeshopApiPath('/api/v1/bakeshop/units'),
        products: bakeshopApiPath('/api/v1/bakeshop/products'),
        productStatus: bakeshopApiPath('/api/v1/bakeshop/products/[id]/status'),
        productsDelete: bakeshopApiPath('/api/v1/bakeshop/products/delete'),
        ingredients: bakeshopApiPath('/api/v1/bakeshop/ingredients'),
        ingredientStatus: bakeshopApiPath('/api/v1/bakeshop/ingredients/[id]/status'),
        ingredientsDelete: bakeshopApiPath('/api/v1/bakeshop/ingredients/delete'),
        recipes: bakeshopApiPath('/api/v1/bakeshop/recipes'),
        recipesDelete: bakeshopApiPath('/api/v1/bakeshop/recipes/delete'),
        deliveries: bakeshopApiPath('/api/v1/bakeshop/deliveries'),
        deliveriesDelete: bakeshopApiPath('/api/v1/bakeshop/deliveries/delete'),
        production: bakeshopApiPath('/api/v1/bakeshop/production'),
        productionVoid: bakeshopApiPath('/api/v1/bakeshop/production/void'),
        permissionsSettings: bakeshopApiPath('/api/v1/bakeshop/settings/permissions'),
        usage: bakeshopApiPath('/api/v1/bakeshop/usage')
    };

    api.branchStatus = bakeshopApiPath('/api/v1/bakeshop/branches/[id]/status');

    const canManageSettings = {if can_manage_settings}true{else}false{/if};
    const canManageWorkspace = {if can_manage_workspace}true{else}false{/if};
    const allowProductionGuardOverride = {if allow_production_guard_override}true{else}false{/if};
    const defaultUsageDecimalPlaces = Number('{usage_decimal_places | default:"2"}');
    const searchParams = new URLSearchParams(window.location.search);
    const focusState = {
        kind: searchParams.get('focus_kind') || '',
        id: Number(searchParams.get('focus_id') || '0'),
        applied: false
    };

    const state = {
        branches: [],
        units: [],
        products: [],
        productListView: 'active',
        selectedProductIds: new Set(),
        productionDraftQuantities: {},
        productionDraftSaveState: {},
        productionGuardOverride: false,
        deliverySectionTab: 'receive',
        productionSectionTab: 'record',
        lastSavedProductionId: 0,
        lastSavedProductionSummary: null,
        ingredients: [],
        ingredientListView: 'active',
        selectedIngredientIds: new Set(),
        recipes: [],
        activeProductId: 0,
        deliveries: [],
        expandedDeliveryId: 0,
        selectedDeliveryIds: new Set(),
        production: [],
        usage: [],
        inventorySnapshot: [],
        usageDecimalPlaces: Number.isFinite(defaultUsageDecimalPlaces) ? defaultUsageDecimalPlaces : 2,
        usageTotals: {
            delivered_qty_base: '{usage_zero_value | default:"0.00"}',
            consumed_qty_base: '{usage_zero_value | default:"0.00"}',
            variance_qty_base: '{usage_zero_value | default:"0.00"}',
            delivered_display: '{usage_zero_value | default:"0.00"}',
            consumed_display: '{usage_zero_value | default:"0.00"}',
            variance_display: '{usage_zero_value | default:"0.00"}'
        },
        factualSummary: {
            ingredient_count: 0,
            delivery_item_count: 0,
            production_run_count: 0,
            inventory_on_hand_qty_base: '{usage_zero_value | default:"0.00"}',
            inventory_on_hand_display: '{usage_zero_value | default:"0.00"}'
        },
        inventoryTotals: {
            on_hand_qty_base: '{usage_zero_value | default:"0.00"}',
            on_hand_display: '{usage_zero_value | default:"0.00"}',
            item_count: 0
        },
        loaded: {
            branches: false,
            units: false,
            products: false,
            ingredients: false,
            recipes: false,
            deliveries: false,
            production: false
        }
    };

    const $ = (selector) => document.querySelector(selector);
    const banner = $('#bakeshop-banner');
    const deleteConfirm = $('#bakeshop-delete-confirm');
    const deleteConfirmTitle = $('#bakeshop-delete-confirm-title');
    const deleteConfirmMessage = $('#bakeshop-delete-confirm-message');
    const deleteConfirmImpact = $('#bakeshop-delete-confirm-impact');
    const deleteConfirmList = $('#bakeshop-delete-confirm-list');
    const deleteConfirmOverflow = $('#bakeshop-delete-confirm-overflow');
    const deleteConfirmCancel = $('#bakeshop-delete-confirm-cancel');
    const deleteConfirmSubmit = $('#bakeshop-delete-confirm-submit');
    const printLink = $('#bakeshop-print-link');
    const productionGuardToggle = $('#production-guard-toggle');
    const productionGuardNote = $('#production-guard-note');
    const productionLastSaved = $('#production-last-saved');
    const productionLastSavedSummary = $('#production-last-saved-summary');
    const productionReviewLastSaved = $('#production-review-last-saved');
    const productionEditLastSaved = $('#production-edit-last-saved');
    const deliverySectionTabs = document.querySelectorAll('[data-delivery-section-tab]');
    const deliverySectionPanels = document.querySelectorAll('[data-delivery-section-panel]');
    const productionSectionTabs = document.querySelectorAll('[data-production-section-tab]');
    const productionSectionPanels = document.querySelectorAll('[data-production-section-panel]');
    const deliveryLines = $('#delivery-lines');
    const deliveryCsvFile = $('#delivery-csv-file');
    const permissionsForm = $('#permissions-form');
    const branchForm = $('#branch-form');
    const productForm = $('#product-form');
    const ingredientForm = $('#ingredient-form');
    const recipeForm = $('#recipe-form');
    const productionForm = $('#production-form');
    const manageRequiredForms = document.querySelectorAll('[data-manage-required="true"]');
    const setupTabs = document.querySelectorAll('[data-tab]');
    const setupPanels = document.querySelectorAll('[data-tab-panel]');
    const focusedWorkspaceMode = {if focused_workspace_mode}true{else}false{/if};
    const pageTitle = document.getElementById('bakeshop-page-title');
    const pageIntro = document.getElementById('bakeshop-page-intro');
    const defaultWorkspaceTitle = pageTitle ? pageTitle.textContent : '';
    const defaultWorkspaceIntro = pageIntro ? pageIntro.textContent : '';
    const defaultTab = '{initial_tab | default:"branches"}';
    const isDashboardPage = '{current_page | default:"dashboard"}' === 'dashboard';
    let pendingDeleteConfirmResolve = null;

    function resolveTabName(candidate) {
        if (!candidate) {
            return defaultTab;
        }

        return Array.from(setupTabs).some((button) => button.getAttribute('data-tab') === candidate)
            ? candidate
            : defaultTab;
    }

    function syncFocusedWorkspaceHeader(tabName) {
        if (!focusedWorkspaceMode || !pageTitle || !pageIntro) {
            return;
        }

        const activeButton = Array.from(setupTabs).find((button) => button.getAttribute('data-tab') === tabName);
        if (!activeButton) {
            pageTitle.textContent = defaultWorkspaceTitle;
            pageIntro.textContent = defaultWorkspaceIntro;
            return;
        }

        pageTitle.textContent = activeButton.getAttribute('data-workspace-title') || defaultWorkspaceTitle;
        pageIntro.textContent = activeButton.getAttribute('data-workspace-intro') || defaultWorkspaceIntro;
    }

    async function activateTab(tabName, options = {}) {
        const updateHash = options.updateHash !== false;
        const resolvedTab = resolveTabName(tabName);
        setupTabs.forEach((button) => {
            const isActive = button.getAttribute('data-tab') === resolvedTab;
            button.classList.toggle('active', isActive);
            button.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
        setupPanels.forEach((panel) => {
            panel.classList.toggle('active', panel.getAttribute('data-tab-panel') === resolvedTab);
        });
        syncFocusedWorkspaceHeader(resolvedTab);

        if (updateHash && window.location.hash.slice(1) !== resolvedTab) {
            history.replaceState(null, '', '#' + resolvedTab);
        }

        await ensureTabData(resolvedTab, { force: options.force === true });
    }

    setupTabs.forEach((button) => {
        button.addEventListener('click', async (event) => {
            const tabName = button.getAttribute('data-tab');
            let targetUrl = null;
            try {
                targetUrl = new URL(button.getAttribute('href') || '', window.location.origin);
            } catch (error) {
                targetUrl = null;
            }

            if (targetUrl && targetUrl.pathname === window.location.pathname && targetUrl.search === window.location.search) {
                event.preventDefault();
                try {
                    await activateTab(tabName);
                } catch (error) {
                    showBanner(error.message || 'Unable to open this work area.', false);
                }
            }
        });
    });

    window.addEventListener('hashchange', () => {
        activateTab(window.location.hash.slice(1), { updateHash: false }).catch((error) => {
            showBanner(error.message || 'Unable to open this work area.', false);
        });
    });

    if (window.location.hash) {
        activateTab(window.location.hash.slice(1)).catch((error) => {
            showBanner(error.message || 'Unable to open this work area.', false);
        });
    } else {
        activateTab(defaultTab, { updateHash: true }).catch((error) => {
            showBanner(error.message || 'Unable to open this work area.', false);
        });
    }

    function rowStatusChip(isActive) {
        return '<span class="bakeshop-chip ' + (Number(isActive) === 0 ? 'inactive' : 'active') + '">' + (Number(isActive) === 0 ? 'Archived' : 'Active') + '</span>';
    }

    function rowActionButtons(kind, row) {
        const rowId = normalizedRowId(kind, row);
        const actionId = rowId > 0 ? String(rowId) : '';
        if (!canManageWorkspace) {
            return '<span class="bakeshop-inline-note">View only</span>';
        }

        let deleteAction = '';
        if (kind === 'product') {
            deleteAction = Number(row.can_delete) === 1
                ? '<button type="button" class="bakeshop-link-button warn" data-kind="' + escapeHtml(kind) + '" data-action="delete" data-id="' + escapeHtml(actionId) + '">Delete</button>'
                : '<span class="bakeshop-inline-note">In use, archive instead</span>';
        }
        if (kind === 'ingredient') {
            deleteAction = Number(row.can_delete) === 1
                ? '<button type="button" class="bakeshop-link-button warn" data-kind="' + escapeHtml(kind) + '" data-action="delete" data-id="' + escapeHtml(actionId) + '">Delete</button>'
                : '<span class="bakeshop-inline-note">In use, archive instead</span>';
        }

        return '<div class="bakeshop-row-actions">'
            + '<button type="button" class="bakeshop-link-button" data-kind="' + escapeHtml(kind) + '" data-action="edit" data-id="' + escapeHtml(actionId) + '">Edit</button>'
            + deleteAction
            + '<button type="button" class="bakeshop-link-button ' + (Number(row.is_active) === 0 ? '' : 'warn') + '" data-kind="' + escapeHtml(kind) + '" data-action="toggle-active" data-id="' + escapeHtml(actionId) + '"' + (rowId > 0 ? '' : ' disabled') + '>' + (Number(row.is_active) === 0 ? 'Restore' : 'Archive') + '</button>'
            + '</div>';
    }

    function activeProductRecord() {
        return state.products.find((row) => Number(row.id) === Number(state.activeProductId)) || null;
    }

    function selectedProductionProductRecord() {
        if (!productionForm) {
            return null;
        }

        const productId = Number(productionForm.elements.namedItem('product_id').value || '0');
        if (productId <= 0) {
            return null;
        }

        return state.products.find((row) => Number(row.id) === productId) || null;
    }

    function productionDraftEntries() {
        return Object.entries(state.productionDraftQuantities || {})
            .map(([productId, qty]) => {
                const numericProductId = Number(productId);
                const normalizedQty = String(qty || '').trim();
                const numericQty = Number.parseFloat(normalizedQty);
                return {
                    productId: numericProductId,
                    qty: normalizedQty,
                    numericQty,
                    product: state.products.find((row) => Number(row.id) === numericProductId) || null
                };
            })
            .filter((entry) => Number.isFinite(entry.productId) && entry.productId > 0 && Number.isFinite(entry.numericQty) && entry.numericQty > 0);
    }

    function normalizeOptionalTwoDecimalQuantity(value) {
        const normalized = String(value ?? '').trim();
        if (normalized === '') {
            return '';
        }

        const numeric = Number.parseFloat(normalized);
        if (!Number.isFinite(numeric) || numeric <= 0) {
            return '';
        }

        return numeric.toFixed(2);
    }

    function productionRowBlockedReason(row) {
        if (!row) {
            return 'Product not found.';
        }

        if (!Number.isFinite(Number(row.default_yield_qty)) || Number(row.default_yield_qty) <= 0) {
            return 'Set the standard batch size first.';
        }

        if (Number(row.recipe_item_count || 0) <= 0) {
            return 'Add ingredients for this item first.';
        }

        return '';
    }

    function productionGuardOverrideActive() {
        return allowProductionGuardOverride && state.productionGuardOverride === true;
    }

    function activateDeliverySectionTab(tabName, options = {}) {
        const resolvedTab = tabName === 'saved' ? 'saved' : 'receive';
        state.deliverySectionTab = resolvedTab;

        deliverySectionTabs.forEach((button) => {
            const isActive = button.getAttribute('data-delivery-section-tab') === resolvedTab;
            button.classList.toggle('active', isActive);
            button.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
        deliverySectionPanels.forEach((panel) => {
            panel.classList.toggle('active', panel.getAttribute('data-delivery-section-panel') === resolvedTab);
        });

        if (resolvedTab === 'saved' && options.scrollToFocused === true) {
            const focusedRow = document.querySelector('#deliveries-table tbody tr.bakeshop-row-focus');
            if (focusedRow) {
                focusedRow.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }
    }

    function activateProductionSectionTab(tabName, options = {}) {
        const resolvedTab = tabName === 'saved' ? 'saved' : 'record';
        state.productionSectionTab = resolvedTab;

        productionSectionTabs.forEach((button) => {
            const isActive = button.getAttribute('data-production-section-tab') === resolvedTab;
            button.classList.toggle('active', isActive);
            button.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
        productionSectionPanels.forEach((panel) => {
            panel.classList.toggle('active', panel.getAttribute('data-production-section-panel') === resolvedTab);
        });

        if (resolvedTab === 'saved' && options.scrollToRecent === true) {
            const recentRow = document.querySelector('#production-table tbody tr.bakeshop-row-recent');
            if (recentRow) {
                recentRow.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }
    }

    function formatProductionLastSavedSummary(summary) {
        if (!summary) {
            return '';
        }

        const parts = [];
        if (summary.product_name) {
            parts.push(summary.product_name + ' · ' + displayTwoDecimalQuantity(summary.qty_produced) + ' ' + (summary.default_yield_unit_code || '').trim());
        }
        if (summary.branch_name) {
            parts.push('Branch: ' + summary.branch_name);
        }
        if (summary.produced_at) {
            parts.push('Finished: ' + summary.produced_at);
        }
        if (summary.produced_by) {
            parts.push('Made by: ' + summary.produced_by);
        }
        if (summary.notes) {
            parts.push('Note: ' + summary.notes);
        }

        return parts.join(' | ');
    }

    function syncProductionLastSavedCard() {
        if (!productionLastSaved || !productionLastSavedSummary) {
            return;
        }

        const summary = state.lastSavedProductionSummary;
        if (!summary || Number(state.lastSavedProductionId || 0) <= 0) {
            productionLastSaved.hidden = true;
            productionLastSavedSummary.textContent = 'The next saved batch will appear here so it can be reviewed right away.';
            return;
        }

        productionLastSaved.hidden = false;
        productionLastSavedSummary.textContent = formatProductionLastSavedSummary(summary);
    }

    function rememberLastSavedProduction(row) {
        const rowId = Number(row && row.id ? row.id : 0);
        if (rowId <= 0) {
            return;
        }

        state.lastSavedProductionId = rowId;
        state.lastSavedProductionSummary = {
            id: rowId,
            branch_name: row.branch_name || '',
            product_name: row.product_name || row.name || '',
            produced_at: row.produced_at || '',
            qty_produced: row.qty_produced || '0',
            default_yield_unit_code: row.default_yield_unit_code || '',
            produced_by: row.produced_by || '',
            notes: row.notes || ''
        };
        syncProductionLastSavedCard();
    }

    function syncProductionGuardOverrideControls() {
        if (!productionGuardToggle) {
            return;
        }

        const active = productionGuardOverrideActive();
        productionGuardToggle.textContent = active ? 'Testing Override: On' : 'Testing Override: Off';
        productionGuardToggle.classList.toggle('warn', active);

        if (productionGuardNote) {
            productionGuardNote.textContent = active
                ? 'Temporary non-production testing override is on. Saved entries will still be recorded even if the item setup is incomplete.'
                : 'Temporary non-production testing override. When enabled, an entry can still be saved even if the item setup is incomplete.';
        }
    }

    function setProductionDraftSaveState(productId, kind, message = '') {
        state.productionDraftSaveState[String(productId)] = {
            kind,
            message
        };
    }

    function productionDraftSaveStateFor(productId) {
        return state.productionDraftSaveState[String(productId)] || null;
    }

    function productionMetadataEditActive() {
        if (!productionForm) {
            return false;
        }

        return Number(productionForm.elements.namedItem('id').value || '0') > 0;
    }

    function productionDateTimeInputValue(value) {
        const normalized = String(value || '').trim();
        if (normalized === '') {
            return nowLocalDateTime();
        }

        return normalized.replace(' ', 'T').slice(0, 16);
    }

    function syncProductionProductSelection() {
        if (!productionForm) {
            return;
        }

        const note = $('#production-product-note');
        const productField = productionForm.elements.namedItem('product_id');
        const qtyField = productionForm.elements.namedItem('qty_produced');
        const draftEntries = productionDraftEntries();
        const selected = productionMetadataEditActive()
            ? selectedProductionProductRecord()
            : (draftEntries.length === 1 ? draftEntries[0].product : null);
        const draftProductIds = new Set(draftEntries.map((entry) => Number(entry.productId)));

        if (!note || !productField || !qtyField) {
            return;
        }

        if (!productionMetadataEditActive()) {
            productField.value = '';
            qtyField.value = '';
        }

        if (productionMetadataEditActive() && selected) {
            note.textContent = 'Reviewing the saved entry for ' + (selected.name || 'item') + '. Branch, item, amount made, and ingredients used stay locked here.';
        } else if (draftEntries.length === 0) {
            note.textContent = 'Choose the branch, finished time, and who made it. Then enter the amount made in the item list below. Leave a box blank if nothing was made for that item.';
        } else if (draftEntries.length === 1 && selected) {
            note.textContent = 'Ready to save ' + (selected.name || 'item') + ' · Standard batch ' + displayTwoDecimalQuantity(selected.default_yield_qty) + ' ' + (selected.default_yield_unit_code || 'unit') + ' · Amount made ' + draftEntries[0].qty + '.';
        } else {
            note.textContent = 'Amounts will save as you leave each box.';
        }

        if (productionGuardOverrideActive()) {
            note.textContent += ' Testing override is on.';
        }

        document.querySelectorAll('#production-products-table tbody tr[data-row-kind="production-product"]').forEach((rowElement) => {
            const rowId = Number(rowElement.getAttribute('data-row-id') || '0');
            const isSelected = productionMetadataEditActive()
                ? Boolean(selected && rowId === Number(selected.id || 0))
                : draftProductIds.has(rowId);
            rowElement.classList.toggle('bakeshop-row-editing', isSelected);
            rowElement.classList.toggle('bakeshop-row-selectable', canManageWorkspace && !productionMetadataEditActive());
        });
    }

    async function autosaveProductionDraft(productId, qtyValue, qtyInput) {
        if (!productionForm || productionMetadataEditActive()) {
            return;
        }

        const normalizedQty = normalizeOptionalTwoDecimalQuantity(qtyValue);
        if (normalizedQty === '') {
            delete state.productionDraftQuantities[String(productId)];
            delete state.productionDraftSaveState[String(productId)];
            syncProductionProductSelection();
            if (qtyInput instanceof HTMLInputElement) {
                qtyInput.value = '';
            }
            renderCatalogTables();
            return;
        }

        const row = state.products.find((item) => Number(item.id) === Number(productId) && Number(item.is_active) !== 0);
        if (!row) {
            setProductionDraftSaveState(productId, 'error', 'This item could not be found.');
            renderCatalogTables();
            showBanner('That item could not be found.', false);
            return;
        }

        const blockedReason = productionRowBlockedReason(row);
        if (blockedReason !== '' && !productionGuardOverrideActive()) {
            setProductionDraftSaveState(productId, 'error', blockedReason);
            renderCatalogTables();
            showBanner(blockedReason, false);
            return;
        }

        if (!productionForm.elements.namedItem('branch_id').value) {
            setProductionDraftSaveState(productId, 'error', 'Choose a branch first.');
            renderCatalogTables();
            showBanner('Choose a branch before entering the amount made.', false);
            return;
        }
        if (!productionForm.elements.namedItem('produced_at').value) {
            setProductionDraftSaveState(productId, 'error', 'Set the finished time first.');
            renderCatalogTables();
            showBanner('Set the finished time before entering the amount made.', false);
            return;
        }

        state.productionDraftQuantities[String(productId)] = normalizedQty;
        setProductionDraftSaveState(productId, 'saving', 'Saving entry...');
        syncProductionProductSelection();
        renderCatalogTables();

        if (qtyInput instanceof HTMLInputElement) {
            qtyInput.value = normalizedQty;
            qtyInput.disabled = true;
        }

        const result = await submitJson(api.production, {
            branch_id: productionForm.elements.namedItem('branch_id').value,
            product_id: String(productId),
            produced_at: productionForm.elements.namedItem('produced_at').value,
            qty_produced: normalizedQty,
            produced_by: productionForm.elements.namedItem('produced_by').value,
            notes: productionForm.elements.namedItem('notes').value,
            relax_guards: productionGuardOverrideActive() ? '1' : '0'
        }, (row.name || 'Item') + ' was saved.', async (data) => {
            delete state.productionDraftQuantities[String(productId)];
            await loadProduction(true);
            const savedRow = state.production.find((item) => Number(item.id) === Number((data && data.item && data.item.id) || 0)) || (data ? data.item : null);
            if (savedRow) {
                rememberLastSavedProduction(savedRow);
            }
            setProductionDraftSaveState(productId, 'saved', productionGuardOverrideActive() && blockedReason !== '' ? 'Saved for testing review.' : 'Saved and ready to review.');
            renderCatalogTables();
            await loadUsage();
        });

        if (!result) {
            setProductionDraftSaveState(productId, 'error', 'Could not save. Try again.');
            renderCatalogTables();
            if (qtyInput instanceof HTMLInputElement) {
                qtyInput.disabled = false;
                qtyInput.value = normalizedQty;
            }
            return;
        }

        if (qtyInput instanceof HTMLInputElement && qtyInput.isConnected) {
            qtyInput.disabled = false;
            qtyInput.value = '';
        }
    }

    function focusProductionDraftInput(row) {
        if (!productionForm) {
            return;
        }

        if (!canManageWorkspace) {
            showBanner('Production entry is read only for your role.', false);
            return;
        }

        if (productionMetadataEditActive()) {
            showBanner('You are reviewing a saved entry. Cancel review mode to record a new batch.', false);
            return;
        }

        const qtyField = document.querySelector('[data-production-qty-input="' + String(row.id || '') + '"]');
        if (!(qtyField instanceof HTMLInputElement)) {
            return;
        }

        qtyField.focus();
        qtyField.select();
    }

    function renderProductionProductsTable(rows) {
        const tbody = document.querySelector('#production-products-table tbody');
        if (!tbody) {
            return;
        }

        if (!rows.length) {
            tbody.innerHTML = '<tr><td colspan="4" class="bakeshop-muted">No active products available for production.</td></tr>';
            syncProductionProductSelection();
            return;
        }

        tbody.innerHTML = rows.map((row) => {
            const rowId = normalizedRowId('production-product', row);
            const draftQty = String((state.productionDraftQuantities && state.productionDraftQuantities[String(rowId)]) || '');
            const blockedReason = productionRowBlockedReason(row);
            const inputDisabled = !canManageWorkspace || productionMetadataEditActive();
            const saveState = productionDraftSaveStateFor(rowId);
            const saveStateClass = blockedReason !== '' && !productionGuardOverrideActive()
                ? ' error'
                : (saveState && saveState.kind === 'saved'
                ? ' ok'
                : (saveState && saveState.kind === 'error' ? ' error' : ''));
            const saveStateMessage = blockedReason !== ''
                ? (productionGuardOverrideActive()
                    ? 'Testing override active. This will save without ingredient-use detail.'
                    : blockedReason)
                : (saveState && saveState.message
                    ? saveState.message
                    : 'Blank = no production');
            return '<tr data-row-kind="production-product" data-row-id="' + escapeHtml(rowId) + '">'
                + '<td><strong>' + escapeHtml(row.name) + '</strong><div class="bakeshop-inline-note">' + escapeHtml(row.sku || 'No SKU') + '</div></td>'
                + '<td>' + escapeHtml(row.category || '—') + '</td>'
                + '<td>' + displayTwoDecimalQuantity(row.default_yield_qty) + ' ' + escapeHtml(row.default_yield_unit_code || '') + '</td>'
                + '<td><input class="bakeshop-table-input" type="number" min="0.01" step="0.01" placeholder="0.00" data-production-qty-input="' + escapeHtml(rowId) + '" value="' + escapeHtml(draftQty) + '"' + (inputDisabled ? ' disabled' : '') + '><div class="bakeshop-inline-note' + saveStateClass + '">' + escapeHtml(saveStateMessage) + '</div></td>'
                + '</tr>';
        }).join('');

        syncProductionProductSelection();
    }

    function currentReportScope() {
        const fromSummary = {
            branch_id: $('#summary-branch-filter') ? $('#summary-branch-filter').value : '',
            from_date: $('#summary-from-filter') ? $('#summary-from-filter').value : '',
            to_date: $('#summary-to-filter') ? $('#summary-to-filter').value : ''
        };
        const fromUsage = {
            branch_id: $('#usage-branch') ? $('#usage-branch').value : '',
            from_date: $('#usage-from') ? $('#usage-from').value : '',
            to_date: $('#usage-to') ? $('#usage-to').value : ''
        };

        return {
            branch_id: fromUsage.branch_id || fromSummary.branch_id,
            from_date: fromUsage.from_date || fromSummary.from_date,
            to_date: fromUsage.to_date || fromSummary.to_date
        };
    }

    function syncReportScopeInputs(sourcePrefix) {
        const source = {
            branch_id: $('#' + sourcePrefix + '-branch-filter') || $('#' + sourcePrefix + '-branch'),
            from_date: $('#' + sourcePrefix + '-from-filter') || $('#' + sourcePrefix + '-from'),
            to_date: $('#' + sourcePrefix + '-to-filter') || $('#' + sourcePrefix + '-to')
        };
        const usageTargets = {
            branch_id: $('#usage-branch'),
            from_date: $('#usage-from'),
            to_date: $('#usage-to')
        };

        Object.keys(usageTargets).forEach((key) => {
            if (source[key] && usageTargets[key]) {
                usageTargets[key].value = source[key].value || '';
            }
        });
    }

    function syncRecipePanel() {
        const empty = $('#recipe-panel-empty');
        const details = $('#recipe-panel-details');
        const title = $('#recipe-panel-title');
        const description = $('#recipe-form-description');
        const productEditorPanel = $('#product-editor-panel');
        const recipePanel = $('#recipe-panel');
        const product = activeProductRecord();

        if (!empty || !details || !title || !description || !productEditorPanel || !recipePanel) {
            return;
        }

        if (!product) {
            empty.hidden = false;
            details.hidden = true;
            title.textContent = 'Recipe';
            description.textContent = 'Edit a product first to view and maintain its recipe lines.';
            productEditorPanel.classList.remove('is-editing');
            recipePanel.classList.remove('is-editing');
            return;
        }

        empty.hidden = true;
        details.hidden = false;
        title.textContent = 'Recipe for ' + (product.name || 'Product');
        description.textContent = 'Add or edit ingredient usage here.';
        recipeForm.elements.namedItem('product_id').value = String(product.id || '');
        productEditorPanel.classList.add('is-editing');
        recipePanel.classList.add('is-editing');
    }

    function showBanner(message, ok = true) {
        banner.textContent = message;
        banner.className = 'bakeshop-banner show ' + (ok ? 'ok' : 'error');
    }

    function clearBanner() {
        banner.className = 'bakeshop-banner';
        banner.textContent = '';
    }

    function filteredProductRows() {
        const showArchived = state.productListView === 'archived';
        return state.products.filter((row) => {
            const isArchived = Number(row.is_active) === 0;
            return showArchived === isArchived;
        });
    }

    function filteredDeliveryRows() {
        return state.deliveries.filter((row) => rowMatchesSearch(tableSearchQuery('#deliveries-filter'), [row.branch_name, row.delivered_at, row.reference, row.received_by, row.source_label, row.cost_basis_summary, row.item_count, row.total_quantity, row.total_amount]));
    }

    function pruneProductSelection() {
        const validIds = new Set(state.products
            .filter((row) => Number(row.can_delete) === 1)
            .map((row) => Number(row.id))
            .filter((id) => Number.isFinite(id) && id > 0));
        Array.from(state.selectedProductIds).forEach((id) => {
            if (!validIds.has(id)) {
                state.selectedProductIds.delete(id);
            }
        });
    }

    function escapeHtml(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function productDeletePreviewLabel(row, id) {
        const name = row && row.name ? row.name : ('Product #' + String(id));
        return row && row.sku ? (name + ' (' + row.sku + ')') : name;
    }

    function ingredientDeletePreviewLabel(row, id) {
        const name = row && row.name ? row.name : ('Ingredient #' + String(id));
        return row && row.sku ? (name + ' (' + row.sku + ')') : name;
    }

    function deliveryDeletePreviewLabel(row, id) {
        const reference = row && row.reference ? row.reference : ('Delivery #' + String(id));
        const branch = row && row.branch_name ? row.branch_name : '';
        const deliveredAt = row && row.delivered_at ? row.delivered_at : '';
        return [reference, branch, deliveredAt].filter(Boolean).join(' - ');
    }

    function pruneDeliverySelection() {
        const validIds = new Set(state.deliveries.map((row) => Number(row.id)).filter((id) => Number.isFinite(id) && id > 0));
        Array.from(state.selectedDeliveryIds).forEach((id) => {
            if (!validIds.has(id)) {
                state.selectedDeliveryIds.delete(id);
            }
        });
    }

    function syncSelectionControls(options) {
        const rows = options.rows || [];
        const selectedIds = options.selectedIds;
        const prefix = options.prefix;
        const noun = options.noun;
        const singular = options.singular || noun.replace(/s$/, '');
        const selectAll = $('#' + prefix + '-select-all');
        const summary = $('#' + prefix + '-selection-summary');
        const clearButton = $('#' + prefix + '-clear-selection');
        const deleteButton = $('#' + prefix + '-delete-selected');
        const selectVisibleButton = $('#' + prefix + '-select-visible');
        const visibleIds = rows.map((row) => Number(row.id)).filter((id) => Number.isFinite(id) && id > 0);
        const selectedCount = selectedIds.size;
        const visibleSelectedCount = visibleIds.filter((id) => selectedIds.has(id)).length;

        if (summary) {
            if (selectedCount === 0) {
                summary.textContent = 'No ' + noun + ' selected.';
            } else if (selectedCount === 1) {
                summary.textContent = '1 ' + singular + ' selected.';
            } else {
                summary.textContent = String(selectedCount) + ' ' + noun + ' selected.';
            }
        }

        if (selectAll) {
            selectAll.checked = visibleIds.length > 0 && visibleSelectedCount === visibleIds.length;
            selectAll.indeterminate = visibleSelectedCount > 0 && visibleSelectedCount < visibleIds.length;
            selectAll.disabled = !canManageWorkspace || visibleIds.length === 0;
        }
        if (selectVisibleButton) {
            selectVisibleButton.disabled = !canManageWorkspace || visibleIds.length === 0;
        }
        if (clearButton) {
            clearButton.hidden = selectedCount === 0;
            clearButton.disabled = !canManageWorkspace || selectedCount === 0;
        }
        if (deleteButton) {
            deleteButton.hidden = selectedCount === 0;
            deleteButton.disabled = !canManageWorkspace || selectedCount === 0;
            deleteButton.textContent = selectedCount > 1 ? 'Delete Selected (' + String(selectedCount) + ')' : 'Delete Selected';
        }
    }

    function productDeleteEligibleRows(rows = filteredProductRows()) {
        return rows.filter((row) => Number(row.can_delete) === 1);
    }

    function syncProductViewControls() {
        const activeButton = $('#products-view-active');
        const archivedButton = $('#products-view-archived');
        const summary = $('#products-view-summary');
        const activeCount = state.products.filter((row) => Number(row.is_active) !== 0).length;
        const archivedCount = state.products.filter((row) => Number(row.is_active) === 0).length;

        $('#products-active-count').textContent = String(activeCount);
        $('#products-archived-count').textContent = String(archivedCount);

        if (activeButton) {
            const isActiveView = state.productListView === 'active';
            activeButton.classList.toggle('active', isActiveView);
            activeButton.setAttribute('aria-selected', isActiveView ? 'true' : 'false');
        }
        if (archivedButton) {
            const isArchivedView = state.productListView === 'archived';
            archivedButton.classList.toggle('active', isArchivedView);
            archivedButton.setAttribute('aria-selected', isArchivedView ? 'true' : 'false');
        }
        if (summary) {
            summary.textContent = state.productListView === 'archived'
                ? 'Archived products stay out of batch recording until they are restored.'
                : 'View active products used for current batch recording.';
        }
    }

    function syncProductSelectionControls(rows = filteredProductRows()) {
        const selectAll = $('#products-select-all');
        const summary = $('#products-selection-summary');
        const clearButton = $('#products-clear-selection');
        const deleteButton = $('#products-delete-selected');
        const selectVisibleButton = $('#products-select-visible');
        const deletableRows = productDeleteEligibleRows(rows);
        const visibleIds = deletableRows.map((row) => Number(row.id)).filter((id) => Number.isFinite(id) && id > 0);
        const selectedCount = state.selectedProductIds.size;
        const visibleSelectedCount = visibleIds.filter((id) => state.selectedProductIds.has(id)).length;

        if (summary) {
            if (selectedCount === 0) {
                summary.textContent = rows.length > 0 && visibleIds.length === 0 ? 'Products already used in saved batches can be archived but not deleted.' : 'No products selected.';
            } else if (selectedCount === 1) {
                summary.textContent = '1 product selected.';
            } else {
                summary.textContent = String(selectedCount) + ' products selected.';
            }
        }

        if (selectAll) {
            selectAll.checked = visibleIds.length > 0 && visibleSelectedCount === visibleIds.length;
            selectAll.indeterminate = visibleSelectedCount > 0 && visibleSelectedCount < visibleIds.length;
            selectAll.disabled = !canManageWorkspace || visibleIds.length === 0;
        }

        if (selectVisibleButton) {
            selectVisibleButton.disabled = !canManageWorkspace || visibleIds.length === 0;
        }
        if (clearButton) {
            clearButton.hidden = selectedCount === 0;
            clearButton.disabled = !canManageWorkspace || selectedCount === 0;
        }
        if (deleteButton) {
            deleteButton.hidden = selectedCount === 0;
            deleteButton.disabled = !canManageWorkspace || selectedCount === 0;
            deleteButton.textContent = selectedCount > 1 ? 'Delete Selected (' + String(selectedCount) + ')' : 'Delete Selected';
        }
    }

    function syncDeliverySelectionControls(rows = filteredDeliveryRows()) {
        syncSelectionControls({ rows, selectedIds: state.selectedDeliveryIds, prefix: 'deliveries', noun: 'deliveries', singular: 'delivery' });
    }

    function normalizeTwoDecimalQuantity(value, fallback = '1.00') {
        const numeric = Number.parseFloat(String(value ?? '').trim());
        if (!Number.isFinite(numeric) || numeric <= 0) {
            return fallback;
        }
        return numeric.toFixed(2);
    }

    function displayTwoDecimalQuantity(value, fallback = '0.00') {
        const numeric = Number.parseFloat(String(value ?? '').trim());
        if (!Number.isFinite(numeric)) {
            return fallback;
        }
        return numeric.toFixed(2);
    }

    function formatCurrencyDisplay(value, fallback = 'PHP 0.00') {
        const numeric = Number.parseFloat(String(value ?? '').trim());
        if (!Number.isFinite(numeric)) {
            return fallback;
        }
        return 'PHP ' + numeric.toFixed(2);
    }

    function renderProductsTable(rows) {
        const tbody = document.querySelector('#products-table tbody');
        if (!tbody) {
            return;
        }

        if (!rows.length) {
            tbody.innerHTML = '<tr><td colspan="7" class="bakeshop-muted">' + escapeHtml(state.productListView === 'archived' ? 'No archived products yet.' : 'No active products yet.') + '</td></tr>';
            syncProductViewControls();
            syncProductSelectionControls(rows);
            return;
        }

        tbody.innerHTML = rows.map((row) => {
            const resolvedRowId = normalizedRowId('product', row);
            const selected = resolvedRowId > 0 && state.selectedProductIds.has(resolvedRowId);
            const selectionCell = canManageWorkspace && resolvedRowId > 0 && Number(row.can_delete) === 1
                ? '<td class="bakeshop-checkbox-cell"><input class="bakeshop-checkbox" type="checkbox" data-product-select="' + escapeHtml(resolvedRowId) + '" aria-label="Select product ' + escapeHtml(row.name || String(resolvedRowId)) + '"' + (selected ? ' checked' : '') + '></td>'
                : '<td class="bakeshop-checkbox-cell"></td>';

            const dependencyNote = Number(row.production_reference_count) > 0
                ? '<div class="bakeshop-inline-note">Used by ' + escapeHtml(String(row.production_reference_count)) + ' saved batch' + (Number(row.production_reference_count) === 1 ? '' : 'es') + '.</div>'
                : '';

            return '<tr data-row-kind="product" data-row-id="' + escapeHtml(resolvedRowId) + '">'
                + selectionCell
                + '<td><strong>' + escapeHtml(row.name) + '</strong><div class="bakeshop-inline-note">' + escapeHtml(row.sku || 'No SKU') + '</div>' + dependencyNote + '</td>'
                + '<td>' + escapeHtml(row.category || '—') + '</td>'
                + '<td>' + displayTwoDecimalQuantity(row.default_yield_qty) + ' ' + escapeHtml(row.default_yield_unit_code || '') + '</td>'
                + '<td>' + escapeHtml(row.recipe_item_count) + '</td>'
                + '<td>' + rowStatusChip(row.is_active) + '</td>'
                + '<td>' + rowActionButtons('product', row) + '</td>'
                + '</tr>';
        }).join('');

        syncProductViewControls();
        syncProductSelectionControls(rows);
    }

    function renderDeliveryDetail(row) {
        const items = Array.isArray(row.items) ? row.items : [];
        return '<div class="bakeshop-detail-stack">'
            + '<strong>' + escapeHtml(row.source_label || 'Commissary') + '</strong>'
            + '<span class="bakeshop-inline-note">' + escapeHtml(row.received_by || 'Receiver not recorded') + (row.cost_basis_summary ? ' · ' + escapeHtml(row.cost_basis_summary) : '') + '</span>'
            + '<span class="bakeshop-inline-note">' + escapeHtml(String(row.item_count || items.length || 0)) + ' lines · ' + escapeHtml(String(row.total_quantity || '0')) + ' total qty · ' + formatCurrencyDisplay(row.total_amount) + ' total amount</span>'
            + renderDetailList(items, (item) => escapeHtml(item.ingredient_name || 'Ingredient') + ': ' + escapeHtml(String(item.qty || '0')) + ' ' + escapeHtml(item.unit_code || '') + ((item.unit_cost !== null && item.unit_cost !== undefined && item.unit_cost !== '') ? (' @ ' + formatCurrencyDisplay(item.unit_cost)) : '') + ' · ' + escapeHtml(item.cost_basis_label || 'Delivery Source'), 'No delivery line detail loaded.')
            + '</div>';
    }

    function renderProductionSnapshotDetail(row) {
        const items = Array.isArray(row.items) ? row.items : [];
        return '<div class="bakeshop-detail-stack">'
            + '<strong>' + escapeHtml(String(row.consumed_item_count || items.length || 0)) + ' ingredient line(s)</strong>'
            + '<span class="bakeshop-inline-note">' + escapeHtml(String(row.total_consumed_qty || '0')) + ' total ingredient quantity</span>'
            + renderDetailList(items, (item) => escapeHtml(item.ingredient_name || 'Ingredient') + ': ' + escapeHtml(String(item.qty_used || '0')) + ' ' + escapeHtml(item.unit_code || ''), 'No ingredient-use detail was saved for this entry.')
            + '</div>';
    }

    function nowLocalDateTime() {
        const date = new Date();
        const pad = (value) => String(value).padStart(2, '0');
        return [date.getFullYear(), pad(date.getMonth() + 1), pad(date.getDate())].join('-') + 'T' + [pad(date.getHours()), pad(date.getMinutes())].join(':');
    }

    function nowLocalDate() {
        return nowLocalDateTime().slice(0, 10);
    }

    function syncDeliverySourceField() {
        const sourceType = $('#delivery-source-type');
        const sourceNameField = $('#delivery-source-name-field');
        const sourceNameInput = $('#delivery-source-name');
        if (!sourceType || !sourceNameField || !sourceNameInput) {
            return;
        }

        const isOther = sourceType.value === 'other';
        sourceNameField.hidden = !isOther;
        sourceNameInput.disabled = !isOther;
        if (!isOther) {
            sourceNameInput.value = '';
        }
    }

    function apiUrl(base, params = {}) {
        const url = new URL(base, window.location.origin);
        Object.entries(params).forEach(([key, value]) => {
            if (value !== null && value !== undefined && value !== '') {
                url.searchParams.set(key, value);
            }
        });
        return url.toString();
    }

    async function request(url, options = {}) {
        const requestUrl = new URL(String(url || ''), window.location.origin).toString();
        const response = await fetch(requestUrl, {
            headers: {
                'Accept': 'application/json',
                ...(options.body ? { 'Content-Type': 'application/json' } : {}),
                ...((options.method || 'GET').toUpperCase() !== 'GET' ? { 'X-CSRF-Token': csrfToken } : {}),
                ...(options.headers || {})
            },
            credentials: 'same-origin',
            ...options
        });

        const payload = await response.json().catch(() => ({ ok: false, error: 'Invalid server response' }));
        if (!response.ok || payload.ok === false) {
            throw new Error(payload.error || 'Request failed');
        }

        return payload.data || {};
    }

    function populateSelect(selector, items, mapFn, includeBlankLabel = '') {
        const select = $(selector);
        if (!select) {
            return;
        }

        const currentValue = select.value;
        const options = [];
        if (includeBlankLabel !== null) {
            options.push('<option value="">' + escapeHtml(includeBlankLabel) + '</option>');
        }
        items.forEach((item) => {
            const mapped = mapFn(item);
            options.push('<option value="' + escapeHtml(mapped.value) + '">' + escapeHtml(mapped.label) + '</option>');
        });
        select.innerHTML = options.join('');

        if (currentValue && Array.from(select.options).some((option) => option.value === currentValue)) {
            select.value = currentValue;
        }
    }

    function applyWorkspaceAccessMode() {
        if (canManageWorkspace) {
            return;
        }

        manageRequiredForms.forEach((form) => {
            form.querySelectorAll('input, select, textarea, button').forEach((field) => {
                if (field instanceof HTMLElement && field.getAttribute('type') === 'hidden') {
                    return;
                }
                field.disabled = true;
            });
        });
    }

    function tableSearchQuery(selector) {
        const input = $(selector);
        return input ? String(input.value || '').trim().toLowerCase() : '';
    }

    function rowMatchesSearch(query, values) {
        if (query === '') {
            return true;
        }

        return values
            .map((value) => String(value || '').toLowerCase())
            .join(' ')
            .includes(query);
    }

    function renderDetailList(items, renderItem, emptyMessage = 'No detail loaded.') {
        const listItems = Array.isArray(items) ? items : [];
        if (!listItems.length) {
            return '<div class="bakeshop-detail-list"><span>' + escapeHtml(emptyMessage) + '</span></div>';
        }

        return '<div class="bakeshop-detail-list">'
            + listItems.map((item) => '<span>' + renderItem(item) + '</span>').join('')
            + '</div>';
    }

    function renderTable(selector, rows, columns, emptyMessage = 'No rows yet.', rowKind = '') {
        const tbody = document.querySelector(selector + ' tbody');
        if (!tbody) {
            return;
        }

        if (!rows.length) {
            tbody.innerHTML = '<tr><td colspan="' + columns.length + '" class="bakeshop-muted">' + escapeHtml(emptyMessage) + '</td></tr>';
            return;
        }

        tbody.innerHTML = rows.map((row) => {
            const cells = columns.map((column) => '<td>' + column(row) + '</td>').join('');
            const resolvedRowId = rowKind ? normalizedRowId(rowKind, row) : Number(row && row.id ? row.id : 0);
            const rowAttrs = rowKind && resolvedRowId > 0
                ? ' data-row-kind="' + escapeHtml(rowKind) + '" data-row-id="' + escapeHtml(resolvedRowId) + '"'
                : '';
            return '<tr' + rowAttrs + '>' + cells + '</tr>';
        }).join('');
    }

    function clearFocusSearch() {
        const url = new URL(window.location.href);
        url.searchParams.delete('focus_kind');
        url.searchParams.delete('focus_id');
        const next = url.pathname + (url.search ? url.search : '') + (url.hash ? url.hash : '');
        history.replaceState(null, '', next);
    }

    function setFocusNote(selector, message) {
        const element = $(selector);
        if (!element) {
            return;
        }

        element.hidden = !message;
        element.textContent = message || '';
    }

    function openFocusedEditor(kind, row) {
        if (kind === 'branch') {
            editBranch(row, 'history');
            return true;
        }
        if (kind === 'product') {
            editProduct(row, 'history');
            return true;
        }
        if (kind === 'ingredient') {
            editIngredient(row, 'history');
            return true;
        }
        if (kind === 'delivery') {
            state.expandedDeliveryId = Number(row.id || 0);
            renderOperationalTables();
            return false;
        }
        if (kind === 'recipe') {
            editRecipe(row, 'history');
            return true;
        }
        if (kind === 'production') {
            editProduction(row, 'history');
            return true;
        }
        return false;
    }

    function applyFocusedRow(selector, kind, rows, label) {
        if (focusState.applied || focusState.kind !== kind || !Number.isFinite(focusState.id) || focusState.id <= 0) {
            return;
        }

        const match = rows.find((row) => Number(row.id) === focusState.id);
        if (!match) {
            return;
        }

        const tableRow = document.querySelector(selector + ' tbody tr[data-row-kind="' + kind + '"][data-row-id="' + focusState.id + '"]');
        if (!tableRow) {
            return;
        }

        tableRow.classList.add('bakeshop-row-focus');
        if (openFocusedEditor(kind, match)) {
            showBanner(label + ' record opened from activity history for review.', true);
        } else {
            tableRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
            showBanner(label + ' record opened from activity history.', true);
        }
        focusState.applied = true;
        clearFocusSearch();
    }

    function updateStats() {
        $('#stat-branches').textContent = String(state.branches.length);
        $('#stat-products').textContent = String(state.products.length);
        $('#stat-ingredients').textContent = String(state.ingredients.length);
        $('#stat-recipes').textContent = String(state.recipes.length);
    }

    function filteredIngredientRows() {
        const ingredientQuery = tableSearchQuery('#ingredients-filter');
        const showArchived = state.ingredientListView === 'archived';
        return state.ingredients.filter((row) => {
            const isArchived = Number(row.is_active) === 0;
            if (showArchived !== isArchived) {
                return false;
            }

            return rowMatchesSearch(ingredientQuery, [row.name, row.sku, row.default_unit_code, row.default_unit_name]);
        });
    }

    function syncIngredientViewControls() {
        const activeButton = $('#ingredients-view-active');
        const archivedButton = $('#ingredients-view-archived');
        const summary = $('#ingredients-view-summary');
        const activeCount = state.ingredients.filter((row) => Number(row.is_active) !== 0).length;
        const archivedCount = state.ingredients.filter((row) => Number(row.is_active) === 0).length;

        $('#ingredients-active-count').textContent = String(activeCount);
        $('#ingredients-archived-count').textContent = String(archivedCount);

        if (activeButton) {
            const isActiveView = state.ingredientListView === 'active';
            activeButton.classList.toggle('active', isActiveView);
            activeButton.setAttribute('aria-selected', isActiveView ? 'true' : 'false');
        }
        if (archivedButton) {
            const isArchivedView = state.ingredientListView === 'archived';
            archivedButton.classList.toggle('active', isArchivedView);
            archivedButton.setAttribute('aria-selected', isArchivedView ? 'true' : 'false');
        }
        if (summary) {
            summary.textContent = state.ingredientListView === 'archived'
                ? 'Archived ingredients stay out of delivery and recipe pickers until they are restored.'
                : 'View active ingredients used in current operations.';
        }
    }

    function ingredientDeleteEligibleRows(rows = filteredIngredientRows()) {
        return rows.filter((row) => Number(row.can_delete) === 1);
    }

    function pruneIngredientSelection() {
        const validIds = new Set(state.ingredients
            .filter((row) => Number(row.can_delete) === 1)
            .map((row) => Number(row.id))
            .filter((id) => Number.isFinite(id) && id > 0));
        Array.from(state.selectedIngredientIds).forEach((id) => {
            if (!validIds.has(id)) {
                state.selectedIngredientIds.delete(id);
            }
        });
    }

    function syncIngredientSelectionControls(rows = filteredIngredientRows()) {
        const selectAll = $('#ingredients-select-all');
        const summary = $('#ingredients-selection-summary');
        const clearButton = $('#ingredients-clear-selection');
        const deleteButton = $('#ingredients-delete-selected');
        const selectVisibleButton = $('#ingredients-select-visible');
        const deletableRows = ingredientDeleteEligibleRows(rows);
        const visibleIds = deletableRows.map((row) => Number(row.id)).filter((id) => Number.isFinite(id) && id > 0);
        const selectedCount = state.selectedIngredientIds.size;
        const visibleSelectedCount = visibleIds.filter((id) => state.selectedIngredientIds.has(id)).length;

        if (summary) {
            if (selectedCount === 0) {
                summary.textContent = rows.length > 0 && visibleIds.length === 0 ? 'Ingredients already in use can be archived but not deleted.' : 'No ingredients selected.';
            } else if (selectedCount === 1) {
                summary.textContent = '1 ingredient selected.';
            } else {
                summary.textContent = String(selectedCount) + ' ingredients selected.';
            }
        }

        if (selectAll) {
            selectAll.checked = visibleIds.length > 0 && visibleSelectedCount === visibleIds.length;
            selectAll.indeterminate = visibleSelectedCount > 0 && visibleSelectedCount < visibleIds.length;
            selectAll.disabled = !canManageWorkspace || visibleIds.length === 0;
        }

        if (selectVisibleButton) {
            selectVisibleButton.disabled = !canManageWorkspace || visibleIds.length === 0;
        }
        if (clearButton) {
            clearButton.hidden = selectedCount === 0;
            clearButton.disabled = !canManageWorkspace || selectedCount === 0;
        }
        if (deleteButton) {
            deleteButton.hidden = selectedCount === 0;
            deleteButton.disabled = !canManageWorkspace || selectedCount === 0;
            deleteButton.textContent = selectedCount > 1 ? 'Delete Selected (' + String(selectedCount) + ')' : 'Delete Selected';
        }
    }

    function renderIngredientsTable(rows) {
        const tbody = document.querySelector('#ingredients-table tbody');
        if (!tbody) {
            return;
        }

        if (!rows.length) {
            tbody.innerHTML = '<tr><td colspan="6" class="bakeshop-muted">' + escapeHtml(state.ingredientListView === 'archived' ? 'No archived ingredients yet.' : 'No active ingredients yet.') + '</td></tr>';
            syncIngredientViewControls();
            syncIngredientSelectionControls(rows);
            return;
        }

        tbody.innerHTML = rows.map((row) => {
            const resolvedRowId = normalizedRowId('ingredient', row);
            const selected = resolvedRowId > 0 && state.selectedIngredientIds.has(resolvedRowId);
            const selectionCell = canManageWorkspace && resolvedRowId > 0 && Number(row.can_delete) === 1
                ? '<td class="bakeshop-checkbox-cell"><input class="bakeshop-checkbox" type="checkbox" data-ingredient-select="' + escapeHtml(resolvedRowId) + '" aria-label="Select ingredient ' + escapeHtml(row.name || String(resolvedRowId)) + '"' + (selected ? ' checked' : '') + '></td>'
                : '<td class="bakeshop-checkbox-cell"></td>';

            const dependencyNotes = [];
            if (Number(row.recipe_reference_count) > 0) {
                dependencyNotes.push(String(row.recipe_reference_count) + ' recipe line(s)');
            }
            if (Number(row.delivery_reference_count) > 0) {
                dependencyNotes.push(String(row.delivery_reference_count) + ' delivery line(s)');
            }
            if (Number(row.production_reference_count) > 0) {
                dependencyNotes.push(String(row.production_reference_count) + ' production snapshot line(s)');
            }
            if (Number(row.usage_reference_count) > 0) {
                dependencyNotes.push(String(row.usage_reference_count) + ' usage record(s)');
            }
            const dependencyNote = dependencyNotes.length > 0
                ? '<div class="bakeshop-inline-note">In use by ' + escapeHtml(dependencyNotes.join(' · ')) + '.</div>'
                : '';

            return '<tr data-row-kind="ingredient" data-row-id="' + escapeHtml(resolvedRowId) + '">'
                + selectionCell
                + '<td><strong>' + escapeHtml(row.name) + '</strong>' + dependencyNote + '</td>'
                + '<td>' + escapeHtml(row.sku || '—') + '</td>'
                + '<td>' + escapeHtml([row.default_unit_code, row.default_unit_name].filter(Boolean).join(' — ') || '—') + '</td>'
                + '<td>' + rowStatusChip(row.is_active) + '</td>'
                + '<td>' + rowActionButtons('ingredient', row) + '</td>'
                + '</tr>';
        }).join('');

        syncIngredientViewControls();
        syncIngredientSelectionControls(rows);
    }

    function renderDeliveriesTable(rows) {
        const tbody = document.querySelector('#deliveries-table tbody');
        if (!tbody) {
            return;
        }

        if (!rows.length) {
            tbody.innerHTML = '<tr><td colspan="6" class="bakeshop-muted">No deliveries yet.</td></tr>';
            syncDeliverySelectionControls(rows);
            return;
        }

        tbody.innerHTML = rows.map((row) => {
            const resolvedRowId = normalizedRowId('delivery', row);
            const selected = resolvedRowId > 0 && state.selectedDeliveryIds.has(resolvedRowId);
            const expanded = resolvedRowId > 0 && Number(state.expandedDeliveryId || 0) === resolvedRowId;
            const selectionCell = canManageWorkspace && resolvedRowId > 0
                ? '<td class="bakeshop-checkbox-cell"><input class="bakeshop-checkbox" type="checkbox" data-delivery-select="' + escapeHtml(resolvedRowId) + '" aria-label="Select delivery ' + escapeHtml(row.reference || String(resolvedRowId)) + '"' + (selected ? ' checked' : '') + '></td>'
                : '<td class="bakeshop-checkbox-cell"></td>';
            const actionButtons = [
                '<button type="button" class="bakeshop-link-button" data-action="toggle-delivery-detail" data-id="' + escapeHtml(row.id) + '">' + (expanded ? 'Hide Details' : 'View Details') + '</button>'
            ];
            if (canManageWorkspace) {
                actionButtons.push('<button type="button" class="bakeshop-link-button warn" data-action="delete-delivery" data-id="' + escapeHtml(row.id) + '">Delete</button>');
            }

            return '<tr data-row-kind="delivery" data-row-id="' + escapeHtml(resolvedRowId) + '">'
                + selectionCell
                + '<td><strong>' + escapeHtml(row.branch_name || '—') + '</strong><div class="bakeshop-inline-note">' + escapeHtml(row.source_label || 'Delivery source not set') + '</div></td>'
                + '<td>' + escapeHtml(row.delivered_at || '—') + '</td>'
                + '<td>' + escapeHtml(row.reference || '—') + '<div class="bakeshop-inline-note">' + escapeHtml(row.received_by || 'Receiver not set') + '</div></td>'
                + '<td><div class="bakeshop-detail-stack"><span>' + escapeHtml(row.item_count || 0) + ' item(s)</span><span>' + escapeHtml(row.total_quantity || '0') + ' total qty</span><span>' + escapeHtml(row.cost_basis_summary || 'Cost basis pending') + '</span></div></td>'
                + '<td><div class="bakeshop-row-actions">' + actionButtons.join('') + '</div></td>'
                + '</tr>'
                + (expanded
                    ? '<tr class="bakeshop-row-focus"><td colspan="6">' + renderDeliveryDetail(row) + '</td></tr>'
                    : '');
        }).join('');

        syncDeliverySelectionControls(rows);
    }

    function renderBranchTables() {
        const filteredBranches = state.branches.filter((row) => rowMatchesSearch(tableSearchQuery('#branches-filter'), [row.code, row.name, row.address]));

        renderTable('#branches-table', filteredBranches, [
            (row) => escapeHtml(row.code),
            (row) => escapeHtml(row.name),
            (row) => escapeHtml(row.address || '—'),
            (row) => rowStatusChip(row.is_active),
            (row) => rowActionButtons('branch', row)
        ], 'No branches yet.', 'branch');
        applyFocusedRow('#branches-table', 'branch', filteredBranches, 'Branch');

        const activeBranches = state.branches.filter((row) => Number(row.is_active) !== 0);
        populateSelect('#delivery-branch', activeBranches, (row) => ({ value: row.id, label: row.code + ' — ' + row.name }), 'Select branch');
        populateSelect('#production-branch', activeBranches, (row) => ({ value: row.id, label: row.code + ' — ' + row.name }), 'Select branch');
        populateSelect('#usage-branch', state.branches, (row) => ({ value: row.id, label: row.code + ' — ' + row.name }), 'All branches');
    }

    function renderCatalogTables() {
        const activeProductId = Number(state.activeProductId || 0);
        const recipeQuery = tableSearchQuery('#recipes-filter');
        if (focusState.kind === 'product' && !focusState.applied) {
            const focusedProduct = state.products.find((row) => Number(row.id) === focusState.id);
            if (focusedProduct) {
                state.productListView = Number(focusedProduct.is_active) === 0 ? 'archived' : 'active';
            }
        }
        if (focusState.kind === 'ingredient' && !focusState.applied) {
            const focusedIngredient = state.ingredients.find((row) => Number(row.id) === focusState.id);
            if (focusedIngredient) {
                state.ingredientListView = Number(focusedIngredient.is_active) === 0 ? 'archived' : 'active';
            }
        }
        const filteredProducts = filteredProductRows();
        const filteredIngredients = filteredIngredientRows();
        const filteredRecipes = activeProductId > 0
            ? state.recipes.filter((row) => Number(row.product_id) === activeProductId && rowMatchesSearch(recipeQuery, [row.ingredient_name, row.unit_code, row.notes]))
            : [];

        renderProductsTable(filteredProducts);

        renderIngredientsTable(filteredIngredients);

        renderTable('#recipes-table', filteredRecipes, [
            (row) => escapeHtml(row.ingredient_name),
            (row) => displayTwoDecimalQuantity(row.qty),
            (row) => escapeHtml(row.unit_code),
            (row) => escapeHtml(row.notes || '—'),
            (row) => canManageWorkspace
                ? '<div class="bakeshop-row-actions"><button type="button" class="bakeshop-link-button" data-action="edit-recipe" data-id="' + escapeHtml(row.id) + '">Edit</button><button type="button" class="bakeshop-link-button warn" data-action="delete-recipe" data-id="' + escapeHtml(row.id) + '">Delete</button></div>'
                : '<span class="bakeshop-inline-note">View only</span>'
        ], activeProductId > 0 ? 'No recipe lines yet for this product.' : 'Edit a product to view its recipe lines.', 'recipe');
        applyFocusedRow('#products-table', 'product', filteredProducts, 'Product');
        applyFocusedRow('#ingredients-table', 'ingredient', filteredIngredients, 'Ingredient');
        applyFocusedRow('#recipes-table', 'recipe', filteredRecipes, 'Recipe line');

        if (activeProductId > 0) {
            const activeProductRow = document.querySelector('#products-table tbody tr[data-row-kind="product"][data-row-id="' + activeProductId + '"]');
            if (activeProductRow) {
                activeProductRow.classList.add('bakeshop-row-editing');
            }
        }

        populateSelect('#product-yield-unit', state.units, (row) => ({ value: row.id, label: row.code + ' — ' + row.name }), 'Select yield unit');
        populateSelect('#ingredient-unit', state.units, (row) => ({ value: row.id, label: row.code + ' — ' + row.name }), 'Select default unit');
        populateSelect('#recipe-unit', state.units, (row) => ({ value: row.id, label: row.code + ' — ' + row.name }), 'Select unit');
        const activeProducts = state.products.filter((row) => Number(row.is_active) !== 0);
        const activeIngredients = state.ingredients.filter((row) => Number(row.is_active) !== 0);
        const filteredProductionProducts = activeProducts.filter((row) => rowMatchesSearch(tableSearchQuery('#production-products-filter'), [row.name, row.sku, row.category, row.default_yield_unit_code]));
        renderProductionProductsTable(filteredProductionProducts);
        populateSelect('#recipe-ingredient', activeIngredients, (row) => ({ value: row.id, label: row.name }), 'Select ingredient');
        syncRecipePanel();
    }

    function renderOperationalTables() {
        const filteredDeliveries = filteredDeliveryRows();
        const filteredProduction = state.production.filter((row) => rowMatchesSearch(tableSearchQuery('#production-filter'), [row.branch_name, row.product_name, row.produced_at, row.produced_by, row.notes, row.qty_produced, row.default_yield_unit_code, row.consumed_item_count, row.total_consumed_qty]));

        if (focusState.kind === 'delivery' && !focusState.applied) {
            activateDeliverySectionTab('saved');
        }

        renderDeliveriesTable(filteredDeliveries);

        renderTable('#production-table', filteredProduction, [
            (row) => escapeHtml(row.branch_name),
            (row) => escapeHtml(row.product_name) + (Number(row.id || 0) === Number(state.lastSavedProductionId || 0) ? ' <span class="bakeshop-chip recent">Recent</span>' : ''),
            (row) => escapeHtml(row.produced_at),
            (row) => escapeHtml(row.qty_produced) + ' ' + escapeHtml(row.default_yield_unit_code || ''),
            (row) => renderProductionSnapshotDetail(row),
            (row) => canManageWorkspace
                ? '<div class="bakeshop-row-actions"><button type="button" class="bakeshop-link-button" data-action="edit-production" data-id="' + escapeHtml(row.id) + '">Edit Details</button><button type="button" class="bakeshop-link-button warn" data-action="void-production" data-id="' + escapeHtml(row.id) + '">Void Entry</button></div>'
                : '<span class="bakeshop-inline-note">View only</span>'
        ], 'No saved entries yet.', 'production');
        document.querySelectorAll('#production-table tbody tr[data-row-kind="production"]').forEach((rowElement) => {
            const rowId = Number(rowElement.getAttribute('data-row-id') || '0');
            rowElement.classList.toggle('bakeshop-row-recent', rowId > 0 && rowId === Number(state.lastSavedProductionId || 0));
        });
        const productionSavedCount = $('#production-saved-count');
        const productionSavedLatestItem = $('#production-saved-latest-item');
        const productionSavedLatestBranch = $('#production-saved-latest-branch');
        if (productionSavedCount) {
            productionSavedCount.textContent = String(filteredProduction.length || 0);
        }
        if (productionSavedLatestItem) {
            productionSavedLatestItem.textContent = state.lastSavedProductionSummary && state.lastSavedProductionSummary.product_name
                ? state.lastSavedProductionSummary.product_name
                : 'None yet';
        }
        if (productionSavedLatestBranch) {
            productionSavedLatestBranch.textContent = state.lastSavedProductionSummary && state.lastSavedProductionSummary.branch_name
                ? state.lastSavedProductionSummary.branch_name
                : 'No branch yet';
        }
        applyFocusedRow('#deliveries-table', 'delivery', filteredDeliveries, 'Delivery');
        applyFocusedRow('#production-table', 'production', filteredProduction, 'Saved entry');
    }

    function renderUsage() {
        const filteredUsage = state.usage.filter((row) => rowMatchesSearch(tableSearchQuery('#usage-filter'), [row.branch_name, row.period_date, row.ingredient_name, row.unit_code || row.dimension, row.delivered_qty_base, row.consumed_qty_base, row.variance_qty_base]));
        const filteredInventory = state.inventorySnapshot.filter((row) => rowMatchesSearch(tableSearchQuery('#inventory-filter'), [row.branch_name, row.ingredient_name, row.unit_code || row.dimension, row.delivered_qty_base, row.consumed_qty_base, row.on_hand_qty_base]));

        renderTable('#usage-table', filteredUsage, [
            (row) => escapeHtml(row.branch_name),
            (row) => escapeHtml(row.period_date),
            (row) => escapeHtml(row.ingredient_name),
            (row) => escapeHtml(row.unit_code || row.dimension || 'unit'),
            (row) => escapeHtml(row.delivered_qty_base),
            (row) => escapeHtml(row.consumed_qty_base),
            (row) => escapeHtml(row.variance_qty_base)
        ], 'No usage rows matched the selected filters.');

        const usageZeroValue = (0).toFixed(state.usageDecimalPlaces);
        $('#usage-total-delivered').textContent = state.usageTotals.delivered_display || state.usageTotals.delivered_qty_base || usageZeroValue;
        $('#usage-total-consumed').textContent = state.usageTotals.consumed_display || state.usageTotals.consumed_qty_base || usageZeroValue;
        $('#usage-total-variance').textContent = state.usageTotals.variance_display || state.usageTotals.variance_qty_base || usageZeroValue;
        $('#usage-factual-ingredients').textContent = String(state.factualSummary.ingredient_count || 0);
        $('#usage-factual-deliveries').textContent = String(state.factualSummary.delivery_item_count || 0);
        $('#usage-factual-runs').textContent = String(state.factualSummary.production_run_count || 0);

        renderTable('#inventory-table', filteredInventory, [
            (row) => escapeHtml(row.branch_name),
            (row) => escapeHtml(row.ingredient_name),
            (row) => escapeHtml(row.unit_code || row.dimension || 'unit'),
            (row) => escapeHtml(row.delivered_qty_base),
            (row) => escapeHtml(row.consumed_qty_base),
            (row) => '<strong>' + escapeHtml(row.on_hand_qty_base) + '</strong>'
        ], 'No inventory snapshot rows are available for the selected branch yet.');
        $('#inventory-total-on-hand').textContent = state.inventoryTotals.on_hand_display || state.inventoryTotals.on_hand_qty_base || usageZeroValue;
        $('#inventory-total-lines').textContent = String(state.inventoryTotals.item_count || state.inventorySnapshot.length || 0);
    }

    function syncPrintLink() {
        const scope = currentReportScope();

        printLink.href = apiUrl('/admin/bakeshop/print', scope);
    }

    function collectDeliveryItems() {
        return Array.from(deliveryLines.querySelectorAll('tr[data-ingredient-id]')).map((row) => ({
            ingredient_id: row.getAttribute('data-ingredient-id') || '',
            unit_id: row.getAttribute('data-unit-id') || '',
            qty: row.querySelector('[data-field="qty"]').value,
            unit_cost: row.querySelector('[data-field="unit_cost"]').value,
            cost_basis: row.querySelector('[data-field="cost_basis"]').value
        })).filter((item) => {
            const parsedQty = Number(item.qty);
            return Number.isFinite(parsedQty) && parsedQty > 0;
        });
    }

    function clearDeliverySheetValues() {
        deliveryLines.querySelectorAll('[data-field="qty"], [data-field="unit_cost"]').forEach((input) => {
            input.value = '';
        });
        deliveryLines.querySelectorAll('[data-field="cost_basis"]').forEach((input) => {
            input.value = '';
        });
        deliveryLines.querySelectorAll('tr').forEach((row) => row.classList.remove('is-imported'));
        if (deliveryCsvFile) {
            deliveryCsvFile.value = '';
        }
    }

    function renderDeliverySheet() {
        const activeIngredients = state.ingredients.filter((row) => Number(row.is_active) !== 0);
        if (!deliveryLines) {
            return;
        }

        if (!activeIngredients.length) {
            deliveryLines.innerHTML = '<tr><td colspan="6" class="bakeshop-muted">Add active ingredients in Products + Recipes before recording daily deliveries.</td></tr>';
            return;
        }

        deliveryLines.innerHTML = activeIngredients.map((row) => {
            const unitLabel = [row.default_unit_code, row.default_unit_name].filter(Boolean).join(' — ');
            const searchText = [row.name, row.sku || '', row.default_unit_code || ''].join(' ').toLowerCase();
            const disabledAttr = canManageWorkspace ? '' : ' disabled';
            return '<tr data-ingredient-id="' + escapeHtml(row.id) + '" data-unit-id="' + escapeHtml(row.default_unit_id) + '" data-search="' + escapeHtml(searchText) + '">'
                + '<td><strong>' + escapeHtml(row.name) + '</strong></td>'
                + '<td>' + escapeHtml(row.sku || '—') + '</td>'
                + '<td>' + escapeHtml(unitLabel || '—') + '</td>'
                + '<td><input data-field="qty" type="number" min="0" step="0.0001" placeholder="0.0000"' + disabledAttr + '></td>'
                + '<td><input data-field="unit_cost" type="number" min="0" step="0.0001" placeholder="Optional"' + disabledAttr + '></td>'
                + '<td><select data-field="cost_basis" class="bakeshop-table-input"' + disabledAttr + '><option value="">Delivery Source</option><option value="receipt">Receipt</option><option value="price_list">Price List</option><option value="manual">Manual</option></select></td>'
                + '</tr>';
        }).join('');
    }

    function filterDeliverySheet() {
        const query = ($('#delivery-sheet-filter').value || '').trim().toLowerCase();
        deliveryLines.querySelectorAll('tr[data-ingredient-id]').forEach((row) => {
            const haystack = row.getAttribute('data-search') || '';
            row.hidden = query !== '' && !haystack.includes(query);
        });
    }

    function parseCsvRows(text) {
        const rows = [];
        let current = '';
        let row = [];
        let inQuotes = false;

        for (let index = 0; index < text.length; index += 1) {
            const char = text[index];
            const next = text[index + 1] || '';

            if (char === '"') {
                if (inQuotes && next === '"') {
                    current += '"';
                    index += 1;
                } else {
                    inQuotes = !inQuotes;
                }
                continue;
            }

            if (char === ',' && !inQuotes) {
                row.push(current);
                current = '';
                continue;
            }

            if ((char === '\n' || char === '\r') && !inQuotes) {
                if (char === '\r' && next === '\n') {
                    index += 1;
                }
                row.push(current);
                if (row.some((cell) => cell.trim() !== '')) {
                    rows.push(row);
                }
                row = [];
                current = '';
                continue;
            }

            current += char;
        }

        row.push(current);
        if (row.some((cell) => cell.trim() !== '')) {
            rows.push(row);
        }

        return rows;
    }

    function importDeliveryCsv(text) {
        const rows = parseCsvRows(text);
        if (rows.length < 2) {
            throw new Error('CSV import needs a header row and at least one data row.');
        }

        const normalizeHeader = (value) => value.trim().toLowerCase().replace(/[^a-z0-9]+/g, '_');
        const headers = rows[0].map(normalizeHeader);
        const skuIndex = headers.findIndex((header) => ['sku', 'ingredient_sku'].includes(header));
        const ingredientIndex = headers.findIndex((header) => ['ingredient', 'ingredient_name', 'name'].includes(header));
        const qtyIndex = headers.findIndex((header) => ['qty', 'quantity', 'delivered_qty'].includes(header));
        const unitCostIndex = headers.findIndex((header) => ['unit_cost', 'cost', 'unit_price'].includes(header));
        const costBasisIndex = headers.findIndex((header) => ['cost_basis', 'basis', 'cost_source'].includes(header));

        if (qtyIndex === -1 || (skuIndex === -1 && ingredientIndex === -1)) {
            throw new Error('CSV import needs `sku` or `ingredient`, plus `qty` headers.');
        }

        const rowByLookup = new Map();
        deliveryLines.querySelectorAll('tr[data-ingredient-id]').forEach((row) => {
            const cells = row.querySelectorAll('td');
            const ingredientName = (cells[0]?.textContent || '').trim().toLowerCase();
            const sku = (cells[1]?.textContent || '').trim().toLowerCase();
            if (ingredientName !== '') {
                rowByLookup.set(ingredientName, row);
            }
            if (sku !== '' && sku !== '—') {
                rowByLookup.set(sku, row);
            }
            row.classList.remove('is-imported');
        });

        let matched = 0;
        const unmatched = [];
        rows.slice(1).forEach((row) => {
            const lookupValue = String((skuIndex !== -1 ? row[skuIndex] : row[ingredientIndex]) || '').trim().toLowerCase();
            const qtyValue = String(row[qtyIndex] || '').trim();
            const unitCostValue = unitCostIndex !== -1 ? String(row[unitCostIndex] || '').trim() : '';
            const costBasisValue = costBasisIndex !== -1
                ? String(row[costBasisIndex] || '').trim().toLowerCase().replace(/[^a-z]+/g, '_')
                : '';

            if (lookupValue === '' || qtyValue === '') {
                return;
            }

            const targetRow = rowByLookup.get(lookupValue);
            if (!targetRow) {
                unmatched.push(lookupValue);
                return;
            }

            targetRow.querySelector('[data-field="qty"]').value = qtyValue;
            targetRow.querySelector('[data-field="unit_cost"]').value = unitCostValue;
            targetRow.querySelector('[data-field="cost_basis"]').value = ['receipt', 'price_list', 'manual'].includes(costBasisValue) ? costBasisValue : '';
            targetRow.classList.add('is-imported');
            matched += 1;
        });

        filterDeliverySheet();

        if (!matched) {
            throw new Error('No CSV rows matched the listed ingredients. Use SKU or exact ingredient names.');
        }

        if (unmatched.length) {
            showBanner('Imported ' + matched + ' ingredient rows. Unmatched rows: ' + unmatched.slice(0, 5).join(', ') + (unmatched.length > 5 ? '…' : '') + '.', true);
            return;
        }

        showBanner('Imported ' + matched + ' ingredient rows from CSV.', true);
    }

    function downloadDeliveryCsvTemplate() {
        const activeIngredients = state.ingredients.filter((row) => Number(row.is_active) !== 0);
        const lines = ['sku,ingredient,qty,unit_cost,cost_basis'];
        activeIngredients.forEach((row) => {
            lines.push([
                '"' + String(row.sku || '').replace(/"/g, '""') + '"',
                '"' + String(row.name || '').replace(/"/g, '""') + '"',
                '',
                '',
                ''
            ].join(','));
        });

        const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8' });
        const link = document.createElement('a');
        const objectUrl = URL.createObjectURL(blob);
        link.href = objectUrl;
        link.download = 'bakeshop-daily-deliveries-template.csv';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(objectUrl);
    }

    async function loadBranches(force = false) {
        if (!force && state.loaded.branches) {
            renderBranchTables();
            return;
        }
        const data = await request(api.branches);
        state.branches = normalizeMaintenanceRows('branch', data.items || []);
        state.loaded.branches = true;
        renderBranchTables();
    }

    async function loadUnits(force = false) {
        if (!force && state.loaded.units) {
            renderCatalogTables();
            return;
        }
        const data = await request(api.units);
        state.units = data.items || [];
        state.loaded.units = true;
        renderCatalogTables();
    }

    async function loadProducts(force = false) {
        if (!force && state.loaded.products) {
            renderCatalogTables();
            updateStats();
            return;
        }
        const data = await request(api.products);
        state.products = normalizeMaintenanceRows('product', data.items || []);
        state.loaded.products = true;
        pruneProductSelection();
        renderCatalogTables();
        updateStats();
    }

    async function loadIngredients(force = false) {
        if (!force && state.loaded.ingredients) {
            renderCatalogTables();
            renderDeliverySheet();
            filterDeliverySheet();
            updateStats();
            return;
        }
        const data = await request(api.ingredients);
        state.ingredients = normalizeMaintenanceRows('ingredient', data.items || []);
        state.loaded.ingredients = true;
        pruneIngredientSelection();
        renderCatalogTables();
        renderDeliverySheet();
        filterDeliverySheet();
        updateStats();
    }

    async function loadRecipes(force = false) {
        if (!force && state.loaded.recipes) {
            renderCatalogTables();
            updateStats();
            return;
        }
        const data = await request(api.recipes);
        state.recipes = data.items || [];
        state.loaded.recipes = true;
        renderCatalogTables();
        updateStats();
    }

    async function loadDeliveries(force = false) {
        if (!force && state.loaded.deliveries) {
            renderOperationalTables();
            return;
        }
        const data = await request(api.deliveries);
        state.deliveries = data.items || [];
        state.loaded.deliveries = true;
        pruneDeliverySelection();
        renderOperationalTables();
    }

    async function loadProduction(force = false) {
        if (!force && state.loaded.production) {
            renderOperationalTables();
            return;
        }
        const data = await request(api.production);
        state.production = data.items || [];
        state.loaded.production = true;
        renderOperationalTables();
    }

    async function loadUsage() {
        syncPrintLink();
        const scope = currentReportScope();
        const usageBranch = $('#usage-branch');
        const usageFrom = $('#usage-from');
        const usageTo = $('#usage-to');
        if (usageBranch) {
            usageBranch.value = scope.branch_id || '';
        }
        if (usageFrom) {
            usageFrom.value = scope.from_date || '';
        }
        if (usageTo) {
            usageTo.value = scope.to_date || '';
        }
        const data = await request(apiUrl(api.usage, scope));
        if (data.settings && Number.isFinite(Number(data.settings.usage_decimal_places))) {
            state.usageDecimalPlaces = Number(data.settings.usage_decimal_places);
        }
        state.usage = data.items || [];
        state.usageTotals = data.totals || state.usageTotals;
        state.factualSummary = data.factual_summary || state.factualSummary;
        state.inventorySnapshot = (data.inventory && data.inventory.items) || [];
        state.inventoryTotals = (data.inventory && data.inventory.totals) || state.inventoryTotals;
        renderUsage();
    }

    async function ensureTabData(tabName, options = {}) {
        const force = options.force === true;
        const resolvedTab = resolveTabName(tabName);
        const tabRequirements = {
            branches: ['branches'],
            catalog: ['units', 'products', 'ingredients', 'recipes'],
            ingredients: ['units', 'ingredients'],
            deliveries: ['branches', 'ingredients', 'deliveries'],
            production: ['branches', 'products', 'production'],
            usage: ['branches', 'usage']
        };
        const datasetLoaders = {
            branches: loadBranches,
            units: loadUnits,
            products: loadProducts,
            ingredients: loadIngredients,
            recipes: loadRecipes,
            deliveries: loadDeliveries,
            production: loadProduction,
            usage: loadUsage
        };

        for (const requirement of tabRequirements[resolvedTab] || []) {
            await datasetLoaders[requirement](force);
        }
    }

    async function submitJson(url, payload, successMessage, after) {
        try {
            const data = await request(url, {
                method: 'POST',
                body: JSON.stringify({ _token: csrfToken, ...payload })
            });
            showBanner(successMessage, true);
            if (typeof after === 'function') {
                await after(data);
            }
            return data;
        } catch (error) {
            showBanner(error.message || 'Request failed.', false);
            return null;
        }
    }

    function confirmDelete(message) {
        return window.confirm(message);
    }

    function closeDeleteConfirm(confirmed) {
        if (deleteConfirm) {
            deleteConfirm.hidden = true;
        }
        document.body.classList.remove('bakeshop-confirm-open');

        if (typeof pendingDeleteConfirmResolve === 'function') {
            const resolve = pendingDeleteConfirmResolve;
            pendingDeleteConfirmResolve = null;
            resolve(confirmed === true);
        }
    }

    function confirmBulkDelete(options = {}) {
        const previewItems = Array.from(new Set((options.items || []).map((item) => String(item || '').trim()).filter(Boolean)));
        const previewLimit = 5;

        if (!deleteConfirm || !deleteConfirmTitle || !deleteConfirmMessage || !deleteConfirmImpact || !deleteConfirmList || !deleteConfirmOverflow || !deleteConfirmSubmit) {
            const fallbackMessage = [
                options.message || 'Delete the selected records?',
                previewItems.length ? previewItems.slice(0, previewLimit).map((item) => '- ' + item).join('\n') : '',
                previewItems.length > previewLimit ? ('+' + String(previewItems.length - previewLimit) + ' more') : ''
            ].filter(Boolean).join('\n\n');
            return Promise.resolve(window.confirm(fallbackMessage));
        }

        if (typeof pendingDeleteConfirmResolve === 'function') {
            closeDeleteConfirm(false);
        }

        deleteConfirmTitle.textContent = options.title || 'Delete selected records?';
        deleteConfirmMessage.textContent = options.message || 'Review the selected items before confirming this delete.';

        const impactMessage = String(options.impact || '').trim();
        deleteConfirmImpact.textContent = impactMessage;
        deleteConfirmImpact.hidden = impactMessage === '';

        deleteConfirmList.innerHTML = previewItems.slice(0, previewLimit)
            .map((item) => '<li>' + escapeHtml(item) + '</li>')
            .join('');
        deleteConfirmList.hidden = previewItems.length === 0;

        if (previewItems.length > previewLimit) {
            deleteConfirmOverflow.textContent = '+' + String(previewItems.length - previewLimit) + ' more selected item(s)';
            deleteConfirmOverflow.hidden = false;
        } else {
            deleteConfirmOverflow.textContent = '';
            deleteConfirmOverflow.hidden = true;
        }

        deleteConfirmSubmit.textContent = options.confirmLabel || 'Delete Selected';
        deleteConfirm.hidden = false;
        document.body.classList.add('bakeshop-confirm-open');

        return new Promise((resolve) => {
            pendingDeleteConfirmResolve = resolve;
            deleteConfirmCancel?.focus();
        });
    }

    function promptRequiredValue(message, defaultValue = '') {
        const value = window.prompt(message, defaultValue);
        if (value === null) {
            return null;
        }

        const normalized = String(value).trim();
        if (normalized === '') {
            showBanner('A reason is required to void a saved entry.', false);
            return null;
        }

        return normalized;
    }

    function syncEditorActionButtons(options) {
        const addButton = options.addSelector ? $(options.addSelector) : null;
        const cancelButton = options.cancelSelector ? $(options.cancelSelector) : null;
        const editing = options.editing === true;

        if (addButton) {
            addButton.disabled = !canManageWorkspace || editing;
        }

        if (cancelButton) {
            cancelButton.hidden = !editing;
            cancelButton.disabled = !canManageWorkspace || !editing;
        }
    }

