<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password — {brand_settings.store_name}</title>
    {if gui.font_url}<link href="{gui.font_url}" rel="stylesheet">{/if}
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --primary: {gui.color_primary};
            --primary-hover: {gui.color_primary_hover};
            --primary-light: {gui.color_primary_light};
            --bg: {gui.color_bg};
            --surface: {gui.color_surface};
            --border: {gui.color_border};
            --text: {gui.color_text};
            --text-muted: {gui.color_text_muted};
        }
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            font-family: {gui.font_family | raw};
            background: var(--bg);
            color: var(--text);
        }
        .login-card {
            width: 100%;
            max-width: 380px;
            background: var(--surface);
            border-radius: 12px;
            box-shadow: 0 4px 24px rgba(0,0,0,.08);
            padding: 40px 32px;
        }
        .login-logo { text-align: center; margin-bottom: 32px; }
        .login-mark {
            width: 78px;
            height: 78px;
            margin: 0 auto 14px;
            border-radius: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: color-mix(in srgb, var(--primary-light) 72%, white);
            border: 1px solid color-mix(in srgb, var(--border) 85%, transparent);
            color: var(--primary);
            font-size: 28px;
            font-weight: 700;
            box-shadow: 0 18px 32px rgba(120, 53, 15, 0.12);
        }
        .login-mark img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            background: #fff;
            padding: 10px;
        }
        .login-logo h1 { font-size: 24px; font-weight: 700; color: var(--text); }
        .login-logo h1 span { color: var(--primary); }
        .login-logo p { font-size: 13px; color: var(--text-muted); margin-top: 4px; }
        .auth-copy {
            text-align: center;
            margin: 0 0 20px;
        }
        .auth-copy h2 { font-size: 20px; font-weight: 700; color: var(--text); }
        .auth-copy span { display: block; margin-top: 8px; color: var(--text-muted); font-size: 13px; line-height: 1.5; }
        .error-msg {
            background: #fee2e2;
            color: #dc2626;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 16px;
            display: none;
        }
        .error-msg.show { display: block; }
        .success-msg {
            background: #ecfdf3;
            color: #166534;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 16px;
            display: none;
        }
        .success-msg.show { display: block; }
        .form-group { margin-bottom: 20px; }
        .form-label {
            display: block;
            margin-bottom: 6px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-muted);
        }
        .form-input {
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 15px;
            font-family: inherit;
            background: rgba(255,255,255,.88);
            transition: border-color .15s;
        }
        .form-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-light);
        }
        .btn-login {
            width: 100%;
            padding: 12px;
            margin-top: 4px;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: background .15s;
        }
        .btn-login:hover { background: var(--primary-hover); }
        .btn-login:disabled { opacity: .6; cursor: not-allowed; }
        .login-links {
            display: flex;
            justify-content: center;
            margin: 18px 0 0;
        }
        .login-links a {
            color: var(--primary);
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
        }
        .login-links a:hover { color: var(--primary-hover); text-decoration: underline; }
    </style>
    {if gui.css_overrides}<style>{gui.css_overrides}</style>{/if}
</head>
<body>
    <div class="login-card">
        <div class="login-logo">
            <div class="login-mark">{brand_mark_html | raw}</div>
            <h1>{brand_settings.store_name}</h1>
            <p>{brand_settings.store_description}</p>
        </div>

        <div class="auth-copy">
            <h2>Forgot Password</h2>
            <span>Enter your bakeshop username or email to receive a reset link.</span>
        </div>

        <div id="forgot-error" class="error-msg"></div>
        <div id="forgot-success" class="success-msg"></div>

        <form id="forgot-form">
            <div class="form-group">
                <label class="form-label" for="identity">Username or Email</label>
                <input class="form-input" id="identity" name="identity" type="text" autocomplete="username" required autofocus>
            </div>
            <button class="btn-login" type="submit" id="forgot-submit">Send Reset Link</button>
        </form>

        <div class="login-links"><a href="{login_page_url}">Back to sign in</a></div>
    </div>

    <script>
        document.getElementById('forgot-form').addEventListener('submit', async function (event) {
            event.preventDefault();
            const submit = document.getElementById('forgot-submit');
            const error = document.getElementById('forgot-error');
            const success = document.getElementById('forgot-success');
            error.classList.remove('show');
            success.classList.remove('show');
            submit.disabled = true;
            submit.textContent = 'Sending link...';

            try {
                const response = await fetch('{forgot_password_endpoint}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ identity: document.getElementById('identity').value })
                });
                const payload = await response.json();
                if (!response.ok || !payload.ok) {
                    error.textContent = payload.error || 'Unable to send reset link.';
                    error.classList.add('show');
                } else {
                    success.textContent = payload.message || 'If the account exists, a reset link has been sent.';
                    success.classList.add('show');
                }
            } catch (err) {
                error.textContent = 'Network error. Please try again.';
                error.classList.add('show');
            }

            submit.disabled = false;
            submit.textContent = 'Send Reset Link';
        });
    </script>
</body>
</html>