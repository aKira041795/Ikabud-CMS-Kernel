<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password — {brand_settings.store_name}</title>
    <style>
        :root {
            --primary: {gui.color_primary};
            --primary-hover: {gui.color_primary_hover};
            --primary-light: {gui.color_primary_light};
            --bg: {gui.color_bg};
            --surface: {gui.color_surface};
            --border: {gui.color_border};
            --text: {gui.color_text};
            --text-muted: {gui.color_text_muted};
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            font-family: {gui.font_family | raw};
            background: var(--bg);
            color: var(--text);
        }
        .auth-card {
            width: 100%;
            max-width: 420px;
            background: var(--surface);
            border: 1px solid color-mix(in srgb, var(--border) 88%, transparent);
            border-radius: 24px;
            box-shadow: 0 28px 80px rgba(120, 53, 15, 0.18);
            padding: 32px 30px;
        }
        .auth-brand { text-align: center; margin-bottom: 24px; }
        .auth-mark {
            width: 84px;
            height: 84px;
            margin: 0 auto 14px;
            border-radius: 26px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: color-mix(in srgb, var(--primary-light) 72%, white);
            border: 1px solid color-mix(in srgb, var(--border) 85%, transparent);
            color: var(--primary);
            font-size: 28px;
            font-weight: 700;
        }
        .auth-mark img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            background: #fff;
            padding: 10px;
        }
        h1 {
            margin: 0;
            font-family: "Fraunces", Georgia, serif;
            font-size: 2rem;
            line-height: 1.1;
        }
        .auth-brand p {
            margin: 10px auto 0;
            max-width: 30ch;
            color: var(--text-muted);
            font-size: 0.95rem;
            line-height: 1.5;
        }
        .auth-copy {
            text-align: center;
            margin: 0 0 18px;
        }
        .auth-copy h2 { margin: 0; font-size: 1.35rem; }
        .auth-copy span { display: block; margin-top: 8px; color: var(--text-muted); font-size: 0.95rem; }
        label {
            display: block;
            margin-bottom: 6px;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--text-muted);
        }
        input {
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 12px 14px;
            font: inherit;
            background: rgba(255,255,255,0.9);
        }
        input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-light);
        }
        .message {
            display: none;
            margin: 0 0 14px;
            padding: 12px 14px;
            border-radius: 12px;
            font-size: 0.92rem;
        }
        .message.show { display: block; }
        .message.error { background: #fff1f2; color: #b91c1c; border: 1px solid #fecdd3; }
        .message.ok { background: #ecfdf3; color: #166534; border: 1px solid #bbf7d0; }
        .submit {
            width: 100%;
            margin-top: 16px;
            border: none;
            border-radius: 12px;
            background: var(--primary);
            color: #fff;
            font: inherit;
            font-weight: 700;
            padding: 13px 16px;
            cursor: pointer;
        }
        .submit:hover { background: var(--primary-hover); }
        .submit:disabled { opacity: 0.65; cursor: wait; }
        .back-link {
            margin-top: 18px;
            text-align: center;
            font-size: 0.88rem;
        }
        .back-link a { color: var(--primary); text-decoration: none; }
        .back-link a:hover { color: var(--primary-hover); text-decoration: underline; }
    </style>
    {if gui.css_overrides}<style>{gui.css_overrides}</style>{/if}
</head>
<body>
    <div class="auth-card">
        <div class="auth-brand">
            <div class="auth-mark">{brand_mark_html | raw}</div>
            <h1>{brand_settings.store_name}</h1>
            <p>{brand_settings.store_description}</p>
        </div>

        <div class="auth-copy">
            <h2>Forgot Password</h2>
            <span>Enter your bakeshop username or email to receive a reset link.</span>
        </div>

        <div id="forgot-error" class="message error"></div>
        <div id="forgot-success" class="message ok"></div>

        <form id="forgot-form">
            <label for="identity">Username or Email</label>
            <input id="identity" name="identity" type="text" autocomplete="username" required>
            <button class="submit" type="submit" id="forgot-submit">Send Reset Link</button>
        </form>

        <div class="back-link"><a href="{login_page_url}">Back to sign in</a></div>
    </div>

    <script>
        document.getElementById('forgot-form').addEventListener('submit', async function (event) {
            event.preventDefault();
            const submit = document.getElementById('forgot-submit');
            const error = document.getElementById('forgot-error');
            const success = document.getElementById('forgot-success');
            error.classList.remove('show');
            success.classList.remove('show');
            submit.disabled = true;
            submit.textContent = 'Sending link...';

            try {
                const response = await fetch('{forgot_password_endpoint}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ identity: document.getElementById('identity').value })
                });
                const payload = await response.json();
                if (!response.ok || !payload.ok) {
                    error.textContent = payload.error || 'Unable to send reset link.';
                    error.classList.add('show');
                } else {
                    success.textContent = payload.message || 'If the account exists, a reset link has been sent.';
                    success.classList.add('show');
                }
            } catch (err) {
                error.textContent = 'Network error. Please try again.';
                error.classList.add('show');
            }

            submit.disabled = false;
            submit.textContent = 'Send Reset Link';
        });
    </script>
</body>
</html>