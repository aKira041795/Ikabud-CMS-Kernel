<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title | default:'Bakeshop Print Summary'}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --border-color: #ead8bc;
            --text-color: #2b190c;
            --text-muted: #7c5a32;
            --surface-color: #fffdf8;
            --accent: #92400e;
            --font-body: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            font-family: var(--font-body);
            color: var(--text-color);
            background: linear-gradient(180deg, #fff8ef 0%, #fffdf8 100%);
            padding: 24px;
        }

        .bakeshop-print-shell {
            max-width: 1040px;
            margin: 0 auto;
            background: var(--surface-color);
            border: 1px solid var(--border-color);
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(120, 53, 15, 0.08);
        }

        .bakeshop-print-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 20px 24px;
            border-bottom: 1px solid var(--border-color);
            background: linear-gradient(145deg, #fff7ed, #fffbeb);
        }

        .bakeshop-print-brand {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .bakeshop-print-brand-logo {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            background: #fff;
            flex: 0 0 auto;
        }

        .bakeshop-print-brand-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
            padding: 5px;
        }

        .bakeshop-print-brand-copy {
            display: grid;
            gap: 4px;
        }

        .bakeshop-print-brand strong {
            font-family: var(--font-body);
            font-size: 1.45rem;
            font-weight: 800;
            color: var(--accent);
        }

        .bakeshop-print-brand span {
            color: var(--text-muted);
            font-size: 0.92rem;
        }

        .bakeshop-print-brand small {
            color: var(--text-muted);
            font-size: 0.82rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .bakeshop-print-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .bakeshop-print-actions button,
        .bakeshop-print-actions a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            border: 1px solid #1d4ed8;
            background: #2563eb;
            color: #ffffff;
            padding: 10px 14px;
            text-decoration: none;
            cursor: pointer;
        }
        .bakeshop-print-actions button:hover,
        .bakeshop-print-actions a:hover { background: #1d4ed8; }
        .bakeshop-print-actions .secondary {
            border-color: var(--border-color);
            background: #fff;
            color: var(--text-color);
        }

        .bakeshop-print-body {
            padding: 24px;
        }

        .bakeshop-print-body h2,
        .bakeshop-print-body h3 {
            font-family: var(--font-body);
            font-weight: 800;
        }

        @media (max-width: 720px) {
            body { padding: 12px; }
            .bakeshop-print-topbar { padding: 16px; flex-direction: column; align-items: flex-start; }
            .bakeshop-print-body { padding: 16px; }
        }

        @media print {
            body { padding: 0; background: #fff; }
            .bakeshop-print-shell { border: none; border-radius: 0; box-shadow: none; }
            .bakeshop-print-topbar { display: none !important; }
        }
    </style>
    {block head}{/block}
</head>
<body>
    <div class="bakeshop-print-shell">
        <div class="bakeshop-print-topbar">
            <div class="bakeshop-print-brand">
                {if brand_settings.store_logo_url}
                <div class="bakeshop-print-brand-logo">
                    <img src="{brand_settings.store_logo_url}" alt="{brand_settings.store_name} logo">
                </div>
                {/if}
                <div class="bakeshop-print-brand-copy">
                    <strong>{brand_settings.store_name}</strong>
                    <span>{brand_settings.store_description}</span>
                    <small>Printable branch ingredient balance summary</small>
                </div>
            </div>
            <div class="bakeshop-print-actions">
                <a class="secondary" href="javascript:window.close()">Close</a>
                <button type="button" onclick="window.print()">Print Report</button>
            </div>
        </div>
        <main class="bakeshop-print-body">
            {block content}{/block}
        </main>
    </div>
    {block scripts}{/block}
</body>
</html>