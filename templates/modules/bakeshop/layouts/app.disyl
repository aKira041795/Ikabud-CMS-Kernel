<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title | default:'Bakeshop Operations'}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --page-bg: linear-gradient(180deg, #eef5ff 0%, #e0ecff 48%, #d6e6ff 100%);
            --surface-color: rgba(248, 251, 255, 0.98);
            --surface-strong: #ffffff;
            --surface-soft: #edf4ff;
            --border-color: #c8d7f2;
            --sidebar-bg: linear-gradient(180deg, #153b7a 0%, #0f2851 100%);
            --sidebar-border: rgba(255, 255, 255, 0.08);
            --sidebar-text: rgba(239, 246, 255, 0.84);
            --sidebar-text-strong: #f8fbff;
            --accent: #2563eb;
            --accent-strong: #1d4ed8;
            --accent-soft: rgba(37, 99, 235, 0.14);
            --text-color: #111827;
            --text-muted: #374151;
            --shadow-lg: 0 24px 60px rgba(30, 64, 175, 0.12);
            --shadow-sm: 0 12px 26px rgba(30, 64, 175, 0.08);
            --font-body: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            --font-size-h2: clamp(1.6rem, 2vw, 2rem);
            --radius-card: 14px;
            --radius-control: 10px;
        }

        * { box-sizing: border-box; }
        html, body { margin: 0; min-height: 100%; }
        body {
            font-family: var(--font-body);
            color: var(--text-color);
            background: var(--page-bg);
        }

        a { color: inherit; }
        button, input, select, textarea { font: inherit; }

        .bakeshop-sidebar-toggle {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .bakeshop-mobile-overlay,
        .bakeshop-mobile-nav-button,
        .bakeshop-sidebar-close {
            display: none;
        }

        .bakeshop-admin-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: minmax(238px, 272px) minmax(0, 1fr);
        }

        .sidebar {
            background: var(--sidebar-bg);
            color: var(--sidebar-text);
            padding: 24px 18px 20px;
            display: grid;
            gap: 22px;
            align-content: start;
            border-right: 1px solid var(--sidebar-border);
            position: sticky;
            top: 0;
            min-height: 100vh;
            overflow-y: auto;
        }

        .bakeshop-sidebar-close {
            align-items: center;
            justify-content: center;
            align-self: flex-end;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, 0.16);
            padding: 8px 12px;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: var(--sidebar-text-strong);
            background: rgba(255, 255, 255, 0.08);
            cursor: pointer;
        }

        .bakeshop-brand {
            display: grid;
            grid-template-columns: auto minmax(0, 1fr);
            align-items: start;
            gap: 10px;
            padding: 6px 10px 0;
        }

        .bakeshop-brand-mark {
            width: 52px;
            height: 52px;
            border-radius: var(--radius-card);
            background: linear-gradient(145deg, rgba(96, 165, 250, 0.24), rgba(37, 99, 235, 0.38));
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-body);
            font-weight: 800;
            font-size: 1.45rem;
            color: var(--sidebar-text-strong);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
            overflow: hidden;
        }

        .bakeshop-brand-mark img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
            padding: 5px;
            background: #ffffff;
        }

        .bakeshop-brand h1 {
            margin: 0;
            font-size: 1.45rem;
            font-weight: 800;
            line-height: 1.05;
            color: var(--sidebar-text-strong);
        }

        .bakeshop-brand p {
            margin: 0;
            font-size: 0.92rem;
            line-height: 1.55;
        }

        .bakeshop-nav {
            display: grid;
            gap: 14px;
        }

        .bakeshop-nav-group {
            display: grid;
            gap: 8px;
        }

        .bakeshop-nav-label {
            padding: 0 10px;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: rgba(255, 247, 237, 0.5);
        }

        .bakeshop-nav a {
            display: flex;
            align-items: center;
            gap: 12px;
            border-radius: var(--radius-control);
            padding: 13px 14px;
            text-decoration: none;
            color: var(--sidebar-text);
            border: 1px solid transparent;
            background: transparent;
            transition: background-color 0.16s ease, border-color 0.16s ease, transform 0.16s ease;
        }

        .bakeshop-nav a:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.07);
            transform: translateX(1px);
        }

        .bakeshop-nav a.active {
            background: linear-gradient(145deg, rgba(96, 165, 250, 0.2), rgba(37, 99, 235, 0.22));
            border-color: rgba(147, 197, 253, 0.24);
            color: var(--sidebar-text-strong);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
        }

        .bakeshop-nav-title {
            display: grid;
            gap: 2px;
        }

        .bakeshop-nav-title strong {
            font-size: 0.93rem;
            font-weight: 600;
            color: inherit;
        }

        .bakeshop-nav-title span {
            font-size: 0.79rem;
            color: inherit;
            opacity: 0.82;
        }

        .bakeshop-nav-submenu {
            display: grid;
            gap: 4px;
            padding-left: 12px;
        }

        .bakeshop-nav-submenu a {
            padding: 9px 12px;
            border-radius: 12px;
            font-size: 0.84rem;
            color: rgba(255, 247, 237, 0.82);
            border-color: transparent;
        }

        .bakeshop-nav-submenu a:hover {
            transform: none;
            background: rgba(255, 255, 255, 0.05);
        }

        .bakeshop-nav-submenu a.active {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(147, 197, 253, 0.18);
            color: var(--sidebar-text-strong);
            box-shadow: none;
        }

        .bakeshop-sidebar-card {
            margin-top: auto;
            border-radius: var(--radius-card);
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(255, 255, 255, 0.05);
            padding: 16px;
            display: grid;
            gap: 10px;
        }

        .bakeshop-sidebar-card h2 {
            margin: 0;
            font-size: 0.98rem;
            color: var(--sidebar-text-strong);
        }

        .bakeshop-sidebar-card p {
            margin: 0;
            font-size: 0.84rem;
            line-height: 1.55;
        }

        .bakeshop-main {
            min-width: 0;
            display: flex;
            flex-direction: column;
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            padding: 22px 28px 16px;
        }

        .bakeshop-topbar-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 12px;
            width: 100%;
        }

        .bakeshop-topbar-signout {
            margin: 0;
        }

        .bakeshop-title-stack {
            display: grid;
            gap: 6px;
        }

        .bakeshop-kicker {
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--accent-strong);
        }

        .bakeshop-title-stack h2 {
            margin: 0;
            font-size: clamp(1.5rem, 2.2vw, 2.2rem);
            font-weight: 800;
            line-height: 1.05;
        }

        .bakeshop-title-stack p {
            margin: 0;
            color: var(--text-muted);
            font-size: 0.92rem;
        }

        .bakeshop-user-card {
            border-radius: var(--radius-card);
            padding: 14px 16px;
            background: rgba(255, 252, 247, 0.82);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            display: grid;
            gap: 4px;
            min-width: 220px;
        }

        .bakeshop-user-card strong { font-size: 0.96rem; }
        .bakeshop-user-card span,
        .bakeshop-user-card small { color: var(--text-muted); }
        .bakeshop-user-role {
            display: inline-flex;
            align-items: center;
            width: fit-content;
            padding: 4px 9px;
            border-radius: 999px;
            background: var(--accent-soft);
            color: var(--accent-strong);
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .bakeshop-mobile-nav-button {
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: fit-content;
            min-height: 44px;
            border-radius: 999px;
            padding: 0 16px;
            border: 1px solid rgba(37, 99, 235, 0.18);
            background: rgba(255, 255, 255, 0.92);
            box-shadow: var(--shadow-sm);
            color: var(--accent-strong);
            font-size: 0.9rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            cursor: pointer;
        }

        .bakeshop-content {
            padding: 0 28px 28px;
        }

        .bakeshop-content-inner {
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(200, 215, 242, 0.85);
            border-radius: 20px;
            padding: 22px;
            box-shadow: var(--shadow-lg);
        }

        .bakeshop-shell-note {
            margin-top: 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border-radius: 999px;
            padding: 8px 12px;
            background: rgba(219, 234, 254, 0.12);
            border: 1px solid rgba(219, 234, 254, 0.16);
            color: var(--sidebar-text-strong);
            font-size: 0.8rem;
        }

        .bakeshop-onboarding-checklist {
            display: grid;
            gap: 12px;
        }

        .bakeshop-onboarding-step {
            display: grid;
            gap: 10px;
            padding: 14px 16px;
            border-radius: 14px;
            border: 1px solid rgba(180, 83, 9, 0.16);
            background: rgba(255, 255, 255, 0.82);
        }

        .bakeshop-onboarding-step.current {
            border-color: rgba(217, 119, 6, 0.42);
            box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.1);
        }

        .bakeshop-onboarding-step.done {
            border-color: rgba(22, 101, 52, 0.18);
            background: rgba(240, 253, 244, 0.82);
        }

        .bakeshop-onboarding-step-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }

        .bakeshop-onboarding-step h4 {
            margin: 0;
            font-size: 0.95rem;
        }

        .bakeshop-onboarding-step p {
            margin: 0;
            line-height: 1.6;
        }

        .bakeshop-step-status {
            display: inline-flex;
            align-items: center;
            width: fit-content;
            border-radius: 999px;
            padding: 4px 10px;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .bakeshop-step-status.done {
            background: rgba(22, 101, 52, 0.12);
            color: #166534;
        }

        .bakeshop-step-status.current {
            background: rgba(217, 119, 6, 0.12);
            color: #b45309;
        }

        .bakeshop-step-status.pending {
            background: rgba(71, 85, 105, 0.12);
            color: #475569;
        }

        .bakeshop-step-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: fit-content;
            gap: 8px;
            padding: 9px 14px;
            border-radius: 10px;
            border: 1px solid rgba(180, 83, 9, 0.2);
            background: #ffffff;
            color: #92400e;
            font-weight: 700;
            text-decoration: none;
        }

        .bakeshop-step-action:hover {
            background: #fff7ed;
        }

        .bakeshop-sidebar-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 14px;
            border-radius: 2px;
            border: 1px solid #d1d5db;
            background: #ffffff;
            color: #111827;
            text-decoration: none;
            font-weight: 600;
        }

        .bakeshop-sidebar-inline-form {
            margin: 0;
        }

        .bakeshop-sidebar-link:hover {
            background: #f9fafb;
        }

        @media (max-width: 980px) {
            .bakeshop-admin-shell {
                grid-template-columns: 1fr;
            }

            .bakeshop-mobile-overlay {
                display: block;
                position: fixed;
                inset: 0;
                background: rgba(15, 23, 42, 0.52);
                opacity: 0;
                pointer-events: none;
                transition: opacity 0.18s ease;
                z-index: 39;
            }

            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                width: min(86vw, 320px);
                min-height: 100vh;
                z-index: 40;
                box-shadow: 0 28px 64px rgba(15, 23, 42, 0.3);
                transform: translateX(calc(-100% - 18px));
                transition: transform 0.22s ease;
            }

            .bakeshop-sidebar-close,
            .bakeshop-mobile-nav-button {
                display: inline-flex;
            }

            .bakeshop-sidebar-toggle:checked ~ .bakeshop-mobile-overlay {
                opacity: 1;
                pointer-events: auto;
            }

            .bakeshop-sidebar-toggle:checked ~ .bakeshop-admin-shell .sidebar {
                transform: translateX(0);
            }

            .topbar {
                padding-top: 18px;
                flex-direction: column;
                align-items: flex-start;
            }

            .bakeshop-topbar-actions {
                position: sticky;
                top: 0;
                z-index: 30;
                justify-content: space-between;
                padding: 10px 0 6px;
                background: linear-gradient(180deg, rgba(238, 245, 255, 0.98) 0%, rgba(238, 245, 255, 0.92) 78%, rgba(238, 245, 255, 0) 100%);
            }

            .bakeshop-user-card {
                width: 100%;
                min-width: 0;
            }
        }

        @media (max-width: 640px) {
            .topbar,
            .bakeshop-content {
                padding-left: 16px;
                padding-right: 16px;
            }

            .bakeshop-content-inner {
                padding: 16px;
                border-radius: 16px;
            }
        }
    </style>
    {block head}{/block}
</head>
<body>
    <input class="bakeshop-sidebar-toggle" type="checkbox" id="bakeshop-sidebar-toggle" aria-hidden="true">
    <label class="bakeshop-mobile-overlay" for="bakeshop-sidebar-toggle" aria-hidden="true"></label>
    <div class="bakeshop-admin-shell">
        <aside class="sidebar">
            <label class="bakeshop-sidebar-close" for="bakeshop-sidebar-toggle">Close</label>
            <div class="bakeshop-brand">
                <div class="bakeshop-brand-mark">{if brand_settings.store_logo_url}<img src="{brand_settings.store_logo_url}" alt="{brand_settings.store_name} logo">{else}{brand_settings.store_initial}{/if}</div>
                <div>
                    <h1>{brand_settings.store_name}</h1>
                    <p>{brand_settings.store_description}</p>
                </div>
            </div>

            <nav class="bakeshop-nav">
                <div class="bakeshop-nav-group">
                    <div class="bakeshop-nav-label">Daily Work</div>
                    <a href="{base_url}{workspace_overview_url}" class="{if in_workspace}active{/if}">
                        <span class="bakeshop-nav-title">
                            <strong>Operations Workspace</strong>
                            <span>Overview plus focused views for branches, products, ingredients, deliveries, production, and usage</span>
                        </span>
                    </a>
                    {if in_workspace && workspace_submenu_routes}
                    <div class="bakeshop-nav-submenu" aria-label="Focused work areas">
                        <a href="{base_url}{workspace_submenu_routes.branches}" class="{if workspace_nav_current_tab == 'branches'}active{/if}"{if workspace_nav_current_tab == 'branches'} aria-current="page"{/if} data-workspace-submenu="true" data-tab-target="branches" data-server-active="{if workspace_nav_current_tab == 'branches'}true{else}false{/if}">Branches</a>
                        <a href="{base_url}{workspace_submenu_routes.catalog}" class="{if workspace_nav_current_tab == 'catalog'}active{/if}"{if workspace_nav_current_tab == 'catalog'} aria-current="page"{/if} data-workspace-submenu="true" data-tab-target="catalog" data-server-active="{if workspace_nav_current_tab == 'catalog'}true{else}false{/if}">Products</a>
                        <a href="{base_url}{workspace_submenu_routes.ingredients}" class="{if workspace_nav_current_tab == 'ingredients'}active{/if}"{if workspace_nav_current_tab == 'ingredients'} aria-current="page"{/if} data-workspace-submenu="true" data-tab-target="ingredients" data-server-active="{if workspace_nav_current_tab == 'ingredients'}true{else}false{/if}">Ingredients</a>
                        <a href="{base_url}{workspace_submenu_routes.deliveries}" class="{if workspace_nav_current_tab == 'deliveries'}active{/if}"{if workspace_nav_current_tab == 'deliveries'} aria-current="page"{/if} data-workspace-submenu="true" data-tab-target="deliveries" data-server-active="{if workspace_nav_current_tab == 'deliveries'}true{else}false{/if}">Ingredient Deliveries</a>
                        <a href="{base_url}{workspace_submenu_routes.production}" class="{if workspace_nav_current_tab == 'production'}active{/if}"{if workspace_nav_current_tab == 'production'} aria-current="page"{/if} data-workspace-submenu="true" data-tab-target="production" data-server-active="{if workspace_nav_current_tab == 'production'}true{else}false{/if}">Production Runs</a>
                        <a href="{base_url}{workspace_submenu_routes.usage}" class="{if workspace_nav_current_tab == 'usage'}active{/if}"{if workspace_nav_current_tab == 'usage'} aria-current="page"{/if} data-workspace-submenu="true" data-tab-target="usage" data-server-active="{if workspace_nav_current_tab == 'usage'}true{else}false{/if}">Usage Summary</a>
                    </div>
                    {/if}
                </div>

                <div class="bakeshop-nav-group">
                    <div class="bakeshop-nav-label">Reports</div>
                    <a href="{base_url}{workspace_print_url}" target="_blank" rel="noopener">
                        <span class="bakeshop-nav-title">
                            <strong>Print Summary</strong>
                            <span>Open the clean branch usage report</span>
                        </span>
                    </a>
                </div>

                <div class="bakeshop-nav-group">
                    <div class="bakeshop-nav-label">Administration</div>
                    {if can_view_history}
                    <a href="{base_url}{workspace_history_url}" class="{if current_page == 'history'}active{/if}">
                        <span class="bakeshop-nav-title">
                            <strong>Activity History</strong>
                            <span>Changes to staff, settings, and operations</span>
                        </span>
                    </a>
                    {/if}
                    {if can_manage_users}
                    <a href="{base_url}{workspace_users_url}" class="{if current_page == 'users'}active{/if}">
                        <span class="bakeshop-nav-title">
                            <strong>Staff</strong>
                            <span>Admins, supervisors, onboarding</span>
                        </span>
                    </a>
                    {/if}
                    {if can_manage_settings}
                    <a href="{base_url}{workspace_settings_url}" class="{if current_page == 'settings'}active{/if}">
                        <span class="bakeshop-nav-title">
                            <strong>Settings</strong>
                            <span>Access rules and module defaults</span>
                        </span>
                    </a>
                    {/if}
                </div>

                <div class="bakeshop-nav-group">
                    <div class="bakeshop-nav-label">Account</div>
                    <a href="{base_url}{workspace_account_url}" class="{if current_page == 'account'}active{/if}">
                        <span class="bakeshop-nav-title">
                            <strong>My Account</strong>
                            <span>Password and account details</span>
                        </span>
                    </a>
                </div>
            </nav>

            <div class="bakeshop-sidebar-card">
                <h2>Recommended Order</h2>
                <p>Open the operations workspace once, then move across the tabs in order: branches, ingredients, products, deliveries, production, and usage review.</p>
                {if bootstrap_onboarding.required}
                <div class="bakeshop-shell-note">Bootstrap admin handoff is active: {bootstrap_onboarding_guide.completed_count}/{bootstrap_onboarding_guide.total_count} steps finished.</div>
                {/if}
            </div>
        </aside>

        <div class="bakeshop-main">
            <header class="topbar">
                <div class="bakeshop-topbar-actions">
                    <label class="bakeshop-mobile-nav-button" for="bakeshop-sidebar-toggle">Menu</label>
                    <form class="bakeshop-topbar-signout" method="post" action="{base_url}/bakeshop/logout">
                        <input type="hidden" name="_token" value="{csrf_token}">
                        <button class="bakeshop-sidebar-link" type="submit">Sign Out</button>
                    </form>
                </div>
                <div class="bakeshop-title-stack">
                    <span class="bakeshop-kicker">Bakeshop Module</span>
                    <h2 id="bakeshop-page-title">{page_title | default:'Bakeshop Operations'}</h2>
                    <p id="bakeshop-page-intro">{page_intro | default:'Module-owned workspace UI. This shell no longer inherits the kernel admin navigation.'}</p>
                </div>

                <div class="bakeshop-user-card">
                    <strong>{if user.full_name}{user.full_name}{elseif user.name}{user.name}{elseif user.username}{user.username}{else}Bakeshop User{/if}</strong>
                    <span>{if user.email}{user.email}{else}@{user.username | default:'bakeshop'}{/if}</span>
                    <span class="bakeshop-user-role">{user.role | default:'user'}</span>
                </div>
            </header>

            <main class="bakeshop-content">
                <div class="bakeshop-content-inner">
                    {block content}{/block}
                </div>
            </main>
        </div>
    </div>
    {if in_workspace && workspace_submenu_routes}
    <script>
    (() => {
        const submenuLinks = Array.from(document.querySelectorAll('[data-workspace-submenu="true"]'));
        if (!submenuLinks.length) {
            return;
        }

        function syncWorkspaceSubmenu() {
            const hash = window.location.hash.replace(/^#/, '');
            submenuLinks.forEach((link) => {
                const serverActive = link.getAttribute('data-server-active') === 'true';
                const shouldBeActive = hash !== ''
                    ? link.getAttribute('data-tab-target') === hash
                    : serverActive;
                link.classList.toggle('active', shouldBeActive);
                if (shouldBeActive) {
                    link.setAttribute('aria-current', 'page');
                } else {
                    link.removeAttribute('aria-current');
                }
            });
        }

        syncWorkspaceSubmenu();
        window.addEventListener('hashchange', syncWorkspaceSubmenu);
    })();
    </script>
    {/if}
    {block scripts}{/block}
</body>
</html>