{extends "modules/dc-cafe/layouts/auth.disyl"}

{block content}
<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-amber-50 to-orange-100">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl p-8 mx-4">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-amber-800">DC Cafe</h1>
            <p class="text-gray-500 mt-1">Reset Your Password</p>
        </div>

        <form x-data="forgotForm()" x-on:submit.prevent="submit()" class="space-y-5">
            <div>
                <label for="identity" class="block text-sm font-medium text-gray-700 mb-1">Email or Username</label>
                <input type="text" id="identity" name="identity" autocomplete="username" x-model="identity" required
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500"
                       placeholder="Enter your email or username">
            </div>
            <div x-show="error" x-text="error" class="text-red-600 text-sm bg-red-50 p-3 rounded-lg"></div>
            <div x-show="success" x-text="success" class="text-green-600 text-sm bg-green-50 p-3 rounded-lg"></div>
            <button type="submit" x-bind:disabled="loading"
                    class="w-full bg-amber-600 text-white py-2.5 rounded-lg font-semibold hover:bg-amber-700 disabled:opacity-50">
                <span x-show="!loading">Send Reset Link</span>
                <span x-show="loading">Sending...</span>
            </button>
        </form>

        <p class="text-center mt-6 text-sm text-gray-500">
            <a href="/dc-cafe/login" class="text-amber-600 hover:underline">Back to Sign In</a>
        </p>
    </div>
</div>

<script>
function forgotForm() {
    return {
        identity: '',
        error: '',
        success: '',
        loading: false,
        submit() {
            this.loading = true;
            this.error = '';
            this.success = '';
            fetch('/dc-cafe/api/v1/auth/forgot-password', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({identity: this.identity})
            })
            .then(r => r.json())
            .then(d => {
                if (d.ok) {
                    this.success = d.message || 'If the account exists, a reset link has been sent.';
                } else {
                    this.error = d.error || 'Request failed';
                }
            })
            .catch(() => { this.error = 'Connection error'; })
            .finally(() => { this.loading = false; });
        }
    };
}
</script>
{/block}
