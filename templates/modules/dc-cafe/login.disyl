{extends "modules/dc-cafe/layouts/auth.disyl"}

{block content}
<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-amber-50 to-orange-100">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl p-8 mx-4">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-amber-800">DC Cafe</h1>
            <p class="text-gray-500 mt-1">Point of Sale — Sign In</p>
        </div>

        <form x-data="loginForm()" x-on:submit.prevent="submit()" class="space-y-5">
            <div>
                <label for="username" class="block text-sm font-medium text-gray-700 mb-1">Username</label>
                <input type="text" id="username" name="username" autocomplete="username" x-model="username" required
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
            </div>
            <div>
                <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                <input type="password" id="password" name="password" autocomplete="current-password" x-model="password" required
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
            </div>
            <div x-show="error" x-text="error" class="text-red-600 text-sm bg-red-50 p-3 rounded-lg"></div>
            <button type="submit" x-bind:disabled="loading"
                    class="w-full bg-amber-600 text-white py-2.5 rounded-lg font-semibold hover:bg-amber-700 disabled:opacity-50">
                <span x-show="!loading">Sign In</span>
                <span x-show="loading">Signing in...</span>
            </button>
        </form>

        <p class="text-center mt-4 text-sm text-gray-500">
            <a href="/dc-cafe/forgot-password" class="text-amber-600 hover:underline">Forgot password?</a>
        </p>
    </div>
</div>

<script>
function loginForm() {
    return {
        username: '',
        password: '',
        error: '',
        loading: false,
        submit() {
            this.loading = true;
            this.error = '';
            fetch('/dc-cafe/auth/login', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({username: this.username, password: this.password})
            })
            .then(r => r.json())
            .then(d => {
                if (d.ok) { window.location.href = '/dc-cafe/pos'; }
                else { this.error = d.error || 'Login failed'; }
            })
            .catch(() => { this.error = 'Connection error'; })
            .finally(() => { this.loading = false; });
        }
    };
}
</script>
{/block}
