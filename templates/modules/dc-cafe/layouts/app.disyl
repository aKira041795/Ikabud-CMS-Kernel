<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title ?? "DC Cafe POS"}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>[x-cloak] { display: none !important; }</style>
</head>
<body class="bg-gray-50">
    <nav class="bg-amber-700 text-white shadow-lg">
        <div class="max-w-[1800px] mx-auto px-4">
            <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 min-h-14 py-2">
                <div class="flex flex-wrap items-center gap-x-3 sm:gap-x-6">
                    <a href="{home_url}" class="font-bold text-lg">DC Cafe</a>
                    {* A viewer is here to read the numbers, so the till-facing links are
                       not offered at all rather than shown and then refused. The other
                       roles keep the exclusion rules they had. *}
                    {if user.role != 'viewer'}
                    {* Role: all except auditor *}
                    {if user.role != 'auditor'}
                    <a href="/dc-cafe/pos" class="text-amber-200 hover:text-white text-sm">POS</a>
                    {/if}
                    {* Role: all. The trail covers every activity, not just sales. *}
                    <a href="/dc-cafe/audit" class="text-amber-200 hover:text-white text-sm">Audit</a>
                    {* Role: all *}
                    <a href="/dc-cafe/inventory" class="text-amber-200 hover:text-white text-sm">Inventory</a>
                    <a href="/dc-cafe/inventory/ledger" class="text-amber-200 hover:text-white text-sm">Ledger</a>
                    {if user.role != 'auditor'}
                    <a href="/dc-cafe/products/receive" class="text-amber-200 hover:text-white text-sm">Deliveries</a>
                    {/if}
                    {* Role: all *}
                    <a href="/dc-cafe/customers" class="text-amber-200 hover:text-white text-sm">Customers</a>
                    {/if}
                    {* Whatever dcAnalyticsRoles() allows, so the link and the page it opens
                       cannot disagree — including a viewer whose branch switched the surface
                       off while the session was already open. *}
                    {if can_view_analytics}
                    <a href="/dc-cafe/dashboard" class="text-amber-200 hover:text-white text-sm">Dashboard</a>
                    <a href="/dc-cafe/reports" class="text-amber-200 hover:text-white text-sm">Reports</a>
                    {/if}
                    {* Role: admin, supervisor *}
                    {if user.role != 'cashier' && user.role != 'auditor' && user.role != 'viewer'}
                    <a href="/dc-cafe/settings" class="text-amber-200 hover:text-white text-sm">Settings</a>
                    {/if}
                </div>
                <div class="flex flex-wrap items-center gap-x-3 sm:gap-x-4">
                    <span class="text-amber-200 text-sm">{user.full_name ?? ''}</span>
                    <a href="/dc-cafe/logout" class="text-amber-200 hover:text-white text-sm">Logout</a>
                </div>
            </div>
        </div>
    </nav>
    <main class="max-w-[1800px] mx-auto px-4 py-6">{block content}{/block}</main>
</body>
</html>
