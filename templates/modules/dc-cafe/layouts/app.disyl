<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title ?? "DC Cafe POS"}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
    <style>[x-cloak] { display: none !important; }</style>
</head>
<body class="bg-gray-50">
    <nav class="bg-amber-700 text-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex items-center justify-between h-14">
                <div class="flex items-center space-x-6">
                    <a href="/dc-cafe/pos" class="font-bold text-lg">DC Cafe</a>
                    {* Role: all except auditor *}
                    {if user.role != 'auditor'}
                    <a href="/dc-cafe/pos" class="text-amber-200 hover:text-white text-sm">POS</a>
                    {/if}
                    {* Role: all *}
                    <a href="/dc-cafe/orders" class="text-amber-200 hover:text-white text-sm">Orders</a>
                    {* Role: all *}
                    <a href="/dc-cafe/inventory" class="text-amber-200 hover:text-white text-sm">Inventory</a>
                    <a href="/dc-cafe/inventory/ledger" class="text-amber-200 hover:text-white text-sm">Ledger</a>
                    {if user.role != 'auditor'}
                    <a href="/dc-cafe/products/receive" class="text-amber-200 hover:text-white text-sm">Deliveries</a>
                    {/if}
                    {* Role: all *}
                    <a href="/dc-cafe/customers" class="text-amber-200 hover:text-white text-sm">Customers</a>
                    {* Role: admin, supervisor, auditor (not cashier) *}
                    {if user.role != 'cashier'}
                    <a href="/dc-cafe/dashboard" class="text-amber-200 hover:text-white text-sm">Dashboard</a>
                    {/if}
                </div>
                <div class="flex items-center space-x-4">
                    <span class="text-amber-200 text-sm">{user.full_name ?? ''}</span>
                    <a href="/dc-cafe/logout" class="text-amber-200 hover:text-white text-sm">Logout</a>
                </div>
            </div>
        </div>
    </nav>
    <main class="max-w-7xl mx-auto px-4 py-6">{block content}{/block}</main>
</body>
</html>
