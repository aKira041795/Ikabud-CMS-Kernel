{extends "modules/dc-cafe/layouts/app.disyl"}

{block content}
<div x-data="sessionStart()" class="max-w-lg mx-auto mt-12">
    <div class="bg-white rounded-2xl shadow-xl p-8">
        <div class="text-center mb-6">
            <h1 class="text-2xl font-bold text-amber-800">Start Shift</h1>
            <p class="text-gray-500 text-sm mt-1">Welcome, <span class="font-semibold text-amber-700">{user.full_name ?? user.name ?? user.username}</span></p>
        </div>

        <form x-on:submit.prevent="start()" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Shift Type</label>
                <select x-model="shiftType" class="w-full px-4 py-2.5 border rounded-lg">
                    <option value="morning">Morning</option>
                    <option value="afternoon">Afternoon</option>
                    <option value="night">Night</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Starting Cash (₱)</label>
                <input type="number" x-model="startingCash" step="0.01" min="0" value="1000" required
                       class="w-full px-4 py-2.5 border rounded-lg">
            </div>
            <div class="flex items-center">
                <input type="checkbox" x-model="isLateReport" class="mr-2">
                <label class="text-sm text-gray-600">Late report</label>
            </div>
            <div x-show="error" x-text="error" class="text-red-600 text-sm bg-red-50 p-3 rounded-lg"></div>
            <button type="submit" x-bind:disabled="loading"
                    class="w-full bg-amber-600 text-white py-3 rounded-lg font-bold hover:bg-amber-700 disabled:opacity-50">
                <span x-show="!loading">Start Shift</span>
                <span x-show="loading">Starting...</span>
            </button>
        </form>
    </div>
</div>

<script>
function sessionStart() {
    return {
        shiftType: 'morning',
        startingCash: 1000,
        isLateReport: false,
        error: '',
        loading: false,
        start() {
            this.loading = true;
            this.error = '';
            fetch('/dc-cafe/api/v1/sessions/start', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    shift_type: this.shiftType,
                    starting_cash: parseFloat(this.startingCash) || 0,
                    is_late_report: this.isLateReport ? 1 : 0,
                })
            })
            .then(r => r.json()).then(d => {
                if (d.ok) { window.location.href = '/dc-cafe/pos'; }
                else { this.error = d.error; }
            })
            .catch(() => { this.error = 'Connection error'; })
            .finally(() => { this.loading = false; });
        }
    };
}
</script>
{/block}
