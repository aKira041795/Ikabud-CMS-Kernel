{extends "modules/dc-cafe/layouts/app.disyl"}

{block content}
<div x-data="inventoryLedger()" class="space-y-4">
    <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Inventory Reconciliation</h1>
            <p class="mt-1 text-sm text-gray-500">
                Review one shift and branch at a time. Sales and branch stock are read from the system.
            </p>
        </div>
        <div class="w-full lg:w-[32rem]">
            <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-gray-500">Shift session</label>
            <select x-model="sessionId" @change="loadReconciliation()"
                    class="w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500">
                <option value="">Select a shift session</option>
                {for s in sessions}
                <option value="{s.session_id}">
                    {s.shift_start|date:'M d, H:i'} · {s.store_name} · {s.opened_by} · {s.status}
                </option>
                {/for}
            </select>
        </div>
    </div>

    <div x-show="statusMsg" x-cloak
         class="rounded-lg border px-4 py-3 text-sm"
         :class="statusError ? 'border-red-200 bg-red-50 text-red-700' : 'border-green-200 bg-green-50 text-green-700'">
        <span x-text="statusMsg"></span>
    </div>

    <div x-show="sessionMeta" x-cloak class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Selected branch</div>
                <div class="mt-1 font-semibold text-gray-900" x-text="sessionMeta?.store_name || '—'"></div>
                <div class="mt-1 text-xs text-gray-500">
                    Opened by <span x-text="sessionMeta?.opened_by || '—'"></span>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <span class="rounded-full px-2.5 py-1 text-xs font-semibold"
                      :class="sessionMeta?.status === 'active' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700'"
                      x-text="sessionMeta?.status === 'active' ? 'Active shift' : 'Closed shift'"></span>
                <span x-show="!editable" class="rounded-full bg-blue-100 px-2.5 py-1 text-xs font-semibold text-blue-700">
                    Read only
                </span>
            </div>
        </div>
        <p x-show="!editable" class="mt-3 rounded-lg bg-blue-50 px-3 py-2 text-xs text-blue-700">
            This reconciliation can be reviewed, but manual counts cannot be changed for a closed shift or read-only role.
        </p>
    </div>

    <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
        <span class="font-semibold">Calculated Sales</span>
        = Beginning + Production − Pullouts − Ending.
        <span class="ml-1 text-xs text-amber-700">POS Sales comes from completed orders. Stock Variance compares Ending with current Branch Stock.</span>
    </div>

    <div x-show="!sessionId && !loading" class="rounded-xl border bg-white py-12 text-center text-gray-400">
        Select a shift session to view its branch reconciliation.
    </div>

    <div x-show="loading" x-cloak class="rounded-xl border bg-white py-12 text-center text-sm text-gray-500">
        Loading reconciliation…
    </div>

    <div x-show="sessionId && !loading && groups.length === 0 && !statusError" x-cloak
         class="rounded-xl border bg-white py-12 text-center text-gray-400">
        No active catalog products are available for this session.
    </div>

    <div x-show="!loading && groups.length > 0" x-cloak class="space-y-4">
        <template x-for="group in groups" :key="group.name">
            <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
                <div class="flex items-center justify-between border-b bg-gray-50 px-5 py-3">
                    <div>
                        <h2 class="font-semibold text-gray-800" x-text="group.name"></h2>
                        <p class="text-xs text-gray-500" x-text="group.products.length + ' products'"></p>
                    </div>
                    <div class="text-right text-xs text-gray-500">
                        Calculated <b class="text-gray-800" x-text="formatQty(groupTotals(group).calculated)"></b>
                        · POS <b class="text-gray-800" x-text="formatQty(groupTotals(group).pos)"></b>
                        · Pending <b class="text-gray-800" x-text="groupTotals(group).pending"></b>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full min-w-[1380px] text-sm">
                        <thead class="bg-white text-xs uppercase tracking-wide text-gray-500">
                            <tr>
                                <th class="px-4 py-3 text-left">Product</th>
                                <th class="px-3 py-3 text-right">Beginning</th>
                                <th class="px-3 py-3 text-right">Production</th>
                                <th class="px-3 py-3 text-right">Pullouts</th>
                                <th class="px-3 py-3 text-right">Ending</th>
                                <th class="px-3 py-3 text-right">Calculated Sales</th>
                                <th class="px-3 py-3 text-right">POS Sales</th>
                                <th class="px-3 py-3 text-right">Sales Variance</th>
                                <th class="px-3 py-3 text-right">Branch stock</th>
                                <th class="px-3 py-3 text-right">Stock Variance</th>
                                <th class="px-4 py-3 text-left">Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <template x-for="row in group.products" :key="row.product_id">
                                <tr class="border-t border-gray-100"
                                    :class="row.has_discrepancy ? 'bg-amber-50/50' : ''">
                                    <td class="px-4 py-2 font-medium text-gray-800" x-text="row.name"></td>
                                    <td class="px-3 py-2">
                                        <input type="number" min="0" step="any" x-model.number="row.beginning_qty"
                                               :disabled="!editable" @input="queueSave(row)"
                                               class="w-24 rounded border px-2 py-1.5 text-right disabled:bg-gray-100 disabled:text-gray-500">
                                    </td>
                                    <td class="px-3 py-2">
                                        <input type="number" min="0" step="any" x-model.number="row.production_qty"
                                               :disabled="!editable" @input="queueSave(row)"
                                               class="w-24 rounded border px-2 py-1.5 text-right disabled:bg-gray-100 disabled:text-gray-500">
                                    </td>
                                    <td class="px-3 py-2">
                                        <input type="number" min="0" step="any" x-model.number="row.pullout_qty"
                                               :disabled="!editable" @input="queueSave(row)"
                                               class="w-24 rounded border px-2 py-1.5 text-right disabled:bg-gray-100 disabled:text-gray-500">
                                    </td>
                                    <td class="px-3 py-2">
                                        <input type="number" min="0" step="any" x-model="row.ending_input"
                                               :disabled="!editable" @input="queueSave(row)"
                                               placeholder="Count"
                                               class="w-24 rounded border px-2 py-1.5 text-right disabled:bg-gray-100 disabled:text-gray-500">
                                        <div x-show="row.ending_recorded && row.ending_counted_at" class="mt-1 text-[11px] text-gray-400"
                                             x-text="'Counted ' + formatTimestamp(row.ending_counted_at)"></div>
                                    </td>
                                    <td class="px-3 py-2 text-right font-semibold"
                                        :class="row.negative_calculated ? 'text-red-700' : 'text-gray-800'"
                                        x-text="displayDerived(row.calculated_sales_qty)"></td>
                                    <td class="px-3 py-2 text-right font-medium" x-text="formatQty(row.pos_sales_qty)"></td>
                                    <td class="px-3 py-2 text-right font-semibold"
                                        :class="row.sales_variance_class"
                                        x-text="displayDerived(row.sales_variance_qty)"></td>
                                    <td class="px-3 py-2 text-right" x-text="formatQty(row.branch_stock_qty)"></td>
                                    <td class="px-3 py-2 text-right font-semibold"
                                        :class="row.stock_variance_class"
                                        x-text="displayDerived(row.stock_variance_qty)"></td>
                                    <td class="px-4 py-2">
                                        <input type="text" x-model="row.notes" :disabled="!editable"
                                               @input.debounce.1000ms="queueSave(row)" placeholder="Optional note"
                                               class="w-44 rounded border px-2 py-1.5 disabled:bg-gray-100 disabled:text-gray-500">
                                        <div class="mt-1 text-[11px]"
                                             :class="row.info_class"
                                             x-text="row.info_text"></div>
                                    </td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
            </section>
        </template>

        <div class="flex flex-col gap-3 rounded-xl bg-amber-700 px-5 py-3 text-white sm:flex-row sm:items-center sm:justify-between">
            <div class="text-sm">
                <b x-text="allRows().length"></b> products
                · Pending Ending counts <b x-text="grandTotals.pending"></b>
                · Calculated Sales <b x-text="formatQty(grandTotals.calculated)"></b>
                · POS Sales <b x-text="formatQty(grandTotals.pos)"></b>
            </div>
            <button x-show="editable" @click="saveAllManual()" :disabled="dirtyCount === 0 || saving"
                    class="rounded bg-white px-4 py-2 text-sm font-bold text-amber-800 hover:bg-amber-100 disabled:opacity-50">
                <span x-text="saving ? 'Saving…' : (dirtyCount ? 'Save ' + dirtyCount + ' unsaved row(s)' : 'All changes saved')"></span>
            </button>
        </div>
    </div>
</div>

<script>
function inventoryLedger() {
    return {
        sessionId: '',
        sessionMeta: null,
        groups: [],
        loading: false,
        saving: false,
        editable: false,
        statusMsg: '',
        statusError: false,
        saveTimers: {},
        loadSequence: 0,

        allRows() {
            return this.groups.flatMap(group => group.products);
        },
        get dirtyCount() {
            return this.allRows().filter(row => row._dirty).length;
        },
        get grandTotals() {
            return this.allRows().reduce((totals, row) => {
                totals.pos += row.pos_sales_qty || 0;
                if (row.ending_recorded && row.calculated_sales_qty !== null) {
                    totals.calculated += row.calculated_sales_qty;
                } else {
                    totals.pending += 1;
                }
                return totals;
            }, {pos: 0, calculated: 0, pending: 0});
        },
        groupTotals(group) {
            return group.products.reduce((totals, row) => {
                totals.pos += row.pos_sales_qty || 0;
                if (row.ending_recorded && row.calculated_sales_qty !== null) {
                    totals.calculated += row.calculated_sales_qty;
                } else {
                    totals.pending += 1;
                }
                return totals;
            }, {pos: 0, calculated: 0, pending: 0});
        },
        formatQty(value) {
            const qty = Number(value);
            return Number.isFinite(qty) ? qty.toFixed(2) : '—';
        },
        displayDerived(value) {
            return value === null || value === undefined ? 'Pending count' : this.formatQty(value);
        },
        formatTimestamp(value) {
            if (!value) return '';
            const parsed = new Date(String(value).replace(' ', 'T'));
            return Number.isNaN(parsed.getTime()) ? value : parsed.toLocaleString();
        },
        syncDerived(row) {
            const beginning = parseFloat(row.beginning_qty) || 0;
            const production = parseFloat(row.production_qty) || 0;
            const pullout = parseFloat(row.pullout_qty) || 0;
            const posSales = parseFloat(row.pos_sales_qty) || 0;
            const branchStock = parseFloat(row.branch_stock_qty) || 0;
            const ending = row.ending_input !== '' && row.ending_input !== null
                ? parseFloat(row.ending_input)
                : null;

            row.ending_qty = ending;
            if (ending === null || Number.isNaN(ending)) {
                row.ending_recorded = false;
                row.calculated_sales_qty = null;
                row.sales_variance_qty = null;
                row.stock_variance_qty = null;
                row.negative_calculated = false;
                row.sales_variance_class = 'text-gray-500';
                row.stock_variance_class = 'text-gray-500';
                row.has_discrepancy = false;
                row.info_class = 'text-gray-400';
                row.info_text = 'Pending count. Calculated Sales and variances will appear after Ending is recorded.';
                return;
            }

            row.ending_recorded = true;
            row.calculated_sales_qty = beginning + production - pullout - ending;
            row.sales_variance_qty = row.calculated_sales_qty - posSales;
            row.stock_variance_qty = ending - branchStock;
            row.negative_calculated = row.calculated_sales_qty < 0;
            row.sales_variance_class = Math.abs(row.sales_variance_qty) > 0.001 ? 'text-amber-700' : 'text-green-700';
            row.stock_variance_class = Math.abs(row.stock_variance_qty) > 0.001 ? 'text-amber-700' : 'text-green-700';
            row.has_discrepancy = row.negative_calculated
                || Math.abs(row.sales_variance_qty) > 0.001
                || Math.abs(row.stock_variance_qty) > 0.001;
            row.info_class = row.negative_calculated ? 'text-red-600' : 'text-gray-500';
            row.info_text = row.negative_calculated
                ? 'Negative Calculated Sales means the count exceeds available inventory for this shift.'
                : (Math.abs(row.sales_variance_qty) > 0.001
                    ? 'Sales Variance compares worksheet depletion with completed POS orders.'
                    : (Math.abs(row.stock_variance_qty) > 0.001
                        ? 'Stock Variance compares Ending with the current branch stock snapshot.'
                        : 'Calculated Sales and POS Sales agree for this row.'));
        },
        clearPendingSaves() {
            Object.values(this.saveTimers).forEach(timer => clearTimeout(timer));
            this.saveTimers = {};
        },
        setStatus(message, isError = false) {
            this.statusMsg = message;
            this.statusError = isError;
        },
        async request(url, options = {}) {
            const response = await fetch(url, options);
            let data = {};
            try {
                data = await response.json();
            } catch (error) {
                throw new Error('The server returned an unreadable response.');
            }
            if (!response.ok || !data.ok) {
                throw new Error(data.error || 'The request could not be completed.');
            }
            return data;
        },
        async loadReconciliation() {
            const loadSequence = ++this.loadSequence;
            this.clearPendingSaves();
            this.groups = [];
            this.sessionMeta = null;
            this.editable = false;
            this.setStatus('');
            if (!this.sessionId) return;

            this.loading = true;
            try {
                const data = await this.request('/dc-cafe/api/v1/inventory/reconciliation/' + this.sessionId);
                if (loadSequence !== this.loadSequence) return;
                this.sessionMeta = data.session || null;
                this.editable = !!data.session?.editable;

                const groups = new Map();
                (data.items || []).forEach(item => {
                    const name = item.ledger_group || 'Unassigned';
                    if (!groups.has(name)) groups.set(name, []);
                    const beginning = parseFloat(item.beginning_qty) || 0;
                    const production = parseFloat(item.production_qty) || 0;
                    const pullout = parseFloat(item.pullout_qty) || 0;
                    const endingRecorded = !!item.ending_recorded;
                    const endingQty = endingRecorded && item.ending_qty !== null ? parseFloat(item.ending_qty) : null;
                    const row = {
                        product_id: Number(item.product_id),
                        name: item.name,
                        beginning_qty: beginning,
                        production_qty: production,
                        pullout_qty: pullout,
                        ending_input: endingRecorded && endingQty !== null ? String(endingQty) : '',
                        ending_qty: endingQty,
                        ending_recorded: endingRecorded,
                        ending_counted_at: item.ending_counted_at || '',
                        calculated_sales_qty: item.calculated_sales_qty === null ? null : parseFloat(item.calculated_sales_qty),
                        pos_sales_qty: parseFloat(item.pos_sales_qty) || 0,
                        sales_variance_qty: item.sales_variance_qty === null ? null : parseFloat(item.sales_variance_qty),
                        branch_stock_qty: parseFloat(item.branch_stock_qty) || 0,
                        stock_variance_qty: item.stock_variance_qty === null ? null : parseFloat(item.stock_variance_qty),
                        notes: item.notes || '',
                        _dirty: false,
                        negative_calculated: false,
                        sales_variance_class: 'text-gray-500',
                        stock_variance_class: 'text-gray-500',
                        has_discrepancy: false,
                        info_class: 'text-gray-400',
                        info_text: '',
                    };
                    this.syncDerived(row);
                    groups.get(name).push(row);
                });
                this.groups = Array.from(groups, ([name, products]) => ({name, products}));
                this.setStatus(this.editable ? 'Ledger loaded. Physical Ending counts can be updated.' : 'Ledger loaded in read-only mode.');
            } catch (error) {
                if (loadSequence !== this.loadSequence) return;
                this.groups = [];
                this.sessionMeta = null;
                this.setStatus(error.message || 'Unable to load reconciliation.', true);
            } finally {
                if (loadSequence === this.loadSequence) {
                    this.loading = false;
                }
            }
        },
        queueSave(row) {
            if (!this.editable) return;
            this.syncDerived(row);
            row._dirty = true;
        },
        payloadFor(rows) {
            return {
                session_id: Number(this.sessionId),
                items: rows.map(row => ({
                    product_id: row.product_id,
                    beginning_qty: parseFloat(row.beginning_qty) || 0,
                    production_qty: parseFloat(row.production_qty) || 0,
                    pullout_qty: parseFloat(row.pullout_qty) || 0,
                    ending_qty: row.ending_input !== '' && row.ending_input !== null ? (parseFloat(row.ending_input) || 0) : null,
                    notes: row.notes || '',
                })),
            };
        },
        async persist(rows) {
            if (!this.editable || rows.length === 0) return;
            await this.request('/dc-cafe/api/v1/inventory/progress', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(this.payloadFor(rows)),
            });
            rows.forEach(row => { row._dirty = false; });
        },
        async saveAllManual() {
            const dirty = this.allRows().filter(row => row._dirty);
            if (!this.editable || dirty.length === 0) return;
            this.saving = true;
            try {
                await this.persist(dirty);
                this.setStatus('Manual reconciliation counts saved.');
            } catch (error) {
                this.setStatus(error.message || 'Unable to save manual counts.', true);
            } finally {
                this.saving = false;
            }
        },
    };
}
</script>
{/block}
