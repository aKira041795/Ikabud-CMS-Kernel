{* Shared void-approval dialog.

   A cashier may start a void, but it only completes when an administrator or
   supervisor supplies their own void PIN. Including this partial in both the
   POS and the order detail page keeps one implementation of that flow.

   Hosts start it:     dcAskVoid(<order_id>)
   Hosts react to it:  dcOnVoidDone(function (orderId, approvedBy) { ... })

   Both are plain function calls on purpose. DiSyL treats a single-line brace
   group that looks like a tag — {id: 1, label: 'x'} — as one of its own tags
   and strips it, so an inline $dispatch('x', {id: 1}) silently compiles to
   $dispatch('x', ) and the click handler breaks.

   The PIN is verified server-side; this dialog only collects it. *}
<div x-data="dcVoidApproval()" x-cloak>
    <div x-show="show"
         class="fixed inset-0 bg-black bg-opacity-50 z-[60] flex items-center justify-center p-4"
         x-on:click.self="close()"
         x-on:keydown.escape.window="close()">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-sm p-5">
            <h2 class="text-lg font-bold text-gray-800">Supervisor approval</h2>
            <p class="text-sm text-gray-500 mt-1">
                Voiding <span class="font-medium text-gray-700" x-text="label"></span> returns the stock
                and removes the sale. A supervisor must approve.
            </p>

            <div class="mt-4">
                <label class="block text-xs font-semibold text-gray-600 mb-1" for="dc-void-pin">
                    Supervisor void PIN
                </label>
                <input id="dc-void-pin" type="password" inputmode="numeric" autocomplete="off"
                       x-model="pin" x-ref="pin"
                       x-on:keydown.enter="submit()"
                       class="w-full px-3 py-2 border rounded text-lg tracking-[0.4em] text-center"
                       placeholder="••••">
            </div>

            <div x-show="error"
                 class="mt-3 text-sm text-red-700 bg-red-50 border border-red-200 rounded px-3 py-2"
                 x-text="error"></div>

            <div class="mt-4 flex gap-2">
                <button type="button" x-on:click="close()"
                        class="flex-1 bg-gray-200 text-gray-700 py-2.5 rounded-lg font-semibold text-sm hover:bg-gray-300">
                    Cancel
                </button>
                <button type="button" x-on:click="submit()" :disabled="busy || !pin"
                        class="flex-1 bg-red-600 text-white py-2.5 rounded-lg font-semibold text-sm hover:bg-red-700 disabled:opacity-50"
                        x-text="busy ? 'Voiding…' : 'Approve &amp; Void'"></button>
            </div>
        </div>
    </div>
</div>

<script>
// The one live dialog. Page markup cannot reach into this component's scope
// directly, so it calls dcAskVoid instead.
var dcVoidDialog = null;
var dcVoidDoneHandler = null;

function dcAskVoid(orderId) {
    if (dcVoidDialog) {
        dcVoidDialog.open(orderId);
    }
}

function dcOnVoidDone(fn) {
    dcVoidDoneHandler = fn;
}

function dcVoidApproval() {
    return {
        show: false,
        orderId: 0,
        label: '',
        pin: '',
        busy: false,
        error: '',

        init() {
            dcVoidDialog = this;
        },

        open(orderId) {
            var id = Number(orderId) || 0;
            if (!id) return;
            this.orderId = id;
            this.label = 'order #' + id;
            this.pin = '';
            this.error = '';
            this.busy = false;
            this.show = true;
            var self = this;
            this.$nextTick(function () {
                if (self.$refs.pin) self.$refs.pin.focus();
            });
        },

        close() {
            this.show = false;
            this.pin = '';
            this.error = '';
        },

        submit() {
            if (this.busy || !this.pin || !this.orderId) return;
            this.busy = true;
            this.error = '';
            var self = this;
            fetch('/dc-cafe/api/v1/orders/' + this.orderId + '/void', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({void_pin: this.pin})
            })
            .then(function (response) {
                return response.json()
                    .catch(function () {
                        return null;
                    })
                    .then(function (body) {
                        return {body: body};
                    });
            })
            .then(function (result) {
                self.busy = false;
                var body = result.body;
                if (body && body.ok) {
                    var approvedBy = body.approved_by || 'Supervisor';
                    var voidedId = self.orderId;
                    self.close();
                    if (dcVoidDoneHandler) {
                        dcVoidDoneHandler(voidedId, approvedBy);
                    }
                    return;
                }
                self.error = (body && body.error) || 'Could not void this sale.';
                self.pin = '';
                self.$nextTick(function () {
                    if (self.$refs.pin) self.$refs.pin.focus();
                });
            })
            .catch(function () {
                self.busy = false;
                self.error = 'Could not reach the server. Please try again.';
            });
        }
    };
}
</script>
