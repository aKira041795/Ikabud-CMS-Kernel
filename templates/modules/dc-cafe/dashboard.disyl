{extends "modules/dc-cafe/layouts/app.disyl"}

{block content}
<div x-data="dashboard()" x-init="load()" class="space-y-6">
    <h1 class="text-2xl font-bold text-gray-800">DC Cafe Dashboard</h1>

    {* KPI Cards *}
    <div class="grid grid-cols-4 gap-4">
        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <div class="text-sm text-gray-500">Today's Sales</div>
            <div class="text-2xl font-bold text-amber-700" x-text="'₱' + today.total.toFixed(2)"></div>
        </div>
        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <div class="text-sm text-gray-500">Transactions</div>
            <div class="text-2xl font-bold text-blue-700" x-text="today.transactions"></div>
        </div>
        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <div class="text-sm text-gray-500">Avg Ticket</div>
            <div class="text-2xl font-bold text-green-700" x-text="'₱' + today.avg_ticket.toFixed(2)"></div>
        </div>
        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <div class="text-sm text-gray-500">Low Stock</div>
            <div class="text-2xl font-bold text-red-700" x-text="lowStock.length"></div>
        </div>
    </div>

    <div class="grid grid-cols-2 gap-6">
        {* Top Products *}
        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <h2 class="font-bold text-gray-700 mb-4">Top Products Today</h2>
            <table class="w-full text-sm">
                <thead><tr class="text-gray-500"><th class="text-left py-2">Product</th><th class="text-right">Qty</th><th class="text-right">Total</th></tr></thead>
                <tbody>
                    <template x-for="p in topProducts" :key="p.name">
                        <tr class="border-t">
                            <td class="py-2" x-text="p.name"></td>
                            <td class="text-right py-2" x-text="p.qty"></td>
                            <td class="text-right py-2 font-semibold" x-text="'₱' + parseFloat(p.total).toFixed(2)"></td>
                        </tr>
                    </template>
                </tbody>
            </table>
            <div x-show="topProducts.length === 0" class="text-gray-400 text-center py-4">No sales today yet.</div>
        </div>

        {* Low Stock *}
        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <h2 class="font-bold text-gray-700 mb-4">Low Stock Alerts</h2>
            <template x-for="item in lowStock" :key="item.ingredient_id">
                <div class="flex justify-between items-center py-2 border-b text-sm">
                    <span x-text="item.name"></span>
                    <span class="text-red-600 font-semibold" x-text="item.current_stock + ' ' + item.unit + ' (reorder: ' + item.reorder_level + ')'"></span>
                </div>
            </template>
            <div x-show="lowStock.length === 0" class="text-green-600 text-center py-4">All stock levels are healthy ✓</div>
        </div>
    </div>

    {* Recent Orders *}
    <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
        <h2 class="font-bold text-gray-700 mb-4">Recent Orders</h2>
        <table class="w-full text-sm">
            <thead><tr class="text-gray-500"><th class="text-left py-2">#</th><th class="text-left">Cashier</th><th class="text-right">Total</th><th class="text-left">Payment</th><th class="text-left">Time</th></tr></thead>
            <tbody>
                <template x-for="o in recentOrders" :key="o.order_id">
                    <tr class="border-t">
                        <td class="py-2"><a x-bind:href="'/dc-cafe/orders/' + o.order_id" class="text-amber-600 hover:underline" x-text="o.order_id"></a></td>
                        <td class="py-2" x-text="o.cashier_name"></td>
                        <td class="text-right py-2 font-semibold" x-text="'₱' + parseFloat(o.total_amount).toFixed(2)"></td>
                        <td class="py-2" x-text="o.payment_method"></td>
                        <td class="py-2 text-gray-500" x-text="o.transaction_date"></td>
                    </tr>
                </template>
            </tbody>
        </table>
    </div>
</div>

<script>
function dashboard() {
    return {
        today: {transactions: 0, total: 0, avg_ticket: 0},
        topProducts: [],
        lowStock: [],
        recentOrders: [],
        load() {
            fetch('/dc-cafe/api/v1/dashboard/today')
                .then(r => r.json()).then(d => {
                    if (d.ok) {
                        this.today = d.today;
                        this.topProducts = d.top_products;
                        this.lowStock = d.low_stock;
                        this.recentOrders = d.recent_orders;
                    }
                });
        }
    };
}
</script>
{/block}
