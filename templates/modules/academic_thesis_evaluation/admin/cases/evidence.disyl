{extends "modules/academic-thesis-evaluation/layouts/admin"}

{block content}
<div class="p-6">
    <div class="mb-6">
        <a href="/admin/thesis-evaluation/cases/{case.id|default:'0'}" class="text-blue-600 hover:underline text-sm">&larr; Back to Case</a>
    </div>

    <h1 class="text-2xl font-bold mb-6">Evidence Review</h1>

    <div class="mb-6 flex items-center gap-3">
        <button class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm"
                onclick="generateEvidence({case.id|default:'0'})">
            {if snapshots|default:[]|length > 0}Regenerate AISS Analysis{else}Generate AISS Analysis{/if}
        </button>
        <span class="text-xs text-gray-500">A failed AISS call is not saved as a zero-result snapshot.</span>
    </div>

    {if snapshots|default:[]|length > 0}
    {for snapshot in snapshots}
    <div class="bg-white rounded-lg shadow p-6 mb-6">
        <div class="flex justify-between items-start mb-4">
            <div>
                <h3 class="text-lg font-semibold">Evidence Snapshot #{snapshot.id}</h3>
                <p class="text-sm text-gray-500">Generated: {snapshot.generated_at|date:"M d, Y H:i"}</p>
            </div>
            <span class="px-3 py-1 text-xs rounded-full bg-gray-100">v{snapshot.evidence_version|default:'1.0'}</span>
        </div>

        {* Maturity badges *}
        {if snapshot.maturity_metadata|default:null}
        <div class="flex flex-wrap gap-2 mb-4">
            {for feature, maturity in snapshot.maturity_metadata}
            <span class="px-2 py-1 rounded bg-gray-100 text-xs text-gray-700">
                {feature}: {maturity}
            </span>
            {/for}
        </div>
        {/if}

        {* Warnings *}
        {if snapshot.capability_warnings|default:null}
        <div class="bg-yellow-50 border border-yellow-200 rounded p-3 mb-4">
            <p class="text-sm font-medium text-yellow-800">Capability Warnings</p>
            <ul class="mt-1 list-disc list-inside text-xs text-yellow-700">
                {for warning in snapshot.capability_warnings}
                <li>{warning}</li>
                {/for}
            </ul>
        </div>
        {/if}

        {if snapshot.textual_result.internet_coverage|default:null}
        <div class="bg-blue-50 border border-blue-200 rounded p-3 mb-4 text-xs text-blue-800">
            Internet coverage:
            {snapshot.textual_result.internet_coverage.imported_count|default:'0'} imported from
            {snapshot.textual_result.internet_coverage.candidate_count|default:'0'} candidates
            ({snapshot.textual_result.internet_coverage.status|default:'unknown'}).
        </div>
        {/if}

        {* Reviewer decisions *}
        <h4 class="font-medium text-sm mb-2">Reviewer Decisions</h4>
        <div class="space-y-2">
            {for decision in decisions|default:[]}
            {if decision.evidence_snapshot_id|default:'0' == snapshot.id}
            <div class="p-3 bg-gray-50 rounded text-sm">
                <div class="flex justify-between">
                    <span>Machine: <code class="text-xs bg-gray-200 px-1 rounded">{decision.machine_relationship|default:'—'}</code></span>
                    <span>Reviewer: <code class="text-xs bg-blue-100 px-1 rounded">{decision.reviewer_relationship|default:'—'}</code></span>
                    <span class="px-2 py-0.5 text-xs rounded-full bg-green-100 text-green-800">{decision.reviewer_action}</span>
                </div>
                {if decision.reviewer_reason}
                <p class="text-xs text-gray-500 mt-1">{decision.reviewer_reason}</p>
                {/if}
            </div>
            {/if}
            {/for}
        </div>

        {* Assessment bundle evidence *}
        {if snapshot.textual_result.assessment_bundle|default:null}
        {set bundle = snapshot.textual_result.assessment_bundle}
        <div class="mt-4 pt-4 border-t border-gray-200">
            <div class="flex flex-wrap gap-2 mb-3">
                {for dim, level in bundle.maturity|default:[]}
                <span class="px-2 py-1 rounded-full text-xs font-medium
                    {if level == 'stable'}bg-green-100 text-green-800
                    {else if level == 'beta'}bg-blue-100 text-blue-800
                    {else if level == 'experimental'}bg-purple-100 text-purple-800
                    {else if level == 'partial'}bg-amber-100 text-amber-800
                    {else}bg-gray-100 text-gray-600{/if}">
                    {dim|replace:"_":" "}: {level}
                </span>
                {/for}
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-3 text-sm">
                <div class="bg-gray-50 rounded p-2"><span class="text-xs text-gray-500">Coverage</span><p class="font-semibold">{bundle.coverage.status|default:'unknown'}</p></div>
                <div class="bg-gray-50 rounded p-2"><span class="text-xs text-gray-500">Imported</span><p class="font-semibold">{bundle.coverage.imported_count|default:0}/{bundle.coverage.candidate_count|default:0}</p></div>
                <div class="bg-gray-50 rounded p-2"><span class="text-xs text-gray-500">Claims</span><p class="font-semibold">{bundle.structure.claims|default:[]|length}</p></div>
                <div class="bg-gray-50 rounded p-2"><span class="text-xs text-gray-500">Sections</span><p class="font-semibold">{bundle.structure.sections|default:[]|length}</p></div>
            </div>

            {if bundle.limitations|default:[]|length > 0}
            <div class="bg-yellow-50 border border-yellow-200 rounded p-3 mb-3">
                <p class="text-sm font-medium text-yellow-800">Limitations</p>
                <ul class="mt-1 list-disc list-inside text-xs text-yellow-700">
                    {for limitation in bundle.limitations}
                    <li>{limitation}</li>
                    {/for}
                </ul>
            </div>
            {/if}

            {if bundle.structure.claims|default:[]|length > 0}
            <details class="border border-gray-200 rounded mb-3">
                <summary class="px-3 py-2 cursor-pointer text-sm font-semibold">Extracted Claims ({bundle.structure.claims|length})</summary>
                <div class="px-3 pb-3 space-y-2">
                    {for claim in bundle.structure.claims}
                    <div class="p-2 bg-gray-50 rounded text-sm">
                        <span class="text-xs font-medium uppercase text-gray-500">{claim.claim_type|replace:"_":" "}</span>
                        <p class="mt-1">{claim.claim_text}</p>
                    </div>
                    {/for}
                </div>
            </details>
            {/if}
        </div>
        {/if}

        {* Machine suggestions + reviewer disposition *}
        {if snapshot.textual_result.assessment_bundle.suggestions|default:[]|length > 0}
        <div class="mt-4 pt-4 border-t border-gray-200">
            <h4 class="font-medium text-sm mb-2">Machine Suggestions — Reviewer Disposition</h4>
            <p class="text-xs text-gray-500 mb-3">Reviewer decisions append to the immutable machine evidence. Linking to a rubric criterion never changes a score.</p>
            <div class="space-y-3">
                {for suggestion in snapshot.textual_result.assessment_bundle.suggestions}
                <div class="p-4 border border-gray-200 rounded-lg">
                    <div class="flex items-center justify-between gap-2">
                        <p class="text-sm font-semibold">{suggestion.title|default:suggestion.suggestion_key}</p>
                        <span class="px-2 py-0.5 rounded-full text-xs font-medium {if suggestion.priority == 'high'}bg-red-100 text-red-800{else if suggestion.priority == 'medium'}bg-amber-100 text-amber-800{else}bg-gray-100 text-gray-700{/if}">{suggestion.priority}</span>
                    </div>
                    <p class="text-sm text-gray-600 mt-1">{suggestion.rationale}</p>
                    <div class="mt-2 flex flex-wrap gap-2 text-xs text-gray-500">
                        <span class="bg-gray-100 rounded px-2 py-0.5">Action: {suggestion.reviewer_action|default:'verify'}</span>
                        <span class="bg-gray-100 rounded px-2 py-0.5">Category: {suggestion.category|default:'—'}</span>
                        <span class="bg-gray-100 rounded px-2 py-0.5">Uncertainty: {suggestion.uncertainty|default:'—'}</span>
                    </div>

                    {for review in suggestion_reviews|default:[]}
                    {if review.suggestion_key == suggestion.suggestion_key}
                    <div class="mt-2 p-2 rounded bg-blue-50 text-xs text-blue-800">
                        Reviewer #{review.reviewer_id} — <strong>{review.reviewer_status|replace:"_":" "}</strong>
                        {if review.reviewer_reason}: {review.reviewer_reason}{/if}
                    </div>
                    {/if}
                    {/for}

                    <div class="mt-3 space-y-2">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                            <select class="border rounded px-2 py-1.5 text-sm" data-suggestion-status="{suggestion.suggestion_key}">
                                <option value="accepted">Accept</option>
                                <option value="edited">Accept with edits</option>
                                <option value="dismissed">Dismiss</option>
                                <option value="converted_to_revision">Convert to revision</option>
                            </select>
                            <select class="border rounded px-2 py-1.5 text-sm" data-suggestion-criterion="{suggestion.suggestion_key}">
                                <option value="">Link rubric criterion (optional)</option>
                                {for criterion in rubric_criteria|default:[]}
                                <option value="{criterion.id}">{criterion.label|default:criterion.code}</option>
                                {/for}
                            </select>
                            <select class="border rounded px-2 py-1.5 text-sm" data-suggestion-revision="{suggestion.suggestion_key}">
                                <option value="">Revision request (for convert)</option>
                                {for revision in revisions|default:[]}
                                <option value="{revision.id}">#{revision.id} {revision.category|default:'revision'} — {revision.status}</option>
                                {/for}
                            </select>
                        </div>
                        <textarea class="w-full border rounded px-2 py-1.5 text-sm" rows="2" placeholder="Reviewer reason (required for accept/edit/dismiss/convert)" data-suggestion-reason="{suggestion.suggestion_key}"></textarea>
                        <textarea class="w-full border rounded px-2 py-1.5 text-sm" rows="2" placeholder="Edited rationale (required when accepting with edits)" data-suggestion-rationale="{suggestion.suggestion_key}"></textarea>
                        <button onclick="reviewSuggestion({case.id|default:'0'}, {snapshot.id}, '{suggestion.suggestion_key}')"
                                class="px-4 py-2 bg-blue-600 text-white rounded text-sm hover:bg-blue-700">Record Disposition</button>
                    </div>
                </div>
                {/for}
            </div>
        </div>
        {/if}
    </div>
    {/for}
    {else}
    <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
        No evidence snapshots generated yet.
    </div>
    {/if}
</div>
{/block}

{block "scripts"}
<script>
function generateEvidence(caseId) {
    fetch('/api/v1/thesis-evaluation/cases/' + caseId + '/aiss-analysis', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-CSRF-TOKEN': '{csrf_token}'},
        body: JSON.stringify({})
    }).then(r => r.json()).then(data => {
        if (data.ok) { location.reload(); }
        else { alert('Error: ' + (data.error || 'Unknown')); }
    });
}

function reviewSuggestion(caseId, snapshotId, suggestionKey) {
    var status = document.querySelector('[data-suggestion-status="' + suggestionKey + '"]').value;
    var criterion = document.querySelector('[data-suggestion-criterion="' + suggestionKey + '"]').value;
    var revision = document.querySelector('[data-suggestion-revision="' + suggestionKey + '"]').value;
    var reason = document.querySelector('[data-suggestion-reason="' + suggestionKey + '"]').value;
    var rationale = document.querySelector('[data-suggestion-rationale="' + suggestionKey + '"]').value;

    if (status !== 'pending' && !reason.trim()) {
        alert('Reviewer reason is required for this disposition.');
        return;
    }
    if (status === 'edited' && !rationale.trim()) {
        alert('Edited rationale is required when accepting with edits.');
        return;
    }
    if (status === 'converted_to_revision' && !revision) {
        alert('Select a revision request to convert this suggestion into.');
        return;
    }

    fetch('/api/v1/thesis-evaluation/cases/' + caseId + '/suggestions/review', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-CSRF-TOKEN': '{csrf_token}'},
        body: JSON.stringify({
            snapshot_id: snapshotId,
            suggestion_key: suggestionKey,
            reviewer_status: status,
            reviewer_reason: reason,
            reviewer_rationale: rationale,
            rubric_criterion_id: criterion ? parseInt(criterion, 10) : null,
            revision_request_id: revision ? parseInt(revision, 10) : null
        })
    }).then(r => r.json()).then(data => {
        if (data.ok) { location.reload(); }
        else { alert('Error: ' + (data.error || 'Unknown')); }
    }).catch(err => { alert('Network error: ' + err.message); });
}
</script>
{/block}
