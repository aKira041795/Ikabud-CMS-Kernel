{extends "modules/academic-thesis-evaluation/layouts/admin"}

{block content}
<div class="p-6">
    <div class="mb-6">
        <a href="/admin/thesis-evaluation/profiles" class="text-blue-600 hover:underline text-sm">&larr; Back to Profiles</a>
    </div>

    {if profile|default:null}
    <div class="bg-white rounded-lg shadow p-6 mb-6">
        <div class="flex justify-between items-start mb-4">
            <div>
                <h1 class="text-2xl font-bold">{profile.name}</h1>
                <p class="text-sm text-gray-500 mt-1">Code: {profile.code} &middot; v{profile.version} &middot; {profile.degree_level|capitalize}</p>
            </div>
            <span class="px-3 py-1 text-sm rounded-full {if profile.status == 'active'}bg-green-100 text-green-800{else}bg-gray-100 text-gray-600{/if}">
                {profile.status|capitalize}
            </span>
        </div>
        {if profile.description}
        <p class="text-gray-600 mb-4">{profile.description}</p>
        {/if}
        {if profile.policy_reference}
        <div class="bg-blue-50 rounded p-3 text-sm text-blue-800 mb-4">{profile.policy_reference}</div>
        {/if}
    </div>

    {if workflow.stages|default:[]|length > 0}
    <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold mb-4">Workflow Stages</h2>
        <div class="space-y-4">
            {for stage in workflow.stages}
            <div class="border rounded p-4 {if stage.terminal|default:false}border-red-200 bg-red-50{else}border-gray-200{/if}">
                <div class="flex justify-between items-start">
                    <div>
                        <h3 class="font-medium">{stage.label|default:stage.code}</h3>
                        <p class="text-xs text-gray-500 font-mono">{stage.code}</p>
                    </div>
                    <div class="flex gap-2">
                        <span class="px-2 py-0.5 text-xs rounded-full bg-blue-100 text-blue-800">{stage.role|default:'any'}</span>
                        {if stage.terminal|default:false}
                        <span class="px-2 py-0.5 text-xs rounded-full bg-red-100 text-red-800">Terminal</span>
                        {/if}
                    </div>
                </div>

                {if stage.requirements|default:[]|length > 0}
                <div class="mt-3">
                    <span class="text-xs font-medium text-gray-500">Requirements:</span>
                    <div class="flex flex-wrap gap-1 mt-1">
                        {for req in stage.requirements}
                        <span class="px-2 py-0.5 text-xs rounded bg-gray-100">{req}</span>
                        {/for}
                    </div>
                </div>
                {/if}

                {if stage.next|default:[]|length > 0}
                <div class="mt-2">
                    <span class="text-xs font-medium text-gray-500">Next: </span>
                    <span class="text-xs">{stage.next|join:', '}</span>
                </div>
                {/if}

                {if stage.outcomes|default:[]|length > 0}
                <div class="mt-2">
                    <span class="text-xs font-medium text-gray-500">Outcomes:</span>
                    <div class="mt-1 space-y-1">
                        {for outcome, target in stage.outcomes}
                        <div class="text-xs">
                            <span class="px-2 py-0.5 rounded bg-green-100 text-green-800 font-mono">{outcome}</span>
                            <span class="mx-1">&rarr;</span>
                            <span class="font-mono">{target}</span>
                        </div>
                        {/for}
                    </div>
                </div>
                {/if}
            </div>
            {/for}
        </div>
    </div>
    {/if}
    {else}
    <p class="text-gray-500">Profile not found.</p>
    {/if}
</div>
{/block}
