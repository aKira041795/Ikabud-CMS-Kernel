{extends "modules/academic-thesis-evaluation/layouts/student"}

{block content}
<div class="p-6">
    <h1 class="text-2xl font-bold mb-6">My Thesis</h1>

    {if cases|default:[]|length > 0}
    <div class="space-y-4">
        {for case in cases}
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex justify-between items-start">
                <div>
                    <h3 class="text-lg font-semibold">
                        <a href="/thesis/cases/{case.id}" class="text-blue-600 hover:underline">{case.title}</a>
                    </h3>
                    <p class="text-sm text-gray-500 mt-1">
                        {case.profile_code|default:'—'} &middot; Stage: {case.current_stage} &middot; Status: {case.status}
                    </p>
                </div>
                <span class="px-3 py-1 text-xs rounded-full bg-blue-100 text-blue-800">{case.status}</span>
            </div>
            <div class="mt-4">
                <a href="/thesis/cases/{case.id}" class="text-sm text-blue-600 hover:underline">View Details</a>
                {if case.status == 'revision'}
                <a href="/thesis/cases/{case.id}/revisions" class="text-sm text-orange-600 hover:underline ml-4">View Revisions</a>
                {/if}
            </div>
        </div>
        {/for}
    </div>
    {else}
    <div class="bg-white rounded-lg shadow p-8 text-center">
        <p class="text-gray-500 mb-4">You haven't submitted a thesis yet.</p>
        <a href="/thesis/submit" class="inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
            Submit Thesis
        </a>
    </div>
    {/if}
</div>
{/block}
