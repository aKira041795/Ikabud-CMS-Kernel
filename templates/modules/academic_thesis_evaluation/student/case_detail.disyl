{extends "modules/academic-thesis-evaluation/layouts/student"}

{block content}
<div class="p-6">
    <div class="mb-6">
        <a href="/thesis" class="text-blue-600 hover:underline text-sm">&larr; Back to My Thesis</a>
    </div>

    {if case|default:null}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {* Main *}
        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white rounded-lg shadow p-6">
                <h1 class="text-xl font-bold mb-4">{case.title}</h1>
                <dl class="grid grid-cols-2 gap-4 text-sm">
                    <div>
                        <dt class="text-gray-500">Profile</dt>
                        <dd>{case.profile_name|default:'—'}</dd>
                    </div>
                    <div>
                        <dt class="text-gray-500">Current Stage</dt>
                        <dd><span class="px-2 py-0.5 text-xs rounded-full bg-blue-100 text-blue-800">{case.current_stage}</span></dd>
                    </div>
                    <div>
                        <dt class="text-gray-500">Status</dt>
                        <dd>{case.status}</dd>
                    </div>
                    <div>
                        <dt class="text-gray-500">Submitted</dt>
                        <dd>{case.created_at|date:"M d, Y"}</dd>
                    </div>
                    <div>
                        <dt class="text-gray-500">Research Category</dt>
                        <dd>{case.research_category|default:'—'}</dd>
                    </div>
                </dl>
            </div>

            {* Stage timeline *}
            <div class="bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-semibold mb-4">Progress</h3>
                {if stages|default:[]|length > 0}
                <div class="space-y-3">
                    {for stage in stages}
                    <div class="flex items-center gap-3">
                        <div class="w-3 h-3 rounded-full {if stage.status == 'completed'}bg-green-500{else if stage.status == 'active'}bg-blue-500{else}bg-gray-300{/if}"></div>
                        <div class="flex-1">
                            <span class="font-medium text-sm">{stage.stage_code|replace:'_':' '|capitalize}</span>
                            <span class="text-xs text-gray-500 ml-2">({stage.status})</span>
                        </div>
                        {if stage.completed_at}
                        <span class="text-xs text-gray-400">{stage.completed_at|date:"M d"}</span>
                        {/if}
                    </div>
                    {/for}
                </div>
                {else}
                <p class="text-sm text-gray-500">No progress recorded.</p>
                {/if}
            </div>
        </div>

        {* Sidebar *}
        <div class="space-y-6">
            {if case.status == 'revision'}
            <div class="bg-orange-50 border border-orange-200 rounded-lg p-6">
                <h3 class="text-lg font-semibold text-orange-800 mb-2">Revisions Required</h3>
                <p class="text-sm text-orange-700 mb-4">Reviewers have requested changes to your thesis.</p>
                <a href="/thesis/cases/{case.id}/revisions" class="inline-flex items-center px-4 py-2 bg-orange-600 text-white rounded hover:bg-orange-700 text-sm">
                    View Revision Requests
                </a>
            </div>
            {/if}

            {if case.status == 'completed'}
            <div class="bg-green-50 border border-green-200 rounded-lg p-6">
                <h3 class="text-lg font-semibold text-green-800 mb-2">Evaluation Complete</h3>
                <p class="text-sm text-green-700">The evaluation process has been completed.</p>
            </div>
            {/if}
        </div>
    </div>
    {else}
    <p class="text-gray-500">Case not found.</p>
    {/if}
</div>
{/block}
