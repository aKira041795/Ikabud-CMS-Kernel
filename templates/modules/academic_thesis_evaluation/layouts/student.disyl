<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{block "title"}My Thesis{/block} — Academic Thesis Evaluation</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen">
    <nav class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex">
                    <div class="flex-shrink-0 flex items-center">
                        <a href="/thesis" class="text-xl font-bold text-gray-900">My Thesis</a>
                    </div>
                    <div class="ml-10 flex items-center space-x-4">
                        <a href="/thesis" class="px-3 py-2 rounded-md text-sm font-medium {if active_nav == 'dashboard'}bg-blue-50 text-blue-700{else}text-gray-500 hover:text-gray-700{/if}">Dashboard</a>
                        <a href="/thesis/submit" class="px-3 py-2 rounded-md text-sm font-medium {if active_nav == 'submit'}bg-blue-50 text-blue-700{else}text-gray-500 hover:text-gray-700{/if}">Submit</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <main>
        {block "content"}{/block}
    </main>
    {block "scripts"}{/block}
</body>
</html>
