{extends "modules/cms/layouts/admin.disyl"}

{block content}
<div class="space-y-6" data-tab-default="{active_tab}">
    <div class="rounded-2xl bg-slate-950 text-slate-50 px-6 py-6 shadow-xl shadow-slate-950/10">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-[0.24em] text-sky-200/80">Contact Form Studio</div>
                <h2 class="mt-2 text-3xl font-semibold">{if is_edit}{form.name}{else}Create a Saved Form{/if}</h2>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-300">Build richer form flows with advanced field types, drag-to-reorder editing, and direct submission management from the CMS.</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a href="{base_url}/cms/admin/contact-forms" class="inline-flex items-center rounded-xl border border-slate-700 bg-slate-900/60 px-4 py-2 text-sm font-medium text-slate-100 hover:bg-slate-800">Back to Forms</a>
                {if is_edit}
                <a href="{base_url}/cms/admin/contact-forms/submissions?form_id={form.id}" class="inline-flex items-center rounded-xl border border-slate-700 bg-slate-900/60 px-4 py-2 text-sm font-medium text-slate-100 hover:bg-slate-800">View Entries</a>
                {/if}
            </div>
        </div>

        <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
            <div class="rounded-xl border border-slate-800 bg-white/5 px-4 py-3">
                <div class="text-xs uppercase tracking-[0.22em] text-slate-400">Status</div>
                <div class="mt-2 text-lg font-semibold">{if form.status == 'active'}Active{else}Inactive{/if}</div>
            </div>
            <div class="rounded-xl border border-slate-800 bg-white/5 px-4 py-3">
                <div class="text-xs uppercase tracking-[0.22em] text-slate-400">Captcha</div>
                <div class="mt-2 text-lg font-semibold">{if form.captcha_enabled == 1}Enabled{else}Disabled{/if}</div>
            </div>
            <div class="rounded-xl border border-slate-800 bg-white/5 px-4 py-3">
                <div class="text-xs uppercase tracking-[0.22em] text-slate-400">Fields</div>
                <div class="mt-2 text-lg font-semibold">{if is_edit}{fields | count}{else}0{/if}</div>
            </div>
        </div>
    </div>

    {if message}
    <div class="px-4 py-3 rounded-lg border text-sm {if message.type == 'error'}bg-red-50 border-red-200 text-red-700{else}bg-emerald-50 border-emerald-200 text-emerald-700{/if}">{message.text}</div>
    {/if}

    {if error}
    <div class="px-4 py-3 rounded-lg border text-sm bg-red-50 border-red-200 text-red-700">{error}</div>
    {/if}

    <div class="flex border-b border-slate-200 bg-white rounded-2xl rounded-b-none shadow-sm -mb-6 overflow-hidden">
        <button type="button" data-tab-target="overview" class="cf-tab-trigger inline-flex items-center gap-2 px-6 py-3.5 text-sm font-medium text-slate-500 hover:text-slate-800 border-b-2 border-transparent -mb-px transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/></svg>
            Settings
        </button>
        <button type="button" data-tab-target="fields" class="cf-tab-trigger inline-flex items-center gap-2 px-6 py-3.5 text-sm font-medium text-slate-500 hover:text-slate-800 border-b-2 border-transparent -mb-px transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            Fields
        </button>
        <button type="button" data-tab-target="embed" class="cf-tab-trigger inline-flex items-center gap-2 px-6 py-3.5 text-sm font-medium text-slate-500 hover:text-slate-800 border-b-2 border-transparent -mb-px transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
            Embed
        </button>
        {if is_edit}
        <button type="button" data-tab-target="preview" class="cf-tab-trigger inline-flex items-center gap-2 px-6 py-3.5 text-sm font-medium text-slate-500 hover:text-slate-800 border-b-2 border-transparent -mb-px transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            Preview
        </button>
        {/if}
    </div>

    <div id="tab-panel-overview" data-tab-panel="overview" class="space-y-6 pt-6">
        <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,2fr),minmax(280px,1fr)] gap-6">
            <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <h3 class="text-lg font-semibold text-slate-900">Form Settings</h3>
                        <p class="mt-1 text-sm text-slate-500">Configure identity, delivery messaging, and publication settings.</p>
                    </div>
                    <div class="rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-sky-700">Setup</div>
                </div>

                <form method="post" action="" class="mt-6 space-y-5" id="cf-form-editor">
                    <input type="hidden" name="_token" value="{csrf_token}">

                    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
                        <div class="lg:col-span-2">
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Form Name</label>
                            <input type="text" name="name" id="cf-form-name" value="{form.name}" required class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm focus:border-sky-500 outline-none">
                        </div>
                        <div class="lg:col-span-2">
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Slug</label>
                            <input type="text" name="slug" id="cf-form-slug" value="{form.slug}" required class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm font-mono text-slate-600 focus:border-sky-500 outline-none">
                            <p class="mt-2 text-xs text-slate-400">Generated from the form name until you edit it manually. Used by the shortcode and builder lookup.</p>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Captcha</label>
                            <select name="captcha_enabled" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm bg-white focus:border-sky-500 outline-none">
                                <option value="1" {if form.captcha_enabled == 1}selected{/if}>Enabled</option>
                                <option value="0" {if form.captcha_enabled == 0}selected{/if}>Disabled</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Status</label>
                            <select name="status" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm bg-white focus:border-sky-500 outline-none">
                                <option value="active" {if form.status == 'active'}selected{/if}>Active</option>
                                <option value="inactive" {if form.status == 'inactive'}selected{/if}>Inactive</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Submit Button Label</label>
                        <input type="text" name="submit_label" value="{form.submit_label}" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm focus:border-sky-500 outline-none" placeholder="Send Message">
                        <p class="mt-2 text-xs text-slate-400">Text shown on the submit button. Defaults to "Send Message" when left blank.</p>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Success Message</label>
                        <textarea name="success_message" rows="4" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm focus:border-sky-500 outline-none resize-y">{form.success_message}</textarea>
                        <p class="mt-2 text-xs text-slate-400">Shown after a successful submission. Leave blank to fall back to the module-level default message.</p>
                    </div>

                    <div class="flex justify-end">
                        <button type="submit" class="inline-flex items-center rounded-xl bg-sky-600 px-5 py-3 text-sm font-medium text-white hover:bg-sky-700">{if is_edit}Save Form Settings{else}Create Form{/if}</button>
                    </div>
                </form>
            </div>

            <div class="space-y-6">
                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                    <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Publishing Checklist</h3>
                    <div class="mt-4 space-y-3 text-sm text-slate-600">
                        <div class="flex items-start gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full {if form.name}bg-emerald-500{else}bg-slate-300{/if}"></span><span>Name and slug are configured.</span></div>
                        <div class="flex items-start gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full {if is_edit && (fields | count) > 0}bg-emerald-500{else}bg-slate-300{/if}"></span><span>Add multiple field types and drag them into a sensible order.</span></div>
                        <div class="flex items-start gap-3"><span class="mt-1 h-2.5 w-2.5 rounded-full {if form.status == 'active'}bg-emerald-500{else}bg-amber-400{/if}"></span><span>Activate the form when it is ready to appear in the builder.</span></div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
                    <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Form Snapshot</h3>
                    <dl class="mt-4 space-y-3 text-sm text-slate-600">
                        <div class="flex justify-between gap-4"><dt>Status</dt><dd class="font-medium text-slate-900">{form.status}</dd></div>
                        <div class="flex justify-between gap-4"><dt>Captcha</dt><dd class="font-medium text-slate-900">{if form.captcha_enabled == 1}Enabled{else}Disabled{/if}</dd></div>
                        <div class="flex justify-between gap-4"><dt>Fields</dt><dd class="font-medium text-slate-900">{if is_edit}{fields | count}{else}0{/if}</dd></div>
                        <div class="flex justify-between gap-4"><dt>Slug</dt><dd class="font-medium font-mono text-slate-900">{if form.slug}{form.slug}{else}pending{/if}</dd></div>
                        <div class="flex justify-between gap-4"><dt>Button</dt><dd class="font-medium text-slate-900">{if form.submit_label}{form.submit_label}{else}Send Message{/if}</dd></div>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div id="tab-panel-fields" data-tab-panel="fields" class="hidden">
        {if is_edit}
        <div class="cf-builder flex flex-col lg:flex-row rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden" style="min-height:580px">

            <!-- LEFT: Field Palette -->
            <div class="cf-palette lg:w-[320px] flex-shrink-0 border-b lg:border-b-0 lg:border-r border-slate-200 bg-slate-50 flex flex-col">
                <div class="px-4 pt-4 pb-2 border-b border-slate-200 bg-slate-100/60">
                    <h3 class="text-xs font-bold uppercase tracking-[0.22em] text-slate-500">Add Fields</h3>
                    <p class="text-[11px] text-slate-400 mt-1">Click a type to configure and add it below</p>
                </div>

                <div class="px-3 pt-4 pb-3 flex-1 overflow-y-auto">
                    <div class="text-[10px] font-bold uppercase tracking-[0.22em] text-slate-400 px-1 mb-2">Basic</div>
                    <div class="grid grid-cols-3 gap-1.5 mb-5">
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="text" data-default-label="Text Field">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h10M4 18h12"/></svg>
                            <span>Text</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="email" data-default-label="Email Address">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            <span>Email</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="tel" data-default-label="Phone Number">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                            <span>Phone</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="number" data-default-label="Number">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/></svg>
                            <span>Number</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="textarea" data-default-label="Message">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 10h16M4 14h10M4 18h7"/></svg>
                            <span>Textarea</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="select" data-default-label="Select Field">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 9l-7 7-7-7"/></svg>
                            <span>Select</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="radio" data-default-label="Choose One">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="currentColor"/></svg>
                            <span>Radio</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="checkbox" data-default-label="I agree to the terms">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3" stroke-width="1.8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12l3 3 5-5"/></svg>
                            <span>Checkbox</span>
                        </button>
                    </div>

                    <div class="text-[10px] font-bold uppercase tracking-[0.22em] text-slate-400 px-1 mb-2">Advanced</div>
                    <div class="grid grid-cols-3 gap-1.5">
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="url" data-default-label="Website URL">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                            <span>URL</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="date" data-default-label="Date">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke-width="1.8"/><line x1="16" y1="2" x2="16" y2="6" stroke-width="1.8" stroke-linecap="round"/><line x1="8" y1="2" x2="8" y2="6" stroke-width="1.8" stroke-linecap="round"/><line x1="3" y1="10" x2="21" y2="10" stroke-width="1.8"/></svg>
                            <span>Date</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="time" data-default-label="Time">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="1.8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 7v5l3 3"/></svg>
                            <span>Time</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="datetime" data-default-label="Date & Time">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke-width="1.8"/><line x1="16" y1="2" x2="16" y2="6" stroke-width="1.8" stroke-linecap="round"/><line x1="3" y1="10" x2="21" y2="10" stroke-width="1.8"/><circle cx="16" cy="16" r="3" stroke-width="1.8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 14.5v1.5l1 1"/></svg>
                            <span>DateTime</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="month" data-default-label="Month">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke-width="1.8"/><line x1="16" y1="2" x2="16" y2="6" stroke-width="1.8" stroke-linecap="round"/><line x1="8" y1="2" x2="8" y2="6" stroke-width="1.8" stroke-linecap="round"/><line x1="3" y1="10" x2="21" y2="10" stroke-width="1.8"/><line x1="8" y1="15" x2="16" y2="15" stroke-width="1.8" stroke-linecap="round"/></svg>
                            <span>Month</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="week" data-default-label="Week">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke-width="1.8"/><line x1="16" y1="2" x2="16" y2="6" stroke-width="1.8" stroke-linecap="round"/><line x1="8" y1="2" x2="8" y2="6" stroke-width="1.8" stroke-linecap="round"/><line x1="3" y1="10" x2="21" y2="10" stroke-width="1.8"/><line x1="7" y1="15" x2="7" y2="19" stroke-width="1.8" stroke-linecap="round"/><line x1="12" y1="13" x2="12" y2="19" stroke-width="1.8" stroke-linecap="round"/><line x1="17" y1="15" x2="17" y2="19" stroke-width="1.8" stroke-linecap="round"/></svg>
                            <span>Week</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="password" data-default-label="Password">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                            <span>Password</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="rating" data-default-label="Rate your experience">
                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                            <span>Rating</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="range" data-default-label="Satisfaction Score">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 12h16M8 8l-4 4 4 4M16 8l4 4-4 4"/></svg>
                            <span>Slider</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="color" data-default-label="Favourite Color">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10c.557 0 1 .452 1 1a2 2 0 004 0c0-1.06-.422-2.016-1.102-2.727A9.957 9.957 0 0022 12c0-5.523-4.477-10-10-10z"/></svg>
                            <span>Color</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="section" data-default-label="Section Heading">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 10h7"/></svg>
                            <span>Section</span>
                        </button>
                        <button type="button" class="cf-palette-tile flex flex-col items-center justify-center gap-1 rounded-xl border border-slate-200 bg-white p-2.5 text-xs font-medium text-slate-600 hover:border-sky-400 hover:bg-sky-50 hover:text-sky-700 transition-colors" data-type="hidden" data-default-label="Hidden Field">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 4.411m0 0L21 21"/></svg>
                            <span>Hidden</span>
                        </button>
                    </div>
                </div>

                <!-- Quick Add Form (appears in palette bottom when a tile is chosen) -->
                <div class="border-t border-slate-200 bg-white px-4 pt-4 pb-4" id="cf-quick-add-section">
                    <div class="flex items-center gap-2 mb-3">
                        <span class="text-xs font-bold uppercase tracking-[0.2em] text-slate-500">Add</span>
                        <span id="cf-quick-type-badge" class="hidden rounded-full bg-sky-100 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-sky-700"></span>
                    </div>
                    <form method="post" action="{base_url}/cms/admin/contact-forms/{form.id}/fields/create" id="cf-quick-add-form">
                        <input type="hidden" name="_token" value="{csrf_token}">
                        <input type="hidden" name="field_type" id="cf-quick-type" value="text">
                        <input type="hidden" name="sort_order" value="9999">
                        <div class="mb-2.5">
                            <label for="cf-quick-label" class="block text-xs font-semibold text-slate-600 mb-1">Label</label>
                            <input type="text" name="label" id="cf-quick-label" required
                                class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-sky-500 outline-none"
                                placeholder="Choose a field type above">
                        </div>
                        <div id="cf-quick-options-section" class="mb-2.5 hidden">
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Options</label>
                            <textarea name="options_text" rows="3"
                                class="w-full rounded-lg border border-slate-300 px-3 py-2 text-xs font-mono focus:border-sky-500 outline-none resize-none"
                                placeholder="value|Label&#10;one_more|Another option"></textarea>
                            <button type="button" class="cf-add-option-btn mt-1.5 inline-flex items-center gap-1 rounded-lg border border-dashed border-slate-300 px-2.5 py-1 text-[11px] font-medium text-slate-500 hover:border-sky-400 hover:text-sky-600 transition-colors">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
                                Add option
                            </button>
                            <p class="mt-1 text-[11px] text-slate-400">One per line &middot; Format: <span class="font-mono">value|Label</span> &middot; Used by Select, Radio &amp; Checkbox</p>
                        </div>
                        <div id="cf-hidden-value-section" class="mb-2.5 hidden">
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Hidden Value <span class="font-normal text-slate-400">(optional)</span></label>
                            <input type="text" id="cf-quick-hidden-value" name="_hidden_value_placeholder" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-sky-500 outline-none" placeholder="e.g. referral_form">
                            <p class="mt-1 text-[11px] text-slate-400">Stored in the Placeholder column as the field's value.</p>
                        </div>
                        <label class="inline-flex items-center gap-2 text-xs text-slate-600 cursor-pointer mb-3">
                            <input type="checkbox" name="required" value="1" checked class="rounded border-slate-300 text-sky-600">
                            <span>Required field</span>
                        </label>
                        <button type="submit" id="cf-quick-add-btn"
                            class="w-full inline-flex items-center justify-center gap-1.5 rounded-xl bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-sky-700 disabled:opacity-40 disabled:cursor-not-allowed"
                            disabled>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
                            Add Field
                        </button>
                    </form>
                </div>
            </div>

            <!-- RIGHT: Form Canvas -->
            <div class="cf-canvas flex-1 flex flex-col min-w-0">
                <div class="px-5 py-3.5 border-b border-slate-200 flex items-center justify-between bg-white">
                    <div>
                        <h3 class="text-sm font-semibold text-slate-900">Form Canvas</h3>
                        <p class="text-xs text-slate-400 mt-0.5">Drag cards to reorder &middot; Click to expand and edit</p>
                    </div>
                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600">{fields | count} fields</span>
                </div>

                <div class="flex-1 overflow-y-auto p-4" data-field-sortable>
                    {if fields | count > 0}
                    {foreach fields as field}
                    <div class="cf-field-card mb-2 rounded-xl border border-slate-200 bg-white" draggable="true" data-field-id="{field.id}">

                        <!-- Card header (always visible) -->
                        <div class="cf-card-header flex items-center gap-3 px-4 py-3 cursor-pointer select-none hover:bg-slate-50/80 rounded-xl transition-colors" data-expand-toggle>
                            <div class="text-slate-300 cursor-grab flex-shrink-0" title="Drag to reorder">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 8h16M4 16h16"/></svg>
                            </div>
                            <div class="flex-1 min-w-0 flex items-center gap-2.5">
                                <div class="flex-1 min-w-0">
                                    <div class="text-sm font-semibold text-slate-900 truncate">{field.label}</div>
                                    <div class="text-[11px] font-mono text-slate-400 truncate">{field.name}</div>
                                </div>
                                <span class="flex-shrink-0 rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-500">{field.field_type}</span>
                                {if field.required == 1}
                                <span class="flex-shrink-0 hidden sm:inline-flex rounded-full bg-sky-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-sky-600">req.</span>
                                {/if}
                            </div>
                            <svg class="cf-expand-icon w-4 h-4 text-slate-400 flex-shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                        </div>

                        <!-- Expanded edit body -->
                        <div class="cf-card-body hidden border-t border-slate-100">
                            <form method="post" action="{base_url}/cms/admin/contact-forms/{form.id}/fields/{field.id}/save" class="px-4 py-4 space-y-3">
                                <input type="hidden" name="_token" value="{csrf_token}">

                                <!-- Quick save/delete bar always visible at top of expanded card -->
                                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                                    <button type="submit" formaction="{base_url}/cms/admin/contact-forms/{form.id}/fields/{field.id}/delete" formnovalidate onclick="return confirm('Delete this field and all its saved data?');" class="inline-flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium text-red-500 hover:bg-red-50 transition-colors">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        Delete
                                    </button>
                                    <button type="submit" class="inline-flex items-center gap-1.5 rounded-xl bg-sky-600 px-4 py-1.5 text-xs font-semibold text-white hover:bg-sky-700">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                        Save Field
                                    </button>
                                </div>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-500 mb-1.5">Label</label>
                                        <input type="text" name="label" value="{field.label}" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-sky-500 outline-none">
                                    </div>
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-500 mb-1.5">Field Name <span class="font-normal text-slate-400 normal-case">(internal)</span></label>
                                        <input type="text" name="name" value="{field.name}" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono focus:border-sky-500 outline-none">
                                    </div>
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-500 mb-1.5">Field Type</label>
                                        <select name="field_type" data-field-type-select class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:border-sky-500 outline-none">
                                            {foreach field_type_options as typeOption}
                                            <option value="{typeOption.value}" {if field.field_type == typeOption.value}selected{/if}>{typeOption.label}</option>
                                            {/foreach}
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-500 mb-1.5">Placeholder</label>
                                        <input type="text" name="placeholder" value="{field.placeholder}" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-sky-500 outline-none">
                                    </div>
                                    <div class="sm:col-span-2">
                                        <label class="block text-xs font-semibold text-slate-500 mb-1.5">Help Text</label>
                                        <input type="text" name="help_text" value="{field.help_text}" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-sky-500 outline-none" placeholder="Optional note shown below the field">
                                    </div>
                                    <div class="sm:col-span-2 cf-field-options-panel {if field.field_type != 'select' && field.field_type != 'radio' && field.field_type != 'checkbox'}hidden{/if}" data-options-for="select,radio,checkbox">
                                        <label class="block text-xs font-semibold text-slate-500 mb-1.5">Options</label>
                                        <textarea name="options_text" rows="4" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono focus:border-sky-500 outline-none resize-y">{field.options_text}</textarea>
                                        <button type="button" class="cf-add-option-btn mt-1.5 inline-flex items-center gap-1 rounded-lg border border-dashed border-slate-300 px-2.5 py-1 text-[11px] font-medium text-slate-500 hover:border-sky-400 hover:text-sky-600 transition-colors">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
                                            Add option
                                        </button>
                                        <p class="mt-1 text-[11px] text-slate-400">One per line &middot; Format: <span class="font-mono">value|Label</span> &middot; Used by Select, Radio &amp; Checkbox. Checkbox with no options becomes a single agree/disagree toggle.</p>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-semibold text-slate-500 mb-1.5">Sort Order</label>
                                        <input type="number" name="sort_order" value="{field.sort_order}" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-sky-500 outline-none">
                                    </div>
                                    <div class="flex items-end pb-1">
                                        <label class="inline-flex items-center gap-2 text-sm text-slate-700 cursor-pointer">
                                            <input type="checkbox" name="required" value="1" {if field.required == 1}checked{/if} class="rounded border-slate-300 text-sky-600 focus:ring-sky-500/20">
                                            <span>Required field</span>
                                        </label>
                                    </div>
                                    <div class="sm:col-span-2 rounded-xl border border-slate-200 bg-slate-50/80 p-4" data-conditional-logic-root>
                                        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                                            <div>
                                                <label class="block text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Conditional Logic</label>
                                                <p class="mt-1 text-xs text-slate-500">Show or hide this field when responses in other fields match your rules.</p>
                                            </div>
                                            <label class="inline-flex items-center gap-2 text-sm text-slate-700 cursor-pointer">
                                                <input type="checkbox" name="conditional_logic_enabled" value="1" {if field.conditional_logic.enabled}checked{/if} data-conditional-logic-toggle class="rounded border-slate-300 text-sky-600 focus:ring-sky-500/20">
                                                <span>Enable logic</span>
                                            </label>
                                        </div>

                                        <div class="mt-4 space-y-4 {if !field.conditional_logic.enabled}hidden{/if}" data-conditional-logic-panel>
                                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                                <div>
                                                    <label class="block text-xs font-semibold text-slate-500 mb-1.5">Action</label>
                                                    <select name="conditional_logic_action" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:border-sky-500 outline-none">
                                                        <option value="show" {if field.conditional_logic.action != 'hide'}selected{/if}>Show this field when rules match</option>
                                                        <option value="hide" {if field.conditional_logic.action == 'hide'}selected{/if}>Hide this field when rules match</option>
                                                    </select>
                                                </div>
                                                <div>
                                                    <label class="block text-xs font-semibold text-slate-500 mb-1.5">Rule Match</label>
                                                    <select name="conditional_logic_match" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:border-sky-500 outline-none">
                                                        <option value="all" {if field.conditional_logic.match != 'any'}selected{/if}>All rules must match</option>
                                                        <option value="any" {if field.conditional_logic.match == 'any'}selected{/if}>Any rule may match</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="space-y-3" data-logic-rules-body>
                                                {if field.conditional_logic.rules | count > 0}
                                                {foreach field.conditional_logic.rules as logicRule}
                                                <div class="cf-logic-row grid grid-cols-1 lg:grid-cols-[minmax(0,1fr),180px,minmax(0,1fr),auto] gap-3 items-end">
                                                    <div>
                                                        <label class="block text-xs font-semibold text-slate-500 mb-1.5">Source Field</label>
                                                        <select name="conditional_logic_field_id[]" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:border-sky-500 outline-none">
                                                            <option value="">Select a field…</option>
                                                            {foreach fields as logicField}
                                                            {if logicField.id != field.id && logicField.field_type != 'section'}
                                                            <option value="{logicField.id}" {if logicField.id == logicRule.field_id}selected{/if}>{logicField.label}</option>
                                                            {/if}
                                                            {/foreach}
                                                        </select>
                                                    </div>
                                                    <div>
                                                        <label class="block text-xs font-semibold text-slate-500 mb-1.5">Operator</label>
                                                        <select name="conditional_logic_operator[]" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:border-sky-500 outline-none">
                                                            <option value="equals" {if logicRule.operator == 'equals'}selected{/if}>Equals</option>
                                                            <option value="not_equals" {if logicRule.operator == 'not_equals'}selected{/if}>Not Equal</option>
                                                            <option value="contains" {if logicRule.operator == 'contains'}selected{/if}>Contains</option>
                                                            <option value="greater_than" {if logicRule.operator == 'greater_than'}selected{/if}>Greater Than</option>
                                                            <option value="less_than" {if logicRule.operator == 'less_than'}selected{/if}>Less Than</option>
                                                            <option value="empty" {if logicRule.operator == 'empty'}selected{/if}>Is Empty</option>
                                                            <option value="not_empty" {if logicRule.operator == 'not_empty'}selected{/if}>Is Not Empty</option>
                                                        </select>
                                                    </div>
                                                    <div>
                                                        <label class="block text-xs font-semibold text-slate-500 mb-1.5">Comparison Value</label>
                                                        <input type="text" name="conditional_logic_value[]" value="{logicRule.value}" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-sky-500 outline-none" placeholder="Comparison value">
                                                    </div>
                                                    <button type="button" class="cf-remove-logic-rule-btn inline-flex items-center justify-center rounded-lg border border-slate-200 px-3 py-2 text-xs font-medium text-slate-500 hover:border-red-200 hover:bg-red-50 hover:text-red-600 transition-colors">Remove</button>
                                                </div>
                                                {/endforeach}
                                                {else}
                                                <div class="cf-logic-row grid grid-cols-1 lg:grid-cols-[minmax(0,1fr),180px,minmax(0,1fr),auto] gap-3 items-end">
                                                    <div>
                                                        <label class="block text-xs font-semibold text-slate-500 mb-1.5">Source Field</label>
                                                        <select name="conditional_logic_field_id[]" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:border-sky-500 outline-none">
                                                            <option value="">Select a field…</option>
                                                            {foreach fields as logicField}
                                                            {if logicField.id != field.id && logicField.field_type != 'section'}
                                                            <option value="{logicField.id}">{logicField.label}</option>
                                                            {/if}
                                                            {/foreach}
                                                        </select>
                                                    </div>
                                                    <div>
                                                        <label class="block text-xs font-semibold text-slate-500 mb-1.5">Operator</label>
                                                        <select name="conditional_logic_operator[]" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white focus:border-sky-500 outline-none">
                                                            <option value="equals" selected>Equals</option>
                                                            <option value="not_equals">Not Equal</option>
                                                            <option value="contains">Contains</option>
                                                            <option value="greater_than">Greater Than</option>
                                                            <option value="less_than">Less Than</option>
                                                            <option value="empty">Is Empty</option>
                                                            <option value="not_empty">Is Not Empty</option>
                                                        </select>
                                                    </div>
                                                    <div>
                                                        <label class="block text-xs font-semibold text-slate-500 mb-1.5">Comparison Value</label>
                                                        <input type="text" name="conditional_logic_value[]" value="" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-sky-500 outline-none" placeholder="Comparison value">
                                                    </div>
                                                    <button type="button" class="cf-remove-logic-rule-btn inline-flex items-center justify-center rounded-lg border border-slate-200 px-3 py-2 text-xs font-medium text-slate-500 hover:border-red-200 hover:bg-red-50 hover:text-red-600 transition-colors">Remove</button>
                                                </div>
                                                {/if}
                                            </div>

                                            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between pt-1">
                                                <p class="text-[11px] text-slate-400">Use field ids internally so renaming labels or field names does not break the rule.</p>
                                                <button type="button" class="cf-add-logic-rule-btn inline-flex items-center gap-1 rounded-lg border border-dashed border-slate-300 px-2.5 py-1.5 text-[11px] font-medium text-slate-500 hover:border-sky-400 hover:text-sky-600 transition-colors">
                                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
                                                    Add condition
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="flex items-center justify-between pt-2 border-t border-slate-100">
                                    <button type="submit" formaction="{base_url}/cms/admin/contact-forms/{form.id}/fields/{field.id}/delete" formnovalidate onclick="return confirm('Delete this field and all its saved data?');" class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-xs font-medium text-red-600 hover:bg-red-50 transition-colors">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        Delete Field
                                    </button>
                                    <button type="submit" class="inline-flex items-center gap-1.5 rounded-xl bg-sky-600 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-700">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                        Save Field
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                    {/foreach}
                    {else}
                    <div class="flex flex-col items-center justify-center h-full min-h-[300px] text-center px-6 py-12">
                        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-100">
                            <svg class="h-8 w-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                        </div>
                        <p class="text-sm font-semibold text-slate-500">No fields yet</p>
                        <p class="mt-1 text-xs text-slate-400 max-w-xs">Click a field type in the left panel, fill in the label, and press Add Field</p>
                    </div>
                    {/if}
                </div>
            </div>
        </div>

        <form id="cf-reorder-form" method="post" action="{base_url}/cms/admin/contact-forms/{form.id}/fields/reorder" class="hidden">
            <input type="hidden" name="_token" value="{csrf_token}">
            <input type="hidden" name="field_order" id="cf-field-order-input" value="">
        </form>
        {else}
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center text-sm text-slate-500">Create the form first, then use this tab to add field types and drag them into order.</div>
        {/if}
    </div>

    <div id="tab-panel-embed" data-tab-panel="embed" class="hidden space-y-6">
        <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1.5fr),minmax(280px,1fr)] gap-6">
            <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-5">
                <div>
                    <h3 class="text-lg font-semibold text-slate-900">Embed Options</h3>
                    <p class="mt-1 text-sm text-slate-500">Drop the form into the builder or paste a shortcode into CMS content.</p>
                </div>

                {if is_edit}
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-[0.16em] text-slate-500 mb-2">Shortcode</label>
                    <input type="text" readonly value="{shortcode}" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-3 text-sm font-mono text-slate-700">
                </div>

                <div class="rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 text-sm text-slate-600">
                    Use the <span class="font-semibold text-slate-900">Contact Form</span> builder block and choose this saved form from the select list. Builder overrides can still change the title, button label, and success message.
                </div>
                {else}
                <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-5 py-8 text-center text-sm text-slate-500">Create the form first to unlock shortcode and builder embedding.</div>
                {/if}
            </div>

            <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
                <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Feature Summary</h3>
                <div class="space-y-3 text-sm text-slate-600">
                    <div class="rounded-xl border border-slate-200 px-4 py-3">
                        <div class="font-semibold text-slate-900">Richer field palette</div>
                        <div class="mt-1">Text, email, telephone, number, textarea, and select field types are supported.</div>
                    </div>
                    <div class="rounded-xl border border-slate-200 px-4 py-3">
                        <div class="font-semibold text-slate-900">Submission workflow</div>
                        <div class="mt-1">Review, archive, and classify form entries without leaving the CMS.</div>
                    </div>
                    <div class="rounded-xl border border-slate-200 px-4 py-3">
                        <div class="font-semibold text-slate-900">Operational export</div>
                        <div class="mt-1">Export filtered submissions to CSV for external reporting or follow-up.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    {if is_edit}
    <div id="tab-panel-preview" data-tab-panel="preview" class="hidden">
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="flex items-center justify-between gap-4 px-5 py-3 border-b border-slate-100 bg-slate-50">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    <span class="text-sm font-medium text-slate-600">Live Preview</span>
                    <span class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-amber-700">Read only</span>
                </div>
                <button type="button" id="cf-preview-refresh"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-50 transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    Refresh
                </button>
            </div>
            <iframe id="cf-preview-frame"
                src=""
                data-preview-url="{base_url}/cms/admin/contact-forms/{form.id}/preview"
                style="width:100%;height:600px;border:none;display:block;"
                title="Form Preview">
            </iframe>
        </div>
    </div>
    {/if}
{/block}

{block scripts}
<script>
(function () {
    // ── Elements ──────────────────────────────────────────────────────────────
    var formNameInput  = document.getElementById('cf-form-name');
    var formSlugInput  = document.getElementById('cf-form-slug');
    var tabButtons     = Array.prototype.slice.call(document.querySelectorAll('[data-tab-target]'));
    var tabPanels      = Array.prototype.slice.call(document.querySelectorAll('[data-tab-panel]'));
    var reorderForm    = document.getElementById('cf-reorder-form');
    var reorderInput   = document.getElementById('cf-field-order-input');
    var sortableContainer = document.querySelector('[data-field-sortable]');
    var draggingId     = null;

    // Palette / quick-add elements
    var paletteTiles          = Array.prototype.slice.call(document.querySelectorAll('.cf-palette-tile'));
    var quickTypeInput        = document.getElementById('cf-quick-type');
    var quickLabelInput       = document.getElementById('cf-quick-label');
    var quickTypeBadge        = document.getElementById('cf-quick-type-badge');
    var quickAddBtn           = document.getElementById('cf-quick-add-btn');
    var quickOptionsSection   = document.getElementById('cf-quick-options-section');
    var quickHiddenSection    = document.getElementById('cf-hidden-value-section');
    var quickHiddenValueInput = document.getElementById('cf-quick-hidden-value');

    var paletteDefaultLabels = {
        'text':     'Text Field',
        'email':    'Email Address',
        'tel':      'Phone Number',
        'number':   'Number',
        'url':      'Website URL',
        'date':     'Date',
        'time':     'Time',
        'textarea': 'Message',
        'select':   'Select Field',
        'radio':    'Choose One',
        'checkbox': 'I agree to the terms',
        'password': 'Password',
        'rating':   'Rate your experience',
        'range':    'Satisfaction Score',
        'color':    'Favourite Color',
        'hidden':   'Hidden Field',
        'section':  'Section Heading',
        'datetime': 'Date & Time',
        'month':    'Month',
        'week':     'Week'
    };

    // ── Helpers ───────────────────────────────────────────────────────────────
    function slugify(value) {
        return String(value || '').toLowerCase().trim()
            .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')
            .replace(/-{2,}/g, '-').slice(0, 100);
    }

    // ── Tab bar ───────────────────────────────────────────────────────────────
    function activateTab(tabName, updateHash) {
        if (!tabName) return;

        tabButtons.forEach(function (btn) {
            var active = btn.getAttribute('data-tab-target') === tabName;
            btn.classList.toggle('border-sky-600', active);
            btn.classList.toggle('text-sky-700',   active);
            btn.classList.toggle('font-semibold',  active);
            btn.classList.toggle('border-transparent', !active);
            btn.classList.toggle('text-slate-500', !active);
        });

        tabPanels.forEach(function (panel) {
            panel.classList.toggle('hidden', panel.getAttribute('data-tab-panel') !== tabName);
        });

        if (updateHash) {
            if (window.history && window.history.replaceState) {
                window.history.replaceState(null, '', '#' + tabName);
            } else {
                window.location.hash = tabName;
            }
        }
    }

    tabButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
            activateTab(btn.getAttribute('data-tab-target'), true);
        });
    });

    // ── Palette tiles ─────────────────────────────────────────────────────────
    function activatePaletteTile(type) {
        paletteTiles.forEach(function (tile) {
            var active = tile.getAttribute('data-type') === type;
            tile.classList.toggle('border-sky-500', active);
            tile.classList.toggle('bg-sky-50',      active);
            tile.classList.toggle('text-sky-700',   active);
            tile.classList.toggle('border-slate-200', !active);
            tile.classList.toggle('bg-white',       !active);
            tile.classList.toggle('text-slate-600', !active);
        });
        if (quickTypeInput) quickTypeInput.value = type;
        if (quickTypeBadge) {
            quickTypeBadge.textContent = type;
            quickTypeBadge.classList.remove('hidden');
        }
        if (quickLabelInput) {
            quickLabelInput.value = paletteDefaultLabels[type] || (type.charAt(0).toUpperCase() + type.slice(1)) + ' Field';
            quickLabelInput.select();
            quickLabelInput.focus();
        }
        // Options panel: visible for select, radio, and checkbox
        if (quickOptionsSection) {
            quickOptionsSection.classList.toggle('hidden', type !== 'select' && type !== 'radio' && type !== 'checkbox');
        }
        // Hidden-value panel: visible only for hidden type
        if (quickHiddenSection) {
            quickHiddenSection.classList.toggle('hidden', type !== 'hidden');
            if (quickHiddenValueInput) {
                quickHiddenValueInput.name = type === 'hidden' ? 'placeholder' : '_hidden_value_placeholder';
            }
        }
        // Required checkbox: hide for section and hidden (they can't be required)
        var quickRequiredLabel = document.querySelector('#cf-quick-add-form label:has([name="required"])');
        if (quickRequiredLabel) {
            quickRequiredLabel.style.display = (type === 'section' || type === 'hidden') ? 'none' : '';
        }
        if (quickAddBtn) quickAddBtn.disabled = false;
    }

    paletteTiles.forEach(function (tile) {
        tile.addEventListener('click', function () {
            activatePaletteTile(tile.getAttribute('data-type') || 'text');
        });
    });

    // ── Field card expand/collapse ────────────────────────────────────────────
    document.addEventListener('click', function (event) {
        var toggle = event.target.closest('[data-expand-toggle]');
        if (!toggle) return;
        var card = toggle.closest('.cf-field-card');
        if (!card) return;
        var body = card.querySelector('.cf-card-body');
        var icon = card.querySelector('.cf-expand-icon');
        if (!body) return;
        var isOpen = !body.classList.contains('hidden');

        // Collapse all other cards first
        document.querySelectorAll('.cf-field-card .cf-card-body').forEach(function (b) { b.classList.add('hidden'); });
        document.querySelectorAll('.cf-field-card .cf-expand-icon').forEach(function (i) { i.style.transform = ''; });
        document.querySelectorAll('.cf-field-card .cf-card-header').forEach(function (h) { h.classList.remove('bg-slate-50', 'rounded-b-none'); });

        if (!isOpen) {
            body.classList.remove('hidden');
            if (icon) icon.style.transform = 'rotate(180deg)';
            toggle.classList.add('bg-slate-50', 'rounded-b-none');
        }
    });

    // ── Field-type select: show/hide options panel ────────────────────────────
    function syncFieldOptionPanels(scope) {
        var root = scope || document;
        Array.prototype.slice.call(root.querySelectorAll('[data-field-type-select]')).forEach(function (select) {
            var form = select.closest('form');
            if (!form) return;
            Array.prototype.slice.call(form.querySelectorAll('.cf-field-options-panel')).forEach(function (panel) {
                var forTypes = (panel.getAttribute('data-options-for') || '').split(',');
            panel.classList.toggle('hidden', forTypes.indexOf(select.value) === -1);
            });
        });
    }

    document.addEventListener('change', function (event) {
        if (event.target && event.target.matches('[data-field-type-select]')) {
            syncFieldOptionPanels(event.target.closest('form'));
        }
    });

    syncFieldOptionPanels(document);

    function syncConditionalLogicPanels(scope) {
        var root = scope || document;
        var logicRoots = (root.matches && root.matches('[data-conditional-logic-root]')) ? [root] : [];
        logicRoots = logicRoots.concat(Array.prototype.slice.call(root.querySelectorAll('[data-conditional-logic-root]')));
        logicRoots.forEach(function (logicRoot) {
            var toggle = logicRoot.querySelector('[data-conditional-logic-toggle]');
            var panel = logicRoot.querySelector('[data-conditional-logic-panel]');
            if (!toggle || !panel) return;
            panel.classList.toggle('hidden', !toggle.checked);
        });
    }

    function syncConditionalLogicValueInputs(scope) {
        var root = scope || document;
        var logicRows = (root.matches && root.matches('.cf-logic-row')) ? [root] : [];
        logicRows = logicRows.concat(Array.prototype.slice.call(root.querySelectorAll('.cf-logic-row')));
        logicRows.forEach(function (row) {
            var operatorSelect = row.querySelector('select[name="conditional_logic_operator[]"]');
            var valueInput = row.querySelector('input[name="conditional_logic_value[]"]');
            if (!operatorSelect || !valueInput) return;
            var needsValue = operatorSelect.value !== 'empty' && operatorSelect.value !== 'not_empty';
            valueInput.disabled = !needsValue;
            valueInput.classList.toggle('bg-slate-100', !needsValue);
            valueInput.placeholder = needsValue ? 'Comparison value' : 'No value needed';
            if (!needsValue) {
                valueInput.value = '';
            }
        });
    }

    document.addEventListener('change', function (event) {
        if (event.target && event.target.matches('[data-conditional-logic-toggle]')) {
            syncConditionalLogicPanels(event.target.closest('[data-conditional-logic-root]'));
        }
        if (event.target && event.target.matches('select[name="conditional_logic_operator[]"]')) {
            syncConditionalLogicValueInputs(event.target.closest('[data-conditional-logic-panel]') || document);
        }
    });

    document.addEventListener('click', function (event) {
        var addRuleBtn = event.target.closest('.cf-add-logic-rule-btn');
        if (addRuleBtn) {
            var panel = addRuleBtn.closest('[data-conditional-logic-panel]');
            var body = panel ? panel.querySelector('[data-logic-rules-body]') : null;
            var row = body ? body.querySelector('.cf-logic-row:last-of-type') : null;
            if (!body || !row) return;

            var clone = row.cloneNode(true);
            Array.prototype.slice.call(clone.querySelectorAll('select')).forEach(function (select) {
                select.value = select.name === 'conditional_logic_operator[]' ? 'equals' : '';
            });
            Array.prototype.slice.call(clone.querySelectorAll('input')).forEach(function (input) {
                if (input.type === 'text') {
                    input.value = '';
                }
            });
            body.appendChild(clone);
            syncConditionalLogicValueInputs(clone);
            return;
        }

        var removeRuleBtn = event.target.closest('.cf-remove-logic-rule-btn');
        if (!removeRuleBtn) return;

        var removeRow = removeRuleBtn.closest('.cf-logic-row');
        var removeBody = removeRow ? removeRow.parentElement : null;
        if (!removeRow || !removeBody) return;

        var rows = removeBody.querySelectorAll('.cf-logic-row');
        if (rows.length <= 1) {
            Array.prototype.slice.call(removeRow.querySelectorAll('select')).forEach(function (select) {
                select.value = select.name === 'conditional_logic_operator[]' ? 'equals' : '';
            });
            Array.prototype.slice.call(removeRow.querySelectorAll('input')).forEach(function (input) {
                if (input.type === 'text') {
                    input.value = '';
                }
            });
            syncConditionalLogicValueInputs(removeRow);
            return;
        }

        removeRow.remove();
    });

    syncConditionalLogicPanels(document);
    syncConditionalLogicValueInputs(document);

    // ── Slug auto-generation from form name ───────────────────────────────────
    if (formNameInput && formSlugInput) {
        var autoSlug = formSlugInput.value.trim() === '';

        formNameInput.addEventListener('input', function () {
            if (!autoSlug) return;
            formSlugInput.value = slugify(formNameInput.value);
        });

        formSlugInput.addEventListener('input', function () {
            formSlugInput.value = slugify(formSlugInput.value);
            autoSlug = formSlugInput.value.trim() === '';
        });

        formSlugInput.addEventListener('blur', function () {
            if (formSlugInput.value.trim() === '') {
                autoSlug = true;
                formSlugInput.value = slugify(formNameInput.value);
            }
        });

        if (formSlugInput.value.trim() === '' && formNameInput.value.trim() !== '') {
            formSlugInput.value = slugify(formNameInput.value);
        }
    }

    // ── Drag-and-drop reorder ─────────────────────────────────────────────────
    function submitFieldOrder() {
        if (!sortableContainer || !reorderForm || !reorderInput) return;
        var orderedIds = Array.prototype.slice.call(
            sortableContainer.querySelectorAll('[data-field-id]')
        ).map(function (card) {
            return card.getAttribute('data-field-id');
        }).filter(Boolean);
        if (!orderedIds.length) return;
        reorderInput.value = orderedIds.join(',');
        reorderForm.submit();
    }

    if (sortableContainer) {
        sortableContainer.addEventListener('dragstart', function (event) {
            var card = event.target.closest('[data-field-id]');
            if (!card) return;
            draggingId = card.getAttribute('data-field-id');
            card.classList.add('opacity-60');
            if (event.dataTransfer) {
                event.dataTransfer.effectAllowed = 'move';
                event.dataTransfer.setData('text/plain', draggingId || '');
            }
        });

        sortableContainer.addEventListener('dragend', function (event) {
            var card = event.target.closest('[data-field-id]');
            if (card) card.classList.remove('opacity-60');
        });

        sortableContainer.addEventListener('dragover', function (event) {
            if (event.target.closest('[data-field-id]')) event.preventDefault();
        });

        sortableContainer.addEventListener('drop', function (event) {
            var target = event.target.closest('[data-field-id]');
            var source = draggingId ? sortableContainer.querySelector('[data-field-id="' + draggingId + '"]') : null;
            if (!target || !source || target === source) return;
            event.preventDefault();
            var midpoint = target.getBoundingClientRect().top + (target.offsetHeight / 2);
            if (event.clientY > midpoint) { target.after(source); } else { target.before(source); }
            submitFieldOrder();
        });
    }

    // ── Initial tab ───────────────────────────────────────────────────────────
    var initialHash = window.location.hash ? window.location.hash.replace('#', '') : '';
    var defaultTabElement = document.querySelector('[data-tab-default]');
    var defaultTab = defaultTabElement ? defaultTabElement.getAttribute('data-tab-default') : '';
    var initialTab = initialHash || defaultTab || 'overview';
    if (!document.querySelector('[data-tab-panel="' + initialTab + '"]')) initialTab = 'overview';
    activateTab(initialTab, false);

    // ── Add option row ──────────────────────────────────────────────────────
    document.addEventListener('click', function (event) {
        var btn = event.target.closest('.cf-add-option-btn');
        if (!btn) return;
        var container = btn.closest('[id="cf-quick-options-section"], .cf-field-options-panel');
        if (!container) return;
        var ta = container.querySelector('textarea[name="options_text"]');
        if (!ta) return;
        var lines = ta.value.split('\n').filter(function (l) { return l.trim() !== ''; });
        var n = lines.length + 1;
        var newLine = 'option_' + n + '|Option ' + n;
        ta.value = lines.length > 0 ? ta.value.trimEnd() + '\n' + newLine : newLine;
        ta.rows = Math.max(ta.rows, lines.length + 2);
        ta.focus();
        ta.setSelectionRange(ta.value.length, ta.value.length);
    });

    // ── Preview iframe ────────────────────────────────────────────────────────
    var previewFrame  = document.getElementById('cf-preview-frame');
    var previewRefBtn = document.getElementById('cf-preview-refresh');

    function loadPreview() {
        if (!previewFrame) return;
        previewFrame.src = previewFrame.getAttribute('data-preview-url') || '';
    }

    tabButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
            if (btn.getAttribute('data-tab-target') === 'preview') {
                loadPreview();
            }
        });
    });

    if (previewRefBtn) {
        previewRefBtn.addEventListener('click', function () {
            if (!previewFrame) return;
            previewFrame.src = '';
            setTimeout(loadPreview, 50);
        });
    }

    if (initialTab === 'preview') {
        loadPreview();
    }
})();
</script>
{/block}