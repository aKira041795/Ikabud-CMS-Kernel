{extends "modules/cms/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-900">Submission #{submission.id}</h2>
            <p class="text-sm text-gray-500 mt-1">Inspect the full payload, update its workflow state, and triage follow-up work from one place.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="{base_url}/cms/admin/contact-forms/submissions" class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-50">Back to Entries</a>
            {if submission.form_id > 0}
            <a href="{base_url}/cms/admin/contact-forms/{submission.form_id}/edit" class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-50">Open Form</a>
            {/if}
        </div>
    </div>

    {if message}
    <div class="px-4 py-3 rounded-xl border text-sm {if message.type == 'error'}bg-red-50 border-red-200 text-red-700{else}bg-emerald-50 border-emerald-200 text-emerald-700{/if}">{message.text}</div>
    {/if}

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <div class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Status</div>
            <div class="text-lg font-semibold {if submission.status == 'new'}text-sky-700{elseif submission.status == 'reviewed'}text-emerald-700{elseif submission.status == 'archived'}text-slate-700{else}text-rose-700{/if}">{submission.status_label}</div>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <div class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Form</div>
            <div class="text-lg font-semibold text-gray-900">{submission.form_label}</div>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <div class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Submitted</div>
            <div class="text-lg font-semibold text-gray-900">{submission.created_at}</div>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <div class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Reviewed</div>
            <div class="text-lg font-semibold text-gray-900">{if submission.reviewed_at}{submission.reviewed_at}{else}Not yet{/if}</div>
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,2fr),minmax(320px,1fr)] gap-6">
        <div class="space-y-6">
            <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
                <div class="px-5 py-4 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900">Captured Values</h3>
                </div>

                {if records | count > 0}
                <dl class="divide-y divide-gray-100">
                    {foreach records as record}
                    <div class="px-5 py-4 grid grid-cols-1 md:grid-cols-[220px,1fr] gap-3">
                        <dt>
                            <div class="text-sm font-semibold text-gray-900">{record.label}</div>
                            {if record.name}
                            <div class="text-xs font-mono text-gray-400 mt-1">{record.name}</div>
                            {/if}
                        </dt>
                        <dd class="text-sm text-gray-700 whitespace-pre-wrap break-words">{if record.value}{record.value}{else}<span class="text-gray-400">No value provided</span>{/if}</dd>
                    </div>
                    {/foreach}
                </dl>
                {else}
                <div class="px-5 py-10 text-center text-sm text-gray-500">No field payload was stored for this submission.</div>
                {/if}
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
                <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-gray-500">Workflow</h3>
                <div class="grid grid-cols-1 gap-2">
                    {foreach status_options as status_option}
                    <form method="post" action="{base_url}/cms/admin/contact-forms/submissions/{submission.id}/status">
                        <input type="hidden" name="_token" value="{csrf_token}">
                        <input type="hidden" name="status" value="{status_option.value}">
                        <button type="submit" class="w-full inline-flex items-center justify-between rounded-xl border px-4 py-3 text-sm font-medium {if submission.status == status_option.value}border-sky-600 bg-sky-50 text-sky-700{else}border-gray-300 bg-white text-gray-700 hover:border-sky-300 hover:text-sky-700{/if}">
                            <span>{status_option.label}</span>
                            {if submission.status == status_option.value}
                            <span class="text-xs uppercase tracking-[0.18em]">Current</span>
                            {/if}
                        </button>
                    </form>
                    {/foreach}
                </div>
            </div>

            <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-3">
                <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-gray-500">Metadata</h3>
                <div class="text-sm text-gray-600 space-y-2">
                    <div><span class="font-semibold text-gray-900">Submitter:</span> {if submission.name}{submission.name}{else}Anonymous{/if}</div>
                    <div><span class="font-semibold text-gray-900">Email:</span> {if submission.email}{submission.email}{else}Not provided{/if}</div>
                    <div><span class="font-semibold text-gray-900">IP Address:</span> {if submission.ip_address}{submission.ip_address}{else}Unknown{/if}</div>
                    <div><span class="font-semibold text-gray-900">Reviewer ID:</span> {if submission.reviewed_by}{submission.reviewed_by}{else}-{/if}</div>
                    <div><span class="font-semibold text-gray-900">Updated:</span> {if submission.updated_at}{submission.updated_at}{else}{submission.created_at}{/if}</div>
                </div>
            </div>
        </div>
    </div>
</div>
{/block}