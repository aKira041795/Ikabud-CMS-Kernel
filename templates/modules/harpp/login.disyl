<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#172554"><link rel="manifest" href="/harpp/manifest.webmanifest"><title>HARPP Sign In</title><style>{verbatim}body{margin:0;min-height:100vh;display:grid;place-items:center;font-family:system-ui;background:linear-gradient(145deg,#020617,#172554);color:#e2e8f0}.card{width:min(92vw,420px);padding:2rem;border:1px solid #334155;border-radius:1rem;background:#0f172a}label{display:grid;gap:.4rem;margin:1rem 0}input,button{padding:.8rem;border-radius:.6rem;border:1px solid #475569;font:inherit}input{background:#020617;color:#fff}button{width:100%;background:#0284c7;color:#fff;cursor:pointer}.error{color:#fca5a5;min-height:1.3rem}a{color:#7dd3fc}{/verbatim}</style></head><body><main class="card"><h1>HARPP</h1><p>Harness decision center and messenger</p><form id="login-form"><label>Email<input name="email" type="email" autocomplete="username" required></label><label>Password<input name="password" type="password" autocomplete="current-password" required></label><button type="submit">Open HARPP</button><p id="login-error" class="error" role="alert"></p></form><a href="/harpp/forgot-password">Forgot password?</a></main><script src="/assets/modules/harpp/pwa.js"></script><script>document.getElementById('login-form').addEventListener('submit',async(e)=>{e.preventDefault();const error=document.getElementById('login-error');error.textContent='';try{const data=await Harpp.fetch('/api/v1/harpp/auth/login',{method:'POST',body:Object.fromEntries(new FormData(e.currentTarget))});location.href=data.data.redirect||'/harpp';}catch(x){error.textContent=x.message;}});</script></body></html>
