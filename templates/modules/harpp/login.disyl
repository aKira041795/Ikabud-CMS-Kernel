<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#0d1014"><link rel="manifest" href="/harpp/manifest.webmanifest"><title>HARPP Sign In</title><style>{verbatim}*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;overflow-x:hidden;font-family:system-ui;background:#0d1014;color:#e7eaee}.card{width:min(92vw,420px);max-width:calc(100vw - 1.25rem);padding:2rem;border:1px solid #2b323c;border-radius:3px;background:#15191f}label{display:grid;gap:.4rem;margin:1rem 0}input,button{padding:.8rem;border-radius:3px;border:1px solid #5b6472;font:inherit}input{background:#0d1014;color:#e7eaee}button{width:100%;background:#7aa2f7;color:#0d1014;cursor:pointer}.error{color:#f07178;min-height:1.3rem}a{color:#7aa2f7}@media(max-width:480px){.card{width:100%;max-width:100%;border-radius:0;padding:1.5rem 1.25rem;min-height:100vh}.card h1{font-size:1.5rem}}{/verbatim}</style></head><body><main class="card"><h1>HARPP</h1><p>Harness decision center and messenger</p><form id="login-form"><label>Email<input name="email" type="email" autocomplete="username" required></label><label>Password<input name="password" type="password" autocomplete="current-password" required></label><button type="submit">Open HARPP</button><p id="login-error" class="error" role="alert"></p></form><a href="/harpp/forgot-password">Forgot password?</a></main><script src="/assets/modules/harpp/pwa.js"></script><script>document.getElementById('login-form').addEventListener('submit',async(e)=>{e.preventDefault();const error=document.getElementById('login-error');error.textContent='';try{const data=await Harpp.fetch('/api/v1/harpp/auth/login',{method:'POST',body:Object.fromEntries(new FormData(e.currentTarget))});location.href=data.data.redirect||'/harpp';}catch(x){error.textContent=x.message;}});</script></body></html>
