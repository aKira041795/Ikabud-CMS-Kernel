{extends "modules/harpp/layout.disyl"}
{block head}<style>.status-page{display:grid;gap:1rem}.status-page .panel{min-width:0}.status-page ul{margin:0;padding-left:1.25rem;display:grid;gap:.45rem;color:var(--text)}.status-page code{color:var(--accent)}.grid.two{grid-template-columns:1fr}.runner-card{display:flex;flex-direction:column;gap:.5rem}.runner-status{display:inline-block;border-radius:2px;padding:.2rem .6rem;font-size:.75rem;font-weight:600;background:var(--surface-raised)}.runner-status.online{color:var(--ok)}.runner-status.offline{color:var(--fail)}.chip{display:inline-block;background:var(--surface-raised);color:var(--text);border-radius:2px;padding:.15rem .5rem;font-size:.75rem}.age{color:var(--muted);font-size:.85rem}.empty-state{color:var(--muted);text-align:center;padding:2rem 1rem}.status-list{display:grid;gap:.65rem}.status-row{display:flex;justify-content:space-between;gap:.75rem;padding:.55rem 0;border-bottom:1px solid var(--line)}.status-row:last-child{border-bottom:0}.chip-row{display:flex;flex-wrap:wrap;gap:.35rem}.status-table{width:100%;border-collapse:collapse}.status-table th,.status-table td{padding:.45rem;text-align:left;border-bottom:1px solid var(--line)}.run-state.terminal{color:var(--ok)}.run-state.active{color:var(--accent)}.run-state.queued{color:var(--warn)}@media(min-width:700px){#runner-fleet{grid-template-columns:repeat(2,1fr)}.grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}}</style>{/block}
{block content}<div class="status-page">
<section class="panel"><h1>HARPP status</h1><p class="muted">Live health of the HARPP harness — runners, run queue, daemon, and workflows.</p></section>
<section class="panel"><h2>What HARPP can do</h2><ul><li>Human-like chat replies with a Next step.</li><li>RAG auto-injection of approved memory.</li><li>Deterministic commands: <code>harpp workflow list</code>, <code>harpp workflow show &lt;id&gt;</code>, <code>harpp workflow resume &lt;id&gt;</code>, and <code>harpp job list</code>.</li><li>Start debates with <code>Start debate &lt;topic&gt;</code>.</li><li>Run plans with <code>implement</code>, <code>re-implement</code>, or <code>Start T1..T4</code>.</li><li>Decision lifecycle: submit → decide → apply.</li><li>Deploy through the Deploy page.</li></ul></section>
<section class="panel"><h2>Daemon &amp; workflows</h2><div id="daemon-health" class="empty-state">Loading…</div></section>
<section class="panel"><h2>Runner fleet</h2><div id="runner-fleet" class="grid"><p class="empty-state">Loading…</p></div></section>
<section class="panel"><h2>Run queue</h2><div id="run-queue" class="empty-state">Loading…</div></section>
<div class="grid two"><section class="panel"><h2>Recent runs</h2><div id="recent-runs" class="empty-state">Loading…</div></section><section class="panel"><h2>Recent decisions</h2><div id="recent-decisions" class="empty-state">Loading…</div></section></div>
</div>{/block}
{block scripts}<script src="/assets/modules/harpp/status.js" defer></script>{/block}