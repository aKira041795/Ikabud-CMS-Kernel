{extends "modules/harpp/layout.disyl"}
{block head}<style>.runner-card{display:flex;flex-direction:column;gap:.5rem}.runner-status{display:inline-block;border-radius:2rem;padding:.2rem .6rem;font-size:.75rem;font-weight:600}.runner-status.online{background:#14532d;color:#86efac}.runner-status.offline{background:#1f2937;color:#9ca3af}.runner-cap{display:inline-block;background:#1e3a8a;color:#bfdbfe;border-radius:2rem;padding:.15rem .5rem;font-size:.75rem}.runner-meta{display:flex;flex-wrap:wrap;gap:.5rem;color:#94a3b8;font-size:.85rem}.empty-state{color:#94a3b8;text-align:center;padding:2rem 1rem}@media(min-width:700px){#runner-fleet{grid-template-columns:repeat(2,1fr)!important}}</style>{/block}
{block content}<section class="panel"><h1>Runner fleet</h1><p class="muted">Health and capabilities of the desktop, LAN, and other HARPP runners registered to this tenant.</p><div id="runner-fleet" class="grid" style="margin-top:1rem"></div><p id="runner-status" class="status"></p></section>{/block}
{block scripts}<script src="/assets/modules/harpp/runners.js" defer></script>{/block}
