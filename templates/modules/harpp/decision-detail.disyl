{extends "modules/harpp/layout.disyl"}
{block content}<section class="panel" id="decision-detail" data-decision-id="{decision_id}" data-user-role="{user.role}"><a href="/harpp/decisions">← Decision inbox</a><h1 id="decision-title">Decision</h1><div id="decision-content"></div>{if user.role == 'owner' || user.role == 'admin'}<form id="decision-apply-close" class="grid" hidden><h2>Apply and close</h2><label>Apply rationale<textarea name="apply_rationale" required placeholder="What was applied"></textarea></label><label>Close rationale<textarea name="close_rationale" required placeholder="Why this decision is being closed"></textarea></label><button class="button" type="submit">Apply and close</button></form><form id="decision-delete" class="grid" hidden><h2>Archive decision</h2><p class="muted">Removes this terminal decision from active lists while retaining the decision, lifecycle audit, and linked ADR. Archived records remain available through the Closed + Show archived filters.</p><button class="button" type="submit">Archive decision</button></form><button id="artifact-open" class="button" type="button">View / share artifacts</button><div id="artifact-panel" class="grid" hidden><h2>Review artifacts</h2><p class="muted">Full approved-task detail (ADR + decision + generated files), readable here and shareable for review. Generated files are downloadable.</p><div id="artifact-add-file"><h3>Add a generated file</h3><div class="grid"><label>Filename<input name="af_filename" placeholder="report.txt"></label><label>Type<input name="af_mime" value="text/plain"></label></div><label>Content<textarea name="af_content" placeholder="Paste the generated file content..."></textarea></label><button id="artifact-add-file-btn" class="button" type="button">Attach file</button></div><div id="artifact-list"></div><div id="artifact-share-form"><label>Share with reviewer (user id)<input name="artifact_reviewer_id" type="number" min="1" placeholder="Reviewer user id"></label><label>TTL hours<input name="artifact_ttl_hours" type="number" min="1" value="720"></label><button id="artifact-share" class="button" type="button">Create share link</button></div><pre id="artifact-share-link" class="muted"></pre></div>{/if}<details id="decision-advanced" open><summary>Decision status — change state</summary><p class="muted">Owners may move a decision straight to its target state (e.g. Decide, or Close directly) from any open state without cycling through every step. Choose the target state and apply.</p><form id="decision-action" class="grid"><label>Target state<select name="state" required><option value="PENDING">Queue for review</option><option value="NOTIFIED">Mark notified</option><option value="VIEWED">Mark viewed</option><option value="DECIDED">Decide</option><option value="ACKNOWLEDGED">Acknowledge</option><option value="APPLIED">Mark applied</option><option value="CLOSED">Close</option></select></label><label>Decision / ADR note<textarea name="decision" placeholder="Required when deciding; this becomes durable decision context"></textarea></label><label>Rationale<textarea name="rationale" required></textarea></label><button class="button" type="submit">Apply status</button></form></details><h2>Lifecycle audit</h2><div id="decision-audit"></div><p id="detail-status" class="status"></p></section>{/block}
{block scripts}<script src="/assets/modules/harpp/decision-detail.js" defer></script>{/block}
