{extends "modules/harpp/layout.disyl"}
{block content}<section class="panel" id="decision-detail" data-decision-id="{decision_id}" data-user-role="{user.role}"><a href="/harpp/decisions">← Decision inbox</a><h1 id="decision-title">Decision</h1><div id="decision-content"></div>{if user.role == 'owner' || user.role == 'admin'}<form id="decision-apply-close" class="grid" hidden><h2>Apply and close</h2><label>Rationale<textarea name="rationale" required placeholder="Why this decision is applied and ready to close"></textarea></label><button class="button" type="submit">Apply and close</button></form><form id="decision-delete" class="grid" hidden><h2 class="danger">Delete decision</h2><p class="muted">Permanently removes this closed decision, its audit trail, and any linked ADR. This cannot be undone.</p><button class="button danger" type="submit">Delete decision</button></form>{/if}<form id="decision-action" class="grid"><label>Action<select name="state" required><option value="PENDING">Queue for review</option><option value="NOTIFIED">Mark notified</option><option value="VIEWED">Mark viewed</option><option value="DECIDED">Decide</option><option value="ACKNOWLEDGED">Acknowledge</option><option value="APPLIED">Mark applied</option><option value="CLOSED">Close</option></select></label><label>Decision / ADR note<textarea name="decision" placeholder="Required when deciding; this becomes durable decision context"></textarea></label><label>Rationale<textarea name="rationale" required></textarea></label><button class="button" type="submit">Apply action</button></form><h2>Lifecycle audit</h2><div id="decision-audit"></div><p id="detail-status" class="status"></p></section>{/block}
{block scripts}<script src="/assets/modules/harpp/decision-detail.js" defer></script>{/block}
