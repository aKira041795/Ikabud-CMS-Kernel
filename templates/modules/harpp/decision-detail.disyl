{extends "modules/harpp/layout.disyl"}
{block content}<section class="panel" id="decision-detail" data-decision-id="{decision_id}"><a href="/harpp/decisions">← Decision inbox</a><h1 id="decision-title">Decision</h1><div id="decision-content"></div><form id="decision-action" class="grid"><label>Action<select name="state" required><option value="PENDING">Queue for review</option><option value="NOTIFIED">Mark notified</option><option value="VIEWED">Mark viewed</option><option value="DECIDED">Decide</option><option value="ACKNOWLEDGED">Acknowledge</option><option value="APPLIED">Mark applied</option><option value="CLOSED">Close</option></select></label><label>Decision / ADR note<textarea name="decision" placeholder="Required when deciding; this becomes durable decision context"></textarea></label><label>Rationale<textarea name="rationale" required></textarea></label><button class="button" type="submit">Apply action</button></form><h2>Lifecycle audit</h2><div id="decision-audit"></div><p id="detail-status" class="status"></p></section>{/block}
{block scripts}<script src="/assets/modules/harpp/decision-detail.js" defer></script>{/block}
