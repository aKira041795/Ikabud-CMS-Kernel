{extends "modules/harpp/layout.disyl"}
{block head}<style>.settings-page{display:grid;gap:1rem;max-width:760px}.settings-page .panel{display:grid;gap:.75rem}.settings-page .panel h2,.settings-page .panel h3,.settings-page .panel p{margin:0}.account-groups{display:grid;gap:1.25rem}.push-device-status{padding:.75rem;border-left:3px solid var(--warn);background:var(--surface-raised)}.push-device-status[data-state="ready"]{border-color:var(--ok)}.danger-zone{margin-top:.5rem;padding-top:1rem;border-top:1px solid var(--fail)}.danger-zone .button{border-color:var(--fail);color:var(--fail)}</style>{/block}
{block content}<div class="settings-page"><header><h1>Settings</h1><p class="muted">Manage notifications, account details, security, and harness access.</p></header><section class="panel"><h2>Notifications</h2><form id="settings-form" class="grid"><label>Web Push<select name="push_enabled"><option value="1">Enabled</option><option value="0">Disabled</option></select></label><label>Channels<input name="notification_channels" value="push" readonly></label><label>Message pushes<select name="notify_messages"><option value="1">Enabled</option><option value="0">Disabled</option></select></label><label>Push important messages only<select name="push_important_only"><option value="0">Off (push all messages)</option><option value="1">On (warnings, blocks, and failures)</option></select></label><button class="button" type="submit">Save notification settings</button></form><p>VAPID: <strong id="vapid-status">Checking…</strong></p><button id="push-toggle" class="button" type="button">Enable push on this device</button><p id="push-device-status" class="push-device-status" role="status">Checking whether this device supports push…</p></section><section class="panel"><h2>Account</h2><div class="account-groups"><div><h3>Profile</h3><form id="profile-form" class="grid"><label>Full name<input name="full_name" value="{user.full_name}" required></label><label>Email<input name="email" type="email" value="{user.email}" required></label><button class="button" type="submit">Save profile</button></form></div><div class="grid"><h3>Tenant preferences</h3><label>Conversation archiving<select name="conversation_archiving" form="settings-form"><option value="1">Enabled</option><option value="0">Disabled</option></select></label><label>Country (ISO code)<input name="country" form="settings-form" placeholder="e.g. PH" maxlength="2"></label><label>Region / City<input name="region" form="settings-form" placeholder="e.g. Manila" maxlength="64"></label><button class="button" type="submit" form="settings-form">Save tenant preferences</button></div></div></section><section class="panel"><h2>Security</h2><form id="change-password-form" class="grid" autocomplete="off"><label>Current password<input name="current_password" type="password" autocomplete="current-password" required></label><label>New password<input name="new_password" type="password" minlength="12" autocomplete="new-password" required><small class="muted">12+ characters with upper, lower, and number.</small></label><label>Confirm new password<input name="confirm_password" type="password" minlength="12" autocomplete="new-password" required></label><button class="button" type="submit">Change password</button></form></section><section class="panel"><h2>Harness</h2><h3>Bridge key</h3><p id="bridge-status">Checking…</p><p><code id="bridge-key-value" class="muted" style="display:none"></code></p><p><button id="bridge-generate" class="button" type="button">Generate bridge key</button></p><p class="muted">The raw key is shown only once — save it now. All harness clients (harpp CLI, MCP, Pi) must use it.</p><div class="danger-zone"><h3>Danger zone</h3><p class="muted">Rotating invalidates the old key immediately and requires every harness client to be updated.</p><button id="bridge-rotate" class="button" type="button" style="display:none">Rotate bridge key</button></div></section></div><p id="settings-status" class="status"></p>{/block}
{block scripts}<script src="/assets/modules/harpp/settings.js" defer></script>{/block}
