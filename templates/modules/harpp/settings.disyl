{extends "modules/harpp/layout.disyl"}
{block content}<div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr))"><section class="panel"><h1>Tenant settings</h1><form id="settings-form" class="grid"><label>Web Push<select name="push_enabled"><option value="1">Enabled</option><option value="0">Disabled</option></select></label><label>Channels<input name="notification_channels" value="push" readonly></label><label>Decision pushes<select name="notify_decisions"><option value="1">Enabled</option><option value="0">Disabled</option></select></label><label>Message pushes<select name="notify_messages"><option value="1">Enabled</option><option value="0">Disabled</option></select></label><label>Push important messages only<select name="push_important_only"><option value="0">Off (push all messages)</option><option value="1">On (decisions + warnings/blocks/failures)</option></select></label><label>Conversation archiving<select name="conversation_archiving"><option value="1">Enabled</option><option value="0">Disabled</option></select></label><label>Country (ISO code)<input name="country" placeholder="e.g. PH" maxlength="2"></label><label>Region / City<input name="region" placeholder="e.g. Manila" maxlength="64"></label><button class="button" type="submit">Save tenant settings</button></form><p>VAPID: <strong id="vapid-status">Checking…</strong></p><button id="push-toggle" class="button" type="button">Enable push on this device</button></section><section class="panel"><h2>Profile</h2><form id="profile-form" class="grid"><label>Full name<input name="full_name" value="{user.full_name}" required></label><label>Email<input name="email" type="email" value="{user.email}" required></label><button class="button" type="submit">Save profile</button></form></section><section class="panel"><h2>Change password</h2><form id="change-password-form" class="grid" autocomplete="off"><label>Current password<input name="current_password" type="password" autocomplete="current-password" required></label><label>New password<input name="new_password" type="password" minlength="12" autocomplete="new-password" required><small class="muted">12+ characters with upper, lower, and number.</small></label><label>Confirm new password<input name="confirm_password" type="password" minlength="12" autocomplete="new-password" required></label><button class="button" type="submit">Change password</button></form></section><section class="panel"><h2>Harness bridge key</h2><p id="bridge-status">Checking…</p><p><code id="bridge-key-value" class="muted" style="display:none"></code></p><p><button id="bridge-generate" class="button" type="button">Generate bridge key</button><button id="bridge-rotate" class="button" type="button" style="display:none">Rotate bridge key</button></p><p class="muted">The raw key is shown only once — save it now. All harness clients (harpp CLI, MCP, Pi) must use it. Rotating invalidates the old key immediately.</p></section></div><p id="settings-status" class="status"></p>{/block}
{block scripts}<script src="/assets/modules/harpp/settings.js" defer></script>{/block}
