{extends "modules/harpp/layout.disyl"}
{block content}<div class="grid"><section class="panel"><h1>User management</h1><p class="muted">{if user.role == 'owner'}Owners can manage every account and assign roles.{else}Administrators can manage member accounts; only an owner can manage administrators or owners.{/if} Deleting a user deactivates and soft-deletes the account.</p><form id="user-create-form" class="grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr));align-items:end"><label>Full name<input name="full_name" required maxlength="255"></label><label>Email<input name="email" type="email" required></label><label>Role<select name="role"><option value="member">Member</option>{if user.role == 'owner'}<option value="admin">Admin</option><option value="owner">Owner</option>{/if}</select></label><label>Temporary password<input name="password" type="password" minlength="12" required autocomplete="new-password"><small class="muted">12+ characters with upper, lower, and number.</small></label><button class="button" type="submit">Create user</button></form></section><section class="panel"><div style="display:flex;align-items:center;justify-content:space-between;gap:1rem"><h2>Active users</h2><button id="users-reload" class="button" type="button">Reload</button></div><div id="users-list" class="grid"><p class="muted">Loading…</p></div></section><p id="users-status" class="status" role="status"></p></div>{/block}
{block scripts}<script>window.HARPP_CURRENT_USER_ID={user.id};window.HARPP_CURRENT_USER_ROLE='{user.role}';</script><script src="/assets/modules/harpp/users.js" defer></script>{/block}
