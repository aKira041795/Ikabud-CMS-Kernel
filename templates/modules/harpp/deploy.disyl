{extends "modules/harpp/layout.disyl"}
{block head}<style>.row{display:flex;gap:.6rem;flex-wrap:wrap}.row button{flex:1}.kv{display:grid;gap:.25rem;font-size:.85rem;color:var(--text)}.grid>.panel{min-width:0}.recs{list-style:none;padding:0;margin:0;max-height:20rem;overflow:auto;min-width:0}.recs li{padding:.55rem .25rem;border-bottom:1px solid var(--line);font-size:.85rem;overflow-wrap:break-word;word-break:break-word}.primary{background:var(--accent);color:var(--bg);font-weight:700}.danger{background:var(--surface-raised);border-color:var(--fail);color:var(--fail);font-weight:700}.warn{color:var(--warn)}.receipt{background:var(--bg);border:1px solid var(--line);border-radius:3px;padding:.75rem;overflow:auto;font-size:.72rem;white-space:pre-wrap;word-break:break-word;color:var(--muted)}.receipt-summary{background:var(--bg);border:1px solid var(--line);border-radius:3px;padding:.75rem;display:grid;gap:.4rem;font-size:.82rem;color:var(--text);overflow-wrap:break-word}.receipt-summary h3{margin:0;color:var(--text)}.receipt-summary b{color:var(--text)}.receipt-summary .mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;word-break:break-all}.receipt-summary .dim{color:var(--muted)}[hidden]{display:none!important}</style>{/block}
{block content}<div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr))"><section class="panel"><h1>Deploy</h1><p class="muted" id="deploy-inventory-note"></p><label>Deployment package<select id="deploy-package"></select></label><label>FTP profile<select id="deploy-profile"></select></label><div class="kv" id="deploy-profile-detail"></div><p class="muted">Deploy uploads the selected package via the selected profile to the live host. The upload runs on your local client machine; only profile metadata is shown here — FTP credentials never reach the server.</p><button id="deploy-go" class="button primary" type="button">Review deploy</button><p id="deploy-status" class="status"></p><div id="deploy-confirm" class="panel" hidden style="border-color:var(--warn)"><p class="warn">Confirm deploy of <strong id="deploy-confirm-pkg"></strong> to <strong id="deploy-confirm-host"></strong>?</p><div class="row"><button id="deploy-confirm-yes" class="button danger" type="button">Confirm &amp; deploy</button><button id="deploy-confirm-no" class="button" type="button">Cancel</button></div></div></section><section class="panel"><h2>Recent deploys</h2><div id="deploy-receipt-summary" class="receipt-summary" hidden></div><button id="deploy-receipt-toggle" class="button" type="button" hidden>Show raw receipt</button><pre id="deploy-receipt" class="receipt" hidden></pre><ul class="recs" id="deploy-history"><li class="muted">(none)</li></ul></section></div>{/block}
{block scripts}<script src="/assets/modules/harpp/deploy.js" defer></script>{/block}
