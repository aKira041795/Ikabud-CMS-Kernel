{extends "modules/harpp/layout.disyl"}
{block head}<style>.row{display:flex;gap:.6rem;flex-wrap:wrap}.row button{flex:1}.kv{display:grid;gap:.25rem;font-size:.85rem;color:#cbd5e1}.recs{list-style:none;padding:0;margin:0;max-height:20rem;overflow:auto}.recs li{padding:.55rem .25rem;border-bottom:1px solid var(--line);font-size:.85rem}.primary{background:#0ea5e9;color:#02131f;font-weight:700}.danger{background:#7f1d1d;color:#fff;font-weight:700}.warn{color:#fbbf24}.receipt{background:#020617;border:1px solid #334155;border-radius:.65rem;padding:.75rem;overflow:auto;font-size:.72rem;white-space:pre-wrap;word-break:break-word;color:#94a3b8}[hidden]{display:none!important}</style>{/block}
{block content}<div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr))"><section class="panel"><h1>Deploy</h1><p class="muted" id="deploy-inventory-note"></p><label>Deployment package<select id="deploy-package"></select></label><label>FTP profile<select id="deploy-profile"></select></label><div class="kv" id="deploy-profile-detail"></div><p class="muted">Deploy uploads the selected package via the selected profile to the live host. The upload runs on your local client machine; only profile metadata is shown here — FTP credentials never reach the server.</p><button id="deploy-go" class="button primary" type="button">Review deploy</button><p id="deploy-status" class="status"></p><div id="deploy-confirm" class="panel" hidden style="border-color:#b45309"><p class="warn">Confirm deploy of <strong id="deploy-confirm-pkg"></strong> to <strong id="deploy-confirm-host"></strong>?</p><div class="row"><button id="deploy-confirm-yes" class="button danger" type="button">Confirm &amp; deploy</button><button id="deploy-confirm-no" class="button" type="button">Cancel</button></div></div></section><section class="panel"><h2>Recent deploys</h2><pre id="deploy-receipt" class="receipt" hidden></pre><ul class="recs" id="deploy-history"><li class="muted">(none)</li></ul></section></div>{/block}
{block scripts}<script src="/assets/modules/harpp/deploy.js" defer></script>{/block}
