{extends "modules/harpp/layout.disyl"}
{block content}<section class="panel"><h1>Decision inbox</h1><form id="decision-filters" class="grid" style="grid-template-columns:1fr 1fr auto"><label>State<select name="state"><option value="PENDING">PENDING</option><option value="">All</option><option>NOTIFIED</option><option>VIEWED</option><option>DECIDED</option><option>ACKNOWLEDGED</option><option>APPLIED</option><option>CLOSED</option></select></label><label>Priority<select name="priority"><option value="">All</option><option>critical</option><option>high</option><option>normal</option><option>low</option></select></label><label><input name="include_archived" type="checkbox" value="1"> Show archived</label><button class="button" type="submit">Filter</button></form><div style="display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;align-items:center;margin:1rem 0"><p class="muted" style="margin:0">Archive removes terminal decisions from active lists without deleting decisions, audits, or ADRs.</p><button id="archive-all-closed" class="button" type="button">Archive all terminal</button></div><div id="decision-list" class="grid" style="margin-top:1rem"></div><p id="decision-status" class="status"></p></section>{/block}
{block scripts}<script src="/assets/modules/harpp/decisions.js" defer></script>{/block}
