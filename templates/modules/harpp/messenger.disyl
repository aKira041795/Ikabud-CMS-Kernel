{extends "modules/harpp/layout.disyl"}
{block head}<style>.messenger{display:grid;grid-template-columns:minmax(220px,32%) 1fr;min-height:70vh}.conversations{border-right:1px solid var(--line);padding-right:1rem}.conversation{display:block;width:100%;text-align:left;margin:.4rem 0;padding:.75rem;border:1px solid var(--line);border-radius:.7rem;background:#111c31;color:#fff;cursor:pointer}.conversation.selected{border-color:var(--accent)}.thread{padding-left:1rem;display:flex;flex-direction:column}.messages{flex:1;max-height:58vh;overflow:auto}.message{max-width:80%;margin:.55rem 0;padding:.65rem .8rem;border-radius:.8rem;background:#1e293b;white-space:pre-wrap;overflow-wrap:anywhere}.message.user{margin-left:auto;background:#075985}.compose{display:flex;gap:.5rem;align-items:stretch}.compose-field{display:flex;flex:1;flex-direction:column;gap:.35rem}.compose textarea{min-height:3rem;width:100%;box-sizing:border-box}.compose button{align-self:stretch}.new-conversation-plus{align-self:flex-start!important;width:2rem;height:2rem;padding:0;font-size:1.35rem;line-height:1}.thread-actions{display:flex;gap:.5rem;flex-wrap:wrap;margin:.35rem 0}@media(max-width:700px){.messenger{grid-template-columns:1fr}.conversations{border:0;padding:0}.thread{padding:1rem 0 0}}</style>{/block}
{block content}<section class="panel messenger"><aside class="conversations"><h2>Conversations</h2><button id="new-conversation" class="button">New</button><button id="archive-toggle" class="button" type="button">Show archived</button><div id="conversation-list" aria-live="polite"></div></aside><article class="thread"><h2 id="thread-title">Select a conversation</h2><div class="thread-actions"><button id="close-conversation" class="button" type="button">Mark done</button><button id="archive-conversation" class="button" type="button">Archive</button><button id="delete-messages" class="button danger" type="button">Delete all messages</button></div><div id="messages" class="messages"></div><form id="compose" class="compose"><div class="compose-field"><textarea name="body" aria-label="Message" placeholder="Reply to the harness" required></textarea><button class="button new-conversation-plus" id="new-conversation-plus" type="button" aria-label="Create new conversation" title="Create new conversation">+</button></div><button class="button" type="submit">Send</button><button class="button" id="refresh-thread" type="button">Refresh</button></form><p id="messenger-status" class="status"></p></article></section>{/block}
{block scripts}<script src="/assets/modules/harpp/messenger.js" defer></script>{/block}
