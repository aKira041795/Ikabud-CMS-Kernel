{extends "modules/harpp/layout.disyl"}
{block head}<style>.messenger{display:grid;grid-template-columns:minmax(220px,32%) 1fr;min-height:70vh}.conversations{border-right:1px solid var(--line);padding-right:1rem}.conversation{display:block;width:100%;text-align:left;margin:.4rem 0;padding:.75rem;border:1px solid var(--line-strong);border-radius:3px;background:var(--surface-raised);color:var(--text);cursor:pointer}.conversation.selected{border-color:var(--accent)}.thread{padding-left:1rem;display:flex;flex-direction:column}.messages{flex:1;max-height:58vh;overflow:auto}.message{max-width:80%;margin:.55rem 0;padding:.65rem .8rem;border-radius:3px;background:var(--surface-raised);white-space:pre-wrap;overflow-wrap:anywhere}.message.user{margin-left:auto;border-left:3px solid var(--accent);background:var(--surface)}.message-time{display:block;margin-top:.35rem;font-size:.72rem;line-height:1.2;opacity:.65;text-align:right}.how-to{margin-top:.75rem;border:1px solid var(--line);border-radius:3px;background:var(--bg);padding:.6rem .75rem;font-size:.82rem;line-height:1.55}.how-to summary{cursor:pointer;font-weight:600;color:var(--accent)}.how-to code{background:var(--surface-raised);padding:.05rem .3rem;border-radius:2px;font-size:.78rem}.how-to pre{background:var(--surface-raised);padding:.4rem .5rem;border-radius:3px;overflow:auto}.how-to ul{margin:.35rem 0 0;padding-left:1.15rem}.how-to li{margin:.2rem 0}.compose{display:flex;gap:.5rem;align-items:stretch}.compose-field{display:flex;flex:1;flex-direction:column;gap:.35rem}.compose textarea{min-height:3rem;width:100%;box-sizing:border-box}.compose button{align-self:stretch}.thread-actions{display:flex;gap:.5rem;flex-wrap:wrap;margin:.35rem 0}.conversation-row{display:flex;align-items:center;gap:.4rem}.conversation-row .conversation{flex:1}.conversation-delete{flex-shrink:0;font-size:.8rem;padding:.35rem .55rem}.messenger-dialog-overlay{position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;padding:1rem;background:color-mix(in srgb,var(--bg) 78%,transparent)}.messenger-dialog{width:min(30rem,100%);border:1px solid var(--line-strong);border-radius:3px;background:var(--surface);color:var(--text);box-shadow:0 1rem 3rem color-mix(in srgb,var(--bg) 75%,transparent)}.messenger-dialog-header{padding:1rem;border-bottom:1px solid var(--line)}.messenger-dialog-header h3{margin:0}.messenger-dialog-body{display:grid;gap:1rem;padding:1rem}.messenger-dialog-field{display:grid;gap:.35rem}.messenger-dialog-field label{font-weight:600}.messenger-dialog-field input{box-sizing:border-box;width:100%;padding:.65rem;border:1px solid var(--line-strong);border-radius:3px;background:var(--surface-raised);color:var(--text)}.messenger-dialog-field input:focus{border-color:var(--accent);outline:1px solid var(--accent)}.messenger-dialog-help{margin:0;color:var(--muted);font-size:.82rem}.messenger-dialog-error{min-height:1.2em;margin:0;color:var(--fail);font-size:.82rem}.messenger-dialog-actions{display:flex;justify-content:flex-end;gap:.5rem;padding:1rem;border-top:1px solid var(--line)}.messenger-dialog-actions button:disabled{cursor:not-allowed;opacity:.5}@media(max-width:700px){.messenger{grid-template-columns:1fr}.conversations{border:0;padding:0}.thread{padding:1rem 0 0}}</style>{/block}
{block content}<section class="panel messenger"><aside class="conversations"><h2>Conversations</h2><button id="new-conversation" class="button">New</button><button id="archive-toggle" class="button" type="button">Show archived</button><div id="conversation-list" aria-live="polite"></div></aside><article class="thread"><h2 id="thread-title">Select a conversation</h2><div class="thread-actions"><button id="close-conversation" class="button" type="button">Mark done</button><button id="archive-conversation" class="button" type="button">Archive</button></div><div id="messages" class="messages"></div><form id="compose" class="compose"><div class="compose-field"><textarea name="body" aria-label="Message" placeholder="Reply to the harness" required></textarea></div><button class="button" type="submit">Send</button><button class="button" id="refresh-thread" type="button">Refresh</button></form><details class="how-to"><summary>How to use — commands</summary><p><b>Run a task plan</b> — send the plan first, then start it:</p><pre>Proposed plan:
T1 - Fix doc drift in workbench-contract.json
T2 - Refactor the handlers split
T3 - Close the manifest gap
Assign: GPT Sol</pre><p>Then run it with:</p><ul><li><code>Start T1, T2 has option B. Then T3, T4</code> — run the plan tasks</li><li><code>Restart the guidance tasks and implement</code> — re-run tasks</li><li><code>resume the failed tasks</code> / <code>proceed with the workflow</code></li><li><code>/implement</code> — run the recorded plan</li></ul><p><b>Workflows</b>: <code>workflow list</code> · <code>workflow status</code> · <code>workflow start &lt;name&gt;</code> · <code>workflow show &lt;id&gt;</code></p><p><b>Debate</b>: <code>Start debate &lt;topic&gt;</code> — e.g. <code>Start debate: 5 rounds on RAG</code></p></details><p id="messenger-status" class="status"></p></article></section>{/block}
{block scripts}<script src="/assets/modules/harpp/messenger.js" defer></script>{/block}
