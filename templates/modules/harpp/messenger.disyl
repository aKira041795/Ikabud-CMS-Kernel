{extends "modules/harpp/layout.disyl"}
{block head}<style>.messenger{display:grid;grid-template-columns:minmax(220px,32%) 1fr;min-height:70vh}.conversations{border-right:1px solid var(--line);padding-right:1rem}.conversation{display:block;width:100%;text-align:left;margin:.4rem 0;padding:.75rem;border:1px solid var(--line);border-radius:.7rem;background:#111c31;color:#fff;cursor:pointer}.conversation.selected{border-color:var(--accent)}.thread{padding-left:1rem;display:flex;flex-direction:column}.messages{flex:1;max-height:58vh;overflow:auto}.message{max-width:80%;margin:.55rem 0;padding:.65rem .8rem;border-radius:.8rem;background:#1e293b;white-space:pre-wrap;overflow-wrap:anywhere}.message.user{margin-left:auto;background:#075985}.message-time{display:block;margin-top:.35rem;font-size:.72rem;line-height:1.2;opacity:.65;text-align:right}.how-to{margin-top:.75rem;border:1px solid var(--line);border-radius:.7rem;background:#0f1b33;padding:.6rem .75rem;font-size:.82rem;line-height:1.55}.how-to summary{cursor:pointer;font-weight:600;color:var(--accent)}.how-to code{background:rgba(148,163,184,.16);padding:.05rem .3rem;border-radius:.3rem;font-size:.78rem}.how-to pre{background:rgba(148,163,184,.08);padding:.4rem .5rem;border-radius:.4rem;overflow:auto}.how-to ul{margin:.35rem 0 0;padding-left:1.15rem}.how-to li{margin:.2rem 0}.compose{display:flex;gap:.5rem;align-items:stretch}.compose-field{display:flex;flex:1;flex-direction:column;gap:.35rem}.compose textarea{min-height:3rem;width:100%;box-sizing:border-box}.compose button{align-self:stretch}.new-conversation-plus{align-self:flex-start!important;width:2rem;height:2rem;padding:0;font-size:1.35rem;line-height:1}.thread-actions{display:flex;gap:.5rem;flex-wrap:wrap;margin:.35rem 0}.conversation-row{display:flex;align-items:center;gap:.4rem}.conversation-row .conversation{flex:1}.conversation-delete{flex-shrink:0;font-size:.8rem;padding:.35rem .55rem}@media(max-width:700px){.messenger{grid-template-columns:1fr}.conversations{border:0;padding:0}.thread{padding:1rem 0 0}}</style>{/block}
{block content}<section class="panel messenger"><aside class="conversations"><h2>Conversations</h2><button id="new-conversation" class="button">New</button><button id="archive-toggle" class="button" type="button">Show archived</button><div id="conversation-list" aria-live="polite"></div></aside><article class="thread"><h2 id="thread-title">Select a conversation</h2><div class="thread-actions"><button id="close-conversation" class="button" type="button">Mark done</button><button id="archive-conversation" class="button" type="button">Archive</button></div><div id="messages" class="messages"></div><form id="compose" class="compose"><div class="compose-field"><textarea name="body" aria-label="Message" placeholder="Reply to the harness" required></textarea><button class="button new-conversation-plus" id="new-conversation-plus" type="button" aria-label="Create new conversation" title="Create new conversation">+</button></div><button class="button" type="submit">Send</button><button class="button" id="refresh-thread" type="button">Refresh</button></form><details class="how-to"><summary>How to use — commands</summary><p><b>Run a task plan</b> — send the plan first, then start it:</p><pre>Proposed plan:
T1 - Fix doc drift in workbench-contract.json
T2 - Refactor the handlers split
T3 - Close the manifest gap
Assign: GPT Sol</pre><p>Then run it with:</p><ul><li><code>Start T1, T2 has option B. Then T3, T4</code> — run the plan tasks</li><li><code>Restart the guidance tasks and implement</code> — re-run tasks</li><li><code>resume the failed tasks</code> / <code>proceed with the workflow</code></li><li><code>/implement</code> — run the recorded plan</li></ul><p><b>Workflows</b>: <code>workflow list</code> · <code>workflow status</code> · <code>workflow start &lt;name&gt;</code> · <code>workflow show &lt;id&gt;</code></p><p><b>Debate</b>: <code>Start debate &lt;topic&gt;</code> — e.g. <code>Start debate: 5 rounds on RAG</code></p></details><p id="messenger-status" class="status"></p></article></section>{/block}
{block scripts}<script src="/assets/modules/harpp/messenger.js" defer></script>{/block}
