{extends "modules/harpp/layout.disyl"}
{block content}<section class="panel"><div style="display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap"><h1>Notifications</h1><span><button id="show-history" class="button" type="button">Show history</button> <button id="mark-all" class="button" type="button">Mark all read</button></span></div><p class="muted">Read notifications are hidden by default.</p><div id="notification-list" class="grid"></div><p id="notification-status" class="status"></p></section>{/block}
{block scripts}<script src="/assets/modules/harpp/notifications.js" defer></script>{/block}
