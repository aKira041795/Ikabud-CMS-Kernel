{extends "modules/moto-inventory/layouts/app.disyl"}

{block content}
<div class="mi-title">
    <h1>Import & Backup</h1>
</div>

<div class="mi-grid" style="grid-template-columns:minmax(0,1fr);gap:14px">
    <div class="mi-card">
        <h2 style="margin-top:0">Import pricelist (.xlsx)</h2>
        <div class="mi-row" style="margin-bottom:12px">
            <label style="min-width:180px"><span class="mi-muted" style="font-size:.72rem">Branch</span>
                <select id="mi-imp-branch" class="mi-select">
                    {for b in branches}<option value="{b.id}">{b.name}</option>{/for}
                </select>
            </label>
            <label style="min-width:180px"><span class="mi-muted" style="font-size:.72rem">Brand / Supplier</span>
                <select id="mi-imp-brand" class="mi-select">
                    {for b in brands}<option value="{b.id}">{b.name}</option>{/for}
                </select>
            </label>
            <label style="min-width:220px"><span class="mi-muted" style="font-size:.72rem">Brand template</span>
                <select id="mi-imp-template" class="mi-select">
                    <option value="__auto__">Auto (match sheet)</option>
                    <optgroup label="Brand templates">
                        {for t in import_templates.presets}
                        <option value="preset:{t.key}">{t.name}</option>
                        {/for}
                    </optgroup>
                    {if import_templates.custom}
                    <optgroup label="Your saved templates">
                        {for t in import_templates.custom}
                        <option value="custom:{t.id}">{t.name}</option>
                        {/for}
                    </optgroup>
                    {/if}
                    <option value="__custom__">Custom (map manually)</option>
                </select>
            </label>
        </div>
        <div class="mi-banner info" id="mi-imp-template-hint" style="display:none;margin-top:10px"></div>
        <div class="mi-field">
            <input id="mi-imp-file" class="mi-input" type="file" accept=".xlsx" aria-label="Choose .xlsx file">
        </div>
        <div class="mi-row">
            <button class="mi-btn primary" id="mi-imp-stage" type="button">Choose file &amp; map columns</button>
            <button class="mi-btn ghost" id="mi-imp-export" type="button">Export branch data (.json)</button>
            <label class="mi-btn" style="cursor:pointer">Import backup (.json)<input id="mi-imp-backup-file" type="file" accept=".json" hidden></label>
        </div>
        <div class="mi-banner error" id="mi-imp-file-error" style="display:none;margin-top:10px"></div>
        <div class="mi-banner info" style="margin-top:10px">
            Pick the brand's .xlsx pricelist, then map each column to a field (Part No., Description, Cost, Sell Price or Code, Quantity). Exactly one column must be <strong>Part No.</strong>; anything else becomes a custom field stored under the label you type. Files are validated and staged for review before any inventory change.
        </div>
    </div>

    <div class="mi-card" id="mi-imp-wizard" style="display:none">
        <h2 style="margin-top:0">Import wizard <span class="mi-muted" style="font-size:.8rem" id="mi-wiz-note"></span></h2>

        <div id="mi-wiz-step-sheet" style="display:none">
            <p class="mi-muted">This file has multiple sheets. Choose the one that holds the pricelist.</p>
            <div id="mi-wiz-sheet-list" style="margin-bottom:12px"></div>
            <div class="mi-row">
                <button class="mi-btn primary" id="mi-wiz-sheet-next" type="button">Next: choose columns &amp; rows</button>
            </div>
        </div>

        <div id="mi-wiz-step-range" style="display:none">
            <div class="mi-grid cols-3">
                <div class="mi-field"><label for="mi-wiz-cols">Columns (e.g. A-F or A,C,F)</label><input class="mi-input" id="mi-wiz-cols" placeholder="A-F" aria-label="Columns"></div>
                <div class="mi-field"><label for="mi-wiz-row-from">Header row (1-based)</label><input class="mi-input" id="mi-wiz-row-from" type="number" min="1" aria-label="Header row"></div>
                <div class="mi-field"><label for="mi-wiz-row-to">Last data row (1-based)</label><input class="mi-input" id="mi-wiz-row-to" type="number" min="1" aria-label="Last data row"></div>
            </div>
            <p class="mi-muted" id="mi-wiz-range-info" style="font-size:.78rem"></p>
            <div id="mi-wiz-range-preview" class="mi-table-wrap"></div>
            <div class="mi-row" style="margin-top:12px">
                <button class="mi-btn ghost" id="mi-wiz-range-back" type="button">Back</button>
                <button class="mi-btn primary" id="mi-wiz-range-next" type="button">Next: map columns</button>
            </div>
        </div>

        <div id="mi-wiz-step-mapping" style="display:none">
            <p class="mi-muted" style="font-size:.84rem">Type what each column means. Exactly one must be <strong>Part No.</strong> — anything else becomes a custom field stored and shown exactly as you name it. A <strong>Code Price</strong> column decodes the brand's coded price (M-I-C-H-A-E-L-S-O-N = 1-2-3-4-5-6-7-8-9-0); <strong>Code (store)</strong> saves the code as-is next to a Sell Price. Brand templates pre-fill this step.</p>
            <div class="mi-banner info" id="mi-wiz-template-badge" style="display:none;margin-bottom:12px"></div>
            <div id="mi-wiz-map-rows" style="margin-bottom:12px"></div>
            <div class="mi-row" style="margin-bottom:12px">
                <select id="mi-wiz-add-col" class="mi-input" style="max-width:320px" aria-label="Add column"></select>
                <button class="mi-btn" id="mi-wiz-add-col-btn" type="button">+ Add column</button>
            </div>
            <div class="mi-row" style="margin-bottom:12px;gap:8px;align-items:center">
                <input class="mi-input" id="mi-wiz-template-name" placeholder="Save this mapping as a reusable template…" aria-label="Template name" style="max-width:300px;margin:0">
                <button class="mi-btn" id="mi-wiz-save-template" type="button">Save as template</button>
                <span class="mi-muted" style="font-size:.72rem">For brands not listed above.</span>
            </div>
            <div class="mi-banner error" id="mi-wiz-map-warning" style="display:none;margin-bottom:12px"></div>
            <div class="mi-row">
                <button class="mi-btn ghost" id="mi-wiz-map-back" type="button">Back</button>
                <button class="mi-btn primary" id="mi-wiz-map-next" type="button">Next: review</button>
            </div>
        </div>

        <div id="mi-wiz-step-review" style="display:none">
            <div id="mi-wiz-review-body"></div>
            <div class="mi-row" style="margin-top:12px">
                <button class="mi-btn ghost" id="mi-wiz-review-back" type="button">Back</button>
                <button class="mi-btn primary" id="mi-wiz-stage" type="button">Upload &amp; stage for review</button>
            </div>
        </div>
    </div>

    <div class="mi-card" id="mi-imp-review" style="display:none">
        <h2 style="margin-top:0">Review staged import</h2>
        <div id="mi-imp-review-body"></div>
        <div class="mi-row" style="margin-top:12px">
            <label class="mi-row" style="gap:6px;font-size:.84rem"><input type="checkbox" id="mi-imp-overwrite-qty"> Also overwrite quantity on existing items</label>
            <div class="mi-spacer"></div>
            <button class="mi-btn ghost" id="mi-imp-errors" type="button">Download error report</button>
            <button class="mi-btn primary" id="mi-imp-commit" type="button">Commit import</button>
        </div>
    </div>
</div>

<div class="mi-card">
    <h2 style="margin-top:0">Recent imports</h2>
    <div class="mi-table-wrap">
        <table class="mi-table">
            <thead><tr><th>File</th><th>Brand</th><th>Status</th><th style="text-align:right">Rows</th><th style="text-align:right">New</th><th style="text-align:right">Updated</th><th>When</th></tr></thead>
            <tbody id="mi-imp-list">
                {if imports}
                {for i in imports}
                <tr>
                    <td>{i.filename}</td>
                    <td>{i.brand_name}</td>
                    <td>{if i.status == 'committed'}<span class="mi-badge good">Committed</span>{elseif i.status == 'rejected'}<span class="mi-badge bad">Rejected</span>{else}<span class="mi-badge warn">Staged</span>{/if}</td>
                    <td style="text-align:right">{i.row_count}</td>
                    <td style="text-align:right">{i.new_count}</td>
                    <td style="text-align:right">{i.existing_count}</td>
                    <td class="mi-muted" style="font-size:.78rem">{i.created_at}</td>
                </tr>
                {/for}
                {else}
                <tr><td colspan="7" class="mi-empty">No imports yet.</td></tr>
                {/if}
            </tbody>
        </table>
    </div>
</div>
{/block}

{block scripts}
<script type="application/json" id="mi-imp-templates-json">{templates_json|raw}</script>
<script src="/moto-inventory/assets/import-wizard.js?v=2026-08-17-3"></script>
<script>
(function () {
    const S = window.MOTO_INVENTORY;
    const $ = (id) => document.getElementById(id);
    let staged = null;

    // Brand template registry (server-rendered): presets + saved custom templates.
    const TEMPLATES = (function () {
        const el = $('mi-imp-templates-json');
        try { return JSON.parse(el ? el.textContent : '{}'); }
        catch (e) { return { presets: [], custom: [] }; }
    })();
    const TEMPLATE_MAP = (function () {
        const m = {};
        (TEMPLATES.presets || []).forEach(t => { m['preset:' + t.key] = t; });
        (TEMPLATES.custom || []).forEach(t => { m['custom:' + t.id] = t; });
        return m;
    })();
    // The wizard's "Auto (match sheet)" mode matches a preset to the sheet it
    // was derived from; it reads this map by template key.
    window.MOTO_IMPORT_TEMPLATES = TEMPLATE_MAP;

    function currentTemplateKey() {
        return $('mi-imp-template') ? $('mi-imp-template').value : '__auto__';
    }
    function currentTemplate() {
        const key = currentTemplateKey();
        if (key === '__auto__' || key === '__custom__') return null;
        return TEMPLATE_MAP[key] || null;
    }
    function updateTemplateHint() {
        const hint = $('mi-imp-template-hint');
        if (!hint) return;
        const key = currentTemplateKey();
        if (key === '__auto__' || key === '__custom__') { hint.style.display = 'none'; return; }
        const t = TEMPLATE_MAP[key];
        if (!t) { hint.style.display = 'none'; return; }
        const partSrc = t.part_number_source === 'description' ? 'part number = description (sheet has no part-no. column)'
            : (t.part_number_source === 'composite' ? 'part number = combined columns' : 'part number column');
        let html = '<strong>' + S.esc(t.name) + '</strong> — ' + S.esc(partSrc) + (t.sheet ? ' · default sheet "' + S.esc(t.sheet) + '"' : '');
        const sel = $('mi-imp-brand');
        const brandName = sel && sel.selectedOptions.length ? sel.selectedOptions[0].textContent : '';
        if (t.brand_hint && brandName && String(brandName).toLowerCase().indexOf(String(t.brand_hint).toLowerCase()) === -1) {
            html += ' <span style="opacity:.75">· destination brand is <strong>' + S.esc(brandName) + '</strong> (template targets ' + S.esc(t.brand_hint) + ')</span>';
        }
        hint.innerHTML = html;
        hint.style.display = 'block';
    }

    async function api(url, opts, isForm) {
        opts = opts || {};
        if (opts.method && opts.method !== 'GET') {
            if (isForm) opts.headers = Object.assign({ 'X-CSRF-Token': S.csrf }, opts.headers || {});
            else { opts.headers = Object.assign({ 'Content-Type': 'application/json', 'X-CSRF-Token': S.csrf }, opts.headers || {}); opts.body = JSON.stringify(opts.body || {}); }
        }
        const r = await fetch(url, opts);
        return r.json();
    }

    function showStaged(json) {
        staged = json;
        $('mi-imp-review').style.display = 'block';
        const body = $('mi-imp-review-body');
        let html = `<div class="mi-grid cols-2">
            <div class="mi-stat"><div class="mi-stat-label">Rows</div><div class="mi-stat-value">${staged.rows.length}</div></div>
            <div class="mi-stat"><div class="mi-stat-label">New / Existing</div><div class="mi-stat-value">${staged.new_count} / ${staged.existing_count}</div></div>
        </div>`;
        if (staged.errors && staged.errors.length) {
            html += `<div class="mi-banner error" style="margin-top:10px"><strong>${staged.errors.length} validation error(s)</strong><br>${S.esc(staged.errors.slice(0, 8).join('<br>'))}</div>`;
        } else if (staged.warnings && staged.warnings.length) {
            html += `<div class="mi-banner warn" style="margin-top:10px"><strong>${staged.warnings.length} warning(s)</strong><br>${S.esc(staged.warnings.slice(0, 6).join('<br>'))}</div>`;
        } else {
            html += '<div class="mi-banner good" style="margin-top:10px">No validation errors — ready to commit.</div>';
        }
        body.innerHTML = html;
        S.toast('Import staged for review');
    }

    if ($('mi-imp-stage')) $('mi-imp-stage').addEventListener('click', () => {
        const file = $('mi-imp-file').files[0];
        if (!file) return S.toast('Choose an .xlsx file first', true);
        const branchId = $('mi-imp-branch').value;
        const brandId = $('mi-imp-brand').value;
        if (!branchId || !brandId) return S.toast('Pick a branch and brand first', true);
        const errBox = $('mi-imp-file-error');
        errBox.style.display = 'none';
        if (window.MOTO_IMPORT_WIZARD && typeof window.MOTO_IMPORT_WIZARD.init === 'function') {
            const template = currentTemplate();
            const templateKey = currentTemplateKey();
            window.MOTO_IMPORT_WIZARD.init({
                branchId: +branchId,
                brandId: +brandId,
                file,
                templateMode: templateKey,
                template,
                onStage: async (mapping, headerRow, dataStartRow, dataEndRow, sheetIdx) => {
                    const form = new FormData();
                    form.append('file', file);
                    form.append('branch_id', branchId);
                    form.append('brand_id', brandId);
                    form.append('sheet_index', sheetIdx);
                    form.append('header_row', headerRow);
                    form.append('data_start_row', dataStartRow);
                    form.append('data_end_row', dataEndRow);
                    form.append('mapping', JSON.stringify(mapping));
                    if (templateKey !== '__custom__') form.append('template_key', templateKey);
                    form.append('idempotency_key', S.uuid());
                    const json = await api('/api/v1/moto-inventory/imports/stage', { method: 'POST', body: form }, true);
                    if (!json.ok) { S.toast(json.error, true); return; }
                    $('mi-imp-wizard').style.display = 'none';
                    showStaged(json.data);
                }
            });
        } else {
            errBox.textContent = 'Import wizard script failed to load.';
            errBox.style.display = 'block';
        }
    });

    if ($('mi-imp-template')) {
        $('mi-imp-template').addEventListener('change', updateTemplateHint);
        updateTemplateHint();
    }
    if ($('mi-imp-brand')) $('mi-imp-brand').addEventListener('change', updateTemplateHint);

    if ($('mi-wiz-save-template')) $('mi-wiz-save-template').addEventListener('click', async () => {
        const name = $('mi-wiz-template-name') ? $('mi-wiz-template-name').value.trim() : '';
        if (!name) return S.toast('Give the template a name first', true);
        if (typeof window.MOTO_IMPORT_WIZARD.buildTemplatePayload !== 'function') return S.toast('Import wizard is not ready', true);
        const payload = window.MOTO_IMPORT_WIZARD.buildTemplatePayload();
        payload.name = name;
        const json = await api('/api/v1/moto-inventory/imports/templates', { method: 'POST', body: payload });
        if (json.ok) {
            S.toast('Template "' + name + '" saved', false, 'good');
            $('mi-wiz-template-name').value = '';
            const t = json.data;
            if (t && t.id) {
                // Make the new template selectable right away (no reload needed).
                TEMPLATES.custom.push(t);
                TEMPLATE_MAP['custom:' + t.id] = t;
                const sel = $('mi-imp-template');
                if (sel) {
                    const opt = document.createElement('option');
                    opt.value = 'custom:' + t.id;
                    opt.textContent = t.name;
                    const manual = sel.querySelector('option[value="__custom__"]');
                    sel.insertBefore(opt, manual);
                }
            }
        }
        else S.toast(json.error, true);
    });

    if ($('mi-imp-commit')) $('mi-imp-commit').addEventListener('click', async () => {
        if (!staged) return;
        if (!confirm('Commit this import now? Existing products will be updated.')) return;
        const json = await api('/api/v1/moto-inventory/imports/' + staged.import_id + '/commit', { method: 'POST', body: { overwrite_qty: $('mi-imp-overwrite-qty').checked } });
        if (json.ok) { S.toast('Import committed', false, 'good'); staged = null; $('mi-imp-review').style.display = 'none'; setTimeout(() => location.reload(), 800); }
        else S.toast(json.error, true);
    });

    if ($('mi-imp-errors')) $('mi-imp-errors').addEventListener('click', () => {
        if (staged) location.href = '/api/v1/moto-inventory/imports/' + staged.import_id + '/errors';
    });

    if ($('mi-imp-export')) $('mi-imp-export').addEventListener('click', () => {
        const q = new URLSearchParams({ branch_id: $('mi-imp-branch').value });
        location.href = '/api/v1/moto-inventory/export?' + q.toString();
    });

    if ($('mi-imp-backup-file')) $('mi-imp-backup-file').addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;
        let payload;
        try { payload = JSON.parse(await file.text()); }
        catch (err) { return S.toast('Not a valid backup file', true); }
        const json = await api('/api/v1/moto-inventory/import', { method: 'POST', body: { branch_id: +$('mi-imp-branch').value, idempotency_key: S.uuid(), payload } });
        if (json.ok) { S.toast(`Backup imported: ${json.data.products_created} new, ${json.data.products_updated} updated`, false, 'good'); }
        else S.toast(json.error, true);
        e.target.value = '';
    });
})();
</script>
{/block}
