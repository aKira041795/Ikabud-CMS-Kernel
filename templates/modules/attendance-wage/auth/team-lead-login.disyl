<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Team Lead — Attendance</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-4">
<div class="w-full max-w-sm">
    <div class="bg-white rounded-xl shadow-lg p-8">
        <div class="text-center mb-6">
            <h1 class="text-xl font-bold text-gray-900">Team Attendance</h1>
            <p class="text-sm text-gray-500 mt-1">Verify your identity to view your team</p>
        </div>

        {if error}
        <div class="mb-4 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">{error}</div>
        {/if}

        <form id="otp-form" onsubmit="return false;">
            <!-- Step 1: Email -->
            <div id="step-email">
                <label class="block text-sm font-medium text-gray-700 mb-1">Team Lead Email</label>
                <input type="email" id="email" name="email" required
                    class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm mb-4"
                    placeholder="team.lead@zap-arts.com">
                <button type="button" onclick="sendOtp()"
                    class="w-full py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700">
                    Send Verification Code
                </button>
            </div>

            <!-- Step 2: OTP -->
            <div id="step-otp" class="hidden">
                <p class="text-sm text-gray-600 mb-3">A 6-digit code was sent to <span id="display-email" class="font-medium"></span></p>
                <label class="block text-sm font-medium text-gray-700 mb-1">Verification Code</label>
                <input type="text" id="code" name="code" required maxlength="6" inputmode="numeric"
                    class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm mb-4 text-center text-2xl tracking-widest"
                    placeholder="000000">
                <button type="button" onclick="verifyOtp()"
                    class="w-full py-2.5 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700">
                    Verify &amp; View Team
                </button>
                <button type="button" onclick="resetForm()"
                    class="w-full py-2 mt-2 text-sm text-gray-500 hover:text-gray-700">
                    ← Use a different email
                </button>
            </div>
        </form>
        <div class="mt-6 pt-4 border-t border-gray-100 text-center">
            <a href="/attendance-wage/login" class="text-sm text-gray-500 hover:text-gray-700">← Back to Login</a>
        </div>
    </div>
</div>

<div id="toast" class="fixed bottom-6 right-6 hidden px-4 py-2 rounded-lg text-white text-sm shadow-lg z-50"></div>

<script>
var otpToken = '';

function toast(msg, type) {
    var t = document.getElementById('toast');
    t.textContent = msg;
    t.className = 'fixed bottom-6 right-6 px-4 py-2 rounded-lg text-white text-sm shadow-lg z-50 ' + (type === 'error' ? 'bg-red-600' : 'bg-green-600');
    t.classList.remove('hidden');
    setTimeout(function(){ t.classList.add('hidden'); }, 4000);
}

function sendOtp() {
    var email = document.getElementById('email').value.trim();
    if (!email) { toast('Please enter your email.', 'error'); return; }
    var fd = new FormData();
    fd.append('email', email);

    fetch('/api/v1/attendance/team-lead/send-otp', { method: 'POST', body: fd })
        .then(function(r){ return r.json(); })
        .then(function(d){
            if (d.ok) {
                otpToken = d.token;
                document.getElementById('step-email').classList.add('hidden');
                document.getElementById('step-otp').classList.remove('hidden');
                document.getElementById('display-email').textContent = email;
                document.getElementById('code').focus();
                toast(d.message || 'Code sent!', 'success');
            } else {
                toast(d.error || 'Failed to send code.', 'error');
            }
        })
        .catch(function(){ toast('Network error. Please try again.', 'error'); });
}

function verifyOtp() {
    var code = document.getElementById('code').value.trim();
    if (!code) { toast('Enter the verification code.', 'error'); return; }
    if (!otpToken) { toast('Session expired. Please request a new code.', 'error'); return; }
    var fd = new FormData();
    fd.append('code', code);
    fd.append('token', otpToken);

    fetch('/api/v1/attendance/team-lead/verify-otp', { method: 'POST', body: fd })
        .then(function(r){ return r.json(); })
        .then(function(d){
            if (d.ok) {
                window.location = d.redirect;
            } else {
                toast(d.error || 'Invalid code.', 'error');
            }
        })
        .catch(function(){ toast('Network error.', 'error'); });
}

function resetForm() {
    document.getElementById('step-email').classList.remove('hidden');
    document.getElementById('step-otp').classList.add('hidden');
    document.getElementById('code').value = '';
    otpToken = '';
}
</script>
</body>
</html>
