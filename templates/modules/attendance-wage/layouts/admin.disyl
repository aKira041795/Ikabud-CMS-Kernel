<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{app_name|default:'ZAP'} — {page_title|default:'Attendance & Wage'}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://unpkg.com/alpinejs@3.14.3/dist/cdn.min.js"></script>
    <script src="/admin/assets/js/ikb-inline-edit.js"></script>
    <script>
        window.showToast = function(msg, type) {
            type = type || 'success';
            var bg = type === 'error' ? '#dc2626' : type === 'warning' ? '#d97706' : '#059669';
            var toast = document.createElement('div');
            toast.textContent = msg;
            toast.style.cssText = 'position:fixed;bottom:24px;right:24px;background:'+bg+';color:#fff;padding:10px 20px;border-radius:8px;font-size:14px;z-index:9999;box-shadow:0 4px 12px rgba(0,0,0,.15);transition:opacity .3s';
            document.body.appendChild(toast);
            setTimeout(function(){ toast.style.opacity='0'; setTimeout(function(){ toast.remove(); }, 300); }, 3000);
        };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
                    colors: {
                        brand: { 50:'#eff6ff',100:'#dbeafe',200:'#bfdbfe',300:'#93c5fd',400:'#60a5fa',500:'#3b82f6',600:'#2563eb',700:'#1d4ed8',800:'#1e40af',900:'#1e3a8a',950:'#172554' }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 min-h-screen flex">
    <!-- Sidebar -->
    <aside class="w-64 bg-brand-950 text-brand-100 flex flex-col flex-shrink-0 min-h-screen fixed inset-y-0 left-0 z-40">
        <div class="px-6 py-5 border-b border-brand-800">
            {if logo_url}
            <img src="{logo_url}" alt="{app_name|default:'ZAP'}" class="h-8 w-auto mb-2">
            {/if}
            <a href="/admin/wage" class="text-xl font-extrabold tracking-tight text-white">{app_name|default:'ZAP'}</a>
            <p class="text-xs text-brand-400 mt-0.5">Attendance &amp; Wage</p>
        </div>
        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
            {macro navLink(icon, label, url, navId)}
            <a href="{url}" class="flex items-center px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {if active_nav == '{navId}'}bg-brand-800 text-white{else}text-brand-200 hover:bg-brand-800/50 hover:text-white{/if}">
                <span class="w-5 mr-3 text-center">{icon}</span> {label}
            </a>
            {/macro}

            {call navLink("📊", "Dashboard", "/admin/wage", "dashboard")}
            {call navLink("🕐", "Attendance", "/admin/attendance", "attendance")}
            {call navLink("👥", "Employees", "/admin/wage/employees", "employees")}
            {call navLink("👪", "Teams", "/admin/wage/groups", "groups")}
            {call navLink("📅", "Payroll Periods", "/admin/wage/periods", "periods")}
            {call navLink("💵", "Computations", "/admin/wage/computations", "computations")}
            {call navLink("🔧", "Adjustments", "/admin/wage/adjustments", "adjustments")}
            {call navLink("📉", "Deductions", "/admin/wage/deductions", "deductions")}
            {call navLink("💸", "Cash Advances", "/admin/wage/cash-advances", "cash-advances")}

            <div class="pt-3 mt-3 border-t border-brand-800"></div>

            {call navLink("🏖️", "Holidays", "/admin/wage/holidays", "holidays")}
            {call navLink("📋", "Schedules", "/admin/wage/schedules", "schedules")}
            {call navLink("📍", "Locations", "/admin/wage/locations", "locations")}
            {call navLink("📄", "Reports", "/admin/wage/reports", "reports")}

            {if current_user_role == 'admin'}
            <div class="pt-3 mt-3 border-t border-brand-800"></div>
            {call navLink("🔄", "Migration", "/admin/wage/migration", "migration")}
            {call navLink("🧮", "Benefits Calc", "/admin/wage/benefits-calculator", "benefits")}
            {/if}
        </nav>
        <div class="px-5 py-4 border-t border-brand-800 space-y-2">
            <a href="/admin/wage/profile" class="flex items-center gap-2 text-sm font-medium text-brand-300 hover:text-white transition-colors">
                <span>👤</span> My Profile
            </a>
            {if current_user_role == 'admin'}
            <a href="/admin/wage/settings" class="flex items-center gap-2 text-sm font-medium text-brand-300 hover:text-white transition-colors">
                <span>⚙️</span> Settings
            </a>
            {/if}
            <a href="/attendance-wage/logout" class="flex items-center gap-2 text-sm font-medium text-brand-300 hover:text-white transition-colors">
                <span>🚪</span> Sign out
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 ml-64">
        {block main}{/block}
    </div>
</body>
</html>
