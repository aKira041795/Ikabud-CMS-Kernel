<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZAP — {page_title|default:'Attendance & Wage'}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://unpkg.com/alpinejs@3.14.3/dist/cdn.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
                    colors: {
                        brand: { 50:'#eff6ff',100:'#dbeafe',200:'#bfdbfe',300:'#93c5fd',400:'#60a5fa',500:'#3b82f6',600:'#2563eb',700:'#1d4ed8',800:'#1e40af',900:'#1e3a8a',950:'#172554' }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 min-h-screen flex">
    <!-- Sidebar -->
    <aside class="w-64 bg-brand-950 text-brand-100 flex flex-col flex-shrink-0 min-h-screen fixed inset-y-0 left-0 z-40">
        <div class="px-6 py-5 border-b border-brand-800">
            <a href="/admin/wage" class="text-xl font-extrabold tracking-tight text-white">ZAP</a>
            <p class="text-xs text-brand-400 mt-0.5">Attendance &amp; Wage</p>
        </div>
        <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
            <a href="/admin/wage" class="flex items-center px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {if active_nav == 'dashboard'}bg-brand-800 text-white{else}text-brand-200 hover:bg-brand-800/50 hover:text-white{/if}">
                <span class="w-5 mr-3 text-center">📊</span> Dashboard
            </a>
            <a href="/admin/attendance" class="flex items-center px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {if active_nav == 'attendance'}bg-brand-800 text-white{else}text-brand-200 hover:bg-brand-800/50 hover:text-white{/if}">
                <span class="w-5 mr-3 text-center">🕐</span> Attendance
            </a>
            <a href="/admin/wage/employees" class="flex items-center px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {if active_nav == 'employees'}bg-brand-800 text-white{else}text-brand-200 hover:bg-brand-800/50 hover:text-white{/if}">
                <span class="w-5 mr-3 text-center">👥</span> Employees
            </a>
            <a href="/admin/wage/periods" class="flex items-center px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {if active_nav == 'periods'}bg-brand-800 text-white{else}text-brand-200 hover:bg-brand-800/50 hover:text-white{/if}">
                <span class="w-5 mr-3 text-center">📅</span> Payroll Periods
            </a>
            <a href="/admin/wage/computations" class="flex items-center px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {if active_nav == 'computations'}bg-brand-800 text-white{else}text-brand-200 hover:bg-brand-800/50 hover:text-white{/if}">
                <span class="w-5 mr-3 text-center">💵</span> Computations
            </a>
            <a href="/admin/wage/adjustments" class="flex items-center px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {if active_nav == 'adjustments'}bg-brand-800 text-white{else}text-brand-200 hover:bg-brand-800/50 hover:text-white{/if}">
                <span class="w-5 mr-3 text-center">🔧</span> Adjustments
            </a>
            <a href="/admin/wage/deductions" class="flex items-center px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {if active_nav == 'deductions'}bg-brand-800 text-white{else}text-brand-200 hover:bg-brand-800/50 hover:text-white{/if}">
                <span class="w-5 mr-3 text-center">📉</span> Deductions
            </a>
            <a href="/admin/wage/cash-advances" class="flex items-center px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {if active_nav == 'cash-advances'}bg-brand-800 text-white{else}text-brand-200 hover:bg-brand-800/50 hover:text-white{/if}">
                <span class="w-5 mr-3 text-center">💸</span> Cash Advances
            </a>
            <div class="pt-3 mt-3 border-t border-brand-800"></div>
            <a href="/admin/wage/holidays" class="flex items-center px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {if active_nav == 'holidays'}bg-brand-800 text-white{else}text-brand-200 hover:bg-brand-800/50 hover:text-white{/if}">
                <span class="w-5 mr-3 text-center">🏖️</span> Holidays
            </a>
            <a href="/admin/wage/schedules" class="flex items-center px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {if active_nav == 'schedules'}bg-brand-800 text-white{else}text-brand-200 hover:bg-brand-800/50 hover:text-white{/if}">
                <span class="w-5 mr-3 text-center">📋</span> Schedules
            </a>
            <a href="/admin/wage/locations" class="flex items-center px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {if active_nav == 'locations'}bg-brand-800 text-white{else}text-brand-200 hover:bg-brand-800/50 hover:text-white{/if}">
                <span class="w-5 mr-3 text-center">📍</span> Locations
            </a>
            <a href="/admin/wage/reports" class="flex items-center px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {if active_nav == 'reports'}bg-brand-800 text-white{else}text-brand-200 hover:bg-brand-800/50 hover:text-white{/if}">
                <span class="w-5 mr-3 text-center">📄</span> Reports
            </a>
            {if current_user_role == 'admin'}
            <div class="pt-3 mt-3 border-t border-brand-800"></div>
            <a href="/admin/wage/migration" class="flex items-center px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {if active_nav == 'migration'}bg-brand-800 text-white{else}text-brand-200 hover:bg-brand-800/50 hover:text-white{/if}">
                <span class="w-5 mr-3 text-center">🔄</span> Migration
            </a>
            <a href="/admin/wage/benefits-calculator" class="flex items-center px-3 py-2.5 rounded-lg text-sm font-medium transition-colors {if active_nav == 'benefits'}bg-brand-800 text-white{else}text-brand-200 hover:bg-brand-800/50 hover:text-white{/if}">
                <span class="w-5 mr-3 text-center">🧮</span> Benefits Calc
            </a>
            {/if}
        </nav>
        <div class="px-5 py-4 border-t border-brand-800 space-y-2">
            <a href="/admin/wage/profile" class="flex items-center gap-2 text-sm font-medium text-brand-300 hover:text-white transition-colors">
                <span>👤</span> My Profile
            </a>
            {if current_user_role == 'admin'}
            <a href="/admin/wage/settings" class="flex items-center gap-2 text-sm font-medium text-brand-300 hover:text-white transition-colors">
                <span>⚙️</span> Settings
            </a>
            {/if}
            <a href="/attendance-wage/logout" class="flex items-center gap-2 text-sm font-medium text-brand-300 hover:text-white transition-colors">
                <span>🚪</span> Sign out
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 ml-64">
        {block main}{/block}
    </div>
</body>
</html>
