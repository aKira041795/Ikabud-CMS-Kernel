{extends "modules/attendance-wage/layouts/admin.disyl"}
{block main}
<div class="px-6 py-8">
    <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">🏖️ Holidays</h1>
        {if edit_holiday}
        <form method="post" action="/api/v1/wage/holidays/{edit_holiday.holiday_id}" class="flex items-center gap-2">
            <input type="hidden" name="_token" value="{csrf_token}">
            <input type="text" name="holiday_name" value="{edit_holiday.holiday_name|default:''}" required class="px-3 py-2 border border-brand-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
            <input type="date" name="holiday_date" value="{edit_holiday.holiday_date|default:''}" required class="px-3 py-2 border border-brand-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
            <select name="holiday_type" class="px-3 py-2 border border-brand-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                <option value="regular" {if edit_holiday.holiday_type=='regular'}selected{/if}>Regular (2.00×)</option>
                <option value="special_non_working" {if edit_holiday.holiday_type=='special_non_working'}selected{/if}>Special Non-Working (1.30×)</option>
                <option value="special_working" {if edit_holiday.holiday_type=='special_working'}selected{/if}>Special Working (1.00×)</option>
            </select>
            <label class="flex items-center gap-1 text-xs text-gray-500">
                <input type="checkbox" name="is_recurring" value="1" {if edit_holiday.is_recurring}checked{/if} class="rounded" /> Yearly
            </label>
            <button type="submit" class="px-4 py-2.5 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm whitespace-nowrap">Update</button>
            <a href="/admin/wage/holidays" class="px-3 py-2.5 text-sm text-gray-500 hover:text-gray-700">Cancel</a>
        </form>
        {else}
        <form method="post" action="/api/v1/wage/holidays" class="flex items-center gap-2">
            <input type="hidden" name="_token" value="{csrf_token}">
            <input type="text" name="holiday_name" placeholder="Holiday name" required class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
            <input type="date" name="holiday_date" required class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
            <select name="holiday_type" class="px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                <option value="regular">Regular (2.00×)</option>
                <option value="special_non_working">Special Non-Working (1.30×)</option>
                <option value="special_working">Special Working (1.00×)</option>
            </select>
            <label class="flex items-center gap-1 text-xs text-gray-500">
                <input type="checkbox" name="is_recurring" value="1" class="rounded" /> Yearly
            </label>
            <button type="submit" class="px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm whitespace-nowrap">Add Holiday</button>
        </form>
        {/if}
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        {ikb_entity_list source="holiday" view="table" use="tailwind" limit="30" empty="No holidays configured." search="true" search-placeholder="Search holidays..." /}
    </div>
</div>
{/block}
