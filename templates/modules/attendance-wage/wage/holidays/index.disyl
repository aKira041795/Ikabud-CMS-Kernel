{* Holidays — Entity List *}
{extends "layouts/app.disyl"}

{block content}
<div class="admin-shell">
  <div class="ikb-toolbar">
    <h1>🏖️ Holidays</h1>
    <form method="post" action="/api/v1/wage/holidays" class="ikb-inline-form">
      {csrf_field /}
      <input type="text" name="holiday_name" placeholder="Holiday name" required />
      <input type="date" name="holiday_date" required />
      <select name="holiday_type">
        <option value="regular">Regular Holiday (2.00×)</option>
        <option value="special_non_working">Special Non-Working (1.30×)</option>
        <option value="special_working">Special Working (1.00×)</option>
      </select>
      <label><input type="checkbox" name="is_recurring" value="1" /> Recurring yearly</label>
      <button type="submit" class="ikb-btn ikb-btn-primary">Add Holiday</button>
    </form>
  </div>

  {ikb_entity_list source="holiday.this_year" view="table" limit="30" empty="No holidays configured." /}
</div>
{/block}
