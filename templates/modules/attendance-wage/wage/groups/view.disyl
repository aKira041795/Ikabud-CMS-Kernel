{extends "modules/attendance-wage/layouts/admin.disyl"}

{block main}
<div class="px-6 py-8">
<div class="max-w-6xl">
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex justify-between items-start mb-4">
        <div>
            <div class="flex items-center gap-3">
                <h2 class="font-semibold text-gray-900">{group.name}</h2>
                <span class="inline-flex px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700">{group.members|count} members</span>
            </div>
            {if group.description}<p class="text-sm text-gray-600 mt-1">{group.description}</p>{/if}
            {if group.pal_team_lead_email}<p class="text-xs text-gray-400 mt-1">🔗 PAL Bridge: {group.pal_team_lead_email}</p>{/if}
        </div>
        <div class="flex gap-2">
            <a href="/admin/wage/groups" class="px-3 py-1.5 bg-gray-200 text-gray-700 text-sm rounded-lg hover:bg-gray-300">← Back</a>
            <a href="/admin/wage/groups/{group.group_id}/edit" class="px-3 py-1.5 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">Edit</a>
            <button onclick="toggleGroup({group.group_id})" class="px-3 py-1.5 bg-red-100 text-red-700 text-sm rounded-lg hover:bg-red-200">{if group.is_active}Deactivate{else}Reactivate{/if}</button>
        </div>
    </div>

    <!-- Leader -->
    <div class="mb-4 p-3 bg-gray-50 rounded text-sm">
        <span class="text-gray-500">Team Leader:</span>
        <span class="font-medium">{group.leader_name|default:'—'}</span>
    </div>

    <!-- Members -->
    <h3 class="text-sm font-semibold text-gray-800 mb-2">Members</h3>
    <div class="overflow-x-auto mb-6">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 border-b">
                    <th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Name</th>
                    <th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Position</th>
                    <th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Department</th>
                    <th class="text-left py-2 px-3 font-semibold text-gray-600 text-xs">Employee #</th>
                    <th class="text-center py-2 px-3 font-semibold text-gray-600 text-xs">Status</th>
                </tr>
            </thead>
            <tbody>
                {for m in group.members}
                <tr class="border-b border-gray-100">
                    <td class="py-2 px-3">{m.name}</td>
                    <td class="py-2 px-3 text-xs text-gray-600">{m.position|default:'—'}</td>
                    <td class="py-2 px-3 text-xs text-gray-600">{m.department|default:'—'}</td>
                    <td class="py-2 px-3 text-xs text-gray-600">{m.employee_number|default:'—'}</td>
                    <td class="py-2 px-3 text-center">
                        <span class="inline-flex px-1.5 py-0.5 rounded-full text-xs font-medium {if m.is_active}bg-green-100 text-green-700{else}bg-red-100 text-red-700{/if}">{if m.is_active}Active{else}Inactive{/if}</span>
                    </td>
                </tr>
                {/for}
            </tbody>
        </table>
    </div>

    <!-- Salary Summary -->
    <h3 class="text-sm font-semibold text-gray-800 mb-2">Salary Estimate ({date_from} – {date_to})</h3>
    <div class="overflow-x-auto mb-4">
        <table class="w-full text-sm border-collapse">
            <thead>
                <tr class="bg-gray-100 text-xs">
                    <th class="text-left py-2 px-3">Employee</th>
                    <th class="text-center py-2 px-3">Type</th>
                    <th class="text-center py-2 px-3">Days</th>
                    <th class="text-right py-2 px-3">Hours</th>
                    <th class="text-right py-2 px-3">Estimated Pay</th>
                </tr>
            </thead>
            <tbody>
                {for pid, es in employee_summary}
                <tr class="border-b border-gray-200">
                    <td class="py-2 px-3 font-medium">{es.name}</td>
                    <td class="py-2 px-3 text-center text-xs">{es.salary_type}</td>
                    <td class="py-2 px-3 text-center">{es.days_worked}</td>
                    <td class="py-2 px-3 text-right">{es.total_hours|round:1}</td>
                    <td class="py-2 px-3 text-right font-semibold">₱{es.computed_salary|number_format:2}</td>
                </tr>
                {/for}
            </tbody>
        </table>
    </div>

    <!-- Attendance -->
    <h3 class="text-sm font-semibold text-gray-800 mb-3">Group Attendance</h3>
    <form method="GET" class="flex gap-3 items-end mb-4">
        <div>
            <label class="block text-xs text-gray-600 mb-1">From</label>
            <input type="date" name="date_from" value="{date_from}" class="px-2 py-1.5 border border-gray-300 rounded text-sm">
        </div>
        <div>
            <label class="block text-xs text-gray-600 mb-1">To</label>
            <input type="date" name="date_to" value="{date_to}" class="px-2 py-1.5 border border-gray-300 rounded text-sm">
        </div>
        <div>
            <button type="submit" class="px-3 py-1.5 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">Filter</button>
        </div>
    </form>

    {if attendance|count > 0}
    {set total_hours = 0}
    <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
            <thead>
                <tr class="bg-gray-800 text-white text-xs">
                    <th class="text-left py-2 px-3">Employee</th>
                    <th class="text-left py-2 px-3">Date</th>
                    <th class="text-center py-2 px-3">Clock In</th>
                    <th class="text-center py-2 px-3">Clock Out</th>
                    <th class="text-right py-2 px-3">Hours</th>
                    <th class="text-left py-2 px-3">Location In</th>
                    <th class="text-left py-2 px-3">Location Out</th>
                    <th class="text-center py-2 px-3">Status</th>
                </tr>
            </thead>
            <tbody>
                {for a in attendance}
                {set total_hours = total_hours + a.hours_worked}
                <tr class="border-b border-gray-200">
                    <td class="py-2 px-3 text-sm">{a.employee_name}<br><span class="text-xs text-gray-500">{a.position|default:''}{if a.salary_type} · {a.salary_type}{/if}</span></td>
                    <td class="py-2 px-3 text-xs">{a.clock_in}</td>
                    <td class="py-2 px-3 text-xs text-center">{a.clock_in}</td>
                    <td class="py-2 px-3 text-xs text-center">{if a.clock_out}{a.clock_out}{else}—{/if}</td>
                    <td class="py-2 px-3 text-xs text-right font-medium">{a.hours_worked|default:0}</td>
                    <td class="py-2 px-3 text-xs text-gray-600">{a.location_in|default:'—'}</td>
                    <td class="py-2 px-3 text-xs text-gray-600">{a.location_out|default:'—'}</td>
                    <td class="py-2 px-3 text-center">
                        <span class="inline-flex px-1.5 py-0.5 rounded-full text-xs font-medium {if a.status=='completed'}bg-green-100 text-green-700{elseif a.status=='active'}bg-yellow-100 text-yellow-700{else}bg-gray-100 text-gray-600{/if}">{a.status|default:'active'}</span>
                    </td>
                </tr>
                {/for}
            </tbody>
            <tfoot>
                <tr class="bg-gray-50 border-t-2 border-gray-300 font-semibold text-xs">
                    <td class="py-2 px-3" colspan="4">Total · {attendance|count} records</td>
                    <td class="py-2 px-3 text-right">{total_hours|round:2}</td>
                    <td class="py-2 px-3" colspan="3"></td>
                </tr>
            </tfoot>
        </table>
    </div>
    {else}
    <div class="p-6 text-center text-gray-600 text-sm">No attendance records found for this period.</div>
    {/if}
</div>
</div>
</div>
<script>
function toggleGroup(id) {
    if (!confirm('Toggle this group active/inactive?')) return;
    var csrf = document.querySelector('input[name=_csrf_token]');
    var fd = new FormData();
    if (csrf) fd.append('_csrf_token', csrf.value);
    fetch('/api/v1/wage/groups/' + id + '/toggle', { method: 'POST', body: fd })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.ok) { showToast('Group updated.', 'success'); setTimeout(function(){ location.reload(); }, 400); }
            else { showToast(d.error || 'Failed.', 'error'); }
        })
        .catch(function(){ showToast('Request failed.', 'error'); });
}
</script>
{/block}