<div class="max-w-6xl">
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <div class="flex justify-between items-center mb-4">
        <h2 class="font-semibold text-gray-900">Attendance Groups</h2>
        <a href="/admin/wage/groups/create" class="px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">+ New Group</a>
    </div>

    {if groups|count > 0}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {for g in groups}
        <div class="border border-gray-200 rounded-lg p-4 hover:border-blue-300 transition-colors">
            <div class="flex justify-between items-start mb-2">
                <a href="/admin/wage/groups/{g.group_id}" class="font-semibold text-gray-900 hover:text-blue-600">{g.name}</a>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700">{g.member_count} members</span>
            </div>
            {if g.leader_name}
            <p class="text-sm text-gray-600">Leader: <span class="font-medium">{g.leader_name}</span></p>
            {/if}
            {if g.leader_position}
            <p class="text-xs text-gray-500">{g.leader_position}</p>
            {/if}
            {if g.pal_team_lead_email}
            <p class="text-xs text-gray-400 mt-1">🔗 PAL: {g.pal_team_lead_email}</p>
            {/if}
        </div>
        {/for}
    </div>
    {else}
    <div class="p-6 text-center text-gray-600 text-sm">
        No attendance groups yet. Create one to group employees under a team lead.
    </div>
    {/if}
</div>
</div>