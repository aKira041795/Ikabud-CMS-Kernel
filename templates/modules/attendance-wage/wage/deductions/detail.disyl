{extends "modules/attendance-wage/layouts/admin.disyl"}
{block main}
<div class="px-6 py-8">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">📉 Deductions — {employee_name|default:''}</h1>
            <p class="text-sm text-gray-500 mt-1">Total Deductions: <strong class="text-gray-900">₱{total_deductions|default:'0.00'}</strong></p>
        </div>
        <a href="/admin/wage/deductions" class="inline-flex items-center px-4 py-2.5 text-sm font-semibold rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 transition-colors">← Back to Deductions</a>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 border-b border-gray-200">
                    <th class="text-left px-4 py-3 font-semibold text-gray-600">Type</th>
                    <th class="text-left px-4 py-3 font-semibold text-gray-600">Description</th>
                    <th class="text-right px-4 py-3 font-semibold text-gray-600">Amount</th>
                    <th class="text-center px-4 py-3 font-semibold text-gray-600">Status</th>
                    <th class="text-right px-4 py-3 font-semibold text-gray-600">Date</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {for deduction in deductions}
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-4 py-3">
                        {if deduction.type == 'manual'}
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700">📝 Manual</span>
                        {elseif deduction.type == 'cash_advance'}
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-700">💳 Cash Advance</span>
                        {elseif deduction.type == 'sss'}
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">🏛️ SSS</span>
                        {elseif deduction.type == 'philhealth'}
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700">🏥 PhilHealth</span>
                        {elseif deduction.type == 'pagibig'}
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-700">🏠 Pag-IBIG</span>
                        {/if}
                    </td>
                    <td class="px-4 py-3 text-gray-700">{deduction.description|default:''}</td>
                    <td class="px-4 py-3 text-right font-medium text-gray-900">₱{deduction.amount_fmt|default:'0.00'}</td>
                    <td class="px-4 py-3 text-center">
                        {if deduction.status == 'computed'}
                        <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full bg-amber-100 text-amber-700">Computed</span>
                        {elseif deduction.status == 'approved'}
                        <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 text-green-700">Approved</span>
                        {elseif deduction.status == 'paid'}
                        <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full bg-blue-100 text-blue-700">Paid</span>
                        {elseif deduction.status == 'completed'}
                        <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 text-green-700">Completed</span>
                        {elseif deduction.status == 'pending'}
                        <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full bg-amber-100 text-amber-700">Pending</span>
                        {elseif deduction.status == 'cancelled'}
                        <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full bg-red-100 text-red-700">Cancelled</span>
                        {else}
                        <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-gray-600">{deduction.status|default:''}</span>
                        {/if}
                    </td>
                    <td class="px-4 py-3 text-right text-gray-500">{deduction.date|default:''}</td>
                </tr>
                {forelse}
                <tr>
                    <td colspan="5" class="px-4 py-8 text-center text-gray-400">No deductions found for this employee.</td>
                </tr>
                {/for}
            </tbody>
        </table>
    </div>
</div>
{/block}
