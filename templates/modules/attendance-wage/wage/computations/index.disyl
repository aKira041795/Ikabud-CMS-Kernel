{extends "modules/attendance-wage/layouts/admin.disyl"}
{block main}
<div class="px-6 py-8">
    <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">💵 Salary Computations</h1>
        <form method="post" action="/api/v1/wage/compute/bulk" class="inline"><button type="submit" class="px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm">Bulk Compute</button></form>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        {ikb_entity_list source="salary_computation.recent" view="table" limit="25" empty="No salary computations yet." /}
    </div>
</div>
{/block}
