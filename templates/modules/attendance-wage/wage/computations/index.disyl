{extends "modules/attendance-wage/layouts/admin.disyl"}

{macro compCard(label, valueText, valueColor = "gray")}
<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">{label}</p>
    <p class="mt-1 text-lg font-extrabold text-{valueColor}-600">{valueText}</p>
</div>
{/macro}

{block main}
<div class="px-6 py-8">
    <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">💵 Salary Computations</h1>
        <a href="/admin/wage/periods" class="inline-flex items-center px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm">← Prepare Payroll</a>
    </div>
    {if selectedPeriodId > 0}
    <!-- Computations for selected period -->
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-8">
        {call compCard("Gross Pay", "₱ {total_gross|default:'0.00'}")}
        {call compCard("+ Additions", "₱ {total_additions|default:'0.00'}", "green")}
        {call compCard("Deductions", "₱ {total_deductions|default:'0.00'}", "red")}
        {call compCard("Adj. Deduct", "₱ {total_adj_deductions|default:'0.00'}", "orange")}
        {call compCard("Net Pay", "₱ {total_net|default:'0.00'}", "green")}
    </div>
    <div class="flex items-center gap-3 mb-6">
        <a href="/admin/wage/computations" class="text-sm text-brand-600 hover:text-brand-700 font-medium">← All periods</a>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        {if period_status || period_pay_date}
        <div class="px-5 py-3 border-b border-gray-100 bg-gray-50/50 flex items-center justify-between flex-wrap gap-2">
            <div class="flex items-center gap-4 text-sm">
                <span class="text-gray-500">Period Status: <span class="font-semibold capitalize {match period_status}{when 'processing'}text-blue-600{/when}{when 'approved'}text-green-600{/when}{when 'completed'}text-green-700{/when}{else}text-gray-600{/match}">{period_status|default:'draft'}</span></span>
                {if period_pay_date}
                <span class="text-gray-400">|</span>
                <span class="text-gray-500">Pay Date: <span class="font-semibold text-gray-700">{period_pay_date}</span></span>
                {if today < period_pay_date}
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700">⏳ Payday not yet reached</span>
                {else}
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-green-50 text-green-700">✅ Payday reached</span>
                {/if}
                {/if}
            </div>
            <div class="flex items-center gap-2">
                {if can_approve}
                <form method="POST" action="/api/v1/wage/computations/batch/approve" class="inline">
                    <input type="hidden" name="_token" value="{csrf_token}">
                    <input type="hidden" name="period_id" value="{selectedPeriodId}">
                    <button type="submit" class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-lg bg-green-600 hover:bg-green-700 text-white transition-colors shadow-sm">✅ Approve All</button>
                </form>
                {else if period_status && period_pay_date && today < period_pay_date}
                <span class="text-xs text-gray-400 italic">Approve available after {period_pay_date}</span>
                {/if}
                {if can_pay}
                <form method="POST" action="/api/v1/wage/computations/batch/pay" class="inline">
                    <input type="hidden" name="_token" value="{csrf_token}">
                    <input type="hidden" name="period_id" value="{selectedPeriodId}">
                    <button type="submit" class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-lg bg-blue-600 hover:bg-blue-700 text-white transition-colors shadow-sm">💰 Mark All Paid</button>
                </form>
                {/if}
                <form method="POST" action="/api/v1/wage/compute/bulk" class="inline" onsubmit="return confirm(&quot;Recompute all employees for this period? This will update hours from attendance records.&quot;)">
                    <input type="hidden" name="_token" value="{csrf_token}">
                    <input type="hidden" name="period_id" value="{selectedPeriodId}">
                    <button type="submit" class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-lg bg-amber-600 hover:bg-amber-700 text-white transition-colors shadow-sm">🧮 Bulk Compute All</button>
                </form>
            </div>
        </div>
        {/if}
        {ikb_entity_list source="salary_computation" view="table" use="tailwind" limit="50"
            empty="No computations for this period."
            auth-role="{current_user_role}" /}
    </div>
    {else}
    <!-- Period list via entity view -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        {ikb_entity_list source="payroll_period" view="table" use="tailwind" limit="15"
            empty="No payroll periods yet. <a href='/admin/wage/periods' class='text-brand-600 hover:text-brand-700 font-medium'>Go to Prepare Payroll →</a>"
            auth-role="{current_user_role}" /}
    </div>
    {/if}
</div>
{/block}
