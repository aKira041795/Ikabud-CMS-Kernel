{* Salary Computations — Entity List *}
{extends "layouts/admin.disyl"}

{block main}
<div class="admin-shell">
  <div class="ikb-toolbar">
    <h1>💵 Salary Computations</h1>
    <form method="post" action="/api/v1/wage/compute/bulk" class="ikb-inline-form" onsubmit="return confirm('Compute salaries for all employees in this period?')">
      {csrf_field /}
      <button type="submit" class="ikb-btn ikb-btn-primary">Bulk Compute</button>
    </form>
  </div>

  {ikb_entity_list source="salary_computation.recent" view="table" limit="25" empty="No salary computations yet. Click 'Bulk Compute' to process payroll for the active period." /}
</div>
{/block}
