{block main}
<div class="px-6 py-8">
    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-8">📄 Payroll Reports</h1>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
