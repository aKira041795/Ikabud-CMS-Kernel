{extends "modules/attendance-wage/layouts/admin.disyl"}
{block main}
<style>
@media print {
    body > aside, body > .fixed, nav, .no-print { display: none !important; }
    .flex-1.ml-64, [class*="ml-64"] { margin-left: 0 !important; }
    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .bg-brand-950, .bg-brand-800, .bg-brand-600, .bg-green-50, .bg-green-500, .bg-blue-50, .bg-blue-500, .bg-red-50, .bg-amber-50, .bg-gray-50 { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
}
</style>
<div class="px-6 py-8">
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">📄 {period.period_name|default:'Payroll Report'}</h1>
            {if period}
            <p class="text-sm text-gray-500 mt-1">{period.start_date|default:'—'} → {period.end_date|default:'—'} &middot; Pay date: {period.pay_date|default:'—'}</p>
            {/if}
        </div>
        <div class="flex items-center gap-3 no-print">
            {if period.status}
            <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold capitalize {if period.status=='completed' || period.status=='approved'}bg-green-100 text-green-700{else if period.status=='paid'}bg-blue-100 text-blue-700{else if period.status=='draft'}bg-amber-100 text-amber-700{else}bg-gray-100 text-gray-600{/if}">
                <span class="w-1.5 h-1.5 rounded-full {if period.status=='completed' || period.status=='approved'}bg-green-500{else if period.status=='paid'}bg-blue-500{else if period.status=='draft'}bg-amber-500{else}bg-gray-400{/if} mr-1.5"></span> {period.status}
            </span>
            {/if}
            <button onclick="window.print()" class="inline-flex items-center gap-2 px-4 py-2 border border-gray-300 text-gray-700 text-sm font-semibold rounded-lg hover:bg-gray-50 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                Print
            </button>
            <a href="/api/v1/wage/reports/{period.period_id}/export?format=csv" class="inline-flex items-center gap-2 px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Export CSV
            </a>
            <a href="/admin/wage/reports" class="inline-flex items-center px-4 py-2.5 text-sm font-semibold rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 transition-colors">← Back</a>
        </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-8">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Employees</p>
            <p class="mt-1 text-xl font-extrabold text-gray-900">{total_employees|default:0}</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Gross Pay</p>
            <p class="mt-1 text-lg font-extrabold text-gray-900">₱ {total_gross|default:'0.00'}</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">+ Additions</p>
            <p class="mt-1 text-lg font-extrabold text-green-600">₱ {total_additions|default:'0.00'}</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Deductions</p>
            <p class="mt-1 text-lg font-extrabold text-red-600">₱ {total_deductions|default:'0.00'}</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Adj. Deduct</p>
            <p class="mt-1 text-lg font-extrabold text-orange-600">₱ {total_adj_deductions|default:'0.00'}</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Net Pay</p>
            <p class="mt-1 text-lg font-extrabold text-green-600">₱ {total_net|default:'0.00'}</p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
            <h2 class="text-lg font-bold text-gray-900">Employee Breakdown</h2>
            <span class="text-xs text-gray-400">{computations|count|default:0} entries</span>
        </div>
        {if computations|count > 0}
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-200">
                        <th class="py-3 px-5 text-left font-semibold text-gray-600 whitespace-nowrap">Employee</th>
                        <th class="py-3 px-5 text-left font-semibold text-gray-600 whitespace-nowrap">Position</th>
                        <th class="py-3 px-5 text-left font-semibold text-gray-600 whitespace-nowrap">Type</th>
                        <th class="py-3 px-5 text-right font-semibold text-gray-600 whitespace-nowrap">Gross</th>
                        <th class="py-3 px-5 text-right font-semibold text-gray-600 whitespace-nowrap">+ Additions</th>
                        <th class="py-3 px-5 text-right font-semibold text-gray-600 whitespace-nowrap">Deductions</th>
                        <th class="py-3 px-5 text-right font-semibold text-gray-600 whitespace-nowrap">Net Pay</th>
                        <th class="py-3 px-5 text-center font-semibold text-gray-600 whitespace-nowrap">Status</th>
                    </tr>
                </thead>
                <tbody>
                    {for c in computations}
                    <tr class="border-b last:border-b-0 border-gray-100 hover:bg-gray-50/50 transition-colors">
                        <td class="py-3 px-5 font-medium text-gray-900 whitespace-nowrap">{c.employee_name|default:'—'}</td>
                        <td class="py-3 px-5 text-gray-600 whitespace-nowrap text-xs">{c.position|default:'—'}</td>
                        <td class="py-3 px-5 whitespace-nowrap">
                            <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium capitalize bg-gray-100 text-gray-600">{c.salary_type|default:'—'}</span>
                        </td>
                        <td class="py-3 px-5 text-right text-gray-900 font-medium whitespace-nowrap">₱ {c.gross_pay|number_format:2|default:'0.00'}</td>
                        <td class="py-3 px-5 text-right whitespace-nowrap">
                            {if c.total_additions > 0}
                            <span class="text-green-600 font-medium">₱ {c.total_additions|number_format:2}</span>
                            {else}
                            <span class="text-gray-300">—</span>
                            {/if}
                        </td>
                        <td class="py-3 px-5 text-right text-red-600 whitespace-nowrap">₱ {c.total_deductions|number_format:2|default:'0.00'}</td>
                        <td class="py-3 px-5 text-right text-green-700 font-semibold whitespace-nowrap">₱ {c.net_pay|number_format:2|default:'0.00'}</td>
                        <td class="py-3 px-5 text-center whitespace-nowrap">
                            {if c.status == 'approved'}
                            <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700 capitalize">{c.status}</span>
                            {else if c.status == 'paid'}
                            <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-700 capitalize">{c.status}</span>
                            {else}
                            <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700 capitalize">{c.status|default:'computed'}</span>
                            {/if}
                        </td>
                    </tr>
                    {/for}
                </tbody>
            </table>
        </div>
        {else}
        <div class="py-16 text-center">
            <p class="text-4xl mb-3">📋</p>
            <p class="text-gray-500 font-medium">No salary computations for this period.</p>
            <p class="text-sm text-gray-400 mt-1">Click "Prepare Payroll" from the dashboard first.</p>
        </div>
        {/if}
    </div>


</div>
{/block}
