{* Employee Profile Form *}
{extends "layouts/admin.disyl"}

{block main}
<div class="admin-shell">
  <h1>{if id}Edit Employee{else}New Employee{/if}</h1>

  <form method="post" action="/api/v1/wage/employees{if id}/{id}{/if}" class="ikb-form">
    {csrf_field /}

    <fieldset class="ikb-fieldset">
      <legend>Basic Information</legend>
      <div class="ikb-grid ikb-grid-2col">
        <div class="ikb-field">
          <label for="user_id">User</label>
          <select name="user_id" id="user_id" required>
            <option value="">Select user...</option>
          </select>
        </div>
        <div class="ikb-field">
          <label for="employee_number">Employee Number</label>
          <input type="text" name="employee_number" id="employee_number" value="{employee_number|default:''}" maxlength="20" />
        </div>
        <div class="ikb-field">
          <label for="position">Position</label>
          <input type="text" name="position" id="position" value="{position|default:''}" required />
        </div>
        <div class="ikb-field">
          <label for="department">Department</label>
          <input type="text" name="department" id="department" value="{department|default:''}" />
        </div>
        <div class="ikb-field">
          <label for="hire_date">Hire Date</label>
          <input type="date" name="hire_date" id="hire_date" value="{hire_date|default:''}" required />
        </div>
        <div class="ikb-field">
          <label for="employment_status">Status</label>
          <select name="employment_status" id="employment_status" required>
            <option value="probationary"{if employment_status=='probationary'} selected{/if}>Probationary</option>
            <option value="regular"{if employment_status=='regular'} selected{/if}>Regular</option>
            <option value="contractual"{if employment_status=='contractual'} selected{/if}>Contractual</option>
            <option value="part_time"{if employment_status=='part_time'} selected{/if}>Part-Time</option>
          </select>
        </div>
      </div>
    </fieldset>

    <fieldset class="ikb-fieldset">
      <legend>💰 Salary Settings</legend>
      <div class="ikb-grid ikb-grid-3col">
        <div class="ikb-field">
          <label for="salary_type">Salary Type</label>
          <select name="salary_type" id="salary_type" required>
            <option value="hourly"{if salary_type=='hourly'} selected{/if}>Hourly</option>
            <option value="daily"{if salary_type=='daily'} selected{/if}>Daily</option>
            <option value="monthly"{if salary_type=='monthly'} selected{/if}>Monthly</option>
            <option value="fixed"{if salary_type=='fixed'} selected{/if}>Fixed</option>
          </select>
        </div>
        <div class="ikb-field">
          <label for="basic_salary">Basic Salary (₱)</label>
          <input type="number" step="0.01" name="basic_salary" id="basic_salary" value="{basic_salary|default:'0.00'}" required />
        </div>
        <div class="ikb-field">
          <label for="hourly_rate">Hourly Rate (₱)</label>
          <input type="number" step="0.01" name="hourly_rate" id="hourly_rate" value="{hourly_rate|default:'0.00'}" />
        </div>
      </div>
    </fieldset>

    <fieldset class="ikb-fieldset">
      <legend>⏰ Overtime Policy</legend>
      <div class="ikb-grid ikb-grid-4col">
        <div class="ikb-field ikb-field-check">
          <label><input type="checkbox" name="overtime_allowed" value="1"{if overtime_allowed|default:1} checked{/if} /> Overtime Allowed</label>
        </div>
        <div class="ikb-field">
          <label for="overtime_rate">OT Rate (×)</label>
          <input type="number" step="0.01" name="overtime_rate" id="overtime_rate" value="{overtime_rate|default:'1.25'}" />
        </div>
        <div class="ikb-field">
          <label for="max_daily_hours">Max Daily Hours</label>
          <input type="number" step="0.01" name="max_daily_hours" id="max_daily_hours" value="{max_daily_hours|default:'8.00'}" />
        </div>
        <div class="ikb-field">
          <label for="max_weekly_hours">Max Weekly Hours</label>
          <input type="number" step="0.01" name="max_weekly_hours" id="max_weekly_hours" value="{max_weekly_hours|default:'40.00'}" />
        </div>
      </div>
    </fieldset>

    <fieldset class="ikb-fieldset">
      <legend>🔘 Premium Toggles</legend>
      <div class="ikb-grid ikb-grid-4col">
        <div class="ikb-field ikb-field-check"><label><input type="checkbox" name="holiday_pay_enabled" value="1"{if holiday_pay_enabled|default:1} checked{/if} /> Holiday Pay</label></div>
        <div class="ikb-field ikb-field-check"><label><input type="checkbox" name="rest_day_pay_enabled" value="1"{if rest_day_pay_enabled|default:1} checked{/if} /> Rest Day Premium</label></div>
        <div class="ikb-field ikb-field-check"><label><input type="checkbox" name="night_diff_enabled" value="1"{if night_diff_enabled|default:1} checked{/if} /> Night Differential</label></div>
        <div class="ikb-field ikb-field-check"><label><input type="checkbox" name="cash_advance_allowed" value="1"{if cash_advance_allowed|default:1} checked{/if} /> Cash Advances</label></div>
      </div>
    </fieldset>

    <fieldset class="ikb-fieldset">
      <legend>📋 Government IDs & Benefits</legend>
      <div class="ikb-grid ikb-grid-3col">
        <div class="ikb-field">
          <label for="sss_number">SSS Number</label>
          <input type="text" name="sss_number" id="sss_number" value="{sss_number|default:''}" maxlength="20" />
          <label><input type="checkbox" name="sss_applicable" value="1"{if sss_applicable|default:1} checked{/if} /> Applicable</label>
        </div>
        <div class="ikb-field">
          <label for="philhealth_number">PhilHealth Number</label>
          <input type="text" name="philhealth_number" id="philhealth_number" value="{philhealth_number|default:''}" maxlength="20" />
          <label><input type="checkbox" name="philhealth_applicable" value="1"{if philhealth_applicable|default:1} checked{/if} /> Applicable</label>
        </div>
        <div class="ikb-field">
          <label for="pagibig_number">Pag-IBIG Number</label>
          <input type="text" name="pagibig_number" id="pagibig_number" value="{pagibig_number|default:''}" maxlength="20" />
          <label><input type="checkbox" name="pagibig_applicable" value="1"{if pagibig_applicable|default:1} checked{/if} /> Applicable</label>
        </div>
      </div>
      <div class="ikb-grid ikb-grid-2col">
        <div class="ikb-field">
          <label for="tin_number">TIN Number</label>
          <input type="text" name="tin_number" id="tin_number" value="{tin_number|default:''}" maxlength="20" />
        </div>
        <div class="ikb-field">
          <label for="tax_exemption_status">Tax Status</label>
          <select name="tax_exemption_status" id="tax_exemption_status">
            <option value="single"{if tax_exemption_status=='single'} selected{/if}>Single</option>
            <option value="married"{if tax_exemption_status=='married'} selected{/if}>Married</option>
            <option value="head_of_family"{if tax_exemption_status=='head_of_family'} selected{/if}>Head of Family</option>
          </select>
        </div>
      </div>
    </fieldset>

    <div class="ikb-form-actions">
      <button type="submit" class="ikb-btn ikb-btn-primary">Save Employee</button>
      <a href="/admin/wage/employees" class="ikb-btn ikb-btn-ghost">Cancel</a>
    </div>
  </form>
</div>
{/block}
