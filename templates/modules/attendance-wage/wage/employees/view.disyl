{extends "modules/attendance-wage/layouts/admin.disyl"}
{block main}
{!-- Expose available entity fields as JSON for frontend metadata features --}
<div data-ikb-entity-fields="{keyof employee_profile.table}"
     data-ikb-entity-fields-detailed="{keyof employee_profile.detailed}"
     class="print-hidden" aria-hidden="true"></div>
<style>
@media print {
    aside, .app-header, .app-shell, .app-nav, .app-footer, .print-hidden { display: none !important; }
    .flex-1.ml-64, [class*="ml-64"] { margin-left: 0 !important; }
    body { background: white !important; }
    .max-w-4xl { max-width: 100% !important; padding: 0 !important; margin: 0 auto !important; }
    .shadow-sm { box-shadow: none !important; }
    .border { border-color: #ddd !important; }
    .bg-white { background: white !important; }
    .rounded-xl { border-radius: 0 !important; }
    .px-6 { padding-left: 0 !important; padding-right: 0 !important; }
    .py-8 { padding-top: 0 !important; padding-bottom: 0 !important; }
}
</style>
<div class="px-6 py-8 max-w-4xl mx-auto">
    {if error}
    <div class="mb-6 px-5 py-4 bg-red-50 border border-red-200 rounded-xl text-sm font-medium text-red-700 flex items-center gap-3">
        <span class="text-lg">❌</span> {error}
    </div>
    {/if}
    {if !error}
    <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-4">
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">👤 {first_name|default:''} {last_name|default:''}</h1>
            {if employment_status}
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold {if employment_status=='regular'}bg-green-100 text-green-700{elseif employment_status=='probationary'}bg-amber-100 text-amber-700{elseif employment_status=='contractual'}bg-blue-100 text-blue-700{else}bg-gray-100 text-gray-600{/if}">{employment_status_label|default:'—'}</span>
            {/if}
        </div>
        <div class="flex items-center gap-3 print-hidden">
            <a href="/admin/wage/employees" class="inline-flex items-center px-4 py-2.5 text-sm font-semibold rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 transition-colors">← Back to Employees</a>
            <a href="/admin/wage/employees/{id}" class="inline-flex items-center px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm">✏️ Edit</a>
            <button onclick="window.print()" class="inline-flex items-center px-4 py-2.5 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold rounded-lg transition-colors shadow-sm">🖨️ Print</button>
        </div>
    </div>

    <!-- Photo + Quick Info -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
        <div class="flex items-start gap-6">
            {if photo_url}
            <img src="{photo_url}" alt="Employee photo" class="w-36 h-36 rounded-xl object-cover border border-gray-200 shadow-sm">
            {else}
            <div class="w-36 h-36 rounded-xl bg-gradient-to-br from-brand-100 to-brand-50 border-2 border-dashed border-gray-300 flex items-center justify-center text-gray-400 text-5xl font-bold">{first_name|default:'?'|first|upper}</div>
            {/if}
            <div class="flex-1 grid grid-cols-2 md:grid-cols-3 gap-x-8 gap-y-3">
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Employee #</p>
                    <p class="text-sm font-medium text-gray-900">{employee_number|default:'—'}</p>
                </div>
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Position</p>
                    <p class="text-sm font-medium text-gray-900">{position|default:'—'}</p>
                </div>
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Department</p>
                    <p class="text-sm font-medium text-gray-900">{department|default:'—'}</p>
                </div>
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Salary Type</p>
                    <p class="text-sm font-medium text-gray-900">{salary_type_label|default:'—'}</p>
                </div>
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Hire Date</p>
                    <p class="text-sm font-medium text-gray-900">{hire_date|default:'—'}</p>
                </div>
                <div>
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</p>
                    <p class="text-sm font-medium text-gray-900">{employment_status_label|default:'—'}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Compensation Details -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h2 class="text-lg font-bold text-gray-900 mb-5 pb-3 border-b border-gray-100">💰 Compensation</h2>
            <dl class="space-y-3">
                <div class="flex justify-between">
                    <dt class="text-sm text-gray-500">Basic Salary</dt>
                    <dd class="text-sm font-semibold text-gray-900">{if basic_salary}₱{basic_salary|number_format:2}{else}—{/if}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-sm text-gray-500">Hourly Rate</dt>
                    <dd class="text-sm font-semibold text-gray-900">{if hourly_rate}₱{hourly_rate|number_format:2}{else}—{/if}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-sm text-gray-500">Daily Rate</dt>
                    <dd class="text-sm font-semibold text-gray-900">{if daily_rate}₱{daily_rate|number_format:2}{else}—{/if}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-sm text-gray-500">Monthly Rate</dt>
                    <dd class="text-sm font-semibold text-gray-900">{if monthly_rate}₱{monthly_rate|number_format:2}{else}—{/if}</dd>
                </div>
            </dl>
            <h3 class="text-sm font-bold text-gray-700 mt-5 mb-3">⏱ Overtime & Premiums</h3>
            <dl class="space-y-3">
                <div class="flex justify-between">
                    <dt class="text-sm text-gray-500">Overtime Allowed</dt>
                    <dd class="text-sm font-semibold">{if overtime_allowed}<span class="text-green-600">Yes</span>{else}<span class="text-gray-400">No</span>{/if}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-sm text-gray-500">Overtime Rate</dt>
                    <dd class="text-sm font-semibold text-gray-900">{if overtime_rate}{overtime_rate}{else}—{/if}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-sm text-gray-500">Max Daily Hours</dt>
                    <dd class="text-sm font-semibold text-gray-900">{if max_daily_hours}{max_daily_hours}h{else}—{/if}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-sm text-gray-500">Max Weekly Hours</dt>
                    <dd class="text-sm font-semibold text-gray-900">{if max_weekly_hours}{max_weekly_hours}h{else}—{/if}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-sm text-gray-500">Holiday Pay</dt>
                    <dd class="text-sm font-semibold">{if holiday_pay_enabled}<span class="text-green-600">Enabled</span>{else}<span class="text-gray-400">Disabled</span>{/if}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-sm text-gray-500">Night Differential</dt>
                    <dd class="text-sm font-semibold">{if night_diff_enabled}<span class="text-green-600">Enabled</span>{else}<span class="text-gray-400">Disabled</span>{/if}</dd>
                </div>
            </dl>
        </div>

        <!-- Government Numbers -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <h2 class="text-lg font-bold text-gray-900 mb-5 pb-3 border-b border-gray-100">🪪 Government Numbers</h2>
            <dl class="space-y-3">
                <div class="flex justify-between">
                    <dt class="text-sm text-gray-500">SSS</dt>
                    <dd class="text-sm font-semibold text-gray-900">{sss_number|default:'—'}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-sm text-gray-500">PhilHealth</dt>
                    <dd class="text-sm font-semibold text-gray-900">{philhealth_number|default:'—'}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-sm text-gray-500">Pag-IBIG</dt>
                    <dd class="text-sm font-semibold text-gray-900">{pagibig_number|default:'—'}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-sm text-gray-500">TIN</dt>
                    <dd class="text-sm font-semibold text-gray-900">{tin_number|default:'—'}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-sm text-gray-500">Tax Status</dt>
                    <dd class="text-sm font-semibold text-gray-900">{tax_status_label|default:'—'}</dd>
                </div>
                <div class="flex justify-between">
                    <dt class="text-sm text-gray-500">Dependents</dt>
                    <dd class="text-sm font-semibold text-gray-900">{dependents_count|default:'0'}</dd>
                </div>
            </dl>
        </div>
    </div>

    <!-- Footer actions -->
    <div class="mt-6 flex items-center gap-3 justify-end print-hidden">
        <a href="/admin/wage/employees" class="inline-flex items-center px-4 py-2.5 text-sm font-semibold rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 transition-colors">← Back to List</a>
        <a href="/admin/wage/employees/{id}" class="inline-flex items-center px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm">✏️ Edit Employee</a>
    </div>
    {/if}
</div>
{/block}
