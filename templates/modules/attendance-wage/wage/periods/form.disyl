{extends "modules/attendance-wage/layouts/admin.disyl"}
{block main}
<div class="px-6 py-8">
    <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">📅 {form_title}</h1>
        <a href="/admin/wage/periods" class="inline-flex items-center px-4 py-2.5 text-sm font-semibold rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 transition-colors">← Back to Periods</a>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-5 pb-3 border-b border-gray-100">📋 {if is_create}New bounded period{else}{period_name|default:'Period'}{/if}</h2>
        <form method="post" action="{form_action}" class="space-y-6">
            <input type="hidden" name="_token" value="{csrf_token}">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label for="period_name" class="block text-sm font-semibold text-gray-700 mb-1.5">Period Name</label>
                    <input type="text" id="period_name" name="period_name" value="{period_name|default:''}" required class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                </div>
                <div>
                    <label for="period_type" class="block text-sm font-semibold text-gray-700 mb-1.5">Frequency</label>
                    <select id="period_type" name="period_type" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 bg-white">
                        <option value="semi_monthly"{if period_type=='semi_monthly'} selected{/if}>Semi-Monthly</option>
                        <option value="bi_weekly"{if period_type=='bi_weekly'} selected{/if}>Bi-Weekly</option>
                        <option value="monthly"{if period_type=='monthly'} selected{/if}>Monthly</option>
                        <option value="weekly"{if period_type=='weekly'} selected{/if}>Weekly</option>
                    </select>
                </div>
                <div>
                    <label for="start_date" class="block text-sm font-semibold text-gray-700 mb-1.5">Start Date</label>
                    <input type="date" id="start_date" name="start_date" value="{start_date|default:''}" required class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                </div>
                <div>
                    <label for="end_date" class="block text-sm font-semibold text-gray-700 mb-1.5">End Date</label>
                    <input type="date" id="end_date" name="end_date" value="{end_date|default:''}" required class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                </div>
                <div>
                    <label for="pay_date" class="block text-sm font-semibold text-gray-700 mb-1.5">Pay Date</label>
                    <input type="date" id="pay_date" name="pay_date" value="{pay_date|default:''}" required class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                </div>
                <div>
                    <label for="cutoff_date" class="block text-sm font-semibold text-gray-700 mb-1.5">Cut-off Date</label>
                    <input type="date" id="cutoff_date" name="cutoff_date" value="{cutoff_date|default:''}" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                    <p class="text-xs text-gray-400 mt-1">Last day to submit adjustments.</p>
                </div>
            </div>
            <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
                <button type="submit" class="inline-flex items-center px-5 py-3 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm">{form_button}</button>
                <a href="/admin/wage/periods" class="px-5 py-3 text-sm font-semibold text-gray-600 hover:text-gray-800 transition-colors">Cancel</a>
            </div>
        </form>
    </div>
</div>
{/block}
