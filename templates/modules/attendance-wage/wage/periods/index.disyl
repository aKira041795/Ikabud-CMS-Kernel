{extends "modules/attendance-wage/layouts/admin.disyl"}
{block main}
<div class="px-6 py-8">
    <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">💵 Prepare Payroll</h1>

    </div>
    {if success}
    <div class="mb-6 px-5 py-4 bg-green-50 border border-green-200 rounded-xl text-sm font-medium text-green-700 flex items-center gap-3">
        <span class="text-lg">✅</span> {success}
    </div>
    {/if}
    {if error}
    <div class="mb-6 px-5 py-4 bg-red-50 border border-red-200 rounded-xl text-sm font-medium text-red-700 flex items-center gap-3">
        <span class="text-lg">❌</span> {error}
    </div>
    {/if}

    {if pending_adjustments.count > 0}
    <div class="mb-6 px-5 py-4 bg-amber-50 border border-amber-200 rounded-xl text-sm flex items-center justify-between flex-wrap gap-3">
        <div class="flex items-center gap-3">
            <span class="text-lg">🔧</span>
            <div>
                <span class="font-semibold text-amber-800">{pending_adjustments.count|default:0} pending adjustment(s)</span>
                <span class="text-amber-600 ml-2">
                    {if pending_adjustments.additions > 0}+₱ {pending_adjustments.additions|number_format:2} additions{/if}
                    {if pending_adjustments.additions > 0 && pending_adjustments.deductions > 0} &middot; {/if}
                    {if pending_adjustments.deductions > 0}₱ {pending_adjustments.deductions|number_format:2} deductions{/if}
                </span>
            </div>
        </div>
        <a href="/admin/wage/adjustments" class="inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-lg bg-amber-100 text-amber-700 hover:bg-amber-200 transition-colors">Review Adjustments →</a>
    </div>
    {/if}

    <!-- Quick Actions: Prepare Payroll by Salary Type -->
    <div class="mb-8">
        <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Quick Prepare — Select Salary Type</h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <!-- Monthly -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-2xl font-extrabold text-brand-600">{stats.monthly|default:0}</span>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-brand-50 text-brand-700">Monthly</span>
                </div>
                <p class="text-xs text-gray-400 mb-4">employees paid monthly</p>
                <form method="post" action="/api/v1/wage/compute/bulk" onsubmit="return confirm('Create payroll for {stats.monthly|default:0} monthly employees?')">
                    <input type="hidden" name="_token" value="{csrf_token}">
                    <input type="hidden" name="salary_type" value="monthly">
                    <button type="submit" class="w-full py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg transition-colors">Prepare Payroll</button>
                </form>
            </div>
            <!-- Daily -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-2xl font-extrabold text-emerald-600">{stats.daily|default:0}</span>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700">Daily</span>
                </div>
                <p class="text-xs text-gray-400 mb-4">employees paid daily</p>
                <form method="post" action="/api/v1/wage/compute/bulk" onsubmit="return confirm('Create payroll for {stats.daily|default:0} daily employees?')">
                    <input type="hidden" name="_token" value="{csrf_token}">
                    <input type="hidden" name="salary_type" value="daily">
                    <button type="submit" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-lg transition-colors">Prepare Payroll</button>
                </form>
            </div>
            <!-- Hourly -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-2xl font-extrabold text-amber-600">{stats.hourly|default:0}</span>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700">Hourly</span>
                </div>
                <p class="text-xs text-gray-400 mb-4">employees paid hourly</p>
                <form method="post" action="/api/v1/wage/compute/bulk" onsubmit="return confirm('Create payroll for {stats.hourly|default:0} hourly employees?')">
                    <input type="hidden" name="_token" value="{csrf_token}">
                    <input type="hidden" name="salary_type" value="hourly">
                    <button type="submit" class="w-full py-2.5 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold rounded-lg transition-colors">Prepare Payroll</button>
                </form>
            </div>
            <!-- Fixed -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-2xl font-extrabold text-purple-600">{stats.fixed|default:0}</span>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-50 text-purple-700">Fixed</span>
                </div>
                <p class="text-xs text-gray-400 mb-4">employees on fixed rate</p>
                <form method="post" action="/api/v1/wage/compute/bulk" onsubmit="return confirm('Create payroll for {stats.fixed|default:0} fixed-rate employees?')">
                    <input type="hidden" name="_token" value="{csrf_token}">
                    <input type="hidden" name="salary_type" value="fixed">
                    <button type="submit" class="w-full py-2.5 bg-purple-600 hover:bg-purple-700 text-white text-sm font-semibold rounded-lg transition-colors">Prepare Payroll</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Existing Payroll Batches -->
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Recent Payroll Batches</h2>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        {if periods|count > 0}
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-200">
                        <th class="py-3.5 px-5 text-left font-semibold text-gray-600 whitespace-nowrap">Period</th>
                        <th class="py-3.5 px-5 text-left font-semibold text-gray-600 whitespace-nowrap">Dates</th>
                        <th class="py-3.5 px-5 text-center font-semibold text-gray-600 whitespace-nowrap">Employees</th>
                        <th class="py-3.5 px-5 text-right font-semibold text-gray-600 whitespace-nowrap">Gross</th>
                        <th class="py-3.5 px-5 text-right font-semibold text-gray-600 whitespace-nowrap">Net Pay</th>
                        <th class="py-3.5 px-5 text-center font-semibold text-gray-600 whitespace-nowrap">Status</th>
                        <th class="py-3.5 px-5 text-right font-semibold text-gray-600 whitespace-nowrap">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {for p in periods}
                    <tr class="border-b last:border-b-0 border-gray-100 hover:bg-gray-50/50 transition-colors">
                        <td class="py-3 px-5 font-medium text-gray-900 whitespace-nowrap">{p.period_name|default:'—'}</td>
                        <td class="py-3 px-5 text-gray-500 text-xs whitespace-nowrap">{p.start_date|default:'—'} → {p.end_date|default:'—'}</td>
                        <td class="py-3 px-5 text-center text-gray-900 font-medium whitespace-nowrap">{p.total_employees|default:0}</td>
                        <td class="py-3 px-5 text-right text-gray-700 whitespace-nowrap">₱ {p.total_gross_pay|number_format:2|default:'0.00'}</td>
                        <td class="py-3 px-5 text-right text-gray-900 font-semibold whitespace-nowrap">₱ {p.total_net_pay|number_format:2|default:'0.00'}</td>
                        <td class="py-3 px-5 text-center whitespace-nowrap">
                            {if p.status == 'completed' || p.status == 'approved'}
                            <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700 capitalize">{p.status}</span>
                            {else if p.status == 'processing'}
                            <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-700 capitalize">{p.status}</span>
                            {else if p.status == 'cancelled'}
                            <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700 capitalize">{p.status}</span>
                            {else}
                            <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700 capitalize">{p.status|default:'draft'}</span>
                            {/if}
                        </td>
                        <td class="py-3 px-5 text-right text-gray-700 whitespace-nowrap">
                            {if p.end_date|default:'' < 'now'|date:'Y-m-d'}
                            <span class="text-xs text-gray-400 mr-1">final</span>₱ {p.total_gross_pay|number_format:2|default:'0.00'}
                            {else}
                            <span class="text-xs text-amber-500 mr-1" title="Running total — subject to deductions">running</span>₱ {p.total_gross_pay|number_format:2|default:'0.00'}
                            {/if}
                        </td>
                        <td class="py-3 px-5 text-right whitespace-nowrap">
                            <div class="flex items-center justify-end gap-2">
                                <a href="/admin/wage/periods/{p.period_id}" class="inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors">Edit</a>
                                {if p.status!='completed' && p.status!='cancelled'}
                                <a href="/admin/wage/reports/{p.period_id}" class="inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-lg bg-brand-50 text-brand-700 hover:bg-brand-100 transition-colors">Report</a>
                                {/if}
                                {if p.status=='draft' || p.status=='processing'}
                                <form method="post" action="/api/v1/wage/periods/{p.period_id}/delete" class="inline" onsubmit="return confirm('Delete this period and all its computations?')">
                                    <input type="hidden" name="_token" value="{csrf_token}">
                                    <button type="submit" class="inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-lg bg-red-50 text-red-600 hover:bg-red-100 transition-colors">Delete</button>
                                </form>
                                {/if}
                            </div>
                        </td>
                    </tr>
                    {/for}
                </tbody>
            </table>
        </div>
        {else}
        <div class="py-16 text-center">
            <p class="text-4xl mb-3">💵</p>
            <p class="text-gray-500 font-medium">No payroll batches yet.</p>
            <p class="text-sm text-gray-400 mt-1">Click "Prepare Payroll" above to create one.</p>
        </div>
        {/if}
    </div>
</div>
{/block}
