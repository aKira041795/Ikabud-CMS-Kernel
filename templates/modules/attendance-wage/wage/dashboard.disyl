<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZAP — Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>body{font-family:'Inter',system-ui,sans-serif}</style>
</head>
<body class="bg-gray-50 min-h-screen">
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-14">
                <div class="flex items-center space-x-1">
                    <a href="/admin/wage" class="font-extrabold text-lg text-gray-900 tracking-tight px-2">ZAP</a>
                    <span class="text-gray-300">|</span>
                    <a href="/admin/wage" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 rounded-md {if active_nav == 'dashboard'}bg-gray-100 text-gray-900{/if}">Dashboard</a>
                    <a href="/admin/attendance" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 rounded-md">Attendance</a>
                    <a href="/admin/wage/employees" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 rounded-md">Employees</a>
                    <a href="/admin/wage/periods" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 rounded-md">Periods</a>
                    <a href="/admin/wage/computations" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 rounded-md">Computations</a>
                    <a href="/admin/wage/holidays" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 rounded-md">Holidays</a>
                    <a href="/admin/wage/reports" class="px-3 py-2 text-sm font-medium text-gray-600 hover:text-gray-900 rounded-md">Reports</a>
                </div>
                <div>
                    <a href="/attendance-wage/logout" class="text-sm text-gray-500 hover:text-gray-700">Sign out</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="mb-8">
            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">📊 Dashboard</h1>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Active Employees</div>
                <div class="text-3xl font-bold text-gray-900">{employee_count|default:0}</div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Current Period</div>
                <div class="text-lg font-bold text-gray-900">{current_period_name|default:'—'}</div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Pending Approvals</div>
                <div class="text-3xl font-bold text-gray-900">{pending_approvals|default:0}</div>
            </div>
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
                <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Total Net Pay</div>
                <div class="text-3xl font-bold text-gray-900">₱{total_net_pay|default:'0.00'}</div>
            </div>
        </div>

        <div class="mb-10">
            <h2 class="text-xl font-bold text-gray-900 mb-4">🕐 Today's Attendance</h2>
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                {ikb_entity_list source="attendance_record.recent" view="compact" limit="10" empty="No attendance records today." /}
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div>
                <h2 class="text-xl font-bold text-gray-900 mb-4">💵 Salary Computations</h2>
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                    {ikb_entity_list source="salary_computation.pending" view="compact" limit="5" empty="No pending computations." /}
                </div>
            </div>
            <div>
                <h2 class="text-xl font-bold text-gray-900 mb-4">💸 Cash Advances</h2>
                <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                    {ikb_entity_list source="cash_advance.active" view="compact" limit="5" empty="No active cash advances." /}
                </div>
            </div>
        </div>
    </main>
</body>
</html>
