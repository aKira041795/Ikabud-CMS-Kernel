{extends "modules/attendance-wage/layouts/admin.disyl"}

{macro statCard(label, value, color = "gray", subtitle = "")}
<div class="bg-white rounded-xl shadow-sm border border-{color}-200 p-6 hover:shadow-md transition-shadow">
    <div class="text-xs font-semibold text-{color}-600 uppercase tracking-wider mb-2">{label}</div>
    <div class="text-2xl font-bold text-{color}-700">{value}</div>
    {if subtitle}<div class="text-xs text-{color}-500 mt-1">{subtitle}</div>{/if}
</div>
{/macro}
<div class="bg-white rounded-xl shadow-sm border border-{color}-200 p-6 hover:shadow-md transition-shadow">
    <div class="text-xs font-semibold text-{color}-600 uppercase tracking-wider mb-2">{label}</div>
    <div class="text-2xl font-bold text-{color}-700">{value}</div>
    {if subtitle}<div class="text-xs text-{color}-500 mt-1">{subtitle}</div>{/if}
</div>
{/macro}

{block main}
<div class="px-6 py-8">
    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-8">📊 Dashboard</h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
        {call statCard("Active Employees", employee_count|default:0)}
        {call statCard("Current Period", current_period_name|default:'—')}
        {call statCard("Pending Approvals", pending_approvals|default:0)}
        {call statCard("Total Net Pay", "₱{total_net_pay|default:'0.00'}")}
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
        {call statCard("Pending CAs", ca_pending_count|default:0, "amber", "₱ {ca_pending_amount|default:'0.00'}")}
        {call statCard("Active CAs", ca_active_count|default:0, "red", "₱ {ca_outstanding|default:'0.00'} outstanding")}
        {call statCard("Office Locations", location_count|default:0, "blue")}
        {call statCard("Clocked In Now", today_clocked_in|default:0, "emerald", "{today_records|default:0} records today")}
    </div>

    <!-- Today's Attendance Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-10">
        {call statCard("Total Today", today_records|default:0)}
        {call statCard("Office Clock-ins", today_office_count|default:0, "green")}
        {call statCard("On-Site Clock-ins", today_onsite_count|default:0, "amber")}
    </div>
    <div class="mb-10">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold text-gray-900">🕐 Today's Attendance</h2>
            <a href="/admin/attendance" class="text-sm text-brand-600 hover:text-brand-700 font-medium">View All →</a>
        </div>
        {if today_attendance|count > 0}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-200">
                            <th class="py-3 px-4 text-left font-semibold text-gray-600">Employee</th>
                            <th class="py-3 px-4 text-left font-semibold text-gray-600">Position</th>
                            <th class="py-3 px-4 text-left font-semibold text-gray-600">Clock In</th>
                            <th class="py-3 px-4 text-left font-semibold text-gray-600">Clock Out</th>
                            <th class="py-3 px-4 text-left font-semibold text-gray-600">Type</th>
                            <th class="py-3 px-4 text-center font-semibold text-gray-600">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {for row in today_attendance}
                        <tr class="border-b last:border-b-0 border-gray-100 hover:bg-gray-50/50">
                            <td class="py-3 px-4">
                                <div class="font-medium text-gray-900">{row.employee_name}</div>
                                <div class="text-xs text-gray-400">{row.employee_number|default:'—'}</div>
                            </td>
                            <td class="py-3 px-4 text-gray-600 text-xs">{row.position|default:'—'}</td>
                            <td class="py-3 px-4 text-gray-700 font-mono text-xs">{row.clock_in|default:'—'}</td>
                            <td class="py-3 px-4 text-gray-700 font-mono text-xs">
                                {if row.clock_out}{row.clock_out}{else}<span class="text-amber-600 font-medium">—</span>{/if}
                            </td>
                            <td class="py-3 px-4">
                                {if row.onsite_attendance}
                                <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700">🏗️ On-site</span>
                                {else}
                                <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-700">🏢 Office</span>
                                {/if}
                            </td>
                            <td class="py-3 px-4 text-center">
                                {if row.status == 'active'}
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">
                                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Active
                                </span>
                                {else}
                                <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">Done</span>
                                {/if}
                            </td>
                        </tr>
                        {/for}
                    </tbody>
                </table>
            </div>
        </div>
        {else}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center">
            <p class="text-gray-400 text-sm">No attendance records for today yet.</p>
        </div>
        {/if}
    </div>

    <div class="mb-10">
        <h2 class="text-xl font-bold text-gray-900 mb-4">📍 Office Locations</h2>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            {ikb_entity_list source="office_location" view="table" use="tailwind" limit="10" empty="No office locations configured yet." /}
        </div>
    </div>

    <div class="mb-10">
        <h2 class="text-xl font-bold text-gray-900 mb-4">💸 Recent Cash Advances</h2>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            {ikb_entity_list source="cash_advance" view="table" use="tailwind" limit="5" empty="No cash advances yet." /}
        </div>
    </div>
    <div class="mb-10">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold text-gray-900">💵 Recent Computations</h2>
            <a href="/admin/wage/computations" class="text-sm text-brand-600 hover:text-brand-700 font-medium">View All →</a>
        </div>
        {if recent_computations|count > 0}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-200">
                            <th class="py-3 px-4 text-left font-semibold text-gray-600">Employee</th>
                            <th class="py-3 px-4 text-left font-semibold text-gray-600">Period</th>
                            <th class="py-3 px-4 text-right font-semibold text-gray-600">Gross Pay</th>
                            <th class="py-3 px-4 text-right font-semibold text-gray-600">Deductions</th>
                            <th class="py-3 px-4 text-right font-semibold text-gray-600">Net Pay</th>
                            <th class="py-3 px-4 text-center font-semibold text-gray-600">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {for c in recent_computations}
                        <tr class="border-b last:border-b-0 border-gray-100 hover:bg-gray-50/50">
                            <td class="py-3 px-4 font-medium text-gray-900">{c.employee_name|default:'—'}</td>
                            <td class="py-3 px-4 text-gray-600 text-xs">{c.period_name|default:'—'}</td>
                            <td class="py-3 px-4 text-right text-gray-900 font-medium">₱{c.gross_pay|default:'0.00'}</td>
                            <td class="py-3 px-4 text-right text-red-600">₱{c.total_deductions|default:'0.00'}</td>
                            <td class="py-3 px-4 text-right text-green-700 font-semibold">₱{c.net_pay|default:'0.00'}</td>
                            <td class="py-3 px-4 text-center">
                                {if c.status == 'computed'}
                                <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700">Computed</span>
                                {else if c.status == 'approved'}
                                <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">Approved</span>
                                {else if c.status == 'paid'}
                                <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-700">Paid</span>
                                {else}
                                <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">{c.status|default:'—'}</span>
                                {/if}
                            </td>
                        </tr>
                        {/for}
                    </tbody>
                </table>
            </div>
        </div>
        {else}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 text-center">
            <p class="text-gray-400 text-sm">No computations yet. Run payroll from the Computations page.</p>
        </div>
        {/if}
    </div>
</div>
{/block}
