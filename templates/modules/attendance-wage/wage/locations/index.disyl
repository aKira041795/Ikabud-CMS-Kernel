{extends "modules/attendance-wage/layouts/admin.disyl"}

{block main}
<div class="px-6 py-8">
    <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">📍 Office Locations</h1>
        <a href="/admin/wage/locations/create" class="inline-flex items-center px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm">+ Add Location</a>
    </div>

    {ikb_entity_list source="office_location" view="table" use="tailwind" limit="50" empty="No office locations configured yet." /}
</div>
{/block}
