{extends "modules/attendance-wage/layouts/admin.disyl"}

{block main}
<div class="px-6 py-8">
    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight mb-8">
        {if id}Edit Location{else}Add Office Location{/if}
    </h1>

    <form method="post" action="/api/v1/wage/locations{if id}/{id}{/if}" class="space-y-6 max-w-3xl">
        <input type="hidden" name="_token" value="{csrf_token}">

        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-5">
            <h2 class="text-lg font-bold text-gray-900">Location Details</h2>

            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Office Name <span class="text-red-500">*</span></label>
                <input type="text" name="name" value="{name|default:''}" required
                       class="w-full px-4 py-2.5 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500"
                       placeholder="e.g. DC Main Office, Julies Bakeshop - Branch A">
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Address</label>
                <input type="text" name="address" value="{address|default:''}"
                       class="w-full px-4 py-2.5 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500"
                       placeholder="Full street address">
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Latitude <span class="text-red-500">*</span></label>
                    <input type="number" step="any" name="latitude" value="{latitude|default:''}" required
                           class="w-full px-4 py-2.5 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500"
                           placeholder="14.5995" id="loc-lat">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Longitude <span class="text-red-500">*</span></label>
                    <input type="number" step="any" name="longitude" value="{longitude|default:''}" required
                           class="w-full px-4 py-2.5 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500"
                           placeholder="120.9842" id="loc-lng">
                </div>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">
                    Geo-fence Radius (meters) <span class="text-red-500">*</span>
                </label>
                <input type="number" name="radius_meters" value="{radius_meters|default:100}" required min="10" max="10000"
                       class="w-full px-4 py-2.5 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500"
                       placeholder="100">
                <p class="text-xs text-gray-400 mt-1">Employees must be within this distance to clock in. Range: 10–10,000 meters.</p>
            </div>

            {if id}
            <div class="flex items-center gap-3 pt-2">
                <label class="relative inline-flex items-center cursor-pointer">
                    <input type="hidden" name="is_active" value="0">
                    <input type="checkbox" name="is_active" value="1" class="sr-only peer" {if is_active|default:1}checked{/if}>
                    <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-brand-500/20 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand-600"></div>
                </label>
                <span class="text-sm font-medium text-gray-700">Active</span>
                <span class="text-xs text-gray-400">Inactive locations are hidden from clock-in geo-fence checks.</span>
            </div>
            {/if}
        </div>

        <!-- Google Map Picker (self-contained, does not block form submission) -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 space-y-4" x-data="locationMap()" x-init="init()">
            <h2 class="text-lg font-bold text-gray-900">Pin Location on Map</h2>
            <p class="text-sm text-gray-500">Click the map to set coordinates, or type them above.</p>

            <div class="flex gap-3">
                <input type="text" x-model="query" @keyup.enter="search()"
                       class="flex-1 px-4 py-2.5 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500"
                       placeholder="Search for an address...">
                <button type="button" @click="search()"
                        class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-lg transition-colors">
                    🔍 Search
                </button>
            </div>

            <div id="location-map" class="w-full h-80 rounded-lg border border-gray-200 bg-gray-100"></div>
            <p class="text-xs text-gray-400" x-show="coords" x-text="coords"></p>
        </div>

        <div class="flex items-center gap-4">
            <button type="submit"
                    class="px-6 py-3 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm">
                {if id}Update Location{else}Create Location{/if}
            </button>
            <a href="/admin/wage/locations" class="px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold rounded-lg transition-colors">
                Cancel
            </a>
        </div>
    </form>
</div>

<!-- Google Maps API -->
{if maps_api_key}
<script src="https://maps.googleapis.com/maps/api/js?key={maps_api_key}&libraries=places"></script>
<script>
    function gm_authFailure() {
        var el = document.getElementById('location-map');
        if (el) el.innerHTML = '<div class="flex items-center justify-center h-full text-center p-6"><div><p class="text-red-600 font-semibold text-sm mb-1">⚠️ Google Maps failed to load</p><p class="text-red-500 text-xs">Check billing + Maps JavaScript API in Google Cloud Console.</p></div></div>';
    }

    document.addEventListener('alpine:init', function () {
        Alpine.data('locationMap', function () {
            return {
                query: '',
                coords: '',
                map: null,
                marker: null,

                init() {
                    var mapEl = document.getElementById('location-map');
                    if (!mapEl || typeof google === 'undefined' || typeof google.maps === 'undefined') {
                        if (mapEl) mapEl.innerHTML = '<div class="flex items-center justify-center h-full text-center p-6 text-sm text-gray-400">Map unavailable — enter coordinates manually above.</div>';
                        return;
                    }
                    var latEl = document.getElementById('loc-lat');
                    var lngEl = document.getElementById('loc-lng');
                    var lat = latEl ? parseFloat(latEl.value) || 14.5995 : 14.5995;
                    var lng = lngEl ? parseFloat(lngEl.value) || 120.9842 : 120.9842;

                    try {
                        this.map = new google.maps.Map(mapEl, { center: { lat: lat, lng: lng }, zoom: 15, mapTypeControl: false, streetViewControl: false });
                        this.marker = new google.maps.Marker({ position: { lat: lat, lng: lng }, map: this.map, draggable: true });
                        var self = this;
                        this.marker.addListener('dragend', function () { var p = self.marker.getPosition(); self.setCoords(p.lat(), p.lng()); });
                        this.map.addListener('click', function (e) { self.marker.setPosition(e.latLng); self.setCoords(e.latLng.lat(), e.latLng.lng()); });
                        new google.maps.Circle({ strokeColor: '#3b82f6', strokeOpacity: 0.3, strokeWeight: 2, fillColor: '#3b82f6', fillOpacity: 0.08, map: this.map, center: { lat: lat, lng: lng }, radius: parseInt(document.querySelector('[name=radius_meters]')?.value) || 100 });
                        this.coords = 'Selected: ' + lat.toFixed(6) + ', ' + lng.toFixed(6);
                    } catch (e) {
                        if (mapEl) mapEl.innerHTML = '<div class="flex items-center justify-center h-full text-center p-6 text-sm text-red-500">Map error: ' + (e.message || '') + '</div>';
                    }
                },

                setCoords(lat, lng) {
                    var latEl = document.getElementById('loc-lat');
                    var lngEl = document.getElementById('loc-lng');
                    if (latEl) latEl.value = lat.toFixed(7);
                    if (lngEl) lngEl.value = lng.toFixed(7);
                    this.coords = 'Selected: ' + lat.toFixed(6) + ', ' + lng.toFixed(6);
                },

                search() {
                    if (!this.query || typeof google === 'undefined') return;
                    var self = this;
                    new google.maps.Geocoder().geocode({ address: this.query }, function (results, status) {
                        if (status === 'OK' && results[0]) {
                            var loc = results[0].geometry.location;
                            self.map.setCenter(loc); self.map.setZoom(17);
                            self.marker.setPosition(loc);
                            self.setCoords(loc.lat(), loc.lng());
                            var addrEl = document.querySelector('[name=address]');
                            if (addrEl && !addrEl.value) addrEl.value = results[0].formatted_address;
                        }
                    });
                },
            };
        });
    });
</script>
{else}
<div class="bg-amber-50 border border-amber-200 rounded-lg p-4 text-sm text-amber-700 mt-4">
    ⚠️ <strong>Google Maps API key not configured.</strong> Set it in <a href="/admin/wage/settings" class="text-brand-600 hover:text-brand-700 underline">Settings → Google Maps API Key</a>. Coordinates can still be entered manually.
</div>
{/if}
{/block}
