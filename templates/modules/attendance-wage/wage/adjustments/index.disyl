{extends "modules/attendance-wage/layouts/admin.disyl"}
{block main}
<div class="px-6 py-8">
    <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">🔧 Salary Adjustments</h1>
        <a href="/admin/wage/adjustments/create" class="inline-flex items-center px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm">+ New Adjustment</a>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        {ikb_entity_list source="salary_adjustment.recent" view="table" use="tailwind" limit="20" empty="No salary adjustments yet." /}
    </div>
</div>
{/block}
