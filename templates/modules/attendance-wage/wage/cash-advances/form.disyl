{extends "modules/attendance-wage/layouts/admin.disyl"}
{block main}
<div class="px-6 py-8" x-data="{repaymentType:'full_next_payroll'}">
    <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">💸 Request Cash Advance</h1>
        <a href="/admin/wage/cash-advances" class="inline-flex items-center px-4 py-2.5 text-sm font-semibold rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-700 transition-colors">← Back</a>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <form method="post" action="/api/v1/wage/cash-advances" class="space-y-6">
            <input type="hidden" name="_token" value="{csrf_token}">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label for="employee_name" class="block text-sm font-semibold text-gray-700 mb-1.5">Employee <span class="text-red-500">*</span></label>
                    <select name="employee_name" id="employee_name" required class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 bg-white">
                        <option value="">Select employee...</option>
                        {for emp in employees}
                        <option value="{emp.profile_id}">{emp.full_name|default:'—'}{if emp.position} — {emp.position}{/if}</option>
                        {/for}
                    </select>
                </div>
                <div>
                    <label for="amount" class="block text-sm font-semibold text-gray-700 mb-1.5">Amount (₱) <span class="text-red-500">*</span></label>
                    <input type="number" step="0.01" name="amount" id="amount" required class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500" placeholder="0.00">
                </div>
                <div>
                    <label for="repayment_type" class="block text-sm font-semibold text-gray-700 mb-1.5">Repayment <span class="text-red-500">*</span></label>
                    <select name="repayment_type" id="repayment_type" required x-model="repaymentType" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 bg-white">
                        <option value="full_next_payroll">Full amount — next payroll</option>
                        <option value="installment">Installment (per period)</option>
                        <option value="lumpsum_date">Lump sum by date</option>
                    </select>
                </div>
                <div>
                    <label for="request_date" class="block text-sm font-semibold text-gray-700 mb-1.5">Request Date</label>
                    <input type="date" name="request_date" id="request_date" value="{today|default:''}" required class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                </div>
            </div>
            <div x-show="repaymentType === 'installment'" class="grid grid-cols-1 md:grid-cols-2 gap-5" x-transition x-data="{instAmt:0, totalAmt:0}">
                <div>
                    <label for="installment_amount" class="block text-sm font-semibold text-gray-700 mb-1.5">Amount per Period (₱) <span class="text-red-500">*</span></label>
                    <input type="number" step="0.01" name="installment_amount" id="installment_amount" required x-model="instAmt" @input="totalAmt = parseFloat(document.getElementById('amount').value) || 0" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500" placeholder="e.g. 500.00">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">Number of Installments</label>
                    <p class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-sm text-gray-700 font-medium">
                        <span x-text="instAmt > 0 && totalAmt > 0 ? Math.ceil(totalAmt / instAmt) : '—'">—</span>
                        <span class="text-xs text-gray-400 ml-1" x-show="instAmt > 0 && totalAmt > 0">periods</span>
                    </p>
                    <input type="hidden" name="total_installments" :value="instAmt > 0 && totalAmt > 0 ? Math.ceil(totalAmt / instAmt) : 0">
                </div>
            </div>
            <div x-show="repaymentType === 'lumpsum_date'" x-transition>
                <label for="target_repay_date" class="block text-sm font-semibold text-gray-700 mb-1.5">Repayment Date</label>
                <input type="date" name="target_repay_date" id="target_repay_date" class="w-full md:w-1/2 px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                <p class="text-xs text-gray-400 mt-1">Full amount will be deducted from the payroll covering this date.</p>
            </div>
            <div>
                <label for="notes" class="block text-sm font-semibold text-gray-700 mb-1.5">Notes</label>
                <textarea name="notes" id="notes" rows="3" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500" placeholder="Brief description..."></textarea>
            </div>
            <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
                <button type="submit" class="inline-flex items-center px-5 py-3 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm">Submit Request</button>
                <a href="/admin/wage/cash-advances" class="px-5 py-3 text-sm font-semibold text-gray-600 hover:text-gray-800 transition-colors">Cancel</a>
            </div>
        </form>
    </div>
</div>
{/block}
