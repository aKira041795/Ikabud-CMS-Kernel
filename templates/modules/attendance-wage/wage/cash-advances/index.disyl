{extends "modules/attendance-wage/layouts/admin.disyl"}
{block main}
<div class="px-6 py-8">
    <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">💸 Cash Advances</h1>
        <a href="/admin/wage/cash-advances/create" class="inline-flex items-center px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-lg transition-colors shadow-sm">+ Request Advance</a>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Total Requested</p>
            <p class="mt-1.5 text-2xl font-extrabold text-gray-900">₱ {summary.total|number_format:2|default:'0.00'}</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Pending</p>
            <p class="mt-1.5 text-2xl font-extrabold text-amber-600">₱ {summary.pending|number_format:2|default:'0.00'}</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Outstanding Balance</p>
            <p class="mt-1.5 text-2xl font-extrabold text-red-600">₱ {summary.approved|number_format:2|default:'0.00'}</p>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide">Active CAs</p>
            <p class="mt-1.5 text-2xl font-extrabold text-brand-600">{summary.active|default:0}</p>
        </div>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        {ikb_entity_list source="cash_advance.active" view="table" use="tailwind" limit="20" empty="No cash advance requests." /}
    </div>

    {if selectedCA}
    <div class="mt-8 bg-white rounded-xl shadow-sm border border-brand-200 ring-1 ring-brand-500/20 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-brand-50/30 flex items-center justify-between">
            <h2 class="text-lg font-bold text-gray-900">💸 Cash Advance Detail</h2>
            <a href="/admin/wage/cash-advances" class="text-sm text-gray-500 hover:text-gray-700">✕ Close</a>
        </div>
        <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="md:col-span-2">
                <dl class="grid grid-cols-2 gap-4 text-sm">
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase">Employee</dt>
                        <dd class="mt-0.5 font-semibold text-gray-900">{selectedCA.employee_name|default:'—'}</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase">Position</dt>
                        <dd class="mt-0.5 text-gray-700">{selectedCA.position|default:'—'} &middot; {selectedCA.department|default:'—'}</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase">Amount</dt>
                        <dd class="mt-0.5 text-xl font-extrabold text-gray-900">₱ {selectedCA.amount|number_format:2|default:'0.00'}</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase">Balance</dt>
                        <dd class="mt-0.5 text-xl font-extrabold text-red-600">₱ {selectedCA.balance|number_format:2|default:'0.00'}</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase">Requested</dt>
                        <dd class="mt-0.5 text-gray-700">{selectedCA.request_date|default:'—'}</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase">Repayment</dt>
                        <dd class="mt-0.5 text-gray-700">{selectedCA.repayment_type|default:'—'}</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase">Status</dt>
                        <dd class="mt-0.5">
                            <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-medium {if selectedCA.status=='pending'}bg-amber-100 text-amber-700{else if selectedCA.status=='approved'}bg-green-100 text-green-700{else}bg-blue-100 text-blue-700{/if}">{selectedCA.status|default:'—'}</span>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-gray-500 uppercase">Approved</dt>
                        <dd class="mt-0.5 text-gray-700">{selectedCA.approved_at|default:'Not yet'}</dd>
                    </div>
                </dl>
                {if selectedCA.notes}
                <div class="mt-4 pt-4 border-t border-gray-100">
                    <dt class="text-xs font-medium text-gray-500 uppercase mb-1">Notes</dt>
                    <dd class="text-sm text-gray-600">{selectedCA.notes}</dd>
                </div>
                {/if}
            </div>
            <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                <h3 class="text-sm font-semibold text-gray-700 mb-3">All Advances — {selectedCA.employee_name|default:'Employee'}</h3>
                {if employeeCAs|count > 0}
                <div class="space-y-2 max-h-64 overflow-y-auto">
                    {for ca in employeeCAs}
                    <div class="flex items-center justify-between text-xs bg-white rounded-md px-3 py-2 border border-gray-100">
                        <div>
                            <span class="font-medium text-gray-800">₱ {ca.amount|number_format:2}</span>
                            <span class="text-gray-400 ml-1">{ca.request_date|default:''}</span>
                        </div>
                        <span class="px-2 py-0.5 rounded-full text-xs font-medium {if ca.status=='pending'}bg-amber-100 text-amber-700{else if ca.status=='approved'}bg-green-100 text-green-700{else}bg-blue-100 text-blue-700{/if}">{ca.status}</span>
                    </div>
                    {/for}
                </div>
                {else}
                <p class="text-xs text-gray-400">No other advances found.</p>
                {/if}
                <div class="mt-3 pt-3 border-t border-gray-200">
                    <p class="text-xs text-gray-500">Total Outstanding</p>
                    <p class="text-lg font-extrabold text-red-600">₱ {selectedCA.balance|number_format:2|default:'0.00'}</p>
                </div>
            </div>
        </div>
    </div>
    {/if}
</div>
{/block}
