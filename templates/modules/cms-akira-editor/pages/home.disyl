{extends "modules/cms/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-xl font-bold text-slate-900">CMS Akira Editor</h1>
            <p class="mt-0.5 text-sm text-slate-500">Editor extension for the CMS Akira suite. Render, normalize, and sanitize editor content.</p>
        </div>
    </div>

    <!-- Contract card -->
    <div class="rounded-[28px] border border-slate-200 bg-white/92 shadow-[0_18px_40px_rgba(15,23,42,0.05)] p-8">
        <h2 class="text-base font-bold text-slate-900 mb-3">What this module provides</h2>
        <p class="text-sm text-slate-600 leading-relaxed">
            Exposes the editor provider contracts used by the CMS content editor:
            <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">editor.render@1</code>,
            <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">editor.normalize@1</code>,
            <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">editor.sanitize@1</code>,
            <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">editor.validate@1</code>, and
            <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">editor.assets@1</code>.
            When disabled, CMS Akira Core applies a safe fallback normalization (strip scripts/styles).
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
            <span class="text-[11px] font-medium bg-slate-100 text-slate-600 rounded-full px-3 py-1">Exposes: editor.*@1 contracts</span>
            <span class="text-[11px] font-medium bg-emerald-50 text-emerald-700 rounded-full px-3 py-1">Graceful fallback when disabled</span>
        </div>
    </div>

    <!-- Manage card -->
    <div class="rounded-[24px] border border-slate-200 bg-white/92 shadow-[0_18px_40px_rgba(15,23,42,0.05)] p-6">
        <div class="flex items-center justify-between gap-4">
            <div>
                <div class="font-semibold text-slate-900">Content editor</div>
                <p class="text-sm text-slate-500">The rich-text editor (TinyMCE integration) lives in the CMS content editor.</p>
            </div>
            <a href="{base_url}/cms/admin/content" class="shrink-0 text-sm font-medium text-sky-600 hover:text-sky-800 no-underline">Open Content →</a>
        </div>
    </div>
</div>
{/block}
