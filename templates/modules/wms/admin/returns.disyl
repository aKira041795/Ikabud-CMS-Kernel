{extends "modules/wms/layouts/admin.disyl"}

{block content}
<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <section class="xl:col-span-1 bg-white border border-slate-200 rounded-2xl p-5">
        <div class="text-lg font-semibold text-slate-900">Log Return</div>
        <div class="text-sm text-[#999] mt-1">Register a customer or supplier return.</div>
        <form class="mt-5 space-y-3" onsubmit="event.preventDefault(); const f = new FormData(this); wmsPost('{base_url}/api/v1/wms/returns', {reference_number: f.get('reference_number'), customer_name: f.get('customer_name'), warehouse_id: Number(f.get('warehouse_id')), reason: f.get('reason'), items: [{product_id: Number(f.get('product_id')), location_id: Number(f.get('location_id')), qty_returned: Number(f.get('qty_returned')), condition: f.get('condition')}]});">
            <input class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" type="text" name="reference_number" placeholder="Return ref. (e.g. RET-001)" required>
            <input class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" type="text" name="customer_name" placeholder="Customer name">
            <select class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" name="warehouse_id" required>
                <option value="">Warehouse</option>
                {foreach warehouses as warehouse}
                <option value="{warehouse.id}">{warehouse.code} — {warehouse.name}</option>
                {/foreach}
            </select>
            <select class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" name="product_id" required>
                <option value="">Product</option>
                {foreach products as product}
                <option value="{product.id}">{product.sku} — {product.name}</option>
                {/foreach}
            </select>
            <select class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" name="location_id" required>
                <option value="">Return to location</option>
                {foreach locations as location}
                <option value="{location.id}">{location.code} — {location.name}</option>
                {/foreach}
            </select>
            <input class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" type="number" step="0.0001" min="0.0001" name="qty_returned" placeholder="Quantity returned" required>
            <select class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" name="condition">
                <option value="unknown">Condition — Unknown</option>
                <option value="good">Good — restock eligible</option>
                <option value="damaged">Damaged — dispose only</option>
                <option value="expired">Expired — dispose only</option>
            </select>
            <input class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" type="text" name="reason" placeholder="Reason for return">
            <button class="w-full rounded-xl bg-wms-600 text-white px-4 py-2 text-sm font-medium" type="submit">Log return</button>
        </form>
    </section>

    <section class="xl:col-span-2 bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-200">
            <div class="text-lg font-semibold text-slate-900">Returns Queue</div>
            <div class="text-sm text-[#999]">Pending, inspecting, and recent returns.</div>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead class="bg-slate-50 text-[#999] uppercase text-xs tracking-wide">
                    <tr>
                        <th class="px-4 py-3 text-left">Reference</th>
                        <th class="px-4 py-3 text-left">Customer</th>
                        <th class="px-4 py-3 text-left">Warehouse</th>
                        <th class="px-4 py-3 text-left">Status</th>
                        <th class="px-4 py-3 text-left">Reason</th>
                        <th class="px-4 py-3 text-left">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {if returns | count == 0}
                    <tr><td colspan="6" class="px-4 py-6 text-[#999]">No returns logged yet.</td></tr>
                    {/if}
                    {foreach returns as ret}
                    <tr>
                        <td class="px-4 py-3 font-medium text-slate-900">{ret.reference_number}</td>
                        <td class="px-4 py-3 text-[#999]">{ret.customer_name | default:'-'}</td>
                        <td class="px-4 py-3 text-[#999]">{ret.warehouse_name}</td>
                        <td class="px-4 py-3">
                            {if ret.status == 'restocked'}
                            <span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">Restocked</span>
                            {elseif ret.status == 'disposed'}
                            <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-[#999]">Disposed</span>
                            {elseif ret.status == 'cancelled'}
                            <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-600">Cancelled</span>
                            {else}
                            <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700">{ret.status}</span>
                            {/if}
                        </td>
                        <td class="px-4 py-3 text-[#999]">{ret.reason | default:'-'}</td>
                        <td class="px-4 py-3">
                            {if ret.status != 'restocked' && ret.status != 'cancelled'}
                            <button class="rounded-lg bg-emerald-600 text-white px-3 py-1.5 text-xs" onclick="wmsPost('{base_url}/api/v1/wms/returns/{ret.id}/restock', {});">Restock</button>
                            {/if}
                        </td>
                    </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </section>
</div>
{/block}
