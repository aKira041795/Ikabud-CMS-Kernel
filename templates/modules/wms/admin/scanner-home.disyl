<div class="h-full flex flex-col space-y-4" x-data="scannerTasks()">

    <!-- Header Stats -->
    <div class="grid grid-cols-2 gap-3 mb-2 shrink-0">
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center shadow-sm">
            <div class="text-3xl font-black text-blue-700 tabular-nums leading-none" x-text="tasks.filter(t => t.status === 'pending').length">-</div>
            <div class="text-xs font-semibold text-blue-600 uppercase tracking-wide mt-1">Pending</div>
        </div>
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-center shadow-sm">
            <div class="text-3xl font-black text-amber-700 tabular-nums leading-none" x-text="tasks.filter(t => t.status === 'in_progress').length">-</div>
            <div class="text-xs font-semibold text-amber-600 uppercase tracking-wide mt-1">Active</div>
        </div>
    </div>

    <!-- Scanner Action Context -->
    <div class="bg-wms-50 border-2 border-wms-200 border-dashed rounded-xl p-4 flex flex-col items-center justify-center min-h-[120px] shadow-sm relative overflow-hidden transition-all duration-300"
         :class="{'ring-4 ring-green-400 border-solid bg-green-50': lastScanGood, 'ring-4 ring-red-400 border-solid bg-red-50': lastScanBad}">
        <div class="text-wms-600 mb-2">
            <svg class="w-8 h-8 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm14 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path></svg>
        </div>
        <h3 class="text-sm font-semibold text-wms-800 tracking-wide">Ready for Barcode</h3>
        <p class="text-xs text-wms-600 mt-1 opacity-80">Scan a Location, Product, or Task</p>
        
        <div x-show="lastScanText" x-transition.opacity class="absolute bottom-1 w-full text-center">
            <span class="text-[10px] font-mono tracking-widest bg-black/10 px-2 py-0.5 rounded" x-text="lastScanText"></span>
        </div>
    </div>

    <!-- Task List -->
    <div class="flex-1 overflow-y-auto pb-6 space-y-3">
        <h2 class="text-sm font-bold text-slate-400 uppercase tracking-widest sticky top-0 bg-slate-100 py-2 z-10 border-b border-slate-200">My Queue</h2>
        
        <template x-for="t in sortedTasks" :key="t.id">
            <div class="bg-white rounded-xl shadow border border-slate-200 p-4 relative overflow-hidden active:scale-[0.98] transition-transform" 
                 @click="openTask(t.id)"
                 :class="{'border-l-4 border-l-amber-500': t.status === 'in_progress'}">
                <div class="flex justify-between items-start mb-2">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider shadow-sm"
                          :class="{
                              'bg-indigo-100 text-indigo-700 border border-indigo-200': t.task_type === 'pick',
                              'bg-emerald-100 text-emerald-700 border border-emerald-200': t.task_type === 'putaway',
                              'bg-purple-100 text-purple-700 border border-purple-200': t.task_type === 'replenish',
                              'bg-slate-100 text-slate-700 border border-slate-200': t.task_type === 'count'
                          }" x-text="t.task_type"></span>
                    <span class="text-xs font-mono text-slate-400">#<span x-text="t.id"></span></span>
                </div>
                
                <p class="text-sm text-slate-800 font-medium leading-tight mb-2" x-text="t.notes || 'No description provided'"></p>
                
                <div class="flex justify-between items-end mt-auto pt-2 border-t border-slate-100">
                    <div class="text-[10px] font-semibold text-slate-500 uppercase tracking-widest" x-text="t.reference_type ? t.reference_type + ' ' + t.reference_id : 'MANUAL TASK'"></div>
                    <div x-show="t.status === 'in_progress'" class="flex items-center gap-1 text-amber-600">
                        <span class="relative flex h-2 w-2">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
                        </span>
                        <span class="text-[10px] font-bold uppercase tracking-widest">Active</span>
                    </div>
                </div>
            </div>
        </template>

        <div x-show="tasks.length === 0" class="text-center py-8 text-slate-400">
            <svg class="w-12 h-12 mx-auto mb-3 opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <p class="text-sm">No tasks assigned to you right now.</p>
        </div>
    </div>

</div>

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('scannerTasks', () => ({
        tasks: [],
        lastScanText: '',
        lastScanGood: false,
        lastScanBad: false,
        
        get sortedTasks() {
            return this.tasks.sort((a, b) => {
                // In progress first
                if (a.status === 'in_progress' && b.status !== 'in_progress') return -1;
                if (b.status === 'in_progress' && a.status !== 'in_progress') return 1;
                return a.priority - b.priority;
            });
        },

        init() {
            this.load();
            window.addEventListener('wms-barcode-scanned', (e) => this.handleScan(e.detail.barcode));
        },

        async load() {
            const res = await fetch('/api/v1/wms/tasks?status=pending&assigned_to={auth_user.id}');
            const res2 = await fetch('/api/v1/wms/tasks?status=in_progress&assigned_to={auth_user.id}');
            
            const j1 = await res.json();
            const j2 = await res2.json();
            
            this.tasks = [...(j1.data||[]), ...(j2.data||[])];
        },
        
        handleScan(barcode) {
            this.lastScanText = barcode;
            
            // Dummy validation logic for Phase 3 visual feedback
            if (barcode.startsWith('LOC-') || barcode.startsWith('PRD-') || barcode.startsWith('TSK-')) {
                this.lastScanGood = true;
                setTimeout(() => this.lastScanGood = false, 500);
            } else {
                this.lastScanBad = true;
                setTimeout(() => this.lastScanBad = false, 500);
            }
        },

        openTask(id) {
            // For now, auto-start task on tap
            if (confirm('Start task #' + id + '?')) {
                fetch(`/api/v1/wms/tasks/${id}/status`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({status: 'in_progress'})
                }).then(() => this.load());
            }
        }
    }));
});
</script>
