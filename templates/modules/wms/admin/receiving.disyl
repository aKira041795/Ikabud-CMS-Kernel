{extends "modules/wms/layouts/admin.disyl"}

{block content}
<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <section class="xl:col-span-1 bg-white border border-slate-200 rounded-2xl p-5">
        <div class="text-lg font-semibold text-slate-900">Create Delivery</div>
        <div class="text-sm text-[#999] mt-1">Post to the WMS receiving API.</div>
        <form class="mt-5 space-y-3" onsubmit="event.preventDefault(); const form = new FormData(this); const data = {reference_number: form.get('reference_number'), supplier_name: form.get('supplier_name'), warehouse_id: Number(form.get('warehouse_id') || 0), items: [{product_id: Number(form.get('product_id') || 0), location_id: Number(form.get('location_id') || 0), qty_expected: Number(form.get('qty_expected') || 0)}]}; wmsPost('{base_url}/api/v1/wms/deliveries', data);">
            <input class="w-full rounded-xl border border-slate-200 px-3 py-2" type="text" name="reference_number" placeholder="Reference number" required>
            <input class="w-full rounded-xl border border-slate-200 px-3 py-2" type="text" name="supplier_name" placeholder="Supplier name">
            <select class="w-full rounded-xl border border-slate-200 px-3 py-2" name="warehouse_id" required>
                <option value="">Warehouse</option>
                {foreach warehouses as warehouse}
                <option value="{warehouse.id}">{warehouse.code} — {warehouse.name}</option>
                {/foreach}
            </select>
            <select class="w-full rounded-xl border border-slate-200 px-3 py-2" name="product_id" required>
                <option value="">Product</option>
                {foreach products as product}
                <option value="{product.id}">{product.sku} — {product.name}</option>
                {/foreach}
            </select>
            <select class="w-full rounded-xl border border-slate-200 px-3 py-2" name="location_id" required>
                <option value="">Putaway location</option>
                {foreach locations as location}
                <option value="{location.id}">{location.code} — {location.name}</option>
                {/foreach}
            </select>
            <input class="w-full rounded-xl border border-slate-200 px-3 py-2" type="number" step="0.0001" name="qty_expected" placeholder="Expected qty" required>
            <button class="w-full rounded-xl bg-wms-600 text-white px-4 py-2 font-medium" type="submit">Create delivery</button>
        </form>
    </section>

    <section class="xl:col-span-2 bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-200 flex items-center justify-between">
            <div>
                <div class="text-lg font-semibold text-slate-900">Receiving Queue</div>
                <div class="text-sm text-[#999]">Pending and recent inbound receipts.</div>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead class="bg-slate-50 text-[#999] uppercase text-xs tracking-wide">
                    <tr>
                        <th class="px-4 py-3 text-left">Reference</th>
                        <th class="px-4 py-3 text-left">Supplier</th>
                        <th class="px-4 py-3 text-left">Warehouse</th>
                        <th class="px-4 py-3 text-left">Status</th>
                        <th class="px-4 py-3 text-left">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {if deliveries | count == 0}
                    <tr><td colspan="5" class="px-4 py-6 text-[#999]">No deliveries found.</td></tr>
                    {/if}
                    {foreach deliveries as delivery}
                    <tr>
                        <td class="px-4 py-3 font-medium text-slate-900">{delivery.reference_number}</td>
                        <td class="px-4 py-3">{delivery.supplier_name | default:'-'}</td>
                        <td class="px-4 py-3">{delivery.warehouse_id}</td>
                        <td class="px-4 py-3">{delivery.status}</td>
                        <td class="px-4 py-3">
                            {if delivery.status != 'received' && delivery.status != 'cancelled'}
                            <button class="rounded-lg bg-emerald-600 text-white px-3 py-1.5 text-xs" onclick="wmsPost('{base_url}/api/v1/wms/deliveries/{delivery.id}/receive', {})">Receive</button>
                            {/if}
                        </td>
                    </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </section>
</div>
{/block}
