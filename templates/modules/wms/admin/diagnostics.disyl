{extends "modules/wms/layouts/admin.disyl"}

{block content}
<div class="max-w-6xl mx-auto space-y-6" id="wmsDiagnosticsRoot" data-trace-url="{base_url}/api/v1/wms/diagnostics/trace" data-reservations-url="{base_url}/api/v1/wms/diagnostics/reservations">
    <section class="rounded-2xl border border-slate-200 bg-white p-6">
        <div class="text-2xl font-semibold text-slate-900">Diagnostics & Observability</div>
        <p class="mt-2 text-sm text-slate-600">Inspect reservation pressure and trace inventory history without dropping into raw SQL. These tools are intended for supervisors and support operators who need to answer “why is stock here?” and “who is holding it?”.</p>
    </section>

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
        <section class="rounded-2xl border border-slate-200 bg-white p-5 xl:col-span-1">
            <div class="text-lg font-semibold text-slate-900">Movement Trace</div>
            <div class="mt-1 text-sm text-slate-600">Choose a product and inspect the latest movement ledger entries.</div>
            <div class="mt-5 space-y-3">
                <select class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" id="traceProductId">
                    <option value="">Select product</option>
                    {foreach products as product}
                    <option value="{product.id}">{product.sku} — {product.name}</option>
                    {/foreach}
                </select>
                <button id="runTraceBtn" class="w-full rounded-xl bg-wms-600 px-4 py-2 text-sm font-medium text-white hover:bg-wms-700">Trace Product Movements</button>
                <div class="rounded-xl bg-slate-50 px-4 py-3 text-sm text-slate-600">Best practice: use the trace before making manual adjustments so you can distinguish missing receipts from bad reservations or picking errors.</div>
            </div>
        </section>

        <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white xl:col-span-2">
            <div class="border-b border-slate-200 px-5 py-4">
                <div class="text-lg font-semibold text-slate-900">Latest Movement Trail</div>
                <div class="text-sm text-slate-600">Newest entries first, scoped to the selected product.</div>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-600">
                        <tr>
                            <th class="px-4 py-3 text-left">Movement</th>
                            <th class="px-4 py-3 text-left">Type</th>
                            <th class="px-4 py-3 text-left">Delta</th>
                            <th class="px-4 py-3 text-left">Balance</th>
                            <th class="px-4 py-3 text-left">Location</th>
                            <th class="px-4 py-3 text-left">Reference</th>
                            <th class="px-4 py-3 text-left">Timestamp</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100" id="traceTbody">
                        <tr><td colspan="7" class="px-4 py-10 text-center text-slate-600">Choose a product to view its trace.</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
        <div class="border-b border-slate-200 px-5 py-4">
            <div class="text-lg font-semibold text-slate-900">Active Reservation Locks</div>
            <div class="text-sm text-slate-600">Current reserved stock that may be blocking picks, transfers, or manual adjustments.</div>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-600">
                    <tr>
                        <th class="px-4 py-3 text-left">Product</th>
                        <th class="px-4 py-3 text-left">Warehouse</th>
                        <th class="px-4 py-3 text-left">Location</th>
                        <th class="px-4 py-3 text-left">Reserved Qty</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100" id="reservationsTbody">
                    <tr><td colspan="4" class="px-4 py-10 text-center text-slate-600">Loading reservations…</td></tr>
                </tbody>
            </table>
        </div>
    </section>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const root = document.getElementById('wmsDiagnosticsRoot');
    const traceProductId = document.getElementById('traceProductId');
    const traceTbody = document.getElementById('traceTbody');
    const reservationsTbody = document.getElementById('reservationsTbody');

    function escapeHtml(value) {
        return String(value ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function movementBadge(type) {
        if (type === 'in' || type === 'cycle_count_adjustment') return 'bg-emerald-50 text-emerald-700 border border-emerald-200';
        if (type === 'out' || type === 'transfer_out') return 'bg-red-50 text-red-700 border border-red-200';
        if (type === 'reserved' || type === 'unreserved') return 'bg-amber-50 text-amber-700 border border-amber-200';
        return 'bg-slate-100 text-slate-700 border border-slate-200';
    }

    async function loadReservations() {
        try {
            const res = await fetch(root.dataset.reservationsUrl, {headers: {'Accept': 'application/json'}});
            const json = await res.json();
            if (!res.ok || !json.ok) throw new Error(json.error || 'Failed to load reservations.');

            const rows = json.reservations || [];
            if (!rows.length) {
                reservationsTbody.innerHTML = '<tr><td colspan="4" class="px-4 py-10 text-center text-slate-600">No active reservations exist.</td></tr>';
                return;
            }

            reservationsTbody.innerHTML = rows.map(row => '<tr>'
                + '<td class="px-4 py-3 font-medium text-slate-900">' + escapeHtml(row.sku) + ' — ' + escapeHtml(row.product_name) + '</td>'
                + '<td class="px-4 py-3 text-slate-700">' + escapeHtml(row.warehouse_name) + '</td>'
                + '<td class="px-4 py-3 text-slate-700">' + escapeHtml(row.location_code) + '</td>'
                + '<td class="px-4 py-3 font-medium text-amber-700">' + escapeHtml(row.qty_reserved) + '</td>'
                + '</tr>').join('');
        } catch (error) {
            reservationsTbody.innerHTML = '<tr><td colspan="4" class="px-4 py-10 text-center text-red-600">' + escapeHtml(error.message) + '</td></tr>';
        }
    }

    async function loadTrace() {
        const productId = Number(traceProductId.value || 0);
        if (productId <= 0) {
            traceTbody.innerHTML = '<tr><td colspan="7" class="px-4 py-10 text-center text-slate-600">Choose a product to view its trace.</td></tr>';
            return;
        }

        traceTbody.innerHTML = '<tr><td colspan="7" class="px-4 py-10 text-center text-slate-600">Loading movement trace…</td></tr>';
        try {
            const res = await fetch(root.dataset.traceUrl + '?product_id=' + encodeURIComponent(productId), {headers: {'Accept': 'application/json'}});
            const json = await res.json();
            if (!res.ok || !json.ok) throw new Error(json.error || 'Failed to load movement trace.');

            const rows = json.trace || [];
            if (!rows.length) {
                traceTbody.innerHTML = '<tr><td colspan="7" class="px-4 py-10 text-center text-slate-600">No movements found for that product.</td></tr>';
                return;
            }

            traceTbody.innerHTML = rows.map(row => '<tr>'
                + '<td class="px-4 py-3 font-medium text-slate-900">#' + escapeHtml(row.id) + '</td>'
                + '<td class="px-4 py-3"><span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium ' + movementBadge(row.movement_type) + '">' + escapeHtml(row.movement_type) + '</span></td>'
                + '<td class="px-4 py-3 ' + (Number(row.qty) < 0 ? 'text-red-700' : 'text-emerald-700') + '">' + escapeHtml(row.qty) + '</td>'
                + '<td class="px-4 py-3 text-slate-700">' + escapeHtml(row.qty_before) + ' → ' + escapeHtml(row.qty_after) + '</td>'
                + '<td class="px-4 py-3 text-slate-700">' + escapeHtml(row.location_code) + (row.batch_number ? '<div class="text-xs text-slate-500">Batch ' + escapeHtml(row.batch_number) + '</div>' : '') + '</td>'
                + '<td class="px-4 py-3 text-slate-700">' + escapeHtml(row.reference_type || 'manual') + (row.reference_id ? ' #' + escapeHtml(row.reference_id) : '') + '</td>'
                + '<td class="px-4 py-3 text-slate-700">' + escapeHtml(row.created_at) + '</td>'
                + '</tr>').join('');
        } catch (error) {
            traceTbody.innerHTML = '<tr><td colspan="7" class="px-4 py-10 text-center text-red-600">' + escapeHtml(error.message) + '</td></tr>';
        }
    }

    document.getElementById('runTraceBtn').addEventListener('click', loadTrace);
    loadReservations();
});
</script>
{/block}