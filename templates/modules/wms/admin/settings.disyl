{extends "modules/wms/layouts/admin.disyl"}

{block content}
<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <section class="xl:col-span-1 bg-white border border-slate-200 rounded-2xl p-5">
        <div class="text-lg font-semibold text-slate-900">Runtime Settings</div>
        <div class="mt-4 space-y-3 text-sm">
            <div class="flex items-center justify-between"><span class="text-[#999]">Low stock threshold</span><span class="font-medium text-slate-900">{wms_settings.low_stock_threshold}</span></div>
            <div class="flex items-center justify-between"><span class="text-[#999]">Picking strategy</span><span class="font-medium text-slate-900 uppercase">{wms_settings.picking_strategy}</span></div>
        </div>
    </section>

    <section class="xl:col-span-2 bg-white border border-slate-200 rounded-2xl overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-200">
            <div class="text-lg font-semibold text-slate-900">Putaway Rules</div>
            <div class="text-sm text-[#999]">Scored rules for location suggestions.</div>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead class="bg-slate-50 text-[#999] uppercase text-xs tracking-wide">
                    <tr>
                        <th class="px-4 py-3 text-left">Warehouse</th>
                        <th class="px-4 py-3 text-left">Product</th>
                        <th class="px-4 py-3 text-left">Type</th>
                        <th class="px-4 py-3 text-left">Zone</th>
                        <th class="px-4 py-3 text-left">Priority</th>
                        <th class="px-4 py-3 text-left">Active</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {if putaway_rules | count == 0}
                    <tr><td colspan="6" class="px-4 py-6 text-[#999]">No putaway rules defined.</td></tr>
                    {/if}
                    {foreach putaway_rules as rule}
                    <tr>
                        <td class="px-4 py-3">{rule.warehouse_name}</td>
                        <td class="px-4 py-3">{rule.product_name | default:'Any product'}</td>
                        <td class="px-4 py-3">{rule.product_type | default:'Any type'}</td>
                        <td class="px-4 py-3">{rule.preferred_zone | default:'-'}</td>
                        <td class="px-4 py-3">{rule.priority}</td>
                        <td class="px-4 py-3">{if rule.is_active}Yes{else}No{/if}</td>
                    </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </section>
</div>
{/block}
