{extends "modules/wms/layouts/admin.disyl"}

{block content}
<div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <section class="xl:col-span-1 bg-white border border-slate-200 rounded-2xl p-5 space-y-4">
        <div>
            <div class="text-lg font-semibold text-slate-900">Account Details</div>
            <div class="text-sm text-[#999] mt-1">Update your active WMS login profile and contact information.</div>
        </div>
        <form class="space-y-4" onsubmit="event.preventDefault(); const f = new FormData(this); wmsPost('{base_url}/api/v1/wms/account', {full_name: f.get('full_name'), email: f.get('email'), phone: f.get('phone')}, () => window.location.reload());">
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">Full Name</label>
                <input class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm bg-white" type="text" name="full_name" value="{account.full_name}" required>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">Username</label>
                <input class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm bg-slate-100 text-slate-500 font-mono" type="text" value="@{account.username}" readonly>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">Email</label>
                <input class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm bg-white" type="email" name="email" value="{account.email}" required>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">Phone</label>
                <input class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm bg-white" type="tel" name="phone" value="{account.phone | default:''}" placeholder="Phone number">
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">Role</label>
                <input class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm bg-slate-100 text-slate-500" type="text" value="{account.role}" readonly>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">Joined</label>
                <input class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm bg-slate-100 text-slate-500" type="text" value="{account.created_at}" readonly>
            </div>
            <div class="flex flex-wrap items-center gap-3 pt-1">
                <button class="rounded-xl bg-wms-600 text-white px-4 py-2 text-sm font-medium" type="submit">Save profile</button>
                {if user.role == 'admin'}
                <a href="{base_url}/wms/users" class="inline-flex items-center rounded-xl bg-slate-100 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-200">Back to Users</a>
                {/if}
            </div>
        </form>
    </section>

    <section class="xl:col-span-2 bg-white border border-slate-200 rounded-2xl p-5">
        <div class="text-lg font-semibold text-slate-900">Change Password</div>
        <div class="text-sm text-[#999] mt-1">Use your current password to set a new WMS login password.</div>
        <form class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-4" onsubmit="event.preventDefault(); const f = new FormData(this); wmsPost('{base_url}/api/v1/wms/account/password', {current_password: f.get('current_password'), new_password: f.get('new_password'), confirm_password: f.get('confirm_password')}, () => { this.reset(); alert('Password updated successfully.'); });">
            <div class="md:col-span-2">
                <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">Current Password</label>
                <input class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" type="password" name="current_password" autocomplete="current-password" required>
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">New Password</label>
                <input class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" type="password" name="new_password" autocomplete="new-password" required minlength="8" placeholder="Minimum 8 characters">
            </div>
            <div>
                <label class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1">Confirm Password</label>
                <input class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" type="password" name="confirm_password" autocomplete="new-password" required minlength="8" placeholder="Repeat new password">
            </div>
            <div class="md:col-span-2 flex justify-end">
                <button class="rounded-xl bg-wms-600 text-white px-4 py-2 text-sm font-medium" type="submit">Update password</button>
            </div>
        </form>
    </section>
</div>
{/block}