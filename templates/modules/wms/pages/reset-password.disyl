<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{page_title|default:'Reset Password'} — {gui.app_name}</title>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root { --primary: {gui.color_primary}; --primary-hover: {gui.color_primary_hover}; --primary-light: {gui.color_primary_light}; --bg: {gui.color_bg}; --surface: {gui.color_surface}; --border: {gui.color_border}; --text: {gui.color_text}; --text-muted: {gui.color_text_muted}; }
        body { font-family: {gui.font_family|raw}; background: var(--bg); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
        .card { background: var(--surface); border-radius: 12px; box-shadow: 0 4px 24px rgba(0,0,0,.08); width: 100%; max-width: 380px; padding: 40px 32px; }
        .card h1 { font-size: 24px; font-weight: 700; color: var(--text); text-align: center; margin-bottom: 6px; }
        .card p { font-size: 13px; color: var(--text-muted); text-align: center; margin-bottom: 24px; }
        .form-group { margin-bottom: 20px; }
        .form-label { display: block; font-size: 13px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px; }
        .form-input { width: 100%; padding: 10px 14px; border: 1px solid var(--border); border-radius: 8px; font-size: 15px; font-family: inherit; }
        .form-input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-light); }
        .btn { width: 100%; padding: 12px; background: var(--primary); color: #fff; border: none; border-radius: 8px; font-size: 15px; font-weight: 600; font-family: inherit; cursor: pointer; }
        .btn:hover { background: var(--primary-hover); }
        .back-link { display: block; text-align: center; margin-top: 16px; color: var(--text-muted); font-size: 13px; text-decoration: none; }
        .back-link:hover { color: var(--primary); }
        .msg { padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 16px; display: none; }
        .msg.success { display: block; background: #dcfce7; color: #15803d; }
        .msg.error { display: block; background: #fee2e2; color: #dc2626; }
    </style>
</head>
<body>
    <div class="card">
        {if token_valid}
        <h1>🔐 Reset Password</h1>
        <p>Enter your new password.</p>
        <div id="reset-msg" class="msg"></div>
        <form id="reset-form" onsubmit="return handleReset(event)">
            <input type="hidden" name="token" value="{reset_token}">
            <div class="form-group">
                <label class="form-label" for="password">New Password</label>
                <input class="form-input" type="password" id="password" name="password" minlength="8" required>
            </div>
            <div class="form-group">
                <label class="form-label" for="confirm_password">Confirm Password</label>
                <input class="form-input" type="password" id="confirm_password" name="confirm_password" minlength="8" required>
            </div>
            <button type="submit" class="btn" id="reset-btn">Reset Password</button>
        </form>
        {else}
        <h1>🔐 Invalid Link</h1>
        <p>This password reset link is invalid or has expired.</p>
        <a href="{login_page_url}" class="btn" style="display:block;text-align:center;text-decoration:none;margin-top:16px;">Go to Sign In</a>
        {/if}
        <a href="{login_page_url}" class="back-link">← Back to Sign In</a>
    </div>
    <script>
        function handleReset(e) {
            e.preventDefault();
            var btn = document.getElementById('reset-btn');
            var msgEl = document.getElementById('reset-msg');
            var pw = document.getElementById('password').value;
            var cpw = document.getElementById('confirm_password').value;
            if (pw !== cpw) {
                msgEl.className = 'msg error';
                msgEl.textContent = 'Passwords do not match.';
                return false;
            }
            btn.disabled = true;
            btn.textContent = 'Resetting...';
            fetch('{reset_password_endpoint}', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({token: '{reset_token}', password: pw, confirm_password: cpw})
            })
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.ok) {
                    msgEl.className = 'msg success';
                    msgEl.textContent = res.message || 'Password reset successfully!';
                    btn.textContent = 'Redirecting...';
                    setTimeout(function() { window.location.href = '{login_page_url}'; }, 2000);
                } else {
                    msgEl.className = 'msg error';
                    msgEl.textContent = res.error || 'Reset failed.';
                    btn.disabled = false;
                    btn.textContent = 'Reset Password';
                }
            })
            .catch(function() {
                msgEl.className = 'msg error';
                msgEl.textContent = 'Network error.';
                btn.disabled = false;
                btn.textContent = 'Reset Password';
            });
            return false;
        }
    </script>
</body>
</html>
