<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{page_title} - WMS Scanner</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <style>
        /* Mobile specific utility to prevent overscroll bounce and text select */
        body { overscroll-behavior-y: none; -webkit-user-select: none; user-select: none; }
        input, textarea { -webkit-user-select: text; user-select: text; }
    </style>
</head>
<body class="bg-slate-100 text-slate-900 h-screen flex flex-col font-sans antialiased" x-data="{ scanning: false }">

    <!-- Top App Bar -->
    <header class="bg-wms-600 text-white p-4 shadow-md flex items-center justify-between z-10 shrink-0">
        <div class="flex items-center gap-3">
            <a href="{base_url}/wms/scanner" class="flex items-center justify-center w-8 h-8 rounded-full bg-white/20 hover:bg-white/30 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            </a>
            <h1 class="text-xl font-bold tracking-tight truncate">{page_title}</h1>
        </div>
        <div class="flex items-center gap-2">
            <span class="text-sm font-medium opacity-80">{auth_user.name}</span>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 overflow-y-auto p-4 relative">
        {content|raw}
    </main>

    <!-- Bottom Nav Bar -->
    <footer class="bg-white border-t border-slate-200 shrink-0 pb-safe">
        <nav class="flex justify-around">
            <a href="{base_url}/wms/scanner" class="flex flex-col items-center py-3 px-2 flex-1 {if current_page == 'scanner_home'}text-wms-600 border-t-2 border-wms-600{else}text-slate-500 hover:bg-slate-50{/if}">
                <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                <span class="text-[10px] font-medium uppercase tracking-wider">My Tasks</span>
            </a>
            <button @click="scanning = !scanning" class="flex flex-col items-center py-3 px-2 flex-1 text-slate-500 hover:bg-slate-50">
                <div class="bg-wms-600 text-white rounded-full p-2 -mt-6 shadow-lg border-4 border-slate-100">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm14 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path></svg>
                </div>
                <span class="text-[10px] font-medium uppercase tracking-wider mt-1">Scan</span>
            </button>
            <a href="{base_url}/wms" class="flex flex-col items-center py-3 px-2 flex-1 text-slate-500 hover:bg-slate-50">
                <svg class="w-6 h-6 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                <span class="text-[10px] font-medium uppercase tracking-wider">Exit</span>
            </a>
        </nav>
    </footer>

    <!-- Global Fake Barcode Scanner Overlay (Simulates camera or wedge scanner input focus) -->
    <div x-show="scanning" x-cloak class="absolute inset-0 bg-slate-900 z-50 flex flex-col">
        <div class="p-4 flex justify-end">
            <button @click="scanning = false" class="text-white p-2 bg-white/10 rounded-full">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div class="flex-1 flex flex-col items-center justify-center p-6 text-center">
            <div class="w-64 h-64 border-2 border-dashed border-green-500 rounded-xl relative mb-8 flex items-center justify-center">
                <div class="absolute w-full h-1 bg-green-500 shadow-[0_0_10px_2px_rgba(34,197,94,0.5)] animate-pulse"></div>
                <p class="text-white/50 text-sm">Awaiting Scanner Input...</p>
            </div>
            
            <!-- Manual Wedge Input for Testing -->
            <input type="text" id="wedgeInput" x-effect="if(scanning) setTimeout(() => document.getElementById('wedgeInput').focus(), 100)"
                class="bg-slate-800 text-white border border-slate-700 rounded px-4 py-3 w-full max-w-sm text-center text-xl tracking-widest focus:ring-2 focus:ring-green-500 focus:outline-none" 
                placeholder="Or type barcode..." 
                @keydown.enter.prevent="if ($event.target.value.trim() !== '') { window.handleScan($event.target.value.trim()); } $event.target.value = ''; scanning = false">
                
            <p class="mt-4 text-slate-400 text-sm">Hardware wedge scanners emit an 'Enter' keypress automatically.</p>
        </div>
    </div>

    <script>
        // Global scan handler hook
        window.handleScan = function(barcode) {
            const event = new CustomEvent('wms-barcode-scanned', { detail: { barcode } });
            window.dispatchEvent(event);
        };

        // Listen for hardware wedge scanners typing rapidly globally
        let scanBuffer = '';
        let scanTimer;
        document.addEventListener('keypress', (e) => {
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
            
            if (e.key === 'Enter') {
                if (scanBuffer.length > 3) {
                    window.handleScan(scanBuffer);
                }
                scanBuffer = '';
                return;
            }
            
            scanBuffer += e.key;
            clearTimeout(scanTimer);
            scanTimer = setTimeout(() => { scanBuffer = ''; }, 100); // 100ms threshold for human vs scanner
        });
    </script>
</body>
</html>
