<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title|default:'WMS'} — Warehouse Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>
        * { border-radius: 4px !important; }
        @media print { .no-print { display: none !important; } }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    {csrf_field | raw}
    <div class="flex h-screen overflow-hidden">
        <!-- Sidebar -->
        <aside class="w-56 bg-slate-900 flex flex-col shrink-0">
            <div class="p-4 border-b border-slate-700">
                <h1 class="text-lg font-bold text-white">📦 WMS</h1>
                <p class="text-xs text-slate-400">{current_user.full_name|default:''}</p>
            </div>
            <nav class="flex-1 overflow-y-auto p-2 space-y-0.5">
                {for item in menu_items}
                <a href="{item.path}"
                   class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors {if page_content == item.label|lower}bg-slate-700 text-white{/if}">
                    <span>{item.icon}</span>
                    <span>{item.label}</span>
                </a>
                {/for}
            </nav>
            <div class="p-3 border-t border-slate-700">
                <a href="/wms/logout" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-slate-400 hover:text-white hover:bg-slate-700 transition-colors">
                    <span>🚪</span> Logout
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 overflow-y-auto p-6">
            {page_body|raw}
        </main>
    </div>
</body>
</html>
