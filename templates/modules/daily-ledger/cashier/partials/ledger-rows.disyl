{foreach rows as row}
<tr data-product-id="{row.product_id}">
    <td class="row-num w-14 whitespace-nowrap text-center align-middle text-sm text-gray-500">{loop.index1}</td>
    <td class="product-name whitespace-nowrap align-middle font-medium text-gray-900">{row.name}</td>
    <td class="align-middle text-right">
        <input type="number" class="ledger-input mt-0 ml-auto block w-20 rounded-lg border border-gray-300 bg-white px-2 py-1.5 text-right text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" inputmode="numeric" min="0"
               data-product="{row.product_id}" data-field="beg_bal"
               value="{row.beg_bal}"
               onchange="saveField(this)"
               {if day_status == 'closed' || reference_only}disabled{/if}>
    </td>
    <td class="align-middle text-right">
        <input type="number" class="ledger-input mt-0 ml-auto block w-20 rounded-lg border border-gray-300 bg-white px-2 py-1.5 text-right text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" inputmode="numeric" min="0"
               data-product="{row.product_id}" data-field="addtl"
               value="{row.addtl}"
               onchange="saveField(this)"
               {if day_status == 'closed' || reference_only}disabled{/if}>
    </td>
    <td class="align-middle text-right">
        <input type="number" class="ledger-input mt-0 ml-auto block w-20 rounded-lg border border-gray-300 bg-white px-2 py-1.5 text-right text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" inputmode="numeric" min="0"
               data-product="{row.product_id}" data-field="withdraw"
               value="{row.withdraw}"
               onchange="saveField(this)"
               {if day_status == 'closed' || reference_only}disabled{/if}>
    </td>
    <td class="align-middle text-right">
        <input type="number" class="ledger-input mt-0 ml-auto block w-20 rounded-lg border border-gray-300 bg-white px-2 py-1.5 text-right text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" inputmode="numeric" min="0"
               data-product="{row.product_id}" data-field="bal_end"
               value="{row.bal_end}"
               onchange="saveField(this)"
               {if day_status == 'closed' || reference_only}disabled{/if}>
    </td>
    <td class="align-middle text-right">
        <span class="sales-computed ml-auto inline-flex w-20 justify-end rounded-lg bg-gray-50 px-2 py-1.5 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-200" data-product="{row.product_id}">{row.sales}</span>
    </td>
</tr>
{/foreach}
