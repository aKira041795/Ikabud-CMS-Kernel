{foreach rows as row}
<tr data-product-id="{row.product_id}" data-pack="{if row.pcs_per_pack}{row.pcs_per_pack}{else}0{/if}">
    <td class="ledger-num row-num">{loop.index1}</td>
    <td class="ledger-name product-name">{row.name}</td>
    <td class="align-middle text-right">
        <input type="number" class="ledger-cell ledger-input" inputmode="numeric" enterkeyhint="next" min="0"
               data-product="{row.product_id}" data-field="beg_bal"
               value="{if shift == 'PM' && row.beg_bal == 0 && row.am_bal_end > 0}{row.am_bal_end}{elseif shift == 'AM' && row.beg_bal == 0 && row.prev_bal_end !== null && row.prev_bal_end !== ''}{row.prev_bal_end}{else}{row.beg_bal}{/if}"
               data-am-end="{if shift == 'PM'}{row.am_bal_end}{else}0{/if}"
               data-prev-end="{row.prev_bal_end}"
               data-orig-beg="{row.beg_bal}"
               onfocus="dlSnapshotCell(this); this.select()"
               onchange="saveField(this)"
               {if day_status == 'closed' || reference_only || shift_status == 'finalized'}disabled{/if}>
        {if shift == 'PM'}
        <div class="mt-0.5 text-xs leading-tight text-indigo-600">AM end: {row.am_bal_end}</div>
        {elseif row.prev_bal_end !== null && row.prev_bal_end !== ''}
        <div class="mt-0.5 text-xs leading-tight text-indigo-600">Prev end: {row.prev_bal_end}</div>
        {elseif row.prev_pm_pending}
        <div class="mt-0.5 text-xs leading-tight text-indigo-600">PM ending pending</div>
        {/if}
    </td>
    <td class="align-middle text-right">
        {if day_status == 'open' && !reference_only && shift_status != 'finalized'}
        <button type="button"
                class="ledger-trigger ledger-trigger-add addtl-trigger"
                data-product="{row.product_id}"
                onclick="dlAddStockDirect({row.product_id})"
                title="Add stock — no paper DR needed. Records a missed or undercounted entry; charge a person only if stock was actually lost. Use Receive Stock for a DR-tracked delivery.">
            <span class="addtl-value" data-field="addtl" data-product="{row.product_id}">{row.addtl}</span>
            <i class="fas fa-plus text-[10px]" aria-hidden="true"></i>
        </button>
        {else}
        <span class="ledger-chip"
              data-field="addtl" data-product="{row.product_id}">{row.addtl}</span>
        {/if}
    </td>
    <td class="align-middle text-right">
        {if day_status == 'open' && !reference_only && shift_status != 'finalized'}
        <button type="button"
                class="ledger-trigger ledger-trigger-out withdraw-trigger"
                data-product="{row.product_id}"
                onclick="dlAdjustRowDirect({row.product_id})"
                title="Record an adjustment for {row.name} — charge, pullout, used or correction. Opens Stock Adjustment on this product.">
            <span class="withdraw-total" data-field="withdraw" data-product="{row.product_id}">{row.withdraw}</span>
            <i class="fas fa-minus text-[10px]" aria-hidden="true"></i>
        </button>
        {else}
        <span class="ledger-chip withdraw-total"
              data-product="{row.product_id}" data-field="withdraw">{row.withdraw}</span>
        {/if}
    </td>
    <td class="align-middle text-right">
        <input type="number" class="ledger-cell ledger-input" inputmode="numeric" enterkeyhint="next" min="0"
               data-product="{row.product_id}" data-field="bal_end"
               value="{if row.bal_end !== null && row.bal_end !== ''}{row.bal_end}{/if}"
               onfocus="dlSnapshotCell(this); this.select()"
               onchange="saveField(this)"
               {if day_status == 'closed' || reference_only || shift_status == 'finalized'}disabled{/if}>
    </td>
    <td class="align-middle text-right">
        {if row.bal_end !== null && row.bal_end !== ''}
        <span class="ledger-chip sales-computed" data-product="{row.product_id}">{row.sales}</span>
        {else}
        <span class="ledger-chip ledger-chip-pending sales-computed" data-product="{row.product_id}" data-pending="1">Pending</span>
        {/if}
    </td>
</tr>
{/foreach}
