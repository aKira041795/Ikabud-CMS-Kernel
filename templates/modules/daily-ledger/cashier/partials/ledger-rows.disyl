{foreach rows as row}
<tr data-product-id="{row.product_id}">
    <td class="row-num w-14 whitespace-nowrap text-center align-middle text-sm text-gray-500">{loop.index1}</td>
    <td class="product-name whitespace-nowrap align-middle font-medium text-gray-900">{row.name}</td>
    <td class="align-middle text-right">
        <input type="number" class="ledger-input mt-0 ml-auto block w-20 rounded-lg border border-gray-300 bg-white px-2 py-1.5 text-right text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" inputmode="numeric" min="0"
               data-product="{row.product_id}" data-field="beg_bal"
               value="{if shift == 'PM' && row.beg_bal == 0 && row.am_bal_end > 0}{row.am_bal_end}{else}{row.beg_bal}{/if}"
               data-am-end="{if shift == 'PM'}{row.am_bal_end}{else}0{/if}"
               data-orig-beg="{row.beg_bal}"
               onfocus="this.select()"
               onchange="saveField(this)"
               {if day_status == 'closed' || reference_only}disabled{/if}>
        {if shift == 'PM'}
        <div class="mt-0.5 text-[10px] leading-tight text-indigo-600">AM end: {row.am_bal_end}</div>
        {/if}
    </td>
    <td class="align-middle text-right">
        {if day_status == 'open' && !reference_only}
        <button type="button"
                class="addtl-trigger ml-auto inline-flex w-20 items-center justify-end gap-1 rounded-lg border border-emerald-300 bg-emerald-50 px-2 py-1.5 text-sm font-semibold text-emerald-800 shadow-sm ring-1 ring-inset ring-emerald-200 hover:bg-emerald-100"
                data-product="{row.product_id}"
                onclick="openReceiveModal()"
                title="Add stock — opens Receive Stock so the DR is recorded">
            <span class="addtl-value" data-field="addtl" data-product="{row.product_id}">{row.addtl}</span>
            <i class="fas fa-plus text-[10px]" aria-hidden="true"></i>
        </button>
        {else}
        <span class="ml-auto inline-flex w-20 justify-end rounded-lg bg-gray-50 px-2 py-1.5 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-200"
              data-field="addtl" data-product="{row.product_id}">{row.addtl}</span>
        {/if}
    </td>
    <td class="align-middle text-right">
        {if day_status == 'open' && !reference_only}
        <button type="button"
                class="withdraw-trigger ml-auto inline-flex w-20 items-center justify-end gap-1 rounded-lg border border-amber-300 bg-amber-50 px-2 py-1.5 text-sm font-semibold text-amber-800 shadow-sm ring-1 ring-inset ring-amber-200 hover:bg-amber-100"
                data-product="{row.product_id}"
                onclick="openWithdrawalModal()"
                title="Record adjustment — opens Stock Adjustment">
            <span class="withdraw-total" data-field="withdraw" data-product="{row.product_id}">{row.withdraw}</span>
            <i class="fas fa-minus text-[10px]" aria-hidden="true"></i>
        </button>
        {else}
        <span class="withdraw-total ml-auto inline-flex w-20 justify-end rounded-lg bg-gray-50 px-2 py-1.5 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-200"
              data-product="{row.product_id}" data-field="withdraw">{row.withdraw}</span>
        {/if}
    </td>
    <td class="align-middle text-right">
        <input type="number" class="ledger-input mt-0 ml-auto block w-20 rounded-lg border border-gray-300 bg-white px-2 py-1.5 text-right text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" inputmode="numeric" min="0"
               data-product="{row.product_id}" data-field="bal_end"
               value="{row.bal_end}"
               onfocus="this.select()"
               onchange="saveField(this)"
               {if day_status == 'closed' || reference_only}disabled{/if}>
    </td>
    <td class="align-middle text-right">
        <span class="sales-computed ml-auto inline-flex w-20 justify-end rounded-lg bg-gray-50 px-2 py-1.5 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-200" data-product="{row.product_id}">{row.sales}</span>
    </td>
</tr>
{/foreach}
