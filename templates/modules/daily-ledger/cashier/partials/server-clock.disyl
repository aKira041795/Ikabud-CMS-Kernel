{* Server clock for the top bar.

   Shows the server's current time rendered in the BUSINESS timezone, so anyone
   can confirm at a glance that the clock driving shift and day boundaries is
   correct. A host left on UTC reads "AM" through the local afternoon, which sent
   adjustments to the wrong shift row; the timezone and offset are printed next to
   the time so that mismatch is obvious instead of invisible.

   Ticking is anchored to the server epoch supplied by dl_operatingClockLabel()
   and formatted in the business timezone, so the display never silently switches
   to the viewer's own timezone.

   The business timezone stays authoritative (it is what the ledger, shifts and
   business date follow), so the VIEWER's zone is compared against it rather than
   adopted: when the two differ the note turns into an explicit warning naming
   both zones. Silently following a device clock would let one misconfigured phone
   move the accounting day. *}
{if server_now_label}
<div class="hidden md:flex flex-col items-end gap-0.5"
     data-server-clock-root
     data-operating-timezone="{operating_timezone}">
    <div class="flex items-center gap-2 rounded-lg bg-gray-50 px-3 py-1.5 ring-1 ring-inset ring-gray-200"
         title="Current time on the server, shown in the business timezone. Shift and day boundaries follow this clock.">
        <i class="fas fa-clock text-gray-400 text-xs" aria-hidden="true"></i>
        <div class="leading-tight">
            <div class="text-xs font-semibold text-gray-800 whitespace-nowrap"
                 id="dl-server-clock"
                 data-server-epoch-ms="{server_epoch_ms}"
                 data-server-timezone="{operating_timezone}">{server_now_label}</div>
            <div class="text-[10px] text-gray-500 whitespace-nowrap">
                server time · {operating_timezone} <span class="font-mono">{server_now_offset}</span>
            </div>
        </div>
    </div>
{* Filled in client-side only: hidden until the viewer's zone is known, then
   swapped to the amber warning style when it differs from the business zone. *}
<div id="dl-device-timezone-note"
     class="hidden rounded px-2 py-0.5 text-[10px] font-semibold leading-tight text-right"
     role="status"
     aria-live="polite"></div>
</div>
<script>
(function () {
    var el = document.getElementById('dl-server-clock');
    if (!el || el.dataset.dlClockBound === '1') return;
    var zone = el.getAttribute('data-server-timezone') || '';
    var serverEpoch = parseInt(el.getAttribute('data-server-epoch-ms'), 10);
    if (!zone || !serverEpoch) return; // keep the server-rendered string
    el.dataset.dlClockBound = '1';

    var skew = Date.now() - serverEpoch;
    var formatter = null;
    try {
        // Must mirror server_now_label's PHP format ('D, M j, Y, h:i:s A') so the
        // first tick does not change the rendering.
        formatter = new Intl.DateTimeFormat('en-US', {
            timeZone: zone, weekday: 'short', day: '2-digit', month: 'short',
            year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true
        });
    } catch (e) {
        formatter = null; // unknown timezone: fall back to the epoch's UTC text
    }

    function tick() {
        var now = new Date(Date.now() - skew);
        el.textContent = formatter ? formatter.format(now) : now.toUTCString();
    }
    tick();
    setInterval(tick, 1000);

    // Compare the viewer's own zone with the business zone. The business zone wins
    // (it drives shifts and the business date); this only makes a difference
    // impossible to miss for the operator sitting in front of the screen.
    var deviceZone = '';
    try {
        deviceZone = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
    } catch (e) {
        deviceZone = '';
    }
    var note = document.getElementById('dl-device-timezone-note');
    if (!deviceZone || !note) return;

    var MATCH_CLASS = 'hidden rounded px-2 py-0.5 text-[10px] font-semibold leading-tight text-right text-emerald-700';
    var MISMATCH_CLASS = 'rounded px-2 py-0.5 text-[10px] font-semibold leading-tight text-right text-amber-800 bg-amber-100 ring-1 ring-inset ring-amber-300';

    function paintNote() {
        if (deviceZone === zone) {
            note.className = MATCH_CLASS;
            note.classList.remove('hidden');
            note.textContent = 'matches this device';
            return;
        }
        var local = '';
        try {
            local = new Intl.DateTimeFormat('en-US', {
                timeZone: deviceZone, hour: '2-digit', minute: '2-digit', hour12: true
            }).format(new Date(Date.now() - skew));
        } catch (e) {
            local = '';
        }
        note.className = MISMATCH_CLASS;
        note.textContent = '\u26a0 this device is on ' + deviceZone + (local ? ' (' + local + ')' : '') +
            ' \u2014 shifts and dates follow ' + zone + '. Check the Settings timezone.';
    }
    paintNote();
    setInterval(paintNote, 30000);
})();
</script>
{/if}
