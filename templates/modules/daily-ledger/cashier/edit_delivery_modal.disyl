<!-- Correct Delivery by DR Modal -->
<div x-data="editDeliveryModal()"
     x-cloak
     x-on:open-edit-delivery-modal.window="openModal($event.detail)"
     class="relative z-50" aria-labelledby="edit-delivery-title" role="dialog" aria-modal="true" x-show="isOpen">
    <div x-show="isOpen" x-transition.opacity class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
    <div class="fixed inset-0 z-10 overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div x-show="isOpen"
                 x-transition:enter="ease-out duration-300"
                 x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                 x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
                 x-transition:leave="ease-in duration-200"
                 x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
                 x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                 @click.away="closeModal()"
                 class="relative transform overflow-hidden rounded-lg bg-white px-4 pb-4 pt-5 text-left shadow-xl transition-all sm:my-8 w-full sm:max-w-3xl sm:p-6">

                <div>
                    <h3 class="text-lg font-semibold leading-6 text-gray-900" id="edit-delivery-title">Correct Delivery by DR</h3>
                    <p class="text-sm text-gray-500 mb-4">Fix a stock delivery captured from a paper DR — add missed items or correct quantities. The origin withdrawal always moves with the corrected sent quantity. An <span class="font-semibold">admin</span> correction also moves the receiving branch's stock, so both branches agree from one DR; a branch correction leaves the count as evidence and records the difference as a delivery issue for the office. A reason is recorded.</p>

                    <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-900">
                        Enter the paper DR number first. The current items are loaded so you only correct what changed. This is available for the current business date only.
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Paper DR Number <span class="text-rose-500">*</span></label>
                            <div class="flex gap-2">
                                <input type="text" x-model="drNumber" class="form-input mt-0 w-full font-mono uppercase" placeholder="e.g. 12345">
                                <button type="button" class="btn btn-accent whitespace-nowrap" @click="loadDelivery()" x-bind:disabled="loading">
                                    <span x-text="loading ? 'Loading...' : 'Load'"></span>
                                </button>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Reason for Correction <span class="text-rose-500">*</span></label>
                            <input type="text" x-model="reason" maxlength="255" class="form-input mt-0 w-full" placeholder="e.g. Missed item on the paper DR">
                        </div>
                    </div>

                    <template x-if="notFoundMsg">
                        <div class="mb-3 rounded-md bg-rose-50 p-3 text-sm text-rose-700" x-text="notFoundMsg"></div>
                    </template>

                    <div class="mb-3 bg-gray-50 rounded-lg p-3" x-show="loaded">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-sm font-semibold text-gray-800" x-text="'DR ' + drNumber + ' — adjust items'"></span>
                            <span class="text-xs text-gray-500" x-text="'Loaded ' + loadedCount + ' item(s)'"></span>
                        </div>
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="border-b border-gray-200">
                                    <th class="py-2 text-left font-medium text-gray-700">Product</th>
                                    <th class="py-2 text-right font-medium text-gray-700 w-24">Pcs</th>
                                    <th class="py-2 w-10"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-for="(line, idx) in lines" :key="idx">
                                    <tr class="border-b border-gray-100">
                                        <td class="py-2 pr-2 align-top">
                                            {* ONE control, not a search box above a <select>: typing filters the list and the
                                               matches appear immediately underneath, so the operator sees products as they type.
                                               The panel is in normal flow on purpose — the modal panel is overflow-hidden, an
                                               absolutely positioned list would be clipped at its edge. *}
                                            <div @click.outside="line.productOpen = false">
                                                <input type="text" class="form-input mt-0 w-full" placeholder="Type to find a product…"
                                                       autocomplete="off" role="combobox" aria-autocomplete="list" aria-label="Search product"
                                                       :aria-expanded="line.productOpen ? 'true' : 'false'"
                                                       :value="dlProductDisplay(line, products)"
                                                       @focus="dlProductOpen(line)"
                                                       @input="dlProductInput(line, $event.target.value)"
                                                       @keydown.arrow-down.prevent="dlProductMove(line, products, 1)"
                                                       @keydown.arrow-up.prevent="dlProductMove(line, products, -1)"
                                                       @keydown.enter.prevent="dlProductCommit(line, products)"
                                                       @keydown.escape="dlProductClose(line)"
                                                       @blur="dlProductBlur(line)">
                                                <div x-show="line.productOpen" x-cloak role="listbox"
                                                     class="mt-1 max-h-56 w-full overflow-y-auto rounded-lg border border-slate-200 bg-white py-1 text-sm shadow-sm">
                                                    <template x-for="(p, pi) in dlProductMatches(products, line.productQuery)" :key="p.id">
                                                        <button type="button" role="option"
                                                                class="flex w-full items-center justify-between gap-2 px-3 py-1.5 text-left hover:bg-indigo-50"
                                                                :class="pi === (line.productActive || 0) ? 'bg-indigo-50' : ''"
                                                                :aria-selected="String(p.id) === String(line.product_id) ? 'true' : 'false'"
                                                                @mousedown.prevent
                                                                @click="dlProductPick(line, p)">
                                                            <span class="truncate" x-text="p.name"></span>
                                                            <span class="shrink-0 text-xs text-slate-400" x-text="p.sku"></span>
                                                        </button>
                                                    </template>
                                                    <div x-show="dlProductMatches(products, line.productQuery).length === 0"
                                                         class="px-3 py-2 text-sm text-slate-500">No product matches “<span x-text="line.productQuery"></span>”.</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-2 pr-2">
                                            <input type="number" x-model="line.quantity" min="0" class="form-input mt-0 text-right w-full">
                                        </td>
                                        <td class="py-2 text-right">
                                            <button type="button" @click="lines.splice(idx, 1)" class="text-rose-500 hover:text-rose-700 p-1 rounded hover:bg-rose-50">
                                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                                </svg>
                                            </button>
                                        </td>
                                    </tr>
                                </template>
                            </tbody>
                        </table>
                        <button type="button" @click="addEmptyLine()" class="btn btn-accent w-full justify-center mt-3">+ Add Missed Item</button>
                        <p class="mt-2 text-xs text-gray-500">Set a quantity to 0 or remove a row to drop that item from the delivery.</p>
                    </div>

                    <div x-show="errorMsg" class="mb-3 flex items-start gap-2 rounded-md border border-rose-300 bg-rose-50 px-3 py-2">
                        <i class="fas fa-triangle-exclamation mt-0.5 text-rose-600" aria-hidden="true"></i>
                        <p class="text-sm leading-5 text-rose-800" x-text="errorMsg"></p>
                    </div>
                </div>

                <div class="mt-5 sm:mt-6 sm:flex sm:flex-row-reverse border-t border-gray-200 pt-4">
                    <button type="button" @click="saveChanges()" class="inline-flex w-full items-center justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 sm:ml-3 sm:w-auto" x-bind:disabled="saving || !loaded">
                        <svg x-show="saving" class="mr-2 h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                        </svg>
                        <span x-text="saving ? 'Saving...' : 'Save Correction'"></span>
                    </button>
                    <button type="button" @click="closeModal()" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto" x-bind:disabled="saving">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
window.openEditDeliveryModal = function() {
    window.dispatchEvent(new CustomEvent('open-edit-delivery-modal', { detail: {} }));
};

function editDeliveryModal() {
    return {
        isOpen: false,
        saving: false,
        loading: false,
        loaded: false,
        loadedCount: 0,
        drNumber: '',
        reason: '',
        errorMsg: '',
        notFoundMsg: '',
        lines: [],
        products: [],

        openModal() {
            this.errorMsg = '';
            this.notFoundMsg = '';
            this.drNumber = '';
            this.reason = '';
            this.lines = [];
            this.loaded = false;
            this.loadedCount = 0;
            this.loadProducts();
            this.isOpen = true;
        },

        closeModal() { this.isOpen = false; },

        addEmptyLine() { this.lines.push({ product_id: '', quantity: '' }); },

        loadProducts() {
            this.products = [];
            var rows = document.querySelectorAll('tr[data-product-id]');
            var seen = {};
            rows.forEach(function(r) {
                var pid = r.getAttribute('data-product-id');
                var nm = (r.querySelector('.product-name') || {}).textContent || '';
                if (pid && !seen[pid]) {
                    seen[pid] = true;
                    this.products.push({ id: pid, name: nm.trim() });
                }
            }.bind(this));
        },

        authHeaders() {
            return {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            };
        },

        loadDelivery() {
            var dr = (this.drNumber || '').trim();
            if (!dr) { this.notFoundMsg = 'Enter a DR number first.'; return; }
            this.loading = true;
            this.errorMsg = '';
            this.notFoundMsg = '';
            var qs = 'branch_id=' + encodeURIComponent(window.BRANCH_ID || '') + '&dr_number=' + encodeURIComponent(dr);
            fetch(BASE + '/api/v1/cashier/ledger/delivery-detail?' + qs, {
                headers: this.authHeaders(),
                credentials: 'same-origin'
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                this.loading = false;
                if (!data.ok) {
                    this.notFoundMsg = data.error || 'Could not load this delivery.';
                    this.loaded = false;
                    this.lines = [];
                    return;
                }
                this.loaded = true;
                this.lines = (data.items || []).map(function(it) {
                    return { product_id: String(it.product_id), quantity: it.quantity };
                });
                this.loadedCount = this.lines.length;
            }.bind(this))
            .catch(function() {
                this.loading = false;
                this.notFoundMsg = 'Network error while loading the delivery.';
            }.bind(this));
        },

        validate() {
            this.errorMsg = '';
            if (!this.drNumber || String(this.drNumber).trim() === '') {
                this.errorMsg = 'DR number is required.';
                return false;
            }
            if (!this.reason || String(this.reason).trim() === '') {
                this.errorMsg = 'A correction reason is required.';
                return false;
            }
            var validLines = this.lines.filter(function(l) { return l.product_id && parseInt(l.quantity) > 0; });
            if (validLines.length === 0) {
                this.errorMsg = 'At least one product with a quantity greater than 0 is required.';
                return false;
            }
            return true;
        },

        saveChanges() {
            if (!this.validate()) return;
            this.saving = true;

            // Delivery correction needs the server delivery-detail lookup, so it
            // cannot run offline. Only the browser's own signal may decide this — a
            // failed PROBE is a heartbeat (refreshed at most every 120s, 10s while
            // amber), not proof the cloud is unreachable, and letting that stale guess
            // refuse the correction made it work or not apparently at random.
            if (!navigator.onLine) {
                this.saving = false;
                this.errorMsg = 'Not saved — correcting a delivery needs connectivity. Reconnect and try again.';
                return;
            }

            var payload = {
                branch_id: window.BRANCH_ID || null,
                // Shift being viewed — keeps the correction on the ledger row the
                // operator is actually looking at.
                shift: (window.SHIFT || ''),
                dr_number: (this.drNumber || '').trim(),
                reason: (this.reason || '').trim(),
                items: this.lines.filter(function(l) {
                    return l.product_id && l.quantity !== '' && !isNaN(parseInt(l.quantity, 10));
                }).map(function(l) {
                    return { product_id: parseInt(l.product_id, 10), quantity: Math.max(0, parseInt(l.quantity, 10)) };
                })
            };

            window.dlWriteTimeout(BASE + '/api/v1/cashier/ledger/delivery-edit', {
                method: 'POST',
                headers: this.authHeaders(),
                credentials: 'same-origin',
                body: JSON.stringify(payload)
            }, 'This correction')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                this.saving = false;
                if (data.ok) {
                    showToast('Delivery corrected', 'success');
                    this.closeModal();
                    if (typeof window.refreshMainContent === 'function') {
                        window.refreshMainContent();
                    }
                } else {
                    this.errorMsg = data.error || 'Failed to save the correction.';
                }
            }.bind(this))
            .catch(function(err) {
                this.saving = false;
                this.errorMsg = (err && err.dlTimedOut)
                    ? window.dlWriteTimeoutMessage('This correction')
                    : 'Not saved — the server could not be reached. Check the connection and retry.';
            }.bind(this));
        }
    };
}
</script>
