<!-- Receive Stock Modal -->
<div x-data="receiveModal()"
     x-cloak
     x-on:open-receive-modal.window="openModal()"
     class="relative z-50" aria-labelledby="receive-modal-title" role="dialog" aria-modal="true" x-show="isOpen">
    <div x-show="isOpen" x-transition.opacity class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
    <div class="fixed inset-0 z-10 overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div x-show="isOpen"
                 x-transition:enter="ease-out duration-300"
                 x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                 x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
                 x-transition:leave="ease-in duration-200"
                 x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
                 x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                 @click.away="closeModal()"
                 class="relative transform overflow-hidden rounded-lg bg-white px-4 pb-4 pt-5 text-left shadow-xl transition-all sm:my-8 w-full sm:max-w-3xl sm:p-6">

                <div>
                    <h3 class="text-lg font-semibold leading-6 text-gray-900" id="receive-modal-title">Receive Stock</h3>
                    <p class="text-sm text-gray-500 mb-4">Use this when stock is arriving into this branch. Receiving adds the accepted quantity to today's <span class="font-semibold">Addt'l</span> column.</p>
                    <div class="mb-4 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs leading-5 text-slate-700">
                        Two simple options live here: <span class="font-semibold">receive an already encoded transfer</span>, or if the truck arrived first, <span class="font-semibold">enter the paper DR and receive it now</span>. Use the second option only when no pending system record exists yet.
                    </div>
                    <div class="mb-4 grid gap-2 sm:grid-cols-2">
                        <div class="rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-3 text-xs text-indigo-900">
                            <div class="flex items-center gap-2">
                                <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-indigo-600 text-[11px] font-semibold text-white">1</span>
                                <span class="font-semibold">Search the DR first</span>
                            </div>
                            <p class="mt-2 leading-5">If the transfer is already in the system, receive it from the list below.</p>
                        </div>
                        {if formal_delivery_enabled}
                        <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-3 text-xs text-amber-900">
                            <div class="flex items-center gap-2">
                                <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-amber-600 text-[11px] font-semibold text-white">2</span>
                                <span class="font-semibold">Use Paper DR only if nothing appears</span>
                            </div>
                            <p class="mt-2 leading-5">Open the Paper DR entry only when the truck arrived first and no system record exists yet.</p>
                        </div>
                        {/if}
                    </div>

                    <template x-if="loading">
                        <div class="py-8 text-center text-sm text-gray-500">Loading transfers...</div>
                    </template>

                    <template x-if="!loading && deliveries.length === 0">
                        <div class="py-8 text-center text-sm text-gray-500">No pending transfers for this branch.</div>
                    </template>

                    <template x-if="!loading && deliveries.length > 0 && filteredDeliveries.length === 0 && !drFilter.trim()">
                        <div class="py-8 text-center text-sm text-gray-500">No pending transfers for this branch.</div>
                    </template>

                    <template x-if="errorMsg">
                        <div class="mb-3 rounded-md bg-rose-50 p-3 text-sm text-rose-700" x-text="errorMsg"></div>
                    </template>

                    <div class="mb-4 rounded-lg border border-slate-200 bg-white p-3">
                        <div class="mb-3 text-sm font-medium text-slate-700">
                            Receiving as: <span class="text-slate-900">{user_name}</span> &middot;
                            <template x-if="window.SHIFT_LOCKED">
                                <span class="inline-flex items-center text-slate-700">
                                    <i class="fas fa-lock mr-1 text-[10px]" aria-hidden="true"></i>
                                    <span x-text="receivingShift"></span>&nbsp;shift &middot; LOCKED
                                </span>
                            </template>
                            <template x-if="!window.SHIFT_LOCKED">
                                <span><span x-text="receivingShift || 'select below'"></span> shift</span>
                            </template>
                        </div>
                        <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-500">Required receipt shifts</div>
                        <div class="grid gap-3 sm:grid-cols-2">
                            <div>
                                <label class="block text-xs font-medium text-gray-700 mb-1">Received into (shift) *</label>
                                <template x-if="window.SHIFT_LOCKED">
                                    <div class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-600 ring-1 ring-inset ring-slate-300">
                                        <i class="fas fa-lock mr-1.5 text-[10px]" aria-hidden="true"></i>
                                        Locked to <span class="mx-1" x-text="receivingShift"></span> Shift
                                    </div>
                                </template>
                                <template x-if="!window.SHIFT_LOCKED">
                                    <select x-model="receivingShift" class="form-input mt-0 w-full">
                                        <option value="">-- Select receiving shift --</option>
                                        <option value="AM">AM</option>
                                        <option value="PM">PM</option>
                                    </select>
                                </template>
                                <p class="mt-1 text-[11px] text-gray-500">This is the ledger row that receives the stock.</p>
                            </div>
                            <div class="text-xs leading-5 text-slate-600">
                                The <span class="font-semibold">production shift</span> is the shift that sent the stock. It comes from the dispatch when the transfer was encoded in the system, otherwise from the paper DR below.
                            </div>
                        </div>
                    </div>

                    <!-- DR# search: cashier types the number from the paper DR -->
                    <div class="mb-4 rounded-lg border border-slate-200 bg-white p-3">
                           <div class="mb-1 text-xs font-semibold uppercase tracking-wide text-gray-500">Step 1: Receive an already encoded transfer</div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Find by Paper DR Number</label>
                        <input type="text"
                               x-model="drFilter"
                               placeholder="Enter the paper DR number"
                               class="w-full rounded-md border-2 border-indigo-300 bg-indigo-50 px-3 py-2.5 font-mono text-base font-semibold uppercase tracking-[0.18em] text-indigo-950 placeholder:text-sm placeholder:font-medium placeholder:normal-case placeholder:tracking-normal placeholder-indigo-400 focus:border-indigo-500 focus:ring-indigo-500"
                               autocomplete="off">
                        <template x-if="drFilter.trim() && filteredDeliveries.length === 0 && !loading">
                            <p class="mt-1 text-xs text-rose-600">No pending transfer was found for DR# "<span x-text="drFilter.trim()"></span>". Check the number and try again, or clear to browse all.</p>
                        </template>
                        <p class="mt-2 text-[11px] leading-5 text-gray-500">If the correct DR shows up below, use <span class="font-semibold text-gray-700">Receive Now</span>. Only use the Paper DR entry when nothing appears here.</p>
                    </div>

                    <div class="space-y-3 max-h-[60vh] overflow-y-auto">
                        <template x-for="(g, gi) in filteredDeliveries" :key="g.group_key">
                            <div class="rounded-lg border border-gray-200 bg-white p-3 shadow-sm">
                                <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                                    <div>
                                        <div class="inline-flex items-center rounded-lg bg-slate-900 px-3 py-1.5 font-mono text-sm font-semibold tracking-[0.18em] text-white shadow-sm" x-text="g.dr_number || 'NO DR'"></div>
                                        <div class="text-xs text-gray-500">
                                            From <span class="font-medium" x-text="g.origin_branch_name"></span>
                                            &middot; <span x-text="g.ledger_date"></span>
                                        </div>
                                        <template x-if="g.provenance_status === 'none'">
                                            <div class="mt-1 text-xs text-gray-700">
                                                Sent by: <span class="font-semibold" x-text="g.dispatching_cashier_name || 'not recorded (historical)'"></span>
                                            </div>
                                        </template>
                                        <template x-if="g.provenance_status === 'paper_dr_pending'">
                                            <div class="mt-1 text-xs font-semibold text-amber-800">
                                                not electronically dispatched - captured from paper DR
                                            </div>
                                        </template>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <template x-if="isPartial(g)">
                                            <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700 ring-1 ring-inset ring-amber-200">Partial</span>
                                        </template>
                                        <button type="button"
                                                class="btn btn-primary"
                                                x-bind:disabled="busyKey === g.group_key || hasInvalidCorrection(g)"
                                                x-effect="$el.disabled = busyKey === g.group_key || hasInvalidCorrection(g) || !canAcceptGroup(g)"
                                                @click="acceptGroup(g)">
                                            <span x-text="busyKey === g.group_key ? 'Receiving...' : 'Receive Now'"></span>
                                        </button>
                                    </div>
                                </div>
                                <template x-if="declaredReceivingShiftFor(g)">
                                    <div class="mb-3 rounded-md border p-2 text-xs leading-5"
                                         :class="receiptShiftMismatch(g) ? 'border-amber-300 bg-amber-50 text-amber-900' : 'border-indigo-200 bg-indigo-50 text-indigo-900'">
                                        <div><span class="font-semibold">Sender expected receiving shift:</span> <span x-text="declaredReceivingShiftFor(g)"></span></div>
                                        <div><span class="font-semibold">This receipt posts to:</span> <span x-text="receivingShift || 'not selected'"></span><span x-show="receivingShift"> shift</span></div>
                                        <p x-show="receiptShiftMismatch(g)" class="mt-1 font-semibold">
                                            Note: the sender expected <span x-text="declaredReceivingShiftFor(g)"></span>; this receipt posts to <span x-text="receivingShift"></span>. You can still receive it.
                                        </p>
                                    </div>
                                </template>
                                <div class="mb-3 rounded-md border border-amber-200 bg-amber-50 p-2">
                                    <label class="block text-xs font-semibold text-amber-900 mb-1">Production shift *</label>
                                    <select x-model="g.production_shift" class="form-input mt-0 w-full sm:w-40">
                                        <option value="">-- Select --</option>
                                        <option value="AM">AM</option>
                                        <option value="PM">PM</option>
                                    </select>
                                    <p class="mt-1 text-[11px] text-amber-800">Prefilled from the dispatch when known. Correct it if the paper DR differs.</p>
                                </div>
                                <p class="mb-2 text-xs font-medium text-slate-600">Confirm as sent, or correct the received qty if it differs.</p>
                                <table class="w-full text-sm">
                                    <thead class="text-xs uppercase text-gray-500">
                                        <tr>
                                            <th class="text-left py-1">Product</th>
                                            <th class="text-right py-1 pr-2">Sent</th>
                                            <th class="text-right py-1">Received</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <template x-for="it in g.items" :key="it.id">
                                            <tr class="border-t border-gray-100">
                                                <td class="py-1 text-gray-800" x-text="it.product_name"></td>
                                                <td class="py-1 text-right pr-2 text-gray-500" x-text="it.quantity"></td>
                                                <td class="py-1 text-right">
                                                    <input type="number"
                                                           class="w-20 rounded border border-gray-300 px-2 py-0.5 text-right text-sm focus:border-indigo-500 focus:ring-indigo-500"
                                                           :min="0"
                                                           :value="receivedQty(g, it)"
                                                           placeholder="Count"
                                                           @input="setReceivedQty(g, it, $event.target.value)">
                                                </td>
                                            </tr>
                                        </template>
                                    </tbody>
                                </table>
                            </div>
                        </template>
                    </div>

                    <div class="mt-4 rounded-lg border border-indigo-200 bg-indigo-50 p-3">
                        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                            <div>
                                <div class="text-sm font-semibold text-indigo-900">Step 2: Nothing found? Use the Paper DR</div>
                                <p class="mt-1 text-xs font-semibold text-indigo-900">not electronically dispatched — captured from paper DR</p>
                                <p class="mt-1 text-xs text-indigo-800">Use this only when the truck already arrived but the transfer was not encoded in the system yet. The paper DR remains the source of truth.</p>
                            </div>
                            <button type="button" class="btn btn-outline" @click="paperOpen = !paperOpen" x-text="paperOpen ? 'Hide Paper DR Entry' : 'Open Paper DR Entry'"></button>
                        </div>

                        <div class="mt-3 space-y-3" x-show="paperOpen" x-cloak>
                            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-5">
                                <div>
                                    <label class="block text-xs font-medium text-indigo-900 mb-1">Where stock came from</label>
                                    <select x-model="paperForm.origin_type" @change="paperForm.auto_dr = false; paperForm.origin_id = ''" class="form-input mt-0 w-full">
                                        <option value="commissary">Commissary</option>
                                        <option value="branch">Branch</option>
                                    </select>
                                </div>
                                <div x-show="paperForm.origin_type === 'branch'">
                                    <label class="block text-xs font-medium text-indigo-900 mb-1">Sending branch</label>
                                    <select x-model="paperForm.origin_id" class="form-input mt-0 w-full">
                                        <option value="">-- Select branch --</option>
                                        {foreach all_branches as b}
                                        {if b.id != branch_id}
                                        <option value="{b.id}">{b.code} — {b.name}</option>
                                        {/if}
                                        {/foreach}
                                    </select>
                                </div>
                                <div x-show="paperForm.origin_type === 'commissary'">
                                    <label class="block text-xs font-medium text-indigo-900 mb-1">Commissary</label>
                                    <select x-model="paperForm.origin_id" class="form-input mt-0 w-full">
                                        <option value="">-- Optional --</option>
                                        {foreach all_branches as b}
                                        {if b.id != branch_id && b.is_commissary == 1}
                                        <option value="{b.id}">{b.code} — {b.name}</option>
                                        {/if}
                                        {/foreach}
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-indigo-900 mb-1">Production shift (from paper DR) *</label>
                                    <select x-model="paperForm.production_shift" class="form-input mt-0 w-full border-amber-300 bg-amber-50">
                                        <option value="">-- Select shift --</option>
                                        <option value="AM">AM</option>
                                        <option value="PM">PM</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-indigo-900 mb-1">Date sent</label>
                                    <input type="date" x-model="paperForm.delivery_date" class="form-input mt-0 w-full">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-indigo-900 mb-1">Date received</label>
                                    <input type="date" x-model="paperForm.receive_date" class="form-input mt-0 w-full">
                                </div>
                                <div x-show="!paperForm.auto_dr">
                                    <label class="block text-xs font-medium text-indigo-900 mb-1">Paper DR Number</label>
                                    <input type="text" x-model="paperForm.dr_number" placeholder="Enter paper DR number" class="form-input mt-0 w-full border-indigo-300 bg-white font-mono text-base font-semibold uppercase tracking-[0.18em]">
                                </div>
                                <div class="flex items-start gap-2 rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2" x-show="paperForm.origin_type === 'commissary'">
                                    <input type="checkbox" x-model="paperForm.auto_dr" id="auto-dr-toggle" class="mt-0.5 h-4 w-4 rounded border-emerald-300 text-emerald-600 focus:ring-emerald-500">
                                    <label for="auto-dr-toggle" class="text-xs leading-5 text-emerald-900">
                                        <span class="font-semibold">No paper DR — auto-generate</span>
                                        <span class="block text-[11px] text-emerald-700">Goods from the commissary (production) arrived without a DR. The system creates one (dd/mm/yyyy-n) and logs it.</span>
                                    </label>
                                </div>
                                {* Delayed producer entry (066): filled from the paper sheet later, not
                                   inferred from whoever is encoding. Optional; blank = not recorded. *}
                                <div>
                                    <label class="block text-xs font-medium text-indigo-900 mb-1">Produced by <span class="font-normal text-indigo-700">(optional — from the paper sheet)</span></label>
                                    <select x-model="paperForm.produced_by" class="form-input mt-0 w-full">
                                        <option value="">-- Not recorded --</option>
                                        {foreach producer_options as pu}
                                        <option value="{pu.id}">{pu.label}</option>
                                        {/foreach}
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-indigo-900 mb-1">Produced at <span class="font-normal text-indigo-700">(optional — from the paper sheet)</span></label>
                                    <input type="datetime-local" x-model="paperForm.produced_at" class="form-input mt-0 w-full">
                                </div>
                            </div>

                            <div class="rounded-lg border border-indigo-200 bg-white p-3">
                                <table class="w-full text-sm">
                                    <thead>
                                        <tr class="border-b border-gray-200">
                                            <th class="py-2 text-left font-medium text-gray-700">Product</th>
                                            <th class="py-2 text-right font-medium text-gray-700 w-24">Pcs</th>
                                            <th class="py-2 w-10"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <template x-for="(line, idx) in paperForm.items" :key="idx">
                                            <tr class="border-b border-gray-100">
                                                <td class="py-2 pr-2">
                                                    <select x-model="line.product_id" class="form-input mt-0 py-1 px-2 w-full">
                                                        <option value="">-- Select Product --</option>
                                                        <template x-for="p in products" :key="p.id">
                                                            <option :value="p.id" x-text="p.name"></option>
                                                        </template>
                                                    </select>
                                                </td>
                                                <td class="py-2 pr-2">
                                                    <input type="number" x-model="line.quantity" min="0" class="form-input mt-0 py-1 px-2 text-right w-full">
                                                </td>
                                                <td class="py-2 text-right">
                                                    <button type="button" @click="paperForm.items.splice(idx, 1)" class="text-rose-500 hover:text-rose-700 p-1 rounded hover:bg-rose-50" x-show="paperForm.items.length > 1">×</button>
                                                </td>
                                            </tr>
                                        </template>
                                    </tbody>
                                </table>
                                <button type="button" class="btn btn-outline w-full justify-center mt-3" @click="addPaperItem()">+ Add Item</button>
                            </div>

                            <div class="flex justify-end">
                                <button type="button" class="btn btn-primary inline-flex items-center justify-center" x-bind:disabled="paperSaving || !canSubmitPaper()" @click="submitPaperDelivery()">
                                    <svg x-show="paperSaving" class="mr-2 h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                                    </svg>
                                    <span x-text="paperSaving ? 'Receiving...' : 'Save and Receive Paper DR'"></span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-5 sm:mt-6 sm:flex sm:flex-row-reverse">
                    <button type="button" @click="closeModal()" class="inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:w-auto">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
window.openReceiveModal = function() {
    window.dispatchEvent(new CustomEvent('open-receive-modal', { detail: {} }));
};

function receiveModal() {
    return {
        isOpen: false,
        loading: false,
        busyKey: '',
        errorMsg: '',
        deliveries: [],
        drFilter: '',
        paperOpen: false,
        paperSaving: false,
        receivingShift: (window.SHIFT || ''),
        products: [],
        paperForm: {
            origin_type: 'commissary',
            origin_id: '',
            delivery_date: '',
            receive_date: '',
            dr_number: '',
            auto_dr: false,
            production_shift: '',
            produced_by: '',
            produced_at: '',
            items: [{ product_id: '', quantity: '' }]
        },
        // partialQtys: { group_key: { product_id: qty } }
        partialQtys: {},

        get filteredDeliveries() {
            var q = this.drFilter.trim().toLowerCase();
            if (!q) return this.deliveries;
            return this.deliveries.filter(function(g) {
                return (g.dr_number || '').toLowerCase().includes(q);
            });
        },

        openModal() {
            this.errorMsg = '';
            this.partialQtys = {};
            this.drFilter = '';
            this.paperOpen = false;
            this.paperSaving = false;
            // Bound cashiers see this value locked; unbound users may deliberately
            // choose another receiving ledger shift.
            this.receivingShift = (window.SHIFT || '');
            this.resetPaperForm();
            this.loadProducts();
            this.isOpen = true;
            this.load();
        },

        closeModal() { this.isOpen = false; },

        resetPaperForm() {
            this.paperForm = {
                origin_type: 'commissary',
                origin_id: '',
                delivery_date: LEDGER_DATE,
                receive_date: LEDGER_DATE,
                dr_number: '',
                auto_dr: false,
                production_shift: '',
                produced_by: '',
                produced_at: '',
                items: [{ product_id: '', quantity: '' }]
            };
        },

        currentBranchId() {
            var sel = document.getElementById('branch-select');
            if (sel && sel.value) return sel.value;
            return window.BRANCH_ID || '';
        },

        loadProducts() {
            this.products = [];
            var rows = document.querySelectorAll('tr[data-product-id]');
            var seen = {};
            rows.forEach(function(r) {
                var pid = r.getAttribute('data-product-id');
                var nm = (r.querySelector('.product-name') || {}).textContent || '';
                if (pid && !seen[pid]) {
                    seen[pid] = true;
                    this.products.push({ id: pid, name: nm.trim() });
                }
            }.bind(this));
            if (rows.length === 0 && typeof window.dlReadProductReference === 'function') {
                window.dlReadProductReference().then(function(products) { this.products = products; }.bind(this));
            }
        },

        addPaperItem() {
            this.paperForm.items.push({ product_id: '', quantity: '' });
        },

        validShift(value) {
            return value === 'AM' || value === 'PM';
        },

        declaredReceivingShiftFor(g) {
            return this.validShift(g && g.declared_receiving_shift) ? g.declared_receiving_shift : '';
        },

        receiptShiftMismatch(g) {
            var declared = this.declaredReceivingShiftFor(g);
            return declared !== '' && this.validShift(this.receivingShift) && declared !== this.receivingShift;
        },

        prefillReceivingShift(groups) {
            // The declaration is only an expectation. For a bound cashier it cannot
            // change the outcome: SHIFT_LOCKED is the accountability control. For an
            // unbound admin/supervisor it supplies the useful default and stays editable.
            if (window.SHIFT_LOCKED) {
                this.receivingShift = (window.SHIFT || '');
                return;
            }
            var declared = (groups || []).map(function(g) {
                return this.declaredReceivingShiftFor(g);
            }.bind(this)).find(function(value) { return value !== ''; });
            this.receivingShift = declared || (window.SHIFT || '');
        },

        productionShiftFor(g) {
            // Incoming API groups always carry this key, including null for a
            // historical unknown. The fallback only preserves compatibility for
            // older callers that constructed a group before the field existed.
            if (!Object.prototype.hasOwnProperty.call(g, 'production_shift')) {
                return (window.SHIFT || '');
            }
            return g.production_shift || '';
        },

        canAcceptGroup(g) {
            return this.validShift(this.receivingShift) && this.validShift(this.productionShiftFor(g));
        },

        paperProductionShift() {
            // Pages rendered before the shift controls existed did not define
            // SHIFT_LOCKED. Keep those already-open clients compatible while
            // every current page requires the explicit paper-DR choice.
            if (typeof window.SHIFT_LOCKED === 'undefined' && !this.paperForm.production_shift) {
                return (window.SHIFT || '');
            }
            return this.paperForm.production_shift || '';
        },

        canSubmitPaper() {
            return this.validShift(this.receivingShift) && this.validShift(this.paperProductionShift());
        },

        validatePaperDelivery() {
            this.errorMsg = '';
            if (!this.canSubmitPaper()) {
                this.errorMsg = 'Choose both the production shift from the paper DR and the receiving shift.';
                return false;
            }
            if (this.paperForm.auto_dr) {
                if (this.paperForm.origin_type !== 'commissary') {
                    this.errorMsg = 'Auto DR is only available when receiving from the commissary (production).';
                    return false;
                }
            } else if (!this.paperForm.dr_number || !String(this.paperForm.dr_number).trim()) {
                this.errorMsg = 'Paper DR number is required.';
                return false;
            }
            if (this.paperForm.origin_type === 'branch' && !this.paperForm.origin_id) {
                this.errorMsg = 'Source branch is required for branch-to-branch paper DR receiving.';
                return false;
            }
            if (!this.paperForm.delivery_date || !this.paperForm.receive_date) {
                this.errorMsg = 'Delivery date and receive date are required.';
                return false;
            }
            var validItems = this.paperForm.items.filter(function(item) {
                return item.product_id && parseInt(item.quantity, 10) > 0;
            });
            if (validItems.length === 0) {
                this.errorMsg = 'Add at least one delivered item from the paper DR.';
                return false;
            }
            return true;
        },

        // Auto-DR production receive mints the DR server-side, so it cannot be
        // queued offline (the offline replay requires an explicit paper DR).
        autoDrBlockedOffline() {
            if (!this.paperForm.auto_dr) return false;
            this.errorMsg = 'Auto-DR production receive requires connectivity. Reconnect and retry, or enter the paper DR number.';
            return true;
        },

        submitPaperDelivery() {
            if (!this.validatePaperDelivery()) return;
            // Writes are online-only (nothing is buffered on the device since
            // 2026-09-22). Auto-DR is a special case on top of that: the server
            // mints the DR, so the offline replay has no explicit paper DR to
            // honour. Refuse it here with the reason instead of attempting a
            // write the queue could never sync.
            if (!navigator.onLine && this.autoDrBlockedOffline()) {
                this.paperSaving = false;
                return;
            }
            this.paperSaving = true;

            var payload = {
                branch_id: this.currentBranchId(),
                // Shift being viewed — the server must credit this ledger row, not
                // whichever shift its request clock happens to resolve. Before the
                // receiving selector this was: shift: (window.SHIFT || '')
                shift: this.receivingShift,
                production_shift: this.paperProductionShift(),
                origin_type: this.paperForm.origin_type,
                origin_id: this.paperForm.origin_id || null,
                delivery_date: this.paperForm.delivery_date,
                receive_date: this.paperForm.receive_date,
                dr_number: this.paperForm.auto_dr ? '' : this.paperForm.dr_number,
                auto_dr: this.paperForm.auto_dr ? 1 : 0,
                // Delayed producer entry (066): optional, from the paper sheet.
                // Empty means "not recorded" and the server leaves the columns NULL.
                produced_by: this.paperForm.produced_by || null,
                produced_at: this.paperForm.produced_at || null,
                items: this.paperForm.items.filter(function(item) {
                    return item.product_id && parseInt(item.quantity, 10) > 0;
                }).map(function(item) {
                    return {
                        product_id: parseInt(item.product_id, 10),
                        quantity: parseInt(item.quantity, 10),
                        unit: 'pcs'
                    };
                })
            };
            payload.idempotency_key = window.generateOperationId ? window.generateOperationId() : String(Date.now());

            // ONLINE-ONLY (owner decision 2026-09-22). Nothing is buffered on the
            // device: a receive that is believed recorded but is not gets re-keyed by
            // hand, which is how duplicates balloon the ledger. Attempt it; if it fails
            // the modal stays open with the reason and Save is the Retry. Safe to retry
            // because the payload carries an idempotency key and the server dedupes the
            // replay by it. Do NOT reintroduce enqueueOperation here.

            window.dlWriteTimeout(BASE + '/api/v1/cashier/ledger/receive-paper-dr', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': (window.DL_CSRF || ''),
                    'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
                },
                body: JSON.stringify(payload)
            }, 'This Paper DR')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                this.paperSaving = false;
                if (data && data.ok) {
                    showToast('Paper DR captured and received', 'success');
                    this.closeModal();
                    window.refreshMainContent();
                } else if (window.shouldQueueServerFailure && window.shouldQueueServerFailure(data)) {
                    // ONLINE-ONLY: a retryable server error is reported, not buffered.
                    this.errorMsg = 'NOT saved — the server is not accepting receives right now ('
                        + (data && data.error ? data.error : 'temporary error') + '). Retry in a moment.';
                } else {
                    this.errorMsg = (data && data.error) || 'Failed to receive paper DR.';
                }
            }.bind(this))
            .catch(function(err) {
                this.paperSaving = false;
                // Auto-DR has no paper DR to replay: if the connection dropped,
                // say why instead of offering a generic retry.
                if (!navigator.onLine && this.autoDrBlockedOffline()) {
                    return;
                }
                // ONLINE-ONLY: never buffered. The modal stays open with the reason so
                // the Save button is the retry.
                this.errorMsg = (err && err.dlTimedOut)
                    ? window.dlWriteTimeoutMessage('This Paper DR')
                    : 'NOT saved — the server could not be reached. Check the connection and retry.';
            }.bind(this));
        },

        receivedQty(g, it) {
            var map = this.partialQtys[g.group_key];
            return (map && map[it.id] !== undefined) ? map[it.id] : it.quantity;
        },

        setReceivedQty(g, it, val) {
            if (!this.partialQtys[g.group_key]) {
                this.partialQtys[g.group_key] = {};
            }
            if (val === '') {
                // Preserve an explicitly cleared field as invalid. Treating it as
                // untouched would silently restore the sent quantity on submit.
                this.partialQtys[g.group_key][it.id] = null;
                return;
            }
            var parsed = Number(val);
            if (!Number.isInteger(parsed) || parsed < 0) {
                this.partialQtys[g.group_key][it.id] = null;
                return;
            }
            if (parsed === it.quantity) {
                // Returning to the dispatched value is no longer a correction.
                delete this.partialQtys[g.group_key][it.id];
                return;
            }
            this.partialQtys[g.group_key][it.id] = parsed;
        },

        hasInvalidCorrection(g) {
            var map = this.partialQtys[g.group_key];
            if (!map) return false;
            return g.items.some(function(it) {
                return map[it.id] === null;
            });
        },

        hasCorrections(g) {
            var map = this.partialQtys[g.group_key];
            if (!map) return false;
            return g.items.some(function(it) {
                return Number.isInteger(map[it.id]) && map[it.id] !== it.quantity;
            });
        },

        isPartial(g) {
            return this.hasCorrections(g);
        },

        load() {
            this.loading = true;
            var bid = this.currentBranchId();
            var url = BASE + '/api/v1/cashier/ledger/incoming-deliveries';
            if (bid) url += '?branch_id=' + encodeURIComponent(bid);
            fetch(url, {
                headers: {
                    'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
                }
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                this.loading = false;
                this.deliveries = (data && data.ok) ? (data.deliveries || []) : [];
                this.prefillReceivingShift(this.deliveries);
                if (data && !data.ok) this.errorMsg = data.error || 'Failed to load deliveries.';
            }.bind(this))
            .catch(function() {
                this.loading = false;
                this.errorMsg = 'Network error while loading deliveries.';
            }.bind(this));
        },

        acceptGroup(g) {
            if (this.busyKey) return;
            if (!this.canAcceptGroup(g)) {
                this.errorMsg = 'Choose both the production shift from the paper DR and the receiving shift.';
                return;
            }
            if (this.hasInvalidCorrection(g)) {
                this.errorMsg = 'Corrected Received qty must be a whole number between 0 and the sent quantity.';
                return;
            }
            this.busyKey = g.group_key;
            this.errorMsg = '';
            var payload = {
                withdrawal_ids: g.ids,
                shift: this.receivingShift,
                production_shift: this.productionShiftFor(g)
            };
            var corrected = this.hasCorrections(g);
            if (g.delivery_ids && g.delivery_ids.length) {
                payload.delivery_ids = g.delivery_ids;
                // No correction means no partial_qtys: the server honestly records
                // a copied confirmation. A correction sends every line because the
                // API validates the complete independently-counted document.
                if (corrected) {
                    var self = this;
                    var lineCounts = {};
                    g.items.forEach(function(it) {
                        lineCounts[it.id] = self.receivedQty(g, it);
                    });
                    var byDelivery = {};
                    g.delivery_ids.forEach(function(did) {
                        byDelivery[did] = lineCounts;
                    });
                    payload.partial_qtys = byDelivery;
                }
            } else if (corrected) {
                // Informal transfer corrections are keyed by withdrawal record id.
                var self = this;
                var informalMap = {};
                g.items.forEach(function(it) {
                    informalMap[it.id] = self.receivedQty(g, it);
                });
                payload.informal_partial_qtys = informalMap;
            }
            var bid = this.currentBranchId();
            if (bid) payload.branch_id = bid;

            window.dlWriteTimeout(BASE + '/api/v1/cashier/ledger/receive-delivery', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': (window.DL_CSRF || ''),
                    'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
                },
                body: JSON.stringify(payload)
            }, 'This receipt')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                this.busyKey = '';
                if (data && data.ok) {
                    showToast('Delivery received (' + (data.received_count || 0) + ' items)', 'success');
                    // Remove this group from the list
                    this.deliveries = this.deliveries.filter(function(x) { return x.group_key !== g.group_key; });
                    this.closeModal();
                    // Refresh ledger rows so Addt'l column updates
                    window.refreshMainContent();
                } else {
                    this.errorMsg = (data && data.error) || 'Failed to receive delivery.';
                }
            }.bind(this))
            .catch(function() {
                this.busyKey = '';
                this.errorMsg = 'Network error while receiving delivery.';
            }.bind(this));
        }
    };
}
</script>
