{extends "modules/daily-ledger/layouts/app.disyl"}

{block head}
{/block}

{block header_shift}
{include "modules/daily-ledger/cashier/partials/server-clock.disyl"}
{include "modules/daily-ledger/cashier/partials/shift-badge.disyl"}
{/block}

{block content}
<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">Sales Report</h2>
        <p class="text-sm text-gray-500">Encoder view for daily inventory and sales.</p>
        <p class="text-xs text-gray-500 mt-1">
            Business date: <span class="font-medium text-gray-700">{business_date_label}</span>
            · Timezone: <span class="font-medium text-gray-700">{operating_timezone}</span>
            · Region: <span class="font-medium text-gray-700">{operating_region}</span>
        </p>
        <div class="mt-2">
            <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800 ring-1 ring-inset ring-amber-300">
                Cutoff: {close_of_day_time}
            </span>
        </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700 ring-1 ring-inset ring-indigo-200">{branch_name}</span>

        {if is_cashier}
        <input type="date" class="form-input mt-0 w-auto min-w-40" id="ledger-date" value="{ledger_date}" max="{today}"
               name="date"
               onchange="window.dlReloadLedger()">
        {else}
        <select class="form-input mt-0 w-auto min-w-44" id="branch-select" name="branch_id"
                onchange="window.dlReloadLedger()">
            {foreach branches as br}
            <option value="{br.id}" {if br.id == branch_id}selected{/if}>{br.name}</option>
            {/foreach}
        </select>
        <input type="date" class="form-input mt-0 w-auto min-w-40" id="ledger-date" value="{ledger_date}" max="{today}" name="date"
               onchange="window.dlReloadLedger()">
        {/if}

        <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset
            {if day_status == 'open'}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}
            {if day_status == 'closed'}bg-rose-50 text-rose-700 ring-rose-200{/if}
        ">{day_status}</span>

        {if reference_only}
        <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 ring-1 ring-inset ring-slate-300">Reference only</span>
        {/if}

        {if shift_locked}
        <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset bg-slate-100 text-slate-600 ring-slate-300">Locked to {shift} Shift</span>
        {else}
        <div class="inline-flex items-center rounded-full bg-slate-100 p-0.5 ring-1 ring-inset ring-slate-300" role="group" aria-label="Shift">
            <a href="{base_url}/ledger?date={ledger_date}&branch_id={branch_id}&shift=AM" class="rounded-full px-3 py-1 text-xs font-semibold {if shift == 'AM'}bg-white text-indigo-700 shadow-sm{else}text-slate-500 hover:text-slate-700{/if}">AM</a>
            <a href="{base_url}/ledger?date={ledger_date}&branch_id={branch_id}&shift=PM" class="rounded-full px-3 py-1 text-xs font-semibold {if shift == 'PM'}bg-white text-indigo-700 shadow-sm{else}text-slate-500 hover:text-slate-700{/if}">PM</a>
        </div>
        {/if}

        {if pos_enabled}
        {if sales_mode == 'pos'}
        <span class="inline-flex items-center rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800 ring-1 ring-inset ring-emerald-300">Mode: POS</span>
        {elseif sales_mode == 'fallback'}
        <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800 ring-1 ring-inset ring-amber-300">Mode: Fallback</span>
        {else}
        <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700 ring-1 ring-inset ring-slate-300">Mode: Manual</span>
        {/if}
        {if can_pos_sell}
        <a href="{base_url}/pos" class="btn btn-outline" data-online-action="POS">POS</a>
        {/if}
        {/if}

        <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset bg-emerald-50 text-emerald-700 ring-emerald-200" id="global-status">All saved</span>
        <span id="offline-ready-badge" class="hidden inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset bg-emerald-50 text-emerald-700 ring-emerald-200">Offline ready</span>
        <button type="button" class="btn btn-outline" id="offline-access-btn" onclick="dlOpenOfflineAccess()">Enable offline access</button>
        {if shift == 'PM' && day_status == 'open' && !reference_only}
        {if pm_pending}
        <button type="button" class="btn btn-primary" id="finalize-pm-btn" onclick="finalizePmShift()">Close PM Shift</button>
        {else}
        <span class="inline-flex items-center rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-200">PM Shift Finalized</span>
        {/if}
        {/if}
        <button type="button" class="btn btn-outline" onclick="printCashierLedger()">Print</button>
    </div>
</div>

<div id="connectivity-banner" class="mb-4 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-900" role="status" aria-live="polite">
    <span id="connectivity-banner-text">Checking cloud connection…</span>
</div>
<div id="online-action-blocked" class="hidden mb-4 rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800" role="alert"></div>

{if prior_pending_day}
<div class="mb-4 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="status">
    <span class="font-semibold">PM ending pending for {prior_pending_day.date}.</span>
    <span class="ml-1 text-amber-800">That business date is still open because its PM shift was not finalized. Enter the late counts, then close the PM shift.</span>
    <a class="ml-2 font-semibold text-amber-900 underline" href="{base_url}/ledger?date={prior_pending_day.date}&branch_id={branch_id}&shift=PM">Open prior PM ledger</a>
</div>
{/if}

<div id="finalize-pm-result" class="hidden mb-4 rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"></div>

{* A finalized shift refuses API writes (dl_assertShiftMutable) even while the day stays open.
   Say so here and expose the audited reopen, so the block is never discovered by a silent 403. *}
{if shift_status == 'finalized' && day_status != 'closed'}
<div class="mb-4 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="status">
    <span class="font-semibold">The {shift} shift for {ledger_date} is finalized.</span>
    <span class="ml-1">Beginning balance, ending count and stock adjustments are locked so the signed-off shift cannot change without a trace.</span>
    {if can_ledger_override}
    <button type="button" class="btn btn-outline btn-sm ml-2" onclick="reopenDay()" data-online-action="Shift reopen">Reopen {shift} shift to correct</button>
    {else}
    <span class="ml-1">Ask an admin or supervisor to reopen the shift if it needs correcting.</span>
    {/if}
</div>
{/if}

<div class="mb-4 flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
    <div>
        <div class="text-sm font-semibold text-gray-900">Choose what you need to do</div>
        <p class="mt-1 text-xs text-gray-500">Use the paper DR number whenever possible. Pick only one action below so the same stock movement is not recorded twice.</p>
    </div>
    <input type="text" class="form-input max-w-xs" id="ledger-search" placeholder="Search product..." oninput="filterLedgerRows(this.value)">
</div>

<div id="offline-pending-sync" class="hidden mb-4 rounded-lg border border-indigo-300 bg-indigo-50 px-4 py-3 text-sm text-indigo-900" role="status" aria-live="polite">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <div class="font-semibold">Offline entries not yet synced.</div>
            <p id="offline-pending-sync-text" class="mt-1 text-xs text-indigo-800">This device has entries saved while offline that have not reached the cloud. Enter your offline PIN to sync them now.</p>
        </div>
        <div class="flex items-center gap-2">
            <input type="password" id="offline-pin-input" inputmode="numeric" maxlength="6" autocomplete="off"
                   placeholder="PIN" class="form-input mt-0 w-28 text-center"
                   onkeydown="if(event.key === 'Enter') window.dlUnlockVaultAndSync()">
            <button type="button" class="btn btn-primary btn-sm" id="offline-sync-btn" onclick="window.dlUnlockVaultAndSync()">Sync now</button>
            <button type="button" class="btn btn-outline btn-sm" id="offline-sync-later" onclick="dlDismissPendingSync()">Later</button>
        </div>
    </div>
    <p id="offline-pin-msg" class="mt-1 text-xs text-rose-600 hidden"></p>
</div>

<div id="pending-save-warning" class="hidden mb-4 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <div class="font-semibold">Stale offline saves need review.</div>
            <p id="pending-save-warning-text" class="mt-1 text-xs text-amber-800">Pending ledger saves from another user, branch, date, or schema were quarantined and will not be retried automatically.</p>
        </div>
        <button type="button" class="btn btn-outline btn-sm" onclick="clearQuarantinedPending()">Purge stale saves</button>
    </div>
</div>

<div class="mb-4 grid gap-3 lg:grid-cols-3">
    <div class="rounded-xl border border-indigo-200 bg-indigo-50 p-4 shadow-sm">
        <div class="flex items-start justify-between gap-3">
            <div>
                <div class="text-sm font-semibold text-indigo-900">Receive Stock</div>
                <p class="mt-1 text-xs leading-5 text-indigo-800">Use this when stock is arriving into this branch. Search the DR first. If the truck arrived before the transfer was encoded, use the Paper DR entry inside the same screen.</p>
            </div>
            {if incoming_count > 0}
            <span class="inline-flex items-center rounded-full bg-rose-600 px-2.5 py-1 text-xs font-semibold text-white">{incoming_count} waiting</span>
            {/if}
        </div>
        <div class="mt-3 rounded-lg bg-white/70 px-3 py-2 text-[11px] leading-5 text-indigo-900 ring-1 ring-inset ring-indigo-200">Best for: stock that has already reached this branch.</div>
        <div class="mt-4">
            <button type="button" class="btn btn-outline w-full justify-center" onclick="openReceiveModal()">Open Receive Stock</button>
        </div>
    </div>
    {if formal_delivery_enabled}
    <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 shadow-sm">
        <div class="text-sm font-semibold text-emerald-900">Send to Branch</div>
        <p class="mt-1 text-xs leading-5 text-emerald-800">Use this only when this branch is sending stock to another branch. Enter the paper DR, choose the receiving branch, and list only the items that actually left this branch.</p>
        <div class="mt-3 rounded-lg bg-white/70 px-3 py-2 text-[11px] leading-5 text-emerald-900 ring-1 ring-inset ring-emerald-200">Best for: normal branch-to-branch stock transfer out.</div>
        <div class="mt-4">
            {if day_status == 'open' && !reference_only && shift_status != 'finalized'}
            <button type="button" class="btn btn-primary w-full justify-center" onclick="openDispatchModal()">Open Send to Branch</button>
            {/if}
            {if day_status != 'open' || reference_only || shift_status == 'finalized'}
            <div class="rounded-lg border border-emerald-200 bg-white/70 px-3 py-2 text-xs text-emerald-900">Unavailable while this day is closed, this shift is finalized, or in reference-only mode.</div>
            {/if}
        </div>
    </div>
    {/if}
    <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 shadow-sm">
        <div class="text-sm font-semibold text-amber-900">Stock Adjustment</div>
        <p class="mt-1 text-xs leading-5 text-amber-800">Use this for charge, pullout, spoilage, staff use, and other branch-side corrections. Do not use it for stock moving between branches.</p>
        <div class="mt-3 rounded-lg bg-white/70 px-3 py-2 text-[11px] leading-5 text-amber-900 ring-1 ring-inset ring-amber-200">Best for: non-transfer corrections inside this branch only.</div>
        <div class="mt-4">
            {if day_status == 'open' && !reference_only && shift_status != 'finalized'}
            <button type="button" class="btn btn-outline w-full justify-center" onclick="openWithdrawalModal()">Open Stock Adjustment</button>
            {/if}
            {if day_status != 'open' || reference_only || shift_status == 'finalized'}
            <div class="rounded-lg border border-amber-200 bg-white/70 px-3 py-2 text-xs text-amber-900">Unavailable while this day is closed, this shift is finalized, or in reference-only mode.</div>
            {/if}
        </div>
    </div>
    {if can_edit_delivery}
    <div class="rounded-xl border border-sky-200 bg-sky-50 p-4 shadow-sm">
        <div class="text-sm font-semibold text-sky-900">Correct Delivery by DR</div>
        <p class="mt-1 text-xs leading-5 text-sky-800">Fix a paper-DR stock delivery — add missed items or correct quantities. Requires the edit-by-DR permission.</p>
        <div class="mt-3 rounded-lg bg-white/70 px-3 py-2 text-[11px] leading-5 text-sky-900 ring-1 ring-inset ring-sky-200">Best for: correcting a delivery captured from a paper DR.</div>
        <div class="mt-4">
            {if day_status == 'open' && !reference_only && shift_status != 'finalized'}
            <button type="button" class="btn btn-outline w-full justify-center" onclick="openEditDeliveryModal()">Open Correct Delivery by DR</button>
            {/if}
            {if day_status != 'open' || reference_only || shift_status == 'finalized'}
            <div class="rounded-lg border border-sky-200 bg-white/70 px-3 py-2 text-xs text-sky-900">Unavailable while this day is closed, this shift is finalized, or in reference-only mode.</div>
            {/if}
        </div>
    </div>
    {/if}
</div>

<div class="card">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th class="text-left w-14">#</th>
                    <th>Description</th>
                    <th class="text-right">Beg. Bal</th>
                    <th class="text-right">Addt'l</th>
                    <th class="text-right">W/Draw</th>
                    <th class="text-right">Bal. End</th>
                    <th class="text-right">Sales</th>
                </tr>
            </thead>
            <tbody id="ledger-body"
                   hx-get="{base_url}/ledger/rows?date={ledger_date}&branch_id={branch_id}&shift={shift}"
                   {* Explicit refresh event, not "load": the rows are already rendered
                      by the include below, so firing on load re-fetched 588KB of identical
                      markup on every ledger view. Callers that need a refresh dispatch
                      the dl:rows-refresh event. *}
                   hx-trigger="dl:rows-refresh"
                   hx-swap="innerHTML">
                {if branch_id}
                {include "modules/daily-ledger/cashier/partials/ledger-rows.disyl"}
                {else}
                <tr><td colspan="7" class="px-4 py-10 text-center text-sm text-gray-500">No branch assigned</td></tr>
                {/if}
            </tbody>
        </table>
    </div>
</div>

{if day_status == 'open' && !reference_only}
<div class="mt-6">
    <div class="flex items-center justify-between gap-3 mb-2">
        <div>
            <div class="text-sm font-semibold text-gray-900">Today's Adjustments</div>
            <p class="text-xs text-gray-500">Correct your own entries after a slow-connection retry. Every change is audit-logged.</p>
        </div>
        <button type="button" class="btn btn-outline btn-sm" onclick="window.dlRefreshTodayAdjustments()">Refresh</button>
    </div>
    <div id="today-adjustments" class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
        <div class="px-4 py-6 text-center text-sm text-gray-400">Loading…</div>
    </div>
</div>
{/if}

{if day_status == 'open' && !reference_only}
<div class="mt-6 flex justify-end gap-3">
    <button class="btn btn-primary" id="close-day-btn" onclick="closeDay()" data-online-action="Day close">Close Day</button>
</div>
{/if}
{if day_status == 'closed'}
<div class="mt-6 flex items-center justify-end gap-3">
    <span class="text-sm text-gray-500">This day has been closed.</span>
    {if can_ledger_override}
    <button class="btn btn-outline" onclick="reopenDay()" data-online-action="Day reopen">Reopen Day</button>
    {/if}
</div>
{/if}

{include "modules/daily-ledger/cashier/modal_patch.disyl"}
{include "modules/daily-ledger/cashier/dispatch_modal.disyl"}
{include "modules/daily-ledger/cashier/receive_modal.disyl"}
{include "modules/daily-ledger/cashier/edit_delivery_modal.disyl"}
{include "modules/daily-ledger/cashier/offline_auth.disyl"}
{/block}

{block scripts}
<script src="/daily-ledger/assets/offline-vault.js"></script>
{include "modules/daily-ledger/cashier/offline_reference.disyl"}
<script>
    var BASE = '{base_url}';
    var BRANCH_ID = '{branch_id}';
    var LEDGER_DATE = '{ledger_date}';
    var SHIFT = '{shift}';
    var SHIFT_LOCKED = {if shift_locked}true{else}false{/if};
    var DAY_STATUS = '{day_status}';
    var SHIFT_STATUS = '{shift_status}';
    var FORMAL_DELIVERY_ENABLED = {if formal_delivery_enabled}true{else}false{/if};
    var COMMISSARY_BRANCH_ID = '{commissary_branch_id}';
    var COMMISSARY_BRANCH_NAME = '{commissary_branch_name}';
    var LIABLE_PERSONS = {if liable_persons_json}{liable_persons_json|raw}{else}[]{/if};
    var IS_CASHIER = {if is_cashier}true{else}false{/if};
    window.BASE = BASE;
    window.BRANCH_ID = BRANCH_ID;
    window.LEDGER_DATE = LEDGER_DATE;
    window.SHIFT = SHIFT;
    window.SHIFT_LOCKED = SHIFT_LOCKED;
    window.SHIFT_STATUS = SHIFT_STATUS;
    window.FORMAL_DELIVERY_ENABLED = FORMAL_DELIVERY_ENABLED;
    window.COMMISSARY_BRANCH_ID = COMMISSARY_BRANCH_ID;
    window.COMMISSARY_BRANCH_NAME = COMMISSARY_BRANCH_NAME;
    window.IS_CASHIER = IS_CASHIER;

    // Modal openers — defined here so they always work even if included templates fail
    window.openReceiveModal = function() {
        window.dispatchEvent(new CustomEvent('open-receive-modal', { detail: {} }));
    };
    window.openDispatchModal = function() {
        window.dispatchEvent(new CustomEvent('open-dispatch-modal', { detail: {} }));
    };
    window.openWithdrawalModal = function(entry) {
        window.dispatchEvent(new CustomEvent('open-withdrawal-modal', { detail: entry || {} }));
    };
    // Add stock WITHOUT a paper DR: the row-level "+" opens the Stock Adjustment
    // (Add Stock) flow, which credits the Addt'l column. It defaults to the
    // "Encoder omission" reason because the common case is a missed entry —
    // nothing was lost, so no liable person is charged. Switching the reason to
    // a variance one makes the charge-to field required again.
    // The DR-tracked Receive Stock flow stays available from the action card
    // above for real incoming transfers.
    window.dlAddStockDirect = function(productId) {
        window.openWithdrawalModal({
            withdrawal_type: 'adjustment_add',
            reason_code: 'encoder_omission',
            product_id: productId
        });
    };
    // Row-level W/Draw: same convenience as "+" — open on the row the operator
    // clicked instead of making them scroll the product list to find it.
    window.dlAdjustRowDirect = function(productId) {
        window.openWithdrawalModal({ product_id: productId });
    };
    window.openEditDeliveryModal = function() {
        window.dispatchEvent(new CustomEvent('open-edit-delivery-modal', { detail: {} }));
    };

    // Reload the ledger page in place with the current date/branch selection.
    window.dlReloadLedger = function() {
        var dateEl = document.getElementById('ledger-date');
        var branchEl = document.getElementById('branch-select');
        var date = dateEl ? dateEl.value : '';
        var branch = branchEl ? branchEl.value : '';
        var url = BASE + '/ledger?date=' + encodeURIComponent(date) + '&branch_id=' + encodeURIComponent(branch) + '&shift=' + encodeURIComponent(SHIFT || 'AM');
        window.dlLoadUrl(url, false);
    };

    // ── Today's Adjustments (cashier edit-own withdrawal) ───────────────
    var __dlTodayAdjCache = [];
    function dlAdjTypeLabel(t) {
        return ({ charge: 'Charge', pullout: 'Pullout', used: 'Used', correction: 'Correction', adjustment_add: 'Add Stock' }[t] || t);
    }
    function dlEscHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }
    window.dlRefreshTodayAdjustments = function() {
        var wrap = document.getElementById('today-adjustments');
        if (!wrap) return;
        var bid = window.BRANCH_ID || '';
        var url = BASE + '/api/v1/cashier/ledger/withdrawals/today?branch_id=' + encodeURIComponent(bid) + '&date=' + encodeURIComponent(window.LEDGER_DATE || '') + '&shift=' + encodeURIComponent(window.SHIFT || '');
        fetch(url, {
            headers: { 'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '') }
        })
        .then(dlResponseJson)
        .then(function(data) {
            if (isSessionExpiredResponse(data)) {
                window.dlSessionExpired(data);
                return;
            }
            var rows = (data && data.ok) ? (data.withdrawals || []) : [];
            __dlTodayAdjCache = rows;
            if (!rows.length) {
                wrap.innerHTML = '<div class="px-4 py-6 text-center text-sm text-gray-400">No adjustments recorded for today.</div>';
                return;
            }
            var html = '<table class="w-full text-sm"><thead><tr class="border-b border-gray-200 text-left text-xs uppercase tracking-wide text-gray-500">' +
                '<th class="px-4 py-2">Product</th><th class="px-4 py-2">Type</th><th class="px-4 py-2 text-right">Qty</th>' +
                '<th class="px-4 py-2">Reason</th><th class="px-4 py-2">Charged to</th><th class="px-4 py-2">Time</th><th class="px-4 py-2 text-right">Action</th></tr></thead><tbody>';
            rows.forEach(function(r) {
                var typeL = dlAdjTypeLabel(r.withdrawal_type);
                var qty = String(r.quantity || 0) + (r.unit === 'box' ? ' box (' + (r.quantity || 0) + ' pcs)' : ' pcs');
                var reason = r.reason_code || '';
                if (r.custom_reason) reason += ' — ' + r.custom_reason;
                var time = String(r.created_at || '').slice(11, 16);
                var btn = (r.editable && window.DAY_STATUS === 'open')
                    ? '<button type="button" class="btn btn-outline btn-xs" data-adj-edit="' + r.id + '">Edit</button>'
                    : '';
                html += '<tr class="border-b border-gray-100">' +
                    '<td class="px-4 py-2 font-medium text-gray-900">' + dlEscHtml(r.product_name) + '</td>' +
                    '<td class="px-4 py-2 text-gray-600">' + dlEscHtml(typeL) + '</td>' +
                    '<td class="px-4 py-2 text-right font-mono">' + dlEscHtml(qty) + '</td>' +
                    '<td class="px-4 py-2 text-gray-600">' + dlEscHtml(reason) + '</td>' +
                    '<td class="px-4 py-2 text-gray-600">' + (r.liable_user_name ? dlEscHtml(r.liable_user_name) : '<span class="text-gray-400">—</span>') + '</td>' +
                    '<td class="px-4 py-2 text-gray-500">' + dlEscHtml(time) + '</td>' +
                    '<td class="px-4 py-2 text-right">' + btn + '</td></tr>';
            });
            html += '</tbody></table>';
            wrap.innerHTML = html;
            Array.prototype.forEach.call(wrap.querySelectorAll('[data-adj-edit]'), function(b) {
                b.addEventListener('click', function() {
                    var id = parseInt(b.getAttribute('data-adj-edit'), 10);
                    var entry = null;
                    __dlTodayAdjCache.forEach(function(x) { if (x.id === id) entry = x; });
                    if (entry) window.openWithdrawalModal(entry);
                });
            });
        })
        .catch(function() {
            var w = document.getElementById('today-adjustments');
            if (w) w.innerHTML = '<div class="px-4 py-6 text-center text-sm text-rose-500">Could not load today’s adjustments.</div>';
        });
    };
    if (window.DAY_STATUS === 'open') { window.dlRefreshTodayAdjustments(); }

    // Offline buffer: localStorage write-ahead log scoped to the active actor, tenant, branch, and business date.
    var PENDING_STORAGE_PREFIX = 'daily-ledger:pending-saves';
    var LEGACY_PENDING_PREFIX = 'bbs_pending_saves';
    var PENDING_SCHEMA_VERSION = 3;
    var PENDING_ALLOWED_FIELDS = ['beg_bal', 'addtl', 'withdraw', 'bal_end'];
    var PENDING_TENANT_SCOPE = String(window.DL_TENANT_SCOPE || 'tenant');
    var PENDING_ACTOR_SCOPE = String(window.DL_USER_ID || 'anonymous');
    var PENDING_KEY = [
        PENDING_STORAGE_PREFIX,
        PENDING_TENANT_SCOPE,
        PENDING_ACTOR_SCOPE,
        BRANCH_ID || 'branch',
        LEDGER_DATE || 'date',
        SHIFT || 'AM'
    ].join(':');
    var QUARANTINE_KEY = [PENDING_STORAGE_PREFIX, 'quarantine', PENDING_TENANT_SCOPE, PENDING_ACTOR_SCOPE].join(':');
    // Start ONLINE. This HTML was just delivered by the server over this very
    // connection, so connectivity was proven a moment ago; assuming 'offline' until
    // the first probe answers made every page load flash an amber "Offline" banner
    // and blocked day-close/POS for the whole round trip. The first probe can only
    // ever DOWNGRADE this on real evidence.
    var cloudOnline = true;
    // Shared hosting cold renders routinely exceed a few seconds - a local ledger
    // GET already measured >1s - so a 4s probe timeout declared a healthy cloud
    // "offline". That is not cosmetic: a false offline stops drainPendingWork() and
    // disables day-close/POS, which is exactly what made syncing look stalled.
    // Be generous with the timeout and require the failure to repeat.
    var CLOUD_PROBE_TIMEOUT_MS = 10000;
    var CLOUD_PROBE_FAILURE_LIMIT = 2;
    var cloudProbeFailures = 0;
    // Whether the sync heartbeat has ever answered. This is the ONLY probe flag other
    // code may branch on, and only for display - never to decide whether a write is
    // attempted. (A separate `cloudProbeDone` flag used to gate queueing in five
    // templates; that is exactly what let a stale verdict swallow a real save.)
    var cloudProbeAnswered = false;
    var syncingPending = false;
    var storageAvailable = true;
    var lastCloudSync = null;
    var saveFieldVersions = {};
    var sessionExpired = false;
    var cloudProbeInterval = null;
    var cloudRetryInterval = null;
    var pendingDrainInterval = null;
    var sessionRedirectTimer = null;

    // Probe cadence. The probe is a connectivity/sync heartbeat only - it never
    // repaints ledger data - so a slower steady interval costs the cashier nothing
    // and removes the fleet's single largest source of load: with 23 branches every
    // open tab polling every 30s was ~59% of all request volume. Responsiveness is
    // preserved where it actually matters (see the listeners at the bottom of this
    // block): immediate check on reconnect, on returning to the tab, and while
    // queued work is waiting to drain.
    var CLOUD_PROBE_MS = 120000;

    // Recovery cadence. While the banner is amber, day-close and POS are blocked, so
    // coming back must not wait out the whole 120s steady interval. Retry quickly for
    // as long as we believe we are offline; the first success clears the state at
    // once. Costs nothing while online (no request is issued).
    var CLOUD_PROBE_RETRY_MS = 10000;

    function dlResponseJson(response) {
        return response.json().then(function(body) {
            if (body && typeof body === 'object') body.__status = response.status;
            return body;
        });
    }

    function isSessionExpiredResponse(res) {
        return !!res && (res.__status === 401 || res.code === 'session_expired' || res.error === 'Auth required');
    }

    window.dlSessionExpired = function(meta) {
        if (sessionExpired) return;
        sessionExpired = true;
        cloudOnline = false;
        if (cloudProbeInterval !== null) {
            clearInterval(cloudProbeInterval);
            cloudProbeInterval = null;
        }
        if (pendingDrainInterval !== null) {
            clearInterval(pendingDrainInterval);
            pendingDrainInterval = null;
        }
        if (cloudRetryInterval !== null) {
            clearInterval(cloudRetryInterval);
            cloudRetryInterval = null;
        }
        window.removeEventListener('online', probeCloud);
        var box = document.getElementById('connectivity-banner');
        var text = document.getElementById('connectivity-banner-text');
        if (box) {
            box.className = 'mb-4 rounded-lg border border-red-400 bg-red-50 px-4 py-3 text-sm font-semibold text-red-900';
            box.setAttribute('role', 'alert');
            box.classList.remove('hidden');
        }
        if (text) text.textContent = 'Your session has expired. Please sign in again - the edit was NOT saved and nothing is held on this device.';
        if (window.showToast) window.showToast('Your session has expired. Please sign in again.', 'error');
        sessionRedirectTimer = setTimeout(function() {
            window.location.assign('/daily-ledger/login');
        }, 1200);
    };

    function markStorageUnavailable() {
        storageAvailable = false;
        renderConnectivityBanner('storage');
    }

    function readStoredArray(key) {
        try {
            var parsed = JSON.parse(localStorage.getItem(key) || '[]');
            return Array.isArray(parsed) ? parsed : [];
        } catch (e) {
            markStorageUnavailable();
            return [];
        }
    }

    function getPending() {
        return readStoredArray(PENDING_KEY);
    }
    function setPending(arr) {
        try {
            if (!Array.isArray(arr) || arr.length === 0) {
                localStorage.removeItem(PENDING_KEY);
                return true;
            }
            localStorage.setItem(PENDING_KEY, JSON.stringify(arr));
            return true;
        } catch (e) {
            markStorageUnavailable();
            return false;
        }
    }
    function getQuarantinedPending() {
        return readStoredArray(QUARANTINE_KEY);
    }
    function setQuarantinedPending(arr) {
        try {
            if (!Array.isArray(arr) || arr.length === 0) {
                localStorage.removeItem(QUARANTINE_KEY);
                return true;
            }
            localStorage.setItem(QUARANTINE_KEY, JSON.stringify(arr.slice(-200)));
            return true;
        } catch (e) {
            markStorageUnavailable();
            return false;
        }
    }
    function buildPendingPayload(productId, field, value) {
        var storedValue = (String(field) === 'bal_end' && (value === null || value === '' || value === undefined)) ? null : (parseInt(value, 10) || 0);
        return {
            schema_version: PENDING_SCHEMA_VERSION,
            module: 'daily-ledger',
            tenant_scope: PENDING_TENANT_SCOPE,
            actor_id: PENDING_ACTOR_SCOPE,
            branch_id: BRANCH_ID || '',
            date: LEDGER_DATE,
            shift: SHIFT || 'AM',
            product_id: String(productId || ''),
            field: String(field || ''),
            value: storedValue,
            created_at: new Date().toISOString()
        };
    }
    function normalizePendingEntry(payload) {
        if (!payload || typeof payload !== 'object') return null;
        if (parseInt(payload.schema_version, 10) !== PENDING_SCHEMA_VERSION) return null;
        if (String(payload.module || '') !== 'daily-ledger') return null;
        if (String(payload.tenant_scope || '') !== PENDING_TENANT_SCOPE) return null;
        if (String(payload.actor_id || '') !== PENDING_ACTOR_SCOPE) return null;
        if (String(payload.branch_id || '') !== String(BRANCH_ID || '')) return null;
        if (String(payload.date || '') !== String(LEDGER_DATE || '')) return null;
        // Pre-shift pending entries had no shift field — treat as AM for continuity.
        if (String(payload.shift || 'AM') !== String(SHIFT || 'AM')) return null;
        if (PENDING_ALLOWED_FIELDS.indexOf(String(payload.field || '')) === -1) return null;
        if (String(payload.product_id || '').trim() === '') return null;
        // Legacy queues (schema < 3) auto-defaulted a blank bal_end to 0. Replaying
        // that as a counted zero would falsify a pending ending, so demote it to
        // null (pending) and let the cashier confirm the count.
        var val = payload.value;
        if (String(payload.field) === 'bal_end'
            && (parseInt(payload.schema_version, 10) || 0) < 3
            && (val === 0 || val === '0')) {
            val = null;
        }
        return buildPendingPayload(payload.product_id, payload.field, val);
    }
    function quarantinePendingEntries(entries, reason, sourceKey) {
        if (!Array.isArray(entries) || entries.length === 0) return 0;
        var stale = getQuarantinedPending();
        var quarantinedAt = new Date().toISOString();
        entries.forEach(function(entry) {
            stale.push({
                reason: reason,
                source_key: sourceKey,
                quarantined_at: quarantinedAt,
                payload: entry
            });
        });
        setQuarantinedPending(stale);
        return entries.length;
    }
    function listPendingKeys() {
        var keys = [];
        try {
            for (var i = 0; i < localStorage.length; i++) {
                var key = localStorage.key(i);
                if (!key) continue;
                if (key.indexOf(PENDING_STORAGE_PREFIX) === 0 || key === LEGACY_PENDING_PREFIX || key.indexOf(LEGACY_PENDING_PREFIX + ':') === 0) {
                    keys.push(key);
                }
            }
        } catch (e) {
            return [];
        }
        return keys;
    }
    function shouldQueueServerFailure(res) {
        // Unify with the replay/retry classifier so deterministic rejections
        // (already received, missing, required, A different, etc.) surface as
        // errors instead of being falsely queued as transient and quarantined
        // later. function declarations hoist, so the later definition of
        // shouldQueueOperationFailure is available here.
        if (isSessionExpiredResponse(res)) window.dlSessionExpired(res);
        return shouldQueueOperationFailure(res);
    }
    function syncPendingStorage() {
        var keys = listPendingKeys();
        var quarantinedCount = 0;
        keys.forEach(function(key) {
            if (key === QUARANTINE_KEY) return;
            var entries = readStoredArray(key);
            if (key !== PENDING_KEY) {
                if (entries.length > 0) {
                    quarantinedCount += quarantinePendingEntries(entries, key.indexOf(LEGACY_PENDING_PREFIX) === 0 ? 'legacy-key' : 'scope-mismatch', key);
                }
                try { localStorage.removeItem(key); } catch (e) { markStorageUnavailable(); }
                return;
            }
            var valid = [];
            var invalid = [];
            entries.forEach(function(entry) {
                var normalized = normalizePendingEntry(entry);
                if (normalized) {
                    valid.push(normalized);
                } else {
                    invalid.push(entry);
                }
            });
            if (invalid.length > 0) {
                quarantinedCount += quarantinePendingEntries(invalid, 'schema-mismatch', key);
            }
            setPending(valid);
        });
        renderPendingWarning();
        return quarantinedCount;
    }
    function renderPendingWarning() {
        var box = document.getElementById('pending-save-warning');
        var text = document.getElementById('pending-save-warning-text');
        if (!box || !text) return;
        var count = getQuarantinedPending().length;
        box.classList.toggle('hidden', count === 0);
        if (count > 0) {
            text.textContent = count + ' stale offline save' + (count === 1 ? '' : 's') + ' were quarantined and will not be retried automatically.';
        }
    }
    window.clearQuarantinedPending = function() {
        var count = getQuarantinedPending().length;
        try { localStorage.removeItem(QUARANTINE_KEY); } catch (e) { markStorageUnavailable(); return; }
        renderPendingWarning();
        if (count > 0 && window.showToast) {
            window.showToast('Cleared ' + count + ' stale offline save' + (count === 1 ? '' : 's') + '.', 'success');
        }
    }

    // ── Offline cashier-operation queue ──────────────────────────────
    // Stock Adjustment (withdrawal) and Paper-DR Receive can be entered
    // while the cloud is unreachable. Each operation is queued on the
    // device with its own idempotency key and replayed when connectivity
    // returns (the backend dedupes replays by that key).
    var PENDING_OPS_PREFIX = 'daily-ledger:pending-ops';
    var PENDING_OPS_KEY = [
        PENDING_OPS_PREFIX,
        PENDING_TENANT_SCOPE,
        PENDING_ACTOR_SCOPE,
        BRANCH_ID || 'branch',
        LEDGER_DATE || 'date',
        SHIFT || 'AM'
    ].join(':');
    var OPS_QUARANTINE_KEY = [PENDING_OPS_PREFIX, 'quarantine', PENDING_TENANT_SCOPE, PENDING_ACTOR_SCOPE].join(':');

    function getPendingOps() {
        return readStoredArray(PENDING_OPS_KEY);
    }
    function setPendingOps(arr) {
        if (!Array.isArray(arr) || arr.length === 0) {
            try { localStorage.removeItem(PENDING_OPS_KEY); } catch (e) { markStorageUnavailable(); }
            return true;
        }
        localStorage.setItem(PENDING_OPS_KEY, JSON.stringify(arr));
        return true;
    }
    function pendingTotal() {
        return getPending().length + getPendingOps().length + vaultPendingCount;
    }

    // ── Encrypted vault queue adapter ────────────────────────────────
    // When offline access is enrolled AND unlocked, pending ledger saves and
    // supported offline operations are encrypted into the vault (durable
    // before UI success) and synced through the reconcile API. Devices that
    // have not yet enrolled keep using the legacy localStorage queues above,
    // so the old path is preserved until migration/browser proof.
    var vaultQueueActive = false;
    var vaultPendingCount = 0;

    function vaultRefreshPendingCount() {
        if (!window.DLOfflineVault || !window.DLOfflineVault.isUnlocked()) return;
        window.DLOfflineVault.countPending().then(function(n) {
            vaultPendingCount = n;
            updateGlobalStatus('saved');
            renderConnectivityBanner();
        }).catch(function() {});
    }

    function vaultEnqueue(type, payload) {
        if (!vaultQueueActive || !window.DLOfflineVault) {
            return Promise.resolve({ ok: false });
        }
        return window.DLOfflineVault.enqueueOperation(type, payload)
            .then(function(op) {
                vaultPendingCount++;
                updateGlobalStatus('pending');
                renderConnectivityBanner();
                return { ok: true, op: op };
            })
            .catch(function() {
                // Vault write failed (locked/storage) — signal the failure so the
                // caller can fall back to the legacy queue. The edit is NEVER
                // silently dropped.
                markStorageUnavailable();
                return { ok: false };
            });
    }

    function vaultOrLegacyAddPending(payload) {
        if (vaultQueueActive && window.DLOfflineVault && window.DLOfflineVault.isUnlocked()) {
            vaultEnqueue('ledger_save', {
                product_id: payload.product_id,
                field: payload.field,
                value: payload.value,
                date: payload.date,
                branch_id: payload.branch_id,
                shift: payload.shift || 'AM'
            }).then(function(res) {
                if (!res.ok) addPending(payload); // never lose the edit
            });
            return;
        }
        addPending(payload);
    }

    function drainVault() {
        if (!vaultQueueActive || !window.DLOfflineVault || !window.DLOfflineVault.isUnlocked()) {
            return Promise.resolve();
        }
        return window.DLOfflineVault.getStoredEnrollmentId().then(function(enId) {
            return window.DLOfflineVault.ensureDeviceId().then(function(deviceId) {
                return { enId: enId, deviceId: deviceId };
            });
        }).then(function(ctx) {
            if (!ctx.enId) return;
            return window.DLOfflineVault.listOperations().then(function(ops) {
                if (ops.length === 0) return;
                var payload = ops.map(function(op) {
                    return { client_op_id: op.client_op_id, type: op.type, base_version: op.base_version, payload: op.payload };
                });
                // Non-decrypting pending marker so the server/admin can see this
                // device's unsynced work even if the batch is interrupted.
                var fields = [];
                var since = null;
                ops.forEach(function(op) {
                    if (op.created_at && (!since || op.created_at < since)) since = op.created_at;
                    if (op.type === 'ledger_save' && op.payload && op.payload.field && fields.indexOf(op.payload.field) === -1) {
                        fields.push(op.payload.field);
                    }
                });
                var pendingReport = {
                    pending_count: ops.length,
                    pending_since: since || null,
                    pending_fields: fields.slice(0, 8).join(',')
                };
                return fetch(BASE + '/api/v1/offline/reconcile', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': (window.DL_CSRF || ''),
                        'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
                    },
                    body: JSON.stringify({ enrollment_id: ctx.enId, device_id: ctx.deviceId, operations: payload,
                        pending_count: pendingReport.pending_count, pending_since: pendingReport.pending_since, pending_fields: pendingReport.pending_fields })
                }).then(dlResponseJson).then(function(res) {
                    if (isSessionExpiredResponse(res)) { window.dlSessionExpired(res); return; }
                    // A JSON rejection is an APPLICATION answer, not a lost connection:
                    // the server is demonstrably reachable, so never mark it offline here.
                    if (!res.ok) { return; }
                    var remove = [];
                    (res.results || []).forEach(function(r) {
                        if (r.status === 'applied' || r.duplicate) {
                            window.DLOfflineVault.saveReceipt({ client_op_id: r.client_op_id, result: r.result || {}, duplicate: !!r.duplicate, status: r.status }).catch(function() {});
                            remove.push(r.client_op_id);
                        } else if (r.status === 'rejected' || r.status === 'conflict') {
                            window.DLOfflineVault.quarantineRecord({ reason: r.status, source_key: 'ledger-reconcile', payload: { client_op_id: r.client_op_id, type: r.type, error: r.error } }).catch(function() {});
                            remove.push(r.client_op_id);
                        }
                    });
                    return Promise.all(remove.map(function(id) { return window.DLOfflineVault.removeOperation(id).catch(function() {}); })).then(function() {
                        return window.DLOfflineVault.countPending().then(function(n) { vaultPendingCount = n; });
                    });
                });
            });
        }).catch(function() { markCloudProbeFailure(); }).then(function() {
            updateGlobalStatus('saved');
            renderConnectivityBanner();
        });
    }
    window.generateOperationId = function() {
        if (window.crypto && window.crypto.randomUUID) return window.crypto.randomUUID();
        return 'op-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
    };
    function enqueueLegacyOperation(op, payload) {
        var list = getPendingOps();
        // Honor a caller-provided idempotency key (e.g. a modal's stable key) so
        // retries of the same logical operation reuse it; otherwise generate one.
        var idempotencyKey = (payload && payload.idempotency_key) ? String(payload.idempotency_key) : window.generateOperationId();
        // Dedupe: the same logical operation (same op + key) must never queue twice.
        var existing = null;
        for (var i = 0; i < list.length; i++) {
            if (list[i].op === op && list[i].idempotency_key === idempotencyKey) {
                existing = list[i];
                break;
            }
        }
        if (existing) return existing;
        var entry = {
            schema_version: 1,
            module: 'daily-ledger',
            tenant_scope: PENDING_TENANT_SCOPE,
            actor_id: PENDING_ACTOR_SCOPE,
            branch_id: BRANCH_ID || '',
            date: LEDGER_DATE,
            shift: SHIFT || 'AM',
            op: op,
            idempotency_key: idempotencyKey,
            payload: payload || {},
            created_at: new Date().toISOString()
        };
        list.push(entry);
        setPendingOps(list);
        renderConnectivityBanner();
        updateGlobalStatus('pending');
        return entry;
    }

    // DRAIN-ONLY since 2026-09-22. Ledger writes are online-only (owner decision):
    // nothing new is ever buffered, because a queued entry the cashier believes is
    // stored gets re-keyed by hand and duplicates the ledger. These writers are kept
    // ONLY so entries buffered by the previous behaviour still reconcile on reconnect.
    // Do NOT call enqueueOperation from a write path.
    window.enqueueOperation = function(op, payload) {
        if (vaultQueueActive && window.DLOfflineVault && window.DLOfflineVault.isUnlocked()) {
            vaultEnqueue(op, payload || {}).then(function(res) {
                if (!res.ok) enqueueLegacyOperation(op, payload || {});
            });
            return { idempotency_key: window.generateOperationId() };
        }
        return enqueueLegacyOperation(op, payload || {});
    };
    function removePendingOperation(idempotencyKey) {
        var list = getPendingOps().filter(function(e) { return e.idempotency_key !== idempotencyKey; });
        setPendingOps(list);
        renderConnectivityBanner();
    }
    function quarantinePendingOperation(entry, reason) {
        var stale = readStoredArray(OPS_QUARANTINE_KEY);
        stale.push({ reason: reason, quarantined_at: new Date().toISOString(), payload: entry });
        try { localStorage.setItem(OPS_QUARANTINE_KEY, JSON.stringify(stale.slice(-200))); } catch (e) { markStorageUnavailable(); }
    }
    // Decide whether a failed save should be queued for retry or surfaced to the
    // operator as a refusal. The status code decides; message text is only a
    // fallback for responses that carry no status.
    function shouldQueueOperationFailure(res) {
        var error = String((res && res.error) || '');
        if (isSessionExpiredResponse(res)) return true;

        // Classify STRUCTURALLY first. The handlers already distinguish the two
        // cases by status: 4xx means this exact request will be refused again
        // (403 reference-only / finalized / cannot-override, 422 validation),
        // while 5xx (and 408/429) are worth retrying. Deciding on the status
        // means a reworded or newly added message can no longer silently start
        // queueing a permanent refusal forever. That is not hypothetical: the
        // 422s 'Value must be a number' and 'Value out of bounds' match no
        // fragment in the list below, so they were queued and retried
        // indefinitely while the cashier was told the edit would sync.
        var status = (res && typeof res.__status === 'number') ? res.__status : 0;
        if (status > 0) {
            if (status === 408 || status === 429) return true;
            if (status >= 500) return true;
            if (status >= 400) return false;
        }

        // No usable status (e.g. a 200 body carrying ok:false): fall back to the
        // legacy fragment allowlist. FALLBACK ONLY - do not add new wording
        // here; have the endpoint return a proper HTTP status instead.
        if (error === '') return true;
        return [
            'already received', 'already', 'required', 'Invalid', 'invalid',
            'A different', 'Reference only', 'Day is closed', 'Branch not authorized',
            'cannot override', 'Add at least one', 'must be 255',
            'Unable to resolve', 'Missing', 'requires',
            // A finalized shift is a permanent rejection until someone reopens it.
            // Queueing it retried the same 403 every 30s forever and pinned the
            // status bar at "pending", which read as the cloud being slow.
            'finalized', 'locked'
        ].every(function(fragment) { return error.indexOf(fragment) === -1; });
    }
    function replayPendingOperations() {
        var list = getPendingOps();
        if (list.length === 0) return Promise.resolve();
        var requests = list.map(function(entry) {
            if (!entry || entry.schema_version !== 1 || entry.module !== 'daily-ledger' ||
                (entry.op !== 'withdrawal' && entry.op !== 'receive_paper_dr')) {
                quarantinePendingOperation(entry, 'schema-mismatch');
                removePendingOperation(entry.idempotency_key);
                return Promise.resolve();
            }
            if (String(entry.branch_id) !== String(BRANCH_ID || '') || String(entry.date) !== String(LEDGER_DATE || '')) {
                quarantinePendingOperation(entry, 'scope-mismatch');
                removePendingOperation(entry.idempotency_key);
                return Promise.resolve();
            }
            var url = entry.op === 'withdrawal'
                ? BASE + '/api/v1/cashier/ledger/withdrawals'
                : BASE + '/api/v1/cashier/ledger/receive-paper-dr';
            var payload = JSON.parse(JSON.stringify(entry.payload || {}));
            payload.idempotency_key = entry.idempotency_key;
            return window.dlWriteTimeout(url, {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': (window.DL_CSRF || ''),
                    'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
                },
                body: JSON.stringify(payload)
            }, 'This queued entry')
            .then(dlResponseJson)
            .then(function(res) {
                if (res.ok) {
                    markCloudProbeSuccess();
                    removePendingOperation(entry.idempotency_key);
                } else if (isSessionExpiredResponse(res)) {
                    window.dlSessionExpired(res);
                } else if (!shouldQueueOperationFailure(res)) {
                    quarantinePendingOperation(entry, 'server-rejected');
                    removePendingOperation(entry.idempotency_key);
                }
            })
            .catch(function() { markCloudProbeFailure(); });
        });
        return Promise.all(requests).then(function() {
            updateGlobalStatus(pendingTotal() > 0 ? 'pending' : 'saved');
            renderConnectivityBanner();
        });
    }
    function drainPendingWork() {
        var queuedBefore = pendingTotal();
        var drained = (vaultQueueActive && window.DLOfflineVault && window.DLOfflineVault.isUnlocked())
            ? drainVault()
            : retryPending().then(function() { return replayPendingOperations(); });
        return drained.then(function() {
            // A withdrawal queued while the banner was amber has now reached the cloud,
            // but the cells on screen were rendered before it landed - and the ledger
            // TOTAL for that product only moves when the row is re-read. Without this
            // the operator sees the old number and concludes the entry was refused.
            if (pendingTotal() < queuedBefore) refreshLedgerTotals();
        });
    }

    function refreshLedgerTotals() {
        if (window.htmx && document.getElementById('ledger-body')) {
            htmx.trigger(document.getElementById('ledger-body'), 'dl:rows-refresh');
        }
        if (typeof window.dlRefreshTodayAdjustments === 'function') window.dlRefreshTodayAdjustments();
    }

    // Compute sales = beg_bal + addtl - withdraw - bal_end (pending when no ending)
    function computeSales(productId) {
        var row = document.querySelector('tr[data-product-id="' + productId + '"]');
        if (!row) return null;
        var endInput = row.querySelector('[data-field="bal_end"]');
        var end = (endInput && endInput.value.trim() !== '') ? (parseInt(endInput.value, 10) || 0) : null;
        var beg = parseInt(row.querySelector('[data-field="beg_bal"]').value) || 0;
        var addEl = row.querySelector('[data-field="addtl"]');
        var add = parseInt(addEl ? (addEl.value !== undefined ? addEl.value : addEl.textContent) : 0) || 0;
        var wdrEl = row.querySelector('[data-field="withdraw"]');
        var wdr = parseInt(wdrEl ? (wdrEl.value !== undefined ? wdrEl.value : wdrEl.textContent) : 0) || 0;
        var span = row.querySelector('.sales-computed');
        if (end === null) {
            if (span) {
                span.textContent = 'Pending';
                span.dataset.pending = '1';
                span.className = 'ledger-chip ledger-chip-pending sales-computed';
            }
            return null;
        }
        var sales = beg + add - wdr - end;
        if (sales < 0) sales = 0;
        if (span) {
            span.textContent = sales;
            delete span.dataset.pending;
            span.className = 'ledger-chip sales-computed';
        }
        return sales;
    }

    function doSave(productId, field, value) {
        var payload = {
            product_id: productId,
            field: field,
            value: value,
            date: LEDGER_DATE,
            shift: SHIFT
        };
        if (BRANCH_ID) payload.branch_id = BRANCH_ID;
        return window.dlWriteTimeout(BASE + '/api/v1/cashier/ledger/save', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify(payload)
        }, 'This edit').then(dlResponseJson);
    }

    // The rendered cell value is the server's last word for that cell. Snapshot it
    // on focus so a rejected save can be rolled back to a value the ledger will
    // actually read after reload, instead of leaving the rejected number on screen
    // (which read as "it saved, then changed itself back later").
    function dlSnapshotCell(input) {
        if (input && input.dataset) input.dataset.serverValue = input.value;
    }

    function revertCellToServerValue(input) {
        var snapshot = input.dataset ? input.dataset.serverValue : undefined;
        if (snapshot === undefined || snapshot === null) return false;
        input.value = snapshot;
        return true;
    }

    // Send one cell value. Split out of saveField so a failed write can be RETRIED
    // with the value the operator actually typed - the cell is rolled back to the
    // server's value on failure, so re-reading the input would re-send the old number.
    //
    // ONLINE-ONLY (owner decision 2026-09-22): a ledger edit is NEVER buffered on the
    // device. It is attempted; if it fails it is rolled back and reported with the
    // reason and a Retry. Buffering gave editors/cashiers a false sense of stored data,
    // and the hand re-keying that followed is what duplicated entries. Do NOT
    // reintroduce a queue here.
    function sendFieldValue(input, productId, field, value) {
        var saveKey = String(productId) + ':' + String(field);
        var saveVersion = (saveFieldVersions[saveKey] || 0) + 1;
        saveFieldVersions[saveKey] = saveVersion;
        if (value === null) { input.value = ''; } else { input.value = value; }
        input.classList.remove('saved', 'error');
        input.classList.add('saving');
        updateGlobalStatus('pending');

        // Recompute sales display immediately
        computeSales(productId);

        // Save the changed field. The in-flight indicator and the outcome notice
        // make every send visible on its own, so a saved, queued, or refused edit
        // is never mistaken for another while the view is still refreshing.
        if (window.dlSetBusy) window.dlSetBusy(true, 'Saving…');
        doSave(productId, field, value)
        .then(function(res) {
            if (window.dlSetBusy) window.dlSetBusy(false);
            if (saveFieldVersions[saveKey] !== saveVersion) return;
            input.classList.remove('saving');
            if (res.ok) {
                input.classList.add('saved');
                setTimeout(function() { input.classList.remove('saved'); }, 1500);
                removePending(productId, field);
                input.dataset.serverValue = input.value;
                if (window.dlClearWriteFailure) window.dlClearWriteFailure();
                if (window.dlToastSaved) { window.dlToastSaved('Saved'); }
                else if (window.showToast) { window.showToast('Saved', 'success'); }
            } else {
                input.classList.add('error');
                if (isSessionExpiredResponse(res)) {
                    // ONLINE-ONLY: nothing was recorded and nothing is held, so say that
                    // rather than claiming the entries are kept and will be retried.
                    revertCellToServerValue(input);
                    computeSales(productId);
                    window.dlSessionExpired(res);
                } else if (shouldQueueServerFailure(res)) {
                    // ONLINE-ONLY (owner decision 2026-09-22): a retryable server error is
                    // reported with a Retry, never buffered on the device.
                    revertCellToServerValue(input);
                    computeSales(productId);
                    var busyMsg = 'NOT saved — the server is not accepting changes right now'
                        + (res.error ? ' (' + res.error + ')' : '') + '. Retry in a moment.';
                    if (window.dlReportWriteFailure) {
                        window.dlReportWriteFailure(busyMsg, function() { sendFieldValue(input, productId, field, value); });
                    }
                    if (window.showToast) window.showToast(busyMsg, 'error');
                } else {
                    // Deterministic rejection (locked shift, closed day, reference
                    // only): the ledger will still read the old value after reload,
                    // so put the cell back and say why instead of flashing red and
                    // leaving an unreplayable entry behind.
                    var restored = revertCellToServerValue(input);
                    if (!restored) {
                        // No snapshot to roll back to, so the authoritative value is
                        // unknown. Keep the refused entry for review rather than
                        // discarding the only record of what was attempted.
                        input.value = (value === null) ? '' : value;
                        quarantinePendingEntries([buildPendingPayload(productId, field, value)], 'server-rejected', PENDING_KEY);
                        renderPendingWarning();
                    }
                    computeSales(productId);
                    if (window.showToast) window.showToast(res.error || 'Change rejected', 'error');
                }
            }
            updateGlobalStatus(getPending().length > 0 ? 'pending' : 'saved');
        })
        .catch(function(err) {
            if (window.dlSetBusy) window.dlSetBusy(false);
            if (saveFieldVersions[saveKey] !== saveVersion) return;
            input.classList.remove('saving');
            input.classList.add('error');
            // ONLINE-ONLY (owner decision 2026-09-22): the edit is NEVER buffered. It is
            // rolled back to the server's value and reported with the reason plus a Retry,
            // so the screen can never suggest a value that was not recorded.
            revertCellToServerValue(input);
            computeSales(productId);
            updateGlobalStatus(getPending().length > 0 ? 'pending' : 'saved');
            var reason = (err && err.dlTimedOut)
                ? window.dlWriteTimeoutMessage('This edit')
                : 'NOT saved — the server could not be reached.';
            if (window.dlReportWriteFailure) {
                window.dlReportWriteFailure(
                    reason + ' The cell was put back to its last saved value so the screen is not misleading.',
                    function() { sendFieldValue(input, productId, field, value); }
                );
            }
            if (window.showToast) window.showToast(reason, 'error');
        });
    }

    function saveField(input) {
        var productId = input.dataset.product;
        var field = input.dataset.field;
        var value = (field === 'bal_end' && input.value.trim() === '') ? null : (parseInt(input.value, 10) || 0);
        sendFieldValue(input, productId, field, value);
    }

    function addPending(payload) {
        var list = getPending();
        payload = normalizePendingEntry(payload) || buildPendingPayload(payload.product_id, payload.field, payload.value);
        // Replace existing entry for same product+field+branch+date
        list = list.filter(function(p) {
            return !(p.product_id == payload.product_id && p.field == payload.field && p.branch_id == payload.branch_id && p.date == payload.date);
        });
        list.push(payload);
        setPending(list);
        renderConnectivityBanner();
    }

    function removePending(productId, field) {
        var list = getPending().filter(function(p) {
            return !(p.product_id == productId && p.field == field && p.branch_id == BRANCH_ID && p.date == LEDGER_DATE);
        });
        setPending(list);
        renderConnectivityBanner();
    }

    function removePendingIfUnchanged(completed) {
        var list = getPending().filter(function(p) {
            var sameEntry = p.product_id == completed.product_id &&
                p.field == completed.field &&
                p.branch_id == completed.branch_id &&
                p.date == completed.date &&
                String(p.shift || 'AM') === String(completed.shift || 'AM') &&
                String(p.created_at || '') === String(completed.created_at || '') &&
                Number(p.value) === Number(completed.value);
            return !sameEntry;
        });
        setPending(list);
        renderConnectivityBanner();
    }

    function updateGlobalStatus(state) {
        var el = document.getElementById('global-status');
        if (!el) return;
        el.classList.remove('all-saved', 'pending');
        if (!storageAvailable) {
            el.textContent = 'Storage unavailable';
            el.classList.add('pending');
            return;
        }
        if (state === 'saved' && pendingTotal() === 0) {
            el.textContent = 'All saved';
            el.classList.add('all-saved');
        } else {
            el.textContent = 'Saving...';
            el.classList.add('pending');
        }
    }

    function retryPending() {
        // Gate on the browser's own signal, never on the probe's. A stale "offline"
        // verdict must not stop queued work from draining - that is how a queued
        // entry stayed stranded while the cloud was perfectly reachable.
        if (syncingPending || !navigator.onLine || !storageAvailable) return Promise.resolve();
        var list = getPending();
        if (list.length === 0) {
            lastCloudSync = new Date();
            renderConnectivityBanner();
            return Promise.resolve();
        }
        syncingPending = true;
        updateGlobalStatus('pending');

        var requests = list.map(function(payload) {
            if (normalizePendingEntry(payload) === null) {
                quarantinePendingEntries([payload], 'schema-mismatch', PENDING_KEY);
                removePending(payload.product_id, payload.field);
                renderPendingWarning();
                return Promise.resolve();
            }
            return window.dlWriteTimeout(BASE + '/api/v1/cashier/ledger/save', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': (window.DL_CSRF || ''),
                    'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
                },
                body: JSON.stringify(payload)
            }, 'This edit')
            .then(dlResponseJson)
            .then(function(res) {
                if (res.ok) {
                    // A successful round trip IS proof of connectivity - clear any
                    // offline state now instead of waiting for the next heartbeat.
                    markCloudProbeSuccess();
                    lastCloudSync = new Date();
                    removePendingIfUnchanged(payload);
                    if (getPending().length === 0) updateGlobalStatus('saved');
                } else if (isSessionExpiredResponse(res)) {
                    window.dlSessionExpired(res);
                } else if (!shouldQueueServerFailure(res)) {
                    quarantinePendingEntries([payload], 'server-rejected', PENDING_KEY);
                    removePending(payload.product_id, payload.field);
                    renderPendingWarning();
                }
            })
            .catch(function() { markCloudProbeFailure(); });
        });
        return Promise.all(requests).then(function() {
            if (cloudOnline) lastCloudSync = new Date();
        }).finally(function() {
            syncingPending = false;
            updateGlobalStatus(getPending().length > 0 ? 'pending' : 'saved');
            renderConnectivityBanner();
        });
    }

    function renderConnectivityBanner(forcedState) {
        var box = document.getElementById('connectivity-banner');
        var text = document.getElementById('connectivity-banner-text');
        if (!box || !text) return;
        if (sessionExpired) return;
        box.className = 'mb-4 rounded-lg border px-4 py-3 text-sm font-semibold';
        if (forcedState === 'storage' || !storageAvailable) {
            box.className += ' border-red-300 bg-red-50 text-red-800';
            text.textContent = 'Device storage unavailable — stop entering data';
            updateGlobalStatus('pending');
            return;
        }
        var pending = pendingTotal();
        if (pending > 0) {
            // Entries exist ONLY on this device. Never claim a successful sync here:
            // "Cloud synchronized" alongside a pending count is a false assurance, and
            // it is the difference between an operator trusting the screen and knowing
            // the work still has to reach the server.
            box.className += ' border-amber-300 bg-amber-50 text-amber-900';
            if (!navigator.onLine) {
                text.textContent = 'Offline · ' + pending + ' not on the server yet · Day close & POS need connectivity';
            } else {
                text.textContent = 'Online · ' + pending + ' not on the server yet · syncing now';
            }
        } else if (cloudOnline) {
            box.className += ' border-emerald-300 bg-emerald-50 text-emerald-800';
            if (!cloudProbeAnswered) {
                // The document arrived over this connection, so we ARE online - the
                // sync heartbeat just has not answered yet. Say that, instead of
                // claiming a sync timestamp we have not verified.
                text.textContent = 'Online · Checking cloud sync…';
            } else {
                var stamp = lastCloudSync ? lastCloudSync.toLocaleTimeString() : new Date().toLocaleTimeString();
                text.textContent = 'Online · Cloud synchronized ' + stamp;
            }
        } else {
            box.className += ' border-amber-300 bg-amber-50 text-amber-900';
            text.textContent = 'Offline · nothing pending · Day close & POS need connectivity';
        }
        if (pending > 0) updateGlobalStatus('pending');
    }

    // Connectivity hysteresis: the first probe answer is decisive because we have no
    // prior evidence of connectivity, but after that a single slow or dropped probe
    // keeps the last known state rather than flapping the banner and halting the
    // pending drain.
    function markCloudProbeFailure() {
        cloudProbeFailures++;
        if (!cloudProbeAnswered || cloudProbeFailures >= CLOUD_PROBE_FAILURE_LIMIT) {
            cloudOnline = false;
        }
        return false;
    }

    function markCloudProbeSuccess() {
        cloudProbeFailures = 0;
        cloudOnline = true;
    }

    function probeCloud() {
        if (sessionExpired) return Promise.resolve(false);
        if (!navigator.onLine) {
            cloudOnline = false;
            renderConnectivityBanner();
            return Promise.resolve(false);
        }
        var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
        var timer = controller ? setTimeout(function() { controller.abort(); }, CLOUD_PROBE_TIMEOUT_MS) : null;
        return fetch(BASE + '/api/v1/cashier/ledger/day-status', {
            method: 'GET',
            credentials: 'same-origin',
            cache: 'no-store',
            headers: { 'Accept': 'application/json', 'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '') },
            signal: controller ? controller.signal : undefined
        }).then(function(response) {
            var contentType = response.headers.get('Content-Type') || '';
            if (response.redirected || contentType.indexOf('application/json') === -1) {
                return markCloudProbeFailure();
            }
            return dlResponseJson(response).then(function(result) {
                if (isSessionExpiredResponse(result)) {
                    window.dlSessionExpired(result);
                    return false;
                }
                if (!(response.ok && result && result.ok === true)) {
                    return markCloudProbeFailure();
                }
                markCloudProbeSuccess();
                if (window.DL_OFFLINE_SHELL) {
                    window.location.reload();
                    return true;
                }
                return drainPendingWork().then(function() { return true; });
            });
        }).catch(function() {
            return markCloudProbeFailure();
        }).finally(function() {
            if (timer) clearTimeout(timer);
            cloudProbeAnswered = true;
            renderConnectivityBanner();
        });
    }

    function blockOnlineAction(name) {
        var box = document.getElementById('online-action-blocked');
        if (box) {
            box.textContent = name + ' requires cloud connectivity. Reconnect before continuing.';
            box.classList.remove('hidden');
        }
        renderConnectivityBanner();
    }

    document.addEventListener('click', function(event) {
        var target = event.target && event.target.closest ? event.target.closest('[data-online-action]') : null;
        // Only the browser's own signal blocks these. Gating on the probe meant a
        // stale "offline" verdict refused day-close and POS on a host that was up.
        // If the cloud really is unreachable the action fails and says so.
        if (!target || navigator.onLine) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        blockOnlineAction(target.getAttribute('data-online-action') || 'This action');
    }, true);

    window.addEventListener('online', probeCloud);
    window.addEventListener('offline', function() { cloudOnline = false; renderConnectivityBanner(); });
    cloudProbeInterval = setInterval(function() {
        // A background tab costs a whole PHP worker per probe and nobody is looking
        // at it, so skip entirely; visibilitychange probes as soon as it returns.
        if (!navigator.onLine || document.hidden) return;
        probeCloud();
    }, CLOUD_PROBE_MS);

    // While the banner is amber, day-close and POS are blocked, so recovery must not
    // wait out the steady 120s cadence. Retry quickly until the cloud answers; a
    // single success restores online at once. This issues no request while online.
    cloudRetryInterval = setInterval(function() {
        if (sessionExpired || !navigator.onLine || document.hidden) return;
        if (cloudOnline === false && cloudProbeAnswered) probeCloud();
    }, CLOUD_PROBE_RETRY_MS);

    // Queued entries must not wait out the full interval to reach the cloud. This
    // tick is free when there is nothing pending - it issues no request at all.
    pendingDrainInterval = setInterval(function() {
        if (!navigator.onLine || document.hidden) return;
        if (pendingTotal() > 0) probeCloud();
    }, 15000);

    document.addEventListener('visibilitychange', function() {
        if (!document.hidden && navigator.onLine) probeCloud();
    });

    // Tab/Enter navigation between inputs
    document.addEventListener('keydown', function(e) {
        if (e.key !== 'Tab' && e.key !== 'Enter') return;
        var target = e.target;
        if (!target.classList.contains('ledger-input')) return;

        if (e.key === 'Enter') {
            e.preventDefault();
            // Move to next input
            var inputs = Array.from(document.querySelectorAll('.ledger-input:not(:disabled)'));
            var idx = inputs.indexOf(target);
            if (idx >= 0 && idx < inputs.length - 1) {
                inputs[idx + 1].focus();
                inputs[idx + 1].select();
            }
        }
    });

    // Auto-select behaviour for ledger numbers: tapping/clicking a field
    // selects the whole value so cashiers type straight over the old
    // quantity. The inline onfocus="this.select()" handles touch; this
    // delegated mouseup guard stops the desktop click from collapsing that
    // selection back to a caret.
    // NOTE: native number inputs are excluded. preventDefault() on mouseup
    // breaks the native up/down spin button's release, so the value keeps
    // auto-incrementing after the mouse is released (rapid "fast add").
    // select() also throws for number inputs, so the guard adds no value there.
    document.addEventListener('mouseup', function(e) {
        var target = e.target;
        if (!target || !target.classList || !target.classList.contains('ledger-input')) return;
        if (target.type === 'number') return;
        e.preventDefault();
        try { target.select(); } catch (err) { /* number input */ }
    });

    function closeDay() {
        if (!confirm('Close this day? Cashiers will no longer be able to edit.')) return;
        var btn = document.getElementById('close-day-btn');
        closeDayWith(btn, false);
    }

    function closeDayWith(btn, acknowledgeVariance) {
        btn.disabled = true;
        btn.textContent = 'Closing...';

        var payload = { date: LEDGER_DATE, branch_id: BRANCH_ID };
        if (acknowledgeVariance) { payload.acknowledge_variance = true; }

        window.dlWriteTimeout(BASE + '/api/v1/cashier/ledger/close-day', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify(payload)
        }, 'Closing the day')
        .then(dlResponseJson)
        .then(function(res) {
            if (isSessionExpiredResponse(res)) { window.dlSessionExpired(res); return; }
            if (res.ok) {
                showToast('Day closed successfully');
                setTimeout(function() { window.refreshMainContent(); }, 800);
                return;
            }
            // POS days with a material variance require an explicit, audited
            // acknowledgment before the day can close.
            if (!acknowledgeVariance && res.code === 'POS_VARIANCE_ACK_REQUIRED') {
                var v = res.summary || {};
                var amt = v.variance_amount != null ? Number(v.variance_amount).toFixed(2) : '?';
                if (confirm('POS and stock-derived sales differ by PHP ' + amt + '. Acknowledge the variance to close the day?')) {
                    closeDayWith(btn, true);
                    return;
                }
            }
            btn.disabled = false;
            btn.textContent = 'Close Day';
            showToast(res.error || 'Failed to close day');
        })
        .catch(function() {
            btn.disabled = false;
            btn.textContent = 'Close Day';
            showToast('Network error');
        });
    }

    function reopenDay() {
        // Reopening the day also resets both shift lifecycles (apiReopenDay), which is
        // the sanctioned way past a finalized shift. Word the prompt for whichever
        // reason the operator actually hit.
        var isShiftReopen = (String(window.SHIFT_STATUS || '') === 'finalized') && (String(window.DAY_STATUS || '') !== 'closed');
        var promptText = isShiftReopen
            ? 'Reopen the ' + SHIFT + ' shift for correction?\n\nThis also reopens the day and unfreezes that day\'s variance snapshot. The change is audit-logged.'
            : 'Reopen this day for editing?\n\nThis also reopens both shift lifecycles and unfreezes that day\'s variance snapshot. The change is audit-logged.';
        if (!confirm(promptText)) return;

        fetch(BASE + '/api/v1/admin/reopen-day', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify({ date: LEDGER_DATE, branch_id: BRANCH_ID })
        })
        .then(dlResponseJson)
        .then(function(res) {
            if (isSessionExpiredResponse(res)) { window.dlSessionExpired(res); return; }
            if (res.ok) {
                showToast(isShiftReopen ? (SHIFT + ' shift reopened') : 'Day reopened');
                setTimeout(function() { window.refreshMainContent(); }, 800);
            } else {
                showToast(res.error || 'Failed to reopen');
            }
        })
        .catch(function() { showToast('Network error'); });
    }

    // Client-side product search/filter
    function filterLedgerRows(query) {
        query = query.toLowerCase().trim();
        var rows = document.querySelectorAll('#ledger-body tr[data-product-id]');
        rows.forEach(function(row) {
            var name = (row.querySelector('.product-name') || {}).textContent || '';
            row.style.display = name.toLowerCase().indexOf(query) !== -1 ? '' : 'none';
        });
    }

    function initializePendingQueue() {
        syncPendingStorage();
        renderConnectivityBanner();
        probeCloud();
        if (typeof window.dlCaptureProductReference === 'function') window.dlCaptureProductReference();
        if (typeof window.dlMaybeLockOffline === 'function') window.dlMaybeLockOffline();
    }

    function renderOfflineReadyBadge(on) {
        var badge = document.getElementById('offline-ready-badge');
        if (badge) badge.classList.toggle('hidden', !on);
        var btn = document.getElementById('offline-access-btn');
        if (btn) btn.textContent = on ? 'Offline access: On' : 'Enable offline access';
    }

    // Explicit online enrollment: one action reaches verified "Offline ready".
    // The server derives tenant/actor/branch/shift; the client stores an
    // encrypted, scope-bound bootstrap + PIN-wrapped key in the vault.
    window.dlOpenOfflineAccess = function() {
        if (!window.isSecureContext || !window.crypto || !window.crypto.subtle || !window.DLOfflineVault) {
            showToast('Offline access requires a secure (HTTPS) connection on this device.', 'error');
            return;
        }
        window.DLOfflineVault.hasLocalEnrollment().then(function(has) {
            if (has) {
                if (window.DLOfflineVault.isUnlocked()) {
                    showToast('This device already has offline access.', 'success');
                    renderOfflineReadyBadge(true);
                    return;
                }
                showToast('Offline access is set up on this device. Use the offline shell to unlock it.', 'success');
                renderOfflineReadyBadge(true);
                return;
            }

            var pin = window.prompt('Set a 4–6 digit offline PIN for this device (unlocks offline data only):');
            if (pin === null) return;
            if (!/^\d{4,6}$/.test(pin)) { showToast('Use a 4–6 digit PIN.', 'error'); return; }
            var confirmation = window.prompt('Confirm the offline PIN:');
            if (confirmation !== pin) { showToast('PINs do not match.', 'error'); return; }

            var btn = document.getElementById('offline-access-btn');
            if (btn) { btn.disabled = true; btn.textContent = 'Enrolling…'; }

            window.DLOfflineVault.ensureDeviceId().then(function(deviceId) {
                return fetch(BASE + '/api/v1/offline/enroll', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': (window.DL_CSRF || ''),
                        'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
                    },
                    body: JSON.stringify({ device_id: deviceId })
                }).then(dlResponseJson);
            }).then(function(res) {
                if (!res.ok || !res.enrollment || !res.bootstrap) {
                    throw new Error((res && res.error) || 'Enrollment failed');
                }
                return window.DLOfflineVault.activate(res.enrollment, res.bootstrap, pin)
                    .then(function() {
                        return window.DLOfflineVault.migrateLegacy().catch(function() { return null; });
                    })
                    .then(function() {
                        vaultQueueActive = true;
                        vaultRefreshPendingCount();
                        renderOfflineReadyBadge(true);
                        if (typeof window.dlNotifyOfflineActivated === 'function') window.dlNotifyOfflineActivated();
                        if (btn) { btn.disabled = false; }
                        showToast('Offline ready. This device can work without a connection.', 'success');
                    });
            }).catch(function(err) {
                if (btn) { btn.disabled = false; btn.textContent = 'Enable offline access'; }
                showToast((err && err.message) || 'Unable to enable offline access.', 'error');
            });
        });
    };

    // Legacy alias — "Offline PIN" now routes through the enrollment flow.
    window.dlOpenPinSettings = function() {
        window.dlOpenOfflineAccess();
    };

    // ── Locked-vault pending sync prompt ───────────────────────────────
    // When the encrypted vault is LOCKED (in-memory data key lost on browser
    // close / reload), pending ops queued while offline never sync — the online
    // page must not require the cashier to remember to open the offline shell.
    // We count pending ops from the plaintext op records (no unlock needed) and
    // prompt the cashier to enter their PIN to unlock and drain the vault.
    function dlShowPendingSyncPrompt(count) {
        var box = document.getElementById('offline-pending-sync');
        var text = document.getElementById('offline-pending-sync-text');
        if (!box) return;
        if (!count) {
            box.classList.add('hidden');
            return;
        }
        if (text) {
            text.textContent = 'This device has ' + count + ' saved-while-offline entr' + (count === 1 ? 'y' : 'ies') + ' that have not reached the cloud. Enter your offline PIN to sync them now.';
        }
        box.classList.remove('hidden');
    }

    function dlDismissPendingSync() {
        var box = document.getElementById('offline-pending-sync');
        if (box) box.classList.add('hidden');
    }

    window.dlDismissPendingSync = dlDismissPendingSync;

    window.dlUnlockVaultAndSync = function() {
        var pin = (document.getElementById('offline-pin-input') || {}).value || '';
        var msg = document.getElementById('offline-pin-msg');
        var btn = document.getElementById('offline-sync-btn');
        var showMsg = function(t) {
            if (!msg) return;
            msg.textContent = t;
            msg.classList.toggle('hidden', !t);
        };
        if (!window.DLOfflineVault) { showMsg('Offline vault is unavailable on this device.'); return; }
        if (!/^\d{4,6}$/.test(pin)) { showMsg('Enter a 4–6 digit PIN.'); return; }
        showMsg('');
        if (btn) btn.disabled = true;
        window.DLOfflineVault.unlock(pin).then(function(res) {
            if (!res || !res.ok) {
                if (btn) btn.disabled = false;
                var reasons = {
                    'bad-pin': 'Incorrect PIN.', 'locked': 'Too many attempts. Try again in a few minutes.',
                    'corrupt': 'The offline vault is unreadable. Remove offline access online and re-enroll.',
                    'expired': 'Offline access expired. Re-enroll online.', 'revoked': 'Offline access was revoked. Re-enroll online.',
                    'storage': 'Device storage is unavailable.'
                };
                showMsg(reasons[(res && res.reason)] || 'Unable to unlock.');
                return;
            }
            vaultQueueActive = true;
            return window.DLOfflineVault.migrateLegacy().catch(function() { return null; })
                .then(function() {
                    return window.DLOfflineVault.countPending().then(function(n) { vaultPendingCount = n; });
                })
                .then(function() {
                    renderOfflineReadyBadge(true);
                    return drainVault();
                })
                .then(function() {
                    dlShowPendingSyncPrompt(0);
                    renderConnectivityBanner();
                    if (window.showToast) window.showToast('Synced. Offline entries sent to the cloud.', 'success');
                });
        }).catch(function() {
            if (btn) btn.disabled = false;
            showMsg('Unable to unlock on this device.');
        });
    };

    function initializePendingQueue() {
        syncPendingStorage();
        renderConnectivityBanner();
        probeCloud();
        if (typeof window.dlCaptureProductReference === 'function') window.dlCaptureProductReference();
        if (typeof window.dlMaybeLockOffline === 'function') window.dlMaybeLockOffline();
        if (window.DLOfflineVault) {
            window.DLOfflineVault.hasLocalEnrollment().then(function(has) {
                if (has) {
                    renderOfflineReadyBadge(true);
                    if (window.DLOfflineVault.isUnlocked()) {
                        vaultQueueActive = true;
                        window.DLOfflineVault.migrateLegacy().catch(function() {});
                        window.DLOfflineVault.countPending().then(function(n) {
                            vaultPendingCount = n;
                            updateGlobalStatus('saved');
                            renderConnectivityBanner();
                        }).catch(function() {});
                    } else {
                        // Locked vault: surface unsynced work so it is never stuck.
                        window.DLOfflineVault.countPendingLocked().then(function(n) {
                            if (n > 0) dlShowPendingSyncPrompt(n);
                        }).catch(function() {});
                    }
                }
            });
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializePendingQueue);
    } else {
        initializePendingQueue();
    }

    function printCashierLedger() {
        var rows = Array.from(document.querySelectorAll('#ledger-body tr[data-product-id]'));
        if (rows.length === 0) {
            showToast('No ledger rows available to print.', 'error');
            return;
        }

        var printedAt = new Date().toLocaleString();
        var htmlRows = rows.map(function(row) {
            var rowNum = (row.querySelector('.row-num') || {}).textContent || '';
            var product = (row.querySelector('.product-name') || {}).textContent || '';
            var beg = (row.querySelector('[data-field="beg_bal"]') || {}).value || '0';
            var addtlEl = row.querySelector('[data-field="addtl"]') || {};
            var addtl = (addtlEl.value !== undefined ? addtlEl.value : addtlEl.textContent) || '0';
            var withdrawEl = row.querySelector('[data-field="withdraw"]') || {};
            var withdraw = (withdrawEl.value !== undefined ? withdrawEl.value : withdrawEl.textContent) || '0';
            var balEndEl = (row.querySelector('[data-field="bal_end"]') || {});
            var balEnd = (balEndEl.value !== undefined && balEndEl.value !== '') ? String(balEndEl.value) : '—';
            var sales = (row.querySelector('.sales-computed') || {}).textContent || 'Pending';

            return '<tr>' +
                '<td style="text-align:center;">' + String(rowNum).trim() + '</td>' +
                '<td>' + String(product).trim() + '</td>' +
                '<td style="text-align:right;">' + String(beg).trim() + '</td>' +
                '<td style="text-align:right;">' + String(addtl).trim() + '</td>' +
                '<td style="text-align:right;">' + String(withdraw).trim() + '</td>' +
                '<td style="text-align:right;">' + String(balEnd).trim() + '</td>' +
                '<td style="text-align:right;">' + String(sales).trim() + '</td>' +
                '</tr>';
        }).join('');

        var reportHtml = '<!doctype html><html><head><meta charset="utf-8">' +
            '<title>Daily Ledger Report</title>' +
            '<style>' +
{literal}            'body{font-family:Arial,sans-serif;color:#111827;margin:24px;}' +
            'h1{font-size:20px;margin:0 0 8px;}' +
            '.meta{font-size:13px;color:#374151;margin:2px 0;}' +
            'table{width:100%;border-collapse:collapse;margin-top:16px;}' +
            'th,td{border:1px solid #d1d5db;padding:8px;font-size:12px;vertical-align:top;}' +
            'th{background:#f3f4f6;text-align:left;}' +
{/literal}            '</style></head><body>' +
            '<h1>Daily Ledger Report</h1>' +
            '<div class="meta">Branch: {branch_name}</div>' +
            '<div class="meta">Ledger Date: {ledger_date}</div>' +
            '<div class="meta">Prepared By: {user_name} ({user_role})</div>' +
            '<div class="meta">Printed At: ' + printedAt + '</div>' +
            '<table><thead><tr>' +
            '<th>#</th><th>Description</th><th style="text-align:right;">Beg. Bal</th><th style="text-align:right;">Addt\'l</th><th style="text-align:right;">W/Draw</th><th style="text-align:right;">Bal. End</th><th style="text-align:right;">Sales</th>' +
            '</tr></thead><tbody>' + htmlRows + '</tbody></table>' +
            '</body></html>';

        var w = window.open('', '_blank', 'width=1024,height=768');
        if (!w) {
            showToast('Popup blocked. Please allow popups for printing.', 'error');
            return;
        }
        w.document.open();
        w.document.write(reportHtml);
        w.document.close();
        w.focus();
        w.print();
    }

    // Close PM shift: server-authoritative finalization of the manual day gate.
    window.finalizePmShift = function() {
        var btn = document.getElementById('finalize-pm-btn');
        if (btn) { btn.disabled = true; btn.textContent = 'Finalizing…'; }
        var box = document.getElementById('finalize-pm-result');
        if (box) { box.classList.add('hidden'); box.innerHTML = ''; }
        window.dlWriteTimeout(BASE + '/api/v1/cashier/ledger/finalize-pm', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify({ date: LEDGER_DATE, branch_id: BRANCH_ID })
        }, 'Finalizing the PM shift')
        .then(dlResponseJson)
        .then(function(res) {
            if (isSessionExpiredResponse(res)) { window.dlSessionExpired(res); return; }
            if (res.ok) {
                showToast('PM shift finalized.', 'success');
                location.reload();
                return;
            }
            var msg = res.error || 'Failed to finalize PM shift.';
            if (box) {
                var html = '<div class="font-semibold">' + String(msg) + '</div>';
                var missing = (res.missing_products || []).slice(0, 50);
                if (missing.length) {
                    html += '<ul class="mt-2 list-disc pl-5 text-xs">';
                    missing.forEach(function(m) {
                        html += '<li>' + String(m.name || ('Product #' + m.product_id)) + '</li>';
                    });
                    html += '</ul>';
                }
                box.innerHTML = html;
                box.classList.remove('hidden');
            }
            showToast(msg, 'error');
        })
        .catch(function(err) {
            showToast(err.message || 'Failed to finalize PM shift', 'error');
        })
        .finally(function() {
            if (btn) { btn.disabled = false; btn.textContent = 'Close PM Shift'; }
        });
    };

    // Overnight handoff: auto-adopt the previous day's recorded ending as the
    // AM beginning. Disabled inputs cover closed/reference-only days, and the
    // stored original beginning guard ensures cashier-entered values win.
    window.adoptAmBegBal = function() {
        if (SHIFT !== 'AM') return;
        var rows = [];
        var inputs = document.querySelectorAll('#ledger-body input[data-field="beg_bal"][data-prev-end]');
        inputs.forEach(function(input) {
            if (input.disabled) return;
            var orig = parseInt(input.getAttribute('data-orig-beg') || '0', 10);
            var prevEnd = parseInt(input.getAttribute('data-prev-end') || '0', 10);
            if (orig !== 0 || prevEnd <= 0) return;
            rows.push({ product_id: parseInt(input.getAttribute('data-product'), 10) || 0, beg_bal: prevEnd });
        });
        if (rows.length === 0) return;

        window.dlWriteTimeout(BASE + '/api/v1/cashier/ledger/save-batch', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify({
                date: LEDGER_DATE,
                branch_id: BRANCH_ID,
                shift: 'AM',
                idempotency_key: 'am-handoff-' + BRANCH_ID + '-' + LEDGER_DATE + '-' + Date.now(),
                rows: rows
            })
        }, 'Carrying the AM beginning forward')
        .then(dlResponseJson)
        .then(function(res) {
            if (isSessionExpiredResponse(res)) { window.dlSessionExpired(res); return; }
            if (res.ok && rows.length > 0 && window.showToast) {
                showToast('Carried forward the previous ending as AM beginning for ' + rows.length + ' product(s). Verify counts and adjust if needed.', 'success');
            }
            // Reload rows so the adopted beg_bal values are persisted/visible.
            if (window.htmx && document.getElementById('ledger-body')) {
                htmx.trigger(document.getElementById('ledger-body'), 'dl:rows-refresh');
            }
        })
        .catch(function() {});
    };

    // PM shift handoff: auto-adopt the AM shift's ending count as the PM
    // beginning (one batch save), so the PM cashier validates instead of
    // re-typing every product. Only runs for new PM rows (stored beg_bal = 0)
    // where the AM ending exists, on an open day. PM can still edit after.
    window.adoptPmBegBal = function() {
        if (SHIFT !== 'PM') return;
        var rows = [];
        var inputs = document.querySelectorAll('#ledger-body input[data-field="beg_bal"][data-am-end]');
        inputs.forEach(function(input) {
            if (input.disabled) return;
            var orig = parseInt(input.getAttribute('data-orig-beg') || '0', 10);
            var amEnd = parseInt(input.getAttribute('data-am-end') || '0', 10);
            if (orig !== 0 || amEnd <= 0) return;
            rows.push({ product_id: parseInt(input.getAttribute('data-product'), 10) || 0, beg_bal: amEnd });
        });
        if (rows.length === 0) return;

        window.dlWriteTimeout(BASE + '/api/v1/cashier/ledger/save-batch', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify({
                date: LEDGER_DATE,
                branch_id: BRANCH_ID,
                shift: 'PM',
                idempotency_key: 'pm-handoff-' + BRANCH_ID + '-' + LEDGER_DATE + '-' + Date.now(),
                rows: rows
            })
        }, 'Adopting the AM ending as the PM beginning')
        .then(dlResponseJson)
        .then(function(res) {
            if (isSessionExpiredResponse(res)) { window.dlSessionExpired(res); return; }
            if (res.ok && rows.length > 0 && window.showToast) {
                showToast('Adopted AM ending as PM beginning for ' + rows.length + ' product(s). Verify counts and adjust if needed.', 'success');
            }
            // Reload rows so the adopted beg_bal values are persisted/visible.
            if (window.htmx && document.getElementById('ledger-body')) {
                htmx.trigger(document.getElementById('ledger-body'), 'dl:rows-refresh');
            }
        })
        .catch(function() {});
    };

    document.addEventListener('htmx:afterSwap', function(e) {
        if (e.target && e.target.id === 'ledger-body') {
            window.adoptAmBegBal();
            window.adoptPmBegBal();
        }
    });
</script>
{/block}
