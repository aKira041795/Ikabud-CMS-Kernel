<!--
  Offline unlock — RETIRED cached-page overlay (Daily Ledger PWA v6).

  The old model served the authenticated ledger page from the service-worker
  cache and gated it with a device-local PBKDF2 PIN overlay. That model is
  replaced by the encrypted vault: the ledger page is never cached or served
  offline anymore, unlock happens in the token-free static offline shell
  (public/daily-ledger/offline.html + offline-app.js), and the PIN now
  wraps the vault data key.

  This block is a compatibility shim only. It keeps the old global function
  names from throwing for any lingering reference and no-ops the overlay.
-->
<script>
(function() {
    // The static offline shell owns unlock now. These legacy globals are
    // kept as inert compatibility stubs; they never gate the ledger page.
    window.dlOfflineAuthHasVerifier = function() { return false; };
    window.dlOfflineAuthSetPin = function() { return Promise.resolve(false); };
    window.dlOfflineAuthClear = function() {};
    window.dlOfflineAuthLockState = function() { return { locked: false }; };
    window.dlOfflineAuthVerify = function() { return Promise.resolve(false); };
    window.dlOfflineLockNotes = function() {};
    // The ledger page is never served as a cached offline shell; nothing to
    // lock here. Unlock/readiness live in the offline shell.
    window.dlMaybeLockOffline = function() {};
})();
</script>
