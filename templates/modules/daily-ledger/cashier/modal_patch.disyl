<!-- Withdrawal Modal -->
<div x-data="withdrawalModal()"
     x-cloak
     x-on:open-withdrawal-modal.window="openModal($event.detail)"
     class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true" x-show="isOpen">
    <div x-show="isOpen" x-transition.opacity class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>
    <div class="fixed inset-0 z-10 overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div x-show="isOpen"
                 x-transition:enter="ease-out duration-300"
                 x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                 x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
                 x-transition:leave="ease-in duration-200"
                 x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
                 x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                 @click.away="closeModal()"
                 class="relative transform overflow-hidden rounded-lg bg-white px-4 pb-4 pt-5 text-left shadow-xl transition-all sm:my-8 w-full sm:max-w-2xl sm:p-6">

                <div>
                    <h3 class="text-lg font-semibold leading-6 text-gray-900" id="modal-title">Stock Adjustment</h3>
                    <p class="text-sm text-gray-500 mb-4">Record branch-side stock corrections: <span class="font-semibold">charge</span> (cashier accountability), <span class="font-semibold">pullout</span> (unsold goods returning to commissary), <span class="font-semibold">used</span> (packaging/items consumed to make or fill a product), <span class="font-semibold">correction</span> (fixing a wrongly-recorded entry), or <span class="font-semibold">add stock</span> (stock that was missed or undercounted). <span class="font-semibold">Pullout items are automatically sent back to the commissary</span> — they will appear as incoming stock on the commissary ledger.</p>
                    <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-900">
                        Quick rule: if another branch is involved, stop and use <span class="font-semibold">Send to Branch</span> or <span class="font-semibold">Receive Stock</span>. This modal is only for branch-side stock corrections. <span class="font-semibold">Pullout</span> returns goods to your assigned commissary automatically.
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Type *</label>
                            <select x-model="header.withdrawal_type" class="form-input mt-0 w-full">
                                <option value="charge">Charge</option>
                                <option value="pullout">Pullout</option>
                                <option value="used">Used (for a product/order)</option>
                                <option value="correction">Correction (wrong entry)</option>
                                <option value="adjustment_add">Add Stock (missed entry / variance)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-700 mb-1">Reason Code <span class="text-rose-500">*</span></label>
                        <select x-model="header.reason_code" class="form-input mt-0 w-full">
                            <option value="manual_adjustment">Manual adjustment</option>
                            <option value="encoder_omission">Encoder omission (nothing lost)</option>
                            <option value="spoilage">Spoilage</option>
                            <option value="staff_meal">Staff meal</option>
                            <option value="sampling">Sampling</option>
                            <option value="testing">Testing</option>
                            <option value="promo">Promo</option>
                            <option value="donation">Donation</option>
                            <option value="damage">Damage</option>
                            <option value="other">Other</option>
                        </select>
                        <p class="mt-1 text-xs text-gray-500">Required for branch-side adjustments. Branch-to-branch transfers now go through Send to Branch.</p>
                        </div>
                    </div>

                    <div class="mb-4" x-show="allowsNegative()">
                        <div class="rounded-lg border border-orange-200 bg-orange-50 px-3 py-2 text-xs leading-5 text-orange-800">
                            <span class="font-semibold" x-text="header.withdrawal_type === 'correction' ? 'Correction' : 'Add Stock'"></span> adds to today's total by default. To <span class="font-semibold">reduce</span> an amount that was recorded too high, put a minus sign first (e.g. <span class="font-mono font-semibold">-3</span>). This is the way to take back Additional stock that was keyed too high — the ledger's Addt'l cell cannot be edited directly. Logged as its own row, so the trail reads: original entry → correction.
                        </div>
                    </div>

                    <div class="mb-4" x-show="header.reason_code === 'other'">
                        <label class="block text-xs font-medium text-gray-700 mb-1">Custom Reason <span class="text-rose-500">*</span></label>
                        <input type="text" x-model="header.custom_reason" maxlength="255" class="form-input mt-0 w-full" placeholder="Describe the reason for this adjustment">
                        <p class="mt-1 text-xs text-gray-500">Required when Reason Code is "Other". Shown in the Adjustment Log.</p>
                    </div>

                    <div class="mb-4" x-show="showsLiable()">
                        <template x-if="isOmission()">
                            <div class="rounded-lg border border-sky-200 bg-sky-50 px-3 py-2 text-xs leading-5 text-sky-900">
                                <span class="font-semibold">Nothing was lost</span> — this records stock that was simply not entered, so no one is charged and no liable person is recorded.
                            </div>
                        </template>
                        <template x-if="!isOmission()">
                            <div>
                                <label class="block text-xs font-medium text-gray-700 mb-1">Charge to
                                    <span x-show="needsLiable()" class="text-rose-500">*</span>
                                    <span x-show="!needsLiable()" class="text-gray-400 font-normal">(optional)</span>
                                </label>
                                <select x-model="header.liable_user_id" class="form-input mt-0 w-full">
                                    <option value="">-- Select liable person --</option>
                                    <template x-for="lp in (window.LIABLE_PERSONS || [])" :key="lp.id">
                                        <option :value="lp.id" x-text="lp.label || (lp.name + ' (' + lp.role + ')')"></option>
                                    </template>
                                </select>
                                <p x-show="needsLiable()" class="mt-1 text-xs text-gray-500">Person financially liable for the missing items. Items are added back to branch sales; payment is charged to this person. This branch's cashiers are listed first. If nothing was lost and the entry was simply missed, choose the <span class="font-semibold">Encoder omission</span> reason instead — no one is charged.</p>
                                <p x-show="!needsLiable()" class="mt-1 text-xs text-gray-500">Person this removed stock is charged to. Payment is collected from them; leave it blank to keep the amount on the branch. This branch's cashiers are listed first.</p>
                            </div>
                        </template>
                    </div>

                    <div class="mb-3 bg-gray-50 rounded-lg p-3">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="border-b border-gray-200">
                                    <th class="py-2 text-left font-medium text-gray-700">Product</th>
                                    <th class="py-2 text-left font-medium text-gray-700 w-24">Unit</th>
                                    <th class="py-2 text-right font-medium text-gray-700 w-24">Qty</th>
                                    <th class="py-2 w-10"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-for="(line, idx) in lines" :key="idx">
                                    <tr class="border-b border-gray-100">
                                        <td class="py-2 pr-2">
                                            <select x-model="line.product_id" @change="onProductChange(idx)" class="form-input mt-0 py-1 px-2 w-full">
                                                <option value="">-- Select Product --</option>
                                                <template x-for="p in products" :key="p.id">
                                                    <option :value="p.id" x-text="p.name"></option>
                                                </template>
                                            </select>
                                        </td>
                                        <td class="py-2 pr-2 align-middle">
                                            <template x-if="packFor(line.product_id)">
                                                <select x-model="line.unit" class="form-input mt-0 py-1 px-1 w-full text-xs" title="Sold by box? Enter Qty as the number of boxes — the system converts to pieces.">
                                                    <option value="pcs">Pcs</option>
                                                    <option value="box">Box</option>
                                                </select>
                                            </template>
                                            <template x-if="!packFor(line.product_id)">
                                                <span class="inline-block w-full text-center text-xs font-medium text-gray-400">pcs</span>
                                            </template>
                                        </td>
                                        <td class="py-2 pr-2">
                                            <input type="number" x-model="line.quantity" :min="allowsNegative() ? -999999 : 0" class="form-input mt-0 py-1 px-2 text-right w-full">
                                            <div x-show="allowsNegative() && line.quantity < 0" class="mt-0.5 text-right text-[10px] font-semibold leading-tight text-orange-600">reduces today's total</div>
                                            <div x-show="line.unit === 'box' && packFor(line.product_id)" class="mt-0.5 text-right text-[10px] leading-tight text-gray-400">
                                                1 box = <span x-text="packFor(line.product_id)"></span> pcs
                                            </div>
                                        </td>
                                        <td class="py-2 text-right">
                                            <button type="button" @click="lines.splice(idx, 1)" class="text-rose-500 hover:text-rose-700 p-1 rounded hover:bg-rose-50" x-show="lines.length > 1">
                                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                                </svg>
                                            </button>
                                        </td>
                                    </tr>
                                </template>
                            </tbody>
                            <tfoot class="bg-gray-100 border-t border-gray-200">
                                <tr>
                                    <th class="py-2 px-3 text-right font-medium text-gray-900">Total:</th>
                                    <th></th>
                                    <th class="py-2 text-right pr-2 font-bold text-gray-900" x-text="totalPieces() + ' pcs'"></th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <button type="button" @click="addEmptyLine()" class="btn btn-outline w-full justify-center mb-4">+ Add Product</button>

                    <div x-show="errorMsg" class="mb-3 flex items-start gap-2 rounded-md border border-rose-300 bg-rose-50 px-3 py-2">
                        <i class="fas fa-triangle-exclamation mt-0.5 text-rose-600" aria-hidden="true"></i>
                        <p class="text-sm leading-5 text-rose-800" x-text="errorMsg"></p>
                    </div>
                </div>

                <div class="mt-5 sm:mt-6 sm:flex sm:flex-row-reverse border-t border-gray-200 pt-4">
                    <button type="button" @click="saveChanges()" class="inline-flex w-full items-center justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 sm:ml-3 sm:w-auto" x-bind:disabled="saving">
                        <svg x-show="saving" class="mr-2 h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
                        </svg>
                        <span x-text="saving ? 'Saving...' : 'Save Adjustment'"></span>
                    </button>
                    <button type="button" @click="closeModal()" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto" x-bind:disabled="saving">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
window.openWithdrawalModal = function(entry) {
    window.dispatchEvent(new CustomEvent('open-withdrawal-modal', { detail: entry || {} }));
};

function withdrawalModal() {
    return {
        isOpen: false,
        saving: false,
        errorMsg: '',
        editId: null,
        header: { withdrawal_type: 'charge', reason_code: 'manual_adjustment', liable_user_id: '', custom_reason: '' },
        lines: [],
        products: [],

        openModal(detail) {
            detail = detail || {};
            this.errorMsg = '';
            this.editId = detail.id ? parseInt(detail.id, 10) : null;
            this.loadProducts();
            if (this.editId) {
                var e = detail;
                var unit = e.unit === 'box' ? 'box' : 'pcs';
                var pieces = parseInt(e.quantity, 10) || 0;
                var displayQty = unit === 'box'
                    ? (parseInt(e.pack_qty, 10) || Math.ceil(pieces / (this.packFor(e.product_id) || 1)))
                    : pieces;
                this.header = {
                    withdrawal_type: e.withdrawal_type || 'charge',
                    reason_code: e.reason_code || 'manual_adjustment',
                    liable_user_id: e.liable_user_id ? String(e.liable_user_id) : '',
                    custom_reason: e.custom_reason || ''
                };
                this.lines = [{ product_id: String(e.product_id), quantity: displayQty, unit: unit }];
            } else {
                // Honor a preset type/product so a caller can open the modal directly on
                // "Add Stock" (adjustment_add) for a specific row, without a paper DR.
                this.header = {
                    withdrawal_type: detail.withdrawal_type || 'charge',
                    reason_code: detail.reason_code || 'manual_adjustment',
                    liable_user_id: '',
                    custom_reason: ''
                };
                this.lines = [{ product_id: detail.product_id ? String(detail.product_id) : '', quantity: '', unit: 'pcs' }];
            }
            // One idempotency key per modal session: a retry after a lost response
            // reuses it, so the server replays the original result instead of
            // creating a duplicate withdrawal.
            this.idempotencyKey = window.generateOperationId ? window.generateOperationId() : String(Date.now());
            this.isOpen = true;
        },

        closeModal() {
            if (window.dlSetBusy) window.dlSetBusy(false);
            this.isOpen = false;
        },

        // A charge removes stock and can be billed to the person responsible, so
        // it offers the same list as Add Stock — optional there, because the
        // amount may simply stay on the branch.
        showsLiable() {
            return this.header.withdrawal_type === 'adjustment_add' || this.header.withdrawal_type === 'charge';
        },

        // Stock that was never lost: Add Stock recorded because the entry was
        // simply missed. No charge, no liable person.
        isOmission() {
            return this.header.withdrawal_type === 'adjustment_add' && this.header.reason_code === 'encoder_omission';
        },

        // Only Add Stock that resolves a shortage MUST name who is charged: the
        // stock is added back to sales and somebody has to answer for it. Every
        // other type records what it records and charges nobody by default. Must
        // mirror the server rule in apiSaveCashierWithdrawals / handlers-offline.
        needsLiable() {
            return this.header.withdrawal_type === 'adjustment_add' && this.header.reason_code !== 'encoder_omission';
        },

        // A minus sign means "take back an amount recorded too high". Correction does
        // that for Withdraw, Add Stock for Addt'l — the Addt'l cell has no input, so
        // this is the only way to reduce it. Mirrors dl_withdrawalTypeAllowsNegative
        // on the server; the modal only decides whether the operator MAY type a
        // minus, the server is what enforces it.
        allowsNegative() {
            return this.header.withdrawal_type === 'correction' || this.header.withdrawal_type === 'adjustment_add';
        },

        addEmptyLine() { this.lines.push({ product_id: '', quantity: '', unit: 'pcs' }); },

        // pcs_per_pack for a product (0 = not sold by box)
        packFor(pid) {
            if (!pid) return 0;
            var found = this.products.find(function(p) { return String(p.id) === String(pid); });
            var pack = found ? (parseInt(found.pack, 10) || 0) : 0;
            return pack > 0 ? pack : 0;
        },

        onProductChange(idx) {
            // Products without a configured box size are pcs-only.
            var line = this.lines[idx];
            if (line && !this.packFor(line.product_id)) {
                line.unit = 'pcs';
            }
        },

        totalQty() {
            return this.lines.reduce(function(sum, l) { return sum + (parseInt(l.quantity) || 0); }, 0);
        },

        // Total expressed in pieces (box qty x pcs_per_pack when unit=box).
        totalPieces() {
            var self = this;
            return this.lines.reduce(function(sum, l) {
                var q = parseInt(l.quantity) || 0;
                if (l.unit === 'box') {
                    var pack = self.packFor(l.product_id);
                    return sum + (pack > 0 ? q * pack : q);
                }
                return sum + q;
            }, 0);
        },

        loadProducts() {
            this.products = [];
            var rows = document.querySelectorAll('tr[data-product-id]');
            var seen = {};
            rows.forEach(function(r) {
                var pid = r.getAttribute('data-product-id');
                var nm = (r.querySelector('.product-name') || {}).textContent || '';
                var pack = parseInt(r.getAttribute('data-pack'), 10) || 0;
                if (pid && !seen[pid]) {
                    seen[pid] = true;
                    this.products.push({ id: pid, name: nm.trim(), pack: pack });
                }
            }.bind(this));
            if (rows.length === 0 && typeof window.dlReadProductReference === 'function') {
                window.dlReadProductReference().then(function(products) {
                    this.products = (products || []).map(function(p) {
                        return { id: p.id, name: p.name, pack: parseInt(p.pcs_per_pack, 10) || 0 };
                    });
                }.bind(this));
            }
        },

        validate() {
            this.errorMsg = '';
            if (!this.header.reason_code || String(this.header.reason_code).trim() === '') {
                this.errorMsg = 'Reason code is required.';
                return false;
            }
            if (this.header.reason_code === 'other' && (!this.header.custom_reason || String(this.header.custom_reason).trim() === '')) {
                this.errorMsg = 'A custom reason is required when Reason is Other.';
                return false;
            }
            if (this.needsLiable() && (!this.header.liable_user_id || String(this.header.liable_user_id).trim() === '')) {
                this.errorMsg = 'Charge to (liable person) is required for Add Stock that resolves a shortage. Use the Encoder omission reason if nothing was lost.';
                return false;
            }
            var allowsNegative = this.allowsNegative();
            var hasInvalidNegative = false;
            this.lines.forEach(function(l) {
                var q = parseInt(l.quantity, 10);
                if (!isNaN(q) && q < 0 && !allowsNegative) hasInvalidNegative = true;
            });
            if (hasInvalidNegative) {
                this.errorMsg = 'Negative quantities are only allowed on a Correction or Add Stock entry (use -3 to reduce).';
                return false;
            }
            var validLines = this.lines.filter(function(l) {
                var q = parseInt(l.quantity, 10);
                return l.product_id && !isNaN(q) && q !== 0;
            });
            if (validLines.length === 0) {
                this.errorMsg = 'Add at least one product with a quantity greater than 0.';
                return false;
            }
            return true;
        },

        saveChanges() {
            if (!this.validate()) return;
            this.saving = true;
            if (window.dlSetBusy) window.dlSetBusy(true, 'Saving adjustment…');
            var isEdit = !!this.editId;

            var allowsNegative = this.allowsNegative();
            var validLines = this.lines.filter(function(l) {
                var q = parseInt(l.quantity, 10);
                if (!l.product_id || isNaN(q) || q === 0) return false;
                if (q < 0 && !allowsNegative) return false;
                return true;
            });
            var payload = {
                date: LEDGER_DATE,
                // The shift being viewed. Without this the server guesses from the
                // request clock (or the user's assigned shift), so an adjustment made
                // while looking at another shift/date lands on the wrong ledger row
                // and the Addt'l cell the operator is fixing stays at zero.
                shift: (window.SHIFT || ''),
                header: {
                    withdrawal_type: this.header.withdrawal_type,
                    reason_code: this.header.reason_code || 'manual_adjustment',
                    custom_reason: this.header.reason_code === 'other' ? (this.header.custom_reason || '').trim() : '',
                    // Sent whenever the field is offered (Add Stock and Charge), so a
                    // charge actually records who it is billed to.
                    liable_user_id: this.showsLiable() ? (parseInt(this.header.liable_user_id) || null) : null
                },
                lines: validLines.map(function(l) {
                    var q = parseInt(l.quantity, 10);
                    return {
                        product_id: parseInt(l.product_id),
                        quantity: q,
                        unit: (l.unit === 'box' && q >= 0) ? 'box' : 'pcs'
                    };
                })
            };
            if (window.BRANCH_ID) payload.branch_id = window.BRANCH_ID;
            if (isEdit) payload.withdrawal_id = this.editId;
            else if (this.header.withdrawal_type === 'pullout' && window.COMMISSARY_BRANCH_ID && window.COMMISSARY_BRANCH_ID !== '') {
                payload.header.target_branch_id = parseInt(window.COMMISSARY_BRANCH_ID, 10);
            }
            payload.idempotency_key = this.idempotencyKey || (window.generateOperationId ? window.generateOperationId() : String(Date.now()));

            // ONLINE-ONLY (owner decision 2026-09-22). A ledger write is never
            // buffered on the device, not even when the browser reports no connection:
            // queueing gives the editor/cashier a false sense of stored data, and the
            // entries that were believed saved are later re-keyed by hand, which is how
            // duplicates balloon the ledger. Every adjustment is ATTEMPTED; it either
            // lands or it fails visibly with the reason and a Retry (the Save button).
            // Retrying is safe: the payload carries an idempotency key whose response is
            // cached 24h, and dl_cashier_withdrawals has a UNIQUE dedup_hash index, so a
            // retry cannot produce a duplicate. Do NOT reintroduce enqueueOperation here.

            var url = BASE + (isEdit ? '/api/v1/cashier/ledger/withdrawals/edit' : '/api/v1/cashier/ledger/withdrawals');
            window.dlWriteTimeout(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': (window.DL_CSRF || ''),
                    'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
                },
                body: JSON.stringify(payload)
            }, isEdit ? 'This correction' : 'This adjustment')
            .then(function(r) {
                // Carry the HTTP status so the shared queue-vs-error classifier can
                // decide structurally instead of by matching the message text.
                return r.json().then(function(body) {
                    if (body && typeof body === 'object') body.__status = r.status;
                    return body;
                });
            })
            .then(function(data) {
                this.saving = false;
                if (data.ok) {
                    var msg = isEdit ? 'Adjustment updated' : 'Adjustment saved';
                    if (!isEdit && data.duplicate) {
                        // DB-level dedup guard replay: identical line(s) already recorded.
                        msg = 'Duplicate ignored — identical adjustment already recorded';
                    } else if (!isEdit && this.header.withdrawal_type === 'adjustment_add') {
                        // A minus on Add Stock takes stock BACK, so reporting "Stock
                        // added" would state the opposite of what was recorded.
                        if (this.totalQty() < 0) {
                            msg = 'Additional stock reduced — entry correction';
                        } else {
                            msg = this.needsLiable()
                                ? 'Stock added — charged to liable person'
                                : 'Stock added — entry correction, nothing was lost';
                        }
                    } else if (!isEdit && data.delivery_id && data.receiving_id) {
                        msg = 'Pullout recorded and returned to commissary';
                    }
                    showToast(msg, 'success');
                    this.closeModal();
                    if (typeof window.dlRefreshTodayAdjustments === 'function') window.dlRefreshTodayAdjustments();
                    if (typeof window.refreshMainContent === 'function') window.refreshMainContent();
                } else if (!isEdit && window.shouldQueueServerFailure && window.shouldQueueServerFailure(data)) {
                    // ONLINE-ONLY: a retryable server error is reported, not buffered.
                    this.errorMsg = 'NOT saved — the server is not accepting changes right now ('
                        + (data && data.error ? data.error : 'temporary error') + '). Retry in a moment.';
                } else {
                    if (window.dlSetBusy) window.dlSetBusy(false);
                    this.errorMsg = data.error || 'Failed to save adjustment.';
                }
            }.bind(this))
            .catch(function(err) {
                this.saving = false;
                if (window.dlSetBusy) window.dlSetBusy(false);
                // ONLINE-ONLY: never buffered. The modal stays open so the Save button
                // IS the retry, and the reason is stated rather than implied.
                this.errorMsg = (err && err.dlTimedOut)
                    ? window.dlWriteTimeoutMessage(isEdit ? 'This correction' : 'This adjustment')
                    : 'NOT saved — the server could not be reached. Check the connection and retry.';
            }.bind(this));
        }
    };
}
</script>
