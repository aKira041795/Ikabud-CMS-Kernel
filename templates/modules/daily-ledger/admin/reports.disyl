{extends "modules/daily-ledger/layouts/app.disyl"}

{block content}
<div class="flex items-center justify-between mb-6">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">{report_title}</h2>
        <p class="text-sm text-gray-500">Governed PDF and CSV deliverables. Exports are archived and audited.</p>
    </div>
    {if !landing}<a class="btn btn-outline" href="{base_url}/admin/reports">All Reports</a>{/if}
</div>

{if landing}
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    {foreach report_packs as pack}
    <a href="{base_url}/admin/reports/{pack.report_id}" class="card hover:border-indigo-300">
        <div class="card-body">
            <div class="text-base font-semibold text-gray-900">{pack.title}</div>
            <div class="text-sm text-gray-500 mt-1">{pack.description}</div>
            <div class="text-xs text-indigo-600 mt-3">PDF + CSV · Intended cadence: {pack.schedule}</div>
        </div>
    </a>
    {/foreach}
</div>
<div class="card">
    <div class="card-header"><span>Recent Archived Reports</span><span class="text-sm text-muted">{archives | count}</span></div>
    <div class="table-wrap">
        <table><thead><tr><th>Created</th><th>Title</th><th>Format</th><th>Generated By</th><th>Archive ID</th></tr></thead>
        <tbody>
        {if archives | count == 0}<tr><td colspan="5" class="text-center text-muted">No archived Daily Ledger reports yet.</td></tr>{/if}
        {foreach archives as item}<tr><td>{item.created_at}</td><td>{item.title}</td><td>{item.format}</td><td>{item.generated_by}</td><td>{item.id}</td></tr>{/foreach}
        </tbody></table>
    </div>
</div>
{/if}

{if !landing}
<form class="card mb-6" action="{base_url}/admin/reports/{report_type}" method="GET" onsubmit="return window.dlLoadForm(this)">
    <div class="card-body grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3 items-end">
        <div class="form-group"><label class="form-label">From</label><input class="form-input" type="date" name="date_from" value="{filters.date_from}"></div>
        <div class="form-group"><label class="form-label">To</label><input class="form-input" type="date" name="date_to" value="{filters.date_to}"></div>
        <div class="form-group"><label class="form-label">Branch</label><select class="form-input" name="branch_id"><option value="">All</option>{foreach branches as branch}<option value="{branch.id}" {if branch.id == filters.branch_id}selected{/if}>{branch.name}</option>{/foreach}</select></div>
        <div class="form-group"><label class="form-label">Product</label><select class="form-input" name="product_id"><option value="">All</option>{foreach products as product}<option value="{product.id}" {if product.id == filters.product_id}selected{/if}>{product.name}</option>{/foreach}</select></div>
        <div class="form-group"><label class="form-label">Shift</label><select class="form-input" name="shift"><option value="">All</option><option value="AM" {if filters.shift == 'AM'}selected{/if}>AM</option><option value="PM" {if filters.shift == 'PM'}selected{/if}>PM</option></select></div>
        <button class="btn btn-primary" type="submit">Apply</button>
    </div>
</form>

<div class="flex gap-2 justify-end mb-4">
    <a class="btn btn-outline" href="{base_url}/admin/reports/{report_type}/export?format=csv&date_from={filters.date_from}&date_to={filters.date_to}&branch_id={filters.branch_id}&product_id={filters.product_id}&shift={filters.shift}">Download CSV</a>
    <a class="btn btn-primary" href="{base_url}/admin/reports/{report_type}/export?format=pdf&date_from={filters.date_from}&date_to={filters.date_to}&branch_id={filters.branch_id}&product_id={filters.product_id}&shift={filters.shift}">Download PDF</a>
</div>

<div class="card mb-4">
    <div class="card-header"><span>Totals</span><span class="text-sm text-muted">{report_rows | count} rows</span></div>
    <div class="card-body text-sm text-gray-700">
        {if report_type == 'variances'}Unreviewed: <strong>{totals.unreviewed}</strong> · Absolute variance: <strong>{totals.absolute_variance}</strong>{/if}
        {if report_type != 'variances'}Official: <strong>{totals.official_units}</strong> units · PHP <strong>{totals.official_amount | number_format:2}</strong> · Provisional: <strong>{totals.provisional_units}</strong> units · PHP <strong>{totals.provisional_amount | number_format:2}</strong>{/if}
    </div>
</div>

<div class="card"><div class="table-wrap"><table>
{if report_type == 'sales'}
<thead><tr><th>Date</th><th>Shift</th><th>Branch</th><th>Product</th><th>Ending</th><th>Sales</th><th>Amount</th><th>Status</th></tr></thead><tbody>
{foreach report_rows as row}<tr><td>{row.ledger_date}</td><td>{row.shift}</td><td>{row.branch_name}</td><td>{row.product_name}</td><td>{if row.bal_end !== null}{row.bal_end}{else}—{/if}</td><td>{if row.sales !== null}{row.sales}{else}—{/if}</td><td>PHP {row.amount | number_format:2}</td><td>{row.status_label}</td></tr>{/foreach}
</tbody>
{/if}
{if report_type == 'variances'}
<thead><tr><th>Date</th><th>Shift</th><th>Kind</th><th>Branch</th><th>Product</th><th>Expected</th><th>Recorded</th><th>Variance</th><th>Status</th></tr></thead><tbody>
{foreach report_rows as row}<tr><td>{row.ledger_date}</td><td>{row.shift}</td><td>{row.kind}</td><td>{row.branch_name}</td><td>{row.product_name}</td><td>{row.expected_end_bal}</td><td>{row.recorded_end_bal}</td><td>{row.variance}</td><td>{row.resolution_status}</td></tr>{/foreach}
</tbody>
{/if}
{if report_type == 'branch-summary'}
<thead><tr><th>Branch</th><th>Official Units</th><th>Official Amount</th><th>Provisional Units</th><th>Provisional Amount</th></tr></thead><tbody>
{foreach report_rows as row}<tr><td>{row.branch_name}</td><td>{row.official_units}</td><td>PHP {row.official_amount | number_format:2}</td><td>{row.provisional_units}</td><td>PHP {row.provisional_amount | number_format:2}</td></tr>{/foreach}
</tbody>
{/if}
{if report_type == 'month-end'}
<thead><tr><th>Month</th><th>Branch</th><th>Official Units</th><th>Official Amount</th><th>Provisional Units</th><th>Provisional Amount</th></tr></thead><tbody>
{foreach report_rows as row}<tr><td>{row.month}</td><td>{row.branch_name}</td><td>{row.official_units}</td><td>PHP {row.official_amount | number_format:2}</td><td>{row.provisional_units}</td><td>PHP {row.provisional_amount | number_format:2}</td></tr>{/foreach}
</tbody>
{/if}
</table></div></div>
{/if}
{/block}
