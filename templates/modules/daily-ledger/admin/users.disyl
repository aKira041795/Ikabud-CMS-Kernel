{extends "modules/daily-ledger/layouts/app.disyl"}

{block head}
{/block}

{block content}
<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">Users</h2>
        <p class="text-sm text-gray-500">Manage cashiers, supervisors, admins, and production in-charge users.</p>
    </div>
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
        <form class="flex gap-2" action="{base_url}/admin/users" method="GET">
            <input type="hidden" name="tab" value="{tab}">
            <input type="text" class="form-input w-full sm:w-64" name="q" value="{search}" placeholder="Search name, username, email, or role...">
            <button type="submit" class="btn btn-outline">Search</button>
        </form>
        <button class="btn btn-primary" onclick="openAddUser()">+ Add User</button>
    </div>
</div>

<div class="mb-4 flex flex-wrap gap-2 border-b border-gray-200">
    <a href="{base_url}/admin/users?tab=active{if search != ''}&q={search}{/if}" class="px-3 py-2 text-sm font-semibold {if tab == 'active'}border-b-2 border-emerald-600 text-emerald-700{else}text-gray-500 hover:text-gray-700{/if}">Active <span class="ml-1 inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-200">{active_count}</span></a>
    <a href="{base_url}/admin/users?tab=inactive{if search != ''}&q={search}{/if}" class="px-3 py-2 text-sm font-semibold {if tab == 'inactive'}border-b-2 border-amber-600 text-amber-700{else}text-gray-500 hover:text-gray-700{/if}">Inactive <span class="ml-1 inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700 ring-1 ring-inset ring-amber-200">{inactive_count}</span></a>
    <a href="{base_url}/admin/users?tab=deleted{if search != ''}&q={search}{/if}" class="px-3 py-2 text-sm font-semibold {if tab == 'deleted'}border-b-2 border-rose-600 text-rose-700{else}text-gray-500 hover:text-gray-700{/if}">Deleted <span class="ml-1 inline-flex items-center rounded-full bg-rose-50 px-2 py-0.5 text-xs font-semibold text-rose-700 ring-1 ring-inset ring-rose-200">{deleted_count}</span></a>
</div>

<div class="card">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Full Name</th>
                    <th>Role</th>
                    <th>Branch(es)</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {foreach users as u}
                <tr>
                    <td class="font-mono text-sm text-gray-900">{u.username}</td>
                    <td class="text-sm text-gray-600">{if u.email}{u.email}{else}<span class="text-gray-400">No email</span>{/if}</td>
                    <td class="font-medium text-gray-900">{u.full_name}</td>
                    <td>
                        <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset
                            {if u.role == 'admin'}bg-rose-50 text-rose-700 ring-rose-200{/if}
                            {if u.role == 'cashier'}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}
                            {if u.role == 'supervisor'}bg-amber-50 text-amber-700 ring-amber-200{/if}
                            {if u.role == 'production_in_charge'}bg-indigo-50 text-indigo-700 ring-indigo-200{/if}
                        ">
                            {if u.role == 'production_in_charge'}Production in-charge{else}{u.role}{/if}
                        </span>
                    </td>
                    <td class="text-sm text-muted">
                        {if u.role == 'cashier'}
                            {foreach branches as br}{if br.id == u.branch_id}{br.name}{/if}{/foreach}
                        {/if}
                        {if u.role == 'supervisor'}{if u.branch_names}{u.branch_names}{else}<span class="text-gray-400">No branches</span>{/if}{/if}
                        {if u.role == 'production_in_charge'}{if u.branch_names}{u.branch_names}{else}<span class="text-gray-400">No branches</span>{/if}{/if}
                        {if u.role == 'admin'}<span class="text-gray-400">All branches</span>{/if}

                    </td>
                    <td>
                        {if u.deleted_at}<span class="inline-flex items-center rounded-full bg-rose-50 px-2.5 py-1 text-xs font-semibold text-rose-700 ring-1 ring-inset ring-rose-200">Deleted</span>{else}
                        {if u.is_active == 1}<span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-200">Active</span>{/if}
                        {if u.is_active == 0}<span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 ring-1 ring-inset ring-amber-200">Inactive</span>{/if}
                        {/if}
                    </td>
                    <td>
                        {if u.deleted_at}
                        <button class="btn btn-sm btn-outline restore-user-btn" data-id="{u.id}" data-role="{u.role}" data-fullname="{u.full_name}">Restore</button>
                        {else}
                        <button class="btn btn-sm btn-outline edit-user-btn"
                            data-id="{u.id}"
                            data-email="{u.email}"
                            data-fullname="{u.full_name}"
                            data-role="{u.role}"
                            data-active="{u.is_active}"
                            data-branch-id="{u.branch_id|default:0}"
                            data-branch-ids-csv="{u.branch_ids_csv}"

                        >Edit</button>
                        <button class="btn btn-sm btn-outline delete-user-btn" data-id="{u.id}" data-role="{u.role}" data-fullname="{u.full_name}">Delete</button>
                        {/if}
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>
</div>

<!-- Add User Modal -->
<div class="modal-overlay" id="add-modal">
    <div class="modal">
        <h3>Add User</h3>
        <div class="form-group">
            <label class="form-label">Username</label>
            <input class="form-input" type="text" id="add-username" autocomplete="off">
        </div>
        <div class="form-group">
            <label class="form-label">Email <span class="font-normal text-gray-500">(used for email login and password recovery)</span></label>
            <input class="form-input" type="email" id="add-email" autocomplete="email">
        </div>
        <div class="form-group">
            <label class="form-label">Password</label>
            <input class="form-input" type="password" id="add-password" autocomplete="new-password">
        </div>
        <div class="form-group">
            <label class="form-label">Full Name</label>
            <input class="form-input" type="text" id="add-fullname">
        </div>
        <div class="form-group">
            <label class="form-label">Role</label>
            <select class="form-input" id="add-role">
                <option value="admin">Admin</option>
                <option value="supervisor">Supervisor</option>
                <option value="production_in_charge">Production in-charge</option>
                <option value="cashier">Cashier</option>
            </select>
        </div>
        <div class="form-group" id="add-branch-group">
             <label class="form-label">Assign to Branch <span class="font-normal text-gray-500">(cashiers only)</span></label>
            <select class="form-input" id="add-branch">
                <option value="">— Select Branch —</option>
                {foreach branches as br}
                <option value="{br.id}">{br.name}</option>
                {/foreach}
            </select>
        </div>
        <div class="form-group" id="add-branches-group">
            <label class="form-label">Assign Branches <span class="font-normal text-gray-500">(for supervisors and production in-charge)</span></label>
            <select class="form-input" id="add-branches" multiple size="6">
                {foreach branches as br}
                <option value="{br.id}">{br.name}</option>
                {/foreach}
            </select>
        </div>

        <div class="modal-actions">
            <button class="btn btn-outline" onclick="closeModal('add-modal')">Cancel</button>
            <button class="btn btn-primary" id="add-submit" onclick="submitAddUser()">Add User</button>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal-overlay" id="edit-modal">
    <div class="modal">
        <h3>Edit User</h3>
        <input type="hidden" id="edit-id">
        <div class="form-group">
            <label class="form-label">Full Name</label>
            <input class="form-input" type="text" id="edit-fullname">
        </div>
        <div class="form-group">
            <label class="form-label">Email <span class="font-normal text-gray-500">(used for email login and password recovery)</span></label>
            <input class="form-input" type="email" id="edit-email" autocomplete="email">
        </div>
        <div class="form-group">
            <label class="form-label">Role</label>
            <select class="form-input" id="edit-role">
                <option value="admin">Admin</option>
                <option value="supervisor">Supervisor</option>
                <option value="production_in_charge">Production in-charge</option>
                <option value="cashier">Cashier</option>
            </select>
        </div>
        <div class="form-group" id="edit-branch-group">
             <label class="form-label">Assign to Branch <span class="font-normal text-gray-500">(cashiers only)</span></label>
            <select class="form-input" id="edit-branch">
                <option value="">— Select Branch —</option>
                {foreach branches as br}
                <option value="{br.id}">{br.name}</option>
                {/foreach}
            </select>
        </div>
        <div class="form-group" id="edit-branches-group">
            <label class="form-label">Assign Branches <span class="font-normal text-gray-500">(for supervisors and production in-charge)</span></label>
            <select class="form-input" id="edit-branches" multiple size="6">
                {foreach branches as br}
                <option value="{br.id}">{br.name}</option>
                {/foreach}
            </select>
        </div>

        <div class="form-group">
            <label class="form-label">New Password (leave blank to keep current)</label>
            <input class="form-input" type="password" id="edit-password" autocomplete="new-password">
        </div>
        <div class="form-group">
            <label class="form-label">Status</label>
            <select class="form-input" id="edit-active">
                <option value="1">Active</option>
                <option value="0">Inactive</option>
            </select>
        </div>
        <div class="modal-actions">
            <button class="btn btn-outline" onclick="closeModal('edit-modal')">Cancel</button>
            <button class="btn btn-primary" id="edit-submit" onclick="submitEditUser()">Save Changes</button>
        </div>
    </div>
</div>
{/block}

{block scripts}
<script>
    var BASE = '{base_url}';
    var EDIT_ORIGINAL_ROLE = '';

    function selectedValues(selectEl) {
        if (!selectEl) return [];
        return Array.from(selectEl.options || []).filter(function(o) { return o.selected; }).map(function(o) {
            return parseInt(o.value, 10) || 0;
        }).filter(function(v) { return v > 0; });
    }

    function setSelectedValues(selectEl, ids) {
        if (!selectEl) return;
        var map = {};
        (ids || []).forEach(function(id) { map[String(id)] = true; });
        Array.from(selectEl.options || []).forEach(function(o) {
            o.selected = !!map[String(o.value)];
        });
    }

    function toggleBranchFields(roleSelect, singleBranchGroup, multiBranchGroup) {
        var role = roleSelect.value;
        singleBranchGroup.style.display = role === 'cashier' ? '' : 'none';
        multiBranchGroup.style.display = (role === 'supervisor' || role === 'production_in_charge') ? '' : 'none';
    }

    function openAddUser() {
        document.getElementById('add-modal').classList.add('show');
        document.getElementById('add-username').focus();
        toggleBranchFields(
            document.getElementById('add-role'),
            document.getElementById('add-branch-group'),
            document.getElementById('add-branches-group')
        );
    }
    function closeModal(id) { document.getElementById(id).classList.remove('show'); }

    // Listen for role changes in both modals
    document.getElementById('add-role').addEventListener('change', function() {
        toggleBranchFields(this, document.getElementById('add-branch-group'), document.getElementById('add-branches-group'));
    });
    document.getElementById('edit-role').addEventListener('change', function() {
        if (EDIT_ORIGINAL_ROLE && this.value !== EDIT_ORIGINAL_ROLE) {
            var newRole = this.value;
            this.value = EDIT_ORIGINAL_ROLE;
            toggleBranchFields(this, document.getElementById('edit-branch-group'), document.getElementById('edit-branches-group'));
            showToast('Role changes create a new account instead. Create a new ' + newRole + ' user with the desired username/name/password/state, then deactivate the old account.');
            return;
        }
        toggleBranchFields(this, document.getElementById('edit-branch-group'), document.getElementById('edit-branches-group'));
    });

    document.querySelectorAll('.edit-user-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            openEditUser(
                parseInt(this.dataset.id, 10),
                this.dataset.email || '',
                this.dataset.fullname,
                this.dataset.role,
                parseInt(this.dataset.active, 10),
                parseInt(this.dataset.branchId, 10) || 0,
                this.dataset.branchIdsCsv || '',
                this.dataset.sellingAccountIdsCsv || ''
            );
        });
    });

    document.querySelectorAll('.delete-user-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var id = parseInt(this.dataset.id, 10);
            var role = this.dataset.role;
            var name = this.dataset.fullname;
            if (!confirm('Delete user "' + name + '"? Their account will be hidden from the active list. All historical sales, ledger entries, and audit records are preserved. You can restore from the Deleted tab.')) return;
            fetch(BASE + '/api/v1/admin/dl-users/delete', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': (window.DL_CSRF || ''),
                    'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
                },
                body: JSON.stringify({ user_id: id, role: role })
            })
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.ok) { showToast('User deleted'); setTimeout(function() { window.location.reload(); }, 600); }
                else { showToast(res.error || 'Failed to delete'); }
            })
            .catch(function() { showToast('Network error'); });
        });
    });

    document.querySelectorAll('.restore-user-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var id = parseInt(this.dataset.id, 10);
            var role = this.dataset.role;
            var name = this.dataset.fullname;
            if (!confirm('Restore user "' + name + '"? The account will be restored as inactive; re-activate it from the Inactive tab when ready.')) return;
            fetch(BASE + '/api/v1/admin/dl-users/restore', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': (window.DL_CSRF || ''),
                    'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
                },
                body: JSON.stringify({ user_id: id, role: role })
            })
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.ok) { showToast('User restored'); setTimeout(function() { window.location.reload(); }, 600); }
                else { showToast(res.error || 'Failed to restore'); }
            })
            .catch(function() { showToast('Network error'); });
        });
    });

    function openEditUser(id, email, fullName, role, active, branchId, branchIdsCsv, sellingAccountIdsCsv) {
        document.getElementById('edit-id').value = id;
        document.getElementById('edit-email').value = email;
        document.getElementById('edit-fullname').value = fullName;
        document.getElementById('edit-role').value = role;
        EDIT_ORIGINAL_ROLE = role;
        document.getElementById('edit-active').value = active;
        document.getElementById('edit-branch').value = branchId || '';
        var ids = String(branchIdsCsv || '').split(',').map(function(v) { return parseInt(v, 10) || 0; }).filter(function(v) { return v > 0; });
        setSelectedValues(document.getElementById('edit-branches'), ids);

        document.getElementById('edit-password').value = '';
        toggleBranchFields(document.getElementById('edit-role'), document.getElementById('edit-branch-group'), document.getElementById('edit-branches-group'));
        document.getElementById('edit-modal').classList.add('show');
    }

    function submitAddUser() {
        var role = document.getElementById('add-role').value;
        var branchId = parseInt(document.getElementById('add-branch').value) || 0;
        var branchIds = selectedValues(document.getElementById('add-branches'));
        if ((role === 'supervisor' || role === 'production_in_charge') && branchIds.length === 0) {
            showToast('Select at least one branch');
            return;
        }
        var btn = document.getElementById('add-submit');
        btn.disabled = true; btn.textContent = 'Adding...';
        fetch(BASE + '/api/v1/admin/dl-users', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify({
                username: document.getElementById('add-username').value,
                email: document.getElementById('add-email').value,
                password: document.getElementById('add-password').value,
                full_name: document.getElementById('add-fullname').value,
                role: role,
                branch_id: role === 'cashier' ? branchId : 0,
                branch_ids: (role === 'supervisor' || role === 'production_in_charge') ? branchIds : [],
                selling_account_ids: []
            })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res.ok) { showToast('User added'); setTimeout(function() { window.location.reload(); }, 600); }
            else { showToast(res.error || 'Failed'); btn.disabled = false; btn.textContent = 'Add User'; }
        })
        .catch(function() { showToast('Network error'); btn.disabled = false; btn.textContent = 'Add User'; });
    }

    function submitEditUser() {
        var role = document.getElementById('edit-role').value;
        var branchId = parseInt(document.getElementById('edit-branch').value) || 0;
        var branchIds = selectedValues(document.getElementById('edit-branches'));
        if ((role === 'supervisor' || role === 'production_in_charge') && branchIds.length === 0) {
            showToast('Select at least one branch');
            return;
        }
        var btn = document.getElementById('edit-submit');
        btn.disabled = true; btn.textContent = 'Saving...';
        fetch(BASE + '/api/v1/admin/dl-users/update', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify({
                user_id: parseInt(document.getElementById('edit-id').value),
                email: document.getElementById('edit-email').value,
                full_name: document.getElementById('edit-fullname').value,
                role: role,
                branch_id: role === 'cashier' ? branchId : 0,
                branch_ids: (role === 'supervisor' || role === 'production_in_charge') ? branchIds : [],
                selling_account_ids: [],
                password: document.getElementById('edit-password').value,
                is_active: parseInt(document.getElementById('edit-active').value)
            })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res.ok) { showToast('User updated'); setTimeout(function() { window.location.reload(); }, 600); }
            else { showToast(res.error || 'Failed'); btn.disabled = false; btn.textContent = 'Save Changes'; }
        })
        .catch(function() { showToast('Network error'); btn.disabled = false; btn.textContent = 'Save Changes'; });
    }

    document.querySelectorAll('.modal-overlay').forEach(function(el) {
        el.addEventListener('click', function(e) { if (e.target === el) el.classList.remove('show'); });
    });
</script>
{/block}
