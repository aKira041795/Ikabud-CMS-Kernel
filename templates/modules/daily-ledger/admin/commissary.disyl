{# COUPLING: this shell is a copy of templates/modules/daily-ledger/layouts/app.disyl — change that layout and this file together; daily_ledger_shell_drift_guard_test.php enforces it. #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title | default:'Daily Ledger'}</title>
    <link rel="icon" href="{resolved_favicon_url}">
    <link rel="manifest" href="/daily-ledger/manifest.webmanifest">
    <meta name="theme-color" content="#4f46e5">

    <script src="/daily-ledger/assets/tailwindcss.js"></script>
    <link rel="stylesheet" href="/daily-ledger/assets/fontawesome/all.min.css">
    <script src="/daily-ledger/assets/htmx-1.9.10.min.js"></script>
    <script defer src="/daily-ledger/assets/alpine-3.min.js"></script>

    <style>
        [x-cloak] { display: none !important; }

        .btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; border-radius: 3px; padding: .5rem .75rem; font-size: .875rem; font-weight: 600; transition: background-color .15s, border-color .15s, color .15s, box-shadow .15s; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
        .btn:focus-visible { outline: 2px solid transparent; outline-offset: 2px; box-shadow: 0 0 0 3px rgba(99,102,241,.25); }
        .btn-sm { padding: .25rem .5rem; font-size: .75rem; }
        .btn-primary { background: rgb(79 70 229); color: #fff; }
        .btn-primary:hover { background: rgb(67 56 202); }
        .btn-outline { background: #fff; color: rgb(15 23 42); border: 1px solid rgb(203 213 225); }
        .btn-outline:hover { background: rgb(249 250 251); }
        .btn-danger { background: rgb(225 29 72); color: #fff; }
        .btn-danger:hover { background: rgb(190 18 60); }

        button,
        input:not([type='checkbox']):not([type='radio']):not([type='range']),
        select,
        textarea {
            border-radius: 3px !important;
        }

        .form-label { display: block; font-size: .875rem; font-weight: 500; color: rgb(31 41 55); }
        .form-input { margin-top: .25rem; display: block; width: 100%; border-radius: 3px; border: 1px solid rgb(203 213 225); background: #fff; padding: .5rem .75rem; font-size: .875rem; color: rgb(15 23 42); box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
        .form-input:focus { outline: none; border-color: rgb(99 102 241); box-shadow: 0 0 0 3px rgba(99,102,241,.22); }
        .form-input::placeholder { color: rgb(100 116 139); }
        .form-group { margin-bottom: 1rem; }

        .card { border-radius: 3px; border: 1px solid rgb(226 232 240); background: #fff; color: rgb(15 23 42); box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
        .card-header { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgb(226 232 240); padding: .75rem 1rem; font-size: .875rem; font-weight: 600; color: rgb(15 23 42); }
        .card-body { padding: 1rem; color: rgb(15 23 42); }

        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        thead th { white-space: nowrap; border-bottom: 1px solid rgb(226 232 240); background: rgb(248 250 252); padding: .75rem 1rem; text-align: left; font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: rgb(51 65 85); }
        tbody td { border-bottom: 1px solid rgb(241 245 249); padding: .75rem 1rem; font-size: .875rem; color: rgb(15 23 42); }
        tbody tr:hover { background: rgb(249 250 251); }

        .text-left { text-align: left; }
        .text-center { text-align: center; }
        .text-right { text-align: right; }

        .text-muted { color: rgb(71 85 105); }

        .modal-overlay { position: fixed; inset: 0; z-index: 300; display: none; align-items: center; justify-content: center; background: rgba(0,0,0,.4); padding: 1rem; }
        .modal-overlay.show { display: flex; }
        .modal { width: 100%; max-width: 32rem; border-radius: 3px; background: #fff; color: rgb(15 23 42); padding: 1.5rem; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); border: 1px solid rgba(0,0,0,0.05); }
        .modal h3 { margin-bottom: 1rem; font-size: 1rem; font-weight: 600; color: rgb(15 23 42); }
        .modal-actions { margin-top: 1.5rem; display: flex; align-items: center; justify-content: flex-end; gap: .5rem; }

        .card .text-gray-500,
        .card .text-gray-600,
        .card .text-gray-400,
        .modal .text-gray-500,
        .modal .text-gray-600,
        .modal .text-gray-400,
        .bg-white .text-gray-500,
        .bg-white .text-gray-600,
        .bg-white .text-gray-400 {
            color: rgb(71 85 105);
        }

        .card .text-gray-700,
        .modal .text-gray-700,
        .bg-white .text-gray-700,
        .card .text-gray-800,
        .modal .text-gray-800,
        .bg-white .text-gray-800,
        .card .text-gray-900,
        .modal .text-gray-900,
        .bg-white .text-gray-900 {
            color: rgb(15 23 42);
        }

        /* Daily Ledger ledger-row cells. These mirror the Tailwind utilities they
           replace so the grid renders identically, while removing ~1.1KB of repeated
           class text from each of 174 rows (class attributes were 41% of the rows
           payload, which is re-sent on every ledger view). */
        .ledger-cell { display: block; margin: 0 0 0 auto; min-height: 2.75rem; width: 5rem; border: 1px solid rgb(209 213 219); background: #fff; padding: .5rem; text-align: right; font-size: .875rem; line-height: 1.25rem; color: rgb(15 23 42); box-shadow: 0 1px 2px rgba(0,0,0,.05); }
        .ledger-cell:focus { outline: none; border-color: rgb(99 102 241); box-shadow: inset 0 0 0 3px rgba(99,102,241,.22); }
        .ledger-chip { margin-left: auto; display: inline-flex; width: 5rem; justify-content: flex-end; border-radius: .5rem; padding: .375rem .5rem; font-size: .875rem; line-height: 1.25rem; font-weight: 600; color: rgb(15 23 42); background: rgb(249 250 251); box-shadow: inset 0 0 0 1px rgb(229 231 235); }
        .ledger-chip-pending { color: rgb(180 83 9); background: rgb(255 251 235); box-shadow: inset 0 0 0 1px rgb(253 230 138); }
        .ledger-trigger { margin-left: auto; display: inline-flex; width: 5rem; align-items: center; justify-content: flex-end; gap: .25rem; border-style: solid; border-width: 1px; border-radius: 3px; padding: .375rem .5rem; font-size: .875rem; line-height: 1.25rem; font-weight: 600; }
        .ledger-trigger-add { border-color: rgb(110 231 183); background: rgb(236 253 245); color: rgb(6 95 70); box-shadow: inset 0 0 0 1px rgb(167 243 208), 0 1px 2px rgba(0,0,0,.05); }
        .ledger-trigger-add:hover { background: rgb(209 250 229); }
        .ledger-trigger-out { border-color: rgb(252 211 77); background: rgb(255 251 235); color: rgb(146 64 14); box-shadow: inset 0 0 0 1px rgb(253 230 138), 0 1px 2px rgba(0,0,0,.05); }
        .ledger-trigger-out:hover { background: rgb(254 243 199); }
        .ledger-num { width: 3.5rem; white-space: nowrap; text-align: center; vertical-align: middle; font-size: .875rem; color: rgb(71 85 105); }
        .ledger-name { white-space: nowrap; vertical-align: middle; font-weight: 500; font-size: .875rem; color: rgb(15 23 42); }
    </style>

    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function() {
                navigator.serviceWorker.register('/daily-ledger/sw.js')
                .then(function(reg) {
                    // Ensure the newest worker takes control on first launch so
                    // the offline shell is reachable without a manual reload.
                    if (reg.waiting && navigator.serviceWorker.controller) {
                        reg.waiting.postMessage({ type: 'SKIP_WAITING' });
                    }
                    return navigator.serviceWorker.ready;
                })
                .then(function() {
                    if (navigator.serviceWorker.controller) {
                        navigator.serviceWorker.controller.postMessage({ type: 'DL_CONTROLLED' });
                    }
                })
                .catch(function(error) {
                    console.warn('Daily Ledger service worker registration failed', error);
                });
            });

            // Launch messaging: the online ledger tells a concurrently open
            // offline shell to re-lock after enrollment or logout. The shell
            // (offline-app.js) listens for these on navigator.serviceWorker.
            window.dlNotifyOfflineActivated = function() {
                if (navigator.serviceWorker && navigator.serviceWorker.controller) {
                    navigator.serviceWorker.controller.postMessage({ type: 'dl-offline-activated' });
                }
            };
            window.dlNotifyOfflineLocked = function() {
                if (navigator.serviceWorker && navigator.serviceWorker.controller) {
                    navigator.serviceWorker.controller.postMessage({ type: 'dl-offline-locked' });
                }
            };
        } else {
            window.dlNotifyOfflineActivated = function() {};
            window.dlNotifyOfflineLocked = function() {};
        }

        window.DL_BASE = '/daily-ledger';
        window.DL_CSRF = '{csrf_token}';
        window.DL_TOKEN = '{dl_token}';
        window.DL_OFFLINE_SHELL = false;
        window.DL_USER_ID = '{dl_user_id | default:''}';
        window.DL_TENANT_SCOPE = '{tenant_scope | default:''}';
        window.showToast = function(message, type) {
            try {
                var cont = document.getElementById('toast-container');
                if (!cont) return;

                var el = document.createElement('div');
                // Colour carries the outcome, so a cashier can read the result at a
                // glance without waiting for the (slow) view refresh:
                //   green  = the SERVER accepted it
                //   amber  = queued on this device, NOT yet on the server
                //   red    = the server refused it or the request failed
                //   slate  = purely informational
                // 'queued' must never be green: it is the one outcome the operator
                // cannot otherwise tell apart from a real save, and mistaking it for
                // one is how a lost adjustment gets reported as "it won't add".
                var cls = (type === 'error')
                    ? 'bg-red-600 text-white'
                    : (type === 'success'
                        ? 'bg-emerald-600 text-white'
                        : (type === 'warning' ? 'bg-amber-500 text-white' : 'bg-slate-900 text-white'));
                el.className = 'mb-2 px-4 py-3 rounded-xl shadow text-sm ' + cls;
                el.setAttribute('role', type === 'error' ? 'alert' : 'status');
                el.textContent = String(message || 'OK');
                cont.appendChild(el);

                // A queued entry needs reading time - it is the only notice that the
                // work is not on the server yet.
                setTimeout(function() {
                    if (el && el.parentNode) el.parentNode.removeChild(el);
                }, (type === 'error' || type === 'warning') ? 6000 : 2800);
            } catch (e) {
            }
        };
        window.addEventListener('showToast', function(evt) {
            var d = evt && evt.detail ? evt.detail : null;
            if (!d) return;
            window.showToast(d.message || 'OK', d.type || 'success');
        });

        // ── Bounded writes: a slow transaction FAILS, it is not held ─────────
        // A ledger write is something the operator has to be able to trust. If the
        // server has not answered inside this window we declare it NOT SAVED and say
        // so. Holding it on the device is worse than losing it: an entry the cashier
        // believes is recorded is discovered at close-of-day with no way to tell what
        // happened, whereas a refused one is retried in seconds. Retrying is safe -
        // every write carries an idempotency key (response cached 24h) and
        // dl_cashier_withdrawals has a UNIQUE dedup_hash index, so Retry cannot
        // produce a duplicate.
        window.DL_WRITE_TIMEOUT_MS = 15000;
        window.dlWriteTimeout = function(url, options, label) {
            if (typeof AbortController === 'undefined') return fetch(url, options);
            var controller = new AbortController();
            var opts = {};
            for (var k in options) {
                if (Object.prototype.hasOwnProperty.call(options, k)) opts[k] = options[k];
            }
            opts.signal = controller.signal;
            var timer = setTimeout(function() { controller.abort(); }, window.DL_WRITE_TIMEOUT_MS);
            return fetch(url, opts).then(function(res) {
                clearTimeout(timer);
                return res;
            }, function(err) {
                clearTimeout(timer);
                if (controller.signal.aborted) {
                    var e = new Error('WRITE_TIMEOUT');
                    e.dlTimedOut = true;
                    e.dlLabel = label || 'The change';
                    return Promise.reject(e);
                }
                return Promise.reject(err);
            });
        };
        // Wording matters more than it looks. Aborting the request cancels the
        // CLIENT wait - it does not cancel the work the server already started, so
        // after a timeout we genuinely do not know whether the row landed. Saying
        // "was NOT recorded" asserted something we cannot know, and an operator who
        // believes it will key the same entry again: that repetition is how
        // duplicates get created. So state the uncertainty, and say plainly that
        // Retry is safe, which is what actually stops the hand-re-keying.
        window.dlWriteTimeoutMessage = function(label) {
            return 'No reply in '
                + Math.round(window.DL_WRITE_TIMEOUT_MS / 1000) + 's — it is NOT yet known whether '
                + (label || 'the change') + ' was recorded. Press Retry: it is safe to repeat and '
                + 'will not create a second entry. Do not key it in again.';
        };

        // ── Persistent write-failure notice ──────────────────────────────────
        // A failed ledger write must not be reported only by a toast that vanishes
        // after a few seconds. The operator needs the REASON and a Retry in front of
        // them: without it they either assume it went in, or re-key it by hand - which
        // is exactly how duplicate entries balloon the data.
        window.dlWriteFailureRetry = null;
        window.dlReportWriteFailure = function(reason, retry) {
            var box = document.getElementById('dl-write-failure');
            var text = document.getElementById('dl-write-failure-text');
            var btn = document.getElementById('dl-write-failure-retry');
            if (!box || !text) return;
            window.dlWriteFailureRetry = (typeof retry === 'function') ? retry : null;
            text.textContent = reason || 'The change did not reach the server.';
            if (btn) btn.classList.toggle('hidden', !window.dlWriteFailureRetry);
            box.classList.remove('hidden');
        };
        window.dlClearWriteFailure = function() {
            var box = document.getElementById('dl-write-failure');
            if (box) box.classList.add('hidden');
            window.dlWriteFailureRetry = null;
        };
        // The Retry button calls this rather than running its logic inline, so the failure
        // box keeps a single entry point that can be exercised on its own.
        //
        // An earlier comment here blamed DiSyL for eating the inline braces; that was wrong.
        // DiSyL preserves `{...}` in quoted attributes, so the old inline handler worked.
        // This extraction is a readability change, not a bug fix.
        window.dlRetryWriteFailure = function() {
            if (typeof window.dlWriteFailureRetry !== 'function') return;
            var retry = window.dlWriteFailureRetry; // capture before clearing
            window.dlClearWriteFailure();
            retry();
        };

        // ── Submit feedback ────────────────────────────────────────────────
        // A slow link makes the view refresh lag far behind the request, so the
        // operator cannot tell a saved edit from a failed or merely queued one.
        // These helpers report the outcome as soon as the server answers, which
        // is independent of how long the re-render takes.
        window.dlBusyDepth = 0;
        window.dlBusyWatchdog = null;
        window.dlSetBusy = function(show, label) {
            var box = document.getElementById('dl-busy');
            if (!box) return;
            var text = document.getElementById('dl-busy-label');
            if (show) {
                // Depth counter: rapid, overlapping cell edits keep the indicator
                // visible until the LAST one settles instead of the first
                // completion hiding it while earlier requests are still open.
                window.dlBusyDepth = (window.dlBusyDepth || 0) + 1;
                if (text && label) text.textContent = label;
                box.classList.remove('hidden');
                // Safety net: a permanently stuck indicator would be worse than no
                // indicator at all, so it can never outlive a request that failed
                // to settle. 60s sits just above the server's 50s lock-wait so a
                // legitimately slow save is not cleared early.
                if (window.dlBusyWatchdog !== null) clearTimeout(window.dlBusyWatchdog);
                window.dlBusyWatchdog = setTimeout(function() {
                    window.dlBusyDepth = 0;
                    window.dlBusyWatchdog = null;
                    box.classList.add('hidden');
                }, 60000);
            } else {
                window.dlBusyDepth = Math.max(0, (window.dlBusyDepth || 0) - 1);
                if (window.dlBusyDepth === 0) {
                    box.classList.add('hidden');
                    if (window.dlBusyWatchdog !== null) {
                        clearTimeout(window.dlBusyWatchdog);
                        window.dlBusyWatchdog = null;
                    }
                }
            }
        };
        // Coalesced success notice: tabbing across many cells would otherwise
        // stack one toast per field and bury the screen.
        window.dlToastSaved = function(message) {
            var now = Date.now();
            if (window.dlLastSavedToast && (now - window.dlLastSavedToast) < 1500) return;
            window.dlLastSavedToast = now;
            window.showToast(message || 'Saved', 'success');
        };
        document.addEventListener('htmx:afterSettle', function(evt) {
            var scripts = evt.detail.elt.querySelectorAll('script:not([src])');
            scripts.forEach(function(s) {
                var ns = document.createElement('script');
                ns.textContent = s.textContent;
                s.parentNode.replaceChild(ns, s);
            });
        });
        document.addEventListener('htmx:configRequest', function(evt) {
            var verb = (evt.detail.verb || '').toUpperCase();
            if (verb === 'POST' || verb === 'PUT' || verb === 'PATCH' || verb === 'DELETE') {
                evt.detail.headers['X-CSRF-Token'] = DL_CSRF;
            }
        });
        document.addEventListener('htmx:beforeRequest', function(evt) {
            var path = String((evt.detail && evt.detail.pathInfo && evt.detail.pathInfo.requestPath) || '');
            if (!navigator.onLine && path.indexOf('/daily-ledger/ledger/rows') === 0) {
                evt.preventDefault();
            }
        });
        function maybeShowToastFromHeader(xhr) {
            if (!xhr || typeof xhr.getResponseHeader !== 'function') return;
            var trig = xhr.getResponseHeader('HX-Trigger');
            if (!trig) return;
            try {
                var data = JSON.parse(trig);
                if (data && data.showToast) {
                    window.showToast(data.showToast.message || 'OK', data.showToast.type || 'error');
                }
            } catch (e) {}
        }
        document.addEventListener('htmx:responseError', function(evt) {
            var xhr = evt.detail ? evt.detail.xhr : null;
            maybeShowToastFromHeader(xhr);
            if (xhr && xhr.status) {
                window.showToast('Request failed (' + xhr.status + ')', 'error');
                return;
            }
            window.showToast('Request failed', 'error');
        });
        document.addEventListener('htmx:sendError', function() {
            window.showToast('Network error', 'error');
        });

        /**
         * Deterministic in-place page load: fetch a URL (full page), extract
         * #main-content via DOMParser, and swap it into the live #main-content.
         * Re-runs inline scripts and rebinds htmx. On failure (login redirect,
         * server error, or empty response) it navigates to the URL so the view
         * always recovers.
         *
         * This is the single mechanism for in-place GET navigation. It replaces
         * both htmx.ajax({select}) and hx-select for full-page responses: the
         * bundled htmx version silently produces a BLANK region when hx-select
         * is applied to a full HTML document, even when #main-content exists.
         *
         * Uses the same Bearer auth as the save API calls so authentication
         * cannot differ between a POST that saved and the GET that refreshes.
         */
        window.dlLoadUrl = function(url, usePush) {
            // The ledger owns page-level state and timers outside #main-content.
            // Replacing only its markup leaves the old date/branch and callbacks live.
            var nextPath = new URL(url, window.location.href).pathname;
            if (/\/daily-ledger\/ledger\/?$/.test(nextPath)
                || /\/daily-ledger\/ledger\/?$/.test(window.location.pathname)) {
                window.location.assign(url);
                return;
            }
            var headers = {
                'Accept': 'text/html',
                'X-Requested-With': 'XMLHttpRequest'
            };
            var token = window.DL_TOKEN || '';
            if (token) {
                headers['Authorization'] = 'Bearer ' + token;
            }

            fetch(url, {
                method: 'GET',
                credentials: 'same-origin',
                headers: headers
            })
            .then(function(r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.text();
            })
            .then(function(html) {
                var doc = new DOMParser().parseFromString(html, 'text/html');
                var fresh = doc.getElementById('main-content');
                var target = document.getElementById('main-content');
                if (!fresh || !target || !fresh.innerHTML.trim()) {
                    throw new Error('empty content');
                }
                target.innerHTML = fresh.innerHTML;
                // Re-run inline scripts that were swapped in
                target.querySelectorAll('script:not([src])').forEach(function(s) {
                    var ns = document.createElement('script');
                    ns.textContent = s.textContent;
                    s.parentNode.replaceChild(ns, s);
                });
                // Re-bind hx-* attributes in the new content
                if (typeof htmx !== 'undefined') {
                    htmx.process(target);
                }
                // Keep the URL in sync (back/forward + shareable filters)
                if (window.history) {
                    if (usePush && window.history.pushState) {
                        window.history.pushState({}, '', url);
                    } else if (window.history.replaceState) {
                        window.history.replaceState({}, '', url);
                    }
                }
            })
            .catch(function() {
                // In-place load could not complete — navigate so the view recovers.
                window.location.href = url;
            });
        };

        // Serialize a GET filter form and load it in place (no full reload).
        window.dlLoadForm = function(form) {
            var params = new URLSearchParams(new FormData(form)).toString();
            var url = form.action;
            url += (url.indexOf('?') >= 0 ? '&' : '?') + params;
            window.dlLoadUrl(url, true);
            return false;
        };

        // Unified refresh: re-fetch the current page and swap #main-content.
        window.refreshMainContent = function() {
            window.dlLoadUrl(window.location.href, false);
        };
    </script>

<style>
    /* FLUID GRID. table-layout: fixed lets the numeric columns share the
       remaining width EQUALLY (equal share is what keeps them uniform), and
       width: 100% lets that share grow or shrink with the wrapper. The floor is
       on the TABLE, not on the cells: under fixed layout a cell min-width is
       ignored. min-width is a function of the server-known numeric column count
       (--sheet-numeric-cols), so a 3-branch sheet is not forced as wide as a
       30-branch sheet. 82px per numeric column keeps the baseline above the
       readable control floor; past it the wrapper scrolls instead of crushing
       the entry controls below their own min-width. */
    #tab-daily-sheet table {
        table-layout: fixed;
        width: 100%;
        min-width: calc(200px + var(--sheet-numeric-cols, 14) * 82px);
    }
    /* ONE horizontal padding for every cell of the sheet, the product-name
       column included. The old design spent 16px per side (a 32px gap between
       the product name and BEG) and then clawed it back with a tighter 2px
       override on the branch cells, so those cells sat 4px off their
       neighbours. One shared value removes that drift. */
    #tab-daily-sheet table th,
    #tab-daily-sheet table td {
        padding-left: 6px;
        padding-right: 6px;
    }
    /* The product column keeps its measured 200px floor. Its longest label
       ("MONGO/PEANUT/COCO/MAYO") is a single slash-joined token with no space to
       break on, so it must be allowed to break anywhere or it spills 9px into
       BEG; under fixed layout the overflow would clip instead of showing. */
    #tab-daily-sheet thead th:nth-child(1),
    #tab-daily-sheet tbody td:nth-child(1) {
        width: 200px;
        min-width: 200px;
        max-width: 200px;
        white-space: normal;
        overflow-wrap: anywhere;
    }
    /* EVERY column after the product name is fluid (width: auto) so the numeric
       columns divide the remaining width EQUALLY. The width is no longer a
       function of a fixed px value, so adding a branch re-divides the same
       space instead of pinning a 15th 82px column and forcing a scroll. */
    #tab-daily-sheet thead th:nth-child(n+2),
    #tab-daily-sheet tbody td:nth-child(n+2) {
        width: auto;
        min-width: 0;
        max-width: none;
    }
    /* Branch columns are FLUID like every other numeric column; the vertical
       writing-mode and fixed height keep the rotated header readable while the
       width gives the trigger its equal share of the row. */
    #tab-daily-sheet .daily-sheet-branch-column {
        box-sizing: border-box;
        width: auto;
        min-width: 0;
        max-width: none;
        height: 118px;
        padding-top: 4px;
        padding-bottom: 4px;
        text-align: left;
        vertical-align: bottom;
        white-space: nowrap;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
    }
    /* The branch cell is an entry target, so give it a real hit area. It now
       uses the SAME cell padding as every other cell (the shared rule above);
       the old 3px/2px override is gone. Separation between neighbouring branch
       entries comes from that shared padding, not from shrinking one control. */
    #tab-daily-sheet .production-branch-cell .production-branch-trigger {
        box-sizing: border-box;
        width: 100%;
        min-width: 52px;
        height: 34px;
        margin-left: auto;
        gap: 2px;
        padding: 0 3px;
        font-size: 13px;
        font-weight: 700;
        line-height: 1;
        justify-content: center;
        white-space: nowrap;
    }
    /* A destination the branch does not list is a WARNING, not a wall: the amber
       tint says "this branch has not been given this product", while the control
       stays fully enterable. Recording here gives the product back to the branch
       and notifies the admin, so the encoder never waits on a list update. No
       cursor:not-allowed and no aria-disabled, because neither is true: the cell
       really does accept the entry. The full explanation lives in the modal
       rather than in this tooltip, because this tooltip is emitted once per
       unassigned cell on a 180x18 grid. */
    #tab-daily-sheet .production-branch-cell .production-branch-trigger[data-unassigned="1"] {
        color: #92400e;
        background: #fffbeb;
        border-color: #fcd34d;
    }
    /* ONE control box for all four entry controls. width:100% inside the shared
       6px cell padding makes every control exactly its column's content box,
       so nothing overflows and every control matches. height:34px is the proven
       entry-target height (the inputs used to render 39px, the triggers 34px).
       The branch trigger keeps its own font/gap rules; only the old 66.667%
       width is replaced, so it fills the cell like its neighbours. */
    #tab-daily-sheet .production-beg-input,
    #tab-daily-sheet .addtl-trigger,
    #tab-daily-sheet .production-branch-trigger,
    #tab-daily-sheet .production-actual-input {
        box-sizing: border-box;
        width: 100%;
        /* Readable floor: 64px column - 12px horizontal padding. Once the
           fluid share drops below it the control stops shrinking and the
           table's min-width makes the wrapper scroll instead. */
        min-width: 52px;
        height: 34px;
    }
    /* S12: received-vs-sent reconciliation inside the branch cell. Kept tiny so
       the fluid branch column still holds the sent trigger. The pending marker
       is a deliberate third state; a delivery nobody received must never read
       as a zero difference. */
    #tab-daily-sheet .production-branch-receipt,
    #tab-daily-sheet .production-branch-diff,
    #tab-daily-sheet .production-branch-dr {
        margin-top: 2px;
        font-size: 9px;
        line-height: 1.2;
        white-space: normal;
    }
    #tab-daily-sheet .production-branch-receipt { color: #6b7280; }
    #tab-daily-sheet .production-branch-receipt-pending { color: #b45309; font-weight: 600; }
    #tab-daily-sheet .production-branch-diff { font-weight: 700; }
    #tab-daily-sheet .production-branch-diff-short { color: #b91c1c; }
    #tab-daily-sheet .production-branch-diff-over { color: #1d4ed8; }
    #tab-daily-sheet .production-branch-dr { color: #4338ca; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
    /* Paper declaration. MUST stay at the top level of this stylesheet, NOT inside
       @media print: Chrome does not honour an @page page-size declaration nested in a
       media query. A 15-column sheet only reads on landscape. */
    @page { size: A4 landscape; margin: 8mm; }
    @media print {
        /* Existing hides kept, plus the app chrome: the sidebar, the top header bar,
           the page title/subtitle block, the metric stat-card row and the tab nav
           (all marked .print-hidden in markup) and the product-label warning banner. */
        .print-hidden, form, .tab-panel:not(#tab-daily-sheet), .card.mt-6,
        #wb-sidebar, header { display: none !important; }

        /* Un-clip the layout. On screen the shell is height:100vh + overflow:hidden,
           which pinned the ~9,200px sheet to one viewport. Undo the constraint so the
           sheet flows in normal document order and can paginate. */
        .flex.h-screen.overflow-hidden,
        .h-screen,
        .flex.h-screen.overflow-hidden > .flex-1.overflow-hidden {
            height: auto !important;
            min-height: 0 !important;
            overflow: visible !important;
            display: block !important;
        }
        main, #main-content {
            height: auto !important;
            min-height: 0 !important;
            overflow: visible !important;
            padding: 0 !important;
        }

        /* Print-only identity header: Tailwind .hidden keeps it off the screen, this
           rule reveals it on paper. */
        #daily-sheet-print-header { display: block !important; }

        #tab-daily-sheet { display: block !important; }
        #tab-daily-sheet .table-wrap { overflow: visible !important; }
        /* The on-screen fluid grid's floor must not reach the paper: at 14 numeric columns
           min-width is 1348px, wider than an A4-landscape content box, which cut the last
           column off the printed sheet. */
        #tab-daily-sheet table {
            min-width: 0 !important;
            width: 100% !important;
            table-layout: fixed !important;
        }
        #tab-daily-sheet table { font-size: 9px; }
        #tab-daily-sheet th, #tab-daily-sheet td { padding: 3px 4px; }
        /* Repeat the column header on every printed page and never split a row. */
        #tab-daily-sheet thead { display: table-header-group; }
        #tab-daily-sheet tr { break-inside: avoid; page-break-inside: avoid; }
        #tab-daily-sheet .daily-sheet-branch-column {
            /* The screen fluid rule `#tab-daily-sheet thead th:nth-child(n+2)`
               (specificity 1,1,2) otherwise outranks this rule (1,1,0) on paper,
               so the paper branch width is re-asserted with !important. Without
               it every numeric column keeps its equal 77px share and the nowrap
               "ACTUAL BAL" header overflows the table by 8px. */
            width: 24px !important;
            min-width: 24px !important;
            max-width: 24px !important;
            height: 112px;
            padding: 3px 2px;
            writing-mode: vertical-rl;
            transform: rotate(180deg);
        }
        /* Printing must stay compact: the screen hit area is deliberately large,
           the paper form only needs the number. */
        #tab-daily-sheet .production-branch-cell {
            padding: 2px 1px;
        }
        #tab-daily-sheet .production-branch-cell .production-branch-trigger {
            width: 100%;
            height: auto;
            padding: 0;
            font-size: 9px;
        }
        #tab-daily-sheet .production-branch-cell .production-branch-trigger i {
            display: none;
        }
        #tab-daily-sheet .production-branch-receipt,
        #tab-daily-sheet .production-branch-diff,
        #tab-daily-sheet .production-branch-dr {
            margin-top: 1px;
            font-size: 7px;
        }
    }
</style>

</head>
<body class="min-h-screen bg-slate-50" x-data="{ sidebarOpen: true }" data-wb-component="app-shell">

    <div id="toast-container" class="fixed top-4 right-4 z-50" role="status" aria-live="polite"></div>

    <!-- Persistent write-failure notice. See window.dlReportWriteFailure. -->
    <div id="dl-write-failure" class="hidden fixed bottom-4 left-1/2 z-[60] w-[min(46rem,calc(100vw-2rem))] -translate-x-1/2 rounded-xl border border-red-300 bg-red-50 px-4 py-3 shadow-2xl" role="alert" aria-live="assertive">
        <div class="flex items-start gap-3">
            <i class="fas fa-triangle-exclamation mt-1 text-red-600" aria-hidden="true"></i>
            <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-red-900">Not saved</p>
                <p id="dl-write-failure-text" class="mt-1 text-xs leading-5 text-red-800"></p>
            </div>
            <div class="flex shrink-0 items-center gap-2">
                <button type="button" id="dl-write-failure-retry" class="btn btn-primary btn-sm" onclick="window.dlRetryWriteFailure()">Retry — safe, will not duplicate</button>
                <button type="button" class="btn btn-outline btn-sm" onclick="window.dlClearWriteFailure()">Dismiss</button>
            </div>
        </div>
    </div>

    <!-- In-flight indicator. Deliberately non-blocking (pointer-events-none): on a
         slow link a modal overlay would freeze the cashier for the whole request,
         which is worse than the ambiguity it removes. It is visually
         unmistakable, so a send is never silent. -->
    <div id="dl-busy" class="hidden fixed inset-0 z-40 flex items-center justify-center pointer-events-none" aria-hidden="true">
        <div class="absolute inset-0 bg-slate-900/30"></div>
        <div class="relative flex items-center gap-3 rounded-xl bg-slate-900/95 px-5 py-4 text-sm font-semibold text-white shadow-2xl">
            <svg class="h-5 w-5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
            </svg>
            <span id="dl-busy-label">Saving…</span>
        </div>
    </div>

    <div class="flex h-screen overflow-hidden">
        <aside id="wb-sidebar" class="relative flex flex-col bg-gradient-to-b from-indigo-700 to-indigo-900 text-white transition-all duration-300" :class="sidebarOpen ? 'w-64' : 'w-20'" role="navigation" aria-label="Sidebar navigation">
            <div class="flex h-16 items-center gap-3 px-4 border-b border-white/10 flex-shrink-0">
                <div class="h-9 w-9 rounded-xl bg-white/10 flex items-center justify-center ring-1 ring-white/10">
                    {if logo_url}
                    <img src="{logo_url}" alt="{app_name} logo" class="h-8 w-8 rounded-lg object-contain">
                    {/if}
                    {if !logo_url}
                    <i class="fas fa-receipt text-lg" aria-hidden="true"></i>
                    {/if}
                </div>
                <span class="font-semibold text-base tracking-tight" x-show="sidebarOpen" x-cloak>{app_name}</span>
		<button type="button" class="ml-auto p-1.5 rounded-lg hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/30"
			@click="sidebarOpen = !sidebarOpen"
			:aria-label="sidebarOpen ? 'Collapse sidebar' : 'Expand sidebar'"
			:aria-expanded="sidebarOpen ? 'true' : 'false'">
		    <i class="fas fa-bars" aria-hidden="true"></i>
		</button>
            </div>

            <nav class="mt-4 px-2 flex-1 overflow-y-auto">
                {if user_role == 'cashier' || user_role == 'supervisor' || user_role == 'admin'}
                <a href="{base_url}/ledger"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'ledger'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Ledger">
                    <i class="fas fa-clipboard-list w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Ledger</span>
                </a>
                {/if}

                {if feature_pos && (user_role == 'cashier' || user_role == 'supervisor' || user_role == 'admin')}
                <a href="{base_url}/pos"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'pos'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Point of Sale">
                    <i class="fas fa-cash-register w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>POS</span>
                </a>
                {/if}

                {if user_role == 'admin' || user_role == 'supervisor' || user_role == 'auditor' || user_role == 'viewer'}
                <a href="{base_url}/admin/overview"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'overview'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Business Overview">
                    <i class="fas fa-chart-pie w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Overview</span>
                </a>
                {/if}

                {if user_role == 'admin' || user_role == 'supervisor' || user_role == 'auditor'}
                <a href="{base_url}/admin/dashboard"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'dashboard'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Dashboard">
                    <i class="fas fa-chart-line w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Dashboard</span>
                </a>

                <a href="{base_url}/admin/sales"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'sales'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Sales">
                    <i class="fas fa-chart-bar w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Sales</span>
                </a>

                <a href="{base_url}/admin/consignee-dispatch-report"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'consignee_dispatch'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Consignee Dispatch Report">
                    <i class="fas fa-file-invoice w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Consignee Dispatch</span>
                </a>

                {if feature_pos}
                <a href="{base_url}/admin/pos-sales"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'pos_sales'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="POS Sales">
                    <i class="fas fa-receipt w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>POS Sales</span>
                </a>
                {/if}

                <a href="{base_url}/admin/variances"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'variances'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Variances">
                    <i class="fas fa-triangle-exclamation w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Variances</span>
                </a>

                <a href="{base_url}/admin/reconciliation"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'reconciliation'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Cash and Paper Check">
                    <i class="fas fa-money-bill-wave w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Cash &amp; Paper Check</span>
                </a>
                {/if}

                <!-- Reports are read-only PDF/CSV exports, so the business owner
                     (viewer) sees them alongside the operations roles. -->
                {if user_role == 'admin' || user_role == 'supervisor' || user_role == 'auditor' || user_role == 'viewer'}
                <a href="{base_url}/admin/reports"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'reports'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Reports">
                    <i class="fas fa-file-pdf w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Reports</span>
                </a>
                {/if}

                {if user_role == 'admin' || user_role == 'supervisor' || user_role == 'auditor'}
                <a href="{base_url}/admin/forecast"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'forecast'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Production Forecast">
                    <i class="fas fa-chart-line w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Forecast</span>
                </a>

                <a href="{base_url}/admin/activity"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'activity'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Activity">
                    <i class="fas fa-clock-rotate-left w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Activity</span>
                </a>
                {/if}

                {if user_role == 'admin' || user_role == 'supervisor' || user_role == 'production_in_charge'}
                <a href="{base_url}/admin/commissary"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'commissary'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Commissary">
                    <i class="fas fa-wheat w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Commissary</span>
                </a>

                     {if feature_formal_delivery && (user_role == 'admin' || user_role == 'supervisor')}
                     <a href="{base_url}/admin/deliveries"
                         class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'deliveries'}bg-white/10 ring-1 ring-white/10{/if}"
                         aria-label="Deliveries">
                          <i class="fas fa-truck w-6" aria-hidden="true"></i>
                         <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Deliveries</span>
                     </a>
                     {/if}

                {if user_role == 'admin' || user_role == 'supervisor'}
                <a href="{base_url}/admin/usage"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'usage'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Commissary Usage">
                    <i class="fas fa-package w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Commissary Usage</span>
                </a>
                {/if}
                {/if}

                {if user_role == 'admin' || user_role == 'supervisor' || user_role == 'auditor'}
                <a href="{base_url}/admin/trace"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'trace'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Production Delivery Audit">
                    <i class="fas fa-clipboard-check w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Production Delivery Audit</span>
                </a>
                {/if}

                {if user_role == 'admin' || user_role == 'supervisor'}
                <a href="{base_url}/admin/withdrawals"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'stock-adjustments'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Stock Adjustments">
                    <i class="fas fa-arrow-right-from-bracket w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Stock Adjustments</span>
                </a>
                {/if}

                {if user_role == 'admin'}
                <a href="{base_url}/admin/products"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'products'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Products">
                    <i class="fas fa-cubes w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Products</span>
                </a>

                <a href="{base_url}/admin/branches"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'branches'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Branches">
                    <i class="fas fa-code-branch w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Branches</span>
                </a>

                <a href="{base_url}/admin/users"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'users'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Users">
                    <i class="fas fa-users w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Users</span>
                </a>

                {if feature_price_groups}
                <a href="{base_url}/admin/price-groups"
                         class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'price-groups'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Price Groups">
                    <i class="fas fa-tag w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Price Groups</span>
                </a>
                {/if}

                <a href="{base_url}/admin/settings"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'settings'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Settings">
                    <i class="fas fa-user-shield w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Settings</span>
                </a>
                {/if}
            </nav>
        </aside>

        <div class="flex-1 flex flex-col overflow-hidden">
            <header class="bg-white/80 backdrop-blur border-b border-gray-200 h-16 flex items-center justify-between px-6">
                <button type="button" class="inline-flex items-center justify-center h-9 w-9 rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-100"
                        @click="sidebarOpen = !sidebarOpen"
                        :aria-label="sidebarOpen ? 'Collapse sidebar' : 'Expand sidebar'"
                        :aria-expanded="sidebarOpen ? 'true' : 'false'">
                    <i class="fas fa-bars" aria-hidden="true"></i>
                </button>
                <div class="flex items-center gap-4">

{if !can_view_production_management}
{if shift}
<div class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-xs font-bold uppercase tracking-wide ring-1 ring-inset shadow-sm {if shift == 'PM'}bg-indigo-600 text-white ring-indigo-700{else}bg-emerald-600 text-white ring-emerald-700{/if}"
     title="{if shift_locked}Locked to your assigned shift: the AM cashier stays on AM and the PM cashier stays on PM.{else}Active shift follows the operating clock. AM cutoff {close_of_day_time}; PM is active for the rest of the day.{/if}">
    <span class="inline-flex h-2 w-2 rounded-full bg-white/90"></span>
    {shift} Shift
    {if shift_locked}<i class="fas fa-lock ml-1 text-[10px]" aria-hidden="true"></i>{/if}
</div>
{/if}
{/if}

                    <div class="text-right">
                        <div class="text-sm font-semibold text-gray-900">{user_full_name | default:user_name}</div>
                        <div class="text-xs text-gray-500 uppercase tracking-wide">{if user_username}{user_username} · {/if}{user_role}</div>
                    </div>
                    <a href="/daily-ledger/logout" class="text-sm font-semibold text-indigo-600 hover:text-indigo-700">Logout</a>
                </div>
            </header>

            <main class="flex-1 overflow-auto p-6" id="main-content">

<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6 print-hidden">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">{if can_view_production_management}Commissary{else}Daily Sheet{/if}</h2>
        <p class="text-sm text-gray-500">{if can_view_production_management}Daily Sheet · Inventory · Deliveries · Pullouts · Summary{else}Production encoding{/if}</p>
    </div>
</div>

{if can_view_production_management}
<form class="card mb-4" method="GET" action="{base_url}/admin/commissary"
      onsubmit="return window.dlLoadForm(this)">
    <div class="card-body">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-5 items-end">
            <div class="form-group mb-0">
                <label class="form-label">Date</label>
                <input type="date" class="form-input" name="date" value="{date}">
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Shift</label>
                <select class="form-input" name="shift">
                    <option value="" {if shift === ''}selected{/if}>All (includes pre-shift history)</option>
                    <option value="AM" {if shift == 'AM'}selected{/if}>AM</option>
                    <option value="PM" {if shift == 'PM'}selected{/if}>PM</option>
                </select>
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Commissary</label>
                <select class="form-input" name="commissary_id">
                    <option value="">All Commissaries</option>
                    {foreach commissaries as c}
                    <option value="{c.id}" {if c.id == commissary_id}selected{/if}>{c.name}</option>
                    {/foreach}
                </select>
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Branch</label>
                <select class="form-input" name="branch_id">
                    <option value="">All Branches</option>
                    {foreach branches as br}
                    <option value="{br.id}" {if br.id == branch_id}selected{/if}>{br.name}</option>
                    {/foreach}
                </select>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="btn btn-primary">Apply</button>
                {if can_view_production_management}<a class="btn btn-outline" href="{base_url}/admin/usage?date={date}">Open Usage</a>{/if}
            </div>
        </div>
    </div>
</form>
{/if}

{if can_view_production_management}
<!-- Summary stat cards -->
<div class="grid grid-cols-2 md:grid-cols-6 gap-3 mb-6 print-hidden">
    <div class="card">
        <div class="card-body py-3">
            <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Produced</div>
            <div class="mt-1 text-2xl font-semibold text-emerald-700">{totals.total_produced}</div>
        </div>
    </div>
    <div class="card">
        <div class="card-body py-3">
            <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Dispatched</div>
            <div class="mt-1 text-2xl font-semibold text-blue-700">{totals.total_dispatched}</div>
        </div>
    </div>
    <div class="card">
        <div class="card-body py-3">
            <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Wastage</div>
            <div class="mt-1 text-2xl font-semibold text-rose-700">{totals.total_wastage}</div>
        </div>
    </div>
    <div class="card">
        <div class="card-body py-3">
            <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Returned</div>
            <div class="mt-1 text-2xl font-semibold text-amber-700">{totals.total_returned}</div>
        </div>
    </div>
    <div class="card">
        <div class="card-body py-3">
            <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Remaining</div>
            <div class="mt-1 text-2xl font-semibold text-gray-900">{totals.total_remaining}</div>
        </div>
    </div>
    <div class="card">
        <div class="card-body py-3">
            <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Deliveries</div>
            <div class="mt-1 text-2xl font-semibold text-violet-700">{totals.total_deliveries}</div>
            <div class="text-xs text-gray-500">+{totals.total_pullouts} pullouts</div>
        </div>
    </div>
</div>

<!-- Tabs -->
<div class="border-b border-gray-200 mb-4 print-hidden">
    <nav class="flex gap-0 -mb-px" role="tablist">
        <button type="button" id="tab-btn-daily-sheet" onclick="switchCommissaryTab('daily-sheet')"
            class="px-4 py-2.5 text-sm font-medium border-b-2 border-indigo-500 text-indigo-600">1. Daily Sheet</button>
        <button type="button" id="tab-btn-inventory" onclick="switchCommissaryTab('inventory')"
            class="px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700">2. Inventory</button>
        <button type="button" id="tab-btn-deliveries" onclick="switchCommissaryTab('deliveries')"
            class="px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700">3. Deliveries</button>
        <button type="button" id="tab-btn-pullouts" onclick="switchCommissaryTab('pullouts')"
            class="px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700">4. Pullouts</button>
        <button type="button" id="tab-btn-summary" onclick="switchCommissaryTab('summary')"
            class="px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700">5. Summary</button>
    </nav>
</div>

<!-- Tab 2: Inventory Ledger -->
<div id="tab-inventory" class="tab-panel hidden">
    <!-- Cumulative stock overview -->
    {if cumulative_stock | count > 0}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-4">
        {foreach cumulative_stock as cs}
        <div class="card">
            <div class="card-body py-3">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-semibold text-gray-900">{cs.product_name}</span>
                    <span class="text-xs font-mono text-gray-400">{cs.sku}</span>
                </div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-lg font-semibold text-emerald-700">{cs.cumulative_remaining}</span>
                    <span class="text-xs text-gray-500">on hand</span>
                </div>
                <div class="text-xs text-gray-500">{cs.commissary_name} · {cs.total_produced} produced · {cs.total_dispatched} dispatched</div>
            </div>
        </div>
        {/foreach}
    </div>
    {/if}

    <div class="card">
        <div class="card-header">
            <span>Daily Production — {date}</span>
            <span class="text-sm text-muted">{inventory_rows | count} products with today activity</span>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th>Commissary</th>
                        <th class="text-right">Produced Today</th>
                        <th class="text-right">Dispatched Today</th>
                        <th class="text-right">Wastage Today</th>
                        <th class="text-right">On Hand (All)</th>
                        <th class="text-right">Actual Balance</th>
                        <th class="text-right">Variance</th>
                        <th>Last Updated</th>
                    </tr>
                </thead>
                <tbody>
                    {if inventory_rows | count == 0}
                    <tr><td colspan="10" class="px-4 py-10 text-center text-sm text-gray-500">No production recorded for this date. Use the Daily Sheet to record ADDTL.</td></tr>
                    {/if}
                    {foreach inventory_rows as row}
                    <tr>
                        <td class="font-medium">{row.product_name}</td>
                        <td class="font-mono text-sm text-muted">{row.sku}</td>
                        <td class="text-sm text-muted">{row.commissary_name}</td>
                        <td class="text-right font-semibold text-emerald-700">{row.produced_qty}</td>
                        <td class="text-right font-semibold text-blue-700">{row.dispatched_qty}</td>
                        <td class="text-right font-semibold text-rose-700">{row.wastage_qty}</td>
                        <td class="text-right text-sm text-gray-600">
                            <span class="font-semibold">{row.cumulative_remaining}</span>
                        </td>
                        <td class="text-right">
                            <div class="inline-flex items-center gap-1">
                                <input type="number" min="0" step="1" class="form-input w-24 text-right production-count-input"
                                    data-commissary-id="{row.commissary_branch_id}"
                                    data-product-id="{row.product_id}"
                                    data-original="{if row.actual_end_qty !== null}{row.actual_end_qty}{/if}"
                                    value="{if row.actual_end_qty !== null}{row.actual_end_qty}{else}{row.book_balance}{/if}"
                                    title="Suggested book balance: {row.book_balance}">
                                <button type="button" class="btn btn-outline btn-sm print-hidden" onclick="saveProductionCount(this)">Save</button>
                            </div>
                            <div class="text-xs text-gray-500">suggested {row.book_balance}; blank = not counted</div>
                        </td>
                        <td class="text-right production-variance" data-product-id="{row.product_id}">{if row.calc_variance !== null}{row.calc_variance}{else}—{/if}</td>
                        <td class="text-sm text-muted">{row.updated_at}</td>
                    </tr>
                    </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Tab 3: Deliveries -->
<div id="tab-deliveries" class="tab-panel hidden">
    {if branch_dispatch_summary | count > 0}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-4">
        {foreach branch_dispatch_summary as bs}
        <div class="card">
            <div class="card-body py-3">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-semibold text-gray-900">{bs.branch_name}</span>
                    <span class="text-xs font-mono text-gray-500">{bs.dr_numbers | join:', '}</span>
                </div>
                <div class="mt-1 text-lg font-semibold text-blue-700">{bs.total_qty} pcs</div>
                <div class="text-xs text-gray-500">{bs.delivery_count} delivery(ies)</div>
            </div>
        </div>
        {/foreach}
    </div>
    {/if}
    <div class="card">
        <div class="card-header">
            <span>Deliveries to Branches — {date}</span>
            <span class="text-sm text-muted">{delivery_rows | count} line items</span>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>DR #</th>
                        <th>Date</th>
                        <th>Branch</th>
                        <th>Product</th>
                        <th class="text-right">Qty</th>
                        <th>Status</th>
                        <th>Remarks</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    {if delivery_rows | count == 0}
                    <tr><td colspan="8" class="px-4 py-10 text-center text-sm text-gray-500">No deliveries recorded for this date.</td></tr>
                    {/if}
                    {foreach delivery_rows as row}
                    <tr>
                        <td class="font-mono text-sm font-semibold">{row.dr_number | default:'—'}</td>
                        <td>{row.delivery_date}</td>
                        <td class="font-medium">{row.branch_name}</td>
                        <td>{row.product_name} <span class="text-muted">({row.sku})</span></td>
                        <td class="text-right font-semibold">{row.quantity}</td>
                        <td>
                            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold ring-1 ring-inset
                                {if row.status == 'posted'}bg-blue-50 text-blue-700 ring-blue-200
                                {elseif row.status == 'draft'}bg-gray-50 text-gray-600 ring-gray-200
                                {elseif row.status == 'voided'}bg-rose-50 text-rose-700 ring-rose-200{/if}">
                                {row.status}
                            </span>
                        </td>
                        <td class="text-sm text-muted max-w-[16ch] truncate">{row.remarks | default:'—'}</td>
                        <td class="text-sm text-muted">{row.created_by_name} · {row.created_at}</td>
                    </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Tab 4: Pullouts / Returns -->
<div id="tab-pullouts" class="tab-panel hidden">
    <div class="card">
        <div class="card-header">
            <span>Pullouts &amp; Returns to Commissary — {date}</span>
            <span class="text-sm text-muted">{pullout_rows | count} line items</span>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>DR #</th>
                        <th>Date</th>
                        <th>From Branch</th>
                        <th>To Commissary</th>
                        <th>Product</th>
                        <th class="text-right">Qty</th>
                        <th>Status</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    {if pullout_rows | count == 0}
                    <tr><td colspan="8" class="px-4 py-10 text-center text-sm text-gray-500">No pullouts or returns for this date.</td></tr>
                    {/if}
                    {foreach pullout_rows as row}
                    <tr>
                        <td class="font-mono text-sm font-semibold">{row.dr_number | default:'—'}</td>
                        <td>{row.delivery_date}</td>
                        <td class="font-medium">{row.from_branch_name}</td>
                        <td class="text-sm text-muted">{row.commissary_branch_name}</td>
                        <td>{row.product_name} <span class="text-muted">({row.sku})</span></td>
                        <td class="text-right font-semibold text-amber-700">{row.quantity}</td>
                        <td>
                            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold ring-1 ring-inset
                                {if row.status == 'posted'}bg-emerald-50 text-emerald-700 ring-emerald-200
                                {else}bg-gray-50 text-gray-600 ring-gray-200{/if}">
                                {row.status}
                            </span>
                        </td>
                        <td class="text-sm text-muted max-w-[16ch] truncate">{row.remarks | default:'—'}</td>
                    </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Tab 5: Summary -->
<div id="tab-summary" class="tab-panel hidden">
    <div class="card mb-6">
        <div class="card-header">
            <span>Per-Product Summary — {date}</span>
            <span class="text-sm text-muted">BEG + Produced − Dispatched − Wastage = Book Balance</span>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th class="text-right">BEG</th>
                        <th class="text-right">Produced</th>
                        <th class="text-right">Dispatched</th>
                        <th class="text-right">Wastage</th>
                        <th class="text-right">Returned</th>
                        <th class="text-right">Net Available</th>
                    </tr>
                </thead>
                <tbody>
                    {if summary_rows | count == 0}
                    <tr><td colspan="8" class="px-4 py-10 text-center text-sm text-gray-500">No activity to summarize for this date.</td></tr>
                    {/if}
                    {foreach summary_rows as row}
                    <tr>
                        <td class="font-medium">{row.product_name}</td>
                        <td class="font-mono text-sm text-muted">{row.sku}</td>
                        <td class="text-right font-semibold text-gray-700">{row.beg_qty}</td>
                        <td class="text-right font-semibold text-emerald-700">{row.produced_qty}</td>
                        <td class="text-right text-blue-700">{row.dispatched_qty}</td>
                        <td class="text-right text-rose-700">{row.wastage_qty}</td>
                        <td class="text-right text-amber-700">{row.returned_qty}</td>
                        <td class="text-right font-semibold text-gray-900">{row.net_available}</td>
                    </tr>
                    {/foreach}
                </tbody>
                <tfoot class="border-t-2 border-gray-200 bg-gray-50">
                    <tr>
                        <td class="font-semibold">TOTAL</td>
                        <td></td>
                        <td></td>
                        <td class="text-right font-semibold text-emerald-700">{totals.total_produced}</td>
                        <td class="text-right font-semibold text-blue-700">{totals.total_dispatched}</td>
                        <td class="text-right font-semibold text-rose-700">{totals.total_wastage}</td>
                        <td class="text-right font-semibold text-amber-700">{totals.total_returned}</td>
                        <td class="text-right font-semibold text-gray-900">{totals.total_remaining + totals.total_returned}</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

{/if}
<!-- Tab 1: Daily Sheet -->
<div id="tab-daily-sheet" class="tab-panel">
    <div class="mb-5 flex gap-2 border-b border-gray-200 print-hidden">
        <button type="button" id="production-destination-tab-branches" class="px-4 py-2 text-sm font-semibold border-b-2 border-indigo-600 text-indigo-700" onclick="switchProductionDestinationTab('branches')">Branches</button>
        {if consignee_enabled}<button type="button" id="production-destination-tab-consignees" class="px-4 py-2 text-sm font-semibold border-b-2 border-transparent text-gray-500" onclick="switchProductionDestinationTab('consignees')">Consignees</button>{/if}
    </div>
    <div id="production-destination-panel-branches">
    <!-- Print-only identity header. Hidden on screen (.hidden); the print stylesheet
         reveals it so the printed sheet names the commissary, date, shift and day
         status. Plain text only — no controls. -->
    <div id="daily-sheet-print-header" class="hidden">
        <div class="mb-2 border-b border-slate-300 pb-2">
            <div class="text-base font-semibold text-slate-900">Daily Production Sheet</div>
            <div class="mt-0.5 text-xs text-slate-700">
                <span>Commissary: {sheet_source_branch_name}</span>
                <span> &middot; Date: {date}</span>
                <span> &middot; Shift: {if shift}{shift}{else}All{/if}</span>
                <span> &middot; Status: {day_status}</span>
            </div>
        </div>
    </div>
    <div class="card mb-6">
        <div class="card-header">
            <div>
                <span>Daily Production Sheet — {date}{if shift} · {shift}{else} · All shifts{/if}</span>
                {if sheet_source_branch_name}
                <span id="production-commissary-name"
                      class="ml-2 inline-flex items-center gap-1 rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700 ring-1 ring-inset ring-indigo-200"
                      title="Commissary this sheet, its day status and its close/reopen controls belong to">
                    <i class="fas fa-warehouse" aria-hidden="true"></i>
                    {sheet_source_branch_name}
                </span>
                {/if}
                <span class="ml-2 inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset
                    {if day_status == 'open'}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}
                    {if day_status == 'closed'}bg-rose-50 text-rose-700 ring-rose-200{/if}
                " id="production-day-status">{day_status}</span>
                <div class="text-xs text-gray-500">BEG + ADDTL − TOTAL − WASTAGE = ACTUAL BAL</div>
            </div>
            <div class="flex items-center gap-2 print-hidden">
                {if !can_view_production_management}
                <input type="date" id="production-date-picker" name="date" value="{date}" max="{today}"
                       class="form-input w-auto min-w-40" onchange="window.dlReloadProductionDate(this.value)"
                       title="Business date">
                {/if}
                {if !can_view_production_management}
                {if shift_locked}
                <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset bg-slate-100 text-slate-600 ring-slate-300">Locked to {shift} Shift</span>
                {else}
                <div class="inline-flex items-center rounded-full bg-slate-100 p-0.5 ring-1 ring-inset ring-slate-300" role="group" aria-label="Shift">
                    <a href="{base_url}/admin/commissary?date={date}&commissary_id={commissary_id}&branch_id={branch_id}&shift=AM" class="rounded-full px-3 py-1 text-xs font-semibold {if shift == 'AM'}bg-white text-indigo-700 shadow-sm{else}text-slate-500 hover:text-slate-700{/if}">AM</a>
                    <a href="{base_url}/admin/commissary?date={date}&commissary_id={commissary_id}&branch_id={branch_id}&shift=PM" class="rounded-full px-3 py-1 text-xs font-semibold {if shift == 'PM'}bg-white text-indigo-700 shadow-sm{else}text-slate-500 hover:text-slate-700{/if}">PM</a>
                </div>
                {/if}
                {/if}
                {if shift_status != 'finalized'}<button type="button" class="btn btn-primary btn-sm" onclick="openProductionAdditionModal()">Record Addition</button>{/if}
                {if shift == 'PM' && shift_status != 'finalized'}<button type="button" class="btn btn-outline btn-sm" id="finalize-production-pm" onclick="finalizeProductionPm()">Close PM Shift</button>{/if}
                {if can_view_production_management && shift_status == 'finalized'}<button type="button" class="btn btn-outline btn-sm" onclick="reopenProductionShift()">Reopen Shift</button>{/if}
                {if can_close_day && day_status != 'closed'}<button type="button" class="btn btn-outline btn-sm" id="production-close-day" onclick="closeProductionDay()">Close Day</button>{/if}
                {if can_reopen_day && day_status == 'closed'}<button type="button" class="btn btn-outline btn-sm" id="production-reopen-day" onclick="reopenProductionDay()">Reopen Day</button>{/if}
                <button type="button" class="btn btn-outline btn-sm" onclick="window.print()">Print Daily Sheet</button>
            </div>
        </div>
        {* Settled-ending lifecycle (R1/R2). The three data-* counts are read by the acceptance
           specs and must equal settled_summary exactly. Verify/revert are ADMIN ONLY and are
           ABSENT (never disabled) for everyone else. *}
        {if settled_summary.pending > 0 || settled_summary.unverified > 0 || settled_summary.verified > 0}
        <div id="settled-panel" data-pending="{settled_summary.pending}" data-unverified="{settled_summary.unverified}" data-verified="{settled_summary.verified}"
             class="mx-4 mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 rounded border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-700 print-hidden"
             role="status">
            <span class="font-semibold text-slate-900">Endings</span>
            <span id="settled-pending-count">{settled_summary.pending} pending</span>
            <span id="settled-unverified-count">{settled_summary.unverified} settled ending(s) awaiting verification</span>
            <span id="settled-verified-count">{settled_summary.verified} verified</span>
            {if settled_summary.can_settle && settled_summary.pending > 0}
            <button type="button" class="btn btn-outline btn-sm ml-auto" id="settle-pending-endings"
                    onclick="window.dlSettlePendingEndings()"
                    title="Settle every pending ending in this shift as a derived, unverified ending. An admin can revert it.">Settle pending endings</button>
            {/if}
            {if settled_summary.can_verify && settled_summary.unverified > 0}
            <button type="button" class="btn btn-primary btn-sm" id="verify-settled-endings"
                    onclick="window.dlVerifySettledEndings()"
                    title="Admin only: certify the settled endings as counted numbers. This is audited.">Verify for finality</button>
            <button type="button" class="btn btn-outline btn-sm" id="revert-settled-endings"
                    onclick="window.dlRevertSettledEndings()"
                    title="Admin only: return the settled endings to pending, discarding the derived numbers.">Revert to pending</button>
            {/if}
        </div>
        {/if}
        {if prior_pending_day}
        <div class="mb-4 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="status">
            <span class="font-semibold">PM ending pending for {prior_pending_day.date}.</span>
            <span class="ml-1 text-amber-800">That business date is still open because its PM shift was not finalized. Enter the late counts, then close the PM shift.</span>
            <a class="ml-2 font-semibold text-amber-900 underline" href="{base_url}/admin/commissary?date={prior_pending_day.date}&commissary_id={sheet_source_branch_id}&shift=PM">Open prior PM ledger</a>
        </div>
        {/if}
        {if pm_flag}
        <div id="production-pm-flag" class="mb-4 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="status">
            <span class="font-semibold">The PM shift for {pm_flag.date} was closed without finalizing.</span>
            <span class="ml-1 text-amber-800">The late ending counts are still outstanding.</span>
            <span class="ml-1 text-amber-800">Flagged {pm_flag.at}.</span>
        </div>
        {/if}
        <div id="finalize-pm-result" class="hidden mb-4 rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert"></div>
        {if shift_status == 'finalized'}
        <div class="mx-4 mt-4 rounded border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs text-emerald-900">The {shift} shift is finalized and locked.</div>
        {/if}
        <div class="mx-4 mt-4 flex items-center gap-3 print-hidden">
            <button type="button" class="btn btn-outline btn-sm hidden" id="production-carry-beginnings-btn" onclick="carryProductionBeginnings()">Carry beginnings forward</button>
            <span class="hidden text-xs text-amber-700" id="production-carry-beginnings-note"></span>
        </div>
        {if historical_unshifted_count > 0}
        <div class="mx-4 mt-4 rounded border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-700">{historical_unshifted_count} pre-shift row(s) exist for this date. They remain unshifted historical data and are not included in AM or PM.</div>
        {/if}
        {if can_view_production_management}
        <div class="mx-4 mt-4 rounded border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900 print-hidden">
            Product-label seam pending owner ruling — unresolved: {unresolved_sheet_labels | join:', '}.
            No mapping has been guessed.
        </div>
        {/if}
        {* Column count for the fluid grid floor. The rendered branch columns are the
           active branches minus the sheet's own source branch; the four non-branch
           numeric columns (BEG, ADDTL, TOTAL, ACTUAL BAL) are always present. The
           table declares this as --sheet-numeric-cols so its min-width scales with
           the branch count instead of being one hard-coded width. *}
        {set sheet_branch_column_count = sheet_branches | count}
        {set sheet_numeric_column_count = sheet_branch_column_count + 3}
        <div class="table-wrap">
            <table class="production-ledger-table" id="production-ledger-table" style="--sheet-numeric-cols: {sheet_numeric_column_count}">
                <thead>
                    <tr>
                        <th>Product</th>
                        {* Right padding matches the cell content's right padding so the header
                           text's right edge sits over the cell content it labels (S7c). *}
                        <th class="text-right pr-1">BEG</th>
                        <th class="text-right pr-2">ADDTL</th>
                        {foreach sheet_branches as br}
                        {if br.id != sheet_source_branch_id}
                        <th class="text-right daily-sheet-branch-column" data-branch-id="{br.id}">{br.name}</th>
                        {/if}
                        {/foreach}
                        <th class="text-right">TOTAL</th>
                        <th class="text-right pr-1">ACTUAL BAL</th>
                        {if can_view_production_variance}<th class="text-right">VARIANCE</th>{/if}
                    </tr>
                </thead>
                <tbody>
                    {if daily_sheet_rows | count == 0}
                    <tr><td colspan="99" class="px-4 py-10 text-center text-sm text-gray-500">No cashier-assigned products are available for this production branch.</td></tr>
                    {/if}
                    {foreach daily_sheet_rows as row}
                    <tr class="daily-sheet-product-row" data-product-id="{row.product_id}" data-produced="{row.addtl_qty}">
                        <td class="font-medium">{row.sheet_label}</td>
                        <td class="px-1 py-1 text-right">
                            {* BEG is user-settable; the carry is the suggestion, never auto-persisted. *}
                            <input type="number" step="1" class="form-input w-20 ml-auto text-right production-beg-input"
                                id="production-beg-{row.product_id}"
                                value="{row.beg_qty}"
                                data-original="{row.beg_qty}"
                                data-suggestion="{row.beg_suggestion}"
                                data-recorded="{if row.beg_is_recorded}1{else}0{/if}"
                                data-carry-source="{if shift == 'PM'}am-end{else}prev-end{/if}"
                                onchange="saveProductionBeg({row.product_id})"
                                {if shift_status == 'finalized' || day_status == 'closed' || production_reference_only}disabled{/if}
                                title="Suggested beginning: {row.beg_suggestion}">
                            {if row.beg_suggestion > 0}
                            <div class="mt-0.5 text-xs leading-tight text-indigo-600 production-carry-source">
                                {if shift == 'PM'}AM end: {row.beg_suggestion}{else}Prev end: {row.beg_suggestion}{/if}
                            </div>
                            {/if}
                        </td>
                        {* ADDTL is a displayed value and a per-row entry point. The row trigger opens
                           the Record Addition modal with that row's product preselected, mirroring the
                           cashier ledger's dlAddStockDirect trigger; editing is the log below. *}
                        <td class="text-right px-2 py-1 font-semibold">
                            <button type="button"
                                    class="ledger-trigger ledger-trigger-add addtl-trigger"
                                    data-product="{row.product_id}"
                                    {if shift_status == 'finalized'}disabled{/if}
                                    onclick="openProductionAdditionModal({row.product_id})"
                                    title="Record an addition for {row.sheet_label}">
                                <span class="production-addtl-value" id="production-addtl-{row.product_id}" data-field="addtl" data-product="{row.product_id}">{row.addtl_qty}</span>
                                <i class="fas fa-plus text-[10px]" aria-hidden="true"></i>
                            </button>
                        </td>
                        {foreach row.branch_cells as cell}
                        {if cell.branch_id != sheet_source_branch_id}
                        <td class="text-right production-branch-cell" data-branch-id="{cell.branch_id}">
                            {* S10: the cell is the entry point. The value stays the delivery SUM
                               displayed by dl_fetchProductionSheetDispatchMatrix; the trigger opens
                               the signed-entry modal with this product and branch preselected. *}
                            <button type="button"
                                    class="ledger-trigger ledger-trigger-add production-branch-trigger"
                                    data-product="{row.product_id}"
                                    data-branch="{cell.branch_id}"
                                    data-branch-name="{cell.branch_name}"
                                    data-exists="{if cell.has_entry}1{else}0{/if}"
                                    {if shift_status == 'finalized'}disabled{/if}
                                    {if !cell.is_assigned}data-unassigned="1"{/if}
                                    onclick="openBranchCellModal({row.product_id}, {cell.branch_id})"
                                    title="{if !cell.is_assigned}{row.sheet_label} is not in {cell.branch_name}'s product list - you can still record it{else}Record a delivery for {row.sheet_label} to {cell.branch_name}{/if}">
                                <span class="production-branch-value" data-product="{row.product_id}" data-branch-id="{cell.branch_id}">{cell.quantity}</span>
                                <i class="fas fa-plus text-[10px]" aria-hidden="true"></i>
                            </button>
                            {* S12: what the cashier actually received and the signed delivery
                               difference, plus the DR. A sent item with no receiving row is
                               pending and must never render as a zero difference. A cell
                               with no delivery at all shows nothing. *}
                            {if can_view_production_variance}
                            {if cell.has_delivery}
                            {if cell.origin_unresolved}
                            <div class="production-branch-origin-unresolved font-semibold text-amber-700"
                                 data-origin-state="unresolved">&middot; origin unresolved</div>
                            {/if}
                            {if cell.received_pending}
                            <div class="production-branch-receipt production-branch-receipt-pending"
                                 data-receipt-state="pending"
                                 title="Cashier has not received this delivery yet">&middot; pending</div>
                            {elseif cell.not_independently_counted}
                            <div class="production-branch-receipt font-semibold text-amber-700"
                                 data-receipt-state="not-independently-counted"
                                 title="Sent quantity was copied; no independent physical count was entered">not independently counted</div>
                            {elseif cell.count_basis_unresolved}
                            <div class="production-branch-receipt font-semibold text-amber-700"
                                 data-receipt-state="count-basis-unresolved"
                                 title="Historical receipt does not establish whether this quantity was independently counted">count basis unresolved</div>
                            {else}
                            <div class="production-branch-receipt"
                                 data-receipt-state="{if cell.delivery_diff_display != ''}variance{else}received{/if}"
                                 title="Quantity the cashier independently counted">rcv {cell.received_qty}</div>
                            {if cell.delivery_diff_display != ''}
                            <div class="production-branch-diff {if cell.delivery_short}production-branch-diff-short{else}production-branch-diff-over{/if}"
                                 data-delivery-diff="{cell.delivery_diff}">{cell.delivery_diff_display}</div>
                            {/if}
                            {/if}
                            {if cell.dr_display != ''}
                            <div class="production-branch-dr" title="Delivery receipt number">DR {cell.dr_display}</div>
                            {/if}
                            {/if}
                            {/if}
                        </td>
                        {/if}
                        {/foreach}
                        <td class="text-right font-semibold production-total">{row.total_qty}</td>
                        <td class="px-1 py-1 text-right">
                            <input type="number" step="1" class="form-input w-24 ml-auto text-right production-actual-input"
                                id="production-actual-{row.product_id}"
                                value="{row.actual_input_value}"
                                data-original="{if row.actual_end_qty !== null}{row.actual_end_qty}{/if}"
                                data-suggestion="{row.book_balance}"
                                onchange="saveProductionActual({row.product_id})"
                                {if shift_status == 'finalized'}disabled{/if}
                                title="Suggested book balance: {row.book_balance}; clear and save for not counted">
                        </td>
                        {if can_view_production_variance}<td class="text-right production-variance">{if row.calc_variance_present}{row.calc_variance}{/if}</td>{/if}
                    </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>

    {if can_view_production_management}
    <!-- S7b: the bottom log. Every change accumulates here; a row is editable in place
         and editing appends a new audit record rather than erasing the prior one. -->
    <div class="card mb-6" id="production-ledger-log-card">
        <div class="card-header">
            <span>Production Ledger Log — {date}</span>
            <span class="text-sm text-muted">Logged and editable; the prior record is kept.</span>
        </div>
        {* S15: the rule the paper flow implies, stated once next to the log. Not a
           workflow — the send/receive rows below are the evidence it refers to. *}
        <div class="px-4 py-2 text-sm text-muted border-b" id="production-ledger-log-rule">
            DR = what was sent (production) · Received = what the branch counted ·
            the difference is an open item until one side is corrected, and every correction is logged
        </div>
        <div class="table-wrap">
            <table id="production-ledger-log-table">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>Who</th>
                        <th>Product</th>
                        <th>Branch</th>
                        <th>Field</th>
                        <th>Type</th>
                        <th class="text-right">Before → After</th>
                        <th>Reason</th>
                        <th class="text-right print-hidden">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {if production_log | count == 0}
                    <tr><td colspan="9" class="px-4 py-8 text-center text-sm text-gray-500">No changes recorded for this date yet.</td></tr>
                    {/if}
                    {foreach production_log as entry}
                    <tr class="production-log-row" data-field="{entry.field_key}" data-product-id="{entry.product_id}"
                        data-branch-id="{if entry.branch_id}{entry.branch_id}{/if}"
                        data-before="{entry.before}" data-after="{entry.after}">
                        <td class="text-sm text-muted">{entry.when}</td>
                        <td class="text-sm">{entry.who | default:'—'}</td>
                        <td class="font-medium">{entry.product_name}</td>
                        <td class="text-sm text-muted">{entry.branch_name | default:'—'}</td>
                        <td>{entry.field}</td>
                        <td class="text-sm text-muted">{entry.adjustment_type | default:'—'}</td>
                        <td class="text-right production-log-change">{entry.before_display} → {entry.after_display}{if entry.signed_display} <span class="text-muted">({entry.signed_display})</span>{/if}</td>
                        <td class="text-sm text-muted production-log-reason">{entry.reason | default:'—'}</td>
                        <td class="text-right print-hidden">
                            {* A branch-cell correction is append-only by design: its target is
                               corrected from the branch cell trigger, never overwritten in place. *}
                            {if production_can_override && entry.source != 'branch_entry' && entry.source != 'send' && entry.source != 'receiving'}
                            <button type="button" class="btn btn-outline btn-sm" onclick="editProductionLogRow(this)">Edit</button>
                            {/if}
                        </td>
                    </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
    </div>

    {/if}
    <!-- S7b: one simple modal — product, quantity, optional reason. The batch/yield
         machinery is deliberately not carried in; output_pieces_per_batch is NULL for
         every product on this tenant, so the mechanism is inert. It can return if yield
         profiles are ever configured. -->
    <div id="production-addition-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4 print-hidden" role="dialog" aria-modal="true" aria-labelledby="production-addition-title">
        <div class="w-full max-w-md rounded-lg bg-white shadow-xl">
            <div class="card-header"><span id="production-addition-title">Record Addition (ADDTL)</span></div>
            <div class="card-body space-y-3">
                <div class="form-group mb-0">
                    <label class="form-label">Product</label>
                    <select id="production-addition-product" class="form-input">
                        <option value="">-- Select Product --</option>
                        {foreach daily_sheet_rows as row}
                        <option value="{row.product_id}">{row.sheet_label}</option>
                        {/foreach}
                    </select>
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Quantity</label>
                    <input type="number" min="1" step="1" id="production-addition-qty" class="form-input text-right" value="">
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Reason <span class="text-gray-400">(optional)</span></label>
                    <input type="text" id="production-addition-reason" class="form-input" maxlength="255" placeholder="e.g. morning bake">
                </div>
                <div id="production-addition-status" class="text-sm text-rose-600" aria-live="polite"></div>
                <div class="flex justify-end gap-2">
                    <button type="button" class="btn btn-outline" onclick="closeProductionAdditionModal()">Cancel</button>
                    <button type="button" class="btn btn-primary" id="production-addition-submit" onclick="submitProductionAddition()">Record Addition</button>
                </div>
            </div>
        </div>
    </div>

    <!-- S10: branch-cell entry. A first entry is a plain signed quantity. Editing an
         already-recorded entry requires Type + Reason Code, copied verbatim from the
         cashier withdrawal modal; each change is appended as its own delivery + log
         row, so the original entry is never overwritten. -->
    <div id="branch-cell-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4 print-hidden" role="dialog" aria-modal="true" aria-labelledby="branch-cell-title">
        <div class="w-full max-w-lg rounded-lg bg-white shadow-xl">
            <div class="card-header"><span id="branch-cell-title">Record Branch Delivery</span></div>
            <div class="card-body space-y-3">
                <input type="hidden" id="branch-cell-branch-id" value="">
                <div class="form-group mb-0">
                    <label class="form-label">Product</label>
                    <select id="branch-cell-product" class="form-input">
                        <option value="">-- Select Product --</option>
                        {foreach daily_sheet_rows as row}
                        <option value="{row.product_id}">{row.sheet_label}</option>
                        {/foreach}
                    </select>
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Branch <span class="text-gray-400">(destination)</span></label>
                    <input type="text" id="branch-cell-branch-name" class="form-input bg-gray-100" value="" readonly>
                </div>
                <div class="form-group mb-0">
                    <label class="form-label">Quantity</label>
                    <input type="number" step="1" id="branch-cell-qty" class="form-input text-right" value="">
                </div>
                <div class="rounded-lg border border-orange-200 bg-orange-50 px-3 py-2 text-xs leading-5 text-orange-800">
                    A positive quantity <span class="font-semibold">adds</span> to the delivered quantity; to
                    <span class="font-semibold">reduce</span> an amount recorded too high, put a minus sign first
                    (e.g. <span class="font-mono font-semibold">-3</span>). Each adjustment is logged as its own row,
                    so the trail reads: original entry → correction.
                </div>
                <div id="branch-cell-unassigned-note" class="hidden rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-900">
                    This branch does not list this product. Recording it here still works: the product is given
                    back to this branch and the admin is notified, so nobody waits for a list update. If this was
                    a mistake, reverse the entry and an admin can hide the product again.
                </div>
                <div id="branch-cell-edit-fields" class="space-y-3 hidden">
                    <div class="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-900">
                        This cell already has a recorded delivery. A change needs a Type and a Reason Code and is appended, never overwritten.
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label">Type <span class="text-rose-500">*</span></label>
                        <select id="branch-cell-type" class="form-input" onchange="syncBranchCellAdjustmentFields()">
                            <option value="charge">Charge</option>
                            <option value="pullout">Pullout</option>
                            <option value="used">Used (for a product/order)</option>
                            <option value="correction">Correction — wrong entry</option>
                            <option value="adjustment_add">Add Stock (missed entry / variance)</option>
                            <option value="correction_addtl">Correction — Additional (wrong entry)</option>
                        </select>
                    </div>
                    <div class="form-group mb-0">
                        <label class="form-label">Reason Code <span class="text-rose-500">*</span></label>
                        <select id="branch-cell-reason" class="form-input" onchange="syncBranchCellAdjustmentFields()">
                            <option value="manual_adjustment">Manual adjustment</option>
                            <option value="encoder_omission">Encoder omission (nothing lost)</option>
                            <option value="spoilage">Spoilage</option>
                            <option value="staff_meal">Staff meal</option>
                            <option value="sampling">Sampling</option>
                            <option value="testing">Testing</option>
                            <option value="promo">Promo</option>
                            <option value="donation">Donation</option>
                            <option value="damage">Damage</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                    <div class="form-group mb-0 hidden" id="branch-cell-custom-reason-wrap">
                        <label class="form-label">Custom Reason <span class="text-rose-500">*</span></label>
                        <input type="text" id="branch-cell-custom-reason" class="form-input" maxlength="255" placeholder="Describe the reason for this adjustment">
                    </div>
                    <p id="branch-cell-omission-note" class="hidden rounded-lg border border-sky-200 bg-sky-50 px-3 py-2 text-xs leading-5 text-sky-900">
                        Nothing was lost — this records stock that was simply not entered, so no one is charged and no liable person is recorded.
                    </p>
                </div>
                <div id="branch-cell-status" class="text-sm text-rose-600" aria-live="polite"></div>
                <div class="flex justify-end gap-2">
                    <button type="button" class="btn btn-outline" onclick="closeBranchCellModal()">Cancel</button>
                    <button type="button" class="btn btn-primary" id="branch-cell-submit" onclick="submitBranchCellEntry()">Save Entry</button>
                </div>
            </div>
        </div>
    </div>
</div>

    <div id="production-destination-panel-consignees" class="hidden">
        <div class="card mb-6">
            <div class="card-header">
                <div>
                    <span>Consignee Daily Sheet — {date}{if shift} · {shift}{else} · All shifts{/if}</span>
                    <div class="text-xs text-gray-500">Only consignees supplied by {sheet_source_branch_name} with ledger activity on this date are shown.</div>
                    <div class="text-xs text-gray-500">BEG + ADDTL &minus; TOTAL &minus; WASTAGE = ACTUAL BAL. Here ACTUAL BAL is the <span class="font-semibold">commissary balance after consignee dispatch</span> &mdash; it is not the Branches tab's on-hand figure.</div>
                </div>
            </div>
            <div class="card-body border-b border-slate-200">
                <p class="text-xs text-gray-500">This is a stock (production destination) view. Quantities only — dispatched value belongs on Sales &rarr; Consignee Dispatch Report.</p>
            </div>
            <div class="table-wrap">
                <table class="production-ledger-table" id="consignee-production-ledger-table" style="--sheet-numeric-cols: {consignee_sheet_numeric_column_count}">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-right pr-1">BEG</th>
                            <th class="text-right pr-2">ADDTL</th>
                            {foreach consignee_sheet_columns as cc}
                            <th class="text-right consignee-sheet-column" data-consignee-id="{cc.id}">{cc.name}</th>
                            {/foreach}
                            <th class="text-right">TOTAL</th>
                            <th class="text-right pr-1" title="Commissary balance after consignee dispatch">ACTUAL BAL</th>
                        </tr>
                    </thead>
                    <tbody>
                        {if consignee_sheet_columns | count == 0 && consignee_assignment_count == 0}
                        <tr><td colspan="99" class="px-4 py-10 text-center text-sm text-gray-500">No products are assigned to active consignees for this commissary. Use Products → Show in Consignees to choose what appears here.</td></tr>
                        {/if}
                        {if consignee_sheet_columns | count == 0 && consignee_assignment_count > 0}
                        <tr><td colspan="99" class="px-4 py-10 text-center text-sm text-gray-500">No ledger activity for the assigned consignee products on this date.</td></tr>
                        {/if}
                        {if consignee_sheet_columns | count > 0}
                        {foreach consignee_sheet_rows as row}
                        <tr class="consignee-sheet-product-row" data-product-id="{row.product_id}">
                            <td class="font-medium">{row.sheet_label}</td>
                            <td class="text-right">{row.beg_qty}</td>
                            <td class="text-right font-semibold text-emerald-700">{row.addtl_qty}</td>
                            {foreach row.cells as cell}
                            <td class="text-right consignee-sheet-cell" data-consignee-id="{cell.consignee_id}">{cell.quantity}</td>
                            {/foreach}
                            <td class="text-right font-semibold consignee-sheet-total">{row.total_qty}</td>
                            <td class="text-right">{row.book_balance}</td>
                        </tr>
                        {/foreach}
                        {/if}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{if can_view_production_management}
<!-- Dispatch to Branch -->
<div class="card mt-6">
    <div class="card-header">
        <span>Dispatch to Branch</span>
        <span class="text-sm text-muted">Select a destination branch, enter DR number, fill quantities for products on hand</span>
    </div>
    <div class="card-body">
        {if cumulative_stock | count == 0}
        <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            No products with remaining stock. Record production output first.
        </div>
        {/if}
        {if cumulative_stock | count > 0}
        <div class="grid grid-cols-1 gap-3 md:grid-cols-3 items-end mb-4">
            <div class="form-group mb-0">
                <label class="form-label">Destination Branch</label>
                <select id="dispatch-dest-branch-id" class="form-input">
                    <option value="">-- Select Branch --</option>
                    {foreach branches as br}
                    <option value="{br.id}"{if br.is_commissary} data-is-commissary="1"{/if}>{br.name}{if br.is_commissary} (commissary){/if}</option>
                    {/foreach}
                </select>
                <p class="mt-1 text-xs text-gray-500">Do not dispatch from a commissary to itself. Co-located branches use the Usage page for an <span class="font-semibold">Internal release (same location)</span>.</p>
            </div>
            <div class="form-group mb-0">
                <label class="form-label">DR Number</label>
                <input type="text" id="dispatch-dr-number" class="form-input" placeholder="e.g. DR-2026-001">
            </div>
            <div class="flex items-center gap-2">
                <button type="button" class="btn btn-primary" id="submit-dispatch" onclick="submitDispatch()">Dispatch to Branch</button>
                <span id="dispatch-status" class="text-sm text-muted"></span>
            </div>
        </div>
        <div class="border rounded-lg overflow-hidden">
            <table class="mb-0">
                <thead class="bg-gray-50">
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th>Commissary</th>
                        <th class="text-right">On Hand</th>
                        <th class="text-right w-32">Qty to Send</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {foreach cumulative_stock as row}
                    <tr class="hover:bg-gray-50">
                        <td class="font-medium">{row.product_name}</td>
                        <td class="font-mono text-sm text-muted">{row.sku}</td>
                        <td class="text-sm text-muted">{row.commissary_name}</td>
                        <td class="text-right">
                            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold
                                {if row.cumulative_remaining >= 20}bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200
                                {elseif row.cumulative_remaining >= 5}bg-amber-50 text-amber-700 ring-1 ring-amber-200
                                {else}bg-rose-50 text-rose-700 ring-1 ring-rose-200{/if}">
                                {row.cumulative_remaining}
                            </span>
                        </td>
                        <td class="text-right">
                            <input type="number" min="0" max="{row.cumulative_remaining}" step="1"
                                class="form-input text-right w-24 dispatch-qty-input"
                                data-commissary-id="{row.commissary_branch_id}"
                                data-product-id="{row.product_id}"
                                data-product-name="{row.product_name}"
                                data-remaining="{row.cumulative_remaining}"
                                value="" placeholder="0">
                        </td>
                    </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
        {/if}
    </div>
</div>
{/if}

            </main>
        </div>
    </div>


<script>
    function switchProductionDestinationTab(tab) {
        var active = tab === 'consignees' ? 'consignees' : 'branches';
        ['branches', 'consignees'].forEach(function(kind) {
            var panel = document.getElementById('production-destination-panel-' + kind);
            var button = document.getElementById('production-destination-tab-' + kind);
            var selected = kind === active;
            if (panel) panel.classList.toggle('hidden', !selected);
            if (button) {
                button.classList.toggle('border-indigo-600', selected);
                button.classList.toggle('text-indigo-700', selected);
                button.classList.toggle('border-transparent', !selected);
                button.classList.toggle('text-gray-500', !selected);
            }
        });
    }

    function switchCommissaryTab(tab) {
        var tabs = ['inventory', 'deliveries', 'pullouts', 'summary', 'daily-sheet'];
        tabs.forEach(function(t) {
            var panel = document.getElementById('tab-' + t);
            var btn = document.getElementById('tab-btn-' + t);
            if (panel) panel.classList.add('hidden');
            if (btn) {
                btn.classList.remove('border-indigo-500', 'text-indigo-600');
                btn.classList.add('border-transparent', 'text-gray-500');
            }
        });
        var activePanel = document.getElementById('tab-' + tab);
        var activeBtn = document.getElementById('tab-btn-' + tab);
        if (activePanel) activePanel.classList.remove('hidden');
        if (activeBtn) {
            activeBtn.classList.add('border-indigo-500', 'text-indigo-600');
            activeBtn.classList.remove('border-transparent', 'text-gray-500');
        }
        try { localStorage.setItem('commissary_tab', tab); } catch(e) {}
    }
    (function() {
        var saved = '';
        try { saved = localStorage.getItem('commissary_tab') || ''; } catch(e) {}
        // Values persisted by the previous tab order are stale. Only the new
        // first tab is safe to restore; everything else defaults to Daily Sheet.
        switchCommissaryTab(saved === 'daily-sheet' ? saved : 'daily-sheet');
    })();

    function productionRow(pid) {
        return document.querySelector('.daily-sheet-product-row[data-product-id="' + pid + '"]');
    }

    // Identity is the submission, not the content (mirrors the cashier withdrawal
    // helper). Every modal submit mints one; a retry reuses it and is deduped.
    function dlNewSubmissionId() {
        if (window.crypto && typeof window.crypto.randomUUID === 'function') return window.crypto.randomUUID();
        return 'sub-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
    }

    // The production carry mirrors the cashier candidate rule exactly: the
    // server-recorded beginning and current cell must both still be zero, and
    // the preceding ending must be positive. Disabled candidates are retained
    // so the affordance can explain that a reopen is required.
    function productionCarryCandidates() {
        var out = [];
        document.querySelectorAll('.production-beg-input').forEach(function(input) {
            if (input.getAttribute('data-recorded') === '1') return;
            if ((parseInt(input.value || '0', 10) || 0) !== 0) return;
            var ending = parseInt(input.getAttribute('data-suggestion') || '0', 10) || 0;
            var row = input.closest('.daily-sheet-product-row');
            var productId = row ? (parseInt(row.getAttribute('data-product-id') || '0', 10) || 0) : 0;
            if (!(ending > 0) || productId <= 0) return;
            out.push({ product_id: productId, beg_qty: ending, disabled: input.disabled });
        });
        return out;
    }

    function refreshProductionCarryAffordance() {
        var btn = document.getElementById('production-carry-beginnings-btn');
        var note = document.getElementById('production-carry-beginnings-note');
        if (!btn || !note) return;
        var ready = 0;
        var blocked = 0;
        productionCarryCandidates().forEach(function(row) { row.disabled ? blocked++ : ready++; });
        if (ready > 0) {
            btn.textContent = 'Carry ' + ready + ' beginning' + (ready === 1 ? '' : 's') + ' forward';
            btn.classList.remove('hidden');
            note.classList.add('hidden');
            return;
        }
        btn.classList.add('hidden');
        if (!blocked) { note.classList.add('hidden'); return; }
        var reason = '{day_status}' === 'closed'
            ? 'this day is closed'
            : ('{shift_status}' === 'finalized' ? 'the {shift} shift is finalized' : 'this date is read-only for your role');
        note.textContent = blocked + ' beginning' + (blocked === 1 ? '' : 's') + ' waiting on a reopen - ' + reason + '.';
        note.classList.remove('hidden');
    }

    function carryProductionBeginnings() {
        if ('{day_status}' === 'closed') {
            showToast('This day is closed. Reopen the day before carrying beginnings.', 'error'); return;
        }
        if ('{shift_status}' === 'finalized') {
            showToast('The {shift} shift is finalized. Reopen the shift before carrying beginnings.', 'error'); return;
        }
        if ('{if production_reference_only}1{else}0{/if}' === '1') {
            showToast('This date is read-only for your role, so beginnings cannot be carried forward.', 'error'); return;
        }
        var rows = productionCarryCandidates()
            .filter(function(row) { return !row.disabled; })
            .map(function(row) { return { product_id: row.product_id, beg_qty: row.beg_qty }; });
        if (!rows.length) {
            showToast('Nothing to carry - every beginning is recorded, non-zero, or has no positive preceding ending.', 'warning'); return;
        }
        var btn = document.getElementById('production-carry-beginnings-btn');
        if (btn) btn.disabled = true;
        // One request owns the complete transaction; never issue one save per product.
        productionJson('{base_url}/api/v1/commissary/carry-beginnings', {
            date: '{date}', shift: '{shift}', commissary_branch_id: {sheet_source_branch_id},
            idempotency_key: 'carry-forward-{sheet_source_branch_id}-{date}-{shift}-' + Date.now(),
            rows: rows
        }).then(function(res) {
            showToast('Carried ' + res.carried + ' beginning' + (res.carried === 1 ? '' : 's') + ' forward.', 'success');
            window.refreshMainContent();
        }).catch(function(error) {
            showToast(error.message || 'Could not carry beginnings - nothing was changed.', 'error');
        }).finally(function() { if (btn) btn.disabled = false; });
    }

    refreshProductionCarryAffordance();

    // BEG remains user-settable. Carrying is a separate explicit action; this
    // function never runs on load or on a plain re-read.
    function saveProductionBeg(pid) {
        var input = document.getElementById('production-beg-' + pid);
        if (!input) return;
        var raw = input.value.trim();
        var value = raw === '' ? 0 : parseInt(raw, 10);
        if (isNaN(value)) { showToast('BEG must be a whole number', 'error'); return; }
        input.disabled = true;
        productionJson('{base_url}/api/v1/commissary/material', {
            entity: 'product_beg',
            date: '{date}',
            shift: '{shift}',
            commissary_branch_id: {sheet_source_branch_id},
            product_id: pid,
            beg_qty: value,
            submission_id: dlNewSubmissionId()
        }).then(function(res) {
            var persisted = res.row.beg_qty === null ? '' : String(res.row.beg_qty);
            input.value = persisted;
            input.setAttribute('data-original', persisted);
            input.setAttribute('data-recorded', '1');
            refreshProductionCarryAffordance();
            var row = productionRow(pid);
            if (row) {
                var variance = row.querySelector('.production-variance');
                if (variance) variance.textContent = res.row.calc_variance === null ? '—' : res.row.calc_variance;
            }
            showToast('Beginning saved', 'success');
        }).catch(function(error) {
            input.value = input.getAttribute('data-original');
            showToast(error.message || 'Save failed', 'error');
        }).finally(function() { input.disabled = false; });
    }

    // ACTUAL BAL is user-settable; blank means not counted (NULL, never 0).
    function saveProductionActual(pid) {
        var input = document.getElementById('production-actual-' + pid);
        if (!input) return;
        var raw = input.value.trim();
        var value = raw === '' ? null : parseInt(raw, 10);
        if (value !== null && isNaN(value)) { showToast('ACTUAL BAL must be a whole number', 'error'); return; }
        input.disabled = true;
        productionJson('{base_url}/api/v1/commissary/material', {
            entity: 'product_count',
            date: '{date}',
            shift: '{shift}',
            commissary_branch_id: {sheet_source_branch_id},
            product_id: pid,
            actual_end_qty: value,
            submission_id: dlNewSubmissionId()
        }).then(function(res) {
            var persisted = res.row.actual_end_qty === null ? '' : String(res.row.actual_end_qty);
            input.value = persisted;
            input.setAttribute('data-original', persisted);
            var row = productionRow(pid);
            if (row) {
                var variance = row.querySelector('.production-variance');
                if (variance) variance.textContent = res.row.calc_variance === null ? '—' : res.row.calc_variance;
            }
            showToast(value === null ? 'Count cleared (not counted)' : 'Physical count saved', 'success');
        }).catch(function(error) {
            input.value = input.getAttribute('data-original');
            showToast(error.message || 'Save failed', 'error');
        }).finally(function() { input.disabled = false; });
    }

    // Optional productId: the toolbar opens with nothing preselected, a row trigger
    // opens with that row's product selected (mirrors dlAddStockDirect).
    function openProductionAdditionModal(productId) {
        var modal = document.getElementById('production-addition-modal');
        if (!modal) return;
        var status = document.getElementById('production-addition-status');
        if (status) status.textContent = '';
        var qty = document.getElementById('production-addition-qty');
        if (qty) qty.value = '';
        var reason = document.getElementById('production-addition-reason');
        if (reason) reason.value = '';
        var product = document.getElementById('production-addition-product');
        if (product) product.value = productId ? String(productId) : '';
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeProductionAdditionModal() {
        var modal = document.getElementById('production-addition-modal');
        if (!modal) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }

    function submitProductionAddition() {
        var productEl = document.getElementById('production-addition-product');
        var qtyEl = document.getElementById('production-addition-qty');
        var reasonEl = document.getElementById('production-addition-reason');
        var status = document.getElementById('production-addition-status');
        var btn = document.getElementById('production-addition-submit');
        if (!productEl || !qtyEl || !btn) return;
        var pid = parseInt(productEl.value || '0', 10) || 0;
        var qty = parseInt(qtyEl.value || '0', 10);
        if (!pid) { if (status) status.textContent = 'Select a product.'; return; }
        if (isNaN(qty) || qty <= 0) { if (status) status.textContent = 'Quantity must be one or more.'; return; }
        btn.disabled = true;
        if (status) status.textContent = '';
        productionJson('{base_url}/api/v1/commissary/run', {
            entity: 'production_addition',
            date: '{date}',
            shift: '{shift}',
            commissary_branch_id: {sheet_source_branch_id},
            product_id: pid,
            quantity: qty,
            reason: reasonEl ? reasonEl.value.trim() : '',
            submission_id: dlNewSubmissionId()
        }).then(function(res) {
            closeProductionAdditionModal();
            showToast(res.duplicate ? 'Addition was already recorded' : 'Addition recorded', 'success');
            setTimeout(function() { window.refreshMainContent(); }, 500);
        }).catch(function(error) {
            if (status) status.textContent = error.message || 'Save failed';
            showToast(error.message || 'Save failed', 'error');
        }).finally(function() { btn.disabled = false; });
    }

    // S10: the branch cell trigger. The cell itself stays a displayed delivery SUM; the
    // modal records a NEW delivery (first entry) or a signed, reasoned, logged
    // correction (existing entry). Nothing already recorded is overwritten.
    function branchCellTrigger(productId, branchId) {
        return document.querySelector('.production-branch-cell[data-branch-id="' + branchId + '"] button[data-product="' + productId + '"]');
    }

    function syncBranchCellAdjustmentFields() {
        var reasonEl = document.getElementById('branch-cell-reason');
        var typeEl = document.getElementById('branch-cell-type');
        var customWrap = document.getElementById('branch-cell-custom-reason-wrap');
        var omissionNote = document.getElementById('branch-cell-omission-note');
        if (!reasonEl || !typeEl) return;
        var reason = reasonEl.value;
        var type = typeEl.value;
        var isOmission = (type === 'adjustment_add' && reason === 'encoder_omission');
        if (customWrap) customWrap.classList.toggle('hidden', reason !== 'other');
        if (omissionNote) omissionNote.classList.toggle('hidden', !isOmission);
    }

    function openBranchCellModal(productId, branchId) {
        var modal = document.getElementById('branch-cell-modal');
        if (!modal) return;
        var trigger = branchCellTrigger(productId, branchId);
        var hasEntry = trigger && trigger.getAttribute('data-exists') === '1';
        // The amber cell means "this branch has not been given this product".
        // Say what that means once, here, instead of in a tooltip repeated on
        // every unassigned cell of the sheet.
        var unassignedNote = document.getElementById('branch-cell-unassigned-note');
        if (unassignedNote) unassignedNote.classList.toggle('hidden', !(trigger && trigger.getAttribute('data-unassigned') === '1'));
        var productEl = document.getElementById('branch-cell-product');
        if (productEl) productEl.value = String(productId);
        document.getElementById('branch-cell-branch-id').value = String(branchId);
        document.getElementById('branch-cell-branch-name').value = (trigger && trigger.getAttribute('data-branch-name')) || '';
        document.getElementById('branch-cell-qty').value = '';
        document.getElementById('branch-cell-status').textContent = '';
        document.getElementById('branch-cell-edit-fields').classList.toggle('hidden', !hasEntry);
        // Reset a fresh intent: the type/reason only mean something on an edit.
        document.getElementById('branch-cell-type').value = 'correction';
        document.getElementById('branch-cell-reason').value = 'encoder_omission';
        document.getElementById('branch-cell-custom-reason').value = '';
        syncBranchCellAdjustmentFields();
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeBranchCellModal() {
        var modal = document.getElementById('branch-cell-modal');
        if (!modal) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
    }

    function submitBranchCellEntry() {
        var productEl = document.getElementById('branch-cell-product');
        var branchEl = document.getElementById('branch-cell-branch-id');
        var qtyEl = document.getElementById('branch-cell-qty');
        var status = document.getElementById('branch-cell-status');
        var btn = document.getElementById('branch-cell-submit');
        if (!productEl || !branchEl || !qtyEl || !btn) return;
        var pid = parseInt(productEl.value || '0', 10) || 0;
        var bid = parseInt(branchEl.value || '0', 10) || 0;
        var qty = parseInt(qtyEl.value || '0', 10);
        var isEdit = !document.getElementById('branch-cell-edit-fields').classList.contains('hidden');
        if (!pid || !bid) { if (status) status.textContent = 'Select a product and branch.'; return; }
        if (isNaN(qty) || qty === 0) { if (status) status.textContent = 'Quantity must be a non-zero whole number (use -3 to reduce).'; return; }

        var payload = {
            // A sheet entry is a real delivery without a paper DR. The server keeps
            // the formal dispatch path intact for every caller that does not send this.
            sheet_entry: true,
            ledger_date: '{date}',
            shift: '{shift}',
            destination_branch_id: bid,
            items: [{ commissary_branch_id: {sheet_source_branch_id}, product_id: pid, quantity: qty }],
            submission_id: dlNewSubmissionId()
        };
        if (isEdit) {
            var type = document.getElementById('branch-cell-type').value;
            var reason = document.getElementById('branch-cell-reason').value;
            var custom = (document.getElementById('branch-cell-custom-reason').value || '').trim();
            if (!type) { if (status) status.textContent = 'Type is required to change a recorded entry.'; return; }
            if (!reason) { if (status) status.textContent = 'Reason code is required to change a recorded entry.'; return; }
            if (reason === 'other' && custom === '') { if (status) status.textContent = 'A custom reason is required when Reason is Other.'; return; }
            payload.type = type;
            payload.reason_code = reason;
            payload.custom_reason = custom;
        }

        btn.disabled = true;
        if (status) status.textContent = '';
        productionJson('{base_url}/api/v1/commissary/dispatch', payload).then(function(res) {
            closeBranchCellModal();
            showToast(res.duplicate ? 'Entry was already recorded' : (isEdit ? 'Correction recorded' : 'Branch delivery recorded'), 'success');
            // Recording is never blocked by the branch list, so the list change it
            // caused has to be said out loud - the encoder is the only person who
            // knows whether the entry was right, and the admin has been told too.
            if (res.branch_link_revived) {
                showToast((res.product_name || 'This product') + ' was added back to ' + (res.branch_name || 'that branch') + ' and the admin was notified', 'warning');
            }
            setTimeout(function() { window.refreshMainContent(); }, 500);
        }).catch(function(error) {
            if (status) status.textContent = error.message || 'Save failed';
            showToast(error.message || 'Save failed', 'error');
        }).finally(function() { btn.disabled = false; });
    }

    function editProductionLogRow(button) {
        var tr = button ? button.closest('tr') : null;
        if (!tr || tr.getAttribute('data-editing') === '1') return;
        tr.setAttribute('data-editing', '1');
        var changeCell = tr.querySelector('.production-log-change');
        var reasonCell = tr.querySelector('.production-log-reason');
        var actionCell = tr.querySelector('td:last-child');
        var after = tr.getAttribute('data-after');
        if (changeCell) {
            changeCell.innerHTML = '<input type="number" step="1" class="form-input w-24 text-right production-log-edit-value" value="' + (after === null || after === '' ? '' : after) + '">';
        }
        if (reasonCell) {
            reasonCell.innerHTML = '<input type="text" class="form-input production-log-edit-reason" maxlength="255" placeholder="Reason (required)">';
        }
        if (actionCell) {
            actionCell.innerHTML = '<button type="button" class="btn btn-primary btn-sm" onclick="saveProductionLogEdit(this)">Save</button> ' +
                '<button type="button" class="btn btn-outline btn-sm" onclick="cancelProductionLogEdit(this)">Cancel</button>';
        }
    }

    function saveProductionLogEdit(button) {
        var tr = button ? button.closest('tr') : null;
        if (!tr) return;
        var field = tr.getAttribute('data-field');
        var pid = parseInt(tr.getAttribute('data-product-id') || '0', 10) || 0;
        var valueEl = tr.querySelector('.production-log-edit-value');
        var reasonEl = tr.querySelector('.production-log-edit-reason');
        var raw = valueEl ? valueEl.value.trim() : '';
        var reason = reasonEl ? reasonEl.value.trim() : '';
        if (reason === '') { showToast('A reason is required to edit a recorded entry', 'error'); return; }
        var value = raw === '' ? null : parseInt(raw, 10);
        if (value !== null && isNaN(value)) { showToast('Enter a whole number', 'error'); return; }
        if (value === null && field !== 'actual_end_qty') { showToast('A value is required', 'error'); return; }
        button.disabled = true;
        productionJson('{base_url}/api/v1/commissary/material', {
            entity: 'production_ledger_edit',
            date: '{date}',
            commissary_branch_id: {sheet_source_branch_id},
            product_id: pid,
            field: field,
            value: value,
            reason: reason,
            submission_id: dlNewSubmissionId()
        }).then(function() {
            showToast('Change recorded', 'success');
            setTimeout(function() { window.refreshMainContent(); }, 500);
        }).catch(function(error) {
            showToast(error.message || 'Save failed', 'error');
            button.disabled = false;
        });
    }

    function cancelProductionLogEdit(button) {
        var tr = button ? button.closest('tr') : null;
        if (!tr) return;
        tr.removeAttribute('data-editing');
        window.location.reload();
    }

    function finalizeProductionPm() {
        var button = document.getElementById('finalize-production-pm');
        if (button) button.disabled = true;
        var box = document.getElementById('finalize-pm-result');
        if (box) { box.classList.add('hidden'); box.innerHTML = ''; }
        productionJson('{base_url}/api/v1/commissary/finalize-pm', {
            date: '{date}',
            commissary_branch_id: {sheet_source_branch_id}
        }).then(function() {
            showToast('PM shift finalized', 'success');
            setTimeout(function() { window.refreshMainContent(); }, 400);
        }).catch(function(error) {
            var msg = (error && error.message) || 'Failed to finalize PM shift';
            if (box) {
                var html = '<div class="font-semibold">' + String(msg) + '</div>';
                var body = error && error.body ? error.body : null;
                var missing = body && Array.isArray(body.missing_products) ? body.missing_products.slice(0, 50) : [];
                if (missing.length) {
                    html += '<ul class="mt-2 list-disc pl-5 text-xs">';
                    missing.forEach(function(m) {
                        html += '<li>' + String((m && m.name) || ('Product #' + (m && m.product_id))) + '</li>';
                    });
                    html += '</ul>';
                }
                box.innerHTML = html;
                box.classList.remove('hidden');
            }
            showToast(msg, 'error');
        }).finally(function() {
            if (button) button.disabled = false;
        });
    }

    // Settle / verify / revert of derived endings. Explicit clicked actions (R5): no render,
    // cron or auto-close ever settles anything. The server re-authorizes every call, and the
    // refresh re-reads the counts so the panel tracks the real state.
    function productionEndingAction(url, label, successText) {
        return productionJson(url, {
            date: '{date}',
            shift: '{shift}',
            commissary_branch_id: {sheet_source_branch_id},
            production: true
        }).then(function(res) {
            showToast(successText(res), 'success');
            setTimeout(function() { window.refreshMainContent(); }, 500);
        }).catch(function(error) {
            showToast((error && error.message) || (label + ' failed'), 'error');
        });
    }
    window.dlSettlePendingEndings = function() {
        productionEndingAction('{base_url}/api/v1/commissary/settle-endings', 'Settling pending endings', function(res) {
            return (res.settled || 0) + ' ending(s) settled; awaiting verification';
        });
    };
    window.dlVerifySettledEndings = function() {
        productionEndingAction('{base_url}/api/v1/commissary/verify-endings', 'Verifying settled endings', function(res) {
            return (res.verified || 0) + ' ending(s) verified for finality';
        });
    };
    window.dlRevertSettledEndings = function() {
        productionEndingAction('{base_url}/api/v1/commissary/revert-endings', 'Reverting settled endings', function(res) {
            return (res.reverted || 0) + ' ending(s) reverted to pending';
        });
    };

    function reopenProductionShift() {
        productionJson('{base_url}/api/v1/admin/reopen-day', {
            date: '{date}', branch_id: {sheet_source_branch_id}
        }).then(function() {
            showToast('Shift reopened', 'success');
            setTimeout(function() { window.refreshMainContent(); }, 400);
        }).catch(function(error) { showToast(error.message || 'Failed to reopen shift', 'error'); });
    }

    // Close Day goes through the ONE close implementation (apiCloseDay). The server
    // enforces the production today-only rule; this only carries the viewed
    // commissary branch, which is re-authorized server-side.
    function closeProductionDay() {
        var button = document.getElementById('production-close-day');
        if (button) button.disabled = true;
        productionJson('{base_url}/api/v1/cashier/ledger/close-day', {
            date: '{date}', branch_id: {sheet_source_branch_id}
        }).then(function() {
            showToast('Day closed', 'success');
            setTimeout(function() { window.refreshMainContent(); }, 400);
        }).catch(function(error) {
            showToast(error.message || 'Failed to close day', 'error');
            if (button) button.disabled = false;
        });
    }

    function reopenProductionDay() {
        var button = document.getElementById('production-reopen-day');
        if (button) button.disabled = true;
        productionJson('{base_url}/api/v1/admin/reopen-day', {
            date: '{date}', branch_id: {sheet_source_branch_id}
        }).then(function() {
            showToast('Day reopened', 'success');
            setTimeout(function() { window.refreshMainContent(); }, 400);
        }).catch(function(error) {
            showToast(error.message || 'Failed to reopen day', 'error');
            if (button) button.disabled = false;
        });
    }

    // Reload the same sheet on a new date while preserving the commissary,
    // destination-branch and shift filters (all live in the query string).
    window.dlReloadProductionDate = function(value) {
        try {
            var url = new URL(window.location.href);
            url.searchParams.set('date', value);
            window.location.href = url.toString();
        } catch (e) {
            window.location.reload();
        }
    };

    function productionJson(url, payload) {
        if (!navigator.onLine) {
            return Promise.reject(new Error('NOT saved — no connection. Reconnect and save again.'));
        }
        return window.dlWriteTimeout(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify(payload)
        }, 'This production ledger save').then(function(response) {
            return response.json().then(function(body) {
                if (!response.ok || !body.ok) {
                    var err = new Error(body.error || 'Save failed');
                    err.body = body;
                    err.status = response.status;
                    throw err;
                }
                return body;
            });
        });
    }

    function saveProductionCount(button) {
        var input = button && button.parentNode ? button.parentNode.querySelector('.production-count-input') : null;
        if (!input) return;
        var raw = input.value.trim();
        var original = input.getAttribute('data-original') || '';
        // The suggested value is display-only. Merely opening/focusing/blurring
        // the input never reaches this explicit save path.
        var payloadValue = raw === '' ? null : parseInt(raw, 10);
        button.disabled = true;
        fetch('{base_url}/api/v1/commissary/material', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify({
                entity: 'product_count',
                date: '{date}',
                commissary_branch_id: parseInt(input.getAttribute('data-commissary-id') || '0', 10),
                product_id: parseInt(input.getAttribute('data-product-id') || '0', 10),
                actual_end_qty: payloadValue
            })
        }).then(function(r) { return r.json(); }).then(function(res) {
            if (!res.ok) throw new Error(res.error || 'Save failed');
            var persisted = res.row.actual_end_qty === null ? '' : String(res.row.actual_end_qty);
            input.setAttribute('data-original', persisted);
            var variance = input.closest('tr').querySelector('.production-variance');
            if (variance) variance.textContent = res.row.calc_variance === null ? '—' : res.row.calc_variance;
            showToast(raw === original ? 'Count confirmed' : 'Physical count saved', 'success');
        }).catch(function(err) {
            showToast(err.message || 'Save failed', 'error');
        }).finally(function() { button.disabled = false; });
    }

    function submitDispatch() {
        var btn = document.getElementById('submit-dispatch');
        var statusEl = document.getElementById('dispatch-status');
        if (!btn) return;

        var destBranchId = parseInt((document.getElementById('dispatch-dest-branch-id') || {}).value || '0', 10) || 0;
        var drNumber = ((document.getElementById('dispatch-dr-number') || {}).value || '').trim();

        if (!destBranchId) { showToast('Select a destination branch', 'error'); return; }
        if (!drNumber) { showToast('DR number is required', 'error'); return; }

        // Collect all items with quantity > 0
        var items = [];
        var inputs = document.querySelectorAll('.dispatch-qty-input');
        inputs.forEach(function(input) {
            var qty = parseInt(input.value || '0', 10) || 0;
            if (qty <= 0) return;
            var commissaryId = parseInt(input.getAttribute('data-commissary-id') || '0', 10) || 0;
            var productId = parseInt(input.getAttribute('data-product-id') || '0', 10) || 0;
            var remaining = parseInt(input.getAttribute('data-remaining') || '0', 10) || 0;
            if (commissaryId <= 0 || productId <= 0) return;
            if (qty > remaining) {
                showToast(input.getAttribute('data-product-name') + ': qty ' + qty + ' exceeds on-hand ' + remaining, 'error');
                return;
            }
            items.push({
                commissary_branch_id: commissaryId,
                product_id: productId,
                quantity: qty
            });
        });

        if (items.length === 0) {
            showToast('Enter at least one product quantity to dispatch', 'error');
            return;
        }

        // Reject source-equals-destination formal dispatch — co-located
        // commissary/storefront production must use the Internal release path.
        var selfDispatch = items.some(function(it) { return it.commissary_branch_id === destBranchId; });
        if (selfDispatch) {
            showToast('A branch cannot formally dispatch to itself. Use the Commissary Usage page for an Internal release (same location) instead.', 'error');
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Dispatching ' + items.length + ' item(s)...';
        if (statusEl) statusEl.textContent = '';

        fetch('{base_url}/api/v1/commissary/dispatch', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify({
                destination_branch_id: destBranchId,
                dr_number: drNumber,
                ledger_date: '{date}',
                items: items
            })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (!res.ok) {
                showToast(res.error || 'Dispatch failed', 'error');
                if (statusEl) statusEl.textContent = res.error || '';
                return;
            }
            var totalQty = 0;
            (res.items || []).forEach(function(i) { totalQty += (i.quantity || 0); });
            var msg = 'Dispatched ' + totalQty + ' pcs across ' + (res.expected_items || res.items.length) + ' products';
            if (res.actual_items && res.actual_items !== res.expected_items) {
                msg += ' (WARNING: expected ' + res.expected_items + ' items but DB has ' + res.actual_items + ')';
            }
            msg += ' — DR ' + res.dr_number;
            showToast(msg, 'success');
            setTimeout(function() { window.refreshMainContent(); }, 800);
        })
        .catch(function() { showToast('Network error', 'error'); })
        .finally(function() {
            btn.disabled = false;
            btn.textContent = 'Dispatch to Branch';
        });
    }
</script>

</body>
</html>
