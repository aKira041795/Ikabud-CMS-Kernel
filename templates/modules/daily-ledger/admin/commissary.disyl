{extends "modules/daily-ledger/layouts/app.disyl"}

{block head}
{/block}

{block content}
<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">Commissary</h2>
        <p class="text-sm text-gray-500">Track finished-goods output, branch dispatches, and commissary stock balance.</p>
    </div>
    <div class="text-xs text-gray-500">
        Stock balance here means bread and cakes held by commissary, not raw ingredients.
    </div>
</div>

<form class="card mb-6" method="GET" action="{base_url}/admin/commissary">
    <div class="card-body">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-3 items-end">
            <div class="form-group mb-0">
                <label class="form-label">Date</label>
                <input type="date" class="form-input" name="date" value="{date}">
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Branch</label>
                <select class="form-input" name="branch_id">
                    <option value="">All Branches</option>
                    {foreach branches as br}
                    <option value="{br.id}" {if br.id == branch_id}selected{/if}>{br.name}</option>
                    {/foreach}
                </select>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="btn btn-primary">Apply</button>
                <a class="btn btn-outline" href="{base_url}/admin/usage?date={date}">Open Usage</a>
            </div>
        </div>
    </div>
</form>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="card">
        <div class="card-body">
            <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Branch Yield</div>
            <div class="mt-2 text-3xl font-semibold text-gray-900">{summary.branch_yield_total}</div>
            <div class="mt-1 text-sm text-gray-500">Finished goods produced for branches on {date}</div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Branch Dispatches</div>
            <div class="mt-2 text-3xl font-semibold text-gray-900">{summary.branch_dispatch_total}</div>
            <div class="mt-1 text-sm text-gray-500">Direct output plus formal branch deliveries on {date}</div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Commissary On Hand</div>
            <div class="mt-2 text-3xl font-semibold text-gray-900">{summary.commissary_remaining_total}</div>
            <div class="mt-1 text-sm text-gray-500">Running finished-goods balance through {date}</div>
        </div>
    </div>
</div>

<div class="card mb-6">
    <div class="card-header">
        <span>Yield Trace By Branch</span>
        <span class="text-sm text-muted">{branch_yield_rows | count} rows</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Branch</th>
                    <th>Product</th>
                    <th class="text-right">Yield</th>
                    <th>DR #</th>
                    <th>Baker</th>
                </tr>
            </thead>
            <tbody>
                {if branch_yield_rows | count == 0}
                <tr><td colspan="6" class="px-4 py-10 text-center text-sm text-gray-500">No branch-directed yield recorded for this date.</td></tr>
                {/if}
                {foreach branch_yield_rows as row}
                <tr>
                    <td>{row.ledger_date}</td>
                    <td>{row.branch_name}</td>
                    <td>{row.product_name}</td>
                    <td class="text-right font-semibold">{row.yield_qty}</td>
                    <td class="text-sm text-muted">{row.dr_number | default:'—'}</td>
                    <td class="text-sm text-muted">{row.baker_name | default:'—'}</td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>
</div>

<div class="card mb-6">
    <div class="card-header">
        <span>Deliveries Per Branch</span>
        <span class="text-sm text-muted">{delivery_rows | count} rows</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Branch</th>
                    <th>Product</th>
                    <th class="text-right">Qty</th>
                    <th>DR #</th>
                    <th>Source</th>
                </tr>
            </thead>
            <tbody>
                {if delivery_rows | count == 0}
                <tr><td colspan="6" class="px-4 py-10 text-center text-sm text-gray-500">No commissary deliveries found for this date.</td></tr>
                {/if}
                {foreach delivery_rows as row}
                <tr>
                    <td>{row.movement_date}</td>
                    <td>{row.branch_name}</td>
                    <td>{row.product_name}</td>
                    <td class="text-right font-semibold">{row.quantity}</td>
                    <td class="text-sm text-muted">{row.dr_number | default:'—'}</td>
                    <td class="text-sm text-muted">{row.source_label}</td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <span>Finished Goods Balance</span>
        <span class="text-sm text-muted">Produced to commissary minus formal deliveries through {date}</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Product</th>
                    <th class="text-right">Produced To Commissary</th>
                    <th class="text-right">Delivered From Commissary</th>
                    <th class="text-right">Remaining</th>
                </tr>
            </thead>
            <tbody>
                {if stock_rows | count == 0}
                <tr><td colspan="4" class="px-4 py-10 text-center text-sm text-gray-500">No commissary stock balance available yet.</td></tr>
                {/if}
                {foreach stock_rows as row}
                <tr>
                    <td>{row.product_name}</td>
                    <td class="text-right">{row.produced_qty}</td>
                    <td class="text-right">{row.dispatched_qty}</td>
                    <td class="text-right font-semibold">{row.remaining_qty}</td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>
</div>
{/block}
