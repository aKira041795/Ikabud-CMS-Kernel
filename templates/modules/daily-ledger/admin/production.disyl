{extends "modules/daily-ledger/layouts/app.disyl"}

{block head}
<style>
    .print-only {
        display: none;
    }
    @media print {
        .print-hide {
            display: none !important;
        }
        .print-only {
            display: block !important;
        }
        .card {
            border: none !important;
            box-shadow: none !important;
        }
        body {
            background: #fff !important;
        }
    }
</style>
{/block}

{block content}
<div class="flex items-center justify-between mb-6">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">Production Withdrawal</h2>
        <p class="text-sm text-gray-500">Record raw material consumption for commissary production. <span class="font-semibold">This is NOT for branch pullouts</span> — branch-side adjustments are done by the cashier through Stock Adjustment.</p>
        <p class="text-xs text-gray-500 mt-1">
            Business date: <span class="font-medium text-gray-700">{business_date_label}</span>
            · Timezone: <span class="font-medium text-gray-700">{operating_timezone}</span>
            · Region: <span class="font-medium text-gray-700">{operating_region}</span>
        </p>
        <div class="mt-2">
            <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800 ring-1 ring-inset ring-amber-300">
                Cutoff: {close_of_day_time}
            </span>
        </div>
    </div>
    <button type="button" class="btn btn-outline print-hide" onclick="printProductionLedger()">Print</button>
</div>

<div class="mb-6 grid gap-3 lg:grid-cols-3">
    <a href="{base_url}/admin/production-output" class="rounded-lg border border-emerald-200 bg-emerald-50 p-4 hover:border-emerald-300 hover:bg-emerald-100">
        <div class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Upstream</div>
        <div class="mt-1 text-sm font-semibold text-emerald-900">1. Production Output</div>
        <p class="mt-1 text-xs leading-5 text-emerald-800">Start upstream with output so the branch flow and DR are already established before withdrawal.</p>
    </a>
    <a href="{base_url}/admin/deliveries" class="rounded-lg border border-slate-200 bg-slate-50 p-4 hover:border-slate-300 hover:bg-slate-100">
        <div class="text-xs font-semibold uppercase tracking-wide text-slate-600">Bridge</div>
        <div class="mt-1 text-sm font-semibold text-slate-900">2. Transfer Records</div>
        <p class="mt-1 text-xs leading-5 text-slate-700">Check or fix the DR record in the middle so the downstream branch step has the same DR context.</p>
    </a>
    <a href="{base_url}/admin/production" class="rounded-lg border border-indigo-200 bg-indigo-50 p-4 ring-1 ring-inset ring-indigo-200">
        <div class="text-xs font-semibold uppercase tracking-wide text-indigo-700">Downstream</div>
        <div class="mt-1 text-sm font-semibold text-indigo-900">3. Production Withdrawal</div>
        <p class="mt-1 text-xs leading-5 text-indigo-800">This is the downstream step. Encode branch withdrawal only after output upstream and delivery handoff are already aligned.</p>
    </a>
</div>

{if can_production_output}
<div class="card mb-6">
    <div class="card-header">
        <span>Withdrawal Entry</span>
        <span class="text-sm text-muted">Select branch, then enter qty per product</span>
    </div>
    <div class="card-body">
        {if branches | count == 0}
        <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            No branch assignment found for this account.
        </div>
        {/if}

        {if branches | count > 0}
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-4 mb-4">
            <div class="form-group mb-0">
                <label class="form-label">Branch</label>
                <select id="wd-branch-id" class="form-input font-semibold">
                    <option value="">-- Select Branch --</option>
                    {foreach branches as br}
                    <option value="{br.id}">{br.name} ({br.code}){if br.area} · {br.area}{/if}</option>
                    {/foreach}
                </select>
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Ledger Date</label>
                <input type="date" id="wd-ledger-date" class="form-input" value="{ledger_date}">
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Reason</label>
                <input type="text" id="wd-reason" class="form-input" placeholder="Optional withdrawal note">
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Delivery Receipt #</label>
                <input type="text" id="wd-dr-number" class="form-input" placeholder="Required and must match an existing branch delivery DR">
            </div>
        </div>

        <div class="border-b border-gray-200 mb-0">
            <nav class="flex gap-0 -mb-px">
                <button type="button" id="wd-tab-bread" onclick="switchWithdrawalTab('bread')"
                    class="px-4 py-2 text-sm font-medium border-b-2 border-indigo-500 text-indigo-600">Bread</button>
                <button type="button" id="wd-tab-cake" onclick="switchWithdrawalTab('cake')"
                    class="px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700">Cakes</button>
            </nav>
        </div>

        <div class="table-wrap mb-4">
            <table>
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th class="text-center">Yield Profile</th>
                        <th class="px-2 text-left">Qty (pcs)</th>
                    </tr>
                </thead>
                <tbody id="wd-tbody-bread" class="divide-y divide-gray-100">
                    {foreach product_rows_bread as p}
                    <tr data-pid="{p.id}" data-oppb="{p.output_pieces_per_batch | default:0}">
                        <td class="font-medium">{p.name}</td>
                        <td class="font-mono text-sm text-muted">{p.sku}</td>
                        <td class="text-center text-sm text-muted">
                            {if p.output_pieces_per_batch > 0}1 batch = {p.output_pieces_per_batch} {p.output_unit_label | default:'pcs'}{/if}
                            {if p.output_pieces_per_batch <= 0}<span class="text-xs text-amber-500">No profile</span>{/if}
                        </td>
                        <td class="px-2 py-1 text-right">
                            <input type="number" min="0" step="1" class="form-input text-right wd-qty-input w-28"
                                id="wd-qty-{p.id}" value="" placeholder="0">
                        </td>
                    </tr>
                    {/foreach}
                    {if product_rows_bread | count == 0}
                    <tr><td colspan="4" class="px-4 py-6 text-center text-sm text-gray-500">No bread products configured.</td></tr>
                    {/if}
                </tbody>
                <tbody id="wd-tbody-cake" class="divide-y divide-gray-100 hidden">
                    {foreach product_rows_cake as p}
                    <tr data-pid="{p.id}" data-oppb="{p.output_pieces_per_batch | default:0}">
                        <td class="font-medium">{p.name}</td>
                        <td class="font-mono text-sm text-muted">{p.sku}</td>
                        <td class="text-center text-sm text-muted">
                            {if p.output_pieces_per_batch > 0}1 batch = {p.output_pieces_per_batch} {p.output_unit_label | default:'pcs'}{/if}
                            {if p.output_pieces_per_batch <= 0}<span class="text-xs text-amber-500">No profile</span>{/if}
                        </td>
                        <td class="px-2 py-1 text-right">
                            <input type="number" min="0" step="1" class="form-input text-right wd-qty-input w-28"
                                id="wd-qty-{p.id}" value="" placeholder="0">
                        </td>
                    </tr>
                    {/foreach}
                    {if product_rows_cake | count == 0}
                    <tr><td colspan="4" class="px-4 py-6 text-center text-sm text-gray-500">No cake products configured.</td></tr>
                    {/if}
                </tbody>
            </table>
        </div>

        <div class="flex items-center justify-end gap-2">
            <button type="button" class="btn btn-outline" onclick="resetWithdrawals()">Reset</button>
            <button type="button" class="btn btn-primary" id="submit-withdrawals" onclick="submitWithdrawalsByRow()">Submit Withdrawals</button>
        </div>
        {/if}
    </div>
</div>
{/if}

{if !can_production_output}
<div class="card mb-6">
    <div class="card-body">
        <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            Production Withdrawal (batch-count mode) is disabled. Ask the Settings Admin (superadmin) to activate it from Feature Settings.
        </div>
    </div>
</div>
{/if}

<form class="card mb-6" action="{base_url}/admin/production" method="GET">
    <div class="card-body">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-4 items-end">
            <div class="form-group mb-0">
                <label class="form-label">From</label>
                <input type="date" class="form-input" name="date_from" value="{date_from}">
            </div>
            <div class="form-group mb-0">
                <label class="form-label">To</label>
                <input type="date" class="form-input" name="date_to" value="{date_to}">
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Ledger Date</label>
                <input type="date" class="form-input" name="ledger_date" value="{ledger_date}">
            </div>
            <button type="submit" class="btn btn-outline">Refresh History</button>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-header">
        <span>Recent Production Movements</span>
        <span class="text-sm text-muted">{movement_rows | count} rows</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Created</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Area</th>
                    <th>Branch</th>
                    <th>Product</th>
                    <th>Flow</th>
                    <th class="text-right">Qty</th>
                    <th>DR #</th>
                    <th>Reason</th>
                    <th>Actor</th>
                </tr>
            </thead>
            <tbody>
                {if movement_rows | count == 0}
                <tr><td colspan="11" class="px-4 py-10 text-center text-sm text-gray-500">No production movement history in selected range.</td></tr>
                {/if}
                {foreach movement_rows as row}
                <tr data-movement-type="{row.movement_type}">
                    <td>{row.created_at}</td>
                    <td>{row.ledger_date}</td>
                    <td>
                        <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset
                            {if row.movement_type == 'withdrawal'}bg-indigo-50 text-indigo-700 ring-indigo-200{/if}
                            {if row.movement_type == 'output'}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}
                            {if row.movement_type == 'reverse'}bg-rose-50 text-rose-700 ring-rose-200{/if}
                        ">{row.movement_type}</span>
                        {if row.movement_type == 'withdrawal' && row.has_reverse}
                        <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset bg-amber-50 text-amber-700 ring-amber-200 ml-1">Overridden</span>
                        {/if}
                    </td>
                    <td>{row.destination_name} <span class="text-muted">({row.destination_code})</span></td>
                    <td class="text-sm text-muted">{row.destination_area}</td>
                    <td>{row.product_name} <span class="text-muted">({row.sku})</span></td>
                    <td>{row.flow_mode}</td>
                    <td class="text-right font-semibold">{row.quantity}</td>
                    <td class="text-sm text-muted">{row.dr_number | default:'—'}</td>
                    <td class="text-sm text-muted">{row.override_reason}</td>
                    <td class="text-sm text-muted">
                        <div>{row.created_by_role}</div>
                        {if can_production_override && row.movement_type == 'withdrawal' && !row.has_reverse}
                        <button
                            type="button"
                            class="btn btn-sm btn-outline mt-2 print-hide"
                            data-movement-id="{row.id}"
                            data-branch-id="{row.destination_branch_id}"
                            data-product-id="{row.product_id}"
                            data-ledger-date="{row.ledger_date}"
                            data-quantity="{row.quantity}"
                            data-flow-mode="{row.flow_mode}"
                            data-dr-number="{row.dr_number | default:''}"
                            onclick="openOverrideModalFromButton(this)"
                        >
                            Override
                        </button>
                        {/if}
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>
</div>

<div class="modal-overlay" id="override-modal">
    <div class="modal">
        <h3>Admin Override Withdrawal</h3>
        <p class="text-sm text-gray-500 mb-4">This will reverse the selected withdrawal, then submit a corrected withdrawal value.</p>
        <input type="hidden" id="ov-movement-id">
        <input type="hidden" id="ov-branch-id">
        <input type="hidden" id="ov-product-id">
        <input type="hidden" id="ov-ledger-date">
        <input type="hidden" id="ov-flow-mode">
        <input type="hidden" id="ov-dr-number">

        <div class="form-group">
            <label class="form-label">Original Quantity</label>
            <input type="number" class="form-input" id="ov-original-qty" readonly>
        </div>
        <div class="form-group">
            <label class="form-label">Corrected Quantity</label>
            <input type="number" min="1" step="1" class="form-input" id="ov-corrected-qty" placeholder="Enter corrected withdrawal quantity">
        </div>
        <div class="form-group mb-0">
            <label class="form-label">Override Reason</label>
            <input type="text" class="form-input" id="ov-reason" placeholder="Required reason for override">
        </div>

        <div class="modal-actions">
            <button type="button" class="btn btn-outline" onclick="closeOverrideModal()">Cancel</button>
            <button type="button" class="btn btn-primary" id="ov-submit-btn" onclick="submitOverrideMovement()">Apply Override</button>
        </div>
    </div>
</div>
{/block}

{block scripts}
<script>
    function switchWithdrawalTab(tab) {
        var breadBody = document.getElementById('wd-tbody-bread');
        var cakeBody  = document.getElementById('wd-tbody-cake');
        var tabBread  = document.getElementById('wd-tab-bread');
        var tabCake   = document.getElementById('wd-tab-cake');
        if (tab === 'bread') {
            if (breadBody) breadBody.classList.remove('hidden');
            if (cakeBody)  cakeBody.classList.add('hidden');
            if (tabBread) { tabBread.classList.add('border-indigo-500', 'text-indigo-600'); tabBread.classList.remove('border-transparent', 'text-gray-500'); }
            if (tabCake)  { tabCake.classList.remove('border-indigo-500', 'text-indigo-600'); tabCake.classList.add('border-transparent', 'text-gray-500'); }
        } else {
            if (cakeBody)  cakeBody.classList.remove('hidden');
            if (breadBody) breadBody.classList.add('hidden');
            if (tabCake)  { tabCake.classList.add('border-indigo-500', 'text-indigo-600'); tabCake.classList.remove('border-transparent', 'text-gray-500'); }
            if (tabBread) { tabBread.classList.remove('border-indigo-500', 'text-indigo-600'); tabBread.classList.add('border-transparent', 'text-gray-500'); }
        }
    }

    function resetWithdrawals() {
        document.querySelectorAll('.wd-qty-input').forEach(function(el) {
            el.value = '';
        });
    }

    function submitWithdrawalsByRow() {
        var btn = document.getElementById('submit-withdrawals');
        if (!btn) return;
        var branchId   = parseInt((document.getElementById('wd-branch-id')   || {}).value || '0', 10) || 0;
        var ledgerDate = (document.getElementById('wd-ledger-date') || {}).value || '';
        var flowMode   = 'production';
        var reason     = ((document.getElementById('wd-reason')     || {}).value || '').trim();
        var drNumber   = ((document.getElementById('wd-dr-number')  || {}).value || '').trim();

        if (!branchId)   { showToast('Select a branch first', 'error'); return; }
        if (!ledgerDate) { showToast('Ledger date is required', 'error'); return; }

        var operations = [];
        var now = Date.now();
        var idx = 0;
        document.querySelectorAll('tr[data-pid]').forEach(function(row) {
            var pid  = parseInt(row.getAttribute('data-pid'), 10) || 0;
            if (!pid) return;
            var qtyEl   = document.getElementById('wd-qty-'   + pid);
            var qty = 0;
            if (qtyEl && qtyEl.value !== '' && parseFloat(qtyEl.value) > 0) {
                qty = Math.round(parseFloat(qtyEl.value));
            }
            if (qty <= 0) return;
            operations.push({
                type: 'withdrawal',
                destination_branch_id: branchId,
                product_id: pid,
                ledger_date: ledgerDate,
                quantity: qty,
                flow_mode: flowMode,
                dr_number: drNumber,
                reason: reason,
                client_op_id: 'wd-' + now + '-' + pid + '-' + (idx++)
            });
        });

        if (operations.length === 0) {
            showToast('Enter at least one product quantity greater than 0', 'error');
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Submitting...';

        fetch('{base_url}/api/v1/production/sync-batch', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify({ operations: operations })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (!res.ok) {
                showToast(res.error || 'Failed to submit withdrawals', 'error');
                return;
            }
            var summary = res.summary || { succeeded: 0, failed: 0 };
            var msg = 'Withdrawals synced: ' + summary.succeeded + ' success';
            if (summary.failed > 0) msg += ', ' + summary.failed + ' failed';
            showToast(msg, summary.failed > 0 ? 'error' : 'success');
            setTimeout(function() { window.refreshMainContent(); }, 700);
        })
        .catch(function() {
            showToast('Network error while submitting withdrawals', 'error');
        })
        .finally(function() {
            btn.disabled = false;
            btn.textContent = 'Submit Withdrawals';
        });
    }

    function printProductionLedger() {
        var rows = Array.from(document.querySelectorAll('tr[data-movement-type="withdrawal"]'));
        if (rows.length === 0) {
            showToast('No withdrawal movement rows to print in current range.', 'error');
            return;
        }

        var printedAt = new Date().toLocaleString();
        var htmlRows = rows.map(function(row) {
            var cells = row.querySelectorAll('td');
            if (!cells || cells.length < 11) return '';
            return '<tr>' +
                '<td>' + cells[0].textContent.trim() + '</td>' +
                '<td>' + cells[1].textContent.trim() + '</td>' +
                '<td>' + cells[3].textContent.trim() + '</td>' +
                '<td>' + cells[4].textContent.trim() + '</td>' +
                '<td style="text-align:right;">' + cells[7].textContent.trim() + '</td>' +
                '<td>' + cells[8].textContent.trim() + '</td>' +
                '<td>' + cells[9].textContent.trim() + '</td>' +
                '<td>' + cells[10].textContent.trim() + '</td>' +
                '</tr>';
        }).join('');

        var reportHtml = '<!doctype html><html><head><meta charset="utf-8">' +
            '<title>Production Withdrawal Report</title>' +
            '<style>' +
{literal}            'body{font-family:Arial,sans-serif;color:#111827;margin:24px;}' +
            'h1{font-size:20px;margin:0 0 8px;}' +
            '.meta{font-size:13px;color:#374151;margin:2px 0;}' +
            'table{width:100%;border-collapse:collapse;margin-top:16px;}' +
            'th,td{border:1px solid #d1d5db;padding:8px;font-size:12px;vertical-align:top;}' +
            'th{background:#f3f4f6;text-align:left;}' +
            '.right{text-align:right;}' +
{/literal}            '</style></head><body>' +
            '<h1>Production Withdrawal Report</h1>' +
            '<div class="meta">Ledger Date: {ledger_date}</div>' +
            '<div class="meta">History Range: {date_from} to {date_to}</div>' +
            '<div class="meta">Prepared By: {user_name} ({user_role})</div>' +
            '<div class="meta">Printed At: ' + printedAt + '</div>' +
            '<table><thead><tr>' +
            '<th>Created</th><th>Date</th><th>Branch</th><th>Product</th><th class="right">Qty</th><th>DR #</th><th>Reason</th><th>Actor</th>' +
            '</tr></thead><tbody>' + htmlRows + '</tbody></table>' +
            '</body></html>';

        var w = window.open('', '_blank', 'width=1024,height=768');
        if (!w) {
            showToast('Popup blocked. Please allow popups for printing.', 'error');
            return;
        }
        w.document.open();
        w.document.write(reportHtml);
        w.document.close();
        w.focus();
        w.print();
    }

    function openOverrideModalFromButton(button) {
        if (!button) return;
        openOverrideModal(
            parseInt(button.getAttribute('data-movement-id') || '0', 10) || 0,
            parseInt(button.getAttribute('data-branch-id') || '0', 10) || 0,
            parseInt(button.getAttribute('data-product-id') || '0', 10) || 0,
            button.getAttribute('data-ledger-date') || '',
            parseInt(button.getAttribute('data-quantity') || '0', 10) || 0,
            button.getAttribute('data-flow-mode') || 'production',
            button.getAttribute('data-dr-number') || ''
        );
    }

    function openOverrideModal(movementId, branchId, productId, ledgerDate, quantity, flowMode, drNumber) {
        document.getElementById('ov-movement-id').value = movementId;
        document.getElementById('ov-branch-id').value = branchId;
        document.getElementById('ov-product-id').value = productId;
        document.getElementById('ov-ledger-date').value = ledgerDate;
        document.getElementById('ov-flow-mode').value = flowMode || 'production';
        document.getElementById('ov-dr-number').value = drNumber || '';
        document.getElementById('ov-original-qty').value = quantity;
        document.getElementById('ov-corrected-qty').value = quantity;
        document.getElementById('ov-reason').value = '';
        document.getElementById('override-modal').classList.add('show');
        document.getElementById('ov-corrected-qty').focus();
    }

    function closeOverrideModal() {
        document.getElementById('override-modal').classList.remove('show');
    }

    function submitOverrideMovement() {
        var submitBtn = document.getElementById('ov-submit-btn');
        var movementId = parseInt(document.getElementById('ov-movement-id').value, 10) || 0;
        var branchId = parseInt(document.getElementById('ov-branch-id').value, 10) || 0;
        var productId = parseInt(document.getElementById('ov-product-id').value, 10) || 0;
        var ledgerDate = document.getElementById('ov-ledger-date').value || '';
        var flowMode = document.getElementById('ov-flow-mode').value || 'production';
        var drNumber = (document.getElementById('ov-dr-number').value || '').trim();
        var correctedQty = parseInt(document.getElementById('ov-corrected-qty').value, 10) || 0;
        var reason = (document.getElementById('ov-reason').value || '').trim();

        if (!movementId || !branchId || !productId || !ledgerDate) {
            showToast('Invalid override context', 'error');
            return;
        }
        if (correctedQty <= 0) {
            showToast('Corrected quantity must be greater than 0', 'error');
            return;
        }
        if (!reason) {
            showToast('Override reason is required', 'error');
            return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Applying...';

        var reversePayload = {
            reference_movement_id: movementId,
            destination_branch_id: branchId,
            product_id: productId,
            ledger_date: ledgerDate,
            quantity: correctedQty,
            flow_mode: flowMode,
            dr_number: drNumber,
            reason: reason,
            client_op_id: 'ovr-rev-' + movementId + '-' + Date.now()
        };

        fetch('{base_url}/api/v1/production/reverse', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify(reversePayload)
        })
        .then(function(r) { return r.json(); })
        .then(function(reverseRes) {
            if (!reverseRes.ok) {
                throw new Error(reverseRes.error || 'Reverse failed');
            }

            var withdrawalPayload = {
                destination_branch_id: branchId,
                product_id: productId,
                ledger_date: ledgerDate,
                quantity: correctedQty,
                flow_mode: flowMode,
                dr_number: drNumber,
                reason: reason,
                client_op_id: 'ovr-new-' + movementId + '-' + Date.now()
            };

            return fetch('{base_url}/api/v1/production/withdrawal', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': (window.DL_CSRF || ''),
                    'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
                },
                body: JSON.stringify(withdrawalPayload)
            });
        })
        .then(function(r) { return r.json(); })
        .then(function(withdrawRes) {
            if (!withdrawRes.ok) {
                throw new Error(withdrawRes.error || 'Corrected withdrawal failed');
            }

            closeOverrideModal();
            showToast('Override applied successfully', 'success');
            setTimeout(function() { window.refreshMainContent(); }, 700);
        })
        .catch(function(err) {
            showToast(err.message || 'Override failed', 'error');
        })
        .finally(function() {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Apply Override';
        });
    }

    document.getElementById('override-modal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeOverrideModal();
        }
    });

</script>
{/block}
