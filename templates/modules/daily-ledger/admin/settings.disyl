{extends "modules/daily-ledger/layouts/app.disyl"}

{block content}
<div class="flex items-center justify-between mb-6">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">Daily Ledger Settings</h2>
        <p class="text-sm text-gray-500">Manage close-of-day timing and override capabilities. Admin permissions are always enabled.</p>
    </div>
</div>

<div class="card mb-6">
    <div class="card-header">
        <span>Close of Day</span>
        <span class="text-sm text-muted">Cashier and Production</span>
    </div>
    <div class="card-body">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div class="form-group mb-0">
                <label class="form-label">Operating Region</label>
                <select id="operating-region" class="form-input">
                    {foreach operating_region_choices as region}
                    <option value="{region}" {if region == operating_region}selected{/if}>{region}</option>
                    {/foreach}
                </select>
                <p class="mt-2 text-sm text-gray-500">Informational label shown on Daily Ledger screens.</p>
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Operating Timezone</label>
                <select id="operating-timezone" class="form-input">
                    {foreach operating_timezone_choices as tz}
                    <option value="{tz}" {if tz == operating_timezone}selected{/if}>{tz}</option>
                    {/foreach}
                </select>
                <p class="mt-2 text-sm text-gray-500">Used for business-date and auto-close cutoff calculations.</p>
            </div>
            <div>
                <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" id="auto-close-enabled" {if auto_close_enabled}checked{/if} onchange="toggleCloseOfDayTime()">
                    Enable automatic close of day
                </label>
                <p class="mt-2 text-sm text-gray-500">When enabled, the app rolls to the next business day after the configured cutoff and auto-closes the previous day on the next request.</p>
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Cutoff Time</label>
                <input type="time" id="close-of-day-time" class="form-input" value="{close_of_day_time}">
                <p class="mt-2 text-sm text-gray-500">Entries before the cutoff are treated as the previous business day. Auto close only allows overnight cutoff times from 00:00 to 11:59 to prevent same-day closure.</p>
                <div class="mt-3">
                    <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800 ring-1 ring-inset ring-amber-300" id="cutoff-badge-preview">
                        Cutoff: {close_of_day_time}
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-6">
    <div class="card-header">
        <span>Feature Activation</span>
        <span class="text-sm text-muted">Admin / Superadmin Control</span>
    </div>
    <div class="card-body">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div>
                <p class="text-sm text-gray-700 font-medium">Production Output (Batch Count / Option A)</p>
                <p class="mt-1 text-sm text-gray-500">Controls whether output movement posting is enabled for the production page and output APIs.</p>
            </div>
            <div>
                {if is_kernel_admin}
                <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" id="feature-production-output" {if production_output_enabled}checked{/if}>
                    Enable production output feature
                </label>
                <p class="mt-2 text-sm text-gray-500">You are signed in as Admin/Superadmin, so this activation switch is editable.</p>
                {/if}
                {if !is_kernel_admin}
                <div class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset {if production_output_enabled}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}{if !production_output_enabled}bg-gray-100 text-gray-700 ring-gray-300{/if}">
                    Production Output is {if production_output_enabled}Enabled{/if}{if !production_output_enabled}Disabled{/if}
                </div>
                <p class="mt-2 text-sm text-gray-500">Only Admin or Superadmin can change feature activation.</p>
                {/if}
            </div>
        </div>
    </div>
</div>

<div class="card mb-6">
    <div class="card-header">
        <span>Override Permissions</span>
        <span class="text-sm text-muted">Daily Ledger</span>
    </div>
    <div class="card-body">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Role</th>
                        <th>Ledger Override</th>
                        <th>Production Override</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="font-medium">Admin</td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" checked disabled>
                                Always allowed
                            </label>
                        </td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" checked disabled>
                                Always allowed
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td class="font-medium">Supervisor</td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" id="perm-supervisor-ledger" {if perm_supervisor_ledger_override}checked{/if}>
                                Allow reopen/override cashier day
                            </label>
                        </td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" id="perm-supervisor-production" {if perm_supervisor_production_override}checked{/if}>
                                Allow production reverse/override
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td class="font-medium">Production in-charge</td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" id="perm-prod-ledger" {if perm_prod_ledger_override}checked{/if}>
                                Allow ledger override
                            </label>
                        </td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" id="perm-prod-production" {if perm_prod_production_override}checked{/if}>
                                Allow production reverse/override
                            </label>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="mt-6 flex justify-end">
            <button type="button" class="btn btn-primary" id="save-perm-btn" onclick="saveRolePermissions()">Save Settings</button>
        </div>
    </div>
</div>
{/block}

{block scripts}
<script>
    function toggleCloseOfDayTime() {
        // Keep cutoff time editable even when auto-close is off,
        // so admins can preconfigure the value before enabling it.
    }

    function updateCutoffBadgePreview() {
        var val = document.getElementById('close-of-day-time').value || '00:00';
        document.getElementById('cutoff-badge-preview').textContent = 'Cutoff: ' + val;
    }

    function saveRolePermissions() {
        var btn = document.getElementById('save-perm-btn');
        var autoCloseEnabled = document.getElementById('auto-close-enabled').checked;
        var closeOfDayTime = document.getElementById('close-of-day-time').value || '00:00';
        var closeHour = parseInt(closeOfDayTime.split(':')[0], 10);

        if (autoCloseEnabled && (isNaN(closeHour) || closeHour < 0 || closeHour > 11)) {
            showToast('Auto close cutoff must be an overnight time between 00:00 and 11:59.', 'error');
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Saving...';

        var payload = {
            operating_region: document.getElementById('operating-region').value,
            operating_timezone: document.getElementById('operating-timezone').value,
            auto_close_enabled: autoCloseEnabled,
            close_of_day_time: closeOfDayTime,
            supervisor_ledger_override: document.getElementById('perm-supervisor-ledger').checked,
            supervisor_production_override: document.getElementById('perm-supervisor-production').checked,
            prod_ledger_override: document.getElementById('perm-prod-ledger').checked,
            prod_production_override: document.getElementById('perm-prod-production').checked
        };

        var featureOutputToggle = document.getElementById('feature-production-output');
        if (featureOutputToggle) {
            payload.production_output_enabled = featureOutputToggle.checked;
        }

        fetch('{base_url}/api/v1/admin/settings/permissions', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify(payload)
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (!res.ok) {
                throw new Error(res.error || 'Failed to save settings');
            }
            showToast('Settings updated', 'success');
            setTimeout(function() { window.location.reload(); }, 500);
        })
        .catch(function(err) {
            showToast(err.message || 'Failed to save settings', 'error');
        })
        .finally(function() {
            btn.disabled = false;
            btn.textContent = 'Save Settings';
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        var cutoffInput = document.getElementById('close-of-day-time');
        if (cutoffInput) {
            cutoffInput.addEventListener('input', updateCutoffBadgePreview);
            updateCutoffBadgePreview();
        }
    });
</script>
{/block}
