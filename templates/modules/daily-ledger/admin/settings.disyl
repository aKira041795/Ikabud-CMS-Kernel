{extends "modules/daily-ledger/layouts/app.disyl"}

{block content}
<div class="flex items-center justify-between mb-6">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">Daily Ledger Settings</h2>
        <p class="text-sm text-gray-500">Manage close-of-day timing and override capabilities. Admin permissions are always enabled.</p>
    </div>
</div>

<div class="card mb-6">
    <div class="card-header">
        <span>Branding</span>
        <span class="text-sm text-muted">Appearance</span>
    </div>
    <div class="card-body">
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,360px),minmax(0,1fr)]">
            <div class="form-group mb-0">
                <label class="form-label" for="app-name">App Name</label>
                <input type="text" id="app-name" class="form-input" value="{app_name}" maxlength="80" placeholder="Daily Ledger">
                <p class="mt-2 text-sm text-gray-500">Display name shown on the login page and throughout the app.</p>
            </div>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <h3 class="text-sm font-semibold text-slate-900">Logo</h3>
                            <p class="mt-1 text-sm text-slate-500">Used on the login screen and in the Daily Ledger sidebar.</p>
                        </div>
                        <div id="logo-preview" class="flex h-16 w-20 items-center justify-center rounded-xl bg-white ring-1 ring-slate-200">
                            {if logo_url}
                            <img src="{logo_url}" alt="{app_name} logo" class="max-h-12 w-auto object-contain">
                            {/if}
                            {if !logo_url}
                            <span class="text-[11px] font-medium uppercase tracking-[0.18em] text-slate-400">No logo</span>
                            {/if}
                        </div>
                    </div>
                    <label class="form-label mt-4" for="logo-url">Logo URL</label>
                    <input type="text" id="logo-url" class="form-input" value="{logo_url}" placeholder="/uploads/daily-ledger/... or https://...">
                    <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center">
                        <input type="file" id="logo-file" class="block w-full text-sm text-slate-600" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml">
                        <button type="button" class="btn btn-outline whitespace-nowrap" id="logo-upload-btn" onclick="uploadBrandAsset('logo')">Upload Logo</button>
                    </div>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <h3 class="text-sm font-semibold text-slate-900">Favicon</h3>
                            <p class="mt-1 text-sm text-slate-500">Used in browser tabs across Daily Ledger pages.</p>
                        </div>
                        <div id="favicon-preview" class="flex h-16 w-16 items-center justify-center rounded-xl bg-white ring-1 ring-slate-200">
                            {if favicon_url}
                            <img src="{favicon_url}" alt="{app_name} favicon" class="h-10 w-10 rounded-lg object-contain">
                            {/if}
                            {if !favicon_url}
                            <span class="text-[11px] font-medium uppercase tracking-[0.18em] text-slate-400">Default</span>
                            {/if}
                        </div>
                    </div>
                    <label class="form-label mt-4" for="favicon-url">Favicon URL</label>
                    <input type="text" id="favicon-url" class="form-input" value="{favicon_url}" placeholder="/uploads/daily-ledger/... or https://...">
                    <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center">
                        <input type="file" id="favicon-file" class="block w-full text-sm text-slate-600" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml,image/x-icon,.ico">
                        <button type="button" class="btn btn-outline whitespace-nowrap" id="favicon-upload-btn" onclick="uploadBrandAsset('favicon')">Upload Favicon</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="card mb-6">
    <div class="card-header">
        <span>Close of Day</span>
        <span class="text-sm text-muted">Cashier and Production</span>
    </div>
    <div class="card-body">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div class="form-group mb-0">
                <label class="form-label">Operating Region</label>
                <select id="operating-region" class="form-input">
                    {foreach operating_region_choices as region}
                    <option value="{region}" {if region == operating_region}selected{/if}>{region}</option>
                    {/foreach}
                </select>
                <p class="mt-2 text-sm text-gray-500">Informational label shown on Daily Ledger screens.</p>
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Operating Timezone</label>
                <select id="operating-timezone" class="form-input">
                    {foreach operating_timezone_choices as tz}
                    <option value="{tz}" {if tz == operating_timezone}selected{/if}>{tz}</option>
                    {/foreach}
                </select>
                <p class="mt-2 text-sm text-gray-500">Used for business-date and auto-close cutoff calculations.</p>
            </div>
            <div>
                <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" id="auto-close-enabled" {if auto_close_enabled}checked{/if} onchange="toggleCloseOfDayTime()">
                    Enable automatic close of day
                </label>
                <p class="mt-2 text-sm text-gray-500">When enabled, the app rolls to the next business day after the configured cutoff and auto-closes the previous day on the next request.</p>
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Cutoff Time</label>
                <input type="time" id="close-of-day-time" class="form-input" value="{close_of_day_time}">
                <p class="mt-2 text-sm text-gray-500">Entries before the cutoff are treated as the previous business day. Auto close only allows overnight cutoff times from 00:00 to 11:59 to prevent same-day closure.</p>
                <div class="mt-3">
                    <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800 ring-1 ring-inset ring-amber-300" id="cutoff-badge-preview">
                        Cutoff: {close_of_day_time}
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-6">
    <div class="card-header">
        <span>Feature Activation</span>
        <span class="text-sm text-muted">Admin / Superadmin Control</span>
    </div>
    <div class="card-body">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div>
                <p class="text-sm text-gray-700 font-medium">Production Output (Batch Count / Option A)</p>
                <p class="mt-1 text-sm text-gray-500">Controls whether output movement posting is enabled for the production page and output APIs.</p>
            </div>
            <div>
                {if can_manage_feature_activation}
                <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" id="feature-production-output" {if production_output_enabled}checked{/if}>
                    Enable production output feature
                </label>
                <p class="mt-2 text-sm text-gray-500">You are signed in as Admin/Superadmin, so this activation switch is editable.</p>
                {/if}
                {if !can_manage_feature_activation}
                <div class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset {if production_output_enabled}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}{if !production_output_enabled}bg-gray-100 text-gray-700 ring-gray-300{/if}">
                    Production Output is {if production_output_enabled}Enabled{/if}{if !production_output_enabled}Disabled{/if}
                </div>
                <p class="mt-2 text-sm text-gray-500">Only Admin or Superadmin can change feature activation.</p>
                {/if}
            </div>
        </div>

        <div class="mt-6 border-t border-gray-200 pt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
            <div>
                <p class="text-sm text-gray-700 font-medium">Formal Delivery Workflow (Phase B)</p>
                <p class="mt-1 text-sm text-gray-500">Two-step commissary → branch deliveries with receivings + variance flags. When OFF, deliveries fall back to the legacy direct-push behavior.</p>
            </div>
            <div>
                {if can_manage_feature_activation}
                <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" id="feature-formal-delivery" {if formal_delivery_workflow_enabled}checked{/if}>
                    Enable formal delivery + receiving workflow
                </label>
                {/if}
                {if !can_manage_feature_activation}
                <div class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset {if formal_delivery_workflow_enabled}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}{if !formal_delivery_workflow_enabled}bg-gray-100 text-gray-700 ring-gray-300{/if}">
                    Formal Delivery is {if formal_delivery_workflow_enabled}Enabled{/if}{if !formal_delivery_workflow_enabled}Disabled{/if}
                </div>
                {/if}
            </div>

            <div>
                <p class="text-sm text-gray-700 font-medium">Price Groups (Phase D)</p>
                <p class="mt-1 text-sm text-gray-500">Independent price tiers (Default, Mall, Wholesale). Resolution always falls back to <code>current_price</code> when OFF or unmapped.</p>
            </div>
            <div>
                {if can_manage_feature_activation}
                <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" id="feature-price-groups" {if price_groups_enabled}checked{/if}>
                    Enable price groups
                </label>
                {/if}
                {if !can_manage_feature_activation}
                <div class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset {if price_groups_enabled}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}{if !price_groups_enabled}bg-gray-100 text-gray-700 ring-gray-300{/if}">
                    Price Groups {if price_groups_enabled}Enabled{/if}{if !price_groups_enabled}Disabled{/if}
                </div>
                {/if}
            </div>

            <div>
                <p class="text-sm text-gray-700 font-medium">Selling Accounts (Phase E)</p>
                <p class="mt-1 text-sm text-gray-500">Per-branch sub-ledgers (consignment carts, kiosks, resellers) with their own day open/close cycles. Existing branch ledgers are unaffected when OFF.</p>
            </div>
            <div>
                {if can_manage_feature_activation}
                <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" id="feature-selling-accounts" {if selling_accounts_enabled}checked{/if}>
                    Enable selling accounts
                </label>
                {/if}
                {if !can_manage_feature_activation}
                <div class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset {if selling_accounts_enabled}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}{if !selling_accounts_enabled}bg-gray-100 text-gray-700 ring-gray-300{/if}">
                    Selling Accounts {if selling_accounts_enabled}Enabled{/if}{if !selling_accounts_enabled}Disabled{/if}
                </div>
                {/if}
            </div>
        </div>
    </div>
</div>

<div class="card mb-6">
    <div class="card-header">
        <span>Override Permissions</span>
        <span class="text-sm text-muted">Daily Ledger</span>
    </div>
    <div class="card-body">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Role</th>
                        <th>Ledger Override</th>
                        <th>Production Override</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="font-medium">Admin</td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" checked disabled>
                                Always allowed
                            </label>
                        </td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" checked disabled>
                                Always allowed
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td class="font-medium">Supervisor</td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" id="perm-supervisor-ledger" {if perm_supervisor_ledger_override}checked{/if}>
                                Allow reopen/override cashier day
                            </label>
                        </td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" id="perm-supervisor-production" {if perm_supervisor_production_override}checked{/if}>
                                Allow production reverse/override
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td class="font-medium">Production in-charge</td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" id="perm-prod-ledger" {if perm_prod_ledger_override}checked{/if}>
                                Allow ledger override
                            </label>
                        </td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" id="perm-prod-production" {if perm_prod_production_override}checked{/if}>
                                Allow production reverse/override
                            </label>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="mt-6 flex justify-end">
            <button type="button" class="btn btn-primary" id="save-perm-btn" onclick="saveRolePermissions()">Save Settings</button>
        </div>
    </div>
</div>
{/block}

{block scripts}
<script>
    function toggleCloseOfDayTime() {
        // Keep cutoff time editable even when auto-close is off,
        // so admins can preconfigure the value before enabling it.
    }

    function updateBrandAssetPreview(assetType, assetUrl) {
        var preview = document.getElementById(assetType + '-preview');
        if (!preview) {
            return;
        }

        preview.innerHTML = '';

        if (assetUrl) {
            var img = document.createElement('img');
            img.src = assetUrl;
            img.alt = assetType === 'logo' ? 'Daily Ledger logo preview' : 'Daily Ledger favicon preview';
            img.className = assetType === 'logo'
                ? 'max-h-12 w-auto object-contain'
                : 'h-10 w-10 rounded-lg object-contain';
            preview.appendChild(img);
            return;
        }

        var empty = document.createElement('span');
        empty.className = 'text-[11px] font-medium uppercase tracking-[0.18em] text-slate-400';
        empty.textContent = assetType === 'logo' ? 'No logo' : 'Default';
        preview.appendChild(empty);
    }

    function uploadBrandAsset(assetType) {
        var fileInput = document.getElementById(assetType + '-file');
        var urlInput = document.getElementById(assetType + '-url');
        var button = document.getElementById(assetType + '-upload-btn');

        if (!fileInput || !urlInput || !button || !fileInput.files || !fileInput.files[0]) {
            showToast('Choose a ' + assetType + ' image first.', 'error');
            return;
        }

        var formData = new FormData();
        formData.append('asset_type', assetType);
        formData.append('asset_file', fileInput.files[0]);

        button.disabled = true;
        button.textContent = assetType === 'logo' ? 'Uploading Logo...' : 'Uploading Favicon...';

        fetch('{base_url}/api/v1/admin/settings/branding-asset', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: formData
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (!res.ok || !res.asset_url) {
                throw new Error(res.error || 'Upload failed');
            }
            urlInput.value = res.asset_url;
            updateBrandAssetPreview(assetType, res.asset_url);
            fileInput.value = '';
            showToast(res.message || 'Branding asset uploaded. Save settings to apply it everywhere.', 'success');
        })
        .catch(function(err) {
            showToast(err.message || 'Upload failed', 'error');
        })
        .finally(function() {
            button.disabled = false;
            button.textContent = assetType === 'logo' ? 'Upload Logo' : 'Upload Favicon';
        });
    }

    function updateCutoffBadgePreview() {
        var val = document.getElementById('close-of-day-time').value || '00:00';
        document.getElementById('cutoff-badge-preview').textContent = 'Cutoff: ' + val;
    }

    function saveRolePermissions() {
        var btn = document.getElementById('save-perm-btn');
        var autoCloseEnabled = document.getElementById('auto-close-enabled').checked;
        var closeOfDayTime = document.getElementById('close-of-day-time').value || '00:00';
        var closeHour = parseInt(closeOfDayTime.split(':')[0], 10);

        if (autoCloseEnabled && (isNaN(closeHour) || closeHour < 0 || closeHour > 11)) {
            showToast('Auto close cutoff must be an overnight time between 00:00 and 11:59.', 'error');
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Saving...';

        var payload = {
            operating_region: document.getElementById('operating-region').value,
            operating_timezone: document.getElementById('operating-timezone').value,
            auto_close_enabled: autoCloseEnabled,
            close_of_day_time: closeOfDayTime,
            supervisor_ledger_override: document.getElementById('perm-supervisor-ledger').checked,
            supervisor_production_override: document.getElementById('perm-supervisor-production').checked,
            prod_ledger_override: document.getElementById('perm-prod-ledger').checked,
            prod_production_override: document.getElementById('perm-prod-production').checked
        };

        var featureOutputToggle = document.getElementById('feature-production-output');
        if (featureOutputToggle) {
            payload.production_output_enabled = featureOutputToggle.checked;
        }
        var featureFormalDelivery = document.getElementById('feature-formal-delivery');
        if (featureFormalDelivery) {
            payload.formal_delivery_workflow_enabled = featureFormalDelivery.checked;
        }
        var featurePriceGroups = document.getElementById('feature-price-groups');
        if (featurePriceGroups) {
            payload.price_groups_enabled = featurePriceGroups.checked;
        }
        var featureSellingAccounts = document.getElementById('feature-selling-accounts');
        if (featureSellingAccounts) {
            payload.selling_accounts_enabled = featureSellingAccounts.checked;
        }

        var appNameInput = document.getElementById('app-name');
        if (appNameInput) {
            payload.app_name = appNameInput.value.trim() || 'Daily Ledger';
        }
        payload.logo_url = (document.getElementById('logo-url') || {}).value || '';
        payload.favicon_url = (document.getElementById('favicon-url') || {}).value || '';

        fetch('{base_url}/api/v1/admin/settings/permissions', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify(payload)
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (!res.ok) {
                throw new Error(res.error || 'Failed to save settings');
            }
            showToast('Settings updated', 'success');
            setTimeout(function() { window.location.reload(); }, 500);
        })
        .catch(function(err) {
            showToast(err.message || 'Failed to save settings', 'error');
        })
        .finally(function() {
            btn.disabled = false;
            btn.textContent = 'Save Settings';
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        var cutoffInput = document.getElementById('close-of-day-time');
        if (cutoffInput) {
            cutoffInput.addEventListener('input', updateCutoffBadgePreview);
            updateCutoffBadgePreview();
        }
        updateBrandAssetPreview('logo', (document.getElementById('logo-url') || {}).value || '');
        updateBrandAssetPreview('favicon', (document.getElementById('favicon-url') || {}).value || '');
    });
</script>
{/block}
