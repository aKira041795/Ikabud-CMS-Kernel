{extends "modules/daily-ledger/layouts/app.disyl"}

{block content}
<div class="flex items-center justify-between mb-6">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">Daily Ledger Settings</h2>
        <p class="text-sm text-gray-500">Manage close-of-day timing and override capabilities. Admin permissions are always enabled.</p>
    </div>
</div>

<div class="card mb-6">
    <div class="card-header">
        <span>Branding</span>
        <span class="text-sm text-muted">Appearance</span>
    </div>
    <div class="card-body">
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,360px),minmax(0,1fr)]">
            <div class="form-group mb-0">
                <label class="form-label" for="app-name">App Name</label>
                <input type="text" id="app-name" class="form-input" value="{app_name}" maxlength="80" placeholder="Daily Ledger">
                <p class="mt-2 text-sm text-gray-500">Display name shown on the login page and throughout the app.</p>
            </div>
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <h3 class="text-sm font-semibold text-slate-900">Logo</h3>
                            <p class="mt-1 text-sm text-slate-500">Used on the login screen and in the Daily Ledger sidebar.</p>
                        </div>
                        <div id="logo-preview" class="flex h-16 w-20 items-center justify-center rounded-xl bg-white ring-1 ring-slate-200">
                            {if logo_url}
                            <img src="{logo_url}" alt="{app_name} logo" class="max-h-12 w-auto object-contain">
                            {/if}
                            {if !logo_url}
                            <span class="text-[11px] font-medium uppercase tracking-[0.18em] text-slate-400">No logo</span>
                            {/if}
                        </div>
                    </div>
                    <label class="form-label mt-4" for="logo-url">Logo URL</label>
                    <input type="text" id="logo-url" class="form-input" value="{logo_url}" placeholder="/uploads/daily-ledger/... or https://...">
                    <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center">
                        <input type="file" id="logo-file" class="block w-full text-sm text-slate-600" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml">
                        <button type="button" class="btn btn-outline whitespace-nowrap" id="logo-upload-btn" onclick="uploadBrandAsset('logo')">Upload Logo</button>
                    </div>
                </div>
                <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <h3 class="text-sm font-semibold text-slate-900">Favicon</h3>
                            <p class="mt-1 text-sm text-slate-500">Used in browser tabs across Daily Ledger pages.</p>
                        </div>
                        <div id="favicon-preview" class="flex h-16 w-16 items-center justify-center rounded-xl bg-white ring-1 ring-slate-200">
                            {if favicon_url}
                            <img src="{favicon_url}" alt="{app_name} favicon" class="h-10 w-10 rounded-lg object-contain">
                            {/if}
                            {if !favicon_url}
                            <span class="text-[11px] font-medium uppercase tracking-[0.18em] text-slate-400">Default</span>
                            {/if}
                        </div>
                    </div>
                    <label class="form-label mt-4" for="favicon-url">Favicon URL</label>
                    <input type="text" id="favicon-url" class="form-input" value="{favicon_url}" placeholder="/uploads/daily-ledger/... or https://...">
                    <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center">
                        <input type="file" id="favicon-file" class="block w-full text-sm text-slate-600" accept="image/png,image/jpeg,image/gif,image/webp,image/svg+xml,image/x-icon,.ico">
                        <button type="button" class="btn btn-outline whitespace-nowrap" id="favicon-upload-btn" onclick="uploadBrandAsset('favicon')">Upload Favicon</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="card mb-6">
    <div class="card-header">
        <span>Shifts</span>
        <span class="text-sm text-muted">AM / PM Cashier Handoff</span>
    </div>
    <div class="card-body">
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            <div class="form-group mb-0">
                <label class="form-label" for="am-shift-cutoff">AM to PM Shift Cutoff</label>
                <input type="time" id="am-shift-cutoff" class="form-input" value="{am_shift_cutoff}" onchange="updateShiftBadgePreview()">
                <p class="mt-2 text-sm text-gray-500">The AM shift ends and the PM shift begins at this time. A cashier working at or after this time is auto-selected to the PM shift on the ledger, and the PM shift starts with the AM ending count.</p>
                <div class="mt-3">
                    <span class="inline-flex items-center rounded-full bg-indigo-100 px-3 py-1 text-sm font-semibold text-indigo-800 ring-1 ring-inset ring-indigo-200" id="shift-badge-preview">
                        PM shift starts at {am_shift_cutoff}
                    </span>
                </div>
            </div>
            <div class="rounded-xl border border-indigo-200 bg-indigo-50 p-4 text-sm text-indigo-900">
                <p class="font-semibold">How the two shifts work</p>
                <ul class="mt-2 list-disc pl-4 space-y-1 text-xs leading-5">
                    <li><span class="font-semibold">AM</span> encodes its own beginning, adjustments, and ending.</li>
                    <li><span class="font-semibold">PM</span> validates the AM ending and uses it as its beginning, then continues with its own adjustments and ending.</li>
                    <li>Each shift keeps its own sales total; the day total is the sum of both.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="card mb-6">
    <div class="card-header">
        <span>Operating Clock</span>
        <span class="text-sm text-muted">Region and Timezone</span>
    </div>
    <div class="card-body">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div class="form-group mb-0">
                <label class="form-label">Operating Region</label>
                <select id="operating-region" class="form-input">
                    {foreach operating_region_choices as region}
                    <option value="{region}" {if region == operating_region}selected{/if}>{region}</option>
                    {/foreach}
                </select>
                <p class="mt-2 text-sm text-gray-500">Informational label shown on Daily Ledger screens.</p>
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Operating Timezone</label>
                <select id="operating-timezone" class="form-input">
                    {foreach operating_timezone_choices as tz}
                    <option value="{tz}" {if tz == operating_timezone}selected{/if}>{tz}</option>
                    {/foreach}
                </select>
                <p class="mt-2 text-sm text-gray-500">Used for business-date, shift, and auto-close cutoff calculations.</p>
            </div>
        </div>
    </div>
</div>

<div class="card mb-6">
    <div class="card-header">
        <span>Close of Day</span>
        <span class="text-sm text-muted">Business-Day Cutoff</span>
    </div>
    <div class="card-body">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div>
                <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" id="auto-close-enabled" {if auto_close_enabled}checked{/if} onchange="toggleCloseOfDayTime()">
                    Enable automatic close of day
                </label>
                <p class="mt-2 text-sm text-gray-500">When enabled, the app rolls to the next business day after the configured cutoff and auto-closes the previous day on the next request.</p>
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Cutoff Time</label>
                <input type="time" id="close-of-day-time" class="form-input" value="{close_of_day_time}">
                <p class="mt-2 text-sm text-gray-500">Entries before the cutoff are treated as the previous business day. Auto close only allows overnight cutoff times from 00:00 to 11:59 to prevent same-day closure.</p>
                <div class="mt-3">
                    <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800 ring-1 ring-inset ring-amber-300" id="cutoff-badge-preview">
                        Cutoff: {close_of_day_time}
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-6">
    <div class="card-header">
        <span>Offline Access</span>
        <span class="text-sm text-muted">Encrypted Device Offline Shell</span>
    </div>
    <div class="card-body">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div class="form-group mb-0">
                <label class="form-label">Max Offline Days</label>
                <input type="number" id="max-offline-days" class="form-input" min="1" max="90" value="{max_offline_days}">
                <p class="mt-2 text-sm text-gray-500">Offline access granted to an enrolled device expires after this many days (1–90). Expiry is enforced at next contact and before any sync.</p>
            </div>
            <div>
                <p class="text-sm text-gray-700 font-medium">About offline access</p>
                <p class="mt-1 text-sm text-gray-500">An authenticated cashier/supervisor/admin explicitly enables offline access on a device. The device stores an encrypted snapshot plus pending edits, unlocked by a device-only PIN. POS, day close, dispatch, and delivery correction remain online-only.</p>
            </div>
        </div>
    </div>
</div>

<div class="card mb-6">
    <div class="card-header">
        <span>Features</span>
        <span class="text-sm text-muted">Admin / Superadmin Control</span>
    </div>
    <div class="card-body">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div>
                <p class="text-sm text-gray-700 font-medium">Production Output (Batch Count / Option A)</p>
                <p class="mt-1 text-sm text-gray-500">Controls whether output movement posting is enabled for the production page and output APIs.</p>
            </div>
            <div>
                {if can_manage_feature_activation}
                <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" id="feature-production-output" {if production_output_enabled}checked{/if}>
                    Enable production output feature
                </label>
                <p class="mt-2 text-sm text-gray-500">You are signed in as Admin/Superadmin, so this activation switch is editable.</p>
                {/if}
                {if !can_manage_feature_activation}
                <div class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset {if production_output_enabled}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}{if !production_output_enabled}bg-gray-100 text-gray-700 ring-gray-300{/if}">
                    Production Output is {if production_output_enabled}Enabled{/if}{if !production_output_enabled}Disabled{/if}
                </div>
                <p class="mt-2 text-sm text-gray-500">Only Admin or Superadmin can change feature activation.</p>
                {/if}
            </div>
        </div>

        <div class="mt-6 border-t border-gray-200 pt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
            <div>
                <p class="text-sm text-gray-700 font-medium">Formal Delivery Workflow (Phase B)</p>
                <p class="mt-1 text-sm text-gray-500">Two-step commissary → branch deliveries with receivings + variance flags. When OFF, deliveries fall back to the legacy direct-push behavior.</p>
            </div>
            <div>
                {if can_manage_feature_activation}
                <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" id="feature-formal-delivery" {if formal_delivery_workflow_enabled}checked{/if}>
                    Enable formal delivery + receiving workflow
                </label>
                {/if}
                {if !can_manage_feature_activation}
                <div class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset {if formal_delivery_workflow_enabled}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}{if !formal_delivery_workflow_enabled}bg-gray-100 text-gray-700 ring-gray-300{/if}">
                    Formal Delivery is {if formal_delivery_workflow_enabled}Enabled{/if}{if !formal_delivery_workflow_enabled}Disabled{/if}
                </div>
                {/if}
            </div>

            <div>
                <p class="text-sm text-gray-700 font-medium">Price Groups (Phase D)</p>
                <p class="mt-1 text-sm text-gray-500">Independent price tiers (Default, Mall, Wholesale). Resolution always falls back to <code>current_price</code> when OFF or unmapped.</p>
            </div>
            <div>
                {if can_manage_feature_activation}
                <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" id="feature-price-groups" {if price_groups_enabled}checked{/if}>
                    Enable price groups
                </label>
                {/if}
                {if !can_manage_feature_activation}
                <div class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset {if price_groups_enabled}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}{if !price_groups_enabled}bg-gray-100 text-gray-700 ring-gray-300{/if}">
                    Price Groups {if price_groups_enabled}Enabled{/if}{if !price_groups_enabled}Disabled{/if}
                </div>
                {/if}
            </div>

            <div>
                <p class="text-sm text-gray-700 font-medium">Point of Sale (POS)</p>
                <p class="mt-1 text-sm text-gray-500">Itemized cashier POS transactions with receipts. When OFF, only the manual stock ledger is available.</p>
            </div>
            <div>
                {if can_manage_feature_activation}
                <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" id="feature-pos" {if pos_enabled}checked{/if}>
                    Enable POS
                </label>
                <p class="mt-2 text-sm text-gray-500">Enabling POS makes it available to cashiers granted the pos.sell permission.</p>
                <label class="mt-3 inline-flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" id="feature-pos-sort-sales" {if pos_sort_by_sales}checked{/if}>
                    Arrange POS items by sales (most-sold first)
                </label>
                <p class="mt-1 text-sm text-gray-500">Sorts the POS product grid by units sold, descending. Off keeps the manual product sort order.</p>
                {/if}
                {if !can_manage_feature_activation}
                <div class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset {if pos_enabled}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}{if !pos_enabled}bg-gray-100 text-gray-700 ring-gray-300{/if}">
                    POS is {if pos_enabled}Enabled{/if}{if !pos_enabled}Disabled{/if}
                </div>
                {/if}
            </div>

        </div>
    </div>
</div>

<div class="card mb-6">
    <div class="card-header">
        <span>Roles &amp; Permissions</span>
        <span class="text-sm text-muted">Daily Ledger</span>
    </div>
    <div class="card-body">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Role</th>
                        <th>Ledger Override</th>
                        <th>Production Override</th>
                        <th>Edit Stock Delivery by DR</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="font-medium">Admin</td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" checked disabled>
                                Always allowed
                            </label>
                        </td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" checked disabled>
                                Always allowed
                            </label>
                        </td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" checked disabled>
                                Always allowed
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td class="font-medium">Supervisor</td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" id="perm-supervisor-ledger" {if perm_supervisor_ledger_override}checked{/if}>
                                Allow reopen/override cashier day
                            </label>
                        </td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" id="perm-supervisor-production" {if perm_supervisor_production_override}checked{/if}>
                                Allow production reverse/override
                            </label>
                        </td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" id="perm-supervisor-delivery-edit" {if perm_supervisor_delivery_edit}checked{/if}>
                                Allow editing stock deliveries by DR (missed items, qty correction)
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td class="font-medium">Cashier</td>
                        <td>
                            <span class="text-xs text-gray-400">Not applicable</span>
                        </td>
                        <td>
                            <span class="text-xs text-gray-400">Not applicable</span>
                        </td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" id="perm-cashier-delivery-edit" {if perm_cashier_delivery_edit}checked{/if}>
                                Allow editing stock deliveries by DR (missed items, qty correction)
                            </label>
                        </td>
                    </tr>
                    <tr>
                        <td class="font-medium">Production in-charge</td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" id="perm-prod-ledger" {if perm_prod_ledger_override}checked{/if}>
                                Allow ledger override
                            </label>
                        </td>
                        <td>
                            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" id="perm-prod-production" {if perm_prod_production_override}checked{/if}>
                                Allow production reverse/override
                            </label>
                        </td>
                        <td>
                            <span class="text-xs text-gray-400">Not applicable</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="mt-6 flex justify-end">
            <button type="button" class="btn btn-primary" id="save-perm-btn" onclick="saveRolePermissions()">Save Settings</button>
        </div>
    </div>
</div>

<div class="card mb-6">
    <div class="card-header">
        <span>Database Backup</span>
        <span class="text-sm text-muted">Settings-Based Protection</span>
    </div>
    <div class="card-body">
        <div class="rounded-xl border border-sky-200 bg-sky-50 p-4 text-sm text-sky-900">
            <p class="font-semibold">Generate SQL backups from Settings and auto-backup before deployment reset.</p>
            <p class="mt-2">Backups are stored under <span class="font-mono">storage/backups/daily-ledger</span> and old files are auto-cleaned using retention days.</p>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-3">
            <label class="inline-flex items-center gap-2 text-sm text-gray-700 md:col-span-1">
                <input type="checkbox" id="backup-before-reset-enabled" {if backup_before_reset_enabled}checked{/if}>
                Auto backup before deployment reset
            </label>
            <label class="inline-flex items-center gap-2 text-sm text-gray-700 md:col-span-1">
                <input type="checkbox" id="backup-include-users" {if backup_include_users}checked{/if}>
                Include user accounts in backup
            </label>
            <div class="md:col-span-1">
                <label class="form-label" for="backup-retention-days">Retention (days)</label>
                <input type="number" id="backup-retention-days" class="form-input" min="1" max="90" value="{backup_retention_days}">
            </div>
        </div>

        <div class="mt-4 flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline" id="backup-generate-btn" onclick="runManualBackup()">Generate Backup Now</button>
        </div>

        <div id="backup-result" class="mt-4 hidden rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm text-slate-700"></div>
    </div>
</div>

<div class="card mb-6">
    <div class="card-header">
        <span>Reset Sales Data</span>
        <span class="text-sm text-muted">Testing & Re-sync</span>
    </div>
    <div class="card-body">
        <div class="rounded-xl border border-sky-300 bg-sky-50 p-4 text-sm text-sky-900">
            <p class="font-semibold">Clears only sales/transaction data — keeps users, branches, products, prices, and settings.</p>
            <p class="mt-2">Removes ledger entries, POS sales, deliveries, withdrawals, variance flags, and day status so the module can start a fresh period. Useful while testing and for live-host re-sync. Reference data and audit logs are preserved.</p>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-3">
            <div class="md:col-span-2">
                <label class="form-label" for="sales-reset-confirm">Confirmation Phrase</label>
                <input type="text" id="sales-reset-confirm" class="form-input" placeholder="Type: RESET SALES DATA">
                <p class="mt-2 text-xs text-gray-500">Required phrase: <span class="font-semibold">RESET SALES DATA</span></p>
            </div>
            <div class="flex items-end">
                <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" id="sales-reset-dry-run" checked>
                    Preview only (dry run)
                </label>
            </div>
        </div>

        <div class="mt-4 flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline" id="sales-reset-preview-btn" onclick="runSalesDataReset(true)">Preview Reset Scope</button>
            <button type="button" class="btn btn-danger" id="sales-reset-run-btn" onclick="runSalesDataReset(false)">Reset Sales Data</button>
        </div>

        <div id="sales-reset-result" class="mt-4 hidden rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm text-slate-700"></div>
    </div>
</div>

<div class="card mb-6">
    <div class="card-header">
        <span>Deployment Reset</span>
        <span class="text-sm text-muted">Live Server Safety</span>
    </div>
    <div class="card-body">
        <div class="rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
            <p class="font-semibold">Performs full Daily Ledger data reset and preserves only the currently logged-in admin account.</p>
            <p class="mt-2">This removes sales, branches, users, and all other dl_* records, then restores the active admin account so access is retained.</p>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-3">
            <div class="md:col-span-2">
                <label class="form-label" for="deployment-reset-confirm">Confirmation Phrase</label>
                <input type="text" id="deployment-reset-confirm" class="form-input" placeholder="Type: RESET DAILY LEDGER DATA">
                <p class="mt-2 text-xs text-gray-500">Required phrase: <span class="font-semibold">RESET DAILY LEDGER DATA</span></p>
            </div>
            <div class="flex items-end">
                <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" id="deployment-reset-dry-run" checked>
                    Preview only (dry run)
                </label>
            </div>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-3">
            <div class="md:col-span-2">
                <label class="form-label" for="deployment-reset-second-confirm">Second Safeguard Phrase</label>
                <input type="text" id="deployment-reset-second-confirm" class="form-input" placeholder="Type second safeguard phrase for full reset">
                <p class="mt-2 text-xs text-gray-500">Phrase: <span class="font-semibold" id="deployment-reset-second-phrase">{reset_second_phrase}</span></p>
            </div>
            <div class="flex items-end">
                <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" id="reset-second-phrase-enabled" {if reset_second_phrase_enabled}checked{/if}>
                    Require second phrase for full reset
                </label>
            </div>
        </div>

        <div class="mt-4 flex flex-wrap gap-2">
            <button type="button" class="btn btn-outline" id="deployment-reset-preview-btn" onclick="runDeploymentReset(true)">Preview Reset Scope</button>
            <button type="button" class="btn btn-danger" id="deployment-reset-run-btn" onclick="runDeploymentReset(false)">Reset Operational Data</button>
        </div>

        <div id="deployment-reset-result" class="mt-4 hidden rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm text-slate-700"></div>
    </div>
</div>
{/block}

{block scripts}
<script>
    function toggleCloseOfDayTime() {
        // Keep cutoff time editable even when auto-close is off,
        // so admins can preconfigure the value before enabling it.
    }

    function updateBrandAssetPreview(assetType, assetUrl) {
        var preview = document.getElementById(assetType + '-preview');
        if (!preview) {
            return;
        }

        preview.innerHTML = '';

        if (assetUrl) {
            var img = document.createElement('img');
            img.src = assetUrl;
            img.alt = assetType === 'logo' ? 'Daily Ledger logo preview' : 'Daily Ledger favicon preview';
            img.className = assetType === 'logo'
                ? 'max-h-12 w-auto object-contain'
                : 'h-10 w-10 rounded-lg object-contain';
            preview.appendChild(img);
            return;
        }

        var empty = document.createElement('span');
        empty.className = 'text-[11px] font-medium uppercase tracking-[0.18em] text-slate-400';
        empty.textContent = assetType === 'logo' ? 'No logo' : 'Default';
        preview.appendChild(empty);
    }

    function uploadBrandAsset(assetType) {
        var fileInput = document.getElementById(assetType + '-file');
        var urlInput = document.getElementById(assetType + '-url');
        var button = document.getElementById(assetType + '-upload-btn');

        if (!fileInput || !urlInput || !button || !fileInput.files || !fileInput.files[0]) {
            showToast('Choose a ' + assetType + ' image first.', 'error');
            return;
        }

        var formData = new FormData();
        formData.append('asset_type', assetType);
        formData.append('asset_file', fileInput.files[0]);

        button.disabled = true;
        button.textContent = assetType === 'logo' ? 'Uploading Logo...' : 'Uploading Favicon...';

        fetch('{base_url}/api/v1/admin/settings/branding-asset', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: formData
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (!res.ok || !res.asset_url) {
                throw new Error(res.error || 'Upload failed');
            }
            urlInput.value = res.asset_url;
            updateBrandAssetPreview(assetType, res.asset_url);
            fileInput.value = '';
            showToast(res.message || 'Branding asset uploaded. Save settings to apply it everywhere.', 'success');
        })
        .catch(function(err) {
            showToast(err.message || 'Upload failed', 'error');
        })
        .finally(function() {
            button.disabled = false;
            button.textContent = assetType === 'logo' ? 'Upload Logo' : 'Upload Favicon';
        });
    }

    function updateCutoffBadgePreview() {
        var val = document.getElementById('close-of-day-time').value || '00:00';
        document.getElementById('cutoff-badge-preview').textContent = 'Cutoff: ' + val;
    }

    function updateShiftBadgePreview() {
        var val = document.getElementById('am-shift-cutoff').value || '14:00';
        var badge = document.getElementById('shift-badge-preview');
        if (badge) {
            badge.textContent = 'PM shift starts at ' + val;
        }
    }

    function renderDeploymentResetResult(data) {
        var box = document.getElementById('deployment-reset-result');
        if (!box) {
            return;
        }
        var reset = data && data.deployment_reset ? data.deployment_reset : null;
        if (!reset) {
            box.classList.add('hidden');
            box.innerHTML = '';
            return;
        }

        var rows = Array.isArray(reset.tables) ? reset.tables : [];
        var html = '';
        html += '<div class="font-semibold text-slate-900">' + (reset.dry_run ? 'Reset Preview' : 'Reset Completed') + '</div>';
        html += '<div class="mt-1 text-xs text-slate-600">Preserved admin accounts: ' + String(reset.preserved_admin_accounts || 0) + '</div>';
        if (reset.preserved_admin_username) {
            html += '<div class="mt-1 text-xs text-slate-600">Preserved admin username: ' + String(reset.preserved_admin_username) + '</div>';
        }
        html += '<div class="mt-1 text-xs text-slate-600">Total rows: ' + String(reset.total_rows || 0) + '</div>';
        html += '<div class="mt-3 max-h-52 overflow-auto rounded-lg border border-slate-200 bg-white">';
        html += '<table class="min-w-full text-xs"><thead><tr><th class="px-3 py-2 text-left">Table</th><th class="px-3 py-2 text-right">Rows</th></tr></thead><tbody>';
        rows.forEach(function(row) {
            html += '<tr><td class="px-3 py-1.5">' + String(row.table || '') + '</td><td class="px-3 py-1.5 text-right">' + String(row.rows || 0) + '</td></tr>';
        });
        html += '</tbody></table></div>';

        box.innerHTML = html;
        box.classList.remove('hidden');
    }

    function renderBackupResult(data) {
        var box = document.getElementById('backup-result');
        if (!box) {
            return;
        }
        var backup = data && data.backup ? data.backup : null;
        if (!backup) {
            box.classList.add('hidden');
            box.innerHTML = '';
            return;
        }

        var html = '';
        html += '<div class="font-semibold text-slate-900">Backup Ready</div>';
        html += '<div class="mt-1 text-xs text-slate-600">File: ' + String(backup.file_name || '') + '</div>';
        html += '<div class="mt-1 text-xs text-slate-600">Size: ' + String(backup.file_size_bytes || 0) + ' bytes</div>';
        html += '<div class="mt-1 text-xs text-slate-600">Rows: ' + String(backup.total_rows || 0) + '</div>';
        if (backup.download_url) {
            html += '<div class="mt-2"><a class="text-blue-600 underline" href="' + String(backup.download_url) + '">Download SQL Backup</a></div>';
        }

        box.innerHTML = html;
        box.classList.remove('hidden');
    }

    function runManualBackup() {
        var btn = document.getElementById('backup-generate-btn');
        var includeUsers = !!((document.getElementById('backup-include-users') || {}).checked);
        if (!btn) {
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Generating...';

        fetch('{base_url}/api/v1/admin/settings/permissions', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify({
                db_backup_generate: true,
                backup_include_users: includeUsers
            })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (!res.ok) {
                throw new Error(res.error || 'Failed to generate backup');
            }
            renderBackupResult(res);
            showToast('Daily Ledger backup generated.', 'success');
        })
        .catch(function(err) {
            showToast(err.message || 'Failed to generate backup', 'error');
        })
        .finally(function() {
            btn.disabled = false;
            btn.textContent = 'Generate Backup Now';
        });
    }

    function runDeploymentReset(forceDryRun) {
        var phraseInput = document.getElementById('deployment-reset-confirm');
        var phraseTwoInput = document.getElementById('deployment-reset-second-confirm');
        var phraseTwoLabel = document.getElementById('deployment-reset-second-phrase');
        var phraseTwoEnabled = !!((document.getElementById('reset-second-phrase-enabled') || {}).checked);
        var phraseTwoExpected = (phraseTwoLabel && phraseTwoLabel.textContent ? phraseTwoLabel.textContent : '').trim();
        var dryRunCheckbox = document.getElementById('deployment-reset-dry-run');
        var previewBtn = document.getElementById('deployment-reset-preview-btn');
        var runBtn = document.getElementById('deployment-reset-run-btn');
        var phrase = (phraseInput && phraseInput.value ? phraseInput.value : '').trim();
        var phraseTwo = (phraseTwoInput && phraseTwoInput.value ? phraseTwoInput.value : '').trim();

        if (phrase !== 'RESET DAILY LEDGER DATA') {
            showToast('Type RESET DAILY LEDGER DATA to continue.', 'error');
            if (phraseInput) {
                phraseInput.focus();
            }
            return;
        }

        var isDryRun = forceDryRun ? true : !!(dryRunCheckbox && dryRunCheckbox.checked);
        if (!isDryRun && phraseTwoEnabled && phraseTwoExpected !== '' && phraseTwo !== phraseTwoExpected) {
            showToast('Type the second safeguard phrase exactly before full reset.', 'error');
            if (phraseTwoInput) {
                phraseTwoInput.focus();
            }
            return;
        }

        if (!isDryRun) {
            var ok = confirm('Run full Daily Ledger reset now? This removes branches, users, sales, and other module records. Only the currently logged-in admin account will be restored.');
            if (!ok) {
                return;
            }
        }

        previewBtn.disabled = true;
        runBtn.disabled = true;
        previewBtn.textContent = isDryRun ? 'Previewing...' : 'Preview Reset Scope';
        runBtn.textContent = isDryRun ? 'Reset Operational Data' : 'Resetting...';

        fetch('{base_url}/api/v1/admin/settings/permissions', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify({
                deployment_reset: true,
                deployment_reset_confirm: phrase,
                deployment_reset_second_confirm: phraseTwo,
                deployment_reset_dry_run: isDryRun
            })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (!res.ok) {
                throw new Error(res.error || 'Failed to run deployment reset');
            }
            renderDeploymentResetResult(res);
            showToast(isDryRun ? 'Reset preview ready.' : 'Operational data reset completed.', 'success');
            if (!isDryRun) {
                setTimeout(function() { window.refreshMainContent(); }, 800);
            }
        })
        .catch(function(err) {
            showToast(err.message || 'Failed to run deployment reset', 'error');
        })
        .finally(function() {
            previewBtn.disabled = false;
            runBtn.disabled = false;
            previewBtn.textContent = 'Preview Reset Scope';
            runBtn.textContent = 'Reset Operational Data';
        });
    }

    function renderSalesDataResetResult(data) {
        var box = document.getElementById('sales-reset-result');
        if (!box) {
            return;
        }
        var reset = data && data.sales_data_reset ? data.sales_data_reset : null;
        if (!reset) {
            box.classList.add('hidden');
            box.innerHTML = '';
            return;
        }

        var rows = Array.isArray(reset.tables) ? reset.tables : [];
        var html = '';
        html += '<div class="font-semibold text-slate-900">' + (reset.dry_run ? 'Sales Data Reset Preview' : 'Sales Data Reset Completed') + '</div>';
        html += '<div class="mt-1 text-xs text-slate-600">Preserved master data (users, branches, products, prices, settings, audit logs)</div>';
        html += '<div class="mt-1 text-xs text-slate-600">Total rows: ' + String(reset.total_rows || 0) + '</div>';
        html += '<div class="mt-3 max-h-52 overflow-auto rounded-lg border border-slate-200 bg-white">';
        html += '<table class="min-w-full text-xs"><thead><tr><th class="px-3 py-2 text-left">Table</th><th class="px-3 py-2 text-right">Rows</th></tr></thead><tbody>';
        rows.forEach(function(row) {
            html += '<tr><td class="px-3 py-1.5">' + String(row.table || '') + '</td><td class="px-3 py-1.5 text-right">' + String(row.rows || 0) + '</td></tr>';
        });
        html += '</tbody></table></div>';

        box.innerHTML = html;
        box.classList.remove('hidden');
    }

    function runSalesDataReset(forceDryRun) {
        var phraseInput = document.getElementById('sales-reset-confirm');
        var dryRunCheckbox = document.getElementById('sales-reset-dry-run');
        var previewBtn = document.getElementById('sales-reset-preview-btn');
        var runBtn = document.getElementById('sales-reset-run-btn');
        var phrase = (phraseInput && phraseInput.value ? phraseInput.value : '').trim();

        if (phrase !== 'RESET SALES DATA') {
            showToast('Type RESET SALES DATA to continue.', 'error');
            if (phraseInput) {
                phraseInput.focus();
            }
            return;
        }

        var isDryRun = forceDryRun ? true : !!(dryRunCheckbox && dryRunCheckbox.checked);
        if (!isDryRun) {
            var ok = confirm('Reset sales data now? This removes ledger entries, POS sales, deliveries, withdrawals, variance flags, and day status. Users, branches, products, prices, and settings are kept.');
            if (!ok) {
                return;
            }
        }

        previewBtn.disabled = true;
        runBtn.disabled = true;
        previewBtn.textContent = isDryRun ? 'Previewing...' : 'Preview Reset Scope';
        runBtn.textContent = isDryRun ? 'Reset Sales Data' : 'Resetting...';

        fetch('{base_url}/api/v1/admin/settings/permissions', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify({
                sales_data_reset: true,
                sales_data_reset_confirm: phrase,
                sales_data_reset_dry_run: isDryRun
            })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (!res.ok) {
                throw new Error(res.error || 'Failed to run sales data reset');
            }
            renderSalesDataResetResult(res);
            showToast(isDryRun ? 'Sales data reset preview ready.' : 'Sales data reset completed.', 'success');
            if (!isDryRun) {
                setTimeout(function() { window.refreshMainContent(); }, 800);
            }
        })
        .catch(function(err) {
            showToast(err.message || 'Failed to run sales data reset', 'error');
        })
        .finally(function() {
            previewBtn.disabled = false;
            runBtn.disabled = false;
            previewBtn.textContent = 'Preview Reset Scope';
            runBtn.textContent = 'Reset Sales Data';
        });
    }

    function saveRolePermissions() {
        var btn = document.getElementById('save-perm-btn');
        var autoCloseEnabled = document.getElementById('auto-close-enabled').checked;
        var closeOfDayTime = document.getElementById('close-of-day-time').value || '00:00';
        var closeHour = parseInt(closeOfDayTime.split(':')[0], 10);

        if (autoCloseEnabled && (isNaN(closeHour) || closeHour < 0 || closeHour > 11)) {
            showToast('Auto close cutoff must be an overnight time between 00:00 and 11:59.', 'error');
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Saving...';

        var payload = {
            operating_region: document.getElementById('operating-region').value,
            operating_timezone: document.getElementById('operating-timezone').value,
            auto_close_enabled: autoCloseEnabled,
            close_of_day_time: closeOfDayTime,
            am_shift_cutoff: document.getElementById('am-shift-cutoff').value || '14:00',
            backup_before_reset_enabled: document.getElementById('backup-before-reset-enabled').checked,
            backup_include_users: document.getElementById('backup-include-users').checked,
            backup_retention_days: parseInt(document.getElementById('backup-retention-days').value, 10) || 14,
            max_offline_days: parseInt(document.getElementById('max-offline-days').value, 10) || 14,
            reset_second_phrase_enabled: document.getElementById('reset-second-phrase-enabled').checked,
            supervisor_ledger_override: document.getElementById('perm-supervisor-ledger').checked,
            supervisor_production_override: document.getElementById('perm-supervisor-production').checked,
            supervisor_delivery_edit: document.getElementById('perm-supervisor-delivery-edit').checked,
            cashier_delivery_edit: document.getElementById('perm-cashier-delivery-edit').checked,
            prod_ledger_override: document.getElementById('perm-prod-ledger').checked,
            prod_production_override: document.getElementById('perm-prod-production').checked
        };

        if (payload.backup_retention_days < 1 || payload.backup_retention_days > 90) {
            showToast('Backup retention days must be between 1 and 90.', 'error');
            btn.disabled = false;
            btn.textContent = 'Save Settings';
            return;
        }

        var featureOutputToggle = document.getElementById('feature-production-output');
        if (featureOutputToggle) {
            payload.production_output_enabled = featureOutputToggle.checked;
        }
        var featureFormalDelivery = document.getElementById('feature-formal-delivery');
        if (featureFormalDelivery) {
            payload.formal_delivery_workflow_enabled = featureFormalDelivery.checked;
        }
        var featurePriceGroups = document.getElementById('feature-price-groups');
        if (featurePriceGroups) {
            payload.price_groups_enabled = featurePriceGroups.checked;
        }
        var featurePos = document.getElementById('feature-pos');
        if (featurePos) {
            payload.pos_enabled = featurePos.checked;
        }
        var featurePosSortSales = document.getElementById('feature-pos-sort-sales');
        if (featurePosSortSales) {
            payload.pos_sort_by_sales = featurePosSortSales.checked;
        }

        var appNameInput = document.getElementById('app-name');
        if (appNameInput) {
            payload.app_name = appNameInput.value.trim() || 'Daily Ledger';
        }
        payload.logo_url = (document.getElementById('logo-url') || {}).value || '';
        payload.favicon_url = (document.getElementById('favicon-url') || {}).value || '';

        fetch('{base_url}/api/v1/admin/settings/permissions', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify(payload)
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (!res.ok) {
                throw new Error(res.error || 'Failed to save settings');
            }
            showToast('Settings updated', 'success');
            setTimeout(function() { window.refreshMainContent(); }, 500);
        })
        .catch(function(err) {
            showToast(err.message || 'Failed to save settings', 'error');
        })
        .finally(function() {
            btn.disabled = false;
            btn.textContent = 'Save Settings';
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        var cutoffInput = document.getElementById('close-of-day-time');
        if (cutoffInput) {
            cutoffInput.addEventListener('input', updateCutoffBadgePreview);
            updateCutoffBadgePreview();
        }
        updateBrandAssetPreview('logo', (document.getElementById('logo-url') || {}).value || '');
        updateBrandAssetPreview('favicon', (document.getElementById('favicon-url') || {}).value || '');
    });
</script>
{/block}
