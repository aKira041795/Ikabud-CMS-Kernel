{extends "modules/daily-ledger/layouts/app.disyl"}

{block head}
{/block}

{block content}
<div class="flex items-center justify-between mb-6">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">Encoder Activity</h2>
        <p class="text-base text-slate-700">Audit trail across encoders and branches.</p>
        <p class="mt-1 text-sm text-slate-600">Showing events from <span class="font-semibold text-slate-900">{date_from}</span> to <span class="font-semibold text-slate-900">{date_to}</span> (inclusive).</p>
    </div>
    <span class="text-base font-medium text-slate-700">{activities | count} entries</span>
</div>

<form class="card mb-6" action="{base_url}/admin/activity" method="GET"
      onsubmit="return window.dlLoadForm(this)">
    <div class="card-body">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-7 items-end">
        <div class="form-group">
            {include "modules/daily-ledger/admin/partials/scope-filter.disyl"}
        </div>
    <div class="form-group">
        <label class="form-label">From</label>
        <input type="date" class="form-input" name="date_from" value="{date_from}">
    </div>
    <div class="form-group">
        <label class="form-label">To</label>
        <input type="date" class="form-input" name="date_to" value="{date_to}">
    </div>
    <div class="form-group">
        <label class="form-label">Destination</label>
        <select class="form-input" name="branch_id">
            <option value="">All Destinations</option>
            <optgroup label="Branches">
                {foreach branches as br}
                <option value="{br.filter_value}" {if br.selected}selected{/if}>{br.code} — {br.name}</option>
                {/foreach}
            </optgroup>
            <optgroup label="Consignees">
                {foreach consignees as consignee}
                <option value="{consignee.filter_value}" {if consignee.selected}selected{/if}>{consignee.code} — {consignee.name}</option>
                {/foreach}
            </optgroup>
        </select>
    </div>
    <div class="form-group">
        <label class="form-label">Action</label>
        <select class="form-input" name="action_filter">
            {foreach action_filter_options as opt}
            <option value="{opt.value}" {if opt.value == action_filter}selected{/if}>{opt.label}</option>
            {/foreach}
        </select>
    </div>
    <div class="form-group">
        <label class="form-label">Search</label>
        <input type="text" class="form-input" name="q" value="{search}" placeholder="Name, action, or branch...">
    </div>
    <div class="form-group">
        <label class="form-label">DR #</label>
        <input type="text" class="form-input" name="dr_number" value="{dr_number}" placeholder="Filter by DR number">
    </div>
    <div class="form-group">
        <div class="h-5"></div>
        <button type="submit" class="btn btn-primary w-full h-11">Filter</button>
    </div>
    </div>
    </div>
</form>

<div class="card">
    <div class="card-header">
        <span>Activity Log</span>
    </div>
    <div class="card-body p-0">
        {if omitted > 0}
        <div class="border-b border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
            Showing the most recent {activities | count} entries (up to {activity_limit} audit events).
            <span class="font-semibold">{omitted} older matching event(s) are not shown.</span>
            Narrow the date range or add a filter to reach them.
        </div>
        {/if}
        {if activities | count == 0}
        <div class="px-4 py-10 text-center text-base text-slate-700">No activity found for selected date range</div>
        {/if}
        {if activities | count > 0}
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 text-sm">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left font-semibold text-slate-700">When</th>
                        <th class="px-4 py-3 text-left font-semibold text-slate-700">Branch</th>
                        <th class="px-4 py-3 text-left font-semibold text-slate-700">Consignee</th>
                        <th class="px-4 py-3 text-left font-semibold text-slate-700">Actor</th>
                        <th class="px-4 py-3 text-left font-semibold text-slate-700">Action</th>
                        <th class="px-4 py-3 text-left font-semibold text-slate-700">Details</th>
                        <th class="px-4 py-3 text-left font-semibold text-slate-700">Changes</th>
                        <th class="px-4 py-3 text-left font-semibold text-slate-700">Source / Record</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                    {foreach activities as act}
                    <tr>
                        <td class="px-4 py-3 align-top text-slate-700">
                            <div class="font-semibold text-slate-900">{act.created_at}</div>
                            {if act.relative_time}
                            <div class="mt-1 text-xs uppercase tracking-wide text-slate-500">{act.relative_time}</div>
                            {/if}
                        </td>
                        <td class="px-4 py-3 align-top text-slate-800">{if act.branch_name}{act.branch_name}{else}<span class="text-slate-400">All / None</span>{/if}</td>
                        <td class="px-4 py-3 align-top text-slate-800">{if act.consignee_name}<div class="font-semibold text-slate-900">{act.consignee_name}</div><div class="mt-1 text-xs text-slate-500">{act.consignee_code}</div>{/if}</td>
                        <td class="px-4 py-3 align-top text-slate-700">
                            <div class="font-semibold text-slate-900">{if act.actor_username}@{act.actor_username}{else}{act.actor_name}{/if}</div>
                            {if act.actor_username && act.actor_name}
                            <div class="mt-1 text-xs text-slate-500">{act.actor_name}</div>
                            {/if}
                            {if act.actor_source_label}
                            <div class="mt-1 text-xs text-slate-500">{act.actor_source_label}</div>
                            {/if}
                        </td>
                        <td class="px-4 py-3 align-top text-slate-700">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset {act.badge_classes}">{act.badge_label}</span>
                                <span class="font-semibold text-slate-900">{act.summary}</span>
                            </div>
                            {if act.entity_type_label}
                            <div class="mt-1 text-xs text-slate-500">{act.entity_type_label}{if act.entity_id} #{act.entity_id}{/if}</div>
                            {/if}
                        </td>
                        <td class="px-4 py-3 align-top text-slate-700">
                            <div>{act.detail_summary}</div>
                            {if act.grouped_summary != 'None'}
                            <div class="mt-1 text-xs text-slate-500">Batch: {act.grouped_summary}</div>
                            {/if}
                        </td>
                        <td class="px-4 py-3 align-top text-slate-700">{act.change_summary}</td>
                        <td class="px-4 py-3 align-top text-slate-700">
                            <div>
                                Source: <span class="font-semibold text-slate-900">{act.actor_source_label}</span>
                            </div>
                            <div class="mt-1">Record: <span class="font-semibold text-slate-900">{act.record_label}</span></div>
                            {if act.is_grouped}
                            <div class="mt-1 text-xs text-slate-500">Grouped batch entry</div>
                            {/if}
                            <div class="mt-2 text-xs">
                                <a class="text-indigo-700 hover:underline" href="{act.raw_payload_url}" download="activity-payload.json">Download raw payload</a>
                            </div>
                        </td>
                    </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
        {/if}
    </div>
</div>
{/block}
