{extends "modules/daily-ledger/layouts/app.disyl"}

{block head}
{/block}

{block content}
<div class="flex items-center justify-between mb-6">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">Encoder Activity</h2>
        <p class="text-base text-slate-700">Audit trail across encoders and branches.</p>
    </div>
    <span class="text-base font-medium text-slate-700">{activities | count} entries</span>
</div>

<form class="card mb-6" action="{base_url}/admin/activity" method="GET">
    <div class="card-body">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-7 items-end">
    <div class="form-group">
        <label class="form-label">From</label>
        <input type="date" class="form-input" name="date_from" value="{date_from}">
    </div>
    <div class="form-group">
        <label class="form-label">To</label>
        <input type="date" class="form-input" name="date_to" value="{date_to}">
    </div>
    <div class="form-group">
        <label class="form-label">Branch</label>
        <select class="form-input" name="branch_id">
            <option value="">All Branches</option>
            {foreach branches as br}
            <option value="{br.id}" {if br.id == branch_id}selected{/if}>{br.name}</option>
            {/foreach}
        </select>
    </div>
    <div class="form-group">
        <label class="form-label">Action</label>
        <select class="form-input" name="action_filter">
            {foreach action_filter_options as opt}
            <option value="{opt.value}" {if opt.value == action_filter}selected{/if}>{opt.label}</option>
            {/foreach}
        </select>
    </div>
    <div class="form-group">
        <label class="form-label">Search</label>
        <input type="text" class="form-input" name="q" value="{search}" placeholder="Name, action, or branch...">
    </div>
    <div class="form-group">
        <label class="form-label">DR #</label>
        <input type="text" class="form-input" name="dr_number" value="{dr_number}" placeholder="Filter by DR number">
    </div>
    <div class="form-group">
        <div class="h-5"></div>
        <button type="submit" class="btn btn-primary w-full h-11">Filter</button>
    </div>
    </div>
    </div>
</form>

<div class="card">
    <div class="card-header">
        <span>Activity Log</span>
    </div>
    <div class="card-body p-0">
        {if activities | count == 0}
        <div class="px-4 py-10 text-center text-base text-slate-700">No activity found for selected date range</div>
        {/if}
        {foreach activities as act}
        <div class="flex flex-col gap-3 px-5 py-4 border-b border-slate-200 last:border-b-0">
            <div class="flex flex-col gap-2 lg:flex-row lg:items-start lg:justify-between">
                <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="inline-flex items-center rounded-full px-2.5 py-1 text-sm font-semibold ring-1 ring-inset {act.badge_classes}">{act.badge_label}</span>
                        <div class="text-base font-semibold leading-6 text-slate-900">{act.summary}</div>
                    </div>
                    <div class="mt-1 text-sm font-medium text-slate-800">{act.actor_name}</div>
                </div>
                <div class="text-right text-sm font-medium text-slate-600">
                    <div>{act.created_at}</div>
                    {if act.relative_time}
                    <div class="mt-1 text-xs font-semibold uppercase tracking-wide text-slate-500">{act.relative_time}</div>
                    {/if}
                </div>
            </div>
            {if act.detail_items | count > 0}
            <div class="grid grid-cols-1 gap-2 md:grid-cols-2 xl:grid-cols-3">
                {foreach act.detail_items as item}
                <div class="rounded-sm bg-slate-50 px-3 py-2">
                    <div class="text-xs font-semibold uppercase tracking-wide text-slate-500">{item.label}</div>
                    <div class="mt-1 break-words text-sm font-semibold text-slate-900">{item.value}</div>
                </div>
                {/foreach}
            </div>
            {/if}

            {if act.grouped_items | count > 0}
            <div class="rounded-sm border border-slate-200 bg-slate-50 px-3 py-3">
                <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Products In Batch</div>
                <div class="grid grid-cols-1 gap-2 md:grid-cols-2 xl:grid-cols-3">
                    {foreach act.grouped_items as item}
                    <div class="flex items-center justify-between gap-3 rounded-sm bg-white px-3 py-2 text-sm text-slate-800">
                        <span class="font-semibold text-slate-900">{item.product}</span>
                        <span class="font-semibold text-slate-700">{item.quantity}</span>
                    </div>
                    {/foreach}
                </div>
            </div>
            {/if}

            {if act.change_items | count > 0}
            <div class="rounded-sm border border-slate-200 bg-white px-3 py-3">
                <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Changes</div>
                <div class="flex flex-col gap-2">
                    {foreach act.change_items as item}
                    <div class="text-sm text-slate-800">
                        <span class="font-semibold text-slate-900">{item.label}:</span>
                        <span class="text-slate-500">{item.from}</span>
                        <span class="mx-1 text-slate-400">→</span>
                        <span class="font-semibold text-slate-900">{item.to}</span>
                    </div>
                    {/foreach}
                </div>
            </div>
            {/if}

            <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-slate-700">
                {if act.branch_name}
                <span>Branch: <span class="font-semibold text-slate-900">{act.branch_name}</span></span>
                {/if}
                {if act.entity_type}
                <span>Entity: <span class="font-semibold text-slate-900">{act.entity_type}</span></span>
                {/if}
                {if act.entity_id}
                <span>Record ID: <span class="font-semibold text-slate-900">{act.entity_id}</span></span>
                {/if}
                {if act.actor_source_label}
                <span>Source: <span class="font-semibold text-slate-900">{act.actor_source_label}</span></span>
                {/if}
            </div>
        </div>
        {/foreach}
    </div>
</div>
{/block}
