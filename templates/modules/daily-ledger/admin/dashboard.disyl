{extends "modules/daily-ledger/layouts/app.disyl"}

{block head}
{/block}

{block content}
<div class="flex items-center justify-between mb-6">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">Dashboard</h2>
        <p class="text-sm text-gray-500">Overview across branches.</p>
        <p class="text-xs text-gray-500 mt-1">
            Business date: <span class="font-medium text-gray-700">{business_date_label}</span>
            · Timezone: <span class="font-medium text-gray-700">{operating_timezone}</span>
            · Region: <span class="font-medium text-gray-700">{operating_region}</span>
        </p>
        <div class="mt-2">
            <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800 ring-1 ring-inset ring-amber-300">
                Cutoff: {close_of_day_time}
            </span>
        </div>
    </div>
    <span class="text-sm text-gray-500">{today}</span>
</div>

<form class="card mb-6 print-hide" action="{base_url}/admin/dashboard" method="GET"
      hx-get="{base_url}/admin/dashboard"
      hx-target="#main-content"
      hx-select="#main-content > *"
      hx-swap="innerHTML"
      hx-push-url="true"
      hx-include="this">
    <div class="card-body">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4 items-end">
            <div class="form-group">
                <label class="form-label">From</label>
                <input type="date" class="form-input" name="date_from" value="{sales_filter_date_from}">
            </div>
            <div class="form-group">
                <label class="form-label">To</label>
                <input type="date" class="form-input" name="date_to" value="{sales_filter_date_to}">
            </div>
            <div class="form-group">
                <label class="form-label">Branch</label>
                <select class="form-input" name="branch_id">
                    <option value="">All Branches</option>
                    {foreach branches as br}
                    <option value="{br.id}" {if br.id == sales_filter_branch_id}selected{/if}>{br.name}</option>
                    {/foreach}
                </select>
            </div>
            <button type="submit" class="btn btn-primary">Filter Sales</button>
        </div>
    </div>
</form>

<!-- Stats row -->
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-6">
    <div class="card">
        <div class="card-body">
            <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Branches</div>
            <div class="mt-1 text-3xl font-semibold text-gray-900">{branches | count}</div>
            <div class="mt-1 text-sm text-gray-500">Active branches</div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Today's Sales</div>
            <div class="mt-1 text-3xl font-semibold text-emerald-600">
                {total_units_today}
                <span class="text-sm font-medium text-gray-500">units</span>
            </div>
            <div class="mt-2 text-lg font-semibold text-gray-900">PHP {total_amount_today | number_format:2}</div>
            <div class="mt-1 text-sm text-gray-500">across all branches</div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Unreviewed Variances</div>
            <div class="mt-1 text-3xl font-semibold {if unreviewed_variances > 0}text-amber-600{/if}{if unreviewed_variances == 0}text-emerald-600{/if}">
                {unreviewed_variances}
            </div>
            <div class="mt-2 text-sm text-gray-500">
                {if unreviewed_variances > 0}
                    <a href="{base_url}/admin/variances?reviewed=0" class="inline-flex items-center gap-2 rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700 ring-1 ring-inset ring-amber-200 hover:bg-amber-100">
                        Review now
                        <i class="fas fa-arrow-right text-xs"></i>
                    </a>
                {/if}
                {if unreviewed_variances == 0}All clear{/if}
            </div>
        </div>
    </div>
</div>

<!-- Branch sales today -->
<div class="card mb-4">
    <div class="card-header">
        <span>Branch Sales Breakdown</span>
        <span class="text-sm text-muted">{sales_filter_period_label} · {branch_cards | count} branches</span>
    </div>
    <div class="card-body px-4 py-3 border-b border-gray-100 bg-slate-50 text-sm text-gray-600">
        Scope total: <span class="font-semibold text-gray-900">{branch_sales_units}</span> units · PHP {branch_sales_amount | number_format:2}
    </div>
    <div class="card-body p-0">
        {foreach branch_cards as card}
        <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100 last:border-b-0">
            <div>
                <div class="text-sm font-semibold text-gray-900">{card.name}</div>
                <div class="text-xs text-gray-500">
                    {if card.units > 0}{card.units} units sold{/if}
                    {if card.units == 0}No data yet{/if}
                </div>
            </div>
            <div class="text-right">
                <div class="text-sm font-semibold text-gray-900">{if card.amount > 0}PHP {card.amount | number_format:2}{/if}{if card.amount == 0}—{/if}</div>
                {if selling_accounts_enabled}
                <div class="text-xs text-indigo-600 mt-0.5" title="Selling accounts gross sales today">
                    {if card.selling_accounts_total > 0}+ PHP {card.selling_accounts_total | number_format:2} accounts{/if}
                </div>
                {/if}
                <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset
                    {if card.status == 'open'}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}
                    {if card.status == 'closed'}bg-rose-50 text-rose-700 ring-rose-200{/if}
                    {if card.status == 'none'}bg-gray-50 text-gray-700 ring-gray-200{/if}
                ">
                    {card.status}
                </span>
            </div>
        </div>
        {/foreach}
    </div>
</div>

<!-- Recent activity -->
<div class="card">
    <div class="card-header">
        <span>Recent Encoder Activity</span>
        <a href="{base_url}/admin/activity" class="text-sm font-semibold text-indigo-600 hover:text-indigo-700">View All &rarr;</a>
    </div>
    <div class="card-body p-0">
        {if recent_activity | count == 0}
        <div class="px-4 py-10 text-center text-sm text-gray-500">No activity yet today</div>
        {/if}
        {if recent_activity | count > 0}
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 text-sm">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-4 py-3 text-left font-semibold text-slate-700">When</th>
                        <th class="px-4 py-3 text-left font-semibold text-slate-700">Actor</th>
                        <th class="px-4 py-3 text-left font-semibold text-slate-700">Activity</th>
                        <th class="px-4 py-3 text-left font-semibold text-slate-700">Branch</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 bg-white">
                    {foreach recent_activity as act}
                    <tr>
                        <td class="px-4 py-3 text-xs text-gray-500 whitespace-nowrap">{act.created_at}</td>
                        <td class="px-4 py-3 font-semibold text-gray-900">{act.actor_name}</td>
                        <td class="px-4 py-3 text-gray-700">{act.activity_label}</td>
                        <td class="px-4 py-3 text-gray-600">{if act.branch_name}{act.branch_name}{else}All / None{/if}</td>
                    </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
        {/if}
    </div>
</div>
{/block}
