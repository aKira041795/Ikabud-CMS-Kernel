{extends "modules/daily-ledger/layouts/app.disyl"}

{block head}
<style>
    .print-only {
        display: none;
    }
    @media print {
        .print-hide {
            display: none !important;
        }
        .print-only {
            display: block !important;
        }
        .card {
            border: none !important;
            box-shadow: none !important;
        }
        body {
            background: #fff !important;
        }
    }
</style>
{/block}

{block content}
<div class="print-only mb-4">
    <h1 class="text-lg font-semibold text-gray-900">Sales Summary Report</h1>
    <div class="text-sm text-gray-700">Date Range: {date_from} to {date_to}</div>
    <div class="text-sm text-gray-700">Prepared By: {user_name} ({user_role})</div>
    <div class="text-sm text-gray-700" id="print-generated-at-sales">Printed At: -</div>
</div>

<div class="flex items-center justify-between mb-6">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">Sales Summary</h2>
        <p class="text-sm text-gray-500">Filter by date range, branch, or product.</p>
        <p class="text-xs text-gray-500 mt-1">
            Business date: <span class="font-medium text-gray-700">{business_date_label}</span>
            · Timezone: <span class="font-medium text-gray-700">{operating_timezone}</span>
            · Region: <span class="font-medium text-gray-700">{operating_region}</span>
        </p>
        <div class="mt-2">
            <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800 ring-1 ring-inset ring-amber-300">
                Cutoff: {close_of_day_time}
            </span>
        </div>
    </div>
    <div class="flex items-center gap-2">
        <a class="btn btn-accent" href="{base_url}/admin/variances?date={date_from}">View Variances</a>
        {if user_role == 'admin'}
        <button type="button" class="btn btn-accent print-hide" onclick="printSalesSummary()">Print</button>
        {/if}
    </div>
</div>

{if pos_enabled}
<div class="card mb-6">
    <div class="card-body">
        <div class="flex items-center gap-2 flex-wrap">
            <span class="text-sm font-semibold text-gray-700">Official sales source:</span>
            <span class="inline-flex items-center rounded-full bg-indigo-100 px-3 py-1 text-xs font-semibold text-indigo-800">{sales_source_label}</span>
            <span class="text-xs text-gray-500">POS and stock-derived totals are never added together.</span>
        </div>
        {if pos_reconciliation}
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4">
            <div>
                <div class="text-xs text-gray-500">Branch mode</div>
                <div class="text-sm font-semibold text-gray-900">{pos_reconciliation.sales_source}</div>
            </div>
            <div>
                <div class="text-xs text-gray-500">POS net sales</div>
                <div class="text-sm font-semibold text-gray-900">PHP {pos_reconciliation.pos_amount | number_format:2}</div>
            </div>
            <div>
                <div class="text-xs text-gray-500">Calculated (stock) sales</div>
                <div class="text-sm font-semibold text-gray-900">PHP {pos_reconciliation.calculated_amount | number_format:2}</div>
            </div>
            <div>
                <div class="text-xs text-gray-500">Variance (POS − stock)</div>
                <div class="text-sm font-semibold {if pos_reconciliation.variance_amount != 0}text-red-700{else}text-emerald-700{/if}">PHP {pos_reconciliation.variance_amount | number_format:2}</div>
            </div>
        </div>
        {/if}
    </div>
</div>
{/if}

<form class="card mb-6 print-hide" action="{base_url}/admin/sales" method="GET"
      onsubmit="return window.dlLoadForm(this)">
    <div class="card-body">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-6 items-end">
        <div class="form-group">
            {include "modules/daily-ledger/admin/partials/scope-filter.disyl"}
        </div>
    <div class="form-group">
        <label class="form-label">From</label>
        <input type="date" class="form-input" name="date_from" value="{date_from}">
    </div>
    <div class="form-group">
        <label class="form-label">To</label>
        <input type="date" class="form-input" name="date_to" value="{date_to}">
    </div>
    <div class="form-group">
        <label class="form-label">Branch</label>
        <select class="form-input" name="branch_id">
            <option value="">All Branches</option>
            {foreach branches as br}
            <option value="{br.id}" {if br.id == branch_id}selected{/if}>{br.name}</option>
            {/foreach}
        </select>
    </div>
    <div class="form-group">
        <label class="form-label">Search</label>
        <input type="text" class="form-input" name="q" value="{search}" placeholder="Product, SKU, or branch...">
    </div>
    <div class="form-group">
        <label class="form-label">Shift</label>
        <select class="form-input" name="shift">
            <option value="">All</option>
            <option value="AM" {if filter_shift == 'AM'}selected{/if}>AM</option>
            <option value="PM" {if filter_shift == 'PM'}selected{/if}>PM</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Filter</button>
    </div>
    </div>
</form>

<div class="card">
    <div class="card-header">
        <span>Sales Data</span>
        <span class="text-sm text-muted">
            {if sales_total_matching > sales_shown}showing the newest {sales_shown} of {sales_total_matching} rows{else}{sales_total_matching} rows{/if}
        </span>
    </div>
    {if sales_total_matching > sales_shown}
    <div class="card-body text-sm text-amber-900 bg-amber-50 border-b border-amber-200">
        <span class="font-semibold">Showing the newest {sales_shown} of {sales_total_matching} matching rows.</span>
        The totals below cover all of them. The
        <a class="underline font-medium" href="{base_url}/admin/reports/sales">Reports &rarr; Daily Sales</a>
        report exports RECORDED ledger entries only &mdash; it does NOT contain the
        &ldquo;No record&rdquo; rows. {sales_no_record_omitted} no-record row(s) are omitted from this page;
        narrow the date range to see them here.
    </div>
    {/if}
    {if (pending_dates | count) > 0}
    <div class="card-body text-sm text-amber-900 bg-amber-50 border-b border-amber-200">
        <span class="font-semibold">{pending_dates | unique | count} date(s) have pending data:</span>
        <span class="font-medium">{pending_dates | unique | join:', '}</span>
        &mdash; their figures are provisional and excluded from the official total.
    </div>
    {/if}
    {if (shift_coverage_notes | count) > 0}
    <div class="card-body text-sm text-amber-900 bg-amber-50 border-b border-amber-200" id="shift-coverage-disclosure">
        <span class="font-semibold">Shift coverage:</span>
        <ul class="list-disc pl-5 mt-1 space-y-0.5">
        {foreach shift_coverage_notes as note}
            <li>{note}</li>
        {/foreach}
        {if shift_coverage_overflow > 0}
            <li>and {shift_coverage_overflow} more date(s) with missing shift coverage.</li>
        {/if}
        </ul>
    </div>
    {/if}
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Shift</th>
                    <th>Branch</th>
                    <th>Product</th>
                    <th>SKU</th>
                    <th class="text-right">Beg Bal</th>
                    <th class="text-right">Addt'l</th>
                    <th class="text-right">W/Draw</th>
                    <th class="text-right">Bal End</th>
                    <th class="text-right">Sales</th>
                    <th class="text-right">Price</th>
                    <th class="text-right">Amount</th>
                </tr>
            </thead>
            <tbody>
                {if sales_rows | count == 0}
                <tr><td colspan="12" class="px-4 py-10 text-center text-sm text-gray-500">No data for selected range</td></tr>
                {/if}
                {foreach sales_rows as row}
                <tr{if row.status_label == 'no record'} class="bg-gray-50 text-gray-500"{/if}>
                    <td>{if row.status_label == 'no record'}—{else}{row.ledger_date}{/if}</td>
                    <td{if row.status_label == 'no record'} class="bg-gray-100 text-gray-600"{elseif row.status_label != 'official'} class="bg-amber-100 text-amber-800"{/if}>
                        {if row.status_label == 'no record'}
                        <span class="inline-flex items-center rounded-full bg-gray-200 px-2 py-0.5 text-[10px] font-semibold text-gray-700 ring-1 ring-inset ring-gray-300" {if filter_shift != ''}title="No record: no ledger row exists for this product for the {filter_shift} shift in the selected range, so nothing was recorded. Unlike a pending count, there may simply have been no movement; it contributes zero to the totals."{else}title="No record: no ledger row exists for this product anywhere in the selected date range, so nothing was recorded. Unlike a pending count, there may simply have been no movement; it contributes zero to the totals."{/if} aria-label="No record">No record</span>
                        {else}
                        {if row.shift == 'PM'}PM{else}AM{/if}
                        {if row.status_label == 'pending ending'}
                        <span class="ml-1 inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-800 ring-1 ring-inset ring-amber-300" title="Pending count: no ending has been entered for this row; its figures are provisional and excluded from the official total." aria-label="Pending count">Pending count</span>
                        {/if}
                        {if row.status_label == 'provisional'}
                        <span class="ml-1 inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-800 ring-1 ring-inset ring-amber-300" title="Provisional: an ending was entered but the shift is not finalized; excluded from the official total." aria-label="Provisional">Not finalized</span>
                        {/if}
                        {/if}
                    </td>
                    <td>{row.branch_name}</td>
                    <td>{row.product_name}</td>
                    <td class="text-muted text-sm">{row.sku}</td>
                    <td class="text-right">{if row.status_label == 'no record'}—{else}{row.beg_bal}{/if}</td>
                    <td class="text-right">{if row.status_label == 'no record'}—{else}{row.addtl}{/if}</td>
                    <td class="text-right">{if row.status_label == 'no record'}—{else}{row.withdraw}{/if}</td>
                    <td class="text-right">{row.bal_end | default:'—'}</td>
                    <td class="text-right{if row.status_label == 'no record'} text-gray-500{/if}{if row.status_label == 'pending ending' or row.status_label == 'provisional'} bg-amber-100 text-amber-800{/if}"{if row.status_label == 'pending ending'} title="Pending ending: this sales figure is not counted in the official total." aria-label="Sales figure not final: pending ending"{/if}{if row.status_label == 'provisional'} title="Provisional: this sales figure is not counted in the official total." aria-label="Sales figure not final: provisional"{/if}>
                        {if row.status_label == 'no record'}
                        {if filter_shift != ''}<span title="No record: no value was recorded for this product for the {filter_shift} shift in the selected range.">—</span>{else}<span title="No record: no value was recorded for this product anywhere in the selected date range.">—</span>{/if}
                        {/if}
                        {if row.status_label == 'pending ending'}
                        <span title="Not final: no ending entered">{row.sales | default:'—'}</span>
                        {/if}
                        {if row.status_label == 'provisional'}
                        <span title="Not final: shift not finalized">{row.sales | default:'—'}</span>
                        {/if}
                        {if row.status_label == 'official'}
                        {row.sales | default:'—'}
                        {/if}
                    </td>
                    <td class="text-right">{row.price_snapshot | default:'—'}</td>
                    <td class="text-right font-semibold text-emerald-700">{if row.status_label == 'official'}{row.amount | default:'—'}{else}—{/if}</td>
                </tr>
                {/foreach}
                {if sales_rows | count > 0}
                <tr>
                    <td colspan="9" class="text-right font-semibold bg-gray-50 border-t border-gray-200">Official Total:</td>
                    <td class="text-right">{grand_units}</td>
                    <td></td>
                    <td class="text-right font-semibold text-emerald-700">PHP {grand_amount | number_format}</td>
                </tr>
                {if provisional_units > 0}
                <tr>
                    <td colspan="10" class="text-right bg-amber-50/50 border-t border-gray-200 text-xs text-amber-800">Pending (not counted yet): {provisional_units} units — no amount is shown because these figures are not counted in the official total.</td>
                    <td></td>
                    <td class="text-right text-xs text-amber-800">—</td>
                </tr>
                {/if}
                {/if}
            </tbody>
        </table>
    </div>
</div>
{/block}

{block scripts}
<script>
    function printSalesSummary() {
        var el = document.getElementById('print-generated-at-sales');
        if (el) {
            el.textContent = 'Printed At: ' + new Date().toLocaleString();
        }
        window.print();
    }
</script>
{/block}
