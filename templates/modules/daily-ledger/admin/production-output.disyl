{extends "modules/daily-ledger/layouts/app.disyl"}

{block head}
<style>
    .print-only {
        display: none;
    }
    @media print {
        .print-hide {
            display: none !important;
        }
        .print-only {
            display: block !important;
        }
        .card {
            border: none !important;
            box-shadow: none !important;
        }
        body {
            background: #fff !important;
        }
    }
</style>
{/block}

{block content}
<div class="flex items-center justify-between mb-6">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">Production Output</h2>
        <p class="text-sm text-gray-500">Encode output using batch count with per-product yield profile.</p>
        <p class="text-xs text-gray-500 mt-1">
            Business date: <span class="font-medium text-gray-700">{business_date_label}</span>
            · Timezone: <span class="font-medium text-gray-700">{operating_timezone}</span>
            · Region: <span class="font-medium text-gray-700">{operating_region}</span>
        </p>
        <div class="mt-2">
            <span class="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-800 ring-1 ring-inset ring-amber-300">
                Cutoff: {close_of_day_time}
            </span>
        </div>
    </div>
    <button type="button" class="btn btn-outline print-hide" onclick="printOutputLedger()">Print</button>
</div>

<div class="mb-6 grid gap-3 lg:grid-cols-3">
    <a href="{base_url}/admin/production-output" class="rounded-lg border border-emerald-200 bg-emerald-50 p-4 ring-1 ring-inset ring-emerald-200">
        <div class="text-xs font-semibold uppercase tracking-wide text-emerald-700">Upstream</div>
        <div class="mt-1 text-sm font-semibold text-emerald-900">1. Production Output</div>
        <p class="mt-1 text-xs leading-5 text-emerald-800">Start the branch flow here. Encoded output should create or update the DR that downstream steps follow.</p>
    </a>
    <a href="{base_url}/admin/deliveries" class="rounded-lg border border-slate-200 bg-slate-50 p-4 hover:border-slate-300 hover:bg-slate-100">
        <div class="text-xs font-semibold uppercase tracking-wide text-slate-600">Bridge</div>
        <div class="mt-1 text-sm font-semibold text-slate-900">2. Deliveries</div>
        <p class="mt-1 text-xs leading-5 text-slate-700">Confirm the DR leg in the middle. This is the handoff between output upstream and withdrawal downstream.</p>
    </a>
    <a href="{base_url}/admin/production" class="rounded-lg border border-indigo-200 bg-indigo-50 p-4 hover:border-indigo-300 hover:bg-indigo-100">
        <div class="text-xs font-semibold uppercase tracking-wide text-indigo-700">Downstream</div>
        <div class="mt-1 text-sm font-semibold text-indigo-900">3. Production Withdrawal</div>
        <p class="mt-1 text-xs leading-5 text-indigo-800">Use branch withdrawal after the output and delivery are already in place for the same branch flow.</p>
    </a>
</div>

{if can_production_output}
<div class="card mb-6">
    <div class="card-header">
        <span>Output Batch</span>
        <span class="text-sm text-muted">Select branch, then enter batch count or qty per product</span>
    </div>
    <div class="card-body">
        {if branches | count == 0}
        <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            No branch assignment found for this account.
        </div>
        {/if}

        {if branches | count > 0}
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-4 mb-4">
            <div class="form-group mb-0">
                <label class="form-label">Branch</label>
                <select id="output-branch-id" class="form-input font-semibold">
                    <option value="">-- Select Branch --</option>
                    {foreach branches as br}
                    <option value="{br.id}">{br.name} ({br.code}){if br.area} · {br.area}{/if}</option>
                    {/foreach}
                </select>
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Ledger Date</label>
                <input type="date" id="output-ledger-date" class="form-input" value="{ledger_date}">
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Reason</label>
                <input type="text" id="output-reason" class="form-input" placeholder="Optional output note">
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Delivery Receipt #</label>
                <input type="text" id="output-dr-number" class="form-input" placeholder="Required for branch-directed output under formal workflow">
            </div>
        </div>

        <div class="border-b border-gray-200 mb-0">
            <nav class="flex gap-0 -mb-px">
                <button type="button" id="out-tab-bread" onclick="switchOutputTab('bread')"
                    class="px-4 py-2 text-sm font-medium border-b-2 border-indigo-500 text-indigo-600">Bread</button>
                <button type="button" id="out-tab-cake" onclick="switchOutputTab('cake')"
                    class="px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700">Cakes</button>
            </nav>
        </div>

        <div class="table-wrap mb-4">
            <table>
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th class="text-center">Yield Profile</th>
                        <th class="px-2 text-left">Batch Count</th>
                        <th class="px-2 text-left">Qty (pcs)</th>
                    </tr>
                </thead>
                <tbody id="out-tbody-bread" class="divide-y divide-gray-100">
                    {foreach product_rows_bread as p}
                    <tr data-pid="{p.id}" data-oppb="{p.output_pieces_per_batch | default:0}">
                        <td class="font-medium">{p.name}</td>
                        <td class="font-mono text-sm text-muted">{p.sku}</td>
                        <td class="text-center text-sm text-muted">
                            {if p.output_pieces_per_batch > 0}1 batch = {p.output_pieces_per_batch} {p.output_unit_label | default:'pcs'}{/if}
                            {if p.output_pieces_per_batch <= 0}<span class="text-xs text-amber-500">No profile</span>{/if}
                        </td>
                        <td class="px-2 py-1 text-right">
                            <input type="number" min="0" step="0.5" class="form-input text-right output-batch-input w-28"
                                id="out-batch-{p.id}" value="" placeholder="0"
                                oninput="onOutputBatchChange({p.id})" onchange="onOutputBatchChange({p.id})">
                        </td>
                        <td class="px-2 py-1 text-right">
                            <input type="number" min="0" step="1" class="form-input text-right output-qty-input w-28"
                                id="out-qty-{p.id}" value="" placeholder="0"
                                oninput="onOutputQtyChange({p.id})" onchange="onOutputQtyChange({p.id})">
                        </td>
                    </tr>
                    {/foreach}
                    {if product_rows_bread | count == 0}
                    <tr><td colspan="5" class="px-4 py-6 text-center text-sm text-gray-500">No bread products configured.</td></tr>
                    {/if}
                </tbody>
                <tbody id="out-tbody-cake" class="divide-y divide-gray-100 hidden">
                    {foreach product_rows_cake as p}
                    <tr data-pid="{p.id}" data-oppb="{p.output_pieces_per_batch | default:0}">
                        <td class="font-medium">{p.name}</td>
                        <td class="font-mono text-sm text-muted">{p.sku}</td>
                        <td class="text-center text-sm text-muted">
                            {if p.output_pieces_per_batch > 0}1 batch = {p.output_pieces_per_batch} {p.output_unit_label | default:'pcs'}{/if}
                            {if p.output_pieces_per_batch <= 0}<span class="text-xs text-amber-500">No profile</span>{/if}
                        </td>
                        <td class="px-2 py-1 text-right">
                            <input type="number" min="0" step="0.5" class="form-input text-right output-batch-input w-28"
                                id="out-batch-{p.id}" value="" placeholder="0"
                                oninput="onOutputBatchChange({p.id})" onchange="onOutputBatchChange({p.id})">
                        </td>
                        <td class="px-2 py-1 text-right">
                            <input type="number" min="0" step="1" class="form-input text-right output-qty-input w-28"
                                id="out-qty-{p.id}" value="" placeholder="0"
                                oninput="onOutputQtyChange({p.id})" onchange="onOutputQtyChange({p.id})">
                        </td>
                    </tr>
                    {/foreach}
                    {if product_rows_cake | count == 0}
                    <tr><td colspan="5" class="px-4 py-6 text-center text-sm text-gray-500">No cake products configured.</td></tr>
                    {/if}
                </tbody>
            </table>
        </div>

        <div class="flex items-center justify-end gap-2">
            <button type="button" class="btn btn-outline" onclick="resetOutputBatches()">Reset</button>
            <button type="button" class="btn btn-primary" id="submit-output" onclick="submitOutputByBatch()">Submit Output</button>
        </div>
        {/if}
    </div>
</div>
{/if}

{if !can_production_output}
<div class="card mb-6">
    <div class="card-body">
        <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            Production Output (batch-count mode) is disabled. Ask the Settings Admin (superadmin) to activate it from Feature Settings.
        </div>
    </div>
</div>
{/if}

<form class="card mb-6" action="{base_url}/admin/production-output" method="GET">
    <div class="card-body">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-4 items-end">
            <div class="form-group mb-0">
                <label class="form-label">From</label>
                <input type="date" class="form-input" name="date_from" value="{date_from}">
            </div>
            <div class="form-group mb-0">
                <label class="form-label">To</label>
                <input type="date" class="form-input" name="date_to" value="{date_to}">
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Ledger Date</label>
                <input type="date" class="form-input" name="ledger_date" value="{ledger_date}">
            </div>
            <button type="submit" class="btn btn-outline">Refresh History</button>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-header">
        <span>Recent Output Movements</span>
        <span class="text-sm text-muted">{movement_rows | count} rows</span>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Created</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Area</th>
                    <th>Branch</th>
                    <th>Product</th>
                    <th>Flow</th>
                    <th class="text-right">Qty</th>
                    <th>DR #</th>
                    <th>Reason</th>
                    <th>Actor</th>
                </tr>
            </thead>
            <tbody>
                {if movement_rows | count == 0}
                <tr><td colspan="11" class="px-4 py-10 text-center text-sm text-gray-500">No output movement history in selected range.</td></tr>
                {/if}
                {foreach movement_rows as row}
                <tr data-movement-type="{row.movement_type}">
                    <td>{row.created_at}</td>
                    <td>{row.ledger_date}</td>
                    <td>
                        <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset
                            {if row.movement_type == 'output'}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}
                            {if row.movement_type == 'reverse'}bg-rose-50 text-rose-700 ring-rose-200{/if}
                            {if row.movement_type == 'paper_dr_capture'}bg-amber-50 text-amber-800 ring-amber-300{/if}
                        ">
                            {if row.movement_type == 'paper_dr_capture'}paper DR{/if}
                            {if row.movement_type != 'paper_dr_capture'}{row.movement_type}{/if}
                        </span>
                    </td>
                    <td>{row.destination_name} <span class="text-muted">({row.destination_code})</span></td>
                    <td class="text-sm text-muted">{row.destination_area}</td>
                    <td>{row.product_name} <span class="text-muted">({row.sku})</span></td>
                    <td>{row.flow_mode}</td>
                    <td class="text-right font-semibold">{row.quantity}</td>
                    <td class="text-sm text-muted">{row.dr_number | default:'—'}</td>
                    <td class="text-sm text-muted">{row.override_reason}</td>
                    <td class="text-sm text-muted">{row.created_by_role}</td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>
</div>
{/block}

{block scripts}
<script>
    function switchOutputTab(tab) {
        var breadBody = document.getElementById('out-tbody-bread');
        var cakeBody  = document.getElementById('out-tbody-cake');
        var tabBread  = document.getElementById('out-tab-bread');
        var tabCake   = document.getElementById('out-tab-cake');
        if (tab === 'bread') {
            if (breadBody) breadBody.classList.remove('hidden');
            if (cakeBody)  cakeBody.classList.add('hidden');
            if (tabBread) { tabBread.classList.add('border-indigo-500', 'text-indigo-600'); tabBread.classList.remove('border-transparent', 'text-gray-500'); }
            if (tabCake)  { tabCake.classList.remove('border-indigo-500', 'text-indigo-600'); tabCake.classList.add('border-transparent', 'text-gray-500'); }
        } else {
            if (cakeBody)  cakeBody.classList.remove('hidden');
            if (breadBody) breadBody.classList.add('hidden');
            if (tabCake)  { tabCake.classList.add('border-indigo-500', 'text-indigo-600'); tabCake.classList.remove('border-transparent', 'text-gray-500'); }
            if (tabBread) { tabBread.classList.remove('border-indigo-500', 'text-indigo-600'); tabBread.classList.add('border-transparent', 'text-gray-500'); }
        }
    }

    function onOutputBatchChange(pid) {
        var batchEl = document.getElementById('out-batch-' + pid);
        var qtyEl   = document.getElementById('out-qty-'   + pid);
        var row     = document.querySelector('tr[data-pid="' + pid + '"]');
        if (!batchEl || !row) return;
        var oppb    = parseFloat(row.getAttribute('data-oppb') || '0');
        var batches = parseFloat(batchEl.value) || 0;
        if (oppb > 0 && qtyEl) {
            qtyEl.value = batches > 0 ? Math.round(batches * oppb) : '';
        }
    }

    function onOutputQtyChange(pid) {
        var batchEl = document.getElementById('out-batch-' + pid);
        var qtyEl   = document.getElementById('out-qty-'   + pid);
        var row     = document.querySelector('tr[data-pid="' + pid + '"]');
        if (!qtyEl || !row) return;
        var oppb = parseFloat(row.getAttribute('data-oppb') || '0');
        var qty  = parseFloat(qtyEl.value) || 0;
        if (oppb > 0 && batchEl) {
            batchEl.value = qty > 0 ? Math.round(qty / oppb * 100) / 100 : '';
        }
    }

    function resetOutputBatches() {
        document.querySelectorAll('.output-batch-input, .output-qty-input').forEach(function(el) {
            el.value = '';
        });
    }

    function submitOutputByBatch() {
        var btn = document.getElementById('submit-output');
        if (!btn) return;
        var branchId   = parseInt((document.getElementById('output-branch-id')  || {}).value || '0', 10) || 0;
        var ledgerDate = (document.getElementById('output-ledger-date') || {}).value || '';
        var flowMode   = 'production';
        var reason     = ((document.getElementById('output-reason')     || {}).value || '').trim();
        var drNumber   = ((document.getElementById('output-dr-number')  || {}).value || '').trim();

        if (!branchId)   { showToast('Select a branch first', 'error'); return; }
        if (!ledgerDate) { showToast('Ledger date is required', 'error'); return; }

        var operations = [];
        var now = Date.now();
        var idx = 0;
        document.querySelectorAll('tr[data-pid]').forEach(function(row) {
            var pid  = parseInt(row.getAttribute('data-pid'), 10) || 0;
            var oppb = parseFloat(row.getAttribute('data-oppb') || '0');
            if (!pid) return;
            var batchEl = document.getElementById('out-batch-' + pid);
            var qtyEl   = document.getElementById('out-qty-'   + pid);
            var qty = 0;
            if (qtyEl && qtyEl.value !== '' && parseFloat(qtyEl.value) > 0) {
                qty = Math.round(parseFloat(qtyEl.value));
            } else if (batchEl && batchEl.value !== '' && parseFloat(batchEl.value) > 0 && oppb > 0) {
                qty = Math.round(parseFloat(batchEl.value) * oppb);
            }
            if (qty <= 0) return;
            operations.push({
                type: 'output',
                destination_branch_id: branchId,
                product_id: pid,
                ledger_date: ledgerDate,
                quantity: qty,
                flow_mode: flowMode,
                dr_number: drNumber,
                reason: reason,
                client_op_id: 'out-' + now + '-' + pid + '-' + (idx++)
            });
        });

        if (operations.length === 0) {
            showToast('Enter at least one product batch count or qty greater than 0', 'error');
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Submitting...';

        fetch('{base_url}/api/v1/production/sync-batch', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': (window.DL_CSRF || ''),
                'Authorization': (window.DL_TOKEN ? ('Bearer ' + window.DL_TOKEN) : '')
            },
            body: JSON.stringify({ operations: operations })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (!res.ok) {
                showToast(res.error || 'Failed to submit output', 'error');
                return;
            }
            var summary = res.summary || { succeeded: 0, failed: 0 };
            var msg = 'Output synced: ' + summary.succeeded + ' success';
            if (summary.failed > 0) msg += ', ' + summary.failed + ' failed';
            showToast(msg, summary.failed > 0 ? 'error' : 'success');
            setTimeout(function() { window.location.reload(); }, 700);
        })
        .catch(function() {
            showToast('Network error while submitting output', 'error');
        })
        .finally(function() {
            btn.disabled = false;
            btn.textContent = 'Submit Output';
        });
    }

    function printOutputLedger() {
        var rows = Array.from(document.querySelectorAll('tr[data-movement-type="output"], tr[data-movement-type="reverse"], tr[data-movement-type="paper_dr_capture"]'));
        if (rows.length === 0) {
            showToast('No output movement rows to print in current range.', 'error');
            return;
        }

        var printedAt = new Date().toLocaleString();
        var htmlRows = rows.map(function(row) {
            var cells = row.querySelectorAll('td');
            if (!cells || cells.length < 11) return '';
            return '<tr>' +
                '<td>' + cells[0].textContent.trim() + '</td>' +
                '<td>' + cells[1].textContent.trim() + '</td>' +
                '<td>' + cells[2].textContent.trim() + '</td>' +
                '<td>' + cells[3].textContent.trim() + '</td>' +
                '<td>' + cells[4].textContent.trim() + '</td>' +
                '<td style="text-align:right;">' + cells[7].textContent.trim() + '</td>' +
                '<td>' + cells[8].textContent.trim() + '</td>' +
                '<td>' + cells[9].textContent.trim() + '</td>' +
                '<td>' + cells[10].textContent.trim() + '</td>' +
                '</tr>';
        }).join('');

        var reportHtml = '<!doctype html><html><head><meta charset="utf-8">' +
            '<title>Production Output Report</title>' +
            '<style>' +
{literal}            'body{font-family:Arial,sans-serif;color:#111827;margin:24px;}' +
            'h1{font-size:20px;margin:0 0 8px;}' +
            '.meta{font-size:13px;color:#374151;margin:2px 0;}' +
            'table{width:100%;border-collapse:collapse;margin-top:16px;}' +
            'th,td{border:1px solid #d1d5db;padding:8px;font-size:12px;vertical-align:top;}' +
            'th{background:#f3f4f6;text-align:left;}' +
            '.right{text-align:right;}' +
{/literal}            '</style></head><body>' +
            '<h1>Production Output Report</h1>' +
            '<div class="meta">Ledger Date: {ledger_date}</div>' +
            '<div class="meta">History Range: {date_from} to {date_to}</div>' +
            '<div class="meta">Prepared By: {user_name} ({user_role})</div>' +
            '<div class="meta">Printed At: ' + printedAt + '</div>' +
            '<table><thead><tr>' +
            '<th>Created</th><th>Date</th><th>Type</th><th>Branch</th><th>Product</th><th class="right">Qty</th><th>DR #</th><th>Reason</th><th>Actor</th>' +
            '</tr></thead><tbody>' + htmlRows + '</tbody></table>' +
            '</body></html>';

        var w = window.open('', '_blank', 'width=1024,height=768');
        if (!w) {
            showToast('Popup blocked. Please allow popups for printing.', 'error');
            return;
        }
        w.document.open();
        w.document.write(reportHtml);
        w.document.close();
        w.focus();
        w.print();
    }
</script>
{/block}
