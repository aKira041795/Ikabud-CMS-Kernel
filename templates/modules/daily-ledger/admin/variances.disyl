{# COUPLING: this shell is a copy of templates/modules/daily-ledger/layouts/app.disyl — change that layout and this file together; daily_ledger_shell_drift_guard_test.php enforces it. #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title | default:'Daily Ledger'}</title>
    <link rel="icon" href="{resolved_favicon_url}">
    <link rel="manifest" href="/daily-ledger/manifest.webmanifest">
    <meta name="theme-color" content="#4f46e5">

    <script src="/daily-ledger/assets/tailwindcss.js"></script>
    <link rel="stylesheet" href="/daily-ledger/assets/fontawesome/all.min.css">
    <script src="/daily-ledger/assets/htmx-1.9.10.min.js"></script>
    <script defer src="/daily-ledger/assets/alpine-3.min.js"></script>

    <style>
        [x-cloak] { display: none !important; }

        .btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; border-radius: 3px; padding: .5rem .75rem; font-size: .875rem; font-weight: 600; transition: background-color .15s, border-color .15s, color .15s, box-shadow .15s; box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
        .btn:focus-visible { outline: 2px solid transparent; outline-offset: 2px; box-shadow: 0 0 0 3px rgba(99,102,241,.25); }
        .btn-sm { padding: .25rem .5rem; font-size: .75rem; }
        .btn-primary { background: rgb(79 70 229); color: #fff; }
        .btn-primary:hover { background: rgb(67 56 202); }
        .btn-outline { background: #fff; color: rgb(15 23 42); border: 1px solid rgb(203 213 225); }
        .btn-outline:hover { background: rgb(249 250 251); }
        .btn-danger { background: rgb(225 29 72); color: #fff; }
        .btn-danger:hover { background: rgb(190 18 60); }

        button,
        input:not([type='checkbox']):not([type='radio']):not([type='range']),
        select,
        textarea {
            border-radius: 3px !important;
        }

        .form-label { display: block; font-size: .875rem; font-weight: 500; color: rgb(31 41 55); }
        .form-input { margin-top: .25rem; display: block; width: 100%; border-radius: 3px; border: 1px solid rgb(203 213 225); background: #fff; padding: .5rem .75rem; font-size: .875rem; color: rgb(15 23 42); box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
        .form-input:focus { outline: none; border-color: rgb(99 102 241); box-shadow: 0 0 0 3px rgba(99,102,241,.22); }
        .form-input::placeholder { color: rgb(100 116 139); }
        .form-group { margin-bottom: 1rem; }

        .card { border-radius: 3px; border: 1px solid rgb(226 232 240); background: #fff; color: rgb(15 23 42); box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
        .card-header { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgb(226 232 240); padding: .75rem 1rem; font-size: .875rem; font-weight: 600; color: rgb(15 23 42); }
        .card-body { padding: 1rem; color: rgb(15 23 42); }

        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        thead th { white-space: nowrap; border-bottom: 1px solid rgb(226 232 240); background: rgb(248 250 252); padding: .75rem 1rem; text-align: left; font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: rgb(51 65 85); }
        tbody td { border-bottom: 1px solid rgb(241 245 249); padding: .75rem 1rem; font-size: .875rem; color: rgb(15 23 42); }
        tbody tr:hover { background: rgb(249 250 251); }

        .text-left { text-align: left; }
        .text-center { text-align: center; }
        .text-right { text-align: right; }

        .text-muted { color: rgb(71 85 105); }

        .modal-overlay { position: fixed; inset: 0; z-index: 300; display: none; align-items: center; justify-content: center; background: rgba(0,0,0,.4); padding: 1rem; }
        .modal-overlay.show { display: flex; }
        .modal { width: 100%; max-width: 32rem; border-radius: 3px; background: #fff; color: rgb(15 23 42); padding: 1.5rem; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); border: 1px solid rgba(0,0,0,0.05); }
        .modal h3 { margin-bottom: 1rem; font-size: 1rem; font-weight: 600; color: rgb(15 23 42); }
        .modal-actions { margin-top: 1.5rem; display: flex; align-items: center; justify-content: flex-end; gap: .5rem; }

        .card .text-gray-500,
        .card .text-gray-600,
        .card .text-gray-400,
        .modal .text-gray-500,
        .modal .text-gray-600,
        .modal .text-gray-400,
        .bg-white .text-gray-500,
        .bg-white .text-gray-600,
        .bg-white .text-gray-400 {
            color: rgb(71 85 105);
        }

        .card .text-gray-700,
        .modal .text-gray-700,
        .bg-white .text-gray-700,
        .card .text-gray-800,
        .modal .text-gray-800,
        .bg-white .text-gray-800,
        .card .text-gray-900,
        .modal .text-gray-900,
        .bg-white .text-gray-900 {
            color: rgb(15 23 42);
        }

        /* Daily Ledger ledger-row cells. These mirror the Tailwind utilities they
           replace so the grid renders identically, while removing ~1.1KB of repeated
           class text from each of 174 rows (class attributes were 41% of the rows
           payload, which is re-sent on every ledger view). */
        .ledger-cell { display: block; margin: 0 0 0 auto; min-height: 2.75rem; width: 5rem; border: 1px solid rgb(209 213 219); background: #fff; padding: .5rem; text-align: right; font-size: .875rem; line-height: 1.25rem; color: rgb(15 23 42); box-shadow: 0 1px 2px rgba(0,0,0,.05); }
        .ledger-cell:focus { outline: none; border-color: rgb(99 102 241); box-shadow: inset 0 0 0 3px rgba(99,102,241,.22); }
        .ledger-chip { margin-left: auto; display: inline-flex; width: 5rem; justify-content: flex-end; border-radius: .5rem; padding: .375rem .5rem; font-size: .875rem; line-height: 1.25rem; font-weight: 600; color: rgb(15 23 42); background: rgb(249 250 251); box-shadow: inset 0 0 0 1px rgb(229 231 235); }
        .ledger-chip-pending { color: rgb(180 83 9); background: rgb(255 251 235); box-shadow: inset 0 0 0 1px rgb(253 230 138); }
        .ledger-trigger { margin-left: auto; display: inline-flex; width: 5rem; align-items: center; justify-content: flex-end; gap: .25rem; border-style: solid; border-width: 1px; border-radius: 3px; padding: .375rem .5rem; font-size: .875rem; line-height: 1.25rem; font-weight: 600; }
        .ledger-trigger-add { border-color: rgb(110 231 183); background: rgb(236 253 245); color: rgb(6 95 70); box-shadow: inset 0 0 0 1px rgb(167 243 208), 0 1px 2px rgba(0,0,0,.05); }
        .ledger-trigger-add:hover { background: rgb(209 250 229); }
        .ledger-trigger-out { border-color: rgb(252 211 77); background: rgb(255 251 235); color: rgb(146 64 14); box-shadow: inset 0 0 0 1px rgb(253 230 138), 0 1px 2px rgba(0,0,0,.05); }
        .ledger-trigger-out:hover { background: rgb(254 243 199); }
        .ledger-num { width: 3.5rem; white-space: nowrap; text-align: center; vertical-align: middle; font-size: .875rem; color: rgb(71 85 105); }
        .ledger-name { white-space: nowrap; vertical-align: middle; font-weight: 500; font-size: .875rem; color: rgb(15 23 42); }
    </style>

    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function() {
                navigator.serviceWorker.register('/daily-ledger/sw.js')
                .then(function(reg) {
                    // Ensure the newest worker takes control on first launch so
                    // the offline shell is reachable without a manual reload.
                    if (reg.waiting && navigator.serviceWorker.controller) {
                        reg.waiting.postMessage({ type: 'SKIP_WAITING' });
                    }
                    return navigator.serviceWorker.ready;
                })
                .then(function() {
                    if (navigator.serviceWorker.controller) {
                        navigator.serviceWorker.controller.postMessage({ type: 'DL_CONTROLLED' });
                    }
                })
                .catch(function(error) {
                    console.warn('Daily Ledger service worker registration failed', error);
                });
            });

            // Launch messaging: the online ledger tells a concurrently open
            // offline shell to re-lock after enrollment or logout. The shell
            // (offline-app.js) listens for these on navigator.serviceWorker.
            window.dlNotifyOfflineActivated = function() {
                if (navigator.serviceWorker && navigator.serviceWorker.controller) {
                    navigator.serviceWorker.controller.postMessage({ type: 'dl-offline-activated' });
                }
            };
            window.dlNotifyOfflineLocked = function() {
                if (navigator.serviceWorker && navigator.serviceWorker.controller) {
                    navigator.serviceWorker.controller.postMessage({ type: 'dl-offline-locked' });
                }
            };
        } else {
            window.dlNotifyOfflineActivated = function() {};
            window.dlNotifyOfflineLocked = function() {};
        }

        window.DL_BASE = '/daily-ledger';
        window.DL_CSRF = '{csrf_token}';
        window.DL_TOKEN = '{dl_token}';
        window.DL_OFFLINE_SHELL = false;
        window.DL_USER_ID = '{dl_user_id | default:''}';
        window.DL_TENANT_SCOPE = '{tenant_scope | default:''}';
        window.showToast = function(message, type) {
            try {
                var cont = document.getElementById('toast-container');
                if (!cont) return;

                var el = document.createElement('div');
                // Colour carries the outcome, so a cashier can read the result at a
                // glance without waiting for the (slow) view refresh:
                //   green  = the SERVER accepted it
                //   amber  = queued on this device, NOT yet on the server
                //   red    = the server refused it or the request failed
                //   slate  = purely informational
                // 'queued' must never be green: it is the one outcome the operator
                // cannot otherwise tell apart from a real save, and mistaking it for
                // one is how a lost adjustment gets reported as "it won't add".
                var cls = (type === 'error')
                    ? 'bg-red-600 text-white'
                    : (type === 'success'
                        ? 'bg-emerald-600 text-white'
                        : (type === 'warning' ? 'bg-amber-500 text-white' : 'bg-slate-900 text-white'));
                el.className = 'mb-2 px-4 py-3 rounded-xl shadow text-sm ' + cls;
                el.setAttribute('role', type === 'error' ? 'alert' : 'status');
                el.textContent = String(message || 'OK');
                cont.appendChild(el);

                // A queued entry needs reading time - it is the only notice that the
                // work is not on the server yet.
                setTimeout(function() {
                    if (el && el.parentNode) el.parentNode.removeChild(el);
                }, (type === 'error' || type === 'warning') ? 6000 : 2800);
            } catch (e) {
            }
        };
        window.addEventListener('showToast', function(evt) {
            var d = evt && evt.detail ? evt.detail : null;
            if (!d) return;
            window.showToast(d.message || 'OK', d.type || 'success');
        });

        // ── Bounded writes: a slow transaction FAILS, it is not held ─────────
        // A ledger write is something the operator has to be able to trust. If the
        // server has not answered inside this window we declare it NOT SAVED and say
        // so. Holding it on the device is worse than losing it: an entry the cashier
        // believes is recorded is discovered at close-of-day with no way to tell what
        // happened, whereas a refused one is retried in seconds. Retrying is safe -
        // every write carries an idempotency key (response cached 24h) and
        // dl_cashier_withdrawals has a UNIQUE dedup_hash index, so Retry cannot
        // produce a duplicate.
        window.DL_WRITE_TIMEOUT_MS = 15000;
        window.dlWriteTimeout = function(url, options, label) {
            if (typeof AbortController === 'undefined') return fetch(url, options);
            var controller = new AbortController();
            var opts = {};
            for (var k in options) {
                if (Object.prototype.hasOwnProperty.call(options, k)) opts[k] = options[k];
            }
            opts.signal = controller.signal;
            var timer = setTimeout(function() { controller.abort(); }, window.DL_WRITE_TIMEOUT_MS);
            return fetch(url, opts).then(function(res) {
                clearTimeout(timer);
                return res;
            }, function(err) {
                clearTimeout(timer);
                if (controller.signal.aborted) {
                    var e = new Error('WRITE_TIMEOUT');
                    e.dlTimedOut = true;
                    e.dlLabel = label || 'The change';
                    return Promise.reject(e);
                }
                return Promise.reject(err);
            });
        };
        // Wording matters more than it looks. Aborting the request cancels the
        // CLIENT wait - it does not cancel the work the server already started, so
        // after a timeout we genuinely do not know whether the row landed. Saying
        // "was NOT recorded" asserted something we cannot know, and an operator who
        // believes it will key the same entry again: that repetition is how
        // duplicates get created. So state the uncertainty, and say plainly that
        // Retry is safe, which is what actually stops the hand-re-keying.
        window.dlWriteTimeoutMessage = function(label) {
            return 'No reply in '
                + Math.round(window.DL_WRITE_TIMEOUT_MS / 1000) + 's — it is NOT yet known whether '
                + (label || 'the change') + ' was recorded. Press Retry: it is safe to repeat and '
                + 'will not create a second entry. Do not key it in again.';
        };

        // ── Persistent write-failure notice ──────────────────────────────────
        // A failed ledger write must not be reported only by a toast that vanishes
        // after a few seconds. The operator needs the REASON and a Retry in front of
        // them: without it they either assume it went in, or re-key it by hand - which
        // is exactly how duplicate entries balloon the data.
        window.dlWriteFailureRetry = null;
        window.dlReportWriteFailure = function(reason, retry) {
            var box = document.getElementById('dl-write-failure');
            var text = document.getElementById('dl-write-failure-text');
            var btn = document.getElementById('dl-write-failure-retry');
            if (!box || !text) return;
            window.dlWriteFailureRetry = (typeof retry === 'function') ? retry : null;
            text.textContent = reason || 'The change did not reach the server.';
            if (btn) btn.classList.toggle('hidden', !window.dlWriteFailureRetry);
            box.classList.remove('hidden');
        };
        window.dlClearWriteFailure = function() {
            var box = document.getElementById('dl-write-failure');
            if (box) box.classList.add('hidden');
            window.dlWriteFailureRetry = null;
        };
        // The Retry button calls this rather than running its logic inline, so the failure
        // box keeps a single entry point that can be exercised on its own.
        //
        // An earlier comment here blamed DiSyL for eating the inline braces; that was wrong.
        // DiSyL preserves `{...}` in quoted attributes, so the old inline handler worked.
        // This extraction is a readability change, not a bug fix.
        window.dlRetryWriteFailure = function() {
            if (typeof window.dlWriteFailureRetry !== 'function') return;
            var retry = window.dlWriteFailureRetry; // capture before clearing
            window.dlClearWriteFailure();
            retry();
        };

        // ── Submit feedback ────────────────────────────────────────────────
        // A slow link makes the view refresh lag far behind the request, so the
        // operator cannot tell a saved edit from a failed or merely queued one.
        // These helpers report the outcome as soon as the server answers, which
        // is independent of how long the re-render takes.
        window.dlBusyDepth = 0;
        window.dlBusyWatchdog = null;
        window.dlSetBusy = function(show, label) {
            var box = document.getElementById('dl-busy');
            if (!box) return;
            var text = document.getElementById('dl-busy-label');
            if (show) {
                // Depth counter: rapid, overlapping cell edits keep the indicator
                // visible until the LAST one settles instead of the first
                // completion hiding it while earlier requests are still open.
                window.dlBusyDepth = (window.dlBusyDepth || 0) + 1;
                if (text && label) text.textContent = label;
                box.classList.remove('hidden');
                // Safety net: a permanently stuck indicator would be worse than no
                // indicator at all, so it can never outlive a request that failed
                // to settle. 60s sits just above the server's 50s lock-wait so a
                // legitimately slow save is not cleared early.
                if (window.dlBusyWatchdog !== null) clearTimeout(window.dlBusyWatchdog);
                window.dlBusyWatchdog = setTimeout(function() {
                    window.dlBusyDepth = 0;
                    window.dlBusyWatchdog = null;
                    box.classList.add('hidden');
                }, 60000);
            } else {
                window.dlBusyDepth = Math.max(0, (window.dlBusyDepth || 0) - 1);
                if (window.dlBusyDepth === 0) {
                    box.classList.add('hidden');
                    if (window.dlBusyWatchdog !== null) {
                        clearTimeout(window.dlBusyWatchdog);
                        window.dlBusyWatchdog = null;
                    }
                }
            }
        };
        // Coalesced success notice: tabbing across many cells would otherwise
        // stack one toast per field and bury the screen.
        window.dlToastSaved = function(message) {
            var now = Date.now();
            if (window.dlLastSavedToast && (now - window.dlLastSavedToast) < 1500) return;
            window.dlLastSavedToast = now;
            window.showToast(message || 'Saved', 'success');
        };
        document.addEventListener('htmx:afterSettle', function(evt) {
            var scripts = evt.detail.elt.querySelectorAll('script:not([src])');
            scripts.forEach(function(s) {
                var ns = document.createElement('script');
                ns.textContent = s.textContent;
                s.parentNode.replaceChild(ns, s);
            });
        });
        document.addEventListener('htmx:configRequest', function(evt) {
            var verb = (evt.detail.verb || '').toUpperCase();
            if (verb === 'POST' || verb === 'PUT' || verb === 'PATCH' || verb === 'DELETE') {
                evt.detail.headers['X-CSRF-Token'] = DL_CSRF;
            }
        });
        document.addEventListener('htmx:beforeRequest', function(evt) {
            var path = String((evt.detail && evt.detail.pathInfo && evt.detail.pathInfo.requestPath) || '');
            if (!navigator.onLine && path.indexOf('/daily-ledger/ledger/rows') === 0) {
                evt.preventDefault();
            }
        });
        function maybeShowToastFromHeader(xhr) {
            if (!xhr || typeof xhr.getResponseHeader !== 'function') return;
            var trig = xhr.getResponseHeader('HX-Trigger');
            if (!trig) return;
            try {
                var data = JSON.parse(trig);
                if (data && data.showToast) {
                    window.showToast(data.showToast.message || 'OK', data.showToast.type || 'error');
                }
            } catch (e) {}
        }
        document.addEventListener('htmx:responseError', function(evt) {
            var xhr = evt.detail ? evt.detail.xhr : null;
            maybeShowToastFromHeader(xhr);
            if (xhr && xhr.status) {
                window.showToast('Request failed (' + xhr.status + ')', 'error');
                return;
            }
            window.showToast('Request failed', 'error');
        });
        document.addEventListener('htmx:sendError', function() {
            window.showToast('Network error', 'error');
        });

        /**
         * Deterministic in-place page load: fetch a URL (full page), extract
         * #main-content via DOMParser, and swap it into the live #main-content.
         * Re-runs inline scripts and rebinds htmx. On failure (login redirect,
         * server error, or empty response) it navigates to the URL so the view
         * always recovers.
         *
         * This is the single mechanism for in-place GET navigation. It replaces
         * both htmx.ajax({select}) and hx-select for full-page responses: the
         * bundled htmx version silently produces a BLANK region when hx-select
         * is applied to a full HTML document, even when #main-content exists.
         *
         * Uses the same Bearer auth as the save API calls so authentication
         * cannot differ between a POST that saved and the GET that refreshes.
         */
        window.dlLoadUrl = function(url, usePush) {
            // The ledger owns page-level state and timers outside #main-content.
            // Replacing only its markup leaves the old date/branch and callbacks live.
            var nextPath = new URL(url, window.location.href).pathname;
            if (/\/daily-ledger\/ledger\/?$/.test(nextPath)
                || /\/daily-ledger\/ledger\/?$/.test(window.location.pathname)) {
                window.location.assign(url);
                return;
            }
            var headers = {
                'Accept': 'text/html',
                'X-Requested-With': 'XMLHttpRequest'
            };
            var token = window.DL_TOKEN || '';
            if (token) {
                headers['Authorization'] = 'Bearer ' + token;
            }

            fetch(url, {
                method: 'GET',
                credentials: 'same-origin',
                headers: headers
            })
            .then(function(r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.text();
            })
            .then(function(html) {
                var doc = new DOMParser().parseFromString(html, 'text/html');
                var fresh = doc.getElementById('main-content');
                var target = document.getElementById('main-content');
                if (!fresh || !target || !fresh.innerHTML.trim()) {
                    throw new Error('empty content');
                }
                target.innerHTML = fresh.innerHTML;
                // Re-run inline scripts that were swapped in
                target.querySelectorAll('script:not([src])').forEach(function(s) {
                    var ns = document.createElement('script');
                    ns.textContent = s.textContent;
                    s.parentNode.replaceChild(ns, s);
                });
                // Re-bind hx-* attributes in the new content
                if (typeof htmx !== 'undefined') {
                    htmx.process(target);
                }
                // Keep the URL in sync (back/forward + shareable filters)
                if (window.history) {
                    if (usePush && window.history.pushState) {
                        window.history.pushState({}, '', url);
                    } else if (window.history.replaceState) {
                        window.history.replaceState({}, '', url);
                    }
                }
            })
            .catch(function() {
                // In-place load could not complete — navigate so the view recovers.
                window.location.href = url;
            });
        };

        // Serialize a GET filter form and load it in place (no full reload).
        window.dlLoadForm = function(form) {
            var params = new URLSearchParams(new FormData(form)).toString();
            var url = form.action;
            url += (url.indexOf('?') >= 0 ? '&' : '?') + params;
            window.dlLoadUrl(url, true);
            return false;
        };

        // Unified refresh: re-fetch the current page and swap #main-content.
        window.refreshMainContent = function() {
            window.dlLoadUrl(window.location.href, false);
        };
    </script>

<style>
    .variance-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: .75rem;
        margin-bottom: 1.25rem;
    }
    .variance-stat {
        border-radius: 3px;
        border: 1px solid rgb(226 232 240);
        background: #fff;
        padding: 1rem 1.25rem;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        cursor: pointer;
        transition: box-shadow .15s, border-color .15s;
    }
    .variance-stat:hover {
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .variance-stat--active {
        border-color: rgb(99 102 241);
        box-shadow: 0 0 0 3px rgba(99,102,241,.18);
    }
    .variance-stat-label {
        font-size: .6875rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
    }
    .variance-stat-value {
        margin-top: .25rem;
        font-size: 1.75rem;
        font-weight: 700;
    }
    .variance-stat-sub {
        margin-top: .125rem;
        font-size: .75rem;
    }
    .variance-stat--unreviewed .variance-stat-label { color: rgb(180 83 9); }
    .variance-stat--unreviewed .variance-stat-value { color: rgb(180 83 9); }
    .variance-stat--investigated .variance-stat-label { color: rgb(29 78 216); }
    .variance-stat--investigated .variance-stat-value { color: rgb(29 78 216); }
    .variance-stat--corrected .variance-stat-label { color: rgb(4 120 87); }
    .variance-stat--corrected .variance-stat-value { color: rgb(4 120 87); }
    .variance-stat--total .variance-stat-label { color: rgb(71 85 105); }
    .variance-stat--total .variance-stat-value { color: rgb(15 23 42); }

    .variance-filter-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .5rem;
        margin-bottom: 1rem;
    }
    .variance-filter-pill {
        display: inline-flex;
        align-items: center;
        gap: .375rem;
        border-radius: 999px;
        padding: .35rem .85rem;
        font-size: .8125rem;
        font-weight: 600;
        border: 1px solid rgb(226 232 240);
        background: #fff;
        color: rgb(71 85 105);
        cursor: pointer;
        transition: all .15s;
    }
    .variance-filter-pill:hover { background: rgb(248 250 252); }
    .variance-filter-pill--active {
        background: rgb(238 242 255);
        border-color: rgb(165 180 252);
        color: rgb(67 56 202);
    }
    .variance-filter-pill-count {
        font-size: .6875rem;
        font-weight: 700;
        padding: .1rem .4rem;
        border-radius: 999px;
        background: rgb(241 245 249);
        color: rgb(71 85 105);
    }
    .variance-filter-pill--active .variance-filter-pill-count {
        background: rgb(199 210 254);
        color: rgb(55 48 163);
    }

    .variance-status-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: .2rem .65rem;
        font-size: .6875rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .variance-status-badge--unreviewed {
        background: rgb(254 243 199);
        color: rgb(146 64 14);
        ring: 1px rgb(252 211 77);
    }
    .variance-status-badge--investigated {
        background: rgb(219 234 254);
        color: rgb(30 64 175);
    }
    .variance-status-badge--corrected {
        background: rgb(209 250 229);
        color: rgb(6 95 70);
    }

    .variance-value {
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }
    .variance-value--over { color: rgb(4 120 87); }
    .variance-value--short { color: rgb(190 18 60); }
    .variance-value--zero { color: rgb(148 163 184); }

    /* Branch-grouped view */
    .variance-branch-group {
        border: 1px solid rgb(226 232 240);
        border-radius: 3px;
        background: #fff;
        margin-bottom: .75rem;
        overflow: hidden;
    }
    .variance-branch-group-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .75rem 1rem;
        cursor: pointer;
        background: rgb(248 250 252);
        border-bottom: 1px solid rgb(226 232 240);
        transition: background-color .15s;
        user-select: none;
    }
    .variance-branch-group-header:hover { background: rgb(241 245 249); }
    .variance-branch-group-header--expanded { background: rgb(238 242 255); border-bottom-color: rgb(199 210 254); }
    .variance-branch-group-name {
        font-weight: 600;
        font-size: .9375rem;
        color: rgb(15 23 42);
    }
    .variance-branch-group-metrics {
        display: flex;
        gap: 1rem;
        font-size: .8125rem;
    }
    .variance-branch-group-metric {
        display: flex;
        align-items: center;
        gap: .25rem;
    }
    .variance-branch-group-metric-dot {
        width: 8px; height: 8px; border-radius: 999px;
    }
    .variance-branch-group-metric-dot--unreviewed { background: rgb(245 158 11); }
    .variance-branch-group-metric-dot--investigated { background: rgb(59 130 246); }
    .variance-branch-group-metric-dot--corrected { background: rgb(16 185 129); }
    .variance-branch-group-body { display: none; }
    .variance-branch-group-body--expanded { display: block; }
    .variance-branch-group-body table { margin: 0; }

    /* Bulk actions */
    .variance-bulk-bar {
        display: none;
        align-items: center;
        gap: .75rem;
        padding: .625rem 1rem;
        background: rgb(238 242 255);
        border: 1px solid rgb(199 210 254);
        border-radius: 3px;
        margin-bottom: .75rem;
        font-size: .8125rem;
        font-weight: 500;
        color: rgb(55 48 163);
    }
    .variance-bulk-bar--visible { display: flex; }

    /* View toggle */
    .variance-view-toggle {
        display: inline-flex;
        border-radius: 3px;
        border: 1px solid rgb(203 213 225);
        overflow: hidden;
    }
    .variance-view-toggle-btn {
        padding: .35rem .75rem;
        font-size: .75rem;
        font-weight: 600;
        border: none;
        background: #fff;
        color: rgb(71 85 105);
        cursor: pointer;
        transition: all .15s;
    }
    .variance-view-toggle-btn:not(:last-child) { border-right: 1px solid rgb(203 213 225); }
    .variance-view-toggle-btn--active { background: rgb(79 70 229); color: #fff; }
    .variance-view-toggle-btn:hover:not(.variance-view-toggle-btn--active) { background: rgb(248 250 252); }

    @media (max-width: 767px) {
        .variance-stat-grid { grid-template-columns: repeat(2, 1fr); }
        .variance-branch-group-metrics { display: none; }
        .variance-branch-group-header { flex-wrap: wrap; gap: .5rem; }
    }
</style>

</head>
<body class="min-h-screen bg-slate-50" x-data="{ sidebarOpen: false }" data-wb-component="app-shell">

    <div id="toast-container" class="fixed top-4 right-4 z-50" role="status" aria-live="polite"></div>

    <!-- Persistent write-failure notice. See window.dlReportWriteFailure. -->
    <div id="dl-write-failure" class="hidden fixed bottom-4 left-1/2 z-[60] w-[min(46rem,calc(100vw-2rem))] -translate-x-1/2 rounded-xl border border-red-300 bg-red-50 px-4 py-3 shadow-2xl" role="alert" aria-live="assertive">
        <div class="flex items-start gap-3">
            <i class="fas fa-triangle-exclamation mt-1 text-red-600" aria-hidden="true"></i>
            <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold text-red-900">Not saved</p>
                <p id="dl-write-failure-text" class="mt-1 text-xs leading-5 text-red-800"></p>
            </div>
            <div class="flex shrink-0 items-center gap-2">
                <button type="button" id="dl-write-failure-retry" class="btn btn-primary btn-sm" onclick="window.dlRetryWriteFailure()">Retry — safe, will not duplicate</button>
                <button type="button" class="btn btn-outline btn-sm" onclick="window.dlClearWriteFailure()">Dismiss</button>
            </div>
        </div>
    </div>

    <!-- In-flight indicator. Deliberately non-blocking (pointer-events-none): on a
         slow link a modal overlay would freeze the cashier for the whole request,
         which is worse than the ambiguity it removes. It is visually
         unmistakable, so a send is never silent. -->
    <div id="dl-busy" class="hidden fixed inset-0 z-40 flex items-center justify-center pointer-events-none" aria-hidden="true">
        <div class="absolute inset-0 bg-slate-900/30"></div>
        <div class="relative flex items-center gap-3 rounded-xl bg-slate-900/95 px-5 py-4 text-sm font-semibold text-white shadow-2xl">
            <svg class="h-5 w-5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
            </svg>
            <span id="dl-busy-label">Saving…</span>
        </div>
    </div>

    <div class="flex h-screen overflow-hidden">
        <aside id="wb-sidebar" class="relative flex flex-col bg-gradient-to-b from-indigo-700 to-indigo-900 text-white transition-all duration-300" :class="sidebarOpen ? 'w-64' : 'w-20'" role="navigation" aria-label="Sidebar navigation">
            <div class="flex h-16 items-center gap-3 px-4 border-b border-white/10 flex-shrink-0">
                <div class="h-9 w-9 rounded-xl bg-white/10 flex items-center justify-center ring-1 ring-white/10">
                    {if logo_url}
                    <img src="{logo_url}" alt="{app_name} logo" class="h-8 w-8 rounded-lg object-contain">
                    {/if}
                    {if !logo_url}
                    <i class="fas fa-receipt text-lg" aria-hidden="true"></i>
                    {/if}
                </div>
                <span class="font-semibold text-base tracking-tight" x-show="sidebarOpen" x-cloak>{app_name}</span>
		<button type="button" class="ml-auto p-1.5 rounded-lg hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/30"
			@click="sidebarOpen = !sidebarOpen"
			:aria-label="sidebarOpen ? 'Collapse sidebar' : 'Expand sidebar'"
			:aria-expanded="sidebarOpen ? 'true' : 'false'">
		    <i class="fas fa-bars" aria-hidden="true"></i>
		</button>
            </div>

            {* Collapsed sidebar is icon-only, so each menu item needs a visible hint. The label is
               read from the item's own aria-label rather than duplicated here, so a new menu item
               only has to declare its aria-label once and still gets a tooltip. *}
            <nav class="mt-4 px-2 flex-1 overflow-y-auto">
                {if user_role == 'cashier' || user_role == 'supervisor' || user_role == 'admin'}
                <a href="{base_url}/ledger"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'ledger'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Ledger">
                    <i class="fas fa-clipboard-list w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Ledger</span>
                </a>
                {/if}

                {if feature_pos && (user_role == 'cashier' || user_role == 'supervisor' || user_role == 'admin')}
                <a href="{base_url}/pos"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'pos'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Point of Sale">
                    <i class="fas fa-cash-register w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>POS</span>
                </a>
                {/if}

                {if user_role == 'admin' || user_role == 'supervisor' || user_role == 'auditor' || user_role == 'viewer'}
                <a href="{base_url}/admin/overview"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'overview'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Business Overview">
                    <i class="fas fa-chart-pie w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Overview</span>
                </a>
                {/if}

                {if user_role == 'admin' || user_role == 'supervisor' || user_role == 'auditor'}
                <a href="{base_url}/admin/dashboard"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'dashboard'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Dashboard">
                    <i class="fas fa-chart-line w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Dashboard</span>
                </a>

                <a href="{base_url}/admin/sales"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'sales'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Sales">
                    <i class="fas fa-chart-bar w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Sales</span>
                </a>

                <a href="{base_url}/admin/consignee-dispatch-report"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'consignee_dispatch'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Consignee Dispatch Report">
                    <i class="fas fa-file-invoice w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Consignee Dispatch</span>
                </a>

                {if feature_pos}
                <a href="{base_url}/admin/pos-sales"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'pos_sales'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="POS Sales">
                    <i class="fas fa-receipt w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>POS Sales</span>
                </a>
                {/if}

                <a href="{base_url}/admin/variances"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'variances'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Variances">
                    <i class="fas fa-triangle-exclamation w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Variances</span>
                </a>

                <a href="{base_url}/admin/reconciliation"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'reconciliation'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Cash and Paper Check">
                    <i class="fas fa-money-bill-wave w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Cash &amp; Paper Check</span>
                </a>
                {/if}

                <!-- Reports are read-only PDF/CSV exports, so the business owner
                     (viewer) sees them alongside the operations roles. -->
                {if user_role == 'admin' || user_role == 'supervisor' || user_role == 'auditor' || user_role == 'viewer'}
                <a href="{base_url}/admin/reports"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'reports'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Reports">
                    <i class="fas fa-file-pdf w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Reports</span>
                </a>
                {/if}

                {if user_role == 'admin' || user_role == 'supervisor' || user_role == 'auditor'}
                <a href="{base_url}/admin/forecast"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'forecast'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Production Forecast">
                    <i class="fas fa-chart-line w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Forecast</span>
                </a>

                <a href="{base_url}/admin/activity"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'activity'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Activity">
                    <i class="fas fa-clock-rotate-left w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Activity</span>
                </a>
                {/if}

                {if user_role == 'admin' || user_role == 'supervisor' || user_role == 'production_in_charge'}
                <a href="{base_url}/admin/commissary"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'commissary'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Commissary">
                    <i class="fas fa-wheat w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Commissary</span>
                </a>

                     {if feature_formal_delivery && (user_role == 'admin' || user_role == 'supervisor')}
                     <a href="{base_url}/admin/deliveries"
                         class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'deliveries'}bg-white/10 ring-1 ring-white/10{/if}"
                         aria-label="Deliveries">
                          <i class="fas fa-truck w-6" aria-hidden="true"></i>
                         <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Deliveries</span>
                     </a>
                     {/if}

                {if user_role == 'admin' || user_role == 'supervisor'}
                <a href="{base_url}/admin/usage"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'usage'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Commissary Usage">
                    <i class="fas fa-package w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Commissary Usage</span>
                </a>
                {/if}
                {/if}

                {if user_role == 'admin' || user_role == 'supervisor' || user_role == 'auditor'}
                <a href="{base_url}/admin/trace"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'trace'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Production Delivery Audit">
                    <i class="fas fa-clipboard-check w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Production Delivery Audit</span>
                </a>
                {/if}

                {if user_role == 'admin' || user_role == 'supervisor'}
                <a href="{base_url}/admin/withdrawals"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'stock-adjustments'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Stock Adjustments">
                    <i class="fas fa-arrow-right-from-bracket w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Stock Adjustments</span>
                </a>
                {/if}

                {if user_role == 'admin'}
                <a href="{base_url}/admin/products"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'products'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Products">
                    <i class="fas fa-cubes w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Products</span>
                </a>

                <a href="{base_url}/admin/branches"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'branches'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Branches">
                    <i class="fas fa-code-branch w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Branches</span>
                </a>

                <a href="{base_url}/admin/users"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'users'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Users">
                    <i class="fas fa-users w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Users</span>
                </a>

                {if feature_price_groups}
                <a href="{base_url}/admin/price-groups"
                         class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'price-groups'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Price Groups">
                    <i class="fas fa-tag w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Price Groups</span>
                </a>
                {/if}

                <a href="{base_url}/admin/settings"
                   class="wb-nav-item flex items-center px-3 py-2.5 rounded-xl mb-1 hover:bg-white/10 {if current_page == 'settings'}bg-white/10 ring-1 ring-white/10{/if}"
                   aria-label="Settings">
                    <i class="fas fa-user-shield w-6" aria-hidden="true"></i>
                    <span class="ml-3 text-sm font-medium" x-show="sidebarOpen" x-cloak>Settings</span>
                </a>
                {/if}
            </nav>
        </aside>

        <div class="flex-1 flex flex-col overflow-hidden">
            <header class="bg-white/80 backdrop-blur border-b border-gray-200 h-16 flex items-center justify-between px-6">
                <button type="button" class="inline-flex items-center justify-center h-9 w-9 rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-100"
                        @click="sidebarOpen = !sidebarOpen"
                        :aria-label="sidebarOpen ? 'Collapse sidebar' : 'Expand sidebar'"
                        :aria-expanded="sidebarOpen ? 'true' : 'false'">
                    <i class="fas fa-bars" aria-hidden="true"></i>
                </button>
                <div class="flex items-center gap-4">

                    <div class="text-right">
                        <div class="text-sm font-semibold text-gray-900">{user_full_name | default:user_name}</div>
                        <div class="text-xs text-gray-500 uppercase tracking-wide">{if user_username}{user_username} · {/if}{user_role}</div>
                    </div>
                    <a href="/daily-ledger/logout" class="text-sm font-semibold text-indigo-600 hover:text-indigo-700">Logout</a>
                </div>
            </header>

            <main class="flex-1 overflow-auto p-6" id="main-content">

<div x-data="varianceDashboard()" x-init="init()">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-4">
        <div>
            <h2 class="text-lg font-semibold text-gray-900">Variance Dashboard</h2>
            <p class="text-sm text-gray-500">
                Track beginning-vs-ending inventory discrepancies across branches.
                {if is_supervisor}Showing your assigned branches.{/if}
            </p>
        </div>
        <div class="flex items-center gap-3">
            <div class="variance-view-toggle">
                <button class="variance-view-toggle-btn"
                    :class="{ 'variance-view-toggle-btn--active': view === 'grouped' }"
                    @click="switchView('grouped')">
                    <i class="fas fa-layer-group mr-1"></i> Grouped
                </button>
                <button class="variance-view-toggle-btn"
                    :class="{ 'variance-view-toggle-btn--active': view === 'list' }"
                    @click="switchView('list')">
                    <i class="fas fa-list mr-1"></i> List
                </button>
            </div>
            <form class="flex gap-2" action="{base_url}/admin/variances" method="GET"
      onsubmit="return window.dlLoadForm(this)">
                <input type="hidden" name="view" :value="view">
                <input type="hidden" name="status" value="{status_filter}">
                {if branch_id}<input type="hidden" name="branch_id" value="{branch_id}">{/if}
                {if date_from}<input type="hidden" name="date_from" value="{date_from}">{/if}
                {if date_to}<input type="hidden" name="date_to" value="{date_to}">{/if}
                <input type="text" class="form-input w-48" name="q" value="{search}" placeholder="Product or branch...">
                <button type="submit" class="btn btn-outline btn-sm">Search</button>
            </form>
        </div>
    </div>
    <div class="flex items-center gap-2 mb-4">
        <a class="btn btn-outline" href="{base_url}/admin/sales?date_from={sales_link_from}&date_to={sales_link_to}">Sales Summary</a>
    </div>

    {if integrity_notifications | length > 0}
    <div class="card mb-4" data-integrity-notifications="{integrity_notifications | length}">
        <div class="card-header"><span>Integrity notifications</span><span class="text-xs text-gray-500">Recorded delivery and seen state</span></div>
        <div class="card-body space-y-2">
            {foreach integrity_notifications as notice}
            <div class="text-sm" data-notification-id="{notice.id}">
                <strong>{notice.title}</strong>{if notice.finding_count > 1} ({notice.finding_count} findings){/if}
                <span class="text-xs text-gray-500">notified {notice.notified_at} · seen {notice.seen_at}</span>
                {if notice.detail}<div class="text-xs text-gray-600">{notice.detail}</div>{/if}
            </div>
            {/foreach}
        </div>
    </div>
    {/if}

    <!-- Stat cards -->
    <div class="variance-stat-grid">
        <a href="?view={view_mode}&status=unreviewed{filter_query}"
           onclick="return window.dlLoadUrl(this.href, true)"
           class="variance-stat variance-stat--unreviewed {if status_filter == 'unreviewed'}variance-stat--active{/if}">
            <div class="variance-stat-label">Unreviewed</div>
            <div class="variance-stat-value">{stats_unreviewed}</div>
            <div class="variance-stat-sub">{if stats_unreviewed > 0}Needs attention{/if}{if stats_unreviewed == 0}All clear{/if}</div>
        </a>
        <a href="?view={view_mode}&status=investigated{filter_query}"
           onclick="return window.dlLoadUrl(this.href, true)"
           class="variance-stat variance-stat--investigated {if status_filter == 'investigated'}variance-stat--active{/if}">
            <div class="variance-stat-label">Investigated</div>
            <div class="variance-stat-value">{stats_investigated}</div>
            <div class="variance-stat-sub">Under review</div>
        </a>
        <a href="?view={view_mode}&status=corrected{filter_query}"
           onclick="return window.dlLoadUrl(this.href, true)"
           class="variance-stat variance-stat--corrected {if status_filter == 'corrected'}variance-stat--active{/if}">
            <div class="variance-stat-label">Corrected</div>
            <div class="variance-stat-value">{stats_corrected}</div>
            <div class="variance-stat-sub">Resolved</div>
        </a>
        <a href="?view={view_mode}{filter_query}"
           onclick="return window.dlLoadUrl(this.href, true)"
           class="variance-stat variance-stat--total {if status_filter == '' || status_filter == null}variance-stat--active{/if}">
            <div class="variance-stat-label">Total Flags</div>
            <div class="variance-stat-value">{stats_total}</div>
            <div class="variance-stat-sub">{if kind_filter != ''}Net: {if stats_net_variance >= 0}+{/if}{stats_net_variance} units{else}flags across kinds (not netted){/if}</div>
        </a>
    </div>

    <!-- Filter bar -->
    <div class="variance-filter-bar">
        <span class="text-xs font-semibold text-gray-500 mr-1">Quick filter:</span>
        <a href="?view={view_mode}{filter_query}"
           onclick="return window.dlLoadUrl(this.href, true)"
           class="variance-filter-pill {if status_filter == '' || status_filter == null}variance-filter-pill--active{/if}">
            All <span class="variance-filter-pill-count">{stats_total}</span>
        </a>
        <a href="?view={view_mode}&status=unreviewed{filter_query}"
           onclick="return window.dlLoadUrl(this.href, true)"
           class="variance-filter-pill {if status_filter == 'unreviewed'}variance-filter-pill--active{/if}">
            Unreviewed <span class="variance-filter-pill-count">{stats_unreviewed}</span>
        </a>
        <a href="?view={view_mode}&status=investigated{filter_query}"
           onclick="return window.dlLoadUrl(this.href, true)"
           class="variance-filter-pill {if status_filter == 'investigated'}variance-filter-pill--active{/if}">
            Investigated <span class="variance-filter-pill-count">{stats_investigated}</span>
        </a>
        <a href="?view={view_mode}&status=corrected{filter_query}"
           onclick="return window.dlLoadUrl(this.href, true)"
           class="variance-filter-pill {if status_filter == 'corrected'}variance-filter-pill--active{/if}">
            Corrected <span class="variance-filter-pill-count">{stats_corrected}</span>
        </a>

        <span class="mx-2 text-gray-300">|</span>

        <select class="form-input w-auto mt-0 text-xs py-1 px-2" name="kind"
                onchange="window.dlLoadKindFilter(this.value)">
            <option value="">All Kinds</option>
            <option value="overnight" {if kind_filter == 'overnight'}selected{/if}>Overnight (AM)</option>
            <option value="handoff" {if kind_filter == 'handoff'}selected{/if}>Handoff (PM)</option>
            <option value="ending" {if kind_filter == 'ending'}selected{/if}>Ending &gt; supply</option>
            <option value="sales" {if kind_filter == 'sales'}selected{/if}>Negative raw sales</option>
            <option value="delivery" {if kind_filter == 'delivery'}selected{/if}>Delivery sent vs received</option>
        </select>

        <select class="form-input w-auto mt-0 text-xs py-1 px-2" name="shift"
                onchange="window.dlLoadShiftFilter(this.value)">
            <option value="">All Shifts</option>
            <option value="AM" {if shift_filter == 'AM'}selected{/if}>AM</option>
            <option value="PM" {if shift_filter == 'PM'}selected{/if}>PM</option>
        </select>

        <select class="form-input w-auto mt-0 text-xs py-1 px-2" name="branch_id"
                onchange="window.dlLoadBranchFilter(this.value)">
            <option value="">All Branches</option>
            {foreach branches as br}
            <option value="{br.id}" {if br.id == branch_id}selected{/if}>{br.name}</option>
            {/foreach}
        </select>

        <label class="text-xs text-gray-500 ml-1" for="vf-date-from">From</label>
        <input id="vf-date-from" type="date" class="form-input w-auto mt-0 text-xs py-1 px-2"
               value="{date_from}" onchange="window.dlLoadDateRange()">
        <label class="text-xs text-gray-500" for="vf-date-to">To</label>
        <input id="vf-date-to" type="date" class="form-input w-auto mt-0 text-xs py-1 px-2"
               value="{date_to}" onchange="window.dlLoadDateRange()">

        {if branch_id || status_filter || search != '' || date_from != '' || date_to != ''}
        <a href="?view={view_mode}"
           onclick="return window.dlLoadUrl(this.href, true)"
           class="text-xs text-indigo-600 hover:underline ml-1">Clear all</a>
        {/if}
    </div>

    <!-- Bulk action bar -->
    {if can_manage_variances}
    <div class="variance-bulk-bar" :class="{ 'variance-bulk-bar--visible': selectedIds.length > 0 }">
        <span x-text="selectedIds.length + ' selected'"></span>
        <button class="btn btn-sm btn-outline" @click="bulkUpdateStatus('investigated')">
            <i class="fas fa-search text-xs"></i> Mark Investigated
        </button>
        <button class="btn btn-sm btn-outline" @click="bulkUpdateStatus('corrected')">
            <i class="fas fa-check text-xs"></i> Mark Corrected
        </button>
        <button class="btn btn-sm btn-outline" @click="selectedIds = []">Clear selection</button>
    </div>
    {/if}

    {if variances_total_matching > variances_shown}
    <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 rounded border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
        <span class="font-semibold">Showing the newest {variances_shown} of {variances_total_matching} matching flags.</span>
        <span class="text-amber-800">The totals and per-branch counts above cover all of them.</span>
        <span class="text-amber-800">Set a From/To range in the filters above to narrow this list, or</span>
        <a class="underline font-medium" href="{base_url}/admin/reports/variances">open the Variance Report</a>
        <span class="text-amber-800">to filter by date range and export everything to CSV or PDF.</span>
    </div>
    {/if}

    {if variances | length == 0}
    <div class="card">
        <div class="card-body text-center py-12">
            <i class="fas fa-check-circle text-4xl text-emerald-400 mb-3"></i>
            <p class="text-gray-900 font-semibold">No variance flags found</p>
            <p class="text-sm text-gray-500 mt-1">
                {if status_filter}No {status_filter} flags match your filters.{/if}
                {if !status_filter}All inventory transitions are clean for the selected criteria.{/if}
            </p>
        </div>
    </div>
    {/if}

    {if variances | length > 0}
    <!-- Grouped view -->
    <template x-if="view === 'grouped'">
    <div>
        {foreach branch_summary as bg}
        <div class="variance-branch-group" x-data="{ open: {if bg.unreviewed > 0}true{else}false{/if} }">
            <div class="variance-branch-group-header"
                 :class="{ 'variance-branch-group-header--expanded': open }"
                 @click="open = !open">
                <div class="flex items-center gap-3">
                    <i class="fas text-xs text-gray-400" :class="open ? 'fa-chevron-down' : 'fa-chevron-right'"></i>
                    <div>
                        <div class="variance-branch-group-name">{bg.branch_name}</div>
                        <div class="text-xs text-gray-500">
                            {if bg.branch_code}{bg.branch_code} · {/if}Branch #{bg.branch_id}
                        </div>
                    </div>
                    {if bg.unreviewed > 0}
                    <span class="variance-status-badge variance-status-badge--unreviewed">{bg.unreviewed} unreviewed</span>
                    {/if}
                </div>
                <div class="variance-branch-group-metrics">
                    <span class="variance-branch-group-metric">
                        <span class="variance-branch-group-metric-dot variance-branch-group-metric-dot--unreviewed"></span>
                        {bg.unreviewed}
                    </span>
                    <span class="variance-branch-group-metric">
                        <span class="variance-branch-group-metric-dot variance-branch-group-metric-dot--investigated"></span>
                        {bg.investigated}
                    </span>
                    <span class="variance-branch-group-metric">
                        <span class="variance-branch-group-metric-dot variance-branch-group-metric-dot--corrected"></span>
                        {bg.corrected}
                    </span>
                    <span class="text-xs text-gray-400">Net: {if bg.net_variance >= 0}+{/if}{bg.net_variance}</span>
                </div>
            </div>
            <div class="variance-branch-group-body" :class="{ 'variance-branch-group-body--expanded': open }">
                <table>
                    <thead>
                        <tr>
                            {if can_manage_variances}<th class="w-8"><input type="checkbox" @change="toggleBranch($event, '{bg.branch_id}')"></th>{/if}
                            <th>Date</th>
                            <th>Flag</th>
                            <th>Product</th>
                            <th>Kind</th>
                            <th>Shift</th>
                            <th class="text-right">Shift Beg</th>
                            <th class="text-right">Addt'l</th>
                            <th class="text-right">W/Draw</th>
                            <th class="text-right">Rec. End</th>
                            <th class="text-right">Variance</th>
                            <th>Status</th>
                            <th>Reviewed</th>
                        </tr>
                    </thead>
                    <tbody>
                        {foreach bg.items as v}
                        <tr>
                            {if can_manage_variances}<td><input type="checkbox" value="{v.id}" x-model="selectedIds"></td>{/if}
                            <td class="text-sm">
                                <div>{v.ledger_date}</div>
                                <a class="text-xs text-indigo-600 hover:underline" href="{base_url}/admin/trace?branch_id={v.branch_id}&date_from={v.ledger_date}&date_to={v.ledger_date}&product_id={v.product_id}&variance_id={v.id}">Investigate evidence</a>
                            </td>
                            <td class="text-xs text-gray-500">Flag #{v.id}</td>
                            <td>
                                <span class="font-medium text-sm">{v.product_name}</span>
                                {if v.product_sku}<span class="text-xs text-gray-400 ml-1">({v.product_sku})</span>{/if}
                                <div class="text-xs text-gray-400">Product #{v.product_id}</div>
                            </td>
                            <td>
                                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold ring-1 ring-inset {if v.kind == 'overnight'}bg-sky-50 text-sky-700 ring-sky-200{/if}{if v.kind == 'handoff'}bg-violet-50 text-violet-700 ring-violet-200{/if}{if v.kind == 'ending'}bg-rose-50 text-rose-700 ring-rose-200{/if}{if v.kind == 'sales'}bg-orange-50 text-orange-700 ring-orange-200{/if}">{v.kind}</span>
                            </td>
                            <td class="text-sm text-gray-500">{if v.shift}{v.shift}{else}—{/if}</td>
                            <td class="text-right text-sm">{if v.current_beg_bal !== null}{v.current_beg_bal}{else}—{/if}</td>
                            <td class="text-right text-sm">{if v.addtl !== null}{v.addtl}{else}—{/if}</td>
                            <td class="text-right text-sm">{if v.withdraw !== null}{v.withdraw}{else}—{/if}</td>
                            <td class="text-right text-sm">{if v.recorded_end_bal !== null}{v.recorded_end_bal}{else}—{/if}</td>
                            <td class="text-right">
                                <span class="variance-value {if v.variance > 0}variance-value--over{/if}{if v.variance < 0}variance-value--short{/if}{if v.variance == 0}variance-value--zero{/if}">
                                    {if v.variance > 0}+{/if}{v.variance}
                                </span>
                            </td>
                            <td>
                                {if v.is_delivery}
                                <div class="text-xs" data-delivery-variance="{v.id}">
                                    <div class="font-medium text-gray-700">Sent {v.sent_qty} · cashier counted {v.original_counted_qty}</div>
                                    <div class="mt-1 text-gray-500">Produced: {if v.delivery_production_shift}{v.delivery_production_shift}{else}not recorded{/if} · Received into: {if v.delivery_received_shift}{v.delivery_received_shift}{else}not recorded{/if}</div>
                                    {if v.resolution_choice}
                                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold ring-1 ring-inset {if v.resolution_choice == 'accept_production'}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}{if v.resolution_choice == 'keep_as_evidence'}bg-sky-50 text-sky-700 ring-sky-200{/if}">{v.choice_label}</span>
                                    <div class="mt-1 text-gray-500">{v.reviewer_name}{if v.reviewed_at} · {v.reviewed_at}{/if}</div>
                                    {if v.review_note}<div class="mt-1 text-gray-600">{v.review_note | esc_html}</div>{/if}
                                    {/if}
                                    {if can_decide_delivery}
                                    <input type="text" class="form-input mt-1 w-full text-xs py-0.5 px-1.5" data-delivery-note-id="{v.id}" maxlength="500" placeholder="Note the decision…">
                                    {if v.decision_ready}
                                    <div class="mt-1 flex flex-wrap gap-1">
                                        <button type="button" class="btn btn-sm btn-outline" onclick="decideDeliveryVariance({v.id}, 'accept_production')">Accept production ({v.original_counted_qty} → {v.sent_qty})</button>
                                        <button type="button" class="btn btn-sm btn-outline" onclick="decideDeliveryVariance({v.id}, 'keep_as_evidence')">Keep as evidence ({v.original_counted_qty})</button>
                                    </div>
                                    {else}
                                    <div class="mt-1 text-gray-500">Investigate, or reopen a corrected finding, to change the decision.</div>
                                    {/if}
                                    {else}
                                    <div class="mt-1 text-gray-500">Only an admin may make the acceptance decision.</div>
                                    {/if}
                                </div>
                                {else}
                                {if can_manage_variances}
                                <select class="form-input mt-0 w-auto text-xs py-0.5 px-1.5"
                                        data-id="{v.id}"
                                        onchange="updateVarianceStatus(this)"
                                        style="min-width: 110px;">
                                    <option value="unreviewed" {if v.resolution_status == 'unreviewed'}selected{/if}>Unreviewed</option>
                                    <option value="investigated" {if v.resolution_status == 'investigated'}selected{/if}>Investigated</option>
                                    <option value="corrected" {if v.resolution_status == 'corrected'}selected{/if}>Corrected</option>
                                </select>
                                <input type="text"
                                       class="form-input mt-1 w-full text-xs py-0.5 px-1.5"
                                       data-note-id="{v.id}"
                                       data-saved="{v.review_note | esc_html | default:''}"
                                       value="{v.review_note | esc_html | default:''}"
                                       maxlength="500"
                                       placeholder="Note what happened…"
                                       title="Short remark for this variance. Saves on blur. Enter also saves."
                                       onblur="updateVarianceNote(this)">
                                {else}
                                <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset
                                    {if v.resolution_status == 'unreviewed'}bg-amber-50 text-amber-700 ring-amber-200{/if}
                                    {if v.resolution_status == 'investigated'}bg-sky-50 text-sky-700 ring-sky-200{/if}
                                    {if v.resolution_status == 'corrected'}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}">
                                    {if v.resolution_status == 'unreviewed'}Unreviewed{/if}
                                    {if v.resolution_status == 'investigated'}Investigated{/if}
                                    {if v.resolution_status == 'corrected'}Corrected{/if}
                                </span>
                                {if v.review_note}
                                <div class="mt-1 text-xs text-gray-600">{v.review_note | esc_html}</div>
                                {/if}
                                {/if}
                                {/if}
                            </td>
                            <td class="text-xs text-gray-500">
                                <div>{v.reviewer_name}</div>
                                <div>{if v.reviewed_at}{v.reviewed_at}{else}—{/if}</div>
                            </td>
                        </tr>
                        {/foreach}
                    </tbody>
                </table>
            </div>
        </div>
        {/foreach}
    </div>
    </template>

    <!-- List view -->
    <template x-if="view === 'list'">
    <div>
        <div class="card">
            <div class="card-header">
                <span>Variance Records</span>
                <span class="text-sm text-muted">{variances | count} flags</span>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            {if can_manage_variances}<th class="w-8"><input type="checkbox" @change="toggleAll($event)"></th>{/if}
                            <th>Date</th>
                            <th>Branch</th>
                            <th>Flag</th>
                            <th>Product</th>
                            <th>Kind</th>
                            <th>Shift</th>
                            <th class="text-right">Shift Beg</th>
                            <th class="text-right">Addt'l</th>
                            <th class="text-right">W/Draw</th>
                            <th class="text-right">Rec. End</th>
                            <th class="text-right">Variance</th>
                            <th>Status</th>
                            <th>Reviewer</th>
                            <th>Reviewed At</th>
                        </tr>
                    </thead>
                    <tbody>
                        {foreach variances as v}
                        <tr>
                            {if can_manage_variances}<td><input type="checkbox" value="{v.id}" x-model="selectedIds"></td>{/if}
                            <td class="text-sm">
                                <div>{v.ledger_date}</div>
                                <div class="text-xs text-gray-400">Flag #{v.id}</div>
                                <a class="text-xs text-indigo-600 hover:underline" href="{base_url}/admin/trace?branch_id={v.branch_id}&date_from={v.ledger_date}&date_to={v.ledger_date}&product_id={v.product_id}&variance_id={v.id}">Investigate evidence</a>
                            </td>
                            <td class="text-sm font-medium">
                                <div>{v.branch_name}</div>
                                <div class="text-xs text-gray-400">{if v.branch_code}{v.branch_code} · {/if}Branch #{v.branch_id}</div>
                            </td>
                            <td class="text-xs text-gray-500">Product #{v.product_id}</td>
                            <td>
                                <span class="text-sm">{v.product_name}</span>
                                {if v.product_sku}<span class="text-xs text-gray-400 ml-1">({v.product_sku})</span>{/if}
                            </td>
                            <td>
                                <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold ring-1 ring-inset {if v.kind == 'overnight'}bg-sky-50 text-sky-700 ring-sky-200{/if}{if v.kind == 'handoff'}bg-violet-50 text-violet-700 ring-violet-200{/if}{if v.kind == 'ending'}bg-rose-50 text-rose-700 ring-rose-200{/if}{if v.kind == 'sales'}bg-orange-50 text-orange-700 ring-orange-200{/if}">{v.kind}</span>
                            </td>
                            <td class="text-sm text-gray-500">{if v.shift}{v.shift}{else}—{/if}</td>
                            <td class="text-right text-sm">{if v.current_beg_bal !== null}{v.current_beg_bal}{else}—{/if}</td>
                            <td class="text-right text-sm">{if v.addtl !== null}{v.addtl}{else}—{/if}</td>
                            <td class="text-right text-sm">{if v.withdraw !== null}{v.withdraw}{else}—{/if}</td>
                            <td class="text-right text-sm">{if v.recorded_end_bal !== null}{v.recorded_end_bal}{else}—{/if}</td>
                            <td class="text-right">
                                <span class="variance-value {if v.variance > 0}variance-value--over{/if}{if v.variance < 0}variance-value--short{/if}{if v.variance == 0}variance-value--zero{/if}">
                                    {if v.variance > 0}+{/if}{v.variance}
                                </span>
                            </td>
                            <td>
                                {if v.is_delivery}
                                <div class="text-xs" data-delivery-variance="{v.id}">
                                    <div class="font-medium text-gray-700">Sent {v.sent_qty} · cashier counted {v.original_counted_qty}</div>
                                    <div class="mt-1 text-gray-500">Produced: {if v.delivery_production_shift}{v.delivery_production_shift}{else}not recorded{/if} · Received into: {if v.delivery_received_shift}{v.delivery_received_shift}{else}not recorded{/if}</div>
                                    {if v.resolution_choice}
                                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold ring-1 ring-inset {if v.resolution_choice == 'accept_production'}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}{if v.resolution_choice == 'keep_as_evidence'}bg-sky-50 text-sky-700 ring-sky-200{/if}">{v.choice_label}</span>
                                    <div class="mt-1 text-gray-500">{v.reviewer_name}{if v.reviewed_at} · {v.reviewed_at}{/if}</div>
                                    {if v.review_note}<div class="mt-1 text-gray-600">{v.review_note | esc_html}</div>{/if}
                                    {/if}
                                    {if can_decide_delivery}
                                    <input type="text" class="form-input mt-1 w-full text-xs py-0.5 px-1.5" data-delivery-note-id="{v.id}" maxlength="500" placeholder="Note the decision…">
                                    {if v.decision_ready}
                                    <div class="mt-1 flex flex-wrap gap-1">
                                        <button type="button" class="btn btn-sm btn-outline" onclick="decideDeliveryVariance({v.id}, 'accept_production')">Accept production ({v.original_counted_qty} → {v.sent_qty})</button>
                                        <button type="button" class="btn btn-sm btn-outline" onclick="decideDeliveryVariance({v.id}, 'keep_as_evidence')">Keep as evidence ({v.original_counted_qty})</button>
                                    </div>
                                    {else}
                                    <div class="mt-1 text-gray-500">Investigate, or reopen a corrected finding, to change the decision.</div>
                                    {/if}
                                    {else}
                                    <div class="mt-1 text-gray-500">Only an admin may make the acceptance decision.</div>
                                    {/if}
                                </div>
                                {else}
                                {if can_manage_variances}
                                <select class="form-input mt-0 w-auto text-xs py-0.5 px-1.5"
                                        data-id="{v.id}"
                                        onchange="updateVarianceStatus(this)"
                                        style="min-width: 110px;">
                                    <option value="unreviewed" {if v.resolution_status == 'unreviewed'}selected{/if}>Unreviewed</option>
                                    <option value="investigated" {if v.resolution_status == 'investigated'}selected{/if}>Investigated</option>
                                    <option value="corrected" {if v.resolution_status == 'corrected'}selected{/if}>Corrected</option>
                                </select>
                                <input type="text"
                                       class="form-input mt-1 w-full text-xs py-0.5 px-1.5"
                                       data-note-id="{v.id}"
                                       data-saved="{v.review_note | esc_html | default:''}"
                                       value="{v.review_note | esc_html | default:''}"
                                       maxlength="500"
                                       placeholder="Note what happened…"
                                       title="Short remark for this variance. Saves on blur. Enter also saves."
                                       onblur="updateVarianceNote(this)">
                                {else}
                                <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset
                                    {if v.resolution_status == 'unreviewed'}bg-amber-50 text-amber-700 ring-amber-200{/if}
                                    {if v.resolution_status == 'investigated'}bg-sky-50 text-sky-700 ring-sky-200{/if}
                                    {if v.resolution_status == 'corrected'}bg-emerald-50 text-emerald-700 ring-emerald-200{/if}">
                                    {if v.resolution_status == 'unreviewed'}Unreviewed{/if}
                                    {if v.resolution_status == 'investigated'}Investigated{/if}
                                    {if v.resolution_status == 'corrected'}Corrected{/if}
                                </span>
                                {if v.review_note}
                                <div class="mt-1 text-xs text-gray-600">{v.review_note | esc_html}</div>
                                {/if}
                                {/if}
                                {/if}
                            </td>
                            <td class="text-sm text-muted">{v.reviewer_name}</td>
                            <td class="text-xs text-gray-500">{if v.reviewed_at}{v.reviewed_at}{else}—{/if}</td>
                        </tr>
                        {/foreach}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    </template>
    {/if}
</div>

            </main>
        </div>
    </div>


<script>
    var BASE = '{base_url}';
    var initialView = '{view_mode}' || 'list';

    // Reload the variances page in place with the chosen branch filter, keeping
    // the current view/status/search params.
    window.dlLoadBranchFilter = function(branchId) {
        var params = new URLSearchParams(window.location.search);
        if (branchId) {
            params.set('branch_id', String(branchId));
        } else {
            params.delete('branch_id');
        }
        window.dlLoadUrl(window.location.pathname + '?' + params.toString(), true);
    };

    // Reload the variances page in place with the chosen kind/shift filter.
    window.dlLoadKindFilter = function(kind) {
        var params = new URLSearchParams(window.location.search);
        if (kind) {
            params.set('kind', String(kind));
        } else {
            params.delete('kind');
        }
        window.dlLoadUrl(window.location.pathname + '?' + params.toString(), true);
    };

    window.dlLoadShiftFilter = function(shift) {
        var params = new URLSearchParams(window.location.search);
        if (shift) {
            params.set('shift', String(shift));
        } else {
            params.delete('shift');
        }
        window.dlLoadUrl(window.location.pathname + '?' + params.toString(), true);
    };

    // Reload with the chosen date range, keeping every other filter.
    window.dlLoadDateRange = function() {
        var params = new URLSearchParams(window.location.search);
        var from = document.getElementById('vf-date-from').value;
        var to = document.getElementById('vf-date-to').value;
        if (from) { params.set('date_from', from); } else { params.delete('date_from'); }
        if (to) { params.set('date_to', to); } else { params.delete('date_to'); }
        // The single-day parameter is superseded by the range controls.
        params.delete('date');
        window.dlLoadUrl(window.location.pathname + '?' + params.toString(), true);
    };

    function varianceDashboard() {
        return {
            view: initialView,
            selectedIds: [],
            init() {
                // Restore view preference
                var saved = localStorage.getItem('dl_variance_view');
                if (saved && (saved === 'grouped' || saved === 'list')) {
                    this.view = saved;
                }
            },
            switchView(mode) {
                this.view = mode;
                localStorage.setItem('dl_variance_view', mode);
                // Update URL without reload
                var url = new URL(window.location);
                url.searchParams.set('view', mode);
                window.history.replaceState({}, '', url);
            },
            toggleAll(e) {
                var checked = e.target.checked;
                var checkboxes = document.querySelectorAll('tbody input[type="checkbox"]');
                if (checked) {
                    this.selectedIds = Array.from(checkboxes).map(function(cb) { return cb.value; });
                } else {
                    this.selectedIds = [];
                }
            },
            toggleBranch(e, branchId) {
                // Toggle all items in a branch group
                var checked = e.target.checked;
                var group = e.target.closest('.variance-branch-group');
                if (!group) return;
                var checkboxes = group.querySelectorAll('tbody input[type="checkbox"]');
                var ids = Array.from(checkboxes).map(function(cb) { return cb.value; });
                if (checked) {
                    this.selectedIds = this.selectedIds.concat(ids.filter(function(id) {
                        return this.selectedIds.indexOf(id) === -1;
                    }, this));
                } else {
                    this.selectedIds = this.selectedIds.filter(function(id) {
                        return ids.indexOf(id) === -1;
                    });
                }
            },
            bulkUpdateStatus(status) {
                if (this.selectedIds.length === 0) return;
                if (!confirm('Mark ' + this.selectedIds.length + ' variance(s) as ' + status + '?')) return;

                var self = this;
                var done = 0;
                var total = this.selectedIds.length;

                this.selectedIds.forEach(function(id) {
                    fetch(BASE + '/api/v1/admin/variances/update', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ variance_id: parseInt(id), status: status })
                    })
                    .then(function(r) { return r.json(); })
                    .then(function(res) {
                        done++;
                        if (done >= total) {
                            self.selectedIds = [];
                            showToast(total + ' variance(s) set to ' + status, 'success');
                            setTimeout(function() { window.refreshMainContent(); }, 800);
                        }
                    })
                    .catch(function() {
                        done++;
                        if (done >= total) {
                            showToast('Some updates may have failed. Reloading...', 'error');
                            setTimeout(function() { window.refreshMainContent(); }, 1200);
                        }
                    });
                });
            }
        };
    }

    // The admin-only acceptance decision. It is a choice, not a status flip:
    // accept production (correct the cashier's count, original kept as evidence)
    // or keep the count as evidence (no change). A note is required.
    function decideDeliveryVariance(id, choice) {
        var input = document.querySelector('[data-delivery-note-id="' + id + '"]');
        var note = input ? input.value.trim() : '';
        if (!note) {
            showToast('Enter a note before deciding.', 'error');
            if (input) input.focus();
            return;
        }
        var label = choice === 'accept_production'
            ? 'Accept production and correct the cashier\'s count?'
            : 'Keep the cashier\'s count as evidence?';
        if (!confirm(label)) { return; }

        fetch(BASE + '/api/v1/admin/variances/decide-delivery', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ variance_id: parseInt(id), choice: choice, review_note: note })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res.ok) {
                showToast(res.resolution_choice === 'accept_production' ? 'Count corrected to production' : 'Count kept as evidence', 'success');
                setTimeout(function() { window.refreshMainContent(); }, 800);
            } else {
                showToast(res.error || 'Decision failed', 'error');
            }
        })
        .catch(function() { showToast('Network error', 'error'); });
    }

    function updateVarianceStatus(select) {
        var id = select.dataset.id;
        var status = select.value;
        var originalStatus = select.getAttribute('data-original') || select.value;
        select.disabled = true;

        // No review_note key: an absent note means "leave the stored note alone",
        // so changing a status never wipes a note written on this row.
        fetch(BASE + '/api/v1/admin/variances/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ variance_id: parseInt(id), status: status })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            select.disabled = false;
            if (res.ok) {
                showToast('Status updated to ' + status, 'success');
                // Brief highlight effect
                var row = select.closest('tr');
                if (row) {
                    row.style.transition = 'background-color .4s';
                    row.style.backgroundColor = status === 'corrected' ? '#ecfdf5' : '#eff6ff';
                    setTimeout(function() { row.style.backgroundColor = ''; }, 1200);
                }
            } else {
                showToast(res.error || 'Update failed', 'error');
                select.value = originalStatus;
            }
        })
        .catch(function() {
            select.disabled = false;
            showToast('Network error', 'error');
            select.value = originalStatus;
        });
    }

    // Save the review note for one variance without touching its status. Reads the
    // row's current status so there is a single write path, and no-ops when the
    // value is unchanged so a stray blur (tabbing through) writes nothing.
    function updateVarianceNote(input) {
        var note = input.value;
        var saved = input.getAttribute('data-saved') || '';
        if (note === saved) { return; }

        var cell = input.closest('td');
        var select = cell ? cell.querySelector('select') : null;
        var id = input.dataset.noteId;

        input.disabled = true;
        fetch(BASE + '/api/v1/admin/variances/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                variance_id: parseInt(id),
                status: select ? select.value : 'unreviewed',
                review_note: note
            })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            input.disabled = false;
            if (res.ok) {
                input.setAttribute('data-saved', note);
                showToast(note === '' ? 'Note cleared' : 'Note saved', 'success');
            } else {
                showToast(res.error || 'Note save failed', 'error');
                input.value = saved; // put the field back to the last saved value
            }
        })
        .catch(function() {
            input.disabled = false;
            showToast('Network error', 'error');
            input.value = saved;
        });
    }

    // Enter saves the note. Delegated on document for the same reason: this table re-renders
    // over htmx, so a per-row inline handler would need rebinding after every swap.
    document.addEventListener('keydown', function(e) {
        var el = e.target;
        if (!el || !el.dataset || !el.dataset.noteId) { return; }
        if (e.key !== 'Enter') { return; }
        e.preventDefault();
        el.blur();
        updateVarianceNote(el);
    }, true);
</script>

<script>
/* The sidebar defaults to collapsed, so its menu items are icon-only. Copy each item's existing
   accessible name onto a native tooltip so the icon can be identified on hover. A native title is
   used rather than a CSS tooltip because the nav is a scroll container (overflow-y:auto), which
   would clip a pseudo-element. No braces here on purpose: braces in a DiSyL template are parsed. */
document.querySelectorAll('#wb-sidebar .wb-nav-item[aria-label]').forEach(el => el.title = el.getAttribute('aria-label'));
</script>
</body>
</html>
