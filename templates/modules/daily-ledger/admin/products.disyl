{extends "modules/daily-ledger/layouts/app.disyl"}

{block head}
<style>
    .product-modal {
        max-width: 58rem;
        border-radius: 3px;
        padding: 0;
        overflow: hidden;
    }
    .product-modal__header {
        border-bottom: 1px solid rgb(229 231 235);
        padding: 1rem 1.25rem;
    }
    .product-modal__body {
        padding: 1.25rem;
    }
    .product-modal__grid {
        display: grid;
        gap: 1rem 1.25rem;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .product-modal__section {
        border: 1px solid rgb(229 231 235);
        border-radius: 3px;
        background: rgb(248 250 252);
        padding: 1rem;
    }
    .product-modal__section-title {
        margin-bottom: .75rem;
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: rgb(75 85 99);
    }
    .product-modal .form-input,
    .product-modal .btn,
    .product-modal .btn-outline,
    .product-modal .btn-primary {
        border-radius: 3px;
    }
    .product-modal .form-group:last-child {
        margin-bottom: 0;
    }
    .product-modal__actions {
        margin-top: 0;
        border-top: 1px solid rgb(229 231 235);
        padding: .875rem 1.25rem;
    }
    @media (max-width: 767px) {
        .product-modal__grid {
            grid-template-columns: 1fr;
        }
    }
    .picker-row.is-hidden { display: none; }
</style>
{/block}

{block content}
<div class="mb-4 border-b border-gray-200">
    <nav class="flex gap-1" aria-label="Products sections" data-products-tabs>
        <a href="{base_url}/admin/products" data-tab-products
           class="rounded-t px-4 py-2 text-sm font-semibold {if tab == 'assignment'}text-gray-500 hover:text-gray-700{else}border-b-2 border-indigo-600 text-indigo-700{/if}">Products</a>
        <a href="{base_url}/admin/products?tab=assignment" data-tab-assignment
           class="rounded-t px-4 py-2 text-sm font-semibold {if tab == 'assignment'}border-b-2 border-indigo-600 text-indigo-700{else}text-gray-500 hover:text-gray-700{/if}">Show in Branches</a>
    </nav>
</div>

{if tab == 'assignment'}
<div class="card mb-4">
    <div class="card-body flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
            <form method="GET" action="{base_url}/admin/products" onsubmit="return window.dlLoadForm(this)" data-picker-branch-form>
                <input type="hidden" name="tab" value="assignment">
                <label class="form-label" for="picker-branch">Branch being edited</label>
                <select class="form-input sm:w-80" id="picker-branch" name="branch_id" onchange="window.dlLoadForm(this.form)" data-picker-branch>
                    {foreach branches as b}
                    <option value="{b.id}" {if b.id == branch_id}selected{/if}>{b.code} — {b.name}{if b.is_commissary == 1} (commissary){/if}</option>
                    {/foreach}
                </select>
            </form>
            <div>
                <label class="form-label" for="picker-search">Search name or SKU</label>
                <input type="text" class="form-input sm:w-72" id="picker-search" placeholder="Type to filter..." autocomplete="off" oninput="filterPicker()" data-picker-search>
            </div>
        </div>
        <div class="text-sm text-gray-600">
            <span class="font-semibold text-gray-900" id="picker-visible-count">{assignment_products | length}</span>
            product(s) shown
            <span class="mx-2 text-gray-300">|</span>
            <span id="picker-checked-count">0</span> ticked
        </div>
    </div>
</div>

{if assignment_branch}
<div class="mb-4 rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm text-indigo-900">
    Editing products for
    <span class="font-semibold" data-picker-branch-name>{assignment_branch.code} — {assignment_branch.name}</span>
    {if assignment_branch.is_commissary == 1}<span class="ml-2 inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-800 ring-1 ring-inset ring-amber-300">COMMISSARY</span>{/if}
</div>
{/if}

{if warning_groups | length > 0}
<div class="mb-4 rounded-lg border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900" data-picker-warning-info>
    <div class="font-semibold">Information: older unfinished days</div>
    <p class="mt-1">These days are already stalled and <span class="font-semibold">do not block saving</span>. You may want to look at them later.</p>
    <details class="mt-2">
        <summary class="cursor-pointer font-medium">{warning_groups | length} product(s) with older unfinished days</summary>
        <div class="mt-2 space-y-1">
            {foreach warning_groups as wg}
            <div>
                <span class="font-medium">{wg.product_name}</span>
                {foreach wg.items as w}
                <span class="ml-2 whitespace-nowrap text-xs">{w.ledger} {w.date} {w.shift}</span>
                {/foreach}
            </div>
            {/foreach}
        </div>
    </details>
</div>
{/if}

<div class="mb-3 flex flex-wrap items-center gap-2">
    <button type="button" class="btn btn-outline btn-sm" onclick="pickerCheckAll(true)">Tick all shown</button>
    <button type="button" class="btn btn-outline btn-sm" onclick="pickerCheckAll(false)">Untick all shown</button>
</div>

<div class="card">
    <div class="table-wrap" style="max-height: 60vh; overflow-y: auto;">
        <table id="picker-table" data-picker-table>
            <thead>
                <tr>
                    <th style="width:3rem;">Show</th>
                    <th>SKU</th>
                    <th>Product</th>
                    <th>Category</th>
                </tr>
            </thead>
            <tbody>
                {foreach assignment_products as p}
                <tr class="picker-row" data-product-id="{p.id}">
                    <td>
                        <input type="checkbox" class="picker-check" value="{p.id}" {if p.assigned == 1}checked{/if} onchange="updatePickerCheckedCount()" data-product-check>
                    </td>
                    <td class="picker-sku font-mono text-xs text-gray-500">{p.sku}</td>
                    <td class="picker-name font-medium text-gray-900">{p.name}</td>
                    <td class="text-xs uppercase tracking-wider text-gray-600">{p.product_category}</td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>
</div>

<div id="picker-refusal" class="hidden mt-4 rounded-lg border border-rose-300 bg-rose-50 px-4 py-3 text-sm text-rose-900" data-picker-refusal></div>
<div id="picker-warning" class="hidden mt-4 rounded-lg border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900" data-picker-save-warning></div>

<div class="mt-4 flex items-center justify-end gap-2">
    <a href="{base_url}/admin/branches" class="btn btn-outline">Cancel</a>
    <button type="button" class="btn btn-primary" id="picker-save" onclick="submitPicker()" data-picker-save>Save changes</button>
</div>
{else}
<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">Products</h2>
        <p class="text-sm text-gray-500">Manage master products and pricing.</p>
    </div>
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
        <form class="flex gap-2" action="{base_url}/admin/products" method="GET"
      onsubmit="return window.dlLoadForm(this)">
            <input type="text" class="form-input w-full sm:w-64" name="q" value="{search}" placeholder="Search name or SKU...">
            <button type="submit" class="btn btn-outline">Search</button>
        </form>
        <div class="flex gap-2 sm:ml-2">
            <a href="{base_url}/admin/products/export" class="btn btn-outline" download>Export CSV</a>
            <button class="btn btn-outline" onclick="openImportProduct()">Import CSV</button>
            <button class="btn btn-primary" onclick="openAddProduct()">+ Add</button>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th class="text-right">Price</th>
                    <th>Output Profile</th>
                    <th class="text-right">Sort</th>
                    <th>Branches</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {foreach products as p}
                <tr>
                    <td class="font-mono text-xs text-gray-500">{p.sku}</td>
                    <td class="font-medium text-gray-900">{p.name}</td>
                    <td class="text-xs text-gray-600 uppercase tracking-wider">{p.product_category}</td>
                    <td class="text-right font-semibold text-gray-900">
                        PHP {p.current_price}
                        <span class="block text-xs font-normal text-gray-400">Effective {p.current_price_effective_from | default:'date not recorded'}</span>
                    </td>
                    <td class="text-sm text-gray-600">
                        {if (p.output_pieces_per_batch | default:0) > 0}
                        {p.output_pieces_per_batch} {p.output_unit_label} / batch
                        {if (p.batch_input_qty | default:0) > 0}
                        <span class="text-gray-400 text-xs"> ({p.batch_input_qty} kg kilo/batch)</span>
                        {/if}
                        {if (p.batch_egg_qty | default:0) > 0}
                        <span class="text-gray-400 text-xs"> ({p.batch_egg_qty} eggs/batch)</span>
                        {/if}
                        {if (p.pcs_per_pack | default:0) > 0}
                        <span class="text-emerald-600 text-xs font-medium"> (box of {p.pcs_per_pack} pcs)</span>
                        {/if}
                        {/if}
                        {if (p.output_pieces_per_batch | default:0) <= 0}
                        <span class="text-gray-400">Not set</span>
                        {/if}
                    </td>
                    <td class="text-right text-sm text-gray-500">{p.sort_order}</td>
                    <td class="text-sm text-muted">{p.branch_count} branches</td>
                    <td>
                        {if p.is_active == 1}<span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-200">Active</span>{/if}
                        {if p.is_active == 0}<span class="inline-flex items-center rounded-full bg-rose-50 px-2.5 py-1 text-xs font-semibold text-rose-700 ring-1 ring-inset ring-rose-200">Inactive</span>{/if}
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline" onclick="openEditProduct({p.id}, '{p.name}', '{p.product_category}', {p.current_price}, {p.sort_order}, {p.is_active}, {p.output_pieces_per_batch | default:0}, '{p.output_unit_label | default:pcs}', {p.batch_input_qty | default:0}, {p.batch_egg_qty | default:0}, {p.pcs_per_pack | default:0}, '{p.current_price_effective_from | default:''}', '{p.assignment_mode | default:'all_active'}', '{p.assigned_branch_ids | default:''}')">Edit</button>
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>
</div>
{/if}

<!-- Add Product Modal -->
<div class="modal-overlay" id="add-modal">
    <div class="modal">
        <h3>Add Product</h3>
        <div class="form-group">
            <label class="form-label">Product Name</label>
            <input class="form-input" type="text" id="add-name" placeholder="e.g. BDAY CAKE 1 LAYER">
        </div>

        <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Product Category</label>
            <select class="form-input" id="add-category">
                <option value="bread">Bread</option>
                <option value="cake">Cake</option>
                <option value="other">Other</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Price (PHP)</label>
            <input class="form-input" type="number" id="add-price" step="0.01" min="0" placeholder="0.00">
        </div>
        <div class="form-group">
            <label class="form-label">Sort Order</label>
            <input class="form-input" type="number" id="add-sort" value="0" min="0">
        </div>
        <div class="form-group">
            <label class="form-label">Output Pieces per Batch</label>
            <input class="form-input" type="number" id="add-output-pieces" value="0" min="0" step="1" placeholder="0 = not set">
        </div>
        <div class="form-group">
            <label class="form-label">Output Unit Label</label>
            <input class="form-input" type="text" id="add-output-unit" value="pcs" maxlength="20" placeholder="pcs">
        </div>
        <div class="form-group">
            <label class="form-label">Box size (pcs per box)</label>
            <input class="form-input" type="number" id="add-pcs-per-pack" value="" min="0" step="1" placeholder="Blank = not sold by box">
            <p class="text-xs text-gray-400 mt-1">Leave blank unless this item is also sold by whole box (e.g. crinkles 24/box). Cashiers can then withdraw in boxes.</p>
        </div>
        <div class="form-group">
            <label class="form-label">Kilo per Batch</label>
            <input class="form-input" type="number" id="add-batch-kilo-qty" value="" min="0" step="0.001" placeholder="e.g. 5 = 5 kg per batch">
            <p class="text-xs text-gray-400 mt-1">Kilograms of dough/flour that make up one batch. Leave blank if not applicable.</p>
        </div>
        <div class="form-group">
            <label class="form-label">Egg per Batch</label>
            <input class="form-input" type="number" id="add-batch-egg-qty" value="" min="0" step="1" placeholder="e.g. 12 = 12 eggs per batch">
            <p class="text-xs text-gray-400 mt-1">Number of eggs that make up one batch. Leave blank if not applicable.</p>
        </div>
        <p class="text-sm text-muted">SKU will be generated automatically.</p>
        <div class="form-group" data-add-assignment>
            <label class="form-label">Show in branches</label>
            <label class="flex items-center gap-2 text-sm text-gray-700">
                <input type="radio" name="add-assignment-mode" value="all_active" checked onchange="toggleAddBranchPicker()">
                All active branches
            </label>
            <label class="mt-1 flex items-center gap-2 text-sm text-gray-700">
                <input type="radio" name="add-assignment-mode" value="specific" onchange="toggleAddBranchPicker()">
                Only selected branches
            </label>
            <div id="add-branch-picker" class="mt-2 hidden max-h-40 overflow-y-auto rounded border border-gray-200 bg-white p-2">
                {foreach branches as b}
                <label class="flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" class="add-branch-check" value="{b.id}">
                    {b.code} — {b.name}
                </label>
                {/foreach}
            </div>
        </div>
        <div class="modal-actions">
            <button class="btn btn-outline" onclick="closeModal('add-modal')">Cancel</button>
            <button class="btn btn-primary" id="add-submit" onclick="submitAddProduct()">Add Product</button>
        </div>
    </div>
</div>

<!-- Edit Product Modal -->
<div class="modal-overlay" id="edit-modal">
    <div class="modal product-modal">
        <div class="product-modal__header">
            <h3 class="mb-1">Edit Product</h3>
            <p class="text-sm text-gray-500">Update catalog details and the production output profile used by withdrawal, output, and commissary flows.</p>
        </div>
        <div class="product-modal__body">
            <input type="hidden" id="edit-id">
            <div class="product-modal__grid">
                <div class="product-modal__section">
                    <div class="product-modal__section-title">Catalog</div>
                    <div class="form-group">
                        <label class="form-label">Product Name</label>
                        <input class="form-input" type="text" id="edit-name">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Product Category</label>
                        <select class="form-input" id="edit-category">
                            <option value="bread">Bread</option>
                            <option value="cake">Cake</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label class="form-label">Price (PHP)</label>
                            <input class="form-input" type="number" id="edit-price" step="0.01" min="0">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Sort Order</label>
                            <input class="form-input" type="number" id="edit-sort" min="0">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="edit-effective-from">Effective from</label>
                        <input class="form-input" type="date" id="edit-effective-from" value="{today}" onchange="updateEffectiveFromWarning()">
                        <p class="text-xs text-gray-400 mt-1">Current price effective date: <span id="edit-current-price-effective">Not recorded</span></p>
                        <p class="hidden text-xs text-amber-700 mt-2" id="edit-effective-warning">A past effective date will reprice open ledger entries from that date onward. Closed or frozen days are skipped; reopen them and run the price update again.</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Status</label>
                        <select class="form-input" id="edit-active">
                            <option value="1">Active</option>
                            <option value="0">Inactive</option>
                        </select>
                    </div>
                    <div class="form-group" data-edit-assignment>
                        <label class="form-label">Show in branches</label>
                        <label class="flex items-center gap-2 text-sm text-gray-700">
                            <input type="radio" name="edit-assignment-mode" value="all_active" checked onchange="toggleEditBranchPicker()">
                            All active branches
                        </label>
                        <label class="mt-1 flex items-center gap-2 text-sm text-gray-700">
                            <input type="radio" name="edit-assignment-mode" value="specific" onchange="toggleEditBranchPicker()">
                            Only selected branches
                        </label>
                        <div id="edit-branch-picker" class="mt-2 hidden max-h-40 overflow-y-auto rounded border border-gray-200 bg-white p-2">
                            {foreach branches as b}
                            <label class="flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" class="edit-branch-check" value="{b.id}">
                                {b.code} — {b.name}
                            </label>
                            {/foreach}
                        </div>
                    </div>
                </div>

                <div class="product-modal__section">
                    <div class="product-modal__section-title">Production Profile</div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label class="form-label">Output Pieces per Batch</label>
                            <input class="form-input" type="number" id="edit-output-pieces" min="0" step="1" placeholder="0 = not set">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Output Unit Label</label>
                            <input class="form-input" type="text" id="edit-output-unit" maxlength="20" placeholder="pcs">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Box size (pcs per box)</label>
                        <input class="form-input" type="number" id="edit-pcs-per-pack" min="0" step="1" placeholder="Blank = not sold by box">
                        <p class="text-xs text-gray-400 mt-1">Leave blank unless this item is also sold by whole box (e.g. crinkles 24/box). Cashiers can then withdraw in boxes.</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Kilo per Batch</label>
                        <input class="form-input" type="number" id="edit-batch-kilo-qty" min="0" step="0.001" placeholder="e.g. 5 = 5 kg per batch">
                        <p class="text-xs text-gray-400 mt-1">Kilograms of dough or flour that make up one batch. Leave blank if not applicable.</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Egg per Batch</label>
                        <input class="form-input" type="number" id="edit-batch-egg-qty" min="0" step="1" placeholder="e.g. 12 = 12 eggs per batch">
                        <p class="text-xs text-gray-400 mt-1">Number of eggs that make up one batch. Leave blank if not applicable.</p>
                    </div>
                </div>
            </div>
            <p class="text-sm text-muted mt-4">Dated price changes update mutable daily-ledger snapshots only. Completed POS sales, deliveries, and selling-account snapshots are not repriced.</p>
        </div>
        <div class="modal-actions product-modal__actions">
            <button class="btn btn-outline" onclick="closeModal('edit-modal')">Cancel</button>
            <button class="btn btn-primary" id="edit-submit" onclick="submitEditProduct()">Save Changes</button>
        </div>
    </div>
</div>

<!-- Import CSV Modal -->
<div class="modal-overlay" id="import-modal">
    <div class="modal">
        <h3>Import Products Data</h3>
        <p class="text-sm text-gray-600 mb-4">Required columns are Name, Price.</p>
        <p class="text-sm text-gray-500 mb-4">Download an export first to ensure columns are properly formatted. Category, output pieces per batch, output unit label, batch kilo qty, and batch egg qty are all supported during import.</p>
        <div class="form-group">
            <label class="form-label">CSV File</label>
            <input class="form-input" type="file" id="import-file" accept=".csv">
        </div>
        <div class="modal-actions">
            <button class="btn btn-outline" onclick="closeModal('import-modal')">Cancel</button>
            <button class="btn btn-primary" id="import-submit" onclick="submitImportProduct()">Import File</button>
        </div>
    </div>
</div>
{/block}

{block scripts}
<script>
    var BASE = '{base_url}';
    var TODAY = '{today}';

    function openAddProduct() {
        document.getElementById('add-modal').classList.add('show');
        var allRadio = document.querySelector('input[name="add-assignment-mode"][value="all_active"]');
        if (allRadio) { allRadio.checked = true; }
        Array.prototype.forEach.call(document.querySelectorAll('.add-branch-check'), function (cb) { cb.checked = false; });
        toggleAddBranchPicker();
        document.getElementById('add-name').focus();
    }
    function openImportProduct() { document.getElementById('import-modal').classList.add('show'); }
    function closeModal(id) { document.getElementById(id).classList.remove('show'); }

    function openEditProduct(id, name, category, price, sort, active, outputPieces, outputUnit, batchKiloQty, batchEggQty, pcsPerPack, currentPriceEffectiveFrom, assignmentMode, assignedBranchIdsCsv) {
        document.getElementById('edit-id').value = id;
        document.getElementById('edit-name').value = name;
        document.getElementById('edit-category').value = category || 'bread';
        document.getElementById('edit-price').value = price;
        document.getElementById('edit-sort').value = sort;
        document.getElementById('edit-active').value = active;
        document.getElementById('edit-output-pieces').value = outputPieces || 0;
        document.getElementById('edit-output-unit').value = outputUnit || 'pcs';
        document.getElementById('edit-batch-kilo-qty').value = (batchKiloQty && batchKiloQty > 0) ? batchKiloQty : '';
        document.getElementById('edit-batch-egg-qty').value = (batchEggQty && batchEggQty > 0) ? batchEggQty : '';
        document.getElementById('edit-pcs-per-pack').value = (pcsPerPack && pcsPerPack > 0) ? pcsPerPack : '';
        document.getElementById('edit-effective-from').value = TODAY;
        document.getElementById('edit-current-price-effective').textContent = currentPriceEffectiveFrom || 'Not recorded';
        // Load the CURRENT assignment intent into the modal so opening and saving an
        // edit cannot silently rewrite assignments (the loadiness guard).
        var mode = assignmentMode || 'all_active';
        Array.prototype.forEach.call(document.getElementsByName('edit-assignment-mode'), function (radio) {
            radio.checked = (radio.value === mode);
        });
        var assignedSet = {};
        String(assignedBranchIdsCsv || '').split(',').forEach(function (value) {
            if (value !== '') { assignedSet[parseInt(value, 10)] = true; }
        });
        Array.prototype.forEach.call(document.querySelectorAll('.edit-branch-check'), function (cb) {
            cb.checked = !!assignedSet[parseInt(cb.value, 10)];
        });
        toggleEditBranchPicker();
        updateEffectiveFromWarning();
        document.getElementById('edit-modal').classList.add('show');
        document.getElementById('edit-name').focus();
    }

    function toggleAddBranchPicker() {
        var specific = document.querySelector('input[name="add-assignment-mode"][value="specific"]');
        document.getElementById('add-branch-picker').classList.toggle('hidden', !(specific && specific.checked));
    }

    function toggleEditBranchPicker() {
        var specific = document.querySelector('input[name="edit-assignment-mode"][value="specific"]');
        document.getElementById('edit-branch-picker').classList.toggle('hidden', !(specific && specific.checked));
    }

    function selectedAssignmentMode(name) {
        var checked = document.querySelector('input[name="' + name + '"]:checked');
        return checked ? checked.value : 'all_active';
    }

    function collectCheckedBranches(selector) {
        var ids = [];
        Array.prototype.forEach.call(document.querySelectorAll(selector + ':checked'), function (cb) {
            ids.push(parseInt(cb.value, 10));
        });
        return ids;
    }

    function updateEffectiveFromWarning() {
        var selected = document.getElementById('edit-effective-from').value;
        document.getElementById('edit-effective-warning').classList.toggle('hidden', !selected || selected >= TODAY);
    }

    function submitAddProduct() {
        var btn = document.getElementById('add-submit');
        btn.disabled = true; btn.textContent = 'Adding...';
        fetch(BASE + '/api/v1/admin/products', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name: document.getElementById('add-name').value,
                product_category: document.getElementById('add-category').value,
                price: parseFloat(document.getElementById('add-price').value) || 0,
                sort_order: parseInt(document.getElementById('add-sort').value) || 0,
                output_pieces_per_batch: parseInt(document.getElementById('add-output-pieces').value, 10) || 0,
                output_unit_label: document.getElementById('add-output-unit').value || 'pcs',
                batch_input_qty: parseFloat(document.getElementById('add-batch-kilo-qty').value) || null,
                batch_egg_qty: parseFloat(document.getElementById('add-batch-egg-qty').value) || null,
                pcs_per_pack: parseInt(document.getElementById('add-pcs-per-pack').value, 10) || null,
                assignment_mode: selectedAssignmentMode('add-assignment-mode'),
                branch_ids: (selectedAssignmentMode('add-assignment-mode') === 'specific') ? collectCheckedBranches('.add-branch-check') : []
            })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res.ok) {
                closeModal('add-modal');
                showToast('Product added (SKU: ' + res.sku + ')');
                setTimeout(function() { window.refreshMainContent(); }, 600);
            } else {
                showToast(res.error || 'Failed');
                btn.disabled = false; btn.textContent = 'Add Product';
            }
        })
        .catch(function() { showToast('Network error'); btn.disabled = false; btn.textContent = 'Add Product'; });
    }

    function submitEditProduct() {
        var btn = document.getElementById('edit-submit');
        btn.disabled = true; btn.textContent = 'Saving...';
        fetch(BASE + '/api/v1/admin/products/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                product_id: parseInt(document.getElementById('edit-id').value),
                name: document.getElementById('edit-name').value,
                product_category: document.getElementById('edit-category').value,
                price: parseFloat(document.getElementById('edit-price').value) || 0,
                effective_from: document.getElementById('edit-effective-from').value,
                sort_order: parseInt(document.getElementById('edit-sort').value) || 0,
                is_active: parseInt(document.getElementById('edit-active').value),
                output_pieces_per_batch: parseInt(document.getElementById('edit-output-pieces').value, 10) || 0,
                output_unit_label: document.getElementById('edit-output-unit').value || 'pcs',
                batch_input_qty: parseFloat(document.getElementById('edit-batch-kilo-qty').value) || null,
                batch_egg_qty: parseFloat(document.getElementById('edit-batch-egg-qty').value) || null,
                pcs_per_pack: parseInt(document.getElementById('edit-pcs-per-pack').value, 10) || null,
                assignment_mode: selectedAssignmentMode('edit-assignment-mode'),
                branch_ids: (selectedAssignmentMode('edit-assignment-mode') === 'specific') ? collectCheckedBranches('.edit-branch-check') : []
            })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res.ok) {
                closeModal('edit-modal');
                var reprice = res.reprice || {};
                var message = 'Product updated; ' + (reprice.updated_rows || 0) + ' ledger row(s) repriced';
                if ((reprice.skipped_rows || 0) > 0) message += ', ' + reprice.skipped_rows + ' closed/frozen row(s) skipped';
                showToast(message);
                if (res.warnings && res.warnings.length) {
                    showToast(res.warnings.length + ' older unfinished day(s) remain on this branch (informational).', 'warning');
                }
                setTimeout(function() { window.refreshMainContent(); }, 600);
            } else {
                showToast(res.error || 'Failed');
                btn.disabled = false; btn.textContent = 'Save Changes';
            }
        })
        .catch(function() { showToast('Network error'); btn.disabled = false; btn.textContent = 'Save Changes'; });
    }

    function submitImportProduct() {
        var fileIn = document.getElementById('import-file');
        if (!fileIn.files.length) {
            showToast('Please select a CSV file');
            return;
        }

        var btn = document.getElementById('import-submit');
        var originalText = btn.textContent;
        btn.disabled = true; btn.textContent = 'Processing...';

        var formData = new FormData();
        formData.append('csv_file', fileIn.files[0]);

        fetch(BASE + '/api/v1/admin/products/import-csv', {
            method: 'POST',
            body: formData
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res.ok) {
                closeModal('import-modal');
                showToast(res.message || 'Import successful');
                setTimeout(function() { window.refreshMainContent(); }, 800);
            } else {
                showToast(res.error || 'Import failed');
                btn.disabled = false; btn.textContent = originalText;
            }
        })
        .catch(function() { showToast('Network error'); btn.disabled = false; btn.textContent = originalText; });
    }

    // ── Assignment tab (Slice B) — picker behaviour ────────────────────
    var PICKER_BRANCH_ID = {branch_id | default:0};

    function pickerEscape(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function (c) {
            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
        });
    }

    function updatePickerCheckedCount() {
        var el = document.getElementById('picker-checked-count');
        if (!el) { return; }
        el.textContent = String(document.querySelectorAll('.picker-check:checked').length);
    }

    function filterPicker() {
        var search = document.getElementById('picker-search');
        if (!search) { return; }
        var q = (search.value || '').toLowerCase().trim();
        var rows = document.querySelectorAll('#picker-table tbody tr.picker-row');
        var visible = 0;
        Array.prototype.forEach.call(rows, function (row) {
            var nameCell = row.querySelector('.picker-name');
            var skuCell = row.querySelector('.picker-sku');
            var text = ((nameCell ? nameCell.textContent : '') + ' ' + (skuCell ? skuCell.textContent : '')).toLowerCase();
            var show = q === '' || text.indexOf(q) !== -1;
            row.classList.toggle('is-hidden', !show);
            if (show) { visible++; }
        });
        var count = document.getElementById('picker-visible-count');
        if (count) { count.textContent = String(visible); }
    }

    function pickerCheckAll(checked) {
        Array.prototype.forEach.call(document.querySelectorAll('#picker-table tbody tr.picker-row'), function (row) {
            if (row.classList.contains('is-hidden')) { return; }
            var cb = row.querySelector('.picker-check');
            if (cb) { cb.checked = checked; }
        });
        updatePickerCheckedCount();
    }

    function renderPickerRefusals(res) {
        var box = document.getElementById('picker-refusal');
        if (!box) { return; }
        var refused = (res && res.refused) ? res.refused : [];
        if (!refused.length) {
            box.classList.add('hidden');
            box.innerHTML = '';
            return;
        }
        var html = '<p class="font-semibold text-rose-900">Nothing was saved. These products could not be removed:</p>';
        html += '<ul class="mt-1 list-disc pl-5 text-rose-800">';
        refused.forEach(function (item) {
            var parts = (item.blockers || []).map(function (b) {
                return b.date + ' ' + (b.shift || '') + ' (' + b.ledger + ')';
            });
            html += '<li><span class="font-medium">' + pickerEscape(item.name || ('#' + item.product_id)) + '</span>: '
                + pickerEscape(parts.join(', ')) + '</li>';
        });
        html += '</ul>';
        box.innerHTML = html;
        box.classList.remove('hidden');
    }

    function renderPickerWarnings(warnings) {
        var box = document.getElementById('picker-warning');
        if (!box) { return; }
        warnings = warnings || [];
        if (!warnings.length) {
            box.classList.add('hidden');
            box.innerHTML = '';
            return;
        }
        var html = '<p class="font-semibold">Information: older unfinished days (these do not block saving)</p>';
        html += '<ul class="mt-1 list-disc pl-5">';
        warnings.forEach(function (w) {
            html += '<li>' + pickerEscape(((w.product_name || '') + ' — ' + w.ledger + ' ' + w.date + ' ' + (w.shift || '')).trim()) + '</li>';
        });
        html += '</ul>';
        box.innerHTML = html;
        box.classList.remove('hidden');
    }

    function submitPicker() {
        var btn = document.getElementById('picker-save');
        if (!btn) { return; }
        var original = btn.textContent;
        var ids = [];
        Array.prototype.forEach.call(document.querySelectorAll('.picker-check:checked'), function (cb) {
            ids.push(parseInt(cb.value, 10));
        });
        btn.disabled = true;
        btn.textContent = 'Saving...';
        fetch(BASE + '/api/v1/admin/branches/products', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ branch_id: PICKER_BRANCH_ID, product_ids: ids })
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (res && res.ok) {
                renderPickerRefusals(null);
                renderPickerWarnings(res.warnings || []);
                showToast('Saved: ' + (res.added || 0) + ' shown, ' + (res.removed || 0) + ' hidden');
                btn.disabled = false;
                btn.textContent = original;
                setTimeout(function () { window.refreshMainContent(); }, 800);
            } else {
                renderPickerRefusals(res || {});
                renderPickerWarnings((res && res.warnings) || []);
                showToast((res && res.error) || 'Nothing was saved', 'error');
                btn.disabled = false;
                btn.textContent = original;
            }
        })
        .catch(function () {
            showToast('Network error', 'error');
            btn.disabled = false;
            btn.textContent = original;
        });
    }

    updatePickerCheckedCount();

    // Clicking the overlay background closes the modal (delegated so it survives
    // the in-place #main-content refresh).
    document.addEventListener('click', function(e) {
        if (e.target && e.target.classList && e.target.classList.contains('modal-overlay')) {
            e.target.classList.remove('show');
        }
    });
</script>
{/block}
