{extends "modules/daily-ledger/layouts/app.disyl"}

{block head}
<style>
    .product-modal {
        max-width: 58rem;
        border-radius: 3px;
        padding: 0;
        overflow: hidden;
    }
    .product-modal__header {
        border-bottom: 1px solid rgb(229 231 235);
        padding: 1rem 1.25rem;
    }
    .product-modal__body {
        padding: 1.25rem;
    }
    .product-modal__grid {
        display: grid;
        gap: 1rem 1.25rem;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .product-modal__section {
        border: 1px solid rgb(229 231 235);
        border-radius: 3px;
        background: rgb(248 250 252);
        padding: 1rem;
    }
    .product-modal__section-title {
        margin-bottom: .75rem;
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: rgb(75 85 99);
    }
    .product-modal .form-input,
    .product-modal .btn,
    .product-modal .btn-outline,
    .product-modal .btn-primary {
        border-radius: 3px;
    }
    .product-modal .form-group:last-child {
        margin-bottom: 0;
    }
    .product-modal__actions {
        margin-top: 0;
        border-top: 1px solid rgb(229 231 235);
        padding: .875rem 1.25rem;
    }
    @media (max-width: 767px) {
        .product-modal__grid {
            grid-template-columns: 1fr;
        }
    }
    .picker-row.is-hidden { display: none; }
    .picker-table-wrap { max-height: 60vh; overflow-y: auto; }
    #picker-table thead th { position: sticky; top: 0; z-index: 1; }
    #picker-table tbody td { padding-top: .55rem; padding-bottom: .55rem; }
    .picker-check { width: 1.15rem; height: 1.15rem; }
    .picker-empty { border-top: 1px solid rgb(226 232 240); padding: 2rem 1rem; text-align: center; color: rgb(71 85 105); }
    .picker-refusal-item { margin-top: .75rem; border-left: 3px solid rgb(225 29 72); padding-left: .75rem; }
    .picker-blocker { display: grid; grid-template-columns: 7rem 4rem minmax(0, 1fr); gap: .5rem; margin-top: .25rem; font-size: .75rem; }
    @media (max-width: 639px) {
        .picker-blocker { grid-template-columns: 1fr; gap: 0; }
    }
</style>
{/block}

{block content}
<div class="mb-4 border-b border-gray-200">
    <nav class="flex gap-1" aria-label="Products sections" data-products-tabs>
        <a href="{base_url}/admin/products" data-tab-products {if tab == 'assignment' || tab == 'consignee_assignment'}onclick="return pickerLeaveAssignment(event, this.href)"{/if}
           class="rounded-t px-4 py-2 text-sm font-semibold {if tab == 'assignment' || tab == 'consignee_assignment'}text-gray-500 hover:text-gray-700{else}border-b-2 border-indigo-600 text-indigo-700{/if}">Products</a>
        <a href="{base_url}/admin/products?tab=assignment" data-tab-assignment {if tab == 'assignment' || tab == 'consignee_assignment'}onclick="return pickerLeaveAssignment(event, this.href)"{/if}
           class="rounded-t px-4 py-2 text-sm font-semibold {if tab == 'assignment'}border-b-2 border-indigo-600 text-indigo-700{else}text-gray-500 hover:text-gray-700{/if}">Show in Branches</a>
        {if consignee_enabled}<a href="{base_url}/admin/products?tab=consignee_assignment" data-tab-consignee-assignment {if tab == 'assignment' || tab == 'consignee_assignment'}onclick="return pickerLeaveAssignment(event, this.href)"{/if}
           class="rounded-t px-4 py-2 text-sm font-semibold {if tab == 'consignee_assignment'}border-b-2 border-indigo-600 text-indigo-700{else}text-gray-500 hover:text-gray-700{/if}">Show in Consignees</a>{/if}
    </nav>
</div>

{if tab == 'assignment' || tab == 'consignee_assignment'}
<div class="card mb-4">
    <div class="card-body flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
            <form method="GET" action="{base_url}/admin/products" onsubmit="return window.dlLoadForm(this)" data-picker-branch-form>
                {if tab == 'assignment'}<input type="hidden" name="tab" value="assignment">{/if}
                {if tab == 'consignee_assignment'}<input type="hidden" name="tab" value="consignee_assignment">{/if}
                <label class="form-label" for="picker-branch">{if tab == 'assignment'}Branch{else}Consignee{/if} being edited</label>
                <select class="form-input sm:w-80" id="picker-branch" name="{if tab == 'assignment'}branch_id{else}consignee_id{/if}" onchange="changePickerBranch(this)" data-picker-branch>
                    {if tab == 'assignment'}{foreach branches as b}
                    <option value="{b.id}" {if b.id == branch_id}selected{/if}>{b.code} — {b.name}{if b.is_commissary == 1} (commissary){/if}</option>
                    {/foreach}{/if}
                    {if tab == 'consignee_assignment'}{foreach consignees as c}
                    <option value="{c.id}" {if c.id == consignee_id}selected{/if}>{c.code} — {c.name}</option>
                    {/foreach}{/if}
                </select>
            </form>
            <div>
                <label class="form-label" for="picker-search">Search name or SKU</label>
                <input type="search" class="form-input sm:w-72" id="picker-search" placeholder="e.g. product name or SKU" autocomplete="off" oninput="filterPicker()" data-picker-search>
            </div>
            <div>
                <label class="form-label" for="picker-state">State</label>
                <select class="form-input" id="picker-state" onchange="filterPicker()" data-picker-state>
                    <option value="all">All</option>
                    <option value="shown">Shown here</option>
                    <option value="hidden">Hidden here</option>
                </select>
            </div>
        </div>
        <div class="text-sm text-gray-600" aria-live="polite" aria-atomic="true">
            <span class="font-semibold text-gray-900" id="picker-visible-count">{assignment_products | length}</span>
            matching
            <span class="mx-2 text-gray-300" aria-hidden="true">|</span>
            <span id="picker-checked-count">0</span> shown in {if tab == 'assignment'}branch{else}consignee{/if}
        </div>
    </div>
</div>

{if assignment_branch || assignment_consignee}
<div class="mb-4 rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm text-indigo-900">
    Editing products for
    {if assignment_branch}<span class="font-semibold" data-picker-branch-name>{assignment_branch.code} — {assignment_branch.name}</span>{/if}
    {if assignment_consignee}<span class="font-semibold" data-picker-branch-name>{assignment_consignee.code} — {assignment_consignee.name}</span>{/if}
    {if assignment_branch.is_commissary == 1}<span class="ml-2 inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-semibold text-amber-800 ring-1 ring-inset ring-amber-300">COMMISSARY</span>{/if}
</div>
{/if}

{* The destination you asked for was not available, so this is a different one. Said out loud,
   because Save writes the whole visible list: saving here would change a branch nobody chose. *}
{if destination_substituted_from > 0}
<div class="mb-4 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="alert" data-picker-substituted>
    <div class="font-semibold"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> That destination is not available</div>
    <p class="mt-1">The destination you opened is inactive or no longer exists, so this is a different one. Check the name above before saving.</p>
</div>
{/if}

{if warning_groups | length > 0}
<div class="mb-4 rounded-lg border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900" data-picker-warning-info>
    <div class="font-semibold"><i class="fas fa-circle-info" aria-hidden="true"></i> Information: older unfinished days</div>
    <p class="mt-1">These records <span class="font-semibold">do not block this save</span>. When convenient, review the listed days in the Ledger and complete any missing ending balances that should be recorded.</p>
    <details class="mt-2">
        <summary class="cursor-pointer font-medium">{warning_groups | length} product(s) with older unfinished days</summary>
        <div class="mt-2 space-y-1">
            {foreach warning_groups as wg}
            <div>
                <span class="font-medium">{wg.product_name}</span>
                {foreach wg.items as w}
                <span class="ml-2 whitespace-nowrap text-xs">{w.ledger} {w.date} {w.shift}</span>
                {/foreach}
            </div>
            {/foreach}
        </div>
    </details>
</div>
{/if}

<div class="mb-3 flex flex-wrap items-center gap-2">
    <span class="text-sm font-medium text-gray-700">Bulk change:</span>
    <button type="button" class="btn btn-outline btn-sm" id="picker-show-matching" onclick="pickerCheckAll(true)">Show all matching</button>
    <button type="button" class="btn btn-outline btn-sm" id="picker-hide-matching" onclick="pickerCheckAll(false)">Hide all matching</button>
    <span class="text-xs text-gray-600">Only the products currently matching search + state are changed.</span>
</div>
<div id="picker-change-summary" class="mb-3 rounded border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700" role="status" aria-live="polite" tabindex="-1">
    No unsaved changes. Choose products, then save once.
</div>

<div class="card">
    <div class="table-wrap picker-table-wrap">
        <table id="picker-table" data-picker-table>
            <thead>
                <tr>
                    <th style="width:4.5rem;">Show</th>
                    <th>SKU</th>
                    <th>Product</th>
                    <th>Category</th>
                    <th class="text-right">Product view</th>
                </tr>
            </thead>
            <tbody>
                {foreach assignment_products as p}
                <tr class="picker-row" data-product-id="{p.id}">
                    <td>
                        <input type="checkbox" id="picker-product-{p.id}" class="picker-check" value="{p.id}" data-initial="{p.assigned}" {if p.assigned == 1}checked{/if} onchange="pickerSelectionChanged()" aria-label="Show {p.name} in this {if tab == 'assignment'}branch{else}consignee{/if}" data-product-check>
                    </td>
                    <td class="picker-sku font-mono text-xs text-gray-500">{p.sku}</td>
                    <td class="picker-name font-medium text-gray-900"><label for="picker-product-{p.id}">{p.name}</label></td>
                    <td class="text-xs uppercase tracking-wider text-gray-600">{p.product_category}</td>
                    <td class="text-right">
                        <button type="button" class="btn btn-sm btn-outline" aria-label="Open {p.name} product view" title="View details and all branch assignments"
                            data-price="{p.current_price}" data-sort="{p.sort_order}" data-active="{p.is_active}"
                            data-output-pieces="{p.output_pieces_per_batch | default:0}" data-output-unit="{p.output_unit_label | default:pcs}"
                            data-batch-kilo="{p.batch_input_qty | default:0}" data-batch-eggs="{p.batch_egg_qty | default:0}" data-pack="{p.pcs_per_pack | default:0}"
                            data-effective="{p.current_price_effective_from | default:''}" data-assignment-mode="{p.assignment_mode | default:'all_active'}"
                            data-branches="{p.assigned_branch_ids | default:''}" data-consignee-mode="{p.consignee_assignment_mode | default:'all_active'}" data-consignees="{p.assigned_consignee_ids | default:''}" onclick="openPickerProduct(this)">View product</button>
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
        <div id="picker-empty" class="picker-empty hidden" role="status">
            <p class="font-semibold text-gray-900">No matching products</p>
            <p class="mt-1 text-sm" id="picker-empty-help">Clear the search or choose another state.</p>
        </div>
    </div>
</div>

<div id="picker-refusal" class="hidden mt-4 rounded-lg border border-rose-300 bg-rose-50 px-4 py-3 text-sm text-rose-900" role="alert" aria-live="assertive" tabindex="-1" data-picker-refusal></div>
<div id="picker-warning" class="hidden mt-4 rounded-lg border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900" role="status" aria-live="polite" tabindex="-1" data-picker-save-warning></div>

<div class="mt-4 flex flex-wrap items-center justify-end gap-2">
    <a href="{base_url}/admin/branches" class="btn btn-outline" onclick="return pickerLeaveAssignment(event, this.href)">Back to {if tab == 'assignment'}branches{else}consignees{/if}</a>
    <button type="button" class="btn btn-outline" id="picker-discard" onclick="discardPickerChanges()" disabled>Discard changes</button>
    <button type="button" class="btn btn-primary" id="picker-save" onclick="submitPicker()" disabled data-picker-save>Save changes</button>
</div>
{else}
<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">Products</h2>
        <p class="text-sm text-gray-500">Manage master products and pricing.</p>
    </div>
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
        <form class="flex gap-2" action="{base_url}/admin/products" method="GET"
      onsubmit="return window.dlLoadForm(this)">
            <input type="text" class="form-input w-full sm:w-64" name="q" value="{search}" placeholder="Search name or SKU...">
            <button type="submit" class="btn btn-outline">Search</button>
        </form>
        <div class="flex gap-2 sm:ml-2">
            <a href="{base_url}/admin/products/export" class="btn btn-outline" download>Export CSV</a>
            <button class="btn btn-outline" onclick="openImportProduct()">Import CSV</button>
            <button class="btn btn-primary" onclick="openAddProduct()">+ Add</button>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th class="text-right">Price</th>
                    <th>Output Profile</th>
                    <th class="text-right">Sort</th>
                    <th>Branches</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {foreach products as p}
                <tr>
                    <td class="font-mono text-xs text-gray-500">{p.sku}</td>
                    <td class="font-medium text-gray-900">{p.name}</td>
                    <td class="text-xs text-gray-600 uppercase tracking-wider">{p.product_category}</td>
                    <td class="text-right font-semibold text-gray-900">
                        PHP {p.current_price}
                        <span class="block text-xs font-normal text-gray-400">Effective {p.current_price_effective_from | default:'date not recorded'}</span>
                    </td>
                    <td class="text-sm text-gray-600">
                        {if (p.output_pieces_per_batch | default:0) > 0}
                        {p.output_pieces_per_batch} {p.output_unit_label} / batch
                        {if (p.batch_input_qty | default:0) > 0}
                        <span class="text-gray-400 text-xs"> ({p.batch_input_qty} kg kilo/batch)</span>
                        {/if}
                        {if (p.batch_egg_qty | default:0) > 0}
                        <span class="text-gray-400 text-xs"> ({p.batch_egg_qty} eggs/batch)</span>
                        {/if}
                        {if (p.pcs_per_pack | default:0) > 0}
                        <span class="text-emerald-600 text-xs font-medium"> (box of {p.pcs_per_pack} pcs)</span>
                        {/if}
                        {/if}
                        {if (p.output_pieces_per_batch | default:0) <= 0}
                        <span class="text-gray-400">Not set</span>
                        {/if}
                    </td>
                    <td class="text-right text-sm text-gray-500">{p.sort_order}</td>
                    <td class="text-sm text-muted">{p.branch_count} branches</td>
                    <td>
                        {if p.is_active == 1}<span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-200">Active</span>{/if}
                        {if p.is_active == 0}<span class="inline-flex items-center rounded-full bg-rose-50 px-2.5 py-1 text-xs font-semibold text-rose-700 ring-1 ring-inset ring-rose-200">Inactive</span>{/if}
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline" onclick="openEditProduct({p.id}, '{p.name}', '{p.product_category}', {p.current_price}, {p.sort_order}, {p.is_active}, {p.output_pieces_per_batch | default:0}, '{p.output_unit_label | default:pcs}', {p.batch_input_qty | default:0}, {p.batch_egg_qty | default:0}, {p.pcs_per_pack | default:0}, '{p.current_price_effective_from | default:''}', '{p.assignment_mode | default:'all_active'}', '{p.assigned_branch_ids | default:''}', '{p.consignee_assignment_mode | default:'all_active'}', '{p.assigned_consignee_ids | default:''}')">Edit</button>
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>
</div>
{/if}

<!-- Add Product Modal -->
<div class="modal-overlay" id="add-modal">
    <div class="modal product-modal">
        <div class="product-modal__header">
            <h3 class="mb-1">Add Product</h3>
            <p class="text-sm text-gray-500">Create a catalog product and choose where it appears.</p>
        </div>
        <div class="product-modal__body">
            <div class="product-modal__grid">
                <div class="product-modal__section">
                    <div class="product-modal__section-title">Catalog</div>
                    <div class="form-group">
                        <label class="form-label">Product Name</label>
                        <input class="form-input" type="text" id="add-name" placeholder="e.g. BDAY CAKE 1 LAYER">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Product Category</label>
                        <select class="form-input" id="add-category">
                            <option value="bread">Bread</option>
                            <option value="cake">Cake</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label class="form-label">Price (PHP)</label>
                            <input class="form-input" type="number" id="add-price" step="0.01" min="0" placeholder="0.00">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Sort Order</label>
                            <input class="form-input" type="number" id="add-sort" value="0" min="0">
                        </div>
                    </div>
                </div>

                <div class="product-modal__section">
                    <div class="product-modal__section-title">Production Profile</div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label class="form-label">Output Pieces per Batch</label>
                            <input class="form-input" type="number" id="add-output-pieces" value="0" min="0" step="1" placeholder="0 = not set">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Output Unit Label</label>
                            <input class="form-input" type="text" id="add-output-unit" value="pcs" maxlength="20" placeholder="pcs">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Box size (pcs per box)</label>
                        <input class="form-input" type="number" id="add-pcs-per-pack" value="" min="0" step="1" placeholder="Blank = not sold by box">
                        <p class="text-xs text-gray-400 mt-1">Leave blank unless this item is also sold by whole box (e.g. crinkles 24/box). Cashiers can then withdraw in boxes.</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Kilo per Batch</label>
                        <input class="form-input" type="number" id="add-batch-kilo-qty" value="" min="0" step="0.001" placeholder="e.g. 5 = 5 kg per batch">
                        <p class="text-xs text-gray-400 mt-1">Kilograms of dough/flour that make up one batch. Leave blank if not applicable.</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Egg per Batch</label>
                        <input class="form-input" type="number" id="add-batch-egg-qty" value="" min="0" step="1" placeholder="e.g. 12 = 12 eggs per batch">
                        <p class="text-xs text-gray-400 mt-1">Number of eggs that make up one batch. Leave blank if not applicable.</p>
                    </div>
                </div>

                <div class="product-modal__section col-span-full" data-add-assignment>
                    <div class="product-modal__section-title">Show in branches and consignees</div>
                    <label class="flex items-center gap-2 text-sm text-gray-700">
                        <input type="radio" name="add-assignment-mode" value="all_active" checked onchange="toggleAddBranchPicker()">
                        All active branches and consignees
                    </label>
                    <label class="mt-1 flex items-center gap-2 text-sm text-gray-700">
                        <input type="radio" name="add-assignment-mode" value="specific" onchange="toggleAddBranchPicker()">
                        Only selected branches and consignees
                    </label>
                    <div id="add-branch-picker" class="mt-2 hidden max-h-40 overflow-y-auto rounded border border-gray-200 bg-white p-2">
                        {foreach branches as b}
                        <label class="flex items-center gap-2 text-sm text-gray-700">
                            <input type="checkbox" class="add-branch-check" value="{b.id}">
                            {b.code} — {b.name}
                        </label>
                        {/foreach}
                        <div class="mb-1 mt-2 text-xs font-semibold uppercase tracking-wider text-gray-500">Consignees</div>
                        {foreach consignees as c}
                        <label class="flex items-center gap-2 text-sm text-gray-700">
                            <input type="checkbox" class="add-consignee-check" value="{c.id}">
                            {c.code} — {c.name}
                        </label>
                        {/foreach}
                    </div>
                </div>
            </div>
            <p class="text-sm text-muted mt-4">SKU will be generated automatically.</p>
        </div>
        <div class="modal-actions product-modal__actions">
            <button class="btn btn-outline" onclick="closeModal('add-modal')">Cancel</button>
            <button class="btn btn-primary" id="add-submit" onclick="submitAddProduct()">Add Product</button>
        </div>
    </div>
</div>

<!-- Edit Product Modal -->
<div class="modal-overlay" id="edit-modal">
    <div class="modal product-modal">
        <div class="product-modal__header">
            <h3 class="mb-1">Edit Product</h3>
            <p class="text-sm text-gray-500">Update catalog details and the production output profile used by withdrawal, output, and commissary flows.</p>
        </div>
        <div class="product-modal__body">
            <input type="hidden" id="edit-id">
            <div class="product-modal__grid">
                <div class="product-modal__section">
                    <div class="product-modal__section-title">Catalog</div>
                    <div class="form-group">
                        <label class="form-label">Product Name</label>
                        <input class="form-input" type="text" id="edit-name">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Product Category</label>
                        <select class="form-input" id="edit-category">
                            <option value="bread">Bread</option>
                            <option value="cake">Cake</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label class="form-label">Price (PHP)</label>
                            <input class="form-input" type="number" id="edit-price" step="0.01" min="0">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Sort Order</label>
                            <input class="form-input" type="number" id="edit-sort" min="0">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="edit-effective-from">Effective from</label>
                        <input class="form-input" type="date" id="edit-effective-from" value="{today}" onchange="updateEffectiveFromWarning()">
                        <p class="text-xs text-gray-400 mt-1">Current price effective date: <span id="edit-current-price-effective">Not recorded</span></p>
                        <p class="hidden text-xs text-amber-700 mt-2" id="edit-effective-warning">A past effective date will reprice open ledger entries from that date onward. Closed or frozen days are skipped; reopen them and run the price update again.</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Status</label>
                        <select class="form-input" id="edit-active">
                            <option value="1">Active</option>
                            <option value="0">Inactive</option>
                        </select>
                    </div>
                    <div class="form-group" data-edit-assignment>
                        <label class="form-label">Show in branches</label>
                        <label class="flex items-center gap-2 text-sm text-gray-700">
                            <input type="radio" name="edit-branch-assignment-mode" value="all_active" checked onchange="toggleEditBranchPicker()">
                            All active branches
                        </label>
                        <label class="mt-1 flex items-center gap-2 text-sm text-gray-700">
                            <input type="radio" name="edit-branch-assignment-mode" value="specific" onchange="toggleEditBranchPicker()">
                            Only selected branches
                        </label>
                        <div id="edit-branch-picker" class="mt-2 hidden max-h-40 overflow-y-auto rounded border border-gray-200 bg-white p-2">
                            {foreach branches as b}
                            <label class="flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" class="edit-branch-check" value="{b.id}">
                                {b.code} — {b.name}
                            </label>
                            {/foreach}
                        </div>
                    </div>
                    {* Bridges and consignees have their OWN control. They used to share one, which broke
                       the very guard it existed for: a product that was all_active for branches but
                       specific for consignees could not be represented, so saving an unrelated edit
                       silently rewrote the consignee intent. *}
                    <div class="form-group" data-edit-assignment>
                        <label class="form-label">Show in consignees</label>
                        <label class="flex items-center gap-2 text-sm text-gray-700">
                            <input type="radio" name="edit-consignee-assignment-mode" value="all_active" checked onchange="toggleEditConsigneePicker()">
                            All active consignees
                        </label>
                        <label class="mt-1 flex items-center gap-2 text-sm text-gray-700">
                            <input type="radio" name="edit-consignee-assignment-mode" value="specific" onchange="toggleEditConsigneePicker()">
                            Only selected consignees
                        </label>
                        <div id="edit-consignee-picker" class="mt-2 hidden max-h-40 overflow-y-auto rounded border border-gray-200 bg-white p-2">
                            {foreach consignees as c}
                            <label class="flex items-center gap-2 text-sm text-gray-700">
                                <input type="checkbox" class="edit-consignee-check" value="{c.id}">
                                {c.code} — {c.name}
                            </label>
                            {/foreach}
                        </div>
                    </div>
                </div>

                <div class="product-modal__section">
                    <div class="product-modal__section-title">Production Profile</div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="form-group">
                            <label class="form-label">Output Pieces per Batch</label>
                            <input class="form-input" type="number" id="edit-output-pieces" min="0" step="1" placeholder="0 = not set">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Output Unit Label</label>
                            <input class="form-input" type="text" id="edit-output-unit" maxlength="20" placeholder="pcs">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Box size (pcs per box)</label>
                        <input class="form-input" type="number" id="edit-pcs-per-pack" min="0" step="1" placeholder="Blank = not sold by box">
                        <p class="text-xs text-gray-400 mt-1">Leave blank unless this item is also sold by whole box (e.g. crinkles 24/box). Cashiers can then withdraw in boxes.</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Kilo per Batch</label>
                        <input class="form-input" type="number" id="edit-batch-kilo-qty" min="0" step="0.001" placeholder="e.g. 5 = 5 kg per batch">
                        <p class="text-xs text-gray-400 mt-1">Kilograms of dough or flour that make up one batch. Leave blank if not applicable.</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Egg per Batch</label>
                        <input class="form-input" type="number" id="edit-batch-egg-qty" min="0" step="1" placeholder="e.g. 12 = 12 eggs per batch">
                        <p class="text-xs text-gray-400 mt-1">Number of eggs that make up one batch. Leave blank if not applicable.</p>
                    </div>
                </div>
            </div>
            <p class="text-sm text-muted mt-4">Dated price changes update mutable daily-ledger snapshots only. Completed POS sales, deliveries, and selling-account snapshots are not repriced.</p>
        </div>
        <div class="modal-actions product-modal__actions">
            <button class="btn btn-outline" onclick="closeModal('edit-modal')">Cancel</button>
            <button class="btn btn-primary" id="edit-submit" onclick="submitEditProduct()">Save Changes</button>
        </div>
    </div>
</div>

<!-- Import CSV Modal -->
<div class="modal-overlay" id="import-modal">
    <div class="modal">
        <h3>Import Products Data</h3>
        <p class="text-sm text-gray-600 mb-4">Required columns are Name, Price.</p>
        <p class="text-sm text-gray-500 mb-4">Download an export first to ensure columns are properly formatted. Category, output pieces per batch, output unit label, batch kilo qty, and batch egg qty are all supported during import.</p>
        <div class="form-group">
            <label class="form-label">CSV File</label>
            <input class="form-input" type="file" id="import-file" accept=".csv">
        </div>
        <div class="modal-actions">
            <button class="btn btn-outline" onclick="closeModal('import-modal')">Cancel</button>
            <button class="btn btn-primary" id="import-submit" onclick="submitImportProduct()">Import File</button>
        </div>
    </div>
</div>
{/block}

{block scripts}
<script>
    var BASE = '{base_url}';
    var TODAY = '{today}';

    function openAddProduct() {
        document.getElementById('add-modal').classList.add('show');
        var allRadio = document.querySelector('input[name="add-assignment-mode"][value="all_active"]');
        if (allRadio) { allRadio.checked = true; }
        Array.prototype.forEach.call(document.querySelectorAll('.add-branch-check'), function (cb) { cb.checked = false; });
        toggleAddBranchPicker();
        document.getElementById('add-name').focus();
    }
    function openImportProduct() { document.getElementById('import-modal').classList.add('show'); }
    function closeModal(id) { document.getElementById(id).classList.remove('show'); }

    function openEditProduct(id, name, category, price, sort, active, outputPieces, outputUnit, batchKiloQty, batchEggQty, pcsPerPack, currentPriceEffectiveFrom, assignmentMode, assignedBranchIdsCsv, consigneeAssignmentMode, assignedConsigneeIdsCsv) {
        document.getElementById('edit-id').value = id;
        document.getElementById('edit-name').value = name;
        document.getElementById('edit-category').value = category || 'bread';
        document.getElementById('edit-price').value = price;
        document.getElementById('edit-sort').value = sort;
        document.getElementById('edit-active').value = active;
        document.getElementById('edit-output-pieces').value = outputPieces || 0;
        document.getElementById('edit-output-unit').value = outputUnit || 'pcs';
        document.getElementById('edit-batch-kilo-qty').value = (batchKiloQty && batchKiloQty > 0) ? batchKiloQty : '';
        document.getElementById('edit-batch-egg-qty').value = (batchEggQty && batchEggQty > 0) ? batchEggQty : '';
        document.getElementById('edit-pcs-per-pack').value = (pcsPerPack && pcsPerPack > 0) ? pcsPerPack : '';
        document.getElementById('edit-effective-from').value = TODAY;
        document.getElementById('edit-current-price-effective').textContent = currentPriceEffectiveFrom || 'Not recorded';
        // Load the CURRENT assignment intent into the modal so opening and saving an
        // edit cannot silently rewrite assignments (the loadiness guard).
        //
        // Each scope loads its OWN mode. A missing stored consignee mode falls back to the
        // branch mode, so every existing product keeps behaving exactly as it does today.
        var mode = assignmentMode || 'all_active';
        var consigneeMode = consigneeAssignmentMode || mode;
        Array.prototype.forEach.call(document.getElementsByName('edit-branch-assignment-mode'), function (radio) {
            radio.checked = (radio.value === mode);
        });
        Array.prototype.forEach.call(document.getElementsByName('edit-consignee-assignment-mode'), function (radio) {
            radio.checked = (radio.value === consigneeMode);
        });
        toggleEditBranchPicker();
        toggleEditConsigneePicker();
        var assignedSet = {};
        String(assignedBranchIdsCsv || '').split(',').forEach(function (value) {
            if (value !== '') { assignedSet[parseInt(value, 10)] = true; }
        });
        Array.prototype.forEach.call(document.querySelectorAll('.edit-branch-check'), function (cb) {
            cb.checked = !!assignedSet[parseInt(cb.value, 10)];
        });
        var assignedConsigneeSet = {};
        String(assignedConsigneeIdsCsv || '').split(',').forEach(function (value) {
            if (value !== '') { assignedConsigneeSet[parseInt(value, 10)] = true; }
        });
        Array.prototype.forEach.call(document.querySelectorAll('.edit-consignee-check'), function (cb) {
            cb.checked = !!assignedConsigneeSet[parseInt(cb.value, 10)];
        });
        toggleEditBranchPicker();
        updateEffectiveFromWarning();
        document.getElementById('edit-modal').classList.add('show');
        document.getElementById('edit-name').focus();
    }

    function toggleAddBranchPicker() {
        var specific = document.querySelector('input[name="add-assignment-mode"][value="specific"]');
        document.getElementById('add-branch-picker').classList.toggle('hidden', !(specific && specific.checked));
    }

    function toggleEditBranchPicker() {
        var specific = document.querySelector('input[name="edit-branch-assignment-mode"][value="specific"]');
        document.getElementById('edit-branch-picker').classList.toggle('hidden', !(specific && specific.checked));
    }

    function toggleEditConsigneePicker() {
        var specific = document.querySelector('input[name="edit-consignee-assignment-mode"][value="specific"]');
        document.getElementById('edit-consignee-picker').classList.toggle('hidden', !(specific && specific.checked));
    }

    function selectedAssignmentMode(name) {
        var checked = document.querySelector('input[name="' + name + '"]:checked');
        return checked ? checked.value : 'all_active';
    }

    function collectCheckedBranches(selector) {
        var ids = [];
        Array.prototype.forEach.call(document.querySelectorAll(selector + ':checked'), function (cb) {
            ids.push(parseInt(cb.value, 10));
        });
        return ids;
    }

    function collectCheckedConsignees(selector) {
        return collectCheckedBranches(selector);
    }

    function updateEffectiveFromWarning() {
        var selected = document.getElementById('edit-effective-from').value;
        document.getElementById('edit-effective-warning').classList.toggle('hidden', !selected || selected >= TODAY);
    }

    function submitAddProduct() {
        var btn = document.getElementById('add-submit');
        btn.disabled = true; btn.textContent = 'Adding...';
        fetch(BASE + '/api/v1/admin/products', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name: document.getElementById('add-name').value,
                product_category: document.getElementById('add-category').value,
                price: parseFloat(document.getElementById('add-price').value) || 0,
                sort_order: parseInt(document.getElementById('add-sort').value) || 0,
                output_pieces_per_batch: parseInt(document.getElementById('add-output-pieces').value, 10) || 0,
                output_unit_label: document.getElementById('add-output-unit').value || 'pcs',
                batch_input_qty: parseFloat(document.getElementById('add-batch-kilo-qty').value) || null,
                batch_egg_qty: parseFloat(document.getElementById('add-batch-egg-qty').value) || null,
                pcs_per_pack: parseInt(document.getElementById('add-pcs-per-pack').value, 10) || null,
                assignment_mode: selectedAssignmentMode('add-assignment-mode'),
                branch_ids: (selectedAssignmentMode('add-assignment-mode') === 'specific') ? collectCheckedBranches('.add-branch-check') : [],
                consignee_assignment_mode: selectedAssignmentMode('add-assignment-mode'),
                consignee_ids: (selectedAssignmentMode('add-assignment-mode') === 'specific') ? collectCheckedConsignees('.add-consignee-check') : []
            })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res.ok) {
                closeModal('add-modal');
                showToast('Product added (SKU: ' + res.sku + ')');
                setTimeout(function() { window.refreshMainContent(); }, 600);
            } else {
                showToast(res.error || 'Failed');
                btn.disabled = false; btn.textContent = 'Add Product';
            }
        })
        .catch(function() { showToast('Network error'); btn.disabled = false; btn.textContent = 'Add Product'; });
    }

    function submitEditProduct() {
        var btn = document.getElementById('edit-submit');
        btn.disabled = true; btn.textContent = 'Saving...';
        fetch(BASE + '/api/v1/admin/products/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                product_id: parseInt(document.getElementById('edit-id').value),
                name: document.getElementById('edit-name').value,
                product_category: document.getElementById('edit-category').value,
                price: parseFloat(document.getElementById('edit-price').value) || 0,
                effective_from: document.getElementById('edit-effective-from').value,
                sort_order: parseInt(document.getElementById('edit-sort').value) || 0,
                is_active: parseInt(document.getElementById('edit-active').value),
                output_pieces_per_batch: parseInt(document.getElementById('edit-output-pieces').value, 10) || 0,
                output_unit_label: document.getElementById('edit-output-unit').value || 'pcs',
                batch_input_qty: parseFloat(document.getElementById('edit-batch-kilo-qty').value) || null,
                batch_egg_qty: parseFloat(document.getElementById('edit-batch-egg-qty').value) || null,
                pcs_per_pack: parseInt(document.getElementById('edit-pcs-per-pack').value, 10) || null,
                assignment_mode: selectedAssignmentMode('edit-branch-assignment-mode'),
                branch_ids: (selectedAssignmentMode('edit-branch-assignment-mode') === 'specific') ? collectCheckedBranches('.edit-branch-check') : [],
                consignee_assignment_mode: selectedAssignmentMode('edit-consignee-assignment-mode'),
                consignee_ids: (selectedAssignmentMode('edit-consignee-assignment-mode') === 'specific') ? collectCheckedConsignees('.edit-consignee-check') : []
            })
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res.ok) {
                closeModal('edit-modal');
                var reprice = res.reprice || {};
                var message = 'Product updated; ' + (reprice.updated_rows || 0) + ' ledger row(s) repriced';
                if ((reprice.skipped_rows || 0) > 0) message += ', ' + reprice.skipped_rows + ' closed/frozen row(s) skipped';
                showToast(message);
                if (res.warnings && res.warnings.length) {
                    showToast(res.warnings.length + ' older unfinished day(s) remain on this branch (informational).', 'warning');
                }
                setTimeout(function() { window.refreshMainContent(); }, 600);
            } else {
                showToast(res.error || 'Failed');
                btn.disabled = false; btn.textContent = 'Save Changes';
            }
        })
        .catch(function() { showToast('Network error'); btn.disabled = false; btn.textContent = 'Save Changes'; });
    }

    function submitImportProduct() {
        var fileIn = document.getElementById('import-file');
        if (!fileIn.files.length) {
            showToast('Please select a CSV file');
            return;
        }

        var btn = document.getElementById('import-submit');
        var originalText = btn.textContent;
        btn.disabled = true; btn.textContent = 'Processing...';

        var formData = new FormData();
        formData.append('csv_file', fileIn.files[0]);

        fetch(BASE + '/api/v1/admin/products/import-csv', {
            method: 'POST',
            body: formData
        })
        .then(function(r) { return r.json(); })
        .then(function(res) {
            if (res.ok) {
                closeModal('import-modal');
                showToast(res.message || 'Import successful');
                setTimeout(function() { window.refreshMainContent(); }, 800);
            } else {
                showToast(res.error || 'Import failed');
                btn.disabled = false; btn.textContent = originalText;
            }
        })
        .catch(function() { showToast('Network error'); btn.disabled = false; btn.textContent = originalText; });
    }

    // ── Assignment tab (Slice B) — picker behaviour ────────────────────
    var PICKER_BRANCH_ID = {if tab == 'consignee_assignment'}{consignee_id | default:0}{else}{branch_id | default:0}{/if};
    var PICKER_IS_CONSIGNEE = {if tab == 'consignee_assignment'}true{else}false{/if};
    // The destination this checklist writes to, taken from the header so there is only ONE place it
    // is stated. Used on the save control, which sits 178 rows below that header.
    var pickerDestinationName = (function () {
        var el = document.querySelector('[data-picker-branch-name]');
        if (!el) { return ''; }
        var text = (el.textContent || '').trim();
        var parts = text.split('\u2014');
        return (parts.length > 1 ? parts[parts.length - 1] : text).trim();
    })();

    function pickerEscape(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function (c) {
            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
        });
    }

    var pickerDirty = false;

    function updatePickerCheckedCount() {
        var el = document.getElementById('picker-checked-count');
        if (!el) { return; }
        el.textContent = String(document.querySelectorAll('#picker-table .picker-check:checked').length);
    }

    function pickerChangeCounts() {
        var counts = { shown: 0, hidden: 0 };
        Array.prototype.forEach.call(document.querySelectorAll('#picker-table .picker-check'), function (cb) {
            var initiallyChecked = cb.getAttribute('data-initial') === '1';
            if (cb.checked !== initiallyChecked) {
                counts[cb.checked ? 'shown' : 'hidden']++;
            }
        });
        return counts;
    }

    function updatePickerChangeSummary() {
        var counts = pickerChangeCounts();
        var total = counts.shown + counts.hidden;
        pickerDirty = total > 0;
        var summary = document.getElementById('picker-change-summary');
        var save = document.getElementById('picker-save');
        var discard = document.getElementById('picker-discard');
        if (summary) {
            summary.innerHTML = pickerDirty
                ? '<span class="font-semibold">Unsaved:</span> ' + counts.shown + ' product(s) will be shown and '
                    + counts.hidden + ' product(s) will be hidden. Nothing changes until you save.'
                : 'No unsaved changes. Choose products, then save once.';
        }
        if (save) {
            save.disabled = !pickerDirty;
            // Name the destination ON the control. This editor's Save writes the whole visible list,
            // and the header that names the destination is 178 rows away, so an operator who scrolled
            // down could save a destination they never chose -- which reads as "nothing happened".
            var suffix = pickerDestinationName ? ' to ' + pickerDestinationName : '';
            save.textContent = pickerDirty
                ? 'Save ' + total + ' change' + (total === 1 ? '' : 's') + suffix
                : 'Save changes' + suffix;
        }
        if (discard) { discard.disabled = !pickerDirty; }
    }

    function filterPicker() {
        var search = document.getElementById('picker-search');
        if (!search) { return; }
        var state = document.getElementById('picker-state');
        var stateValue = state ? state.value : 'all';
        var q = (search.value || '').toLowerCase().trim();
        var rows = document.querySelectorAll('#picker-table tbody tr.picker-row');
        var visible = 0;
        Array.prototype.forEach.call(rows, function (row) {
            var nameCell = row.querySelector('.picker-name');
            var skuCell = row.querySelector('.picker-sku');
            var cb = row.querySelector('.picker-check');
            var text = ((nameCell ? nameCell.textContent : '') + ' ' + (skuCell ? skuCell.textContent : '')).toLowerCase();
            var matchesText = q === '' || text.indexOf(q) !== -1;
            var matchesState = stateValue === 'all' || (stateValue === 'shown' ? cb.checked : !cb.checked);
            var show = matchesText && matchesState;
            row.classList.toggle('is-hidden', !show);
            if (show) { visible++; }
        });
        var count = document.getElementById('picker-visible-count');
        var empty = document.getElementById('picker-empty');
        var emptyHelp = document.getElementById('picker-empty-help');
        var showMatching = document.getElementById('picker-show-matching');
        var hideMatching = document.getElementById('picker-hide-matching');
        if (count) { count.textContent = String(visible); }
        if (empty) { empty.classList.toggle('hidden', visible !== 0); }
        if (emptyHelp) {
            emptyHelp.textContent = rows.length === 0
                ? 'There are no active products to assign.'
                : 'Clear the search or choose another state.';
        }
        if (showMatching) {
            showMatching.disabled = visible === 0;
            showMatching.textContent = 'Show all ' + visible + ' matching';
        }
        if (hideMatching) {
            hideMatching.disabled = visible === 0;
            hideMatching.textContent = 'Hide all ' + visible + ' matching';
        }
    }

    function pickerSelectionChanged() {
        updatePickerCheckedCount();
        updatePickerChangeSummary();
        filterPicker();
    }

    function pickerCheckAll(checked) {
        var matched = [];
        Array.prototype.forEach.call(document.querySelectorAll('#picker-table tbody tr.picker-row'), function (row) {
            if (!row.classList.contains('is-hidden')) { matched.push(row); }
        });
        Array.prototype.forEach.call(matched, function (row) {
            var cb = row.querySelector('.picker-check');
            if (cb) { cb.checked = checked; }
        });
        pickerSelectionChanged();
    }

    function changePickerBranch(select) {
        if (pickerDirty && !window.confirm('Discard the unsaved product changes and switch branches?')) {
            select.value = String(PICKER_BRANCH_ID);
            return;
        }
        pickerDirty = false;
        window.dlLoadForm(select.form);
    }

    function pickerLeaveAssignment(event, href) {
        if (pickerDirty && !window.confirm('Discard the unsaved product changes and leave this page?')) {
            if (event) { event.preventDefault(); }
            return false;
        }
        pickerDirty = false;
        return true;
    }

    function discardPickerChanges() {
        Array.prototype.forEach.call(document.querySelectorAll('#picker-table .picker-check'), function (cb) {
            cb.checked = cb.getAttribute('data-initial') === '1';
        });
        pickerSelectionChanged();
    }

    function openPickerProduct(button) {
        if (pickerDirty) {
            showToast('Save or discard this destination’s changes before opening a product.', 'warning');
            document.getElementById('picker-change-summary').focus();
            return;
        }
        var row = button.closest('tr');
        openEditProduct(
            parseInt(row.getAttribute('data-product-id'), 10),
            row.querySelector('.picker-name').textContent.trim(),
            row.querySelector('td:nth-child(4)').textContent.trim().toLowerCase(),
            parseFloat(button.getAttribute('data-price')) || 0,
            parseInt(button.getAttribute('data-sort'), 10) || 0,
            parseInt(button.getAttribute('data-active'), 10),
            parseInt(button.getAttribute('data-output-pieces'), 10) || 0,
            button.getAttribute('data-output-unit') || 'pcs',
            parseFloat(button.getAttribute('data-batch-kilo')) || 0,
            parseFloat(button.getAttribute('data-batch-eggs')) || 0,
            parseInt(button.getAttribute('data-pack'), 10) || 0,
            button.getAttribute('data-effective') || '',
            button.getAttribute('data-assignment-mode') || 'all_active',
            button.getAttribute('data-branches') || '',
            button.getAttribute('data-consignee-mode') || 'all_active',
            button.getAttribute('data-consignees') || ''
        );
    }

    function renderPickerRefusals(res) {
        var box = document.getElementById('picker-refusal');
        if (!box) { return; }
        var refused = (res && res.refused) ? res.refused : [];
        if (!refused.length) {
            box.classList.add('hidden');
            box.innerHTML = '';
            return;
        }
        var html = '<p class="font-semibold text-rose-900"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> Nothing was saved</p>';
        html += '<p class="mt-1">Enter the missing ending balance for each date and shift below, then try this all-or-nothing save again.</p>';
        refused.forEach(function (item) {
            html += '<section class="picker-refusal-item"><h3 class="font-semibold">'
                + pickerEscape(item.name || ('Product #' + item.product_id)) + '</h3>';
            (item.blockers || []).forEach(function (b) {
                html += '<div class="picker-blocker"><span><span class="sr-only">Date: </span>' + pickerEscape(b.date || '')
                    + '</span><span><span class="sr-only">Shift: </span>' + pickerEscape(b.shift || 'shift not named')
                    + '</span><span><span class="sr-only">Ledger: </span>' + pickerEscape(b.ledger || '') + '</span></div>';
            });
            html += '</section>';
        });
        box.innerHTML = html;
        box.classList.remove('hidden');
        box.focus();
    }

    function renderPickerWarnings(warnings) {
        var box = document.getElementById('picker-warning');
        if (!box) { return; }
        warnings = warnings || [];
        if (!warnings.length) {
            box.classList.add('hidden');
            box.innerHTML = '';
            return;
        }
        var html = '<p class="font-semibold"><i class="fas fa-circle-info" aria-hidden="true"></i> Information: older unfinished days (these do not block saving)</p>';
        html += '<p class="mt-1">When convenient, review these days in the Ledger and complete any missing ending balances that should be recorded.</p><ul class="mt-1 list-disc pl-5">';
        warnings.forEach(function (w) {
            html += '<li>' + pickerEscape(((w.product_name || '') + ' — ' + w.ledger + ' ' + w.date + ' ' + (w.shift || '')).trim()) + '</li>';
        });
        html += '</ul>';
        box.innerHTML = html;
        box.classList.remove('hidden');
        box.focus();
    }

    function submitPicker() {
        var btn = document.getElementById('picker-save');
        if (!btn) { return; }
        var original = btn.textContent;
        var ids = [];
        Array.prototype.forEach.call(document.querySelectorAll('.picker-check:checked'), function (cb) {
            ids.push(parseInt(cb.value, 10));
        });
        btn.disabled = true;
        btn.textContent = 'Saving...';
        var pickerEndpoint = PICKER_IS_CONSIGNEE ? '/api/v1/admin/consignees/products' : '/api/v1/admin/branches/products';
        var pickerPayload = PICKER_IS_CONSIGNEE
            ? { consignee_id: PICKER_BRANCH_ID, product_ids: ids }
            : { branch_id: PICKER_BRANCH_ID, product_ids: ids };
        fetch(BASE + pickerEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(pickerPayload)
        })
        .then(function (r) { return r.json(); })
        .then(function (res) {
            if (res && res.ok) {
                renderPickerRefusals(null);
                renderPickerWarnings(res.warnings || []);
                pickerDirty = false;
                showToast('Saved: ' + (res.added || 0) + ' shown, ' + (res.removed || 0) + ' hidden');
                btn.disabled = false;
                btn.textContent = original;
                setTimeout(function () { window.refreshMainContent(); }, 800);
            } else {
                renderPickerRefusals(res || {});
                renderPickerWarnings((res && res.warnings) || []);
                showToast((res && res.error) || 'Nothing was saved', 'error');
                btn.disabled = false;
                btn.textContent = original;
            }
        })
        .catch(function () {
            showToast('Network error', 'error');
            btn.disabled = false;
            btn.textContent = original;
        });
    }

    updatePickerCheckedCount();
    updatePickerChangeSummary();
    filterPicker();
    window.onbeforeunload = function () {
        if (pickerDirty) { return 'You have unsaved destination product changes.'; }
    };

    // Clicking the overlay background closes the modal (delegated so it survives
    // the in-place #main-content refresh).
    document.addEventListener('click', function(e) {
        if (e.target && e.target.classList && e.target.classList.contains('modal-overlay')) {
            e.target.classList.remove('show');
        }
    });
</script>
{/block}
