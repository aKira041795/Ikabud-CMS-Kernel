{extends "modules/daily-ledger/layouts/app.disyl"}

{block content}
<div class="flex items-center justify-between mb-6">
    <div>
        <h2 class="text-lg font-semibold text-gray-900">Production Efficiency</h2>
        <p class="text-sm text-gray-500">Two separate measures for {period_label}: production recorded by the branches that actually produce (output, yield, wastage), and stock movement across every branch in scope (received, sold, conversion). They are reported side by side and never divided by one another. Read-only: this page never changes production or ledger entries.</p>
    </div>
    <div class="flex gap-2">
        <a class="btn btn-outline" href="{base_url}/admin/forecast?date_from={date_from}&amp;date_to={date_to}&amp;branch_id={branch_id}">Forecast</a>
        <a class="btn btn-outline" href="{base_url}/admin/overview?date_from={date_from}&amp;date_to={date_to}&amp;branch_id={branch_id}">Business Health</a>
    </div>
</div>

<!-- Primary filter: Area, Branch, From/To and the production-vs-pullout control, all GET on this
     page. The movement control carries the same period/area/branch scope through. -->
<form class="card mb-6 print-hide" action="{base_url}/admin/production-efficiency" method="GET" onsubmit="return window.dlLoadForm(this)">
    <div class="card-body grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-6 items-end">
        <div class="form-group">{include "modules/daily-ledger/admin/partials/scope-filter.disyl"}</div>
        <div class="form-group">
            <label class="form-label">Branch</label>
            <select class="form-input" name="branch_id">
                <option value="">All branches in area</option>
                {foreach branches as br}<option value="{br.id}" {if br.id == branch_id}selected{/if}>{br.name}</option>{/foreach}
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">From</label>
            <input class="form-input" type="date" name="date_from" value="{date_from}">
        </div>
        <div class="form-group">
            <label class="form-label">To</label>
            <input class="form-input" type="date" name="date_to" value="{date_to}">
        </div>
        <div class="form-group">
            <label class="form-label">Movement</label>
            <select class="form-input" name="movement_view" onchange="this.form.submit()">
                <option value="production" {if movement_view == 'production'}selected{/if}>Production vs sales</option>
                <option value="pullout" {if movement_view == 'pullout'}selected{/if}>Pullouts &amp; unsellable</option>
                <option value="all" {if movement_view == 'all'}selected{/if}>Both</option>
            </select>
        </div>
        <div class="form-group">
            <label class="inline-flex items-center gap-2 text-sm"><input type="hidden" name="pending_rows" value="include"><input type="checkbox" name="pending_rows" value="exclude" {if exclude_provisional}checked{/if}> Official rows only</label>
        </div>
        <button type="submit" class="btn btn-primary">Apply</button>
    </div>
</form>

<!-- Basis. Money on this page is official-only; the UNIT counts follow the same rule only when the
     owner asks for it, and the page then states how many units that removed. The Overview uses the
     same control and the same definition of "official" (dl_rowIsProvisional), so the two pages can
     never disagree about which rows a basis admitted. -->
<div class="rounded-lg {if official_only}bg-emerald-50 text-emerald-900 ring-1 ring-inset ring-emerald-200{/if}{if official_only == false}bg-amber-50 text-amber-900 ring-1 ring-inset ring-amber-200{/if} p-4 text-sm mb-4">
    <strong>Basis: {units_basis}.</strong>
    {if official_only}Excluded from the unit counts: <strong>{excluded_units} pcs</strong> carried by provisional rows &mdash; shifts never finalized, derived or zero-forced endings, and entries with no count yet. Everything above is an official figure.{/if}
    {if official_only == false}Tick <em>Official rows only</em> to exclude provisional rows and see official figures instead.{/if}
</div>

<!-- TWO PANELS, deliberately never merged into one ratio. SOURCE PRODUCTION is what the branches that
     actually produce recorded; STOCK MOVEMENT is what every branch in scope received and sold. The
     previous single panel divided destination sales by source output and reported 1,162.38%
     sell-through at all-branch scope, because the two sides are different populations over
     different windows. They are now reported side by side and never divided by one another. -->
<div class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Source production &mdash; producing branches only</div>
{if has_producer_in_scope == false}
<div class="rounded-lg bg-amber-50 p-4 text-sm text-amber-900 mb-4 ring-1 ring-inset ring-amber-200">
    <strong>No producing branch in this scope: production is <em>not recorded</em> here, which is not the
    same as zero.</strong>
    None of the branches selected for {period_label} recorded production, so there is no output to report.
    The stock they sold was <em>received</em>:
    {foreach supplied_branches as supplied_label}<span class="inline-block mr-3 font-medium">{supplied_label}</span>{/foreach}
    Rendering "0 produced" here would read as "this branch produced nothing and incurred no waste", which is a
    different claim from "this branch is supplied". The stock-movement panel below reports what they received.
</div>
{/if}
{if has_producer_in_scope}
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-4">
    <div class="card"><div class="card-body"><div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Produced</div><div class="mt-1 text-3xl font-semibold text-indigo-600">{produced} pcs</div><div class="text-sm text-gray-500">output recorded on {production_positive_days} day(s), of {production_days} day(s) carrying records</div></div></div>
    <div class="card"><div class="card-body"><div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Wastage</div><div class="mt-1 text-3xl font-semibold text-rose-600">{wasted} pcs</div><div class="text-sm text-gray-500">spoilage / unsellable, against the producer's own output</div></div></div>
    <div class="card"><div class="card-body"><div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Closing stock (calculated)</div><div class="mt-1 text-3xl font-semibold text-slate-600">{if closing_available}{closing_calculated} pcs{/if}{if closing_available == false}<span class="text-lg text-amber-700">n/a</span>{/if}</div><div class="text-sm text-gray-500">opening {opening} + produced {produced} &minus; dispatched {dispatched} &minus; wastage {wasted}. Opening stock is included, so this cannot read as a deficit.</div>{if closing_available == false}<div class="text-xs text-amber-700" title="{closing_state}">{closing_state}</div>{/if}{if counted_rows > 0}<div class="text-xs text-gray-500">Physical count on {counted_rows} row(s): {physical_end} pcs.</div>{/if}</div></div>
    <div class="card"><div class="card-body"><div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Yield %</div><div class="mt-1 text-3xl font-semibold text-indigo-700">{if yield_available}{yield_pct | number_format:2}%{/if}{if yield_available == false}<span class="text-lg text-amber-700">n/a</span>{/if}</div><div class="text-sm text-gray-500">produced output / theoretical output from batch input</div>{if yield_exceeds}<div class="text-xs font-semibold text-rose-700">output exceeds the batch basis - see coverage note</div>{/if}</div></div>
</div>
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-6">
    <div class="card"><div class="card-body"><div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Wastage rate</div><div class="mt-1 text-3xl font-semibold text-rose-700">{if wastage_rate_available}{wastage_rate_pct | number_format:2}%{/if}{if wastage_rate_available == false}<span class="text-lg text-amber-700">n/a</span>{/if}</div><div class="text-sm text-gray-500">wasted / produced</div></div></div>
    <div class="card"><div class="card-body"><div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Yield coverage</div><div class="mt-1 text-2xl font-semibold text-slate-600">{yield_products_computable} of {yield_products_total}</div><div class="text-sm text-gray-500">product(s) whose yield basis is computable</div></div></div>
    <div class="card"><div class="card-body"><div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Counted variance</div><div class="mt-1 text-2xl font-semibold text-slate-600">{counted_variance} pcs</div><div class="text-sm text-gray-500">physical count less book balance, only where a count exists. This is the unexplained-loss control.</div></div></div>
    <div class="card"><div class="card-body"><div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Dispatched</div><div class="mt-1 text-2xl font-semibold text-slate-600">{dispatched} pcs</div><div class="text-sm text-gray-500">output that left the producer</div></div></div>
</div>
{/if}

<div class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Stock movement &mdash; every branch in scope</div>
<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 mb-6">
    <div class="card"><div class="card-body"><div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Stock received</div><div class="mt-1 text-3xl font-semibold text-indigo-600">{received} pcs</div><div class="text-sm text-gray-500">posted receipts: {receipt_docs} document(s) across {receipt_days} day(s){if received_internal > 0}; {received_internal} pcs moved between branches inside this scope{/if}</div></div></div>
    <div class="card"><div class="card-body"><div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Sold</div><div class="mt-1 text-3xl font-semibold text-emerald-600">{sold} pcs</div><div class="text-sm text-gray-500">{if official_only}official sales units only{/if}{if official_only == false}official + provisional sales units{/if}</div></div></div>
    <div class="card"><div class="card-body"><div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Stock conversion</div><div class="mt-1 text-3xl font-semibold text-emerald-700">{if conversion_available == false}<span class="text-lg text-amber-700">n/a</span>{/if}{if conversion_available}{if conversion_exceeds}<span class="text-lg text-amber-700">above 100% - see note</span>{/if}{if conversion_exceeds == false}{conversion_pct | number_format:2}%{/if}{/if}</div><div class="text-sm text-gray-500">sold / stock received. This is conversion of received stock, never production efficiency.</div></div></div>
    <div class="card"><div class="card-body"><div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Add Stock adjustments</div><div class="mt-1 text-2xl font-semibold text-slate-600">{adjustment_add} pcs</div><div class="text-sm text-gray-500">operator corrections, disclosed separately and never counted as received production</div></div></div>
</div>
{if conversion_available == false || conversion_exceeds}
<div class="rounded-lg bg-amber-50 p-4 text-sm text-amber-900 mb-4 ring-1 ring-inset ring-amber-200">
    <strong>Stock conversion coverage.</strong> {conversion_state}
    {if conversion_exceeds}Sold {sold} pcs against {received} pcs received. The units that sold came partly from
    opening stock, which this period's receipts do not contain, so the figure is stated as a coverage finding
    and never as a performance rate.{/if}
</div>
{/if}

<!-- Direction key. The owner's rule is OPPOSITE on the two sides of this page, so the direction
     of "good" is stated per metric and the arrows are coloured accordingly. This is a key, not a
     global "up is green" rule: gain metrics are green when they rise, loss metrics are green when
     they FALL. -->
<div class="rounded-lg bg-slate-50 p-4 text-sm text-slate-700 mb-4 ring-1 ring-inset ring-slate-200">
    <strong>Direction key: the colour follows improvement, not raw direction.</strong>
    <ul class="mt-1 list-disc pl-5">
        <li><strong>Gain metrics - yield % and stock conversion %: higher is better.</strong>
            A rise is <span class="{direction_key_gain_up_class} font-semibold" title="higher is better">&#9650;</span> green;
            a fall is <span class="{direction_key_gain_down_class} font-semibold" title="lower is worse">&#9660;</span> red.</li>
        <li><strong>Loss metric - wastage rate: lower is better.</strong>
            A fall is <span class="{direction_key_loss_down_class} font-semibold" title="lower is better">&#9660;</span> green;
            a rise is <span class="{direction_key_loss_up_class} font-semibold" title="higher is worse">&#9650;</span> red.
            Each arrow compares this period with the immediately preceding period of the same length ({prior_period_label});
            when no prior period exists the marker is a stated dash, never an invented direction. The red
            <em>exceeds</em> markers elsewhere are warnings to check the data, not direction indicators.</li>
    </ul>
</div>

<div class="rounded-lg bg-amber-50 p-4 text-sm text-amber-900 mb-4 ring-1 ring-inset ring-amber-200">
    <strong>Basis.</strong> Every quantity on this page is an integer count of <strong>pieces (pcs)</strong>.
    Sales units follow the product ranking: a <strong>provisional</strong> (unfinalized) ledger row contributes
    units but never an amount, so the ratios use the same unit the ranking sums. Money in this module is
    <strong>official-only</strong>; this view reports no money at all, so a ratio here cannot be read as revenue.
</div>

{if has_producer_in_scope}
{if coverage_complete == false}
<div class="rounded-lg bg-rose-50 p-4 text-sm text-rose-900 mb-4 ring-1 ring-inset ring-rose-200">
    <strong>Production coverage: the source panel is not period-matched.</strong>
    The requested period covers {period_days} day(s) ({period_label}), but production records exist for only
    {production_days} day(s){if production_min_date && production_max_date} ({production_min_date} to {production_max_date}){/if},
    of which {production_positive_days} carry actual output. Sales and receipts below cover the whole requested
    period. Each panel therefore states its own window and they are never combined into one ratio: comparing a full
    period of sales against a narrower window of output is what produced the 1,162.38% this page used to show.
</div>
{/if}
{/if}

{if yield_products_missing_basis > 0 || yield_products_missing_input > 0}
<div class="rounded-lg bg-amber-50 p-4 text-sm text-amber-900 mb-4 ring-1 ring-inset ring-amber-200">
    <strong>Yield coverage: a stated gap, not a silent 100% or an exclusion.</strong>
    Yield is computable for {yield_products_computable} of {yield_products_total} product(s) in scope.
    {if yield_products_missing_basis > 0}{yield_products_missing_basis} product(s) have no batch input basis configured (batch_input_qty / batch_egg_qty together with output_pieces_per_batch), so no yield can be computed for them.{/if}
    {if yield_products_missing_input > 0}{yield_products_missing_input} product(s) have a batch basis but no complete recorded input in this period.{/if}
    A yield that covers only part of the catalogue is reported as exactly that.
</div>
{/if}

<div class="rounded-lg bg-slate-50 p-4 text-sm text-slate-700 mb-6 ring-1 ring-inset ring-slate-200">
    <strong>How each figure is measured, and where it cannot be.</strong>
    <ul class="mt-1 list-disc pl-5">
        {if has_producer_in_scope}
        <li><strong>Yield % = produced output / theoretical output &times; 100</strong>. This is the production-efficiency measure, not sell-through. The theoretical output uses this repo's own batch basis (migration 016): <strong>theoretical output = FLOOR(input_qty / batch_input_qty) &times; output_pieces_per_batch</strong>, with batch_egg_qty in place of batch_input_qty for egg products. Input is the batch input recorded in the production runs (kilo or egg); output is pieces. A product with no batch input basis shows an explicit yield gap rather than 100%.</li>
        <li><strong>Stock conversion % = sold / stock received &times; 100</strong>. This is the DESTINATION measure: of the stock that arrived in {period_label}, how much was sold. It is not production efficiency, and it is not sold/produced. The figure that used to be here divided destination sales by source output over non-matching windows and reported 1,162.38% at all-branch scope. A product sold from opening stock with nothing received shows an explicit gap instead. When the period received no stock at all, the ratio is <em>n/a</em>, never 0%.</li>
        <li><strong>Stock received</strong> is the sum of POSTED receiving documents ({receipt_docs} document(s) on {receipt_days} day(s)), taken from the receiving tables, not from <em>dl_daily_ledger.addtl</em>. <em>addtl</em> is an accumulator that also contains operator Add Stock corrections ({adjustment_add} pcs in this period), so using it as "stock received" would fold corrections into a performance ratio. Branch-to-branch transfers inside the selected scope are part of the receiving total and are stated; at network scope they are internal movement, not new stock.</li>
        <li><strong>Wastage rate = wasted / produced</strong>, never wasted / remaining. <em>remaining_qty</em> is a generated column that already subtracts wastage, so dividing by it would overstate loss by everything still on the shelf.</li>
        <li><strong>Shrinkage is not reported as a percentage.</strong> The old residual divided one population by another: it subtracted destination sales from source output and divided by output, which is why it read -1,020.25%. Unexplained loss is now the <em>counted variance</em> above: physical count less book balance, and only for rows that were actually counted, so an uncounted product states a gap instead of inventing a residual.</li>
        <li><strong>Produced but not sold is stock, not waste.</strong> Closing stock is <strong>opening + produced &minus; dispatched &minus; wastage</strong> = {closing_calculated} pcs, which includes the opening balance of {opening} pcs. The generated <em>remaining_qty</em> column omits opening stock and reads negative at a producer that drew on stock it already had, so it is not used as closing stock.</li>
        {/if}
        <li><strong>Sales and output are both period flows.</strong> A unit sold in {period_label} may have been produced in an earlier period, and output produced now may still be in stock. The rates compare this period's output with this period's input or sales, not matched production lots.</li>
        <li><strong>A product with stock received but no sales</strong> shows conversion 0.00%. A product <strong>sold without any receipt in the period</strong> shows an explicit <em>not recorded</em> state naming opening stock, because the period's inflow does not account for those units. When the scope received nothing and sold nothing, the ratio is <em>n/a</em>, never a 0% that reads as failure.</li>
        {if has_producer_in_scope}
        <li>Counted ending variance in scope: {counted_variance} pcs (physical count less the book balance, only for rows that were actually counted). Dispatched in scope: {dispatched} pcs.</li>
        {/if}
    </ul>
</div>

{if movement_view == 'production' || movement_view == 'all'}
<div class="card mb-6">
    <div class="card-header"><span>Production vs sales vs wastage, per product</span><span class="text-sm text-muted">{product_count} product(s) with output or sales</span></div>
    {if products | count == 0}
    <div class="card-body text-sm text-gray-500">Nothing was produced or sold in {period_label} for this scope. Widen the date range or clear the branch filter.</div>
    {/if}
    {if products | count > 0}
    <div class="table-wrap"><table>
        <thead><tr><th>Product</th><th>SKU</th>{if has_producer_in_scope}<th class="text-right">Produced</th><th class="text-right">Wasted</th><th class="text-right">Yield</th><th class="text-right">Wastage rate</th><th class="text-right">Closing stock</th>{/if}<th class="text-right">Received</th><th class="text-right">Sold</th><th class="text-right">Conversion</th></tr></thead>
        <tbody>
        {foreach products as row}
        <tr>
            <td class="font-medium text-gray-900">{row.product_name}</td>
            <td class="text-xs text-gray-500">{row.sku}</td>
            {if has_producer_in_scope}
            <td class="text-right">{row.produced}</td>
            <td class="text-right">{row.wasted}</td>
            <td class="text-right">
                {if row.yield_state == ''}{row.yield_pct | number_format:2}%{/if}
                {if row.yield_state == ''}<span class="ml-1 text-xs {row.yield_trend_class}" title="{row.yield_trend_title}" aria-label="yield trend {row.yield_trend}">{row.yield_trend_arrow}</span>{/if}
                {if row.yield_exceeds}<span class="ml-1 rounded bg-rose-100 px-1 text-xs font-semibold text-rose-700" title="check this: output exceeds the theoretical batch yield for this product">exceeds</span>{/if}
                {if row.yield_state != ''}<span class="text-xs text-amber-700" title="{row.yield_state}">n/a</span>{/if}
            </td>
            <td class="text-right">
                {if row.wastage_state == ''}{row.wastage_rate_pct | number_format:2}%{/if}
                {if row.wastage_state == ''}<span class="ml-1 text-xs {row.wastage_trend_class}" title="{row.wastage_trend_title}" aria-label="wastage rate trend {row.wastage_trend}">{row.wastage_trend_arrow}</span>{/if}
                {if row.wastage_state != ''}<span class="text-xs text-amber-700" title="{row.wastage_state}">not recorded</span>{/if}
            </td>
            <td class="text-right text-gray-500" title="Opening + produced - dispatched - wastage. Includes opening stock, unlike the generated remaining_qty.">
                {if row.closing_state == ''}{row.closing_calculated}{/if}
                {if row.closing_state != ''}<span class="text-xs text-amber-700" title="{row.closing_state}">n/a</span>{/if}
            </td>
            {/if}
            <td class="text-right">{row.received}</td>
            <td class="text-right">{row.sold}</td>
            <td class="text-right">
                {if row.conversion_state == ''}{if row.conversion_exceeds == false}{row.conversion_pct | number_format:2}%{/if}{/if}
                {if row.conversion_state == ''}<span class="ml-1 text-xs {row.conversion_trend_class}" title="{row.conversion_trend_title}" aria-label="conversion trend {row.conversion_trend}">{row.conversion_trend_arrow}</span>{/if}
                {if row.conversion_exceeds}<span class="ml-1 rounded bg-amber-100 px-1 text-xs font-semibold text-amber-800" title="sold more than was received in this period; the rest came from opening stock">from opening stock</span>{/if}
                {if row.conversion_state != ''}<span class="text-xs text-amber-700" title="{row.conversion_state}">n/a</span>{/if}
            </td>
        </tr>
        {/foreach}
        </tbody>
    </table></div>
    {/if}
</div>
{/if}

{if movement_view == 'pullout' || movement_view == 'all'}
<div class="grid grid-cols-1 gap-4 sm:grid-cols-3 mb-6">
    <div class="card"><div class="card-body"><div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Wastage-classified pullouts</div><div class="mt-1 text-2xl font-semibold text-rose-700">{pullout_totals.wastage_qty} pcs</div><div class="text-sm text-gray-500">spoilage / damage, the only pullout reasons that are loss</div></div></div>
    <div class="card"><div class="card-body"><div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Consumed at branch</div><div class="mt-1 text-2xl font-semibold text-amber-700">{pullout_totals.consumed_qty} pcs</div><div class="text-sm text-gray-500">staff meal / sampling / testing / promo / donation: not waste, not stock</div></div></div>
    <div class="card"><div class="card-body"><div class="text-xs font-semibold uppercase tracking-wide text-gray-500">Returned saleable</div><div class="mt-1 text-2xl font-semibold text-emerald-700">{pullout_totals.saleable_qty} pcs</div><div class="text-sm text-gray-500">went back to stock, so not loss</div></div></div>
</div>
<div class="card mb-6">
    <div class="card-header"><span>Pullout / unsellable movements, by the recorded reason</span><span class="text-sm text-muted">{pullout_totals.movements} movement(s) in {period_label}</span></div>
    {if pullout_rows | count == 0}
    <div class="card-body text-sm text-gray-500">No pullout movements were recorded in {period_label} for this scope.</div>
    {/if}
    {if pullout_rows | count > 0}
    <div class="table-wrap"><table>
        <thead><tr><th>Product</th><th>SKU</th><th>Reason</th><th>Classification</th><th class="text-right">Movements</th><th class="text-right">Quantity</th></tr></thead>
        <tbody>
        {foreach pullout_rows as row}
        <tr>
            <td class="font-medium text-gray-900">{row.product_name}</td>
            <td class="text-xs text-gray-500">{row.sku}</td>
            <td>{row.reason_label}</td>
            <td>{row.classification_label}</td>
            <td class="text-right">{row.movements}</td>
            <td class="text-right">{row.qty} pcs</td>
        </tr>
        {/foreach}
        </tbody>
    </table></div>
    <div class="card-body border-t border-gray-200 text-xs text-gray-500">
        Reasons are the module's existing pullout/return vocabulary. Only spoilage and damage classify as wastage; the rest either returned to stock or were consumed at the branch. This is a different measure from the wastage figure above: the production-ledger wastage is written when a wastage-classified return is posted, while a branch pullout can be recorded without a matching production-ledger row, so the two totals need not agree.
    </div>
    {/if}
</div>
{/if}
{/block}
