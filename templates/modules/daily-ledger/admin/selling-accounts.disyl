{extends "modules/daily-ledger/layouts/app.disyl"}

{block content}
<div x-data="sellingAccountsPage()">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
        <div>
            <h2 class="text-lg font-semibold text-gray-900">Selling Accounts</h2>
            <p class="text-sm text-gray-500">
                Mall booths, kiosks, resellers, events, and other non-branch sales channels.
                Each account ledger tracks beginning, delivered, returned, and ending stock per day.
                {if !selling_accounts_enabled}
                <span class="block mt-1 text-amber-700">Selling Accounts feature is currently disabled in Settings &rarr; Feature Activation. Daily ledger entry will not be available to cashiers.</span>
                {/if}
            </p>
        </div>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
            <form class="flex gap-2" action="{base_url}/admin/selling-accounts" method="GET">
                {if selected_price_group_id > 0}<input type="hidden" name="price_group_id" value="{selected_price_group_id}">{/if}
                <input type="text" class="form-input w-full sm:w-64" name="q" value="{search}" placeholder="Search name or code...">
                <button type="submit" class="btn btn-outline">Search</button>
            </form>
            <button class="btn btn-primary" @click="openCreate()">+ New Selling Account</button>
        </div>
    </div>

    {if selected_price_group_id > 0}
    <div class="mb-4 rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm text-indigo-800">
        Showing <span class="font-semibold">{accounts | length}</span> {if accounts | length == 1}selling account{else}selling accounts{/if} assigned to <span class="font-semibold">{selected_price_group_name}</span>.
        <a class="ml-2 font-semibold text-indigo-700 hover:underline" href="{base_url}/admin/selling-accounts{if search != ''}?q={search}{/if}">Clear filter</a>
    </div>
    {/if}

    <div class="card">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Branch</th>
                        <th>Price Group</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {foreach accounts as a}
                    <tr>
                        <td class="font-mono text-sm">{a.code}</td>
                        <td class="font-medium">{a.name}</td>
                        <td class="text-sm">{a.account_type}</td>
                        <td class="text-sm">{if a.branch_name}{a.branch_name}{else}<span class="text-gray-400">—</span>{/if}</td>
                        <td class="text-sm">{if a.price_group_name}{a.price_group_name}{else}<span class="text-gray-400">default</span>{/if}</td>
                        <td>
                            {if a.is_active}
                            <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-200">Active</span>
                            {else}
                            <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-600 ring-1 ring-inset ring-gray-200">Inactive</span>
                            {/if}
                        </td>
                        <td class="text-right">
                            <button class="text-sm text-indigo-600 hover:underline"
                                @click='openEdit({a.id}, {a.name | json}, {a.account_type | json}, {a.assigned_branch_id | default:"null"}, {a.supply_source_type | json}, {a.supply_source_id | default:"null"}, {a.price_group_id | default:"null"}, {a.is_active})'>
                                Edit
                            </button>
                        </td>
                    </tr>
                    {/foreach}
                    {if accounts | length == 0}
                    <tr><td colspan="7" class="text-center text-sm text-gray-500 py-8">No selling accounts defined yet.</td></tr>
                    {/if}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Create Modal -->
    <div class="modal" :class="{ 'show': createOpen }" x-show="createOpen" x-cloak>
        <div class="modal-content max-w-2xl">
            <h3 class="text-lg font-semibold mb-3">New Selling Account</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="form-label">Code *</label>
                    <input class="form-input" type="text" x-model="form.code" placeholder="e.g. SM-NORTH-001">
                </div>
                <div>
                    <label class="form-label">Name *</label>
                    <input class="form-input" type="text" x-model="form.name">
                </div>
                <div>
                    <label class="form-label">Account Type</label>
                    <select class="form-input" x-model="form.account_type">
                        <option value="mall">Mall</option>
                        <option value="kiosk">Kiosk</option>
                        <option value="event_booth">Event booth</option>
                        <option value="bazaar">Bazaar</option>
                        <option value="school_canteen">School canteen</option>
                        <option value="reseller">Reseller</option>
                        <option value="direct_customer">Direct customer</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">Ledger Type</label>
                    <select class="form-input" x-model="form.ledger_type">
                        <option value="mall_account">Mall account (beg/delivered/return/end)</option>
                        <option value="reseller_account">Reseller account</option>
                        <option value="passthrough">Passthrough</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">Assigned Branch</label>
                    <select class="form-input" x-model="form.assigned_branch_id">
                        <option value="">— None —</option>
                        {foreach branches as b}
                        <option value="{b.id}">{b.code} — {b.name}</option>
                        {/foreach}
                    </select>
                </div>
                <div>
                    <label class="form-label">Supply Source Type</label>
                    <select class="form-input" x-model="form.supply_source_type">
                        <option value="commissary">Commissary</option>
                        <option value="branch">Branch</option>
                        <option value="supplier">Supplier</option>
                        <option value="manual">Manual</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">Supply Source ID</label>
                    <input class="form-input" type="number" x-model.number="form.supply_source_id" placeholder="Branch/commissary id">
                </div>
                <div>
                    <label class="form-label">Price Group</label>
                    <select class="form-input" x-model="form.price_group_id">
                        <option value="">— Default —</option>
                        {foreach price_groups as pg}
                        <option value="{pg.id}">{pg.name}</option>
                        {/foreach}
                    </select>
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn btn-outline" @click="createOpen = false">Cancel</button>
                <button class="btn btn-primary" @click="submitCreate()">Create</button>
            </div>
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal" :class="{ 'show': editOpen }" x-show="editOpen" x-cloak>
        <div class="modal-content max-w-2xl">
            <h3 class="text-lg font-semibold mb-3">Edit Selling Account</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="form-label">Name *</label>
                    <input class="form-input" type="text" x-model="editForm.name">
                </div>
                <div>
                    <label class="form-label">Account Type</label>
                    <select class="form-input" x-model="editForm.account_type">
                        <option value="mall">Mall</option>
                        <option value="kiosk">Kiosk</option>
                        <option value="event_booth">Event booth</option>
                        <option value="bazaar">Bazaar</option>
                        <option value="school_canteen">School canteen</option>
                        <option value="reseller">Reseller</option>
                        <option value="direct_customer">Direct customer</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">Assigned Branch</label>
                    <select class="form-input" x-model="editForm.assigned_branch_id">
                        <option value="">— None —</option>
                        {foreach branches as b}
                        <option value="{b.id}">{b.code} — {b.name}</option>
                        {/foreach}
                    </select>
                </div>
                <div>
                    <label class="form-label">Supply Source Type</label>
                    <select class="form-input" x-model="editForm.supply_source_type">
                        <option value="commissary">Commissary</option>
                        <option value="branch">Branch</option>
                        <option value="supplier">Supplier</option>
                        <option value="manual">Manual</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">Supply Source ID</label>
                    <input class="form-input" type="number" x-model.number="editForm.supply_source_id">
                </div>
                <div>
                    <label class="form-label">Price Group</label>
                    <select class="form-input" x-model="editForm.price_group_id">
                        <option value="">— Default —</option>
                        {foreach price_groups as pg}
                        <option value="{pg.id}">{pg.name}</option>
                        {/foreach}
                    </select>
                </div>
                <div>
                    <label class="inline-flex items-center gap-2 text-sm mt-6">
                        <input type="checkbox" x-model="editForm.is_active">
                        Active
                    </label>
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn btn-outline" @click="editOpen = false">Cancel</button>
                <button class="btn btn-primary" @click="submitEdit()">Save Changes</button>
            </div>
        </div>
    </div>
</div>
{/block}

{block scripts}
<script>
function sellingAccountsPage() {
    return {
        createOpen: false,
        editOpen: false,
        form: {
            code: '', name: '', account_type: 'mall', ledger_type: 'mall_account',
            assigned_branch_id: '', supply_source_type: 'commissary', supply_source_id: null,
            price_group_id: ''
        },
        editForm: {
            id: 0, name: '', account_type: 'mall',
            assigned_branch_id: '', supply_source_type: 'commissary', supply_source_id: null,
            price_group_id: '', is_active: true
        },
        openCreate() {
            this.form = {
                code: '', name: '', account_type: 'mall', ledger_type: 'mall_account',
                assigned_branch_id: '', supply_source_type: 'commissary', supply_source_id: null,
                price_group_id: ''
            };
            this.createOpen = true;
        },
        submitCreate() {
            if (!this.form.code.trim() || !this.form.name.trim()) { alert('Code and name required'); return; }
            const payload = Object.assign({}, this.form);
            payload.assigned_branch_id = payload.assigned_branch_id ? parseInt(payload.assigned_branch_id, 10) : null;
            payload.price_group_id = payload.price_group_id ? parseInt(payload.price_group_id, 10) : null;
            payload.supply_source_id = payload.supply_source_id ? parseInt(payload.supply_source_id, 10) : null;
            fetch('{base_url}/api/v1/admin/selling-accounts', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(j => { if (j && j.ok) location.reload(); else alert((j && j.error) || 'Failed'); });
        },
        openEdit(id, name, accountType, branchId, supplyType, supplyId, priceGroupId, isActive) {
            this.editForm = {
                id: id,
                name: name || '',
                account_type: accountType || 'mall',
                assigned_branch_id: branchId == null ? '' : String(branchId),
                supply_source_type: supplyType || 'commissary',
                supply_source_id: supplyId == null ? null : supplyId,
                price_group_id: priceGroupId == null ? '' : String(priceGroupId),
                is_active: !!isActive
            };
            this.editOpen = true;
        },
        submitEdit() {
            const payload = {
                id: this.editForm.id,
                name: this.editForm.name,
                account_type: this.editForm.account_type,
                assigned_branch_id: this.editForm.assigned_branch_id ? parseInt(this.editForm.assigned_branch_id, 10) : null,
                supply_source_type: this.editForm.supply_source_type,
                supply_source_id: this.editForm.supply_source_id ? parseInt(this.editForm.supply_source_id, 10) : null,
                price_group_id: this.editForm.price_group_id ? parseInt(this.editForm.price_group_id, 10) : null,
                is_active: this.editForm.is_active ? 1 : 0
            };
            fetch('{base_url}/api/v1/admin/selling-accounts/update', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(j => { if (j && j.ok) location.reload(); else alert((j && j.error) || 'Failed'); });
        }
    };
}
</script>
{/block}
