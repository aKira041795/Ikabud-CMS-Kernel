{extends "modules/daily-ledger/layouts/app.disyl"}

{block content}
<div class="flex items-center justify-between mb-6"><div><h2 class="text-lg font-semibold text-gray-900">Production Forecast</h2><p class="text-sm text-gray-500">Read-only suggestions, one row per BRANCH, product and shift, from recorded official sales, that branch's own variances and its own counted stock on hand.</p></div><span class="rounded bg-indigo-50 px-3 py-1 text-sm text-indigo-700">Target: {target_date}</span></div>
<div class="rounded-lg bg-amber-50 p-4 text-sm text-amber-800 mb-6 ring-1 ring-inset ring-amber-200">Forecasts are suggestions only. This page never creates or changes production or ledger entries.</div>
<div class="rounded-lg bg-slate-50 p-4 text-sm text-slate-700 mb-4 ring-1 ring-inset ring-slate-200">
    <strong>One row per branch &mdash; each branch's suggestion is its own.</strong> Sales, variance and stock on hand
    are read for that branch alone, so branch A needing 100 and branch B needing 10 no longer average into a single figure
    nobody can action. <em>Stock applied</em> is that branch's own latest counted ending: a supplying branch is never credited
    with the commissary's undelivered finished goods, which no branch has received and which would otherwise offset
    every branch that commissary supplies. Each row states whether that branch produces its own goods or is supplied.
    <span class="mt-1 block"><strong>Every product that moved in the window is listed</strong>, including one that sold nothing.
    A row with <em>0 days</em> carries movement but no measured sales, so its 0 suggestion means "no sales were recorded",
    not "demand was measured as zero" &mdash; it is labelled as such rather than quietly dropped.</span>
</div>
<div class="rounded-lg bg-indigo-50 p-4 text-sm text-indigo-900 mb-4 ring-1 ring-inset ring-indigo-200">
    <strong>How the target is calculated.</strong> Target production = expected sales &divide; (1 &minus; spoilage rate), using each product's own spoilage rate (its wastage &divide; produced from the production ledger - the same rate the Production Efficiency view reports). A product spoiling 20% is produced at expected sales &divide; 0.8, so a product that spoils worse than a flat margin is never under-produced.
    <span class="mt-1 block">{spoilage_products_with_rate} product(s) carry a measurable spoilage rate; {spoilage_products_without_rate} product(s) have no spoilage history in this window and are shown as <em>not measurable</em>, with a target that is the expected sales and no gross-up - never an assumed rate.</span>
</div>
<form class="card mb-6" action="{base_url}/admin/forecast" method="GET" onsubmit="return window.dlLoadForm(this)"><div class="card-body grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 items-end">
<div class="form-group">{include "modules/daily-ledger/admin/partials/scope-filter.disyl"}</div><div class="form-group"><label class="form-label">Target date</label><input class="form-input" type="date" name="target_date" value="{target_date}"></div>
<div class="form-group"><label class="form-label">History window</label><input class="form-input" type="number" min="3" max="90" name="window" value="{window}"></div>
<div class="form-group"><label class="form-label">Branch</label><select class="form-input" name="branch_id"><option value="">All</option>{foreach branches as branch}<option value="{branch.id}" {if branch.id == filters.branch_id}selected{/if}>{branch.name}</option>{/foreach}</select></div>
<div class="form-group"><label class="form-label">Product</label><select class="form-input" name="product_id"><option value="">All</option>{foreach products as product}<option value="{product.id}" {if product.id == filters.product_id}selected{/if}>{product.name}</option>{/foreach}</select></div>
<button class="btn btn-primary" type="submit">Recalculate</button></div></form>
<div class="card"><div class="card-header"><span>Suggested Production</span><span class="text-sm text-muted">{rows | count} branch product shift(s), {product_count} product(s)</span></div><div class="table-wrap"><table><thead><tr><th>Branch</th><th>Product</th><th>Shift</th><th>Days</th><th>Avg Sales</th><th>Variance Adj.</th><th>Expected Sales</th><th>Spoilage Rate</th><th>Spoilage Gross-up</th><th>Target</th><th>Stock Applied</th><th>Suggested</th></tr></thead><tbody>
{if rows | count == 0}<tr><td colspan="12" class="text-center text-muted">No finalized sales history for the selected scope.</td></tr>{/if}
{foreach rows as row}<tr><td><strong>{row.branch_name}</strong><div class="text-xs text-muted">{row.source_label}</div></td><td><strong>{row.product_name}</strong><div class="text-xs text-muted">{row.sku}</div></td><td>{row.shift}</td><td>{if row.sample_days > 0}{row.sample_days}{/if}{if row.sample_days == 0}<span class="text-amber-700" title="{row.sales_basis}">0 &mdash; no sales</span>{/if}</td><td>{row.average_sales}</td><td>{row.variance_adjustment}</td><td>{row.expected_sales}</td><td>{if row.spoilage_available}{row.spoilage_rate | number_format:2}%{/if}{if row.spoilage_available == false}<span class="text-amber-700" title="no measurable wastage/produced history for this product in the window">not measurable</span>{/if}</td><td>{row.spoilage_gross_up}</td><td>{row.target_production}</td><td>{row.inventory_applied}</td><td class="font-semibold text-indigo-700">{row.suggested_production}</td></tr>{/foreach}
</tbody></table></div></div>
{/block}
