{extends "modules/daily-ledger/layouts/app.disyl"}

{block content}
<div class="flex items-center justify-between mb-6"><div><h2 class="text-lg font-semibold text-gray-900">Production Forecast</h2><p class="text-sm text-gray-500">Read-only suggestions from recorded official sales, variances, wastage, and remaining commissary stock.</p></div><span class="rounded bg-indigo-50 px-3 py-1 text-sm text-indigo-700">Target: {target_date}</span></div>
<div class="rounded-lg bg-amber-50 p-4 text-sm text-amber-800 mb-6 ring-1 ring-inset ring-amber-200">Forecasts are suggestions only. This page never creates or changes production or ledger entries.</div>
<form class="card mb-6" action="{base_url}/admin/forecast" method="GET" onsubmit="return window.dlLoadForm(this)"><div class="card-body grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 items-end">
<div class="form-group"><label class="form-label">Target date</label><input class="form-input" type="date" name="target_date" value="{target_date}"></div>
<div class="form-group"><label class="form-label">History window</label><input class="form-input" type="number" min="3" max="90" name="window" value="{window}"></div>
<div class="form-group"><label class="form-label">Branch</label><select class="form-input" name="branch_id"><option value="">All</option>{foreach branches as branch}<option value="{branch.id}" {if branch.id == filters.branch_id}selected{/if}>{branch.name}</option>{/foreach}</select></div>
<div class="form-group"><label class="form-label">Product</label><select class="form-input" name="product_id"><option value="">All</option>{foreach products as product}<option value="{product.id}" {if product.id == filters.product_id}selected{/if}>{product.name}</option>{/foreach}</select></div>
<button class="btn btn-primary" type="submit">Recalculate</button></div></form>
<div class="card"><div class="card-header"><span>Suggested Production</span><span class="text-sm text-muted">{rows | count} product shifts</span></div><div class="table-wrap"><table><thead><tr><th>Product</th><th>Shift</th><th>Days</th><th>Avg Sales</th><th>Variance Adj.</th><th>Wastage Adj.</th><th>Projected</th><th>Safety</th><th>Stock Applied</th><th>Suggested</th></tr></thead><tbody>
{if rows | count == 0}<tr><td colspan="10" class="text-center text-muted">No finalized sales history for the selected scope.</td></tr>{/if}
{foreach rows as row}<tr><td><strong>{row.product_name}</strong><div class="text-xs text-muted">{row.sku}</div></td><td>{row.shift}</td><td>{row.sample_days}</td><td>{row.average_sales}</td><td>{row.variance_adjustment}</td><td>{row.wastage_adjustment}</td><td>{row.projected_demand}</td><td>{row.safety_margin}</td><td>{row.inventory_applied}</td><td class="font-semibold text-indigo-700">{row.suggested_production}</td></tr>{/foreach}
</tbody></table></div></div>
{/block}
