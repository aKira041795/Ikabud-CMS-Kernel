<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>{page_title}</title>
    <link rel="icon" href="{resolved_favicon_url}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <style>
        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background: linear-gradient(145deg, #fff7ed 0%, #fef3c7 46%, #fde68a 100%);
            min-height: 100vh;
        }
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            background:
                radial-gradient(circle at top left, rgba(251,191,36,.22), transparent 36%),
                radial-gradient(circle at bottom right, rgba(217,119,6,.16), transparent 34%);
            pointer-events: none;
        }
        .login-card {
            background: rgba(255, 252, 247, 0.96);
            border: 1px solid rgba(180, 83, 9, .18);
            box-shadow: 0 28px 80px rgba(120, 53, 15, .18);
        }
        .app-title {
            font-family: 'Fraunces', Georgia, serif;
            font-size: 2rem;
            letter-spacing: -.04em;
            color: #422006;
            line-height: 1.1;
        }
        .form-label {
            text-transform: uppercase;
            letter-spacing: .08em;
            font-size: 11px;
            font-weight: 600;
            color: #7c5a32;
        }
        .form-input {
            background: rgba(255, 255, 255, .88);
            border-color: #e7c99c;
            color: #422006;
        }
        .form-input:focus {
            border-color: #b45309;
            box-shadow: 0 0 0 3px rgba(180, 83, 9, .12);
            outline: none;
        }
        .btn-login {
            background: #b45309;
            color: #fff;
            box-shadow: 0 14px 30px rgba(180, 83, 9, .22);
            font-weight: 600;
            letter-spacing: .01em;
        }
        .btn-login:hover:not(:disabled) {
            background: #92400e;
        }
        .btn-login:disabled {
            opacity: .65;
        }
        .icon-bg {
            background: linear-gradient(135deg, #b45309 0%, #d97706 100%);
            box-shadow: 0 8px 24px rgba(180, 83, 9, .32);
        }
    </style>
</head>
<body class="flex items-center justify-center p-6 min-h-screen">
    <div class="w-full max-w-sm relative z-10">
        <div class="mb-7 text-center">
            {if logo_url}
            <div class="mx-auto mb-4 inline-flex max-w-[220px] items-center justify-center rounded-2xl bg-white/70 px-5 py-4 shadow-sm ring-1 ring-amber-100">
                <img src="{logo_url}" alt="{app_name} logo" class="max-h-16 w-auto object-contain">
            </div>
            {/if}
            {if !logo_url}
            <div class="mx-auto mb-4 h-14 w-14 rounded-2xl icon-bg flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" style="color:#fff">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                </svg>
            </div>
            {/if}
            <h1 class="app-title">{app_name}</h1>
            <p class="mt-2 text-sm" style="color:#7c5a32">Sign in to continue</p>
        </div>

        <div class="login-card rounded-2xl p-7">
            <div id="login-error" class="hidden mb-5 rounded-lg px-4 py-3 text-sm font-medium" style="background:rgba(220,38,38,.07);color:#991b1b;border:1px solid rgba(220,38,38,.18)"></div>

            <form id="login-form" onsubmit="return handleLogin(event)">
                <div class="mb-4">
                    <label class="form-label block mb-1.5" for="username">Username</label>
                    <input class="form-input mt-0.5 block w-full rounded-lg border px-3 py-2.5 text-sm shadow-sm transition-colors" type="text" id="username" name="username" autocomplete="username" required autofocus>
                </div>
                <div class="mb-6">
                    <label class="form-label block mb-1.5" for="password">Password</label>
                    <input class="form-input mt-0.5 block w-full rounded-lg border px-3 py-2.5 text-sm shadow-sm transition-colors" type="password" id="password" name="password" autocomplete="current-password" required>
                </div>
                <button type="submit" class="btn-login w-full inline-flex items-center justify-center rounded-lg px-4 py-2.5 text-sm transition-colors" id="login-btn">Sign In</button>
            </form>
        </div>
    </div>

    <script>
        function handleLogin(e) {
            e.preventDefault();
            var btn = document.getElementById('login-btn');
            var errEl = document.getElementById('login-error');
            btn.disabled = true;
            btn.textContent = 'Signing in...';
            errEl.classList.add('hidden');

            var data = {
                username: document.getElementById('username').value,
                password: document.getElementById('password').value
            };

            fetch('/daily-ledger/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.ok && res.redirect) {
                    window.location.href = res.redirect;
                } else {
                    errEl.textContent = res.error || 'Login failed';
                    errEl.classList.remove('hidden');
                    btn.disabled = false;
                    btn.textContent = 'Sign In';
                }
            })
            .catch(function() {
                errEl.textContent = 'Network error. Please try again.';
                errEl.classList.remove('hidden');
                btn.disabled = false;
                btn.textContent = 'Sign In';
            });

            return false;
        }
    </script>
</body>
</html>
