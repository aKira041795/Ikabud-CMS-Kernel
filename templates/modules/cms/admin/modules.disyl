{extends "modules/cms/layouts/admin.disyl"}

{block content}
<div class="space-y-6" x-data="cmsModuleManager()">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">CMS Modules</h1>
            <p class="mt-1 text-sm text-gray-500">Manage CMS-installed extension modules. Kernel/application modules are managed at the system level.</p>
        </div>
        <div class="flex items-center gap-3">
            <span class="text-xs text-gray-400" x-text="modules.length ? modules.length + ' CMS module(s) installed' : 'No CMS modules installed'"></span>
            <button @click="showUpload = !showUpload" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-sky-600 rounded-lg hover:bg-sky-700 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                Upload ZIP
            </button>
        </div>
    </div>

    <!-- Approved Catalog -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
            <div>
                <h3 class="text-sm font-semibold text-gray-700">Approved Catalog</h3>
                <p class="mt-1 text-xs text-gray-500">Install platform-approved modules that are already available on this host. Free and freemium catalog modules can be installed directly; paid modules need superadmin access first.</p>
            </div>
            <span class="text-xs text-gray-400" x-text="catalogModules.length ? catalogModules.length + ' module(s) available' : 'No approved catalog modules available'"></span>
        </div>
        <div x-show="catalogMsg" x-cloak class="mb-4 text-sm rounded-lg px-4 py-2" :class="catalogOk ? 'bg-green-50 text-green-700' : 'bg-amber-50 text-amber-700'" x-text="catalogMsg"></div>
        <div x-show="catalogModules.length > 0" x-cloak class="space-y-3">
            <template x-for="mod in catalogModules" :key="mod.id">
                <div class="flex flex-col gap-4 rounded-xl border border-gray-200 p-4 lg:flex-row lg:items-center lg:justify-between">
                    <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                            <p class="font-semibold text-sm text-gray-900" x-text="mod.name"></p>
                            <span class="inline-flex items-center px-2 py-0.5 text-[10px] font-medium rounded-full bg-slate-100 text-slate-700" x-text="(mod.commercial_mode || 'free').toUpperCase()"></span>
                            <span x-show="mod.entitlement_allowed" class="inline-flex items-center px-2 py-0.5 text-[10px] font-medium rounded-full bg-green-100 text-green-700">Access ready</span>
                            <span x-show="!mod.entitlement_allowed && !mod.can_install" class="inline-flex items-center px-2 py-0.5 text-[10px] font-medium rounded-full bg-amber-100 text-amber-700">Needs superadmin access</span>
                            <span x-show="mod.request_status === 'pending'" class="inline-flex items-center px-2 py-0.5 text-[10px] font-medium rounded-full bg-blue-100 text-blue-700">Request pending</span>
                            <span x-show="mod.request_status === 'rejected'" class="inline-flex items-center px-2 py-0.5 text-[10px] font-medium rounded-full bg-rose-100 text-rose-700">Request needs update</span>
                        </div>
                        <p class="mt-1 text-xs text-gray-500 max-w-2xl" x-text="mod.description || 'No description available.'"></p>
                        <div class="mt-2 flex flex-wrap gap-2 text-[11px] text-gray-400">
                            <span x-text="'Version ' + mod.version"></span>
                            <span x-show="mod.author" x-text="'By ' + mod.author"></span>
                            <span x-show="mod.request_license_ref" x-text="'License: ' + mod.request_license_ref"></span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 lg:justify-end">
                        <template x-if="mod.can_install">
                            <button @click="installCatalogModule(mod)" :disabled="installingCatalog === mod.id" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-emerald-600 rounded-lg hover:bg-emerald-700 disabled:opacity-50 transition-colors">
                                <template x-if="installingCatalog === mod.id">
                                    <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                </template>
                                <span x-text="installingCatalog === mod.id ? 'Installing…' : 'Install from Catalog'"></span>
                            </button>
                        </template>
                        <template x-if="!mod.can_install">
                            <button @click="requestCatalogAccess(mod)" :disabled="requestingAccess === mod.id" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-amber-700 bg-amber-50 rounded-lg hover:bg-amber-100 disabled:opacity-50 transition-colors">
                                <template x-if="requestingAccess === mod.id">
                                    <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                                </template>
                                <span x-text="mod.request_status === 'pending' ? 'Update Request' : 'Request Access'"></span>
                            </button>
                        </template>
                    </div>
                </div>
            </template>
        </div>
        <div x-show="catalogModules.length === 0" x-cloak class="text-sm text-gray-500 rounded-xl border border-dashed border-gray-200 px-4 py-8 text-center">
            No approved catalog modules are currently available for this tenant.
        </div>
    </div>

    <!-- Upload Panel -->
    <div x-show="showUpload" x-cloak x-transition class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Upload New Module ZIP</h3>
        <p class="text-xs text-gray-500 mb-4">Upload a CMS extension module package (.zip) containing a <code class="bg-gray-100 px-1 rounded">module.json</code> manifest. The upload installs the module for this tenant immediately, runs its migrations, and creates or updates a pending catalog submission so a superadmin can approve reuse for other tenants later.</p>
        <form @submit.prevent="uploadModule" class="flex items-end gap-4">
            <div class="flex-1">
                <label class="block text-xs font-medium text-gray-600 mb-1">Module Package (.zip)</label>
                <input type="file" x-ref="moduleFile" accept=".zip" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-sky-50 file:text-sky-700 hover:file:bg-sky-100">
            </div>
            <button type="submit" :disabled="uploading" class="inline-flex items-center gap-2 px-5 py-2 text-sm font-medium text-white bg-sky-600 rounded-lg hover:bg-sky-700 disabled:opacity-50 transition-colors">
                <template x-if="uploading">
                    <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                </template>
                <span x-text="uploading ? 'Uploading…' : 'Upload & Install'"></span>
            </button>
        </form>
        <div x-show="uploadMsg" x-cloak class="mt-3 text-sm rounded-lg px-4 py-2" :class="uploadOk ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'" x-text="uploadMsg"></div>
    </div>

    <!-- Reset Email Test -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
                <h3 class="text-sm font-semibold text-gray-700">Password Reset Email Test</h3>
                <p class="mt-1 text-xs text-gray-500">Send a test reset email to your current CMS admin account email.</p>
            </div>
            <button @click="sendResetEmailTest" :disabled="testingResetEmail" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-cms-600 rounded-lg hover:bg-cms-700 disabled:opacity-50 transition-colors">
                <template x-if="testingResetEmail">
                    <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
                </template>
                <span x-text="testingResetEmail ? 'Sending…' : 'Send Test Reset Email'"></span>
            </button>
        </div>
        <div x-show="resetEmailMsg" x-cloak class="mt-3 text-sm rounded-lg px-4 py-2" :class="resetEmailOk ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'" x-text="resetEmailMsg"></div>
    </div>

    <!-- Module List -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Module</th>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Version</th>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Details</th>
                    <th class="px-5 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="px-5 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <!-- One tbody per module so settings row can be adjacent -->
            <template x-for="mod in modules" :key="mod.id">
                <tbody class="divide-y divide-gray-100">
                    <!-- Module row -->
                    <tr class="hover:bg-gray-50 transition-colors" :class="openConfig === mod.id ? 'bg-sky-50/40' : ''">
                        <!-- Name & Description -->
                        <td class="px-5 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 bg-sky-100">
                                    <svg class="w-4 h-4 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                                </div>
                                <div>
                                    <p class="font-semibold text-sm text-gray-900" x-text="mod.name"></p>
                                    <p class="text-xs text-gray-500 mt-0.5 max-w-xs truncate" x-text="mod.description || '—'"></p>
                                </div>
                            </div>
                        </td>
                        <!-- Version -->
                        <td class="px-5 py-4">
                            <span class="text-sm text-gray-600" x-text="mod.version"></span>
                            <p class="text-xs text-gray-400 mt-0.5" x-show="mod.author" x-text="mod.author"></p>
                        </td>
                        <!-- Details -->
                        <td class="px-5 py-4">
                            <div class="flex flex-wrap gap-1.5">
                                <span x-show="mod.has_routes" class="inline-flex items-center px-2 py-0.5 text-[10px] font-medium rounded-full bg-blue-100 text-blue-700">Routes</span>
                                <span x-show="mod.capabilities_count > 0" class="inline-flex items-center px-2 py-0.5 text-[10px] font-medium rounded-full bg-purple-100 text-purple-700" x-text="mod.capabilities_count + ' caps'"></span>
                                <span x-show="mod.depends_count > 0" class="inline-flex items-center px-2 py-0.5 text-[10px] font-medium rounded-full bg-gray-100 text-gray-600" x-text="mod.depends_count + ' deps'"></span>
                                <span x-show="mod.tables && mod.tables.length > 0" class="inline-flex items-center px-2 py-0.5 text-[10px] font-medium rounded-full bg-green-100 text-green-700" x-text="mod.tables.length + ' tables'"></span>
                                <span x-show="mod.settings_fields && mod.settings_fields.length > 0" class="inline-flex items-center px-2 py-0.5 text-[10px] font-medium rounded-full bg-amber-100 text-amber-700" x-text="mod.settings_fields.length + ' settings'"></span>
                                <span x-show="mod.catalog_managed" class="inline-flex items-center px-2 py-0.5 text-[10px] font-medium rounded-full bg-slate-100 text-slate-700" x-text="'Catalog • ' + (mod.commercial_mode || 'free')"></span>
                            </div>
                        </td>
                        <!-- Status -->
                        <td class="px-5 py-4 text-center">
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium rounded-full" :class="mod.enabled ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500'">
                                <span class="w-1.5 h-1.5 rounded-full" :class="mod.enabled ? 'bg-green-500' : 'bg-gray-400'"></span>
                                <span x-text="mod.enabled ? 'Enabled' : 'Disabled'"></span>
                            </span>
                        </td>
                        <!-- Actions -->
                        <td class="px-5 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <!-- Configure (only when settings_fields exist) -->
                                <template x-if="mod.settings_fields && mod.settings_fields.length > 0">
                                    <button @click="toggleConfig(mod)"
                                        class="px-3 py-1.5 text-xs font-medium rounded-lg transition-colors"
                                        :class="openConfig === mod.id
                                            ? 'text-sky-700 bg-sky-100 ring-1 ring-sky-300'
                                            : 'text-sky-700 bg-sky-50 hover:bg-sky-100'">
                                        Configure
                                    </button>
                                </template>
                                <!-- Toggle Enable/Disable -->
                                <button @click="toggleModule(mod)" :disabled="toggling === mod.id" class="px-3 py-1.5 text-xs font-medium rounded-lg transition-colors" :class="mod.enabled ? 'text-amber-700 bg-amber-50 hover:bg-amber-100' : 'text-green-700 bg-green-50 hover:bg-green-100'" x-text="mod.enabled ? 'Disable' : 'Enable'">
                                </button>
                                <!-- Delete (only disabled modules) -->
                                <template x-if="!mod.enabled">
                                    <button @click="deleteModule(mod)" class="px-3 py-1.5 text-xs font-medium text-red-600 bg-red-50 rounded-lg hover:bg-red-100 transition-colors">
                                        Delete
                                    </button>
                                </template>
                            </div>
                        </td>
                    </tr>

                    <!-- Inline settings panel -->
                    <tr x-show="openConfig === mod.id" x-cloak>
                        <td colspan="5" class="px-0 py-0 bg-sky-50/60 border-t border-sky-100">
                            <div class="px-6 py-5">
                                <div class="flex items-center justify-between mb-4">
                                    <h4 class="text-sm font-semibold text-gray-700" x-text="mod.name + ' Settings'"></h4>
                                    <div class="flex items-center gap-2">
                                        <span x-show="configSaved[mod.id]" x-transition.opacity class="text-xs text-green-600 font-medium flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                                            Saved
                                        </span>
                                        <span x-show="configErr[mod.id]" x-text="configErr[mod.id]" class="text-xs text-red-500" x-transition></span>
                                    </div>
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-4">
                                    <template x-for="field in mod.settings_fields" :key="field.key">
                                        <div>
                                            <label class="block text-xs font-medium text-gray-500 mb-1" x-text="field.label"></label>
                                            <!-- select -->
                                            <template x-if="field.type === 'select'">
                                                <select
                                                    :value="configValues[mod.id] && configValues[mod.id][field.key]"
                                                    @change="setConfigValue(mod.id, field.key, $event.target.value)"
                                                    class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500">
                                                    <template x-for="opt in field.options" :key="opt.value">
                                                        <option :value="opt.value" :selected="(configValues[mod.id] && configValues[mod.id][field.key]) === opt.value" x-text="opt.label"></option>
                                                    </template>
                                                </select>
                                            </template>
                                            <!-- text / email / anything else -->
                                            <template x-if="field.type !== 'select'">
                                                <input
                                                    :type="field.type || 'text'"
                                                    :value="configValues[mod.id] && configValues[mod.id][field.key]"
                                                    @input="setConfigValue(mod.id, field.key, $event.target.value)"
                                                    :placeholder="field.placeholder || ''"
                                                    class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500">
                                            </template>
                                            <p x-show="field.help" x-text="field.help" class="text-[11px] text-gray-400 mt-1"></p>
                                        </div>
                                    </template>
                                </div>
                                <div class="flex items-center gap-3 pt-3 border-t border-sky-100">
                                    <button @click="saveConfig(mod)" :disabled="savingConfig === mod.id"
                                        class="px-4 py-1.5 text-xs font-medium text-white bg-sky-600 rounded-lg hover:bg-sky-700 disabled:opacity-50 transition-colors">
                                        <span x-text="savingConfig === mod.id ? 'Saving…' : 'Save Settings'"></span>
                                    </button>
                                    <button @click="openConfig = null" class="px-4 py-1.5 text-xs font-medium text-gray-500 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">
                                        Close
                                    </button>
                                </div>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </template>
        </table>
    </div>

    <!-- Empty State -->
    <div x-show="modules.length === 0" class="text-center py-16 bg-white rounded-xl border border-gray-200">
        <svg class="w-16 h-16 text-gray-300 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        <p class="mt-4 text-sm text-gray-500">No CMS extension modules installed yet.</p>
        <p class="mt-1 text-xs text-gray-400">Upload a module package (.zip) to extend your CMS. Kernel modules are managed at the application level.</p>
    </div>
</div>

<script>
function cmsModuleManager() {
    const rawModules = JSON.parse('{modules_json|raw}');
    const rawCatalogModules = JSON.parse('{catalog_json|raw}');

    // Pre-populate configValues from each module's current settings
    const configValues = {};
    rawModules.forEach(function (mod) {
        configValues[mod.id] = Object.assign({}, mod.settings || {});
    });

    return {
        modules:     rawModules,
        catalogModules: rawCatalogModules,
        showUpload:  false,
        uploading:   false,
        installingCatalog: null,
        requestingAccess: null,
        toggling:    null,
        uploadMsg:   '',
        uploadOk:    false,
        catalogMsg:  '',
        catalogOk:   false,
        testingResetEmail: false,
        resetEmailMsg: '',
        resetEmailOk: false,

        openConfig:  null,
        savingConfig: null,
        configValues: configValues,
        configSaved:  {},
        configErr:    {},

        toggleConfig(mod) {
            this.openConfig = this.openConfig === mod.id ? null : mod.id;
        },

        setConfigValue(modId, key, value) {
            if (!this.configValues[modId]) this.configValues[modId] = {};
            this.configValues[modId][key] = value;
        },

        async saveConfig(mod) {
            this.savingConfig = mod.id;
            this.configErr    = Object.assign({}, this.configErr, { [mod.id]: '' });
            this.configSaved  = Object.assign({}, this.configSaved, { [mod.id]: false });
            try {
                const res = await fetch(CMS_BASE + '/api/v1/cms/modules/' + mod.id + '/settings', {
                    method:  'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content ?? '',
                    },
                    body: JSON.stringify({ settings: this.configValues[mod.id] || {}, _token: CMS_CSRF }),
                });
                const data = await res.json();
                if (data.ok) {
                    this.configSaved = Object.assign({}, this.configSaved, { [mod.id]: true });
                    // Also update mod.settings so re-open shows current values
                    const m = this.modules.find(m => m.id === mod.id);
                    if (m) m.settings = Object.assign({}, this.configValues[mod.id]);
                    setTimeout(() => {
                        this.configSaved = Object.assign({}, this.configSaved, { [mod.id]: false });
                    }, 3000);
                } else {
                    this.configErr = Object.assign({}, this.configErr, { [mod.id]: data.error || 'Save failed.' });
                }
            } catch (e) {
                this.configErr = Object.assign({}, this.configErr, { [mod.id]: 'Network error.' });
            } finally {
                this.savingConfig = null;
            }
        },

        async installCatalogModule(mod) {
            this.installingCatalog = mod.id;
            this.catalogMsg = '';
            this.catalogOk = false;
            try {
                const fd = new FormData();
                fd.append('module_id', mod.id);
                fd.append('_token', CMS_CSRF);
                const res = await fetch(CMS_BASE + '/api/v1/cms/modules/install', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.ok) {
                    this.catalogMsg = data.message || 'Module installed from catalog.';
                    this.catalogOk = true;
                    setTimeout(() => window.location.reload(), 1200);
                } else {
                    this.catalogMsg = data.error || 'Catalog install failed.';
                    this.catalogOk = false;
                }
            } catch (e) {
                this.catalogMsg = 'Catalog install failed: ' + e.message;
                this.catalogOk = false;
            } finally {
                this.installingCatalog = null;
            }
        },

        async uploadModule() {
            const fileInput = this.$refs.moduleFile;
            if (!fileInput.files || !fileInput.files.length) {
                this.uploadMsg = 'Please select a .zip file.';
                this.uploadOk = false;
                return;
            }
            this.uploading = true;
            this.uploadMsg = '';
            try {
                const fd = new FormData();
                fd.append('module', fileInput.files[0]);
                fd.append('_token', CMS_CSRF);
                const res = await fetch(CMS_BASE + '/api/v1/cms/modules/upload', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.ok) {
                    this.uploadMsg = data.message || 'Module installed successfully.';
                    this.uploadOk = true;
                    fileInput.value = '';
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    this.uploadMsg = data.error || 'Upload failed.';
                    this.uploadOk = false;
                }
            } catch (e) {
                this.uploadMsg = 'Upload failed: ' + e.message;
                this.uploadOk = false;
            } finally {
                this.uploading = false;
            }
        },

        async requestCatalogAccess(mod) {
            const licenseKey = window.prompt(
                'Optional license key for ' + mod.name + '. Leave blank if you only want access reviewed.',
                ''
            );
            if (licenseKey === null) {
                return;
            }

            const requestNotes = window.prompt(
                'Optional note for the superadmin review queue.',
                ''
            );
            if (requestNotes === null) {
                return;
            }

            this.requestingAccess = mod.id;
            this.catalogMsg = '';
            this.catalogOk = false;
            try {
                const fd = new FormData();
                fd.append('module_id', mod.id);
                fd.append('license_key', licenseKey.trim());
                fd.append('request_notes', requestNotes.trim());
                fd.append('_token', CMS_CSRF);
                const res = await fetch(CMS_BASE + '/api/v1/cms/modules/request-access', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.ok) {
                    this.catalogMsg = data.message || 'Access request submitted.';
                    this.catalogOk = true;
                    setTimeout(() => window.location.reload(), 1200);
                } else {
                    this.catalogMsg = data.error || 'Access request failed.';
                    this.catalogOk = false;
                }
            } catch (e) {
                this.catalogMsg = 'Access request failed: ' + e.message;
                this.catalogOk = false;
            } finally {
                this.requestingAccess = null;
            }
        },

        async sendResetEmailTest() {
            this.testingResetEmail = true;
            this.resetEmailMsg = '';
            this.resetEmailOk = false;
            try {
                const res = await fetch(CMS_BASE + '/api/v1/cms/auth/test-reset-email', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content ?? '',
                    },
                    body: JSON.stringify({ _token: CMS_CSRF }),
                });
                const data = await res.json();
                this.resetEmailOk = !!data.ok;
                this.resetEmailMsg = data.message || data.error || 'Request completed.';
            } catch (e) {
                this.resetEmailOk = false;
                this.resetEmailMsg = 'Request failed: ' + e.message;
            } finally {
                this.testingResetEmail = false;
            }
        },

        async toggleModule(mod) {
            if (mod.enabled && !confirm('Disable module "' + mod.name + '"? Its routes and features will become unavailable.')) return;
            this.toggling = mod.id;
            try {
                const fd = new FormData();
                fd.append('module_id', mod.id);
                fd.append('enable', mod.enabled ? '' : '1');
                fd.append('_token', CMS_CSRF);
                const res = await fetch(CMS_BASE + '/api/v1/cms/modules/toggle', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.ok) {
                    mod.enabled = data.enabled;
                    if (!mod.enabled) this.openConfig = null;
                } else {
                    alert(data.error || 'Toggle failed.');
                }
            } catch (e) {
                alert('Error: ' + e.message);
            } finally {
                this.toggling = null;
            }
        },

        async deleteModule(mod) {
            if (!confirm('Delete module "' + mod.name + '"? All module files will be permanently removed.')) return;
            try {
                const fd = new FormData();
                fd.append('_token', CMS_CSRF);
                const res = await fetch(CMS_BASE + '/api/v1/cms/modules/' + mod.id + '/delete', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.ok) {
                    this.modules = this.modules.filter(m => m.id !== mod.id);
                } else {
                    alert(data.error || 'Delete failed.');
                }
            } catch (e) {
                alert('Error: ' + e.message);
            }
        }
    };
}
</script>
{/block}
