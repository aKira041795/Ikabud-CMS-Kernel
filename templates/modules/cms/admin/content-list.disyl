{extends "modules/cms/layouts/admin.disyl"}

{block content}
{!-- Expose available entity fields for frontend features --}
<div data-ikb-entity-fields="{keyof cms_post}" data-ikb-entity-fields-page="{keyof cms_page}" class="print-hidden" aria-hidden="true" style="display:none"></div>
<div x-data="cmsBulkActions()" class="space-y-6">
<div class="flex flex-col gap-6">
    <div class="flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
        <div>
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-[2rem] font-bold tracking-tight text-slate-900">
                    {if content_type == 'all'}All Content{elseif content_type == 'post'}Posts{elseif content_type == 'page'}Pages{else}{content_type|ucfirst}s{/if}
                </h1>
                <span class="inline-flex items-center rounded-full bg-sky-100 px-2.5 py-1 text-xs font-semibold text-sky-700">{total} item{if total != 1}s{/if}</span>
            </div>
            <p class="mt-2 max-w-3xl text-sm text-slate-500">
                {if content_type == 'all'}Manage and organize all your CMS content from one view. Use filters to narrow by type, status, author, or publishing window.
                {else}Manage and organize your {content_type} library. Use filters to quickly find items and keep publishing workflows moving.
                {/if}
            </p>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
            {if status_filter == 'trash'}
            {ikb_confirm_action message="Permanently delete all trashed items? This cannot be undone." variant="danger" confirm="Empty Trash"}
            <button @click="emptyTrash()" :disabled="bulkLoading" class="inline-flex items-center gap-2 rounded-2xl bg-red-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm shadow-red-600/20 transition-colors hover:bg-red-700 disabled:opacity-50">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                Empty Trash
            </button>
            {/ikb_confirm_action}
            {else}
            {ikb_export_button source="cms.post" format="csv" label="Export CSV" variant="secondary" size="small" /}
            <a href="{base_url}/cms/admin/content/create?type=post" class="inline-flex items-center gap-2 rounded-2xl border border-slate-200 bg-white/90 px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm shadow-slate-200/40 transition-colors hover:border-sky-200 hover:bg-sky-50 hover:text-sky-700">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 4v16m8-8H4"/></svg>
                New Content
            </a>
            {if content_type == 'page' || content_type == 'all'}
            <a href="{base_url}/cms/admin/react-builder/create" class="inline-flex items-center gap-2 rounded-2xl bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm shadow-violet-600/20 transition-colors hover:bg-violet-700">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5h16M4 12h16M4 19h16"/></svg>
                Page Builder
            </a>
            {/if}
            {/if}
        </div>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <a href="{base_url}/cms/admin/content/create?type=post" class="group rounded-[26px] border border-slate-200 bg-white/92 p-5 shadow-[0_18px_40px_rgba(15,23,42,0.05)] transition-transform duration-150 hover:-translate-y-0.5 hover:border-sky-200 hover:shadow-[0_24px_44px_rgba(37,99,235,0.10)] no-underline">
            <div class="flex items-start gap-4">
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-sky-100 text-sky-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                </span>
                <span class="min-w-0 flex-1">
                    <span class="block text-base font-semibold text-slate-900">Create Post</span>
                    <span class="mt-1 block text-sm text-slate-500">Write and publish new editorial content.</span>
                </span>
            </div>
        </a>
        <a href="{base_url}/cms/admin/content/create?type=page" class="group rounded-[26px] border border-slate-200 bg-white/92 p-5 shadow-[0_18px_40px_rgba(15,23,42,0.05)] transition-transform duration-150 hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-[0_24px_44px_rgba(16,185,129,0.10)] no-underline">
            <div class="flex items-start gap-4">
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                </span>
                <span class="min-w-0 flex-1">
                    <span class="block text-base font-semibold text-slate-900">Create Page</span>
                    <span class="mt-1 block text-sm text-slate-500">Build a new static page or destination.</span>
                </span>
            </div>
        </a>
        <a href="{base_url}/cms/admin/react-builder/create" class="group rounded-[26px] border border-slate-200 bg-white/92 p-5 shadow-[0_18px_40px_rgba(15,23,42,0.05)] transition-transform duration-150 hover:-translate-y-0.5 hover:border-violet-200 hover:shadow-[0_24px_44px_rgba(139,92,246,0.10)] no-underline">
            <div class="flex items-start gap-4">
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-violet-100 text-violet-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 5h16M4 12h16M4 19h16"/></svg>
                </span>
                <span class="min-w-0 flex-1">
                    <span class="block text-base font-semibold text-slate-900">Page Builder</span>
                    <span class="mt-1 block text-sm text-slate-500">Design visually with the builder workflow.</span>
                </span>
            </div>
        </a>
        <a href="{base_url}/cms/admin/media" class="group rounded-[26px] border border-slate-200 bg-white/92 p-5 shadow-[0_18px_40px_rgba(15,23,42,0.05)] transition-transform duration-150 hover:-translate-y-0.5 hover:border-amber-200 hover:shadow-[0_24px_44px_rgba(245,158,11,0.10)] no-underline">
            <div class="flex items-start gap-4">
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-amber-100 text-amber-500">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </span>
                <span class="min-w-0 flex-1">
                    <span class="block text-base font-semibold text-slate-900">Media Library</span>
                    <span class="mt-1 block text-sm text-slate-500">Upload, organize, and reuse media assets.</span>
                </span>
            </div>
        </a>
    </div>

    <form class="rounded-[30px] border border-slate-200 bg-white/92 p-5 shadow-[0_22px_44px_rgba(15,23,42,0.05)]" method="get" action="{base_url}/cms/admin/content" id="contentListForm">
        <div class="grid gap-3 xl:grid-cols-[minmax(260px,1.8fr)_minmax(130px,.6fr)_minmax(140px,.6fr)_minmax(160px,.7fr)_minmax(130px,.5fr)_auto]">
            <div class="relative xl:col-span-1">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </div>
                <input type="search" name="q" id="searchInput" placeholder="Search content by title, excerpt, or body..." value="{search}" oninput="liveSearch(this.value)" class="w-full rounded-2xl border border-slate-200 bg-slate-50/90 py-3 pl-10 pr-4 text-sm text-slate-700 transition-colors focus:border-sky-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20">
            </div>
            <select name="type" class="rounded-2xl border border-slate-200 bg-white px-3 py-3 text-sm text-slate-700 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20">
                <option value="all" {if content_type == 'all'}selected{/if}>All types</option>
                <option value="post" {if content_type == 'post'}selected{/if}>Post</option>
                <option value="page" {if content_type == 'page'}selected{/if}>Page</option>
                {foreach custom_types as ct}
                <option value="{ct.slug}" {if content_type == ct.slug}selected{/if}>{ct.label}</option>
                {/foreach}
            </select>
            <select name="status" class="rounded-2xl border border-slate-200 bg-white px-3 py-3 text-sm text-slate-700 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20">
                <option value="" {if status_filter == ''}selected{/if}>All statuses</option>
                <option value="published" {if status_filter == 'published'}selected{/if}>Published</option>
                <option value="draft" {if status_filter == 'draft'}selected{/if}>Draft</option>
                <option value="private" {if status_filter == 'private'}selected{/if}>Private</option>
                <option value="trash" {if status_filter == 'trash'}selected{/if}>Trash</option>
            </select>
            <select name="author_id" class="rounded-2xl border border-slate-200 bg-white px-3 py-3 text-sm text-slate-700 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20">
                <option value="">All authors</option>
                {foreach author_list as author}
                <option value="{author.id}" {if author_filter == author.id}selected{/if}>{author.display_name}</option>
                {/foreach}
            </select>
            <select name="per_page" class="rounded-2xl border border-slate-200 bg-white px-3 py-3 text-sm text-slate-700 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20">
                <option value="5" {if per_page == 5}selected{/if}>5 / page</option>
                <option value="10" {if per_page == 10}selected{/if}>10 / page</option>
                <option value="20" {if per_page == 20}selected{/if}>20 / page</option>
                <option value="50" {if per_page == 50}selected{/if}>50 / page</option>
                <option value="100" {if per_page == 100}selected{/if}>100 / page</option>
            </select>
            <div class="flex items-center gap-2">
                <button type="submit" class="inline-flex flex-1 items-center justify-center gap-2 rounded-2xl bg-sky-600 px-4 py-3 text-sm font-semibold text-white shadow-sm shadow-sky-600/20 transition-colors hover:bg-sky-700">Apply</button>
                <a href="{base_url}/cms/admin/content?type=all" class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-500 transition-colors hover:border-slate-300 hover:bg-slate-50 hover:text-slate-700">Reset</a>
            </div>
        </div>
        <div class="mt-4 grid gap-3 border-t border-slate-100 pt-4 lg:grid-cols-2 xl:grid-cols-[minmax(160px,.8fr)_minmax(180px,.9fr)_minmax(160px,.7fr)_minmax(160px,.7fr)_minmax(130px,.5fr)_minmax(130px,.5fr)]">
            <select name="category_id" class="rounded-2xl border border-slate-200 bg-slate-50/80 px-3 py-2.5 text-sm text-slate-700 focus:border-sky-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20">
                <option value="">All categories</option>
                {foreach category_list as category}
                <option value="{category.id}" {if category_filter == category.id}selected{/if}>{category.name}</option>
                {/foreach}
            </select>
            <input type="text" name="tag" value="{tag_filter}" placeholder="Tag or keyword" class="rounded-2xl border border-slate-200 bg-slate-50/80 px-3 py-2.5 text-sm text-slate-700 focus:border-sky-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20">
            <input type="date" name="date_from" value="{date_from}" class="rounded-2xl border border-slate-200 bg-slate-50/80 px-3 py-2.5 text-sm text-slate-700 focus:border-sky-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20">
            <input type="date" name="date_to" value="{date_to}" class="rounded-2xl border border-slate-200 bg-slate-50/80 px-3 py-2.5 text-sm text-slate-700 focus:border-sky-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20">
            <select name="is_sticky" class="rounded-2xl border border-slate-200 bg-slate-50/80 px-3 py-2.5 text-sm text-slate-700 focus:border-sky-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20">
                <option value="">Sticky: Any</option>
                <option value="1" {if is_sticky_filter == 1}selected{/if}>Sticky only</option>
                <option value="0" {if is_sticky_filter == 0}selected{/if}>Not sticky</option>
            </select>
            <select name="is_featured" class="rounded-2xl border border-slate-200 bg-slate-50/80 px-3 py-2.5 text-sm text-slate-700 focus:border-sky-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20">
                <option value="">Featured: Any</option>
                <option value="1" {if is_featured_filter == 1}selected{/if}>Featured only</option>
                <option value="0" {if is_featured_filter == 0}selected{/if}>Not featured</option>
            </select>
        </div>
    </form>
</div>

{if !rows}
<div class="rounded-[30px] border border-slate-200 bg-white/92 shadow-[0_22px_44px_rgba(15,23,42,0.05)]">
    <div class="py-24 text-center">
        <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-full bg-slate-100">
            <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        </div>
        {if search || status_filter}
        <h3 class="mb-1 text-base font-semibold text-slate-800">No results found</h3>
        <p class="mb-4 text-sm text-slate-500">Try adjusting your search or filter settings.</p>
        <a href="{base_url}/cms/admin/content?type=all" class="text-sm font-medium text-sky-600 hover:underline">Clear filters</a>
        {else}
        <h3 class="mb-1 text-base font-semibold text-slate-800">No content items yet</h3>
        <p class="mb-5 text-sm text-slate-500">Create your first post or page to get the CMS moving.</p>
        <a href="{base_url}/cms/admin/content/create?type=post" class="inline-flex items-center gap-2 rounded-2xl bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm shadow-sky-600/20 transition-colors hover:bg-sky-700">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/></svg>
            Create first item
        </a>
        {/if}
    </div>
</div>
{else}
<div class="overflow-hidden rounded-[30px] border border-slate-200 bg-white/92 shadow-[0_22px_44px_rgba(15,23,42,0.05)]">
    <!-- Bulk action bar -->
    <div x-show="selected.length > 0" x-transition class="flex items-center gap-3 border-b border-sky-100 bg-sky-50 px-5 py-3">
        <span class="text-xs font-semibold text-sky-700" x-text="selected.length + ' selected'"></span>
        <div class="flex items-center gap-1.5 ml-auto">
            <button @click="bulkAction('publish')" class="rounded-xl bg-emerald-100 px-2.5 py-1.5 text-xs font-medium text-emerald-700 transition-colors hover:bg-emerald-200" :disabled="bulkLoading">Publish</button>
            <button @click="bulkAction('draft')" class="rounded-xl bg-amber-100 px-2.5 py-1.5 text-xs font-medium text-amber-700 transition-colors hover:bg-amber-200" :disabled="bulkLoading">Set Draft</button>
            <button @click="bulkAction('trash')" class="rounded-xl bg-red-100 px-2.5 py-1.5 text-xs font-medium text-red-600 transition-colors hover:bg-red-200" :disabled="bulkLoading">Trash</button>
            <button @click="selected = []" class="rounded-xl border border-gray-200 bg-white px-2.5 py-1.5 text-xs font-medium text-gray-500 transition-colors hover:bg-gray-50">Clear</button>
        </div>
    </div>
    <div class="overflow-x-auto">
    <table class="w-full min-w-[980px]">
        <thead>
            <tr class="border-b border-slate-200 bg-slate-50/80">
                <th class="w-10 px-4 py-3"><input type="checkbox" class="rounded border-gray-300 text-sky-600 focus:ring-sky-500/20" @change="toggleAll($event)" :checked="selected.length === allIds.length && allIds.length > 0"></th>
                <th class="px-5 py-3 text-left text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-400">Content</th>
                <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-400">Type</th>
                <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-400">Status</th>
                <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-400">Author</th>
                <th class="px-4 py-3 text-left text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-400">Updated</th>
                <th class="px-4 py-3 text-right text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-400">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white/80">
            {foreach rows as row}
            <tr class="group transition-colors hover:bg-sky-50/30" :class="selected.includes({row.id}) ? 'bg-sky-50/50' : ''" data-title="{row.title|lower}">
                <td class="px-4 py-4 align-top"><input type="checkbox" class="rounded border-gray-300 text-sky-600 focus:ring-sky-500/20" value="{row.id}" @change="toggleOne({row.id})" :checked="selected.includes({row.id})"></td>
                <td class="px-5 py-4 align-top">
                    <div class="flex items-start gap-3">
                        <div class="relative mt-1 h-14 w-14 shrink-0 overflow-hidden rounded-2xl border border-slate-200 bg-slate-100 shadow-sm shadow-slate-200/60">
                            {if row.featured_image_url}
                            <img src="{row.featured_image_url}" alt="{row.title}" class="h-full w-full object-cover" loading="lazy">
                            {else}
                            <div class="flex h-full w-full items-center justify-center text-slate-400">
                                {if row.type == 'post'}
                                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                {elseif row.type == 'page'}
                                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                {else}
                                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7a2 2 0 012-2h12a2 2 0 012 2v10a2 2 0 01-2 2H6a2 2 0 01-2-2V7zm4 0v10m8-10v10M4 12h16"/></svg>
                                {/if}
                            </div>
                            {/if}
                            <span class="absolute left-1.5 top-1.5 inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-slate-950/70 px-1 text-[10px] font-semibold text-white backdrop-blur">{row.row_number}</span>
                        </div>
                        <div class="min-w-0">
                            <a href="{base_url}/cms/admin/content/edit/{row.id}" class="text-sm font-semibold text-slate-900 transition-colors hover:text-sky-600">{row.title}</a>
                            <div class="mt-1 truncate font-mono text-[11px] text-slate-400">{if row.type == 'post'}/blog/{elseif row.type == 'page'}/page/{else}/{row.type}/{/if}{row.slug}</div>
                            <div class="mt-2 flex items-center gap-2 text-[11px] text-slate-400">
                                {if row.is_sticky}<span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 font-semibold text-amber-700">Sticky</span>{/if}
                                {if row.is_featured}<span class="inline-flex items-center rounded-full bg-violet-50 px-2 py-0.5 font-semibold text-violet-700">Featured</span>{/if}
                                {if row.word_count}<span>{row.word_count} words</span>{/if}
                            </div>
                        </div>
                    </div>
                </td>
                <td class="px-4 py-4 align-top">
                    <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-slate-600">{row.type}</span>
                </td>
                <td class="px-4 py-4 align-top">
                    <div class="inline-flex items-center gap-2 text-sm font-medium text-slate-700">
                        {if row.status == 'published'}<span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                        {else}{if row.status == 'draft'}<span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
                        {else}{if row.status == 'private'}<span class="h-2.5 w-2.5 rounded-full bg-indigo-400"></span>
                        {else}<span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
                        {/if}{/if}{/if}
                        <span>{row.status}</span>
                    </div>
                </td>
                <td class="px-4 py-4 align-top text-sm text-slate-600">{row.author_name}</td>
                <td class="px-4 py-4 align-top text-sm text-slate-500 whitespace-nowrap">{if row.updated_at}{row.updated_at}{else}{row.published_at}{/if}</td>
                <td class="px-4 py-4 text-right align-top">
                    <div class="flex items-center justify-end gap-2">
                        {if status_filter == 'trash'}
                        <button type="button" @click="bulkAction('restore', {row.id})" class="inline-flex items-center gap-1 rounded-xl bg-emerald-50 px-2.5 py-1.5 text-xs font-medium text-emerald-600 transition-colors hover:bg-emerald-100">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                            Restore
                        </button>
                        <button type="button" @click="bulkAction('delete_permanent', {row.id})" class="inline-flex items-center gap-1 rounded-xl bg-red-50 px-2.5 py-1.5 text-xs font-medium text-red-600 transition-colors hover:bg-red-100">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            Delete
                        </button>
                        {else}
                        <a href="{base_url}/cms/admin/content/edit/{row.id}" class="inline-flex items-center gap-1 rounded-xl bg-sky-50 px-2.5 py-1.5 text-xs font-medium text-sky-600 transition-colors hover:bg-sky-100">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                            Edit
                        </a>
                        <div x-data="{ actionMenuOpen: false }" class="relative">
                            <button type="button" @click.stop="actionMenuOpen = !actionMenuOpen" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-2.5 py-1.5 text-slate-500 transition-colors hover:border-slate-300 hover:bg-slate-50 hover:text-slate-700" aria-label="More actions">
                                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6h.01M12 12h.01M12 18h.01"/></svg>
                            </button>
                            <div x-show="actionMenuOpen" x-cloak @click.outside="actionMenuOpen = false" class="absolute right-0 top-full z-20 mt-2 w-44 overflow-hidden rounded-2xl border border-slate-200 bg-white p-1.5 text-left shadow-xl shadow-slate-900/10">
                                <button type="button" @click="openPreview({row.id}); actionMenuOpen = false" class="flex w-full items-center gap-2 rounded-xl px-3 py-2 text-xs font-medium text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900">
                                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                    Preview
                                </button>
                                {if row.type == 'page'}
                                <a href="{base_url}/cms/admin/react-builder/{row.id}" class="flex items-center gap-2 rounded-xl px-3 py-2 text-xs font-medium text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900">
                                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5h16M4 12h16M4 19h16"/></svg>
                                    Builder
                                </a>
                                {/if}
                                {if row.status == 'published'}
                                <a href="{base_url}{if row.type == 'post'}/cms/blog/{elseif row.type == 'page'}/cms/page/{else}/cms/{row.type}/{/if}{row.slug}" target="_blank" class="flex items-center gap-2 rounded-xl px-3 py-2 text-xs font-medium text-slate-600 transition-colors hover:bg-slate-50 hover:text-slate-900">
                                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                                    View live
                                </a>
                                {/if}
                            </div>
                        </div>
                        {/if}
                    </div>
                </td>
            </tr>
            {/foreach}
        </tbody>
    </table>
    </div>

    {if total_pages > 1}
    <div class="flex items-center justify-between border-t border-slate-100 px-5 py-4">
        <p class="text-xs text-slate-400">Page {page_num} of {total_pages} &mdash; {total} item{if total != 1}s{/if}</p>
        <div class="flex items-center gap-1">
            {if page_num > 1}
            <a href="{base_url}/cms/admin/content?type={content_type}&page=1&q={search}&status={status_filter}&author_id={author_filter}&category_id={category_filter}&tag={tag_filter}&date_from={date_from}&date_to={date_to}&is_sticky={is_sticky_filter}&is_featured={is_featured_filter}&per_page={per_page}" class="rounded-xl border border-gray-200 px-3 py-1.5 text-sm text-gray-600 transition-colors hover:bg-gray-50">«</a>
            <a href="{base_url}/cms/admin/content?type={content_type}&page={prev_page}&q={search}&status={status_filter}&author_id={author_filter}&category_id={category_filter}&tag={tag_filter}&date_from={date_from}&date_to={date_to}&is_sticky={is_sticky_filter}&is_featured={is_featured_filter}&per_page={per_page}" class="rounded-xl border border-gray-200 px-3 py-1.5 text-sm text-gray-600 transition-colors hover:bg-gray-50">‹</a>
            {/if}
            <span class="rounded-xl bg-sky-600 px-3 py-1.5 text-sm font-medium text-white">{page_num}</span>
            {if page_num < total_pages}
            <a href="{base_url}/cms/admin/content?type={content_type}&page={next_page}&q={search}&status={status_filter}&author_id={author_filter}&category_id={category_filter}&tag={tag_filter}&date_from={date_from}&date_to={date_to}&is_sticky={is_sticky_filter}&is_featured={is_featured_filter}&per_page={per_page}" class="rounded-xl border border-gray-200 px-3 py-1.5 text-sm text-gray-600 transition-colors hover:bg-gray-50">›</a>
            <a href="{base_url}/cms/admin/content?type={content_type}&page={total_pages}&q={search}&status={status_filter}&author_id={author_filter}&category_id={category_filter}&tag={tag_filter}&date_from={date_from}&date_to={date_to}&is_sticky={is_sticky_filter}&is_featured={is_featured_filter}&per_page={per_page}" class="rounded-xl border border-gray-200 px-3 py-1.5 text-sm text-gray-600 transition-colors hover:bg-gray-50">»</a>
            {/if}
        </div>
    </div>
    {/if}

<!-- Inline Preview Panel -->
<div x-show="previewOpen" x-cloak class="fixed inset-0 z-50" @keydown.escape.window="previewOpen && (previewOpen = false)">
    <div class="fixed inset-0 bg-black/30 backdrop-blur-sm" @click="previewOpen = false" x-transition.opacity></div>
    <div class="fixed inset-y-0 right-0 w-full max-w-lg bg-white shadow-2xl border-l border-gray-200 flex flex-col" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full">
        <div class="flex items-center justify-between px-5 py-3 border-b border-gray-200 shrink-0">
            <h3 class="text-sm font-semibold text-gray-800">Content Preview</h3>
            <div class="flex items-center gap-2">
                <a x-show="previewData.id" :href="CMS_BASE + '/cms/admin/content/edit/' + previewData.id" class="text-xs text-sky-600 hover:underline">Edit</a>
                <button @click="previewOpen = false" class="text-gray-400 hover:text-gray-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
        </div>
        <div class="flex-1 overflow-y-auto">
            <div x-show="previewLoading" class="p-8 text-center text-sm text-gray-400">Loading preview…</div>
            <div x-show="!previewLoading && previewData.title" class="p-5 space-y-4">
                <div>
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold mb-2" :class="{
                        'bg-emerald-50 text-emerald-700': previewData.status === 'published',
                        'bg-amber-50 text-amber-700': previewData.status === 'draft',
                        'bg-indigo-50 text-indigo-700': previewData.status === 'private',
                        'bg-red-50 text-red-600': previewData.status === 'trash'
                    }" x-text="previewData.status"></span>
                    <h2 class="text-lg font-bold text-gray-900" x-text="previewData.title"></h2>
                    <p class="text-xs text-gray-400 font-mono mt-1" x-text="'/' + previewData.type + '/' + previewData.slug"></p>
                </div>
                <div x-show="previewData.excerpt" class="bg-gray-50 rounded-lg p-3">
                    <p class="text-[11px] font-semibold text-gray-400 uppercase mb-1">Excerpt</p>
                    <p class="text-sm text-gray-600 leading-relaxed" x-text="previewData.excerpt"></p>
                </div>
                <div>
                    <p class="text-[11px] font-semibold text-gray-400 uppercase mb-2">Body</p>
                    <div class="prose prose-sm max-w-none text-gray-700" x-html="previewData.rendered_html || previewData.body"></div>
                </div>
                <div class="border-t border-gray-100 pt-3 space-y-1 text-xs text-gray-400">
                    <p x-show="previewData.author_name">Author: <span class="text-gray-600" x-text="previewData.author_name"></span></p>
                    <p x-show="previewData.updated_at">Updated: <span class="text-gray-600" x-text="previewData.updated_at"></span></p>
                    <p x-show="previewData.published_at">Published: <span class="text-gray-600" x-text="previewData.published_at"></span></p>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
{/if}
</div>
{/block}

{block scripts}
<script>
let _liveSearchTimer = null;
function liveSearch(q) {
    clearTimeout(_liveSearchTimer);
    _liveSearchTimer = setTimeout(() => {
        document.getElementById('contentListForm').submit();
    }, 350);
}

function cmsBulkActions() {
    return {
        selected: [],
        bulkLoading: false,
        previewOpen: false,
        previewLoading: false,
        previewData: {},
        isTrashView: {if status_filter == 'trash'}true{else}false{/if},
        contentType: '{content_type}',
        async openPreview(id) {
            this.previewOpen = true;
            this.previewLoading = true;
            this.previewData = {};
            try {
                const res = await fetch(CMS_BASE + '/api/v1/cms/content/' + id, {
                    headers: { 'X-CSRF-TOKEN': CMS_CSRF }
                });
                const data = await res.json();
                if (data.ok && data.data) {
                    this.previewData = data.data;
                } else {
                    this.previewData = { title: 'Error loading preview', body: data.error || '' };
                }
            } catch (e) {
                this.previewData = { title: 'Network error', body: '' };
            }
            this.previewLoading = false;
        },
        allIds: [{foreach rows as row}{row.id},{/foreach}],
        toggleAll(e) {
            this.selected = e.target.checked ? [...this.allIds] : [];
        },
        toggleOne(id) {
            const idx = this.selected.indexOf(id);
            if (idx >= 0) this.selected.splice(idx, 1);
            else this.selected.push(id);
        },
        async bulkAction(action, singleId = null) {
            const ids = singleId !== null ? [singleId] : [...this.selected];
            if (ids.length === 0) return;
            const labels = {
                trash: 'move to trash',
                restore: 'restore',
                delete_permanent: 'permanently delete',
                publish: 'publish',
                draft: 'set to draft',
            };
            const label = labels[action] || action;
            if (!confirm('Are you sure you want to ' + label + ' ' + ids.length + ' item(s)?')) return;
            this.bulkLoading = true;
            let ok = 0, fail = 0;
            for (const id of ids) {
                try {
                    let url;
                    let body = {};
                    if (action === 'trash') {
                        url = CMS_BASE + '/api/v1/cms/content/' + id + '/trash';
                    } else if (action === 'publish') {
                        url = CMS_BASE + '/api/v1/cms/content/' + id + '/publish';
                    } else if (action === 'restore') {
                        url = CMS_BASE + '/api/v1/cms/content/' + id + '/restore';
                    } else if (action === 'delete_permanent') {
                        url = CMS_BASE + '/api/v1/cms/content/bulk';
                        body = { action: 'delete_permanent', ids: [id] };
                    } else {
                        url = CMS_BASE + '/api/v1/cms/content/' + id;
                        body = { status: 'draft' };
                    }
                    const res = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': CMS_CSRF },
                        body: JSON.stringify(body),
                    });
                    const data = await res.json();
                    if (data.ok) ok++; else fail++;
                } catch (e) { fail++; }
            }
            this.bulkLoading = false;
            if (ok > 0) toast(ok + ' item(s) updated');
            if (fail > 0) toast(fail + ' item(s) failed', 'error');
            if (ok > 0) setTimeout(() => location.reload(), 500);
            this.selected = [];
        },
        async emptyTrash() {
            this.bulkLoading = true;
            try {
                const res = await fetch(CMS_BASE + '/api/v1/cms/content/empty-trash', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': CMS_CSRF },
                    body: JSON.stringify({ type: this.contentType === 'all' ? '' : this.contentType }),
                });
                const data = await res.json();
                if (data.ok) {
                    toast('Trash emptied — ' + (data.deleted || 0) + ' item(s) deleted');
                    setTimeout(() => location.reload(), 600);
                } else {
                    toast(data.error || 'Could not empty trash', 'error');
                }
            } catch (e) {
                toast('Network error', 'error');
            }
            this.bulkLoading = false;
        },
    };
}
</script>
{/block}
