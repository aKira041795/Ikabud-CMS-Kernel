{extends "modules/cms/layouts/admin.disyl"}

{block content}
<div class="space-y-5">
    <div>
        <h1 class="text-xl font-bold text-slate-900">Menu Manager</h1>
        <p class="text-sm text-slate-500 mt-0.5">Create and manage navigation menus. Assign menus to theme locations.</p>
    </div>

<div x-data="menuManager()" x-init="init()">

    <!-- Top: Menu selector bar -->
    <div class="rounded-[28px] border border-slate-200 bg-white/92 shadow-[0_18px_40px_rgba(15,23,42,0.05)] p-4">
        <div class="flex items-center gap-4 flex-wrap">
            <label class="text-sm font-medium text-slate-600">Select a menu to edit:</label>
            <select x-model="selectedMenuId" @change="selectMenu()" class="text-sm border border-slate-200 rounded-2xl px-3 py-2 bg-white min-w-[200px] focus:outline-none focus:border-sky-500">
                <option value="">— Select —</option>
                <template x-for="m in allMenus" :key="m.id">
                    <option :value="m.id" x-text="m.name + ' (' + (m.item_count||0) + ' items)'"></option>
                </template>
            </select>
            <span class="text-slate-300">or</span>
            <button type="button" @click="showCreateModal=true" class="px-4 py-2 text-sm font-semibold text-white bg-sky-600 rounded-2xl hover:bg-sky-700 transition-colors">Create New Menu</button>
        </div>
    </div>

    <!-- Create menu modal -->
    <template x-if="showCreateModal">
        <div class="fixed inset-0 bg-black/40 z-50 flex items-center justify-center" @click.self="showCreateModal=false">
            <div class="bg-white rounded-xl shadow-xl w-full max-w-md p-6">
                <h2 class="text-lg font-bold text-slate-900 mb-4">Create New Menu</h2>
                <div class="space-y-3">
                    <div><label class="block text-sm font-medium text-slate-700 mb-1">Menu Name</label>
                    <input type="text" x-model="newMenuName" placeholder="e.g. Main Navigation" class="w-full text-sm border border-slate-200 rounded-lg px-3 py-2"></div>
                    <div><label class="block text-sm font-medium text-slate-700 mb-1">Description <span class="text-slate-400 font-normal">(optional)</span></label>
                    <input type="text" x-model="newMenuDesc" placeholder="What is this menu for?" class="w-full text-sm border border-slate-200 rounded-lg px-3 py-2"></div>
                </div>
                <div class="flex justify-end gap-3 mt-5">
                    <button type="button" @click="showCreateModal=false" class="px-4 py-2 text-sm text-slate-600">Cancel</button>
                    <button type="button" @click="createMenu()" :disabled="!newMenuName.trim()" class="px-4 py-2 text-sm font-semibold text-white bg-sky-600 rounded-2xl hover:bg-sky-700 disabled:opacity-50">Create Menu</button>
                </div>
            </div>
        </div>
    </template>

    <!-- Main editor (when menu selected) -->
    <template x-if="selectedMenuId">
    <div class="grid grid-cols-1 lg:grid-cols-[320px_1fr] gap-6">

        <!-- Left sidebar -->
        <div class="space-y-4">
            <!-- Add items -->
            <div class="bg-white rounded-[28px] border border-slate-200 shadow-[0_18px_40px_rgba(15,23,42,0.05)]">
                <div class="px-4 py-3 border-b border-slate-100"><span class="text-sm font-semibold text-slate-700">Add Menu Items</span></div>
                <div class="p-4 space-y-3">
                    <details class="group"><summary class="text-xs font-semibold text-slate-600 cursor-pointer select-none">Custom Link</summary>
                        <div class="mt-2 space-y-2">
                            <input type="text" x-model="customLabel" placeholder="Label" class="w-full text-xs border border-slate-200 rounded-xl px-2.5 py-2">
                            <input type="text" x-model="customUrl" placeholder="https://" class="w-full text-xs border border-slate-200 rounded-xl px-2.5 py-2">
                            <button type="button" @click="addCustomLink()" class="w-full px-3 py-1.5 text-xs font-medium bg-sky-600 text-white rounded-2xl hover:bg-sky-700">Add to Menu</button>
                        </div>
                    </details>
                    <details class="group"><summary class="text-xs font-semibold text-slate-600 cursor-pointer select-none">Pages</summary>
                        <div class="mt-2 max-h-[150px] overflow-y-auto space-y-0.5">
                            {foreach link_pages as pg}<label class="flex items-center gap-2 cursor-pointer hover:bg-slate-50 rounded px-2 py-1"><input type="checkbox" value="{pg.slug}" data-label="{pg.title}" class="page-checkbox w-3.5 h-3.5 rounded border-slate-300 text-sky-600"><span class="text-xs text-slate-700">{pg.title}</span></label>{/foreach}
                            <button type="button" @click="addCheckedItems('page')" class="w-full px-3 py-1.5 text-xs font-medium bg-slate-100 text-slate-700 rounded-xl hover:bg-slate-200 mt-1">Add Selected</button>
                        </div>
                    </details>
                    <details class="group"><summary class="text-xs font-semibold text-slate-600 cursor-pointer select-none">Posts</summary>
                        <div class="mt-2 max-h-[150px] overflow-y-auto space-y-0.5">
                            {foreach link_posts as ps}<label class="flex items-center gap-2 cursor-pointer hover:bg-slate-50 rounded px-2 py-1"><input type="checkbox" value="{ps.slug}" data-label="{ps.title}" class="post-checkbox w-3.5 h-3.5 rounded border-slate-300 text-sky-600"><span class="text-xs text-slate-700">{ps.title}</span></label>{/foreach}
                            <button type="button" @click="addCheckedItems('post')" class="w-full px-3 py-1.5 text-xs font-medium bg-slate-100 text-slate-700 rounded-xl hover:bg-slate-200 mt-1">Add Selected</button>
                        </div>
                    </details>
                    <details class="group"><summary class="text-xs font-semibold text-slate-600 cursor-pointer select-none">Categories</summary>
                        <div class="mt-2 max-h-[150px] overflow-y-auto space-y-0.5">
                            {foreach link_categories as cat}<label class="flex items-center gap-2 cursor-pointer hover:bg-slate-50 rounded px-2 py-1"><input type="checkbox" value="{cat.slug}" data-label="{cat.name}" class="cat-checkbox w-3.5 h-3.5 rounded border-slate-300 text-sky-600"><span class="text-xs text-slate-700">{cat.name}</span></label>{/foreach}
                            <button type="button" @click="addCheckedItems('category')" class="w-full px-3 py-1.5 text-xs font-medium bg-slate-100 text-slate-700 rounded-xl hover:bg-slate-200 mt-1">Add Selected</button>
                        </div>
                    </details>
                    <details class="group"><summary class="text-xs font-semibold text-slate-600 cursor-pointer select-none">Tags</summary>
                        <div class="mt-2 max-h-[150px] overflow-y-auto space-y-0.5">
                            {foreach link_tags as tg}<label class="flex items-center gap-2 cursor-pointer hover:bg-slate-50 rounded px-2 py-1"><input type="checkbox" value="{tg.slug}" data-label="{tg.name}" class="tag-checkbox w-3.5 h-3.5 rounded border-slate-300 text-sky-600"><span class="text-xs text-slate-700">{tg.name}</span></label>{/foreach}
                            <button type="button" @click="addCheckedItems('tag')" class="w-full px-3 py-1.5 text-xs font-medium bg-slate-100 text-slate-700 rounded-xl hover:bg-slate-200 mt-1">Add Selected</button>
                        </div>
                    </details>
                    <details class="group"><summary class="text-xs font-semibold text-slate-600 cursor-pointer select-none">Special</summary>
                        <div class="mt-2 space-y-1">
                            <button type="button" @click="addHomeItem()" class="w-full text-left px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50 rounded-lg">+ Home Page</button>
                            <button type="button" @click="addBlogItem()" class="w-full text-left px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50 rounded-lg">+ Blog Archive</button>
                            <button type="button" @click="addSearchItem()" class="w-full text-left px-3 py-1.5 text-xs text-slate-700 hover:bg-slate-50 rounded-lg">+ Search Page</button>
                        </div>
                    </details>
                </div>
            </div>

            <!-- Theme Locations -->
            <div class="bg-white rounded-[28px] border border-slate-200 shadow-[0_18px_40px_rgba(15,23,42,0.05)]">
                <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between">
                    <span class="text-sm font-semibold text-slate-700">Theme Locations</span>
                    <button type="button" @click="saveLocations()" class="text-xs font-medium text-sky-600 hover:text-sky-800">Save</button>
                </div>
                <div class="p-4 space-y-3">
                    <template x-for="loc in locations" :key="loc.slug">
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1" x-text="loc.label"></label>
                            <select x-model="locationAssignments[loc.slug]" class="w-full text-xs border border-slate-200 rounded-xl px-2.5 py-1.5 bg-white">
                                <option value="">— No menu —</option>
                                <template x-for="m in allMenus" :key="m.id"><option :value="m.id" x-text="m.name"></option></template>
                            </select>
                            <p class="text-[10px] text-slate-400 mt-0.5" x-text="loc.description||''"></p>
                        </div>
                    </template>
                </div>
            </div>
        </div>

        <!-- Right: Menu structure -->
        <div class="space-y-4">
            <div class="bg-white rounded-[28px] border border-slate-200 shadow-[0_18px_40px_rgba(15,23,42,0.05)]">
                <div class="px-4 py-3 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <input type="text" x-model="menuName" placeholder="Menu name" class="text-sm font-semibold border-0 border-b-2 border-transparent focus:border-sky-500 px-1 py-0.5 bg-transparent outline-none" style="min-width:200px">
                        <span class="text-xs text-slate-400" x-text="items.length+' items'"></span>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" @click="deleteMenu()" class="px-3 py-1.5 text-xs font-medium text-red-500 hover:bg-red-50 rounded-2xl">Delete Menu</button>
                        <button type="button" @click="saveMenu()" :disabled="saving" class="px-5 py-1.5 text-sm font-semibold text-white bg-sky-600 rounded-2xl hover:bg-sky-700 disabled:opacity-50 shadow-sm" x-text="saving?'Saving…':'Save Menu'"></button>
                    </div>
                </div>
            </div>

            <div x-show="items.length>0" class="text-xs text-slate-500 bg-sky-50 border border-sky-100 rounded-2xl px-4 py-2.5">
                <strong>Tip:</strong> Drag any item to reorder — its children move with it. Use ← → arrows or the <span class="font-mono">+</span> child button to nest up to 3 levels deep. Labels and URLs are editable inline.
            </div>

            <div class="bg-white rounded-[28px] border border-slate-200 shadow-[0_18px_40px_rgba(15,23,42,0.05)] p-4">
                <template x-if="items.length===0">
                    <div class="flex flex-col items-center justify-center py-12 text-center border-2 border-dashed border-slate-200 rounded-xl">
                        <svg class="w-8 h-8 text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h7"/></svg>
                        <p class="text-sm text-slate-400">No menu items yet. Add from the left panel.</p>
                    </div>
                </template>
                <div class="space-y-1">
                    <template x-for="(item,idx) in items" :key="item._uid">
                        <div :style="'margin-left:'+(item._depth*28)+'px'" :class="itemClass(item,idx)" draggable="true" @dragstart="dragStart(idx,$event)" @dragover.prevent @drop="dragDrop(idx)" @dragend="dragEnd()">
                            <div class="flex items-center gap-1.5 px-3 py-2">
                                <svg class="w-3.5 h-3.5 text-slate-400 cursor-grab shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"/></svg>
                                <button type="button" @click="outdentItem(idx)" :disabled="item._depth===0" class="p-0.5 rounded text-slate-400 hover:text-slate-600 disabled:opacity-20 shrink-0" title="Move out (outdent)"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg></button>
                                <button type="button" @click="indentItem(idx)" :disabled="idx===0||item._depth>=3" class="p-0.5 rounded text-slate-400 hover:text-slate-600 disabled:opacity-20 shrink-0" title="Make child (indent)"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg></button>
                                <button type="button" @click.stop="addChildItem(idx)" x-show="item._depth<3" class="p-0.5 rounded text-slate-400 hover:text-emerald-600 shrink-0" title="Add child item"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m7-7H5"/></svg></button>
                                <div x-show="item._depth>=3" class="w-4 shrink-0"></div>
                                <div class="flex-1 min-w-0 flex flex-col gap-0.5">
                                    <input type="text" x-model="item.label" placeholder="(no label)" @mousedown.stop @click.stop class="text-sm font-medium text-slate-800 w-full bg-transparent border-0 border-b border-transparent hover:border-slate-200 focus:border-sky-400 outline-none px-0.5 py-0 leading-snug">
                                    <input x-show="item.link_type==='custom'" type="text" x-model="item.url" placeholder="https://…" @mousedown.stop @click.stop class="text-xs text-slate-400 w-full bg-transparent border-0 border-b border-transparent hover:border-slate-200 focus:border-sky-400 outline-none px-0.5 py-0 leading-snug">
                                </div>
                                <span class="text-[10px] font-medium px-1.5 py-0.5 rounded shrink-0" :class="{'bg-blue-50 text-blue-600':item.link_type==='page','bg-green-50 text-green-600':item.link_type==='post','bg-purple-50 text-purple-600':item.link_type==='custom','bg-amber-50 text-amber-600':item.link_type==='category','bg-teal-50 text-teal-600':item.link_type==='tag','bg-orange-50 text-orange-600':item.link_type==='home'}" x-text="item.link_type"></span>
                                <span x-show="item._depth>0" class="text-[9px] font-bold px-1 py-0.5 rounded bg-slate-100 text-slate-400 shrink-0" x-text="'L'+item._depth"></span>
                                <button type="button" @click="moveItem(idx,-1)" :disabled="idx===0" class="p-0.5 rounded text-slate-400 hover:text-slate-600 disabled:opacity-20 shrink-0"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg></button>
                                <button type="button" @click="moveItem(idx,1)" :disabled="idx===items.length-1" class="p-0.5 rounded text-slate-400 hover:text-slate-600 disabled:opacity-20 shrink-0"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg></button>
                                <button type="button" @click="item._open=!item._open" class="p-0.5 rounded text-slate-400 hover:text-slate-600 shrink-0" title="Advanced options"><svg class="w-3.5 h-3.5 transition-transform" :class="item._open&&'rotate-180'" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></button>
                            </div>
                            <div x-show="item._open" x-cloak class="px-3 pb-3 pt-1 border-t border-slate-100 space-y-2">
                                <div class="grid grid-cols-3 gap-2">
                                    <div><label class="block text-[10px] font-medium text-slate-500 mb-1">Target</label><select x-model="item.target" class="w-full text-xs border border-slate-200 rounded-xl px-2.5 py-1.5 bg-white"><option value="_self">Same window</option><option value="_blank">New tab</option></select></div>
                                    <div><label class="block text-[10px] font-medium text-slate-500 mb-1">Title Attr</label><input type="text" x-model="item.title_attr" placeholder="Tooltip" class="w-full text-xs border border-slate-200 rounded-lg px-2.5 py-1.5"></div>
                                    <div><label class="block text-[10px] font-medium text-slate-500 mb-1">CSS Class</label><input type="text" x-model="item.css_class" placeholder="Optional" class="w-full text-xs border border-slate-200 rounded-lg px-2.5 py-1.5"></div>
                                </div>
                                <div><label class="block text-[10px] font-medium text-slate-500 mb-1">Description</label><input type="text" x-model="item.description" placeholder="Optional description" class="w-full text-xs border border-slate-200 rounded-lg px-2.5 py-1.5"></div>
                                <div class="flex items-center justify-between pt-1">
                                    <span class="text-[10px] text-slate-400" x-text="'Type: '+item.link_type+(item.link_ref?' → '+item.link_ref:'')"></span>
                                    <button type="button" @click="removeItem(idx)" class="text-xs text-red-500 hover:text-red-700 font-medium">Remove</button>
                                </div>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </div>
    </div>
    </template>

    <template x-if="!selectedMenuId">
        <div class="rounded-[28px] border border-slate-200 bg-white/92 shadow-[0_18px_40px_rgba(15,23,42,0.05)] p-12 text-center">
            <svg class="w-12 h-12 text-slate-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h7"/></svg>
            <h3 class="text-base font-medium text-slate-700 mb-1">Select or create a menu</h3>
            <p class="text-sm text-slate-400">Use the dropdown above to edit an existing menu, or create a new one.</p>
        </div>
    </template>
</div>
</div>
{/block}

{block scripts}
<script>
function menuManager() {
    return {
        allMenus: [], locations: [], locationAssignments: {},
        selectedMenuId: '', menuName: '', menuDesc: '', items: [],
        saving: false, dragIdx: null, dragGroupEnd: null, customLabel: '', customUrl: '',
        showCreateModal: false, newMenuName: '', newMenuDesc: '', _uc: 0,

        init() { this.loadAll(); },
        _uid() { return 'mi_'+(++this._uc)+'_'+Date.now(); },

        loadAll() {
            Promise.all([
                fetch(CMS_BASE+'/api/v1/cms/menus',{headers:{'X-CSRF-TOKEN':CMS_CSRF}}),
                fetch(CMS_BASE+'/api/v1/cms/menus/locations',{headers:{'X-CSRF-TOKEN':CMS_CSRF}})
            ]).then(([mR,lR]) => {
                Promise.all([mR.json(), lR.json()]).then(([mD,lD]) => {
                    if(mD.ok) this.allMenus=mD.menus||[];
                    if(lD.ok){
                        this.locations=lD.locations||[];
                        this.locationAssignments={};
                        this.locations.forEach(l => this.locationAssignments[l.slug] = l.menu_id ? String(l.menu_id) : '');
                    }
                    if(this.selectedMenuId) this.selectMenu();
                    else if(this.allMenus.length){this.selectedMenuId=String(this.allMenus[0].id);this.selectMenu();}
                });
            }).catch(e => console.error(e));
        },

        selectMenu() {
            const m=this.allMenus.find(x=>x.id==parseInt(this.selectedMenuId));
            if(!m){this.items=[];this.menuName='';return;}
            this.menuName=m.name||''; this.menuDesc=m.description||'';
            this.items=this._treeToFlat(m.items||[]);
        },

        _treeToFlat(tree,depth=0) {
            const out=[];
            tree.forEach(it=>{
                out.push(this._mk(it,depth));
                if(it.children&&it.children.length) out.push(...this._treeToFlat(it.children,depth+1));
            });
            return out;
        },

        _mk(d,depth=0) {
            return {_uid:this._uid(),_open:false,_depth:depth,
                label:d.label||'',url:d.url||'',link_type:d.link_type||'custom',
                link_ref:d.link_ref||'',target:d.target||'_self',
                css_class:d.css_class||'',description:d.description||'',
                icon:d.icon||'',title_attr:d.title_attr||''};
        },

        _flatToTree(flat) {
            const root=[];
            const stack=[{children:root,depth:-1}];
            flat.forEach(item=>{
                const node={label:item.label,url:item.url,link_type:item.link_type,
                    link_ref:item.link_ref,target:item.target,css_class:item.css_class,
                    description:item.description,icon:item.icon,title_attr:item.title_attr,
                    children:[]};
                while(stack.length>1&&stack[stack.length-1].depth>=item._depth) stack.pop();
                stack[stack.length-1].children.push(node);
                stack.push({children:node.children,depth:item._depth});
            });
            return root;
        },

        addItem(d) { this.items.push(this._mk(d,0)); },

        addHomeItem() { this.addItem({label:'Home',link_type:'home'}); },
        addBlogItem() { var _u=CMS_BASE+'/cms/blog'; this.addItem({label:'Blog',url:_u,link_type:'custom'}); },
        addSearchItem() { var _u=CMS_BASE+'/cms/search'; this.addItem({label:'Search',url:_u,link_type:'custom'}); },

        addCustomLink() {
            const l=(this.customLabel||'').trim(), u=(this.customUrl||'').trim();
            if(!l){toast('Label required','error');return;}
            this.addItem({label:l,url:u,link_type:'custom'});
            this.customLabel='';this.customUrl='';
        },

        addCheckedItems(type) {
            const cls={page:'.page-checkbox',post:'.post-checkbox',category:'.cat-checkbox',tag:'.tag-checkbox'}[type]||'.page-checkbox';
            document.querySelectorAll(cls+':checked').forEach(cb=>{
                this.addItem({label:cb.dataset.label||cb.value,link_type:type,link_ref:cb.value});
                cb.checked=false;
            });
        },

        removeItem(idx){this.items.splice(idx,1);},

        moveItem(idx,delta){
            const ni=idx+delta;
            if(ni<0||ni>=this.items.length) return;
            const t=this.items[idx];this.items[idx]=this.items[ni];this.items[ni]=t;
        },

        indentItem(idx){
            if(idx===0||this.items[idx]._depth>=3) return;
            this.items[idx]._depth++;
        },

        outdentItem(idx){
            if(this.items[idx]._depth<=0) return;
            this.items[idx]._depth--;
        },

        _getGroupEnd(idx) {
            if (!this.items[idx]) return idx + 1;
            const d = this.items[idx]._depth;
            let i = idx + 1;
            while (i < this.items.length && this.items[i]._depth > d) i++;
            return i;
        },
        addChildItem(idx) {
            const pd = this.items[idx]._depth;
            if (pd >= 3) return;
            const insertAt = this._getGroupEnd(idx);
            const child = this._mk({ label: 'New Item', link_type: 'custom', url: '' }, pd + 1);
            child._open = true;
            this.items.splice(insertAt, 0, child);
        },
        itemClass(item, idx) {
            const dragging = this.dragIdx !== null && this.dragGroupEnd !== null && idx >= this.dragIdx && idx < this.dragGroupEnd;
            if (dragging) return 'opacity-40 border-2 border-dashed border-sky-400 rounded-lg bg-sky-50';
            const dc = [
                'border border-slate-200',
                'border border-slate-200 border-l-[3px] border-l-blue-300',
                'border border-slate-200 border-l-[3px] border-l-purple-300',
                'border border-slate-200 border-l-[3px] border-l-emerald-400',
            ];
            return 'rounded-lg bg-white transition-colors ' + (dc[item._depth] || dc[0]);
        },
        dragStart(idx, e) { this.dragIdx = idx; this.dragGroupEnd = this._getGroupEnd(idx); e.dataTransfer.effectAllowed = 'move'; },
        dragEnd() { this.dragIdx = null; this.dragGroupEnd = null; },
        dragDrop(targetIdx) {
            if (this.dragIdx === null || targetIdx === this.dragIdx) { this.dragIdx = null; this.dragGroupEnd = null; return; }
            if (targetIdx > this.dragIdx && targetIdx < this.dragGroupEnd) { this.dragIdx = null; this.dragGroupEnd = null; return; }
            const start = this.dragIdx;
            const groupSize = this.dragGroupEnd - start;
            const group = this.items.splice(start, groupSize);
            const t = targetIdx > start ? Math.max(0, targetIdx - groupSize) : targetIdx;
            this.items.splice(t, 0, ...group);
            this.dragIdx = null;
            this.dragGroupEnd = null;
        },

        async createMenu() {
            try {
                const res=await fetch(CMS_BASE+'/api/v1/cms/menus/create',{method:'POST',
                    headers:{'Content-Type':'application/json','X-CSRF-TOKEN':CMS_CSRF},
                    body:JSON.stringify({name:this.newMenuName.trim(),description:this.newMenuDesc.trim()})});
                const d=await res.json();
                if(d.ok){
                    this.showCreateModal=false;this.newMenuName='';this.newMenuDesc='';
                    await this.loadAll();
                    this.selectedMenuId=String(d.id);this.selectMenu();
                    toast('Menu created');
                } else toast(d.error||'Failed','error');
            } catch(e){toast('Network error','error');}
        },

        async saveMenu() {
            this.saving=true;
            try {
                const tree=this._flatToTree(this.items);
                const res=await fetch(CMS_BASE+'/api/v1/cms/menus/'+this.selectedMenuId,{method:'POST',
                    headers:{'Content-Type':'application/json','X-CSRF-TOKEN':CMS_CSRF},
                    body:JSON.stringify({id:parseInt(this.selectedMenuId),name:this.menuName,description:this.menuDesc,items:tree})});
                const d=await res.json();
                if(d.ok){toast('Menu saved');await this.loadAll();}
                else toast(d.error||'Save failed','error');
            } catch(e){toast('Network error','error');}
            this.saving=false;
        },

        async deleteMenu() {
            if(!confirm('Delete this menu and all its items?')) return;
            try {
                await fetch(CMS_BASE+'/api/v1/cms/menus/'+this.selectedMenuId+'/delete',{method:'POST',
                    headers:{'X-CSRF-TOKEN':CMS_CSRF}});
                this.selectedMenuId='';this.items=[];this.menuName='';
                await this.loadAll();toast('Menu deleted');
            } catch(e){toast('Error','error');}
        },

        async saveLocations() {
            try {
                const assignments={};
                Object.keys(this.locationAssignments).forEach(k=>{
                    assignments[k]=this.locationAssignments[k]?parseInt(this.locationAssignments[k]):null;
                });
                const res=await fetch(CMS_BASE+'/api/v1/cms/menus/locations/assign',{method:'POST',
                    headers:{'Content-Type':'application/json','X-CSRF-TOKEN':CMS_CSRF},
                    body:JSON.stringify({assignments})});
                const d=await res.json();
                if(d.ok) toast('Locations saved');
                else toast(d.error||'Failed','error');
            } catch(e){toast('Error','error');}
        },
    };
}
</script>
{/block}
