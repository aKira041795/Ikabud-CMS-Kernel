<!--
  Report Approval Queue — Admin page
  Requires administrator/superadmin role
-->
{extends "modules/cms/layouts/admin.disyl"}

{block content}
<div x-data="reportApprovals()" class="space-y-6">
    <div class="flex flex-col gap-6">
        <div class="flex flex-col gap-4 xl:flex-row xl:items-start xl:justify-between">
            <div>
                <div class="flex items-center gap-3 flex-wrap">
                    <h1 class="text-[2rem] font-bold tracking-tight text-slate-900">Report Approval Queue</h1>
                </div>
                <p class="mt-2 max-w-3xl text-sm text-slate-500">Review and approve pending export requests.</p>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-200">
            <div class="p-6">
                {if pending_approvals|default:[]|count > 0}
                <table class="w-full text-sm">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Source</th>
                            <th>Format</th>
                            <th>Status</th>
                            <th>Requested</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {for item in pending_approvals}
                        <tr>
                            <td>{item.id}</td>
                            <td>{item.title|default:item.export_source}</td>
                            <td>{item.export_source}</td>
                            <td>{item.export_format}</td>
                            <td>
                                {if item.status == 'pending'}
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">Pending</span>
                                {elseif item.status == 'approved'}
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Approved</span>
                                {elseif item.status == 'rejected'}
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Rejected</span>
                                {else}
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">{item.status}</span>
                                {/if}
                            </td>
                            <td>{item.created_at}</td>
                            <td class="space-x-2">
                                {if item.status == 'pending'}
                                <button @click="approve($event)" data-id="{item.id}" class="px-3 py-1.5 bg-green-600 text-white text-xs rounded-lg hover:bg-green-700">Approve</button>
                                <button @click="reject($event)" data-id="{item.id}" class="px-3 py-1.5 bg-red-600 text-white text-xs rounded-lg hover:bg-red-700">Reject</button>
                                {elseif item.status == 'approved'}
                                <span class="text-green-600 text-sm font-medium">Download</span>
                                {/if}
                            </td>
                        </tr>
                        {/for}
                    </tbody>
                </table>
                {else}
                <div class="text-center py-12 text-gray-500">
                    <p>No pending approvals.</p>
                </div>
                {/if}
            </div>
        </div>
    </div>
</div>
{/block}

{block scripts}
<script>
    function reportApprovals() {
        return {
            approve(event) {
                const id = parseInt(event.target.dataset.id);
                if (!confirm('Approve this export?')) return;
                fetch('/api/v1/cms/export/approve', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
                    body: JSON.stringify({approval_id: id})
                }).then(r => r.json()).then(d => {
                    if (d.ok) { location.reload(); }
                    else { alert('Error: ' + (d.error || 'Unknown')); }
                });
            },
            reject(event) {
                const id = parseInt(event.target.dataset.id);
                const reason = prompt('Rejection reason:');
                if (reason === null) return;
                fetch('/api/v1/cms/export/reject', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
                    body: JSON.stringify({approval_id: id, reason: reason})
                }).then(r => r.json()).then(d => {
                    if (d.ok) { location.reload(); }
                    else { alert('Error: ' + (d.error || 'Unknown')); }
                });
            }
        };
    }
</script>
{/block}
