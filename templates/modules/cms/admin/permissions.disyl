{extends "modules/cms/layouts/admin.disyl"}

{block content}
<div x-data="cmsPermissions()" class="max-w-6xl space-y-5">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-xl font-bold text-slate-900">Role Permissions</h1>
            <p class="text-sm text-slate-500 mt-0.5">Configure which capabilities each role has. Changes in <span class="text-amber-600 font-medium">amber</span> are overrides.</p>
        </div>
        <div class="flex items-center gap-2">
            <span x-show="hasChanges()" x-transition class="text-xs text-amber-600 font-medium">Unsaved changes</span>
            <button type="button" @click="resetDefaults()" class="px-3 py-2 text-xs font-medium text-slate-500 bg-white border border-slate-200 rounded-2xl hover:bg-slate-50 transition-colors">Reset All</button>
            <button type="button" @click="save()" :disabled="saving" class="px-4 py-2 text-xs font-semibold text-white bg-sky-600 rounded-2xl hover:bg-sky-700 disabled:opacity-50 transition-colors">
                <span x-show="!saving">Save Permissions</span>
                <span x-show="saving">Saving…</span>
            </button>
        </div>
    </div>

    <!-- Filter -->
    <div class="flex items-center gap-3 flex-wrap">
        <input type="text" x-model="search" placeholder="Filter capabilities…" class="w-64 px-3 py-2 text-sm border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500">
        <select x-model="filterGroup" class="px-3 py-2 text-sm border border-slate-200 rounded-2xl bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500">
            <option value="">All Groups</option>
            <template x-for="g in groupNames" :key="g">
                <option :value="g" x-text="g"></option>
            </template>
        </select>
        <label class="flex items-center gap-1.5 text-xs text-slate-500 cursor-pointer">
            <input type="checkbox" x-model="onlyOverrides" class="rounded border-slate-200 text-sky-600 focus:ring-sky-500/20">
            <span>Only overrides</span>
        </label>
    </div>

    <!-- Permission Groups -->
    <template x-for="group in filteredGroups" :key="group.name">
        <div class="rounded-[28px] border border-slate-200 bg-white/92 shadow-[0_18px_40px_rgba(15,23,42,0.05)] overflow-hidden">
            <div class="px-5 py-3 border-b border-slate-100 bg-slate-50/60">
                <h3 class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-400" x-text="group.name"></h3>
            </div>
            <div class="overflow-hidden">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 bg-slate-50/30">
                            <th class="text-left px-5 py-2.5 text-[11px] font-semibold text-slate-400 tracking-[0.12em] uppercase w-1/3">Capability</th>
                            <th class="text-left px-5 py-2.5 text-[11px] font-semibold text-slate-400 tracking-[0.12em] uppercase">Minimum Role</th>
                            <th class="text-center px-5 py-2.5 text-[11px] font-semibold text-slate-400 tracking-[0.12em] uppercase w-20">Default</th>
                            <th class="text-center px-5 py-2.5 text-[11px] font-semibold text-slate-400 tracking-[0.12em] uppercase w-16"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="cap in group.caps" :key="cap.key">
                            <tr class="border-b border-slate-50 hover:bg-slate-50/40 transition-colors" :class="isOverridden(cap.key) ? 'bg-amber-50/30' : ''">
                                <td class="px-5 py-3">
                                    <div class="text-xs font-medium text-slate-700" x-text="cap.label"></div>
                                    <div class="text-[11px] text-slate-400 font-mono" x-text="cap.key"></div>
                                </td>
                                <td class="px-5 py-3">
                                    <select
                                        :value="effective[cap.key]"
                                        @change="setRole(cap.key, $event.target.value)"
                                        class="px-2 py-1 text-xs border rounded-xl bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500"
                                        :class="isOverridden(cap.key) ? 'border-amber-400 text-amber-700 font-medium' : 'border-slate-200 text-slate-600'"
                                    >
                                        <template x-for="r in editableRoles" :key="r">
                                            <option :value="r" x-text="r.charAt(0).toUpperCase() + r.slice(1)"></option>
                                        </template>
                                    </select>
                                </td>
                                <td class="text-center px-5 py-3">
                                    <span class="text-[11px] text-slate-400" x-text="defaults[cap.key].charAt(0).toUpperCase() + defaults[cap.key].slice(1)"></span>
                                </td>
                                <td class="text-center px-5 py-3">
                                    <button
                                        x-show="isOverridden(cap.key)"
                                        @click="resetCap(cap.key)"
                                        class="text-[11px] text-slate-400 hover:text-red-500 transition-colors"
                                        title="Reset to default"
                                    >
                                        <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                    </button>
                                </td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </div>
    </template>

    <!-- Role Summary -->
    <div class="space-y-3">
        <h3 class="text-sm font-bold text-slate-700">Role Summary</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
            <template x-for="r in editableRoles" :key="r">
                <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-[0_2px_8px_rgba(15,23,42,0.05)]">
                    <div class="text-xs font-semibold text-slate-700 mb-1" x-text="r.charAt(0).toUpperCase() + r.slice(1)"></div>
                    <div class="text-[11px] text-slate-400">
                        <span x-text="countCaps(r)"></span> / <span x-text="totalCaps"></span> capabilities
                    </div>
                    <div class="mt-2 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                        <div class="h-full bg-sky-500 rounded-full transition-all" :style="'width:' + (countCaps(r) / totalCaps * 100) + '%'"></div>
                    </div>
                </div>
            </template>
        </div>
    </div>
</div>

<script>
function cmsPermissions() {
    const roles = {roles_json | raw};
    const roleLevels = {role_levels_json | raw};
    const defaults = {defaults_json | raw};
    const groups = {groups_json | raw};
    const labels = {labels_json | raw};
    const initialEffective = {effective_json | raw};

    // Editable roles (exclude superadmin — always has everything)
    const editableRoles = roles.filter(r => r !== 'superadmin');

    const groupNames = Object.keys(groups);

    // Build grouped capabilities
    const capGroups = [];
    for (const [gName, prefixes] of Object.entries(groups)) {
        const caps = [];
        for (const [cap, defRole] of Object.entries(defaults)) {
            if (prefixes.some(p => cap.startsWith(p))) {
                caps.push({ key: cap, label: labels[cap] || cap, defaultRole: defRole });
            }
        }
        if (caps.length) capGroups.push({ name: gName, caps });
    }

    return {
        roles,
        editableRoles,
        roleLevels,
        defaults,
        labels,
        groups,
        groupNames,
        capGroups,
        effective: { ...initialEffective },
        originalEffective: { ...initialEffective },
        saving: false,
        search: '',
        filterGroup: '',
        onlyOverrides: false,

        get totalCaps() {
            return Object.keys(defaults).length;
        },

        get filteredGroups() {
            return this.capGroups
                .filter(g => !this.filterGroup || g.name === this.filterGroup)
                .map(g => ({
                    name: g.name,
                    caps: g.caps.filter(c => {
                        if (this.search) {
                            const q = this.search.toLowerCase();
                            if (!c.key.toLowerCase().includes(q) && !c.label.toLowerCase().includes(q)) return false;
                        }
                        if (this.onlyOverrides && !this.isOverridden(c.key)) return false;
                        return true;
                    })
                }))
                .filter(g => g.caps.length > 0);
        },

        isOverridden(cap) {
            return this.effective[cap] !== defaults[cap];
        },

        hasChanges() {
            for (const cap in this.effective) {
                if (this.effective[cap] !== this.originalEffective[cap]) return true;
            }
            return false;
        },

        setRole(cap, role) {
            this.effective[cap] = role;
        },

        resetCap(cap) {
            this.effective[cap] = defaults[cap];
        },

        countCaps(role) {
            const rLevel = roleLevels[role] || 0;
            let count = 0;
            for (const [cap, minRole] of Object.entries(this.effective)) {
                const minLevel = roleLevels[minRole] || 0;
                if (rLevel >= minLevel) count++;
            }
            return count;
        },

        async save() {
            this.saving = true;
            // Build overrides: only caps that differ from defaults
            const overrides = {};
            for (const [cap, role] of Object.entries(this.effective)) {
                if (role !== defaults[cap]) {
                    overrides[cap] = role;
                }
            }
            try {
                const res = await fetch(CMS_BASE + '/api/v1/cms/permissions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': CMS_CSRF },
                    body: JSON.stringify({ overrides }),
                });
                const data = await res.json();
                if (data.ok) {
                    this.originalEffective = { ...this.effective };
                    toast('Permissions saved');
                } else {
                    toast(data.error || 'Save failed', 'error');
                }
            } catch(e) {
                toast('Network error', 'error');
            }
            this.saving = false;
        },

        async resetDefaults() {
            if (!confirm('Reset ALL permissions to factory defaults? This cannot be undone.')) return;
            try {
                const res = await fetch(CMS_BASE + '/api/v1/cms/permissions/reset', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': CMS_CSRF },
                    body: '{}',
                });
                const data = await res.json();
                if (data.ok) {
                    // Reset local state
                    for (const cap in this.effective) {
                        this.effective[cap] = defaults[cap];
                    }
                    this.originalEffective = { ...this.effective };
                    toast('Permissions reset to defaults');
                } else {
                    toast(data.error || 'Reset failed', 'error');
                }
            } catch(e) {
                toast('Network error', 'error');
            }
        }
    };
}
</script>
{/block}
