{extends "modules/cms/layouts/admin.disyl"}
{block head}
<style>
    /* ── Panels ──────────────────────────────────────────────── */
    .cz-panel { background:rgba(255,255,255,.96); border-radius:1rem; border:1px solid #e2e8f0; overflow:hidden; box-shadow:0 16px 34px rgba(15,23,42,.05); transition:box-shadow 0.2s ease, transform 0.2s ease; }
    .cz-panel:hover { box-shadow:0 20px 40px rgba(15,23,42,.07); }
    .cz-panel-header { display:flex; align-items:center; justify-content:space-between; padding:0.875rem 1.25rem; border-bottom:1px solid #f3f4f6; background:rgba(249,250,251,.5); cursor:pointer; user-select:none; transition:background 0.15s ease; }
    .cz-panel-header:hover { background:rgba(241,245,249,.7); }
    .cz-panel-header h3 { font-size:0.875rem; font-weight:600; color:#1f2937; margin:0; }
    .cz-panel-body { padding:1.25rem; }
    .cz-panel-body > * + * { margin-top:1rem; }

    /* ── Section headers inside panels ───────────────────────── */
    .cz-section-title { font-size:0.6875rem; font-weight:600; text-transform:uppercase; letter-spacing:0.08em; color:#6b7280; margin-bottom:0.625rem; display:flex; align-items:center; gap:0.5rem; }
    .cz-section-title::after { content:''; flex:1; height:1px; background:#e5e7eb; }

    /* ── Form elements ───────────────────────────────────────── */
    .cz-label { display:block; font-size:0.75rem; font-weight:500; color:#4b5563; margin-bottom:0.375rem; line-height:1.4; }
    .cz-hint { font-size:0.6875rem; color:#9ca3af; margin-top:0.25rem; line-height:1.4; }
    .cz-input { width:100%; padding:0.5rem 0.75rem; font-size:0.875rem; border:1px solid #e5e7eb; border-radius:0.5rem; outline:none; transition:all 0.15s ease; box-sizing:border-box; background:#fff; color:#1f2937; }
    .cz-input:focus { box-shadow:0 0 0 3px rgba(14,165,233,.15); border-color:#0ea5e9; }
    .cz-input::placeholder { color:#9ca3af; }
    .cz-input[type="number"] { -moz-appearance:textfield; }
    .cz-input[type="number"]::-webkit-inner-spin-button { opacity:0.5; }
    .cz-select { width:100%; padding:0.5rem 0.75rem; font-size:0.875rem; border:1px solid #e5e7eb; border-radius:0.5rem; outline:none; background:#fff; box-sizing:border-box; color:#1f2937; transition:all 0.15s ease; cursor:pointer; }
    .cz-select:focus { box-shadow:0 0 0 3px rgba(14,165,233,.15); border-color:#0ea5e9; }

    /* ── Color pickers ───────────────────────────────────────── */
    .cz-color-wrap { display:flex; align-items:center; gap:0.5rem; }
    .cz-color-input { width:2.5rem; height:2.5rem; border-radius:0.5rem; border:1px solid #e5e7eb; cursor:pointer; padding:2px; transition:border-color 0.15s ease; }
    .cz-color-input:hover { border-color:#94a3b8; }
    .cz-color-hex { flex:1; padding:0.5rem 0.75rem; font-size:0.8125rem; border:1px solid #e5e7eb; border-radius:0.5rem; font-family:ui-monospace,SFMono-Regular,monospace; background:#fff; color:#374151; outline:none; transition:all 0.15s ease; box-sizing:border-box; }
    .cz-color-hex:focus { box-shadow:0 0 0 3px rgba(14,165,233,.15); border-color:#0ea5e9; }

    /* ── Toggle switch (consistent) ──────────────────────────── */
    .cz-toggle { position:relative; display:inline-flex; height:1.375rem; width:2.5rem; flex-shrink:0; cursor:pointer; border-radius:9999px; border:2px solid transparent; transition:background-color 0.2s ease; }
    .cz-toggle-off { background:#d1d5db; }
    .cz-toggle-on { background:#0ea5e9; }
    .cz-toggle-knob { pointer-events:none; display:inline-block; height:1rem; width:1rem; border-radius:9999px; background:#fff; box-shadow:0 1px 3px rgba(0,0,0,.15); transition:transform 0.2s ease; }
    .cz-toggle-knob-off { transform:translateX(0); }
    .cz-toggle-knob-on { transform:translateX(1.125rem); }
    .cz-toggle-row { display:flex; align-items:center; justify-content:space-between; gap:0.75rem; }
    .cz-toggle-label { font-size:0.8125rem; font-weight:500; color:#374151; }
    .cz-toggle-desc { font-size:0.6875rem; color:#9ca3af; margin-top:0.125rem; }

    /* ── Range sliders ───────────────────────────────────────── */
    input[type="range"] { accent-color:#0ea5e9; height:6px; cursor:pointer; }
    input[type="range"]::-webkit-slider-thumb { box-shadow:0 1px 3px rgba(0,0,0,.15); }
    .cz-range-row { display:flex; align-items:center; gap:0.625rem; }
    .cz-range-row input[type="range"] { flex:1; }
    .cz-range-value { min-width:2.5rem; text-align:right; font-size:0.75rem; color:#6b7280; font-family:ui-monospace,SFMono-Regular,monospace; font-weight:500; }

    /* ── Buttons ──────────────────────────────────────────────── */
    .cz-btn { display:inline-flex; align-items:center; gap:0.375rem; padding:0.625rem 1rem; font-size:0.875rem; font-weight:600; border-radius:0.9rem; transition:all 0.15s ease; cursor:pointer; border:none; }
    .cz-btn-primary { background:#0284c7; color:#fff; box-shadow:0 1px 2px rgba(0,0,0,.05); }
    .cz-btn-primary:hover { background:#0369a1; box-shadow:0 1px 3px rgba(0,0,0,.1); }
    .cz-btn-secondary { background:#fff; color:#374151; border:1px solid #e5e7eb; }
    .cz-btn-secondary:hover { background:#f9fafb; border-color:#d1d5db; }
    .cz-btn-danger { background:#fef2f2; color:#dc2626; border:1px solid #fecaca; }
    .cz-btn-danger:hover { background:#fee2e2; }

    /* ── Widget cards ─────────────────────────────────────────── */
    .cz-widget-card { background:#fff; border:1px solid #e5e7eb; border-radius:0.5rem; overflow:hidden; transition:box-shadow 0.15s ease; }
    .cz-widget-card:hover { box-shadow:0 4px 6px -1px rgba(0,0,0,.1); }
    .cz-widget-card-header { display:flex; align-items:center; justify-content:space-between; padding:0.625rem 0.75rem; background:#f9fafb; border-bottom:1px solid #f3f4f6; cursor:move; }
    .cz-widget-card-body { padding:0.75rem; font-size:0.875rem; }
    .cz-widget-card-body > * + * { margin-top:0.75rem; }
    .cz-widget-type-badge { display:inline-flex; align-items:center; padding:0.125rem 0.5rem; border-radius:9999px; font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; }

    /* ── Utility ──────────────────────────────────────────────── */
    .cz-col-header { font-size:0.75rem; font-weight:600; text-transform:uppercase; letter-spacing:0.1em; color:#9ca3af; margin-bottom:0.5rem; display:flex; align-items:center; gap:0.5rem; }
    .cz-empty-col { border:2px dashed #e5e7eb; border-radius:0.5rem; padding:1rem; text-align:center; font-size:0.75rem; color:#9ca3af; }
    .cz-preview-frame { background:linear-gradient(180deg,#eef4ff 0%,#ffffff 12%,#f8fafc 100%); border-radius:1.25rem; overflow:hidden; border:1px solid rgba(148,163,184,.22); box-shadow:0 18px 40px rgba(15,23,42,.08), inset 0 1px 0 rgba(255,255,255,.75); }
    .cz-divider { border:none; border-top:1px solid #f1f5f9; margin:0.25rem 0; }
    .cz-indent { border-left:2px solid #e0f2fe; padding-left:1rem; margin-left:0.25rem; }

    /* ── Studio shell ────────────────────────────────────────── */
    .cz-studio-hero { border:1px solid rgba(148,163,184,.18); border-radius:1.75rem; background:linear-gradient(180deg, rgba(255,255,255,.94) 0%, rgba(248,250,252,.94) 100%); box-shadow:0 24px 48px rgba(15,23,42,.06); padding:1.5rem; }
    .cz-studio-toolbar { display:grid; gap:0.875rem; margin-top:1.25rem; padding:0.875rem; border:1px solid rgba(148,163,184,.16); border-radius:1.5rem; background:rgba(255,255,255,.78); }
    .cz-studio-meta { display:block; font-size:0.6875rem; font-weight:700; text-transform:uppercase; letter-spacing:0.14em; color:#94a3b8; margin-bottom:0.35rem; }
    .cz-studio-status { display:flex; align-items:center; gap:0.75rem; padding:0.8rem 1rem; border-radius:1.25rem; border:1px solid #e2e8f0; background:#fff; min-width:min(100%, 19rem); }
    .cz-studio-status-dot { width:0.75rem; height:0.75rem; border-radius:9999px; flex-shrink:0; }
    .cz-studio-status-clean .cz-studio-status-dot { background:#10b981; box-shadow:0 0 0 6px rgba(16,185,129,.12); }
    .cz-studio-status-dirty .cz-studio-status-dot { background:#f59e0b; box-shadow:0 0 0 6px rgba(245,158,11,.12); }
    .cz-studio-status-saving .cz-studio-status-dot { background:#0ea5e9; box-shadow:0 0 0 6px rgba(14,165,233,.12); }
    .cz-viewport-switch { display:inline-flex; align-items:center; gap:0.25rem; padding:0.25rem; border:1px solid rgba(148,163,184,.16); border-radius:1rem; background:#fff; }
    .cz-viewport-btn { display:inline-flex; align-items:center; justify-content:center; width:2.6rem; height:2.6rem; border-radius:0.85rem; color:#64748b; border:none; background:transparent; transition:all 0.15s ease; }
    .cz-viewport-btn:hover { background:#f8fafc; color:#1e293b; }
    .cz-viewport-btn.is-active { background:#2563eb; color:#fff; box-shadow:0 10px 20px rgba(37,99,235,.2); }
    .cz-toolbar-select { min-width:13rem; border-radius:1rem; }
    .cz-studio-link { display:flex; flex-direction:column; justify-content:center; gap:0.2rem; padding:0.85rem 1rem; min-height:100%; border:1px solid rgba(148,163,184,.16); border-radius:1.25rem; background:#fff; }
    .cz-studio-url { font-size:0.875rem; font-weight:600; color:#0f172a; text-decoration:none; word-break:break-all; }
    .cz-studio-url:hover { color:#2563eb; }
    .cz-tab-shell { border:1px solid rgba(148,163,184,.16); border-radius:1.5rem; background:rgba(255,255,255,.74); box-shadow:0 16px 36px rgba(15,23,42,.04); overflow:hidden; }

    @media (min-width: 1280px) {
        .cz-studio-toolbar { grid-template-columns:auto minmax(14rem, 18rem) minmax(0, 1fr); align-items:center; }
        /* Preview LEFT (7 cols), controls RIGHT (5 cols) */
        .cz-preview-column { position:sticky; top:1.5rem; align-self:start; order:1 !important; grid-column:span 7 / span 7 !important; }
        .cz-tab-grid > div:not(.cz-preview-column) { order:2; grid-column:span 5 / span 5; }
    }

    .cz-viewport-tablet .cz-preview-frame { max-width:52rem; margin-left:auto; margin-right:auto; }
    .cz-viewport-mobile .cz-preview-frame { max-width:26rem; margin-left:auto; margin-right:auto; }

    /* ── Tabs ─────────────────────────────────────────────────── */
    .cz-tab { padding:0.625rem 1rem; font-size:0.875rem; font-weight:500; border-bottom:2px solid transparent; transition:all 0.15s ease; cursor:pointer; background:none; }
    .cz-tab-active { color:#0284c7; border-bottom-color:#0284c7; }
    .cz-tab-inactive { color:#6b7280; }
    .cz-tab-inactive:hover { color:#374151; border-bottom-color:#d1d5db; }

    /* ── Upload button ────────────────────────────────────────── */
    .cz-upload-btn { display:inline-flex; align-items:center; gap:0.25rem; padding:0.375rem 0.75rem; background:#f8fafc; color:#475569; border:1px solid #e2e8f0; border-radius:0.5rem; font-size:0.75rem; font-weight:500; cursor:pointer; transition:all 0.15s ease; }
    .cz-upload-btn:hover { background:#f1f5f9; border-color:#cbd5e1; }
    .cz-upload-btn svg { width:14px; height:14px; }

    /* ── Image preview ────────────────────────────────────────── */
    .cz-img-preview { display:flex; align-items:center; gap:0.75rem; padding:0.5rem; background:#fafafa; border:1px solid #f1f5f9; border-radius:0.5rem; }
    .cz-img-preview img { max-height:2.5rem; border-radius:0.25rem; }
    .cz-img-preview .cz-remove-btn { font-size:0.6875rem; color:#ef4444; cursor:pointer; transition:color 0.15s; }
    .cz-img-preview .cz-remove-btn:hover { color:#dc2626; }
</style>
{/block}

{block content}
<div x-data="themeCustomizer()" x-init="init()" class="space-y-6" :class="'cz-viewport-' + studioViewport">

    <!-- Header -->
    <div class="cz-studio-hero">
        <div class="flex flex-col gap-5 xl:flex-row xl:items-start xl:justify-between">
            <div>
                <div class="flex items-center gap-2">
                    <h2 class="text-xl font-bold text-slate-900">{if customizer_title}{customizer_title}{else}Theme Customizer{/if}</h2>
                    {if customizer_scope == 'ecommerce'}<span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.14em] text-amber-700">Storefront Studio</span>{/if}
                </div>
                <p class="mt-0.5 text-sm text-slate-500" x-text="tabDescription()"></p>
                {if customizer_intro}<p class="mt-1 text-xs text-slate-400">{customizer_intro}</p>{/if}
                <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
                    <a href="{native_customizer_url}" class="inline-flex items-center rounded-full border px-3 py-1.5 font-medium transition-colors {if customizer_scope == 'native'}border-slate-900 bg-slate-900 text-white{else}border-slate-200 bg-white text-slate-600 hover:border-slate-300 hover:text-slate-900{/if}">Native Workspace</a>
                    <a href="{ecommerce_customizer_url}" class="inline-flex items-center rounded-full border px-3 py-1.5 font-medium transition-colors {if customizer_scope == 'ecommerce'}border-amber-600 bg-amber-600 text-white{else}border-amber-200 bg-amber-50 text-amber-700 hover:border-amber-300{/if}">E-commerce Workspace</a>
                </div>
                {if customizer_scope == 'ecommerce'}
                <div class="mt-3 rounded-xl border border-amber-200 bg-gradient-to-r from-amber-50 via-white to-sky-50 px-3 py-3 text-xs text-slate-700">
                    Shape the storefront shell here: header, navigation, sidebar, footer, palette, and shell layout. Use Entities for the canonical entity view and entity list contract.
                </div>
                {/if}
                {if customizer_scope != 'ecommerce'}
                <div class="mt-3 rounded-xl border border-slate-200 bg-gradient-to-r from-slate-50 via-white to-emerald-50 px-3 py-3 text-xs text-slate-700">
                    The active theme shell stays in charge here. Use Entities for canonical page, post, list, and commerce presentation inside that shell.
                </div>
                {/if}
                {if customizer_scope_notice}
                <div class="mt-3 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800">{customizer_scope_notice}</div>
                {/if}
            </div>
            <div class="flex flex-col items-stretch gap-3 xl:items-end">
                <div class="cz-studio-status" :class="saving ? 'cz-studio-status-saving' : (dirty ? 'cz-studio-status-dirty' : 'cz-studio-status-clean')">
                    <span class="cz-studio-status-dot"></span>
                    <div>
                        <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-400" x-text="studioStatusLabel()"></p>
                        <p class="text-xs text-slate-500" x-text="studioStatusDetail()"></p>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <button @click="resetDefaults()" class="cz-btn cz-btn-secondary" :disabled="saving">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                        Reset
                    </button>
                    <a :href="studioPreviewHref()" target="_blank" rel="noopener" class="cz-btn cz-btn-secondary">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        Preview Site
                    </a>
                    <button @click="save()" class="cz-btn cz-btn-primary" :disabled="saving">
                        <svg x-show="!saving" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        <svg x-show="saving" class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                        <span x-text="saving ? 'Saving…' : 'Save Changes'"></span>
                    </button>
                </div>
            </div>
        </div>

        <div class="cz-studio-toolbar">
            <div>
                <span class="cz-studio-meta">Preview Focus</span>
                <div class="cz-viewport-switch">
                    <button type="button" class="cz-viewport-btn" :class="studioViewport === 'desktop' ? 'is-active' : ''" @click="studioViewport = 'desktop'" aria-label="Desktop preview">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M9.75 17L9 20h6l-.75-3M4 5h16a1 1 0 011 1v10a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1z"/></svg>
                    </button>
                    <button type="button" class="cz-viewport-btn" :class="studioViewport === 'tablet' ? 'is-active' : ''" @click="studioViewport = 'tablet'" aria-label="Tablet preview">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="7" y="3" width="10" height="18" rx="2" stroke-width="1.7"></rect><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M11 18h2"/></svg>
                    </button>
                    <button type="button" class="cz-viewport-btn" :class="studioViewport === 'mobile' ? 'is-active' : ''" @click="studioViewport = 'mobile'" aria-label="Mobile preview">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="9" y="2.5" width="6" height="19" rx="2" stroke-width="1.7"></rect><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M11.5 18.5h1"/></svg>
                    </button>
                </div>
            </div>
            <div>
                <label class="cz-studio-meta" for="cz-active-section">Editing Section</label>
                <select id="cz-active-section" class="cz-select cz-toolbar-select" x-model="activeTab">
                    <option value="footer">{if customizer_scope == 'ecommerce'}Store Footer{else}Footer{/if}</option>
                    <option value="header">{if customizer_scope == 'ecommerce'}Store Header{else}Header{/if}</option>
                    <option value="navigation">{if customizer_scope == 'ecommerce'}Menu Behavior{else}Navigation{/if}</option>
                    <option value="sidebar">{if customizer_scope == 'ecommerce'}Sidebar Rail{else}Sidebar{/if}</option>
                    <option value="colors">{if customizer_scope == 'ecommerce'}Store Palette{else}Colors &amp; Typography{/if}</option>
                    <option value="custom_code">{if customizer_scope == 'ecommerce'}Store Code{else}Custom Code{/if}</option>
                    <option value="theme">{if customizer_scope == 'ecommerce'}Shell Layout{else}Theme Settings{/if}</option>
                    <option value="commerce">Entities</option>
                </select>
            </div>
            <div class="cz-studio-link">
                <span class="cz-studio-meta" x-text="studioPreviewLabel()"></span>
                <a :href="studioPreviewHref()" target="_blank" rel="noopener" class="cz-studio-url" x-text="studioPreviewHref()"></a>
            </div>
        </div>
    </div>

    <!-- Workspace Tabs -->
    <div class="cz-tab-shell">
        <nav class="flex gap-0 overflow-x-auto px-2 sm:px-4">
            <button @click="activeTab = 'footer'" class="cz-tab" :class="activeTab === 'footer' ? 'cz-tab-active' : 'cz-tab-inactive'">
                <svg class="w-4 h-4 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                {if customizer_scope == 'ecommerce'}Store Footer{else}Footer{/if}
            </button>
            <button @click="activeTab = 'header'" class="cz-tab" :class="activeTab === 'header' ? 'cz-tab-active' : 'cz-tab-inactive'">
                <svg class="w-4 h-4 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5z"/></svg>
                {if customizer_scope == 'ecommerce'}Store Header{else}Header{/if}
            </button>
            <button @click="activeTab = 'navigation'" class="cz-tab" :class="activeTab === 'navigation' ? 'cz-tab-active' : 'cz-tab-inactive'">
                <svg class="w-4 h-4 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h10"/></svg>
                {if customizer_scope == 'ecommerce'}Menu Behavior{else}Navigation{/if}
            </button>
            <button @click="activeTab = 'sidebar'" class="cz-tab" :class="activeTab === 'sidebar' ? 'cz-tab-active' : 'cz-tab-inactive'">
                <svg class="w-4 h-4 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h18a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm5 0v14"/></svg>
                {if customizer_scope == 'ecommerce'}Sidebar Rail{else}Sidebar{/if}
            </button>
            <button @click="activeTab = 'colors'" class="cz-tab" :class="activeTab === 'colors' ? 'cz-tab-active' : 'cz-tab-inactive'">
                <svg class="w-4 h-4 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
                {if customizer_scope == 'ecommerce'}Store Palette{else}Colors &amp; Typography{/if}
            </button>
            <button @click="activeTab = 'custom_code'" class="cz-tab" :class="activeTab === 'custom_code' ? 'cz-tab-active' : 'cz-tab-inactive'">
                <svg class="w-4 h-4 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                {if customizer_scope == 'ecommerce'}Store Code{else}Custom Code{/if}
            </button>
            <button @click="activeTab = 'theme'" class="cz-tab" :class="activeTab === 'theme' ? 'cz-tab-active' : 'cz-tab-inactive'">
                <svg class="w-4 h-4 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm0 5h16M9 5v14"/></svg>
                {if customizer_scope == 'ecommerce'}Shell Layout{else}Theme Settings{/if}
            </button>
            <button @click="activeTab = 'commerce'" class="cz-tab" :class="activeTab === 'commerce' ? 'cz-tab-active' : 'cz-tab-inactive'">
                <svg class="w-4 h-4 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7h18M6 12h12M8 17h8"/></svg>
                Entities
            </button>
        </nav>
    </div>

    <!-- Footer Tab Content -->
    <div x-show="activeTab === 'footer'" class="grid grid-cols-1 xl:grid-cols-12 gap-6 cz-tab-grid">
        <!-- Left Column: Settings + Widget Areas -->
        <div class="xl:col-span-8 space-y-5">

            <!-- Layout Settings Panel -->
            <div class="cz-panel">
                <div class="cz-panel-header" @click="panels.layout = !panels.layout">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>
                        Footer Layout
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="panels.layout ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="panels.layout" x-collapse class="cz-panel-body">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Columns -->
                        <div>
                            <label class="cz-label">Widget Columns</label>
                            <div class="flex gap-1.5">
                                <template x-for="n in [0,1,2,3,4,5]" :key="n">
                                    <button @click="footerSettings.columns = n"
                                            class="flex-1 py-2 text-sm font-medium rounded-lg border transition-all"
                                            :class="footerSettings.columns == n ? 'bg-sky-600 text-white border-sky-600' : 'bg-white text-gray-600 border-gray-200 hover:bg-gray-50'"
                                            x-text="n === 0 ? 'Off' : n"></button>
                                </template>
                            </div>
                        </div>
                        <div>
                            <label class="cz-label">Widget Container</label>
                            <select class="cz-select" x-model="footerSettings.widget_container_width">
                                <option value="contained">Contained</option>
                                <option value="full">Full Width + Side Gutters</option>
                            </select>
                            <p class="text-[10px] text-gray-400 mt-1">Controls the outer footer band that carries the widget background color.</p>
                        </div>
                        <div>
                            <label class="cz-label">Widget Holder Width</label>
                            <select class="cz-select" x-model="footerSettings.widget_inner_width_mode">
                                <option value="boxed">Boxed</option>
                                <option value="contained">Contained</option>
                                <option value="full">Full Width</option>
                                <option value="custom">Custom</option>
                            </select>
                            <p class="text-[10px] text-gray-400 mt-1">Controls the inner grid that actually holds the widgets.</p>
                        </div>
                        <div x-show="footerSettings.widget_inner_width_mode === 'custom'">
                            <label class="cz-label">Custom Holder Width</label>
                            <input type="text" class="cz-input" x-model="footerSettings.widget_inner_custom_width" placeholder="960px">
                            <p class="text-[10px] text-gray-400 mt-1">Accepts px, rem, em, vw, vh, or % values.</p>
                        </div>
                        <!-- Padding -->
                        <div>
                            <label class="cz-label">Padding Top (px)</label>
                            <input type="number" class="cz-input" x-model="footerSettings.padding_top" min="0" max="200">
                        </div>
                        <div>
                            <label class="cz-label">Padding Bottom (px)</label>
                            <input type="number" class="cz-input" x-model="footerSettings.padding_bottom" min="0" max="200">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Colors Panel -->
            <div class="cz-panel">
                <div class="cz-panel-header" @click="panels.colors = !panels.colors">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
                        Footer Colors
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="panels.colors ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="panels.colors" x-collapse class="cz-panel-body">
                    <p class="text-xs text-gray-400 mb-3">Widget area colors</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        <template x-for="c in widgetColorFields" :key="c.key">
                            <div>
                                <label class="cz-label" x-text="c.label"></label>
                                <div class="cz-color-wrap">
                                    <input type="color" class="cz-color-input" :value="footerSettings[c.key]" @input="footerSettings[c.key] = $event.target.value">
                                    <input type="text" class="cz-color-hex" :value="footerSettings[c.key]" @input="footerSettings[c.key] = $event.target.value" maxlength="9">
                                </div>
                            </div>
                        </template>
                    </div>
                    <hr class="my-4 border-gray-100">
                    <p class="text-xs text-gray-400 mb-3">Footer bar colors</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        <template x-for="c in barColorFields" :key="c.key">
                            <div>
                                <label class="cz-label" x-text="c.label"></label>
                                <div class="cz-color-wrap">
                                    <input type="color" class="cz-color-input" :value="footerSettings[c.key]" @input="footerSettings[c.key] = $event.target.value">
                                    <input type="text" class="cz-color-hex" :value="footerSettings[c.key]" @input="footerSettings[c.key] = $event.target.value" maxlength="9">
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
            </div>

            <!-- Footer Bar Panel -->
            <div class="cz-panel">
                <div class="cz-panel-header" @click="panels.bar = !panels.bar">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2"/></svg>
                        Footer Bar
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="panels.bar ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="panels.bar" x-collapse class="cz-panel-body">
                    <div class="cz-toggle-row" style="margin-bottom:0.75rem;">
                        <span class="cz-toggle-label">Show footer bar</span>
                        <button type="button" @click="footerSettings.show_footer_bar = footerSettings.show_footer_bar == 1 ? 0 : 1"
                            class="cz-toggle" :class="footerSettings.show_footer_bar == 1 ? 'cz-toggle-on' : 'cz-toggle-off'">
                            <span class="cz-toggle-knob" :class="footerSettings.show_footer_bar == 1 ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                        </button>
                    </div>
                    <div style="margin-bottom:0.75rem;">
                        <label class="cz-label">Footer Bar Width</label>
                        <select class="cz-select" x-model="footerSettings.inner_width">
                            <option value="contained">Contained</option>
                            <option value="full-width">Full Width</option>
                        </select>
                        <p class="text-[10px] text-gray-400 mt-1">Keeps the footer bar shell independent from the widget area shell.</p>
                    </div>
                    <div>
                        <label class="cz-label">Copyright Text</label>
                        <input type="text" class="cz-input" x-model="footerSettings.copyright_text" placeholder="{literal}© {current_year} {site_title}. All rights reserved.{/literal}">
                        <p class="cz-hint" style="margin-top:0.375rem;">Use <code class="bg-gray-100 px-1 py-0.5 rounded text-[10px]">{literal}{current_year}{/literal}</code> and <code class="bg-gray-100 px-1 py-0.5 rounded text-[10px]">{literal}{site_title}{/literal}</code> as merge tags</p>
                    </div>
                    <div class="cz-toggle-row" style="margin-top:0.75rem;">
                        <span class="cz-toggle-label">Show admin link</span>
                        <button type="button" @click="footerSettings.show_admin_link = footerSettings.show_admin_link == 1 ? 0 : 1"
                            class="cz-toggle" :class="footerSettings.show_admin_link == 1 ? 'cz-toggle-on' : 'cz-toggle-off'">
                            <span class="cz-toggle-knob" :class="footerSettings.show_admin_link == 1 ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Widget Areas Panel -->
            <div class="cz-panel" x-show="footerSettings.columns > 0">
                <div class="cz-panel-header" @click="panels.widgets = !panels.widgets">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                        Footer Widgets
                    </h3>
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-gray-400" x-text="footerWidgets.length + ' widget' + (footerWidgets.length !== 1 ? 's' : '')"></span>
                        <svg class="w-4 h-4 text-gray-400 transition-transform" :class="panels.widgets ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </div>
                </div>
                <div x-show="panels.widgets" x-collapse class="cz-panel-body">
                    <!-- Add Widget Button -->
                    <div class="flex items-center gap-2 mb-4">
                        <div class="relative flex-1" x-data="{ open: false }">
                            <button @click="open = !open" class="cz-btn cz-btn-primary w-full justify-center">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                                Add Widget
                            </button>
                            <div x-show="open" @click.outside="open = false" x-transition
                                 class="absolute top-full left-0 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg z-20 py-1">
                                <template x-for="wt in widgetTypes" :key="wt.type">
                                    <button @click="addWidget(wt.type); open = false"
                                            class="w-full flex items-center gap-2.5 px-3 py-2 text-sm text-left hover:bg-sky-50 transition-colors">
                                        <span class="w-6 h-6 rounded bg-gray-100 flex items-center justify-center text-xs" x-html="wt.icon"></span>
                                        <div>
                                            <div class="font-medium text-gray-800" x-text="wt.label"></div>
                                            <div class="text-[11px] text-gray-400" x-text="wt.desc"></div>
                                        </div>
                                    </button>
                                </template>
                            </div>
                        </div>
                    </div>

                    <!-- Widget Columns Grid — scrolls horizontally when column count is high -->
                    <div class="overflow-x-auto -mx-4 px-4 pb-1">
                    <div class="grid gap-3" :style="'grid-template-columns: repeat(' + footerSettings.columns + ', minmax(200px, 1fr)); min-width: ' + (footerSettings.columns * 212) + 'px'">
                        <template x-for="col in parseInt(footerSettings.columns)" :key="col">
                            <div>
                                <div class="cz-col-header">
                                    <span>Column <span x-text="col"></span></span>
                                    <span class="text-[10px] font-normal text-gray-300" x-text="widgetsInColumn(col).length + ' widgets'"></span>
                                </div>
                                <!-- Widgets in this column -->
                                <div class="space-y-2 min-h-[60px]"
                                     @dragover.prevent="$event.dataTransfer.dropEffect = 'move'"
                                     @drop.prevent="handleWidgetDrop($event, col)">
                                    <template x-for="(w, wi) in widgetsInColumn(col)" :key="w.id">
                                        <div class="cz-widget-card" draggable="true"
                                             @dragstart="$event.dataTransfer.setData('text/plain', w.id); draggedWidgetId = w.id"
                                             @dragend="draggedWidgetId = null">
                                            <div class="cz-widget-card-header" @click="toggleWidget(w.id)">
                                                <div class="flex items-center gap-2 min-w-0">
                                                    <svg class="w-3.5 h-3.5 text-gray-300 shrink-0 cursor-grab" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16"/></svg>
                                                    <span class="cz-widget-type-badge" :class="widgetBadgeClass(w.type)" x-text="widgetTypeLabel(w.type)"></span>
                                                    <span class="text-xs text-gray-600 truncate" x-text="w.props.title || '(no title)'"></span>
                                                </div>
                                                <div class="flex items-center gap-1 shrink-0">
                                                    <button @click.stop="moveWidgetUp(w.id)" class="p-1 text-gray-300 hover:text-gray-600" title="Move up">
                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/></svg>
                                                    </button>
                                                    <button @click.stop="moveWidgetDown(w.id)" class="p-1 text-gray-300 hover:text-gray-600" title="Move down">
                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                                    </button>
                                                    <button @click.stop="removeWidget(w.id)" class="p-1 text-gray-300 hover:text-red-500" title="Remove">
                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                                    </button>
                                                </div>
                                            </div>
                                            <!-- Widget edit form (collapsed by default) -->
                                            <div x-show="expandedWidgets[w.id]" x-collapse class="cz-widget-card-body">
                                                <!-- Title (shared) -->
                                                <div>
                                                    <label class="cz-label">Title</label>
                                                    <input type="text" class="cz-input" x-model="w.props.title" placeholder="Widget title">
                                                </div>
                                                <!-- Column assignment -->
                                                <div>
                                                    <label class="cz-label">Column</label>
                                                    <select class="cz-select" :value="w.area" @change="w.area = parseInt($event.target.value)">
                                                        <template x-for="c in parseInt(footerSettings.columns)" :key="c">
                                                            <option :value="c" x-text="'Column ' + c" :selected="w.area == c"></option>
                                                        </template>
                                                    </select>
                                                </div>
                                                <!-- Type-specific fields -->
                                                <template x-if="w.type === 'text'">
                                                    <div>
                                                        <label class="cz-label">Content</label>
                                                        <textarea class="cz-input" rows="4" x-model="w.props.content" placeholder="Enter text content…"></textarea>
                                                        <p class="text-[10px] text-gray-400 mt-1">HTML allowed for basic formatting</p>
                                                    </div>
                                                </template>
                                                <template x-if="w.type === 'custom_html'">
                                                    <div>
                                                        <label class="cz-label">HTML Content</label>
                                                        <textarea class="cz-input font-mono text-xs" rows="6" x-model="w.props.content" placeholder="<div>Your custom HTML…</div>"></textarea>
                                                    </div>
                                                </template>
                                                <template x-if="w.type === 'nav_menu'">
                                                    <div>
                                                        <label class="cz-label">Select Menu</label>
                                                        <select class="cz-select" x-model="w.props.menu_id">
                                                            <option value="0">— Select a menu —</option>
                                                            <template x-for="m in availableMenus" :key="m.id">
                                                                <option :value="m.id" x-text="m.name + (m.location ? ' (' + m.location + ')' : '')" :selected="w.props.menu_id == m.id"></option>
                                                            </template>
                                                        </select>
                                                    </div>
                                                </template>
                                                <template x-if="w.type === 'recent_posts'">
                                                    <div>
                                                        <label class="cz-label">Number of Posts</label>
                                                        <input type="number" class="cz-input" x-model="w.props.count" min="1" max="10" placeholder="5">
                                                    </div>
                                                </template>
                                                <template x-if="w.type === 'social_links'">
                                                    <div>
                                                        <p class="text-xs text-gray-500">Social links are pulled from your <a href="{base_url}/cms/admin/settings" class="text-sky-600 underline">CMS Settings</a> automatically.</p>
                                                    </div>
                                                </template>
                                                <template x-if="w.type === 'contact_info'">
                                                    <div class="space-y-3">
                                                        <div>
                                                            <label class="cz-label">Address</label>
                                                            <textarea class="cz-input" rows="2" x-model="w.props.address" placeholder="123 Main St, City"></textarea>
                                                        </div>
                                                        <div>
                                                            <label class="cz-label">Phone</label>
                                                            <input type="text" class="cz-input" x-model="w.props.phone" placeholder="+1 (555) 123-4567">
                                                        </div>
                                                        <div>
                                                            <label class="cz-label">Email</label>
                                                            <input type="email" class="cz-input" x-model="w.props.email" placeholder="info@example.com">
                                                        </div>
                                                    </div>
                                                </template>
                                            </div>
                                        </div>
                                    </template>
                                    <!-- Empty state -->
                                    <div x-show="widgetsInColumn(col).length === 0" class="cz-empty-col">
                                        <svg class="w-6 h-6 mx-auto mb-1 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2"/></svg>
                                        Drop widgets here<br>or use Add Widget above
                                    </div>
                                </div>
                            </div>
                        </template>
                    </div>
                    </div><!-- /overflow-x-auto -->
                </div>
            </div>
        </div>
        <div class="xl:col-span-4 space-y-4 cz-preview-column">
            <div class="sticky top-4">
                <div class="cz-panel">
                    <div class="cz-panel-header">
                        <h3>
                            <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            Preview
                        </h3>
                    </div>
                    <div class="p-3">
                        <div class="cz-preview-frame" :style="'background:' + footerSettings.bg_color">
                            <div class="px-4 pt-3 pb-2 flex flex-wrap gap-1.5 text-[10px] text-gray-500">
                                <span class="inline-flex items-center rounded-full bg-white/80 px-2 py-1">Widgets: <span class="ml-1 font-medium text-gray-700" x-text="footerPreviewWidgetContainerLabel() + ' / ' + footerPreviewWidgetHolderLabel()"></span></span>
                                <span class="inline-flex items-center rounded-full bg-white/80 px-2 py-1">Bar: <span class="ml-1 font-medium text-gray-700" x-text="footerPreviewFooterBarLabel()"></span></span>
                            </div>
                            <!-- Widget Preview -->
                            <div x-show="footerSettings.columns > 0 && footerWidgets.length > 0"
                                 :style="footerPreviewWidgetContainerStyle()">
                                <div :style="footerPreviewWidgetHolderStyle()">
                                    <div class="grid gap-3" :style="'grid-template-columns: repeat(' + footerSettings.columns + ', 1fr)'">
                                        <template x-for="col in parseInt(footerSettings.columns)" :key="col">
                                            <div class="min-w-0">
                                                <template x-for="w in widgetsInColumn(col)" :key="w.id">
                                                    <div class="mb-3">
                                                        <div x-show="w.props.title" class="text-xs font-semibold mb-1" :style="'color:' + footerSettings.title_color" x-text="w.props.title"></div>
                                                        <div class="text-[10px] leading-relaxed" :style="'color:' + footerSettings.text_color">
                                                            <span x-show="w.type === 'text'" x-html="(w.props.content || '<em>Text content…</em>').substring(0, 120)"></span>
                                                            <span x-show="w.type === 'custom_html'" class="text-gray-400">&lt;HTML&gt;</span>
                                                            <span x-show="w.type === 'nav_menu'" class="text-gray-400">☰ Menu</span>
                                                            <span x-show="w.type === 'recent_posts'" class="text-gray-400">📄 Recent Posts</span>
                                                            <span x-show="w.type === 'social_links'" class="text-gray-400">🔗 Social</span>
                                                            <span x-show="w.type === 'contact_info'" class="text-gray-400">📍 Contact</span>
                                                        </div>
                                                    </div>
                                                </template>
                                                <div x-show="widgetsInColumn(col).length === 0" class="text-[10px] text-gray-500 opacity-40">Empty</div>
                                            </div>
                                        </template>
                                    </div>
                                </div>
                            </div>
                            <!-- No widgets state -->
                            <div x-show="footerSettings.columns === 0 || footerWidgets.length === 0"
                                 class="py-6 text-center text-xs text-gray-500">
                                <span x-show="footerSettings.columns === 0">Footer widgets disabled</span>
                                <span x-show="footerSettings.columns > 0 && footerWidgets.length === 0">No widgets added yet</span>
                            </div>
                            <!-- Footer bar preview -->
                            <div x-show="footerSettings.show_footer_bar == 1"
                                 class="py-2 px-4 text-center text-[10px]"
                                 :style="'background:' + footerSettings.bar_bg_color + ';color:' + footerSettings.bar_text_color">
                                <div :style="footerPreviewFooterBarInnerStyle()">
                                    <span x-text="previewCopyright()"></span>
                                    <span x-show="footerSettings.show_admin_link == 1" :style="'color:' + footerSettings.bar_link_color"> · Admin</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Widget type reference -->
                <div class="mt-4 cz-panel">
                    <div class="cz-panel-header" @click="panels.help = !panels.help">
                        <h3 class="text-xs">
                            <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            Widget Types
                        </h3>
                        <svg class="w-3.5 h-3.5 text-gray-400 transition-transform" :class="panels.help ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </div>
                    <div x-show="panels.help" x-collapse class="px-4 py-3">
                        <div class="space-y-2">
                            <template x-for="wt in widgetTypes" :key="wt.type">
                                <div class="flex items-start gap-2">
                                    <span class="w-5 h-5 rounded bg-gray-100 flex items-center justify-center text-[10px] shrink-0 mt-0.5" x-html="wt.icon"></span>
                                    <div>
                                        <div class="text-xs font-medium text-gray-700" x-text="wt.label"></div>
                                        <div class="text-[10px] text-gray-400" x-text="wt.desc"></div>
                                    </div>
                                </div>
                            </template>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════ Sidebar Tab Content ═══════════════════ -->
    <div x-show="activeTab === 'sidebar'" class="grid grid-cols-1 xl:grid-cols-12 gap-6 cz-tab-grid">
        <div class="xl:col-span-8 space-y-5">
            <div class="cz-panel">
                <div class="cz-panel-header" @click="sPanels.layout = !sPanels.layout">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h18a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm6 0v14"/></svg>
                        Sidebar Settings
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="sPanels.layout ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="sPanels.layout" x-collapse class="cz-panel-body">
                    <div class="cz-toggle-row" style="margin-bottom:0.75rem;">
                        <span class="cz-toggle-label">Enable sidebar</span>
                        <button type="button" @click="sidebarSettings.enabled = sidebarSettings.enabled == 1 ? 0 : 1"
                            class="cz-toggle" :class="sidebarSettings.enabled == 1 ? 'cz-toggle-on' : 'cz-toggle-off'">
                            <span class="cz-toggle-knob" :class="sidebarSettings.enabled == 1 ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                        </button>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="cz-label">Apply Scope</label>
                            <select class="cz-select" x-model="sidebarSettings.scope_mode" @change="sidebarNormalizeTemplateRules()">
                                <option value="general">All route targets</option>
                                <option value="exclude_templates">All except selected targets</option>
                                <option value="template">Only selected targets</option>
                            </select>
                        </div>
                        <div x-show="sidebarSettings.scope_mode !== 'general'" class="sm:col-span-2">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <label class="cz-label" x-text="sidebarSettings.scope_mode === 'exclude_templates' ? 'Excluded Targets' : 'Included Targets'"></label>
                                    <p class="text-[10px] text-gray-400 mt-1" x-text="sidebarSettings.scope_mode === 'exclude_templates' ? 'The sidebar will stay visible everywhere except the route targets selected below.' : 'The sidebar will render only on the route targets selected below.'"></p>
                                </div>
                                <span class="text-[10px] font-medium text-gray-500" x-text="sidebarSelectedTemplateCountLabel()"></span>
                            </div>
                            <div class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-52 overflow-auto pr-1">
                                <template x-for="t in availableSidebarTemplates" :key="t.key">
                                    <label class="flex items-center gap-3 rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700 hover:border-sky-300 hover:bg-sky-50 transition-colors cursor-pointer">
                                        <input type="checkbox" class="rounded border-gray-300 text-sky-600 focus:ring-sky-500" :checked="sidebarTemplateRuleChecked(t.key)" @change="toggleSidebarTemplateRule(t.key)">
                                        <span class="flex-1" x-text="t.label"></span>
                                    </label>
                                </template>
                            </div>
                            <p class="text-[10px] text-gray-400 mt-1">Uses route-aware sidebar targets for the current workspace.</p>
                            <p x-show="sidebarTemplateFileExists" class="text-[10px] text-emerald-600 mt-1">Active theme includes `public/sidebar.disyl` override.</p>
                        </div>
                        <div>
                            <label class="cz-label">Placement</label>
                            <select class="cz-select" x-model="sidebarSettings.placement">
                                <option value="right">Right</option>
                                <option value="left">Left</option>
                            </select>
                        </div>
                        <div>
                            <label class="cz-label">Width (px)</label>
                            <input type="number" class="cz-input" x-model="sidebarSettings.width" min="220" max="420" step="10">
                        </div>
                        <div>
                            <label class="cz-label">Content Gap (px)</label>
                            <input type="number" class="cz-input" x-model="sidebarSettings.gap" min="16" max="64" step="4">
                        </div>
                    </div>
                    <div class="cz-toggle-row" style="margin-top:0.75rem;">
                        <span class="cz-toggle-label">Sticky sidebar on desktop</span>
                        <button type="button" @click="sidebarSettings.sticky = sidebarSettings.sticky == 1 ? 0 : 1"
                            class="cz-toggle" :class="sidebarSettings.sticky == 1 ? 'cz-toggle-on' : 'cz-toggle-off'">
                            <span class="cz-toggle-knob" :class="sidebarSettings.sticky == 1 ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="cz-panel">
                <div class="cz-panel-header" @click="sPanels.appearance = !sPanels.appearance">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343"/></svg>
                        Widget Appearance
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="sPanels.appearance ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="sPanels.appearance" x-collapse class="cz-panel-body">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        <template x-for="c in sidebarColorFields" :key="c.key">
                            <div>
                                <label class="cz-label" x-text="c.label"></label>
                                <div class="cz-color-wrap">
                                    <input type="color" class="cz-color-input" :value="sidebarSettings[c.key]" @input="sidebarSettings[c.key] = $event.target.value">
                                    <input type="text" class="cz-color-hex" :value="sidebarSettings[c.key]" @input="sidebarSettings[c.key] = $event.target.value" maxlength="9">
                                </div>
                            </div>
                        </template>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
                        <div>
                            <label class="cz-label">Widget Padding (px)</label>
                            <input type="number" class="cz-input" x-model="sidebarSettings.widget_padding" min="8" max="36" step="2">
                        </div>
                        <div>
                            <label class="cz-label">Widget Radius (px)</label>
                            <input type="number" class="cz-input" x-model="sidebarSettings.widget_radius" min="0" max="24" step="1">
                        </div>
                    </div>
                </div>
            </div>

            <div class="cz-panel">
                <div class="cz-panel-header" @click="sPanels.widgets = !sPanels.widgets">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2"/></svg>
                        Sidebar Widgets
                    </h3>
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-gray-400" x-text="sidebarWidgets.length + ' widget' + (sidebarWidgets.length !== 1 ? 's' : '')"></span>
                        <svg class="w-4 h-4 text-gray-400 transition-transform" :class="sPanels.widgets ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </div>
                </div>
                <div x-show="sPanels.widgets" x-collapse class="cz-panel-body">
                    <div class="mb-4" x-data="{ open: false }">
                        <button @click="open = !open"
                                class="cz-btn w-full justify-between"
                                :class="open ? 'cz-btn-primary' : 'cz-btn-secondary'">
                            <span class="flex items-center gap-1.5">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                                Add Widget
                            </span>
                            <svg class="w-3.5 h-3.5 transition-transform" :class="open ? 'rotate-45' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        </button>
                        <div x-show="open" x-collapse>
                            <div class="mt-2 rounded-lg border border-gray-200 bg-gray-50 p-2 grid grid-cols-2 gap-1.5">
                                <template x-for="wt in sidebarWidgetTypes" :key="wt.type">
                                    <button @click="addSidebarWidget(wt.type); open = false"
                                            class="flex items-center gap-2 px-2.5 py-2 text-left text-sm rounded-md bg-white border border-gray-100 hover:border-sky-300 hover:bg-sky-50 hover:shadow-sm transition-all">
                                        <span class="w-7 h-7 rounded-md bg-gray-50 border border-gray-100 flex items-center justify-center text-base shrink-0" x-html="wt.icon"></span>
                                        <div class="min-w-0">
                                            <div class="font-medium text-gray-800 text-xs leading-tight" x-text="wt.label"></div>
                                            <div class="text-[10px] text-gray-400 leading-tight mt-0.5 truncate" x-text="wt.desc"></div>
                                        </div>
                                    </button>
                                </template>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <template x-for="(w, wi) in sidebarWidgets" :key="w.id">
                            <div class="cz-widget-card">
                                <div class="cz-widget-card-header" @click="toggleSidebarWidget(w.id)">
                                    <div class="flex items-center gap-2 min-w-0">
                                        <span class="cz-widget-type-badge" :class="sidebarWidgetBadgeClass(w.type)" x-text="sidebarWidgetTypeLabel(w.type)"></span>
                                        <span class="text-xs text-gray-600 truncate" x-text="w.props.title || '(no title)'"></span>
                                    </div>
                                    <div class="flex items-center gap-1 shrink-0">
                                        <button @click.stop="moveSidebarWidgetUp(wi)" :disabled="wi===0" class="p-1 text-gray-300 hover:text-gray-600 disabled:opacity-30" title="Move up">↑</button>
                                        <button @click.stop="moveSidebarWidgetDown(wi)" :disabled="wi===sidebarWidgets.length-1" class="p-1 text-gray-300 hover:text-gray-600 disabled:opacity-30" title="Move down">↓</button>
                                        <button @click.stop="removeSidebarWidget(w.id)" class="p-1 text-gray-300 hover:text-red-500" title="Remove">✕</button>
                                    </div>
                                </div>
                                <div x-show="expandedSidebarWidgets[w.id]" x-collapse class="cz-widget-card-body">
                                    <div>
                                        <label class="cz-label">Title</label>
                                        <input type="text" class="cz-input" x-model="w.props.title" placeholder="Widget title">
                                    </div>
                                    <template x-if="w.type === 'text'">
                                        <div><label class="cz-label">Content</label><textarea class="cz-input" rows="4" x-model="w.props.content"></textarea></div>
                                    </template>
                                    <template x-if="w.type === 'custom_html'">
                                        <div><label class="cz-label">HTML Content</label><textarea class="cz-input font-mono text-xs" rows="6" x-model="w.props.content"></textarea></div>
                                    </template>
                                    <template x-if="w.type === 'nav_menu'">
                                        <div>
                                            <label class="cz-label">Select Menu</label>
                                            <select class="cz-select" x-model="w.props.menu_id">
                                                <option value="0">— Select a menu —</option>
                                                <template x-for="m in availableMenus" :key="m.id">
                                                    <option :value="m.id" x-text="m.name + (m.location ? ' (' + m.location + ')' : '')"></option>
                                                </template>
                                            </select>
                                        </div>
                                    </template>
                                    <template x-if="w.type === 'recent_posts'">
                                        <div><label class="cz-label">Number of Posts</label><input type="number" class="cz-input" x-model="w.props.count" min="1" max="10"></div>
                                    </template>
                                    <template x-if="w.type === 'search_box'">
                                        <div class="space-y-3">
                                            <div><label class="cz-label">Placeholder</label><input type="text" class="cz-input" x-model="w.props.placeholder" placeholder="Search…"></div>
                                            <div><label class="cz-label">Button Label</label><input type="text" class="cz-input" x-model="w.props.button_label" placeholder="Search"></div>
                                        </div>
                                    </template>
                                    <template x-if="w.type === 'categories'">
                                        <div class="space-y-3">
                                            <div><label class="cz-label">Max Categories</label><input type="number" class="cz-input" x-model="w.props.count" min="1" max="30"></div>
                                            <label class="inline-flex items-center gap-2 text-xs text-gray-600"><input type="checkbox" x-model="w.props.show_count"> Show post counts</label>
                                        </div>
                                    </template>
                                    <template x-if="w.type === 'tag_cloud'">
                                        <div class="space-y-3">
                                            <div><label class="cz-label">Max Tags</label><input type="number" class="cz-input" x-model="w.props.count" min="1" max="60"></div>
                                        </div>
                                    </template>
                                    <template x-if="w.type === 'archives'">
                                        <div class="space-y-3">
                                            <div><label class="cz-label">Months to Show</label><input type="number" class="cz-input" x-model="w.props.count" min="1" max="36"></div>
                                            <label class="inline-flex items-center gap-2 text-xs text-gray-600"><input type="checkbox" x-model="w.props.show_count"> Show post counts</label>
                                        </div>
                                    </template>
                                    <template x-if="w.type === 'cta_button'">
                                        <div class="space-y-3">
                                            <div><label class="cz-label">Button Text</label><input type="text" class="cz-input" x-model="w.props.text" placeholder="Learn More"></div>
                                            <div><label class="cz-label">Button URL</label><input type="text" class="cz-input" x-model="w.props.url" placeholder="/contact"></div>
                                            <label class="inline-flex items-center gap-2 text-xs text-gray-600"><input type="checkbox" x-model="w.props.new_tab"> Open in new tab</label>
                                        </div>
                                    </template>
                                    <template x-if="w.type === 'contact_info'">
                                        <div class="space-y-3">
                                            <div><label class="cz-label">Address</label><textarea class="cz-input" rows="2" x-model="w.props.address"></textarea></div>
                                            <div><label class="cz-label">Phone</label><input type="text" class="cz-input" x-model="w.props.phone"></div>
                                            <div><label class="cz-label">Email</label><input type="email" class="cz-input" x-model="w.props.email"></div>
                                        </div>
                                    </template>
                                </div>
                            </div>
                        </template>
                        <div x-show="sidebarWidgets.length === 0" class="text-center py-4 text-xs text-gray-400">No sidebar widgets yet</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="xl:col-span-4 cz-preview-column">
            <div class="sticky top-4 cz-panel">
                <div class="cz-panel-header"><h3>Sidebar Preview</h3></div>
                <div class="p-3">
                    <div x-show="customizerScope !== 'ecommerce'" class="border border-gray-200 rounded-lg p-3" :style="'background:' + sidebarSettings.widget_bg_color + ';border-color:' + sidebarSettings.widget_border_color">
                        <div class="text-xs font-semibold mb-2" :style="'color:' + sidebarSettings.widget_title_color">Sample Widget</div>
                        <div class="text-[11px]" :style="'color:' + sidebarSettings.widget_text_color">Sidebar will appear on <span x-text="sidebarScopeSummary()"></span> and on the <span x-text="sidebarSettings.placement"></span> side.</div>
                    </div>
                    <div x-show="customizerScope === 'ecommerce'" class="space-y-3">
                        <div class="rounded-lg border border-gray-200 bg-white p-3">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-[10px] font-semibold uppercase tracking-[0.14em] text-gray-400">Entity + Rail Preview</span>
                                <span class="text-[10px] text-amber-700">Storefront scope</span>
                            </div>
                            <div :style="entityPreviewSidebarLayoutStyle()">
                                <div class="space-y-3">
                                    <div :style="entityPreviewHeroStyle()">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                    </div>
                                    <div class="space-y-2">
                                        <div class="h-3 bg-slate-800 rounded w-2/3"></div>
                                        <div class="space-y-1.5">
                                            <div class="h-1 bg-gray-200 rounded w-full"></div>
                                            <div class="h-1 bg-gray-200 rounded w-5/6"></div>
                                        </div>
                                        <div x-show="entityPresentationSettings.entity_layout_profile === 'commerce'" :style="entityPreviewSummaryStyle()">
                                            <div class="text-[10px] uppercase tracking-[0.16em] text-gray-400 mb-2">Summary Rail</div>
                                            <div class="flex items-end gap-2 mb-2">
                                                <span class="text-base font-bold" :style="'color:' + (colorsSettings.storefront_price_color || '#0f172a')">USD 79.00</span>
                                                <span class="text-xs line-through text-gray-400">99.00</span>
                                            </div>
                                            <div class="flex flex-col gap-2">
                                                <span :style="entityPreviewPrimaryActionStyle()">Add to Cart</span>
                                                <span :style="entityPreviewSecondaryActionStyle()">Inquire</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div x-show="sidebarSettings.enabled == 1" :style="entityPreviewSidebarRailStyle()" class="space-y-2">
                                    <div class="text-xs font-semibold" :style="'color:' + sidebarSettings.widget_title_color">Merchandising Rail</div>
                                    <div class="text-[11px]" :style="'color:' + sidebarSettings.widget_text_color">Placement: <span class="font-medium capitalize" x-text="sidebarSettings.placement"></span></div>
                                    <div class="text-[11px]" :style="'color:' + sidebarSettings.widget_text_color">Scope: <span class="font-medium" x-text="sidebarScopeSummary()"></span></div>
                                    <div class="inline-flex items-center rounded-full px-2.5 py-1 text-[10px] font-semibold" :style="entityPreviewInventoryStyle('ok')">Sticky: <span class="ml-1" x-text="sidebarSettings.sticky == 1 ? 'On' : 'Off'"></span></div>
                                </div>
                            </div>
                            <div x-show="sidebarSettings.enabled != 1" class="mt-3 text-[10px] text-gray-400">Sidebar remains isolated from the storefront until enabled here.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════ Header Tab Content ═══════════════════ -->
    <div x-show="activeTab === 'header'" class="grid grid-cols-1 xl:grid-cols-12 gap-6 cz-tab-grid">
        <!-- Left Column: Header settings -->
        <div class="xl:col-span-8 space-y-5">

            <!-- Layout Panel -->
            <div class="cz-panel">
                <div class="cz-panel-header" @click="hPanels.layout = !hPanels.layout">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5z"/></svg>
                        Header Layout
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="hPanels.layout ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="hPanels.layout" x-collapse class="cz-panel-body">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        <!-- Layout type -->
                        <div>
                            <label class="cz-label">Layout Style</label>
                            <select class="cz-select" x-model="headerSettings.layout">
                                <option value="default">Default (Logo left, nav right)</option>
                                <option value="centered">Centered (Logo center)</option>
                                <option value="logo-left-menu-right">Logo Left / Menu Right</option>
                            </select>
                        </div>
                        <!-- Main header outer band -->
                        <div>
                            <label class="cz-label">Header Container</label>
                            <select class="cz-select" x-model="headerSettings.header_container_width">
                                <option value="contained">Contained</option>
                                <option value="full">Full Width + Side Gutters</option>
                            </select>
                            <p class="text-[10px] text-gray-400 mt-1">Controls the outer header band that carries the header background and border.</p>
                        </div>
                        <!-- Main header holder -->
                        <div>
                            <label class="cz-label">Header Holder Width</label>
                            <select class="cz-select" x-model="headerSettings.header_inner_width_mode">
                                <option value="boxed">Boxed</option>
                                <option value="contained">Contained</option>
                                <option value="full">Full Width</option>
                                <option value="custom">Custom</option>
                            </select>
                            <p class="text-[10px] text-gray-400 mt-1">Controls the inner row that holds branding, navigation, search, and CTA content.</p>
                        </div>
                        <div x-show="headerSettings.header_inner_width_mode === 'custom'">
                            <label class="cz-label">Custom Header Holder Width</label>
                            <input type="text" class="cz-input" x-model="headerSettings.header_inner_custom_width" placeholder="960px">
                            <p class="text-[10px] text-gray-400 mt-1">Accepts px, rem, em, vw, vh, or % values.</p>
                        </div>
                        <!-- Height mode -->
                        <div>
                            <label class="cz-label">Header Height</label>
                            <select class="cz-select" x-model="headerSettings.height" @change="if ($event.target.value !== 'auto' && isNaN($event.target.value)) headerSettings.height = '64'">
                                <option value="auto">Auto (dynamic)</option>
                                <option value="56">56px (compact)</option>
                                <option value="64">64px (default)</option>
                                <option value="72">72px</option>
                                <option value="80">80px</option>
                                <option value="96">96px (tall)</option>
                                <option value="120">120px (extra tall)</option>
                            </select>
                            <p class="text-[10px] text-gray-400 mt-1">Auto adapts to content + padding</p>
                        </div>
                        <!-- Menu location -->
                        <div>
                            <label class="cz-label">Menu Location</label>
                            <select class="cz-select" x-model="headerSettings.menu_location">
                                <template x-for="m in availableMenus" :key="m.location">
                                    <option :value="m.location" x-text="m.name + ' (' + m.location + ')'"></option>
                                </template>
                            </select>
                        </div>
                    </div>
                    <!-- Toggles -->
                    <div class="mt-4 space-y-3">
                        <div class="cz-toggle-row">
                            <span class="cz-toggle-label">Sticky header (fixed on scroll)</span>
                            <button type="button" @click="headerSettings.sticky = headerSettings.sticky == 1 ? 0 : 1"
                                class="cz-toggle" :class="headerSettings.sticky == 1 ? 'cz-toggle-on' : 'cz-toggle-off'">
                                <span class="cz-toggle-knob" :class="headerSettings.sticky == 1 ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                            </button>
                        </div>
                        <div class="cz-toggle-row">
                            <span class="cz-toggle-label">Show site tagline</span>
                            <button type="button" @click="headerSettings.show_tagline = headerSettings.show_tagline == 1 ? 0 : 1"
                                class="cz-toggle" :class="headerSettings.show_tagline == 1 ? 'cz-toggle-on' : 'cz-toggle-off'">
                                <span class="cz-toggle-knob" :class="headerSettings.show_tagline == 1 ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                            </button>
                        </div>
                        <div class="cz-toggle-row">
                            <span class="cz-toggle-label">Show search icon</span>
                            <button type="button" @click="headerSettings.show_search = headerSettings.show_search == 1 ? 0 : 1"
                                class="cz-toggle" :class="headerSettings.show_search == 1 ? 'cz-toggle-on' : 'cz-toggle-off'">
                                <span class="cz-toggle-knob" :class="headerSettings.show_search == 1 ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                            </button>
                        </div>
                    </div>
                    <!-- Padding -->
                    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="cz-label">Padding Top (px)</label>
                            <input type="number" class="cz-input" x-model="headerSettings.padding_top" min="0" max="80" step="4">
                        </div>
                        <div>
                            <label class="cz-label">Padding Bottom (px)</label>
                            <input type="number" class="cz-input" x-model="headerSettings.padding_bottom" min="0" max="80" step="4">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Branding Panel (Logo & Favicon) -->
            <div class="cz-panel">
                <div class="cz-panel-header" @click="hPanels.branding = !hPanels.branding">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        Branding (Logo &amp; Favicon)
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="hPanels.branding ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="hPanels.branding" x-collapse class="cz-panel-body">
                    <!-- Logo Image Upload -->
                    <div class="mb-5">
                        <label class="cz-label">Logo Image</label>
                        <p class="text-[10px] text-gray-400 mb-2">Upload an image logo. If empty, the site title text is used.</p>
                        <div x-show="headerSettings.logo_image_url" class="mb-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
                            <div class="flex items-center gap-3">
                                <img :src="headerSettings.logo_image_url" alt="Logo preview" class="h-10 max-w-[160px] object-contain bg-white rounded border p-1">
                                <div class="flex-1 min-w-0">
                                    <p class="text-xs text-gray-500 truncate" x-text="headerSettings.logo_image_url"></p>
                                </div>
                                <button type="button" @click="headerSettings.logo_image_url = ''" class="text-red-400 hover:text-red-600 text-xs font-medium flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    Remove
                                </button>
                            </div>
                        </div>
                        <div x-show="!headerSettings.logo_image_url">
                            <label class="flex flex-col items-center justify-center w-full h-24 border-2 border-gray-200 border-dashed rounded-lg cursor-pointer hover:bg-gray-50 transition-colors">
                                <div class="flex flex-col items-center justify-center pt-2 pb-3">
                                    <svg class="w-6 h-6 mb-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                                    <p class="text-xs text-gray-500">Click to upload logo</p>
                                    <p class="text-[10px] text-gray-400">PNG, JPG, SVG, WebP</p>
                                </div>
                                <input type="file" class="hidden" accept="image/*" @change="uploadHeaderImage($event, 'logo_image_url')">
                            </label>
                        </div>
                    </div>
                    <!-- Logo Max Height -->
                    <div class="mb-5">
                        <label class="cz-label">Logo Max Height</label>
                        <div class="cz-range-row">
                            <input type="range" x-model="headerSettings.logo_max_height" min="16" max="120" step="2">
                            <span class="cz-range-value" x-text="(headerSettings.logo_max_height || '40') + 'px'"></span>
                        </div>
                    </div>
                    <hr class="my-4 border-gray-100">
                    <!-- Favicon Upload -->
                    <div>
                        <label class="cz-label">Favicon</label>
                        <p class="text-[10px] text-gray-400 mb-2">Browser tab icon. Recommended: 32x32px PNG or ICO.</p>
                        <div x-show="headerSettings.favicon_url" class="mb-3 p-3 bg-gray-50 rounded-lg border border-gray-200">
                            <div class="flex items-center gap-3">
                                <img :src="headerSettings.favicon_url" alt="Favicon preview" class="w-8 h-8 object-contain bg-white rounded border p-0.5">
                                <div class="flex-1 min-w-0">
                                    <p class="text-xs text-gray-500 truncate" x-text="headerSettings.favicon_url"></p>
                                </div>
                                <button type="button" @click="headerSettings.favicon_url = ''" class="text-red-400 hover:text-red-600 text-xs font-medium flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    Remove
                                </button>
                            </div>
                        </div>
                        <div x-show="!headerSettings.favicon_url">
                            <label class="flex flex-col items-center justify-center w-full h-20 border-2 border-gray-200 border-dashed rounded-lg cursor-pointer hover:bg-gray-50 transition-colors">
                                <div class="flex flex-col items-center justify-center pt-2 pb-3">
                                    <svg class="w-5 h-5 mb-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                                    <p class="text-xs text-gray-500">Click to upload favicon</p>
                                </div>
                                <input type="file" class="hidden" accept="image/png,image/x-icon,image/svg+xml" @change="uploadHeaderImage($event, 'favicon_url')">
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CTA Button Panel -->
            <div class="cz-panel">
                <div class="cz-panel-header" @click="hPanels.cta = !hPanels.cta">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                        CTA Button
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="hPanels.cta ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="hPanels.cta" x-collapse class="cz-panel-body">
                    <div class="cz-toggle-row" style="margin-bottom:0.75rem;">
                        <span class="cz-toggle-label">Show CTA button in header</span>
                        <button type="button" @click="headerSettings.show_cta_button = headerSettings.show_cta_button == 1 ? 0 : 1"
                            class="cz-toggle" :class="headerSettings.show_cta_button == 1 ? 'cz-toggle-on' : 'cz-toggle-off'">
                            <span class="cz-toggle-knob" :class="headerSettings.show_cta_button == 1 ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                        </button>
                    </div>
                    <div x-show="headerSettings.show_cta_button == 1" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="cz-label">Button Text</label>
                            <input type="text" class="cz-input" x-model="headerSettings.cta_text" placeholder="Get Started">
                        </div>
                        <div>
                            <label class="cz-label">Button URL</label>
                            <input type="text" class="cz-input" x-model="headerSettings.cta_url" placeholder="/contact">
                        </div>
                        <div>
                            <label class="cz-label">Button Style</label>
                            <select class="cz-select" x-model="headerSettings.cta_style">
                                <option value="primary">Primary (filled)</option>
                                <option value="secondary">Secondary</option>
                                <option value="outline">Outline</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Colors Panel -->
            <div class="cz-panel">
                <div class="cz-panel-header" @click="hPanels.colors = !hPanels.colors">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
                        Header Colors
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="hPanels.colors ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="hPanels.colors" x-collapse class="cz-panel-body">
                    <p class="text-xs text-gray-400 mb-3">Main header colors</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        <template x-for="c in headerColorFields" :key="c.key">
                            <div>
                                <label class="cz-label" x-text="c.label"></label>
                                <div class="cz-color-wrap">
                                    <input type="color" class="cz-color-input" :value="headerSettings[c.key]" @input="headerSettings[c.key] = $event.target.value">
                                    <input type="text" class="cz-color-hex" :value="headerSettings[c.key]" @input="headerSettings[c.key] = $event.target.value" maxlength="9">
                                </div>
                            </div>
                        </template>
                    </div>
                    <hr class="my-4 border-gray-100">
                    <p class="text-xs text-gray-400 mb-3">Mobile menu colors</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        <template x-for="c in headerMobileColorFields" :key="c.key">
                            <div>
                                <label class="cz-label" x-text="c.label"></label>
                                <div class="cz-color-wrap">
                                    <input type="color" class="cz-color-input" :value="headerSettings[c.key]" @input="headerSettings[c.key] = $event.target.value">
                                    <input type="text" class="cz-color-hex" :value="headerSettings[c.key]" @input="headerSettings[c.key] = $event.target.value" maxlength="9">
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
            </div>

            <!-- Dropdown Menu Panel -->
            <div class="cz-panel">
                <div class="cz-panel-header" @click="hPanels.dropdown = !hPanels.dropdown">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9l-5-5-5 5m10 6l-5 5-5-5"/></svg>
                        Dropdown Menu
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="hPanels.dropdown ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="hPanels.dropdown" x-collapse class="cz-panel-body">
                    <p class="text-xs text-gray-400 mb-3">Style child menu dropdowns for desktop navigation.</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        <template x-for="c in headerDropdownColorFields" :key="c.key">
                            <div>
                                <label class="cz-label" x-text="c.label"></label>
                                <div class="cz-color-wrap">
                                    <input type="color" class="cz-color-input" :value="headerSettings[c.key]" @input="headerSettings[c.key] = $event.target.value">
                                    <input type="text" class="cz-color-hex" :value="headerSettings[c.key]" @input="headerSettings[c.key] = $event.target.value" maxlength="9">
                                </div>
                            </div>
                        </template>
                    </div>
                    <hr class="my-4 border-gray-100">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label class="cz-label">Dropdown Min Width (px)</label>
                            <input type="number" class="cz-input" x-model="headerSettings.dropdown_min_width" min="160" max="420" step="10">
                        </div>
                        <div>
                            <label class="cz-label">Dropdown Radius (px)</label>
                            <input type="number" class="cz-input" x-model="headerSettings.dropdown_radius" min="0" max="20" step="1">
                            <p class="text-[10px] text-gray-400 mt-1">Set <strong>0</strong> to remove border radius (square corners).</p>
                        </div>
                        <div>
                            <label class="cz-label">Item Padding Y (px)</label>
                            <input type="number" class="cz-input" x-model="headerSettings.dropdown_item_padding_y" min="6" max="20" step="1">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Header Transparency Panel -->
            <div class="cz-panel">
                <div class="cz-panel-header" @click="hPanels.transparent = !hPanels.transparent">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        Header Transparency
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="hPanels.transparent ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="hPanels.transparent" x-collapse class="cz-panel-body">
                    <div class="cz-toggle-row" style="margin-bottom:0.75rem;">
                        <span class="cz-toggle-label">Enable header transparency</span>
                        <button type="button" @click="headerSettings.transparent_home = headerSettings.transparent_home == 1 ? 0 : 1"
                            class="cz-toggle" :class="headerSettings.transparent_home == 1 ? 'cz-toggle-on' : 'cz-toggle-off'">
                            <span class="cz-toggle-knob" :class="headerSettings.transparent_home == 1 ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                        </button>
                    </div>
                    <p class="cz-hint" style="margin-bottom:0.75rem;">Uses your header background color with adjustable opacity. Becomes fully solid when you scroll past the hero area. Works on all pages.</p>
                    <div x-show="headerSettings.transparent_home == 1">
                        <div class="cz-range-row" style="margin-bottom:1rem;">
                            <label class="cz-label" style="margin-bottom:0;flex-shrink:0;">Background Opacity</label>
                            <input type="range" min="0" max="100" step="1" x-model="headerSettings.header_bg_opacity">
                            <span class="cz-range-value" x-text="headerSettings.header_bg_opacity + '%'"></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="cz-label">Text Color</label>
                                <div class="cz-color-wrap">
                                    <input type="color" class="cz-color-input" :value="headerSettings.transparent_text_color" @input="headerSettings.transparent_text_color = $event.target.value">
                                    <input type="text" class="cz-color-hex" :value="headerSettings.transparent_text_color" @input="headerSettings.transparent_text_color = $event.target.value" maxlength="9">
                                </div>
                            </div>
                            <div>
                                <label class="cz-label">Logo Color</label>
                                <div class="cz-color-wrap">
                                    <input type="color" class="cz-color-input" :value="headerSettings.transparent_logo_color" @input="headerSettings.transparent_logo_color = $event.target.value">
                                    <input type="text" class="cz-color-hex" :value="headerSettings.transparent_logo_color" @input="headerSettings.transparent_logo_color = $event.target.value" maxlength="9">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Top Bar Panel -->
            <div class="cz-panel">
                <div class="cz-panel-header" @click="hPanels.widgets = !hPanels.widgets">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="4" rx="1" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18"/></svg>
                        Top Bar
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="hPanels.widgets ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="hPanels.widgets" x-collapse class="cz-panel-body">
                    <p class="text-xs text-gray-400 mb-3">A utility strip displayed above the main header. Add widgets like contact info, announcements, or social links.</p>

                    <!-- Show / Hide toggle -->
                    <div class="cz-toggle-row" style="margin-bottom:1rem;padding-bottom:1rem;border-bottom:1px solid #f3f4f6;">
                        <span class="cz-toggle-label">Show top bar</span>
                        <button type="button" @click="headerSettings.show_topbar = headerSettings.show_topbar == 1 ? 0 : 1"
                            class="cz-toggle" :class="headerSettings.show_topbar == 1 ? 'cz-toggle-on' : 'cz-toggle-off'">
                            <span class="cz-toggle-knob" :class="headerSettings.show_topbar == 1 ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                        </button>
                    </div>

                    <div x-show="headerSettings.show_topbar == 1">
                        <!-- Style controls -->
                        <div class="mb-4 pb-4 border-b border-gray-100">
                            <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Appearance</h4>
                            <!-- Colors -->
                            <div class="grid grid-cols-2 gap-3 mb-3">
                                <template x-for="cf in topbarColorFields" :key="cf.key">
                                    <div>
                                        <label class="cz-label" x-text="cf.label"></label>
                                        <div class="cz-color-wrap">
                                            <input type="color" class="cz-color-input" :value="headerSettings[cf.key]" @input="headerSettings[cf.key] = $event.target.value">
                                            <input type="text" class="cz-color-hex" :value="headerSettings[cf.key]" @input="headerSettings[cf.key] = $event.target.value" maxlength="9">
                                        </div>
                                    </div>
                                </template>
                            </div>
                            <!-- Font / Alignment / Padding -->
                            <div class="grid grid-cols-3 gap-3 mb-3">
                                <div>
                                    <label class="cz-label">Font Size</label>
                                    <div class="cz-range-row">
                                        <input type="range" min="10" max="18" step="1" x-model="headerSettings.topbar_font_size">
                                        <span class="cz-range-value" x-text="headerSettings.topbar_font_size + 'px'"></span>
                                    </div>
                                </div>
                                <div>
                                    <label class="cz-label">Font Weight</label>
                                    <select class="cz-select" x-model="headerSettings.topbar_font_weight">
                                        <option value="normal">Normal</option>
                                        <option value="500">Medium</option>
                                        <option value="600">Semibold</option>
                                        <option value="bold">Bold</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="cz-label">Alignment</label>
                                    <select class="cz-select" x-model="headerSettings.topbar_align">
                                        <option value="left">Left</option>
                                        <option value="center">Center</option>
                                        <option value="right">Right</option>
                                        <option value="space-between">Space Between</option>
                                    </select>
                                </div>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                                <div>
                                    <label class="cz-label">Top Bar Container</label>
                                    <select class="cz-select" x-model="headerSettings.topbar_container_width">
                                        <option value="contained">Contained</option>
                                        <option value="full">Full Width + Side Gutters</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="cz-label">Top Bar Holder Width</label>
                                    <select class="cz-select" x-model="headerSettings.topbar_inner_width_mode">
                                        <option value="boxed">Boxed</option>
                                        <option value="contained">Contained</option>
                                        <option value="full">Full Width</option>
                                        <option value="custom">Custom</option>
                                    </select>
                                </div>
                                <div x-show="headerSettings.topbar_inner_width_mode === 'custom'">
                                    <label class="cz-label">Custom Top Bar Width</label>
                                    <input type="text" class="cz-input" x-model="headerSettings.topbar_inner_custom_width" placeholder="960px">
                                </div>
                                <div>
                                    <label class="cz-label">Vertical Padding</label>
                                    <div class="cz-range-row">
                                        <input type="range" min="0" max="24" step="1" x-model="headerSettings.topbar_padding_y">
                                        <span class="cz-range-value" x-text="headerSettings.topbar_padding_y + 'px'"></span>
                                    </div>
                                </div>
                                <div class="flex items-end pb-1">
                                    <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
                                        <input type="checkbox" class="rounded border-gray-300" :checked="headerSettings.topbar_border_bottom == 1" @change="headerSettings.topbar_border_bottom = $event.target.checked ? 1 : 0">
                                        Bottom border
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Widget management -->
                        <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Widgets</h4>

                    <!-- Add Widget dropdown -->
                    <div class="mb-4" x-data="{ hwOpen: false }">
                        <div class="relative">
                            <button type="button" @click="hwOpen = !hwOpen" class="w-full flex items-center justify-center gap-2 px-3 py-2 border-2 border-dashed border-gray-300 rounded-lg text-sm text-gray-500 hover:border-sky-400 hover:text-sky-600 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                                Add Top Bar Widget
                            </button>
                            <div x-show="hwOpen" @click.away="hwOpen = false" x-transition class="absolute z-10 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg p-1">
                                <template x-for="wt in headerWidgetTypes" :key="wt.type">
                                    <button type="button" @click="addHeaderWidget(wt.type); hwOpen = false"
                                        class="w-full flex items-center gap-2 px-3 py-2 rounded hover:bg-gray-50 text-left text-sm">
                                        <span x-text="wt.icon" class="text-base"></span>
                                        <div>
                                            <div class="font-medium text-gray-700" x-text="wt.label"></div>
                                            <div class="text-[10px] text-gray-400" x-text="wt.desc"></div>
                                        </div>
                                    </button>
                                </template>
                            </div>
                        </div>
                    </div>

                    <!-- Widget cards -->
                    <div class="space-y-2">
                        <template x-for="(hw, hwIdx) in headerWidgets" :key="hw.id">
                            <div class="border border-gray-200 rounded-lg overflow-hidden">
                                <!-- Widget header -->
                                <div class="flex items-center gap-2 px-3 py-2 bg-gray-50 cursor-pointer" @click="toggleHeaderWidget(hw.id)">
                                    <span :class="headerWidgetBadgeClass(hw.type)" class="px-1.5 py-0.5 rounded text-[10px] font-medium" x-text="headerWidgetTypeLabel(hw.type)"></span>
                                    <span class="text-xs text-gray-500 flex-1 truncate" x-text="hw.props.title || hw.props.content || '(untitled)'"></span>
                                    <div class="flex items-center gap-1">
                                        <button type="button" @click.stop="moveHeaderWidgetUp(hwIdx)" :disabled="hwIdx === 0" class="p-1 text-gray-400 hover:text-gray-600 disabled:opacity-30">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/></svg>
                                        </button>
                                        <button type="button" @click.stop="moveHeaderWidgetDown(hwIdx)" :disabled="hwIdx === headerWidgets.length - 1" class="p-1 text-gray-400 hover:text-gray-600 disabled:opacity-30">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                                        </button>
                                        <button type="button" @click.stop="removeHeaderWidget(hw.id)" class="p-1 text-red-400 hover:text-red-600">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </button>
                                    </div>
                                </div>
                                <!-- Widget body -->
                                <div x-show="expandedHeaderWidgets[hw.id]" class="px-3 py-3 space-y-3 border-t border-gray-100">
                                    <!-- Text widget -->
                                    <template x-if="hw.type === 'text'">
                                        <div class="space-y-3">
                                            <div>
                                                <label class="cz-label">Display Text</label>
                                                <input type="text" class="cz-input" x-model="hw.props.content" placeholder="e.g. Free shipping on orders over $50">
                                            </div>
                                            <div class="grid grid-cols-2 gap-3">
                                                <div>
                                                    <label class="cz-label">Font Size (px)</label>
                                                    <input type="number" class="cz-input" x-model="hw.props.font_size" min="10" max="24" step="1" placeholder="13">
                                                </div>
                                                <div>
                                                    <label class="cz-label">Font Weight</label>
                                                    <select class="cz-select" x-model="hw.props.font_weight">
                                                        <option value="normal">Normal</option>
                                                        <option value="500">Medium</option>
                                                        <option value="600">Semibold</option>
                                                        <option value="bold">Bold</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </template>
                                    <!-- Custom HTML widget -->
                                    <template x-if="hw.type === 'custom_html'">
                                        <div class="space-y-3">
                                            <div>
                                                <label class="cz-label">HTML Content</label>
                                                <textarea class="cz-input font-mono text-xs" rows="4" x-model="hw.props.content" placeholder="<span>Custom HTML</span>"></textarea>
                                            </div>
                                        </div>
                                    </template>
                                    <!-- Social Links widget -->
                                    <template x-if="hw.type === 'social_links'">
                                        <div>
                                            <p class="text-xs text-gray-500">Displays social icons from your CMS Social Links settings. No additional configuration needed.</p>
                                        </div>
                                    </template>
                                    <!-- Contact Info widget -->
                                    <template x-if="hw.type === 'contact_info'">
                                        <div class="space-y-3">
                                            <div>
                                                <label class="cz-label">Phone</label>
                                                <input type="text" class="cz-input" x-model="hw.props.phone" placeholder="+1 (555) 123-4567">
                                            </div>
                                            <div>
                                                <label class="cz-label">Email</label>
                                                <input type="email" class="cz-input" x-model="hw.props.email" placeholder="info@example.com">
                                            </div>
                                            <div>
                                                <label class="cz-label">Address (optional)</label>
                                                <input type="text" class="cz-input" x-model="hw.props.address" placeholder="123 Main St, City">
                                            </div>
                                        </div>
                                    </template>
                                    <!-- Navigation Menu widget -->
                                    <template x-if="hw.type === 'nav_menu'">
                                        <div class="space-y-3">
                                            <div>
                                                <label class="cz-label">Menu</label>
                                                <select class="cz-select" x-model="hw.props.menu_id">
                                                    <option value="0">— Select a menu —</option>
                                                    <template x-for="m in availableMenus" :key="m.id">
                                                        <option :value="m.id" x-text="m.name + ' (' + m.location + ')'"></option>
                                                    </template>
                                                </select>
                                            </div>
                                            <p class="text-[10px] text-gray-400">Displays a compact inline menu in the header bar.</p>
                                        </div>
                                    </template>
                                    <!-- Button / Link widget -->
                                    <template x-if="hw.type === 'button'">
                                        <div class="space-y-3">
                                            <div class="grid grid-cols-2 gap-3">
                                                <div>
                                                    <label class="cz-label">Button Text</label>
                                                    <input type="text" class="cz-input" x-model="hw.props.text" placeholder="Learn More">
                                                </div>
                                                <div>
                                                    <label class="cz-label">URL</label>
                                                    <input type="text" class="cz-input" x-model="hw.props.url" placeholder="/contact">
                                                </div>
                                            </div>
                                            <div class="grid grid-cols-2 gap-3">
                                                <div>
                                                    <label class="cz-label">Style</label>
                                                    <select class="cz-select" x-model="hw.props.style">
                                                        <option value="primary">Primary (filled)</option>
                                                        <option value="secondary">Secondary</option>
                                                        <option value="outline">Outline</option>
                                                        <option value="link">Plain link</option>
                                                    </select>
                                                </div>
                                                <div class="flex items-end pb-1">
                                                    <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
                                                        <input type="checkbox" class="rounded border-gray-300" :checked="hw.props.new_tab == 1" @change="hw.props.new_tab = $event.target.checked ? 1 : 0">
                                                        Open in new tab
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </template>
                                    <!-- Opening Hours widget -->
                                    <template x-if="hw.type === 'opening_hours'">
                                        <div class="space-y-3">
                                            <div>
                                                <label class="cz-label">Hours Text</label>
                                                <input type="text" class="cz-input" x-model="hw.props.text" placeholder="Mon-Fri: 9AM - 5PM">
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <label class="flex items-center gap-2 text-sm text-gray-700 cursor-pointer">
                                                    <input type="checkbox" class="rounded border-gray-300" :checked="hw.props.icon == 1" @change="hw.props.icon = $event.target.checked ? 1 : 0">
                                                    Show clock icon
                                                </label>
                                            </div>
                                        </div>
                                    </template>
                                </div>
                            </div>
                        </template>
                    </div>

                    <div x-show="headerWidgets.length === 0" class="text-center py-4 text-xs text-gray-400">
                        No top bar widgets added yet. Click &ldquo;Add Top Bar Widget&rdquo; above.
                    </div>
                    </div><!-- /x-show topbar -->
                </div>
            </div>

            <!-- Mobile Settings Panel -->
            <div class="cz-panel">
                <div class="cz-panel-header" @click="hPanels.mobile = !hPanels.mobile">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="7" y="2" width="10" height="20" rx="2" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01"/></svg>
                        Mobile Settings
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="hPanels.mobile ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="hPanels.mobile" x-collapse class="cz-panel-body">

                    <!-- Menu Style -->
                    <div>
                        <label class="cz-label">Mobile Menu Style</label>
                        <select x-model="headerSettings.mobile_menu_style" class="cz-select">
                            <option value="dropdown">Dropdown (default)</option>
                            <option value="canvas">Off-Canvas Slide-in</option>
                        </select>
                        <p class="cz-hint" x-text="headerSettings.mobile_menu_style === 'canvas' ? 'Menu slides in from the side as a full-height panel' : 'Menu expands below the header bar'"></p>
                    </div>

                    <div style="margin-top:0.875rem;">
                        <label class="cz-label">Mobile Menu Background</label>
                        <div class="cz-color-wrap" style="margin-bottom:0.5rem;">
                            <input type="color" class="cz-color-input" x-model="_mobileBgHex"
                                @input="let c=_mobileBgHex;let r=parseInt(c.slice(1,3),16),g=parseInt(c.slice(3,5),16),b=parseInt(c.slice(5,7),16);headerSettings.mobile_bg_color='rgba('+r+','+g+','+b+','+(_mobileBgOpacity/100)+')';">
                            <input type="text" class="cz-color-hex" x-model="_mobileBgHex" maxlength="7"
                                @input="if(/^#[0-9a-fA-F]{6}$/.test(_mobileBgHex)){let c=_mobileBgHex;let r=parseInt(c.slice(1,3),16),g=parseInt(c.slice(3,5),16),b=parseInt(c.slice(5,7),16);headerSettings.mobile_bg_color='rgba('+r+','+g+','+b+','+(_mobileBgOpacity/100)+')';}">
                        </div>
                        <div class="cz-range-row">
                            <label class="cz-label" style="margin-bottom:0;flex-shrink:0;">Background Opacity</label>
                            <input type="range" min="0" max="100" step="1" x-model="_mobileBgOpacity"
                                @input="let c=_mobileBgHex||'#ffffff';let r=parseInt(c.slice(1,3),16),g=parseInt(c.slice(3,5),16),b=parseInt(c.slice(5,7),16);headerSettings.mobile_bg_color='rgba('+r+','+g+','+b+','+(_mobileBgOpacity/100)+')';">
                            <span class="cz-range-value" x-text="_mobileBgOpacity + '%'"></span>
                        </div>
                    </div>

                    <!-- Canvas options (shown when canvas selected) -->
                    <div x-show="headerSettings.mobile_menu_style === 'canvas'" class="cz-indent" style="margin-top:1rem;">
                        <div class="space-y-4">
                        <!-- Canvas Menu Location -->
                        <div>
                            <label class="cz-label">Canvas Menu</label>
                            <select class="cz-select" x-model="headerSettings.mobile_menu_location">
                                <option value="">Same as desktop header</option>
                                <template x-for="loc in availableMenuLocations" :key="loc.slug">
                                    <option :value="loc.slug" x-text="(loc.label || loc.name || loc.slug) + (loc.menu_name ? ' — ' + loc.menu_name : '')"></option>
                                </template>
                            </select>
                            <p class="cz-hint">Select a different menu to show in the mobile canvas, or leave blank to reuse the desktop menu.</p>
                        </div>
                        <!-- Direction + Width -->
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="cz-label">Slide Direction</label>
                                <select x-model="headerSettings.mobile_canvas_direction" class="cz-select">
                                    <option value="left">From Left</option>
                                    <option value="right">From Right</option>
                                </select>
                            </div>
                            <div>
                                <label class="cz-label">Panel Width (px)</label>
                                <input type="number" x-model="headerSettings.mobile_canvas_width" min="220" max="420" class="cz-input">
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="cz-label">Menu Alignment</label>
                                <select x-model="headerSettings.mobile_menu_align" class="cz-select">
                                    <option value="left">Left</option>
                                    <option value="center">Center</option>
                                    <option value="right">Right</option>
                                </select>
                            </div>
                            <div>
                                <label class="cz-label">Link Hover Background</label>
                                <div class="cz-color-wrap">
                                    <input type="color" class="cz-color-input" :value="headerSettings.mobile_hover_bg_color" @input="headerSettings.mobile_hover_bg_color = $event.target.value">
                                    <input type="text" class="cz-color-hex" :value="headerSettings.mobile_hover_bg_color" @input="headerSettings.mobile_hover_bg_color = $event.target.value" maxlength="9">
                                </div>
                            </div>
                        </div>
                        <div>
                            <label class="cz-label">Active Item Background</label>
                            <div class="cz-color-wrap">
                                <input type="color" class="cz-color-input" :value="headerSettings.mobile_active_bg_color" @input="headerSettings.mobile_active_bg_color = $event.target.value">
                                <input type="text" class="cz-color-hex" :value="headerSettings.mobile_active_bg_color" @input="headerSettings.mobile_active_bg_color = $event.target.value" maxlength="9">
                            </div>
                            <p class="cz-hint">Background color for the current/active page link in canvas menu.</p>
                        </div>
                        <p class="cz-hint">Canvas uses your <strong>Mobile Background Color</strong> as panel background. Overlay is disabled for a cleaner experience.</p>
                        <!-- Close on link click -->
                        <div class="cz-toggle-row">
                            <div>
                                <span class="cz-toggle-label">Close on Link Click</span>
                                <p class="cz-toggle-desc">Auto-close canvas when a nav link is tapped</p>
                            </div>
                            <button type="button" @click="headerSettings.mobile_close_on_link = headerSettings.mobile_close_on_link ? 0 : 1"
                                class="cz-toggle" :class="headerSettings.mobile_close_on_link ? 'cz-toggle-on' : 'cz-toggle-off'">
                                <span class="cz-toggle-knob" :class="headerSettings.mobile_close_on_link ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                            </button>
                        </div>
                        </div>
                    </div>

                    <hr class="cz-divider">

                    <!-- Mobile Logo -->
                    <div>
                        <h4 class="cz-section-title">Mobile Logo</h4>
                        <p class="cz-hint" style="margin-bottom:0.75rem;">Optionally use a different (smaller, simplified) logo on mobile. Leave empty to use the desktop logo.</p>
                        <div>
                            <label class="cz-label">Mobile Logo URL</label>
                            <div class="flex items-center gap-2">
                                <input type="text" x-model="headerSettings.mobile_logo_url" class="cz-input" style="flex:1;" placeholder="/assets/logo-mobile.png">
                                <label class="cz-upload-btn">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                                    Upload
                                    <input type="file" accept="image/*" class="hidden" @change="uploadHeaderImage($event, 'mobile_logo_url')">
                                </label>
                            </div>
                        </div>
                        <div x-show="headerSettings.mobile_logo_url" class="cz-img-preview" style="margin-top:0.5rem;">
                            <img :src="headerSettings.mobile_logo_url" alt="Mobile logo">
                            <button @click="headerSettings.mobile_logo_url = ''" class="cz-remove-btn">Remove</button>
                        </div>
                        <div style="margin-top:0.75rem;">
                            <label class="cz-label">Mobile Logo Max Height (px)</label>
                            <div class="cz-range-row">
                                <input type="range" min="16" max="80" step="2" x-model="headerSettings.mobile_logo_max_height">
                                <span class="cz-range-value" x-text="headerSettings.mobile_logo_max_height + 'px'"></span>
                            </div>
                        </div>
                    </div>

                    <hr class="cz-divider">

                    <!-- Breakpoint -->
                    <div>
                        <label class="cz-label">Mobile Breakpoint</label>
                        <select x-model="headerSettings.mobile_breakpoint" class="cz-select">
                            <option value="640">640px (small phones only)</option>
                            <option value="768">768px (default — tablets &amp; below)</option>
                            <option value="1024">1024px (tablets in landscape &amp; below)</option>
                        </select>
                        <p class="cz-hint">Screen width at which the mobile menu activates</p>
                    </div>

                </div>
            </div>

        </div>

        <!-- Right Column: Live Preview -->
        <div class="xl:col-span-4 space-y-5 cz-preview-column">
            <div class="cz-panel sticky top-20">
                <div class="cz-panel-header">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        Header Preview
                    </h3>
                </div>
                <div class="p-4">
                    <div class="cz-preview-frame rounded-lg overflow-hidden">
                        <div class="px-4 pt-3 pb-2 flex flex-wrap gap-1.5 text-[10px] text-gray-500">
                            <span class="inline-flex items-center rounded-full bg-white/80 px-2 py-1">Header: <span class="ml-1 font-medium text-gray-700" x-text="headerPreviewContainerLabel(headerSettings.header_container_width) + ' / ' + headerPreviewHolderLabel(headerSettings.header_inner_width_mode, headerSettings.header_inner_custom_width)"></span></span>
                            <span x-show="headerSettings.show_topbar == 1" class="inline-flex items-center rounded-full bg-white/80 px-2 py-1">Top Bar: <span class="ml-1 font-medium text-gray-700" x-text="headerPreviewContainerLabel(headerSettings.topbar_container_width) + ' / ' + headerPreviewHolderLabel(headerSettings.topbar_inner_width_mode, headerSettings.topbar_inner_custom_width)"></span></span>
                        </div>
                        <!-- Preview top bar -->
                        <div x-show="headerSettings.show_topbar == 1 && headerWidgets.length > 0"
                             :style="'background:' + headerSettings.topbar_bg_color + ';color:' + headerSettings.topbar_text_color + ';font-size:' + (headerSettings.topbar_font_size || 13) + 'px;font-weight:' + (headerSettings.topbar_font_weight || 'normal') + ';padding:' + (headerSettings.topbar_padding_y || 6) + 'px 0;' + (headerSettings.topbar_border_bottom == 1 ? 'border-bottom:1px solid rgba(255,255,255,0.1);' : '') + headerPreviewContainerStyle(headerSettings.topbar_container_width)"
                             class="w-full">
                            <div class="w-full" :style="headerPreviewHolderStyle(headerSettings.topbar_inner_width_mode, headerSettings.topbar_inner_custom_width)">
                                <div class="flex items-center gap-3"
                                     :class="{'justify-start': headerSettings.topbar_align === 'left', 'justify-center': headerSettings.topbar_align === 'center', 'justify-end': headerSettings.topbar_align === 'right', 'justify-between': headerSettings.topbar_align === 'space-between'}">
                                    <template x-for="hw in headerWidgets" :key="hw.id">
                                        <span class="truncate max-w-[140px]"
                                              :style="(hw.type === 'contact_info' || hw.type === 'social_links' || hw.type === 'nav_menu' || hw.type === 'button') ? 'color:' + headerSettings.topbar_link_color : ''"
                                              x-text="hw.props.content || hw.props.text || hw.props.phone || hw.props.email || headerWidgetTypeLabel(hw.type)"></span>
                                    </template>
                                </div>
                            </div>
                        </div>
                        <!-- Preview header bar -->
                        <div :style="'background:' + headerSettings.bg_color + ';border-bottom:1px solid ' + headerSettings.border_color + ';' + (headerSettings.height !== 'auto' ? 'min-height:' + headerSettings.height + 'px;' : '') + headerPreviewContainerStyle(headerSettings.header_container_width)"
                             class="relative">
                            <div class="w-full" :style="headerPreviewHolderStyle(headerSettings.header_inner_width_mode, headerSettings.header_inner_custom_width)">
                                <div :style="'display:flex;align-items:center;padding:' + (headerSettings.padding_top || 12) + 'px 16px ' + (headerSettings.padding_bottom || 12) + 'px;'"
                                     class="relative">
                                    <!-- Logo -->
                                    <div :style="'color:' + headerSettings.logo_color + ';font-weight:700;font-size:14px;'" class="flex items-center gap-2">
                                        <img x-show="headerSettings.logo_image_url" :src="headerSettings.logo_image_url" alt="Logo"
                                             :style="'max-height:' + (headerSettings.logo_max_height || 40) + 'px;width:auto;'" class="object-contain">
                                        <span x-show="!headerSettings.logo_image_url" x-text="siteTitle || 'Site Name'"></span>
                                        <span x-show="headerSettings.show_tagline == 1" :style="'color:' + headerSettings.text_color + ';font-weight:400;font-size:10px;opacity:0.7'" x-text="siteTagline || 'Tagline'"></span>
                                    </div>
                                    <!-- Nav links (mock) -->
                                    <div class="flex-1 flex justify-end items-center gap-3" :style="'font-size:11px;'">
                                        <span :style="'color:' + headerSettings.link_color">Home</span>
                                        <span :style="'color:' + headerSettings.link_color">About</span>
                                        <span :style="'color:' + headerSettings.link_color">Blog</span>
                                        <span x-show="headerSettings.show_search == 1" :style="'color:' + headerSettings.link_color">
                                            <svg class="w-3 h-3 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                                        </span>
                                        <span x-show="headerSettings.show_cta_button == 1"
                                              class="px-2 py-0.5 rounded text-[10px] font-medium"
                                              :style="headerSettings.cta_style === 'outline' ? 'border:1px solid currentColor;color:' + headerSettings.link_color : 'background:' + ((customizerScope === 'ecommerce' ? colorsSettings.storefront_cta_bg : colorsSettings.color_primary) || '#2563eb') + ';color:' + ((customizerScope === 'ecommerce' ? colorsSettings.storefront_cta_text : '#ffffff') || '#ffffff') + ';'"
                                              x-text="headerSettings.cta_text || 'CTA'"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Page content placeholder -->
                        <div class="p-4 space-y-2" style="background:#f9fafb;">
                            <div class="h-3 bg-gray-200 rounded w-3/4"></div>
                            <div class="h-3 bg-gray-200 rounded w-1/2"></div>
                            <div class="h-3 bg-gray-200 rounded w-2/3"></div>
                            <div class="h-20 bg-gray-100 rounded mt-3"></div>
                        </div>
                    </div>

                    <!-- Transparent preview -->
                    <div x-show="headerSettings.transparent_home == 1" class="mt-4">
                        <p class="text-[10px] text-gray-400 mb-2 uppercase tracking-wider font-semibold">Homepage (transparent)</p>
                        <div class="cz-preview-frame rounded-lg overflow-hidden relative">
                            <!-- Hero background -->
                            <div style="background:linear-gradient(135deg,#1e293b 0%,#334155 100%);height:100px;position:relative;">
                                <!-- Overlaid header -->
                                <div :style="(function(){ var c = headerSettings.bg_color || '#ffffff'; var r=parseInt(c.slice(1,3),16)||255, g=parseInt(c.slice(3,5),16)||255, b=parseInt(c.slice(5,7),16)||255; return 'background:rgba('+r+','+g+','+b+','+(headerSettings.header_bg_opacity/100)+');'; })() + 'border-bottom:1px solid transparent;' + (headerSettings.height !== 'auto' ? 'min-height:' + headerSettings.height + 'px;' : '') + 'position:absolute;top:0;left:0;right:0;' + headerPreviewContainerStyle(headerSettings.header_container_width)"
                                     class="relative">
                                    <div class="w-full" :style="headerPreviewHolderStyle(headerSettings.header_inner_width_mode, headerSettings.header_inner_custom_width)">
                                        <div :style="'display:flex;align-items:center;padding:' + (headerSettings.padding_top || 12) + 'px 16px ' + (headerSettings.padding_bottom || 12) + 'px;'">
                                            <div :style="'color:' + headerSettings.transparent_logo_color + ';font-weight:700;font-size:14px;'">
                                                <span x-text="siteTitle || 'Site Name'"></span>
                                            </div>
                                            <div class="flex-1 flex justify-end items-center gap-3" :style="'font-size:11px;'">
                                                <span :style="'color:' + headerSettings.transparent_text_color">Home</span>
                                                <span :style="'color:' + headerSettings.transparent_text_color">About</span>
                                                <span :style="'color:' + headerSettings.transparent_text_color">Blog</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Hero text -->
                                <div style="position:absolute;bottom:12px;left:16px;color:#fff;font-size:12px;font-weight:600;">Hero Section</div>
                            </div>
                        </div>
                    </div>

                    <div x-show="customizerScope === 'ecommerce'" class="mt-4 rounded-lg border border-gray-200 bg-white p-3 space-y-3">
                        <div class="flex items-center justify-between">
                            <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Entity Header Wiring</p>
                            <span class="text-[10px] text-amber-700">Storefront scope</span>
                        </div>
                        <div class="rounded-lg border border-gray-100 overflow-hidden bg-white">
                            <div :style="'background:' + headerSettings.bg_color + ';border-bottom:1px solid ' + headerSettings.border_color + ';padding:10px 14px;display:flex;align-items:center;justify-content:space-between;' + (headerSettings.sticky == 1 ? 'position:sticky;top:0;' : '')">
                                <div class="flex items-center gap-2">
                                    <div class="w-7 h-7 rounded-md bg-sky-100"></div>
                                    <div>
                                        <div class="text-xs font-semibold" :style="'color:' + headerSettings.logo_color">Storefront Header</div>
                                        <div class="text-[10px]" :style="'color:' + headerSettings.text_color">Offset <span x-text="entityPreviewHeaderOffset()"></span></div>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 text-[10px]" :style="'color:' + headerSettings.link_color">
                                    <span>Catalog</span>
                                    <span>Collections</span>
                                    <span x-show="headerSettings.show_search == 1">Search</span>
                                </div>
                            </div>
                            <div class="p-3 space-y-3 bg-slate-50">
                                <div class="text-[10px] uppercase tracking-[0.16em] text-gray-400">Entity View Below Header</div>
                                <div :style="entityPreviewHeroStyle()">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                </div>
                                <div class="flex items-center gap-2 text-[10px] text-gray-400">
                                    <span class="inline-flex items-center rounded-full bg-white px-2 py-1 border border-gray-200">Sticky <span class="ml-1 font-medium" x-text="headerSettings.sticky == 1 ? 'On' : 'Off'"></span></span>
                                    <span class="inline-flex items-center rounded-full bg-white px-2 py-1 border border-gray-200">Menu <span class="ml-1 font-medium capitalize" x-text="headerSettings.layout"></span></span>
                                    <span class="inline-flex items-center rounded-full bg-white px-2 py-1 border border-gray-200">CTA <span class="ml-1 font-medium" x-text="headerSettings.show_cta_button == 1 ? 'On' : 'Off'"></span></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tab Content -->
    <div x-show="activeTab === 'navigation'" class="grid grid-cols-1 xl:grid-cols-12 gap-6 cz-tab-grid">
        <div class="xl:col-span-8 space-y-5">
            <div class="cz-panel">
                <div class="cz-panel-header" @click="nPanels.sources = !nPanels.sources">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h10"/></svg>
                        Menu Sources
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="nPanels.sources ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="nPanels.sources" x-collapse class="cz-panel-body">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="cz-label">Desktop Menu Location</label>
                            <select class="cz-select" x-model="headerSettings.menu_location">
                                <template x-for="loc in availableMenuLocations" :key="loc.slug">
                                    <option :value="loc.slug" x-text="(loc.label || loc.name || loc.slug) + (loc.menu_name ? ' · ' + loc.menu_name : '')"></option>
                                </template>
                            </select>
                            <p class="cz-hint">Select which assigned menu drives the main storefront navigation.</p>
                        </div>
                        <div>
                            <label class="cz-label">Canvas Menu Override</label>
                            <select class="cz-select" x-model="headerSettings.mobile_menu_location">
                                <option value="">Use desktop menu</option>
                                <template x-for="loc in availableMenuLocations" :key="'mobile-' + loc.slug">
                                    <option :value="loc.slug" x-text="(loc.label || loc.name || loc.slug) + (loc.menu_name ? ' · ' + loc.menu_name : '')"></option>
                                </template>
                            </select>
                            <p class="cz-hint">Use a dedicated mobile menu when the canvas pattern needs a different information hierarchy.</p>
                        </div>
                    </div>
                    <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-3">
                        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">Current Menu Assignments</p>
                        <div class="mt-3 flex flex-wrap gap-2">
                            <template x-for="loc in availableMenuLocations" :key="'pill-' + loc.slug">
                                <span class="inline-flex items-center rounded-full border border-slate-200 bg-white px-3 py-1 text-[11px] text-slate-600">
                                    <span x-text="loc.label || loc.name || loc.slug"></span>
                                    <span class="mx-1 text-slate-300">·</span>
                                    <span class="font-medium text-slate-900" x-text="loc.menu_name || 'Unassigned'"></span>
                                </span>
                            </template>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cz-panel">
                <div class="cz-panel-header" @click="nPanels.desktop = !nPanels.desktop">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h18v10H3zM8 21h8"/></svg>
                        Desktop Navigation Behavior
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="nPanels.desktop ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="nPanels.desktop" x-collapse class="cz-panel-body">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="cz-label">Header Layout</label>
                            <select class="cz-select" x-model="headerSettings.layout">
                                <option value="default">Default</option>
                                <option value="centered">Centered</option>
                                <option value="logo-left-menu-right">Logo Left / Menu Right</option>
                            </select>
                        </div>
                        <div>
                            <label class="cz-label">Dropdown Min Width</label>
                            <input type="number" class="cz-input" x-model="headerSettings.dropdown_min_width" min="160" max="420" step="10">
                        </div>
                        <div>
                            <label class="cz-label">Dropdown Radius</label>
                            <input type="number" class="cz-input" x-model="headerSettings.dropdown_radius" min="0" max="20" step="1">
                        </div>
                        <div>
                            <label class="cz-label">Dropdown Item Padding</label>
                            <input type="number" class="cz-input" x-model="headerSettings.dropdown_item_padding_y" min="6" max="20" step="1">
                        </div>
                    </div>
                    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="cz-toggle-row rounded-xl border border-slate-200 bg-slate-50 px-3 py-3">
                            <div>
                                <div class="cz-toggle-label">Show Search</div>
                                <div class="cz-toggle-desc">Adds the storefront search trigger to the main header.</div>
                            </div>
                            <button type="button" @click="headerSettings.show_search = headerSettings.show_search == 1 ? 0 : 1" class="cz-toggle" :class="headerSettings.show_search == 1 ? 'cz-toggle-on' : 'cz-toggle-off'">
                                <span class="cz-toggle-knob" :class="headerSettings.show_search == 1 ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                            </button>
                        </div>
                        <div class="cz-toggle-row rounded-xl border border-slate-200 bg-slate-50 px-3 py-3">
                            <div>
                                <div class="cz-toggle-label">Sticky Header</div>
                                <div class="cz-toggle-desc">Keeps navigation pinned so entity actions stay easy to reach.</div>
                            </div>
                            <button type="button" @click="headerSettings.sticky = headerSettings.sticky == 1 ? 0 : 1" class="cz-toggle" :class="headerSettings.sticky == 1 ? 'cz-toggle-on' : 'cz-toggle-off'">
                                <span class="cz-toggle-knob" :class="headerSettings.sticky == 1 ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="cz-panel">
                <div class="cz-panel-header" @click="nPanels.mobile = !nPanels.mobile">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4h10a2 2 0 012 2v12a2 2 0 01-2 2H7a2 2 0 01-2-2V6a2 2 0 012-2z"/></svg>
                        Mobile Menu Behavior
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="nPanels.mobile ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="nPanels.mobile" x-collapse class="cz-panel-body">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="cz-label">Mobile Menu Style</label>
                            <select class="cz-select" x-model="headerSettings.mobile_menu_style">
                                <option value="dropdown">Dropdown</option>
                                <option value="canvas">Canvas</option>
                            </select>
                        </div>
                        <div>
                            <label class="cz-label">Mobile Breakpoint</label>
                            <select class="cz-select" x-model="headerSettings.mobile_breakpoint">
                                <option value="640">640px</option>
                                <option value="768">768px</option>
                                <option value="1024">1024px</option>
                            </select>
                        </div>
                        <div x-show="headerSettings.mobile_menu_style === 'canvas'">
                            <label class="cz-label">Canvas Direction</label>
                            <select class="cz-select" x-model="headerSettings.mobile_canvas_direction">
                                <option value="left">Left</option>
                                <option value="right">Right</option>
                            </select>
                        </div>
                        <div x-show="headerSettings.mobile_menu_style === 'canvas'">
                            <label class="cz-label">Canvas Width</label>
                            <input type="number" class="cz-input" x-model="headerSettings.mobile_canvas_width" min="220" max="420">
                        </div>
                        <div x-show="headerSettings.mobile_menu_style === 'canvas'">
                            <label class="cz-label">Canvas Alignment</label>
                            <select class="cz-select" x-model="headerSettings.mobile_menu_align">
                                <option value="left">Left</option>
                                <option value="center">Center</option>
                                <option value="right">Right</option>
                            </select>
                        </div>
                        <div>
                            <label class="cz-label">Mobile Background</label>
                            <div class="cz-color-wrap">
                                <input type="color" class="cz-color-input" x-model="_mobileBgHex" @input="let c=_mobileBgHex;let r=parseInt(c.slice(1,3),16),g=parseInt(c.slice(3,5),16),b=parseInt(c.slice(5,7),16);headerSettings.mobile_bg_color='rgba('+r+','+g+','+b+','+(_mobileBgOpacity/100)+')';">
                                <input type="text" class="cz-color-hex" x-model="_mobileBgHex" @input="if(/^#[0-9a-fA-F]{6}$/.test(_mobileBgHex)){let c=_mobileBgHex;let r=parseInt(c.slice(1,3),16),g=parseInt(c.slice(3,5),16),b=parseInt(c.slice(5,7),16);headerSettings.mobile_bg_color='rgba('+r+','+g+','+b+','+(_mobileBgOpacity/100)+')';}">
                            </div>
                        </div>
                    </div>
                    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="cz-label">Mobile Background Opacity</label>
                            <div class="cz-range-row">
                                <input type="range" min="0" max="100" step="1" x-model="_mobileBgOpacity" @input="let c=_mobileBgHex||'#ffffff';let r=parseInt(c.slice(1,3),16),g=parseInt(c.slice(3,5),16),b=parseInt(c.slice(5,7),16);headerSettings.mobile_bg_color='rgba('+r+','+g+','+b+','+(_mobileBgOpacity/100)+')';">
                                <span class="cz-range-value" x-text="_mobileBgOpacity + '%' "></span>
                            </div>
                        </div>
                        <div class="cz-toggle-row rounded-xl border border-slate-200 bg-slate-50 px-3 py-3">
                            <div>
                                <div class="cz-toggle-label">Close On Link</div>
                                <div class="cz-toggle-desc">Collapse the mobile menu immediately after a customer chooses a link.</div>
                            </div>
                            <button type="button" @click="headerSettings.mobile_close_on_link = headerSettings.mobile_close_on_link ? 0 : 1" class="cz-toggle" :class="headerSettings.mobile_close_on_link ? 'cz-toggle-on' : 'cz-toggle-off'">
                                <span class="cz-toggle-knob" :class="headerSettings.mobile_close_on_link ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="xl:col-span-4 space-y-5 cz-preview-column">
            <div class="cz-panel sticky top-20">
                <div class="cz-panel-header">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        Navigation Preview
                    </h3>
                </div>
                <div class="p-4 space-y-4">
                    <div class="cz-preview-frame rounded-lg overflow-hidden border border-slate-200 bg-white">
                        <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3 text-xs" :style="'background:' + headerSettings.bg_color + ';color:' + headerSettings.text_color">
                            <div class="font-semibold" x-text="siteTitle || 'Storefront'"></div>
                            <div class="flex items-center gap-3" :style="'color:' + headerSettings.link_color">
                                <span>Home</span>
                                <span>Shop</span>
                                <span>Contact</span>
                                <span x-show="headerSettings.show_search == 1">Search</span>
                            </div>
                        </div>
                        <div class="grid gap-3 px-4 py-4 text-[11px] text-slate-500" style="background:#f8fafc;">
                            <div class="flex flex-wrap gap-2">
                                <span class="inline-flex items-center rounded-full bg-white px-2.5 py-1 border border-slate-200">Desktop <span class="ml-1 font-medium text-slate-900" x-text="headerSettings.menu_location || 'primary'"></span></span>
                                <span class="inline-flex items-center rounded-full bg-white px-2.5 py-1 border border-slate-200">Mobile <span class="ml-1 font-medium text-slate-900" x-text="headerSettings.mobile_menu_location || headerSettings.menu_location || 'primary'"></span></span>
                            </div>
                            <div class="rounded-lg border border-slate-200 bg-white p-3">
                                <div class="flex items-center justify-between text-[10px] uppercase tracking-[0.14em] text-slate-400">
                                    <span>Mobile Pattern</span>
                                    <span x-text="headerSettings.mobile_menu_style"></span>
                                </div>
                                <div class="mt-3 rounded-lg border border-slate-200 px-3 py-3" :style="'background:' + headerSettings.mobile_bg_color + ';color:' + headerSettings.mobile_text_color">
                                    <div class="flex items-center justify-between text-xs font-medium">
                                        <span>Menu</span>
                                        <span x-text="headerSettings.mobile_breakpoint + 'px'"></span>
                                    </div>
                                    <div class="mt-3 grid gap-2 text-[11px]">
                                        <div class="rounded-md px-2 py-2" :style="'background:' + headerSettings.mobile_hover_bg_color">Shop</div>
                                        <div class="rounded-md px-2 py-2" :style="'background:' + headerSettings.mobile_active_bg_color">Collections</div>
                                        <div class="rounded-md px-2 py-2 border border-dashed border-slate-300">Checkout</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 text-xs text-slate-600">
                        Use the menu manager for tree structure. This tab controls which assigned menus are used and how customers experience them across desktop and mobile.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Colors & Typography Tab Content -->
    <div x-show="activeTab === 'colors'" class="grid grid-cols-1 xl:grid-cols-12 gap-6 cz-tab-grid">
        <!-- Left Column: Settings -->
        <div class="xl:col-span-8 space-y-5">

            <!-- Brand Palette Panel -->
            <div class="cz-panel">
                <div class="cz-panel-header" @click="cPanels.brand = !cPanels.brand">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
                        Brand Palette
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="cPanels.brand ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="cPanels.brand" x-collapse class="cz-panel-body">
                    <p class="text-xs text-gray-400 mb-3">Your site's core brand colors. These cascade to buttons, links, and accents across all sections.</p>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                        <template x-for="cf in brandColorFields" :key="cf.key">
                            <div>
                                <label class="cz-label" x-text="cf.label"></label>
                                <div class="cz-color-wrap">
                                    <input type="color" class="cz-color-input" :value="colorsSettings[cf.key]" @input="colorsSettings[cf.key] = $event.target.value">
                                    <input type="text" class="cz-color-hex" :value="colorsSettings[cf.key]" @input="colorsSettings[cf.key] = $event.target.value" maxlength="9">
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
            </div>

            <!-- Body Colors Panel -->
            <div class="cz-panel">
                <div class="cz-panel-header" @click="cPanels.body = !cPanels.body">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
                        Body &amp; Surface Colors
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="cPanels.body ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="cPanels.body" x-collapse class="cz-panel-body">
                    <p class="text-xs text-gray-400 mb-3">Background, text, and link colors for the page body. Header/footer use their own colors if set.</p>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                        <template x-for="cf in bodyColorFields" :key="cf.key">
                            <div>
                                <label class="cz-label" x-text="cf.label"></label>
                                <div class="cz-color-wrap">
                                    <input type="color" class="cz-color-input" :value="colorsSettings[cf.key]" @input="colorsSettings[cf.key] = $event.target.value">
                                    <input type="text" class="cz-color-hex" :value="colorsSettings[cf.key]" @input="colorsSettings[cf.key] = $event.target.value" maxlength="9">
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
            </div>

            <!-- Typography Panel -->
            <div class="cz-panel">
                <div class="cz-panel-header" @click="cPanels.typo = !cPanels.typo">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16"/></svg>
                        Typography
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="cPanels.typo ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="cPanels.typo" x-collapse class="cz-panel-body">
                    <p class="text-xs text-gray-400 mb-3">Font families, base size, and heading scales.</p>

                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="cz-label">Body Font</label>
                            <select class="cz-select" x-model="colorsSettings.font_body">
                                <template x-for="f in fontOptions" :key="f.value">
                                    <option :value="f.value" x-text="f.label"></option>
                                </template>
                            </select>
                        </div>
                        <div>
                            <label class="cz-label">Heading Font</label>
                            <select class="cz-select" x-model="colorsSettings.font_heading">
                                <template x-for="f in fontOptions" :key="f.value">
                                    <option :value="f.value" x-text="f.label"></option>
                                </template>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="cz-label">Base Font Size</label>
                            <div class="cz-range-row">
                                <input type="range" min="12" max="24" step="1" x-model="colorsSettings.font_size_base">
                                <span class="cz-range-value" x-text="colorsSettings.font_size_base + 'px'"></span>
                            </div>
                        </div>
                        <div>
                            <label class="cz-label">Line Height</label>
                            <div class="cz-range-row">
                                <input type="range" min="1" max="2.5" step="0.05" x-model="colorsSettings.line_height">
                                <span class="cz-range-value" x-text="colorsSettings.line_height"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Heading color -->
                    <div class="mb-4">
                        <label class="cz-label">Heading Color <span class="font-normal text-gray-400">(leave empty to inherit body text color)</span></label>
                        <div class="cz-color-wrap" style="max-width:220px;">
                            <input type="color" class="cz-color-input" :value="colorsSettings.heading_color || colorsSettings.body_text_color" @input="colorsSettings.heading_color = $event.target.value">
                            <input type="text" class="cz-color-hex" :value="colorsSettings.heading_color" @input="colorsSettings.heading_color = $event.target.value" placeholder="inherit" maxlength="9">
                        </div>
                    </div>

                    <!-- Heading sizes -->
                    <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Heading Sizes (rem)</h4>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                        <div>
                            <label class="cz-label">H1</label>
                            <div class="cz-range-row">
                                <input type="range" min="1" max="5" step="0.1" x-model="colorsSettings.h1_size">
                                <span class="cz-range-value" x-text="colorsSettings.h1_size + 'rem'"></span>
                            </div>
                        </div>
                        <div>
                            <label class="cz-label">H2</label>
                            <div class="cz-range-row">
                                <input type="range" min="1" max="4" step="0.1" x-model="colorsSettings.h2_size">
                                <span class="cz-range-value" x-text="colorsSettings.h2_size + 'rem'"></span>
                            </div>
                        </div>
                        <div>
                            <label class="cz-label">H3</label>
                            <div class="cz-range-row">
                                <input type="range" min="1" max="3" step="0.1" x-model="colorsSettings.h3_size">
                                <span class="cz-range-value" x-text="colorsSettings.h3_size + 'rem'"></span>
                            </div>
                        </div>
                        <div>
                            <label class="cz-label">H4</label>
                            <div class="cz-range-row">
                                <input type="range" min="1" max="2.5" step="0.1" x-model="colorsSettings.h4_size">
                                <span class="cz-range-value" x-text="colorsSettings.h4_size + 'rem'"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Layout Panel -->
            <div class="cz-panel">
                <div class="cz-panel-header" @click="cPanels.layout = !cPanels.layout">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6z"/></svg>
                        Layout
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="cPanels.layout ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="cPanels.layout" x-collapse class="cz-panel-body">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="cz-label">Container Max Width</label>
                            <div class="cz-range-row">
                                <input type="range" min="800" max="1600" step="20" x-model="colorsSettings.container_width">
                                <span class="cz-range-value" x-text="colorsSettings.container_width + 'px'"></span>
                            </div>
                        </div>
                        <div>
                            <label class="cz-label">Border Radius</label>
                            <div class="cz-range-row">
                                <input type="range" min="0" max="2" step="0.05" x-model="colorsSettings.border_radius">
                                <span class="cz-range-value" x-text="colorsSettings.border_radius + 'rem'"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {if customizer_scope == 'ecommerce'}
            <div class="cz-panel">
                <div class="cz-panel-header" @click="cPanels.storefront = !cPanels.storefront">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18M6 12h12M8 17h8"/></svg>
                        Storefront Entity Palette
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="cPanels.storefront ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="cPanels.storefront" x-collapse class="cz-panel-body space-y-5">
                    <div>
                        <p class="text-xs text-gray-400 mb-3">These colors wire directly into canonical entity summary, pricing, CTA, and inventory surfaces for the ecommerce scope.</p>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                            <template x-for="cf in storefrontSurfaceColorFields" :key="cf.key">
                                <div>
                                    <label class="cz-label" x-text="cf.label"></label>
                                    <div class="cz-color-wrap">
                                        <input type="color" class="cz-color-input" :value="colorsSettings[cf.key]" @input="colorsSettings[cf.key] = $event.target.value">
                                        <input type="text" class="cz-color-hex" :value="colorsSettings[cf.key]" @input="colorsSettings[cf.key] = $event.target.value" maxlength="9">
                                    </div>
                                </div>
                            </template>
                        </div>
                    </div>
                    <div>
                        <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Actions</h4>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                            <template x-for="cf in storefrontActionColorFields" :key="cf.key">
                                <div>
                                    <label class="cz-label" x-text="cf.label"></label>
                                    <div class="cz-color-wrap">
                                        <input type="color" class="cz-color-input" :value="colorsSettings[cf.key]" @input="colorsSettings[cf.key] = $event.target.value">
                                        <input type="text" class="cz-color-hex" :value="colorsSettings[cf.key]" @input="colorsSettings[cf.key] = $event.target.value" maxlength="9">
                                    </div>
                                </div>
                            </template>
                        </div>
                    </div>
                    <div>
                        <h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Inventory States</h4>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                            <template x-for="cf in storefrontInventoryColorFields" :key="cf.key">
                                <div>
                                    <label class="cz-label" x-text="cf.label"></label>
                                    <div class="cz-color-wrap">
                                        <input type="color" class="cz-color-input" :value="colorsSettings[cf.key]" @input="colorsSettings[cf.key] = $event.target.value">
                                        <input type="text" class="cz-color-hex" :value="colorsSettings[cf.key]" @input="colorsSettings[cf.key] = $event.target.value" maxlength="9">
                                    </div>
                                </div>
                            </template>
                        </div>
                    </div>
                </div>
            </div>
            {/if}
        </div>

        <!-- Right Column: Live Preview -->
        <div class="xl:col-span-4 space-y-5 cz-preview-column">
            <div class="cz-panel sticky top-20">
                <div class="cz-panel-header">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        Live Preview
                    </h3>
                </div>
                <div class="p-4">
                    <div class="cz-preview-frame rounded-lg overflow-hidden"
                         :style="'background:' + colorsSettings.body_bg_color + ';color:' + colorsSettings.body_text_color + ';font-family:\'' + colorsSettings.font_body + '\',sans-serif;font-size:' + colorsSettings.font_size_base + 'px;line-height:' + colorsSettings.line_height + ';'">
                        <!-- Preview content -->
                        <div style="padding:16px;">
                            <!-- Heading previews -->
                            <div :style="'font-family:\'' + colorsSettings.font_heading + '\',sans-serif;' + (colorsSettings.heading_color ? 'color:' + colorsSettings.heading_color : '')">
                                <div :style="'font-size:' + colorsSettings.h1_size + 'rem;font-weight:700;line-height:1.2;margin:0 0 0.25rem;'">H1 Heading</div>
                                <div :style="'font-size:' + colorsSettings.h2_size + 'rem;font-weight:700;line-height:1.2;margin:0 0 0.25rem;'">H2 Heading</div>
                                <div :style="'font-size:' + colorsSettings.h3_size + 'rem;font-weight:700;line-height:1.2;margin:0 0 0.25rem;'">H3 Heading</div>
                                <div :style="'font-size:' + colorsSettings.h4_size + 'rem;font-weight:600;line-height:1.2;margin:0 0 0.5rem;'">H4 Heading</div>
                            </div>
                            <p style="margin:0 0 0.75rem;font-size:0.85em;">
                                Body text with <a href="#" @click.prevent :style="'color:' + colorsSettings.body_link_color">a link</a> and
                                <span :style="'color:' + colorsSettings.body_text_light">muted text</span>.
                            </p>
                            <!-- Button preview -->
                            <div class="flex gap-2 mb-3">
                                <span :style="'background:' + colorsSettings.color_primary + ';color:#fff;padding:4px 12px;border-radius:' + colorsSettings.border_radius + 'rem;font-size:11px;font-weight:600;'">Primary</span>
                                <span :style="'background:' + colorsSettings.color_secondary + ';color:#fff;padding:4px 12px;border-radius:' + colorsSettings.border_radius + 'rem;font-size:11px;font-weight:600;'">Secondary</span>
                                <span :style="'background:' + colorsSettings.color_accent + ';color:#fff;padding:4px 12px;border-radius:' + colorsSettings.border_radius + 'rem;font-size:11px;font-weight:600;'">Accent</span>
                            </div>
                            <!-- Surface preview -->
                            <div :style="'background:' + colorsSettings.light_bg_color + ';border:1px solid ' + colorsSettings.border_color + ';border-radius:' + colorsSettings.border_radius + 'rem;padding:10px;'"
                                 class="text-xs">
                                <span :style="'color:' + colorsSettings.body_text_light">Card / surface with light background and border</span>
                            </div>
                        </div>
                    </div>
                    <!-- Font note -->
                    <p class="text-[10px] text-gray-400 mt-3">
                        <strong>Cascade rule:</strong> These general settings apply everywhere unless a specific header or footer color is set in those tabs.
                    </p>
                    {if customizer_scope == 'ecommerce'}
                    <div class="mt-4 rounded-lg border border-gray-200 bg-white p-3 space-y-3">
                        <div class="flex items-center justify-between">
                            <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Entity Wiring Preview</p>
                            <span class="text-[10px] text-amber-700">Storefront scope</span>
                        </div>
                        <div class="space-y-3">
                            <div :style="entityPreviewSummaryStyle()">
                                <div class="text-[10px] uppercase tracking-[0.16em] text-gray-400 mb-1">Summary Surface</div>
                                <div class="flex items-end gap-2">
                                    <span class="text-lg font-bold" :style="'color:' + (colorsSettings.storefront_price_color || '#0f172a')">USD 79.00</span>
                                    <span class="text-xs line-through text-gray-400">99.00</span>
                                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold" :style="'background:' + colorsSettings.storefront_badge_bg + ';color:' + colorsSettings.storefront_badge_text">Sale</span>
                                </div>
                                <div class="mt-3 flex flex-wrap gap-2">
                                    <span :style="entityPreviewPrimaryActionStyle()">Add to Cart</span>
                                    <span :style="entityPreviewSecondaryActionStyle()">Inquire</span>
                                </div>
                                <div class="mt-3 flex flex-wrap gap-2 text-[10px] font-semibold">
                                    <span class="inline-flex items-center rounded-full px-2.5 py-1" :style="entityPreviewInventoryStyle('ok')">In Stock</span>
                                    <span class="inline-flex items-center rounded-full px-2.5 py-1" :style="entityPreviewInventoryStyle('low')">Low Stock</span>
                                    <span class="inline-flex items-center rounded-full px-2.5 py-1" :style="entityPreviewInventoryStyle('out')">Out</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    {/if}
                </div>
            </div>
        </div>
    </div>

    <!-- ───────────────────── Custom Code Tab ───────────────────── -->
    <div x-show="activeTab === 'custom_code'" class="space-y-5">

        <!-- Custom CSS Panel -->
        <div class="cz-panel">
            <div class="cz-panel-header" @click="ccPanels.css = !ccPanels.css">
                <h3>
                    <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
                    Custom CSS
                </h3>
                <svg class="w-4 h-4 text-gray-400 transition-transform" :class="ccPanels.css ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </div>
            <div x-show="ccPanels.css" x-collapse class="cz-panel-body">
                <p class="text-xs text-gray-500">Add CSS rules that override the theme. No <code>&lt;style&gt;</code> tags needed.</p>
                <textarea x-model="customCodeSettings.custom_css"
                    class="w-full h-48 font-mono text-xs bg-gray-900 text-green-300 border border-gray-700 rounded-lg p-3 focus:ring-2 focus:ring-sky-500 focus:border-sky-500 resize-y"
                    placeholder="/* Your CSS overrides */&#10;.site-header { box-shadow: 0 2px 12px rgba(0,0,0,0.08); }&#10;.hero-section { padding: 6rem 0; }"
                    spellcheck="false"></textarea>
            </div>
        </div>

        <!-- Head Code Injection Panel -->
        <div class="cz-panel">
            <div class="cz-panel-header" @click="ccPanels.head = !ccPanels.head">
                <h3>
                    <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                    Head Code Injection
                </h3>
                <svg class="w-4 h-4 text-gray-400 transition-transform" :class="ccPanels.head ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </div>
            <div x-show="ccPanels.head" x-collapse class="cz-panel-body">
                <p class="text-xs text-gray-500">HTML injected into <code>&lt;head&gt;</code> — analytics scripts, meta tags, schema markup, custom font imports, etc.</p>
                <textarea x-model="customCodeSettings.head_code"
                    class="w-full h-36 font-mono text-xs bg-gray-50 border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-sky-500 focus:border-sky-500 resize-y"
                    placeholder="<!-- Google Analytics -->&#10;<script async src='https://www.googletagmanager.com/gtag/js?id=G-XXXXX'></script>&#10;&#10;<!-- Schema markup -->&#10;<script type='application/ld+json'>{ ... }</script>"
                    spellcheck="false"></textarea>
            </div>
        </div>

        <!-- Body End Code Injection Panel -->
        <div class="cz-panel">
            <div class="cz-panel-header" @click="ccPanels.body = !ccPanels.body">
                <h3>
                    <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                    Body End Code
                </h3>
                <svg class="w-4 h-4 text-gray-400 transition-transform" :class="ccPanels.body ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </div>
            <div x-show="ccPanels.body" x-collapse class="cz-panel-body">
                <p class="text-xs text-gray-500">HTML injected before <code>&lt;/body&gt;</code> — chat widgets, tracking pixels, third-party scripts.</p>
                <textarea x-model="customCodeSettings.body_end_code"
                    class="w-full h-36 font-mono text-xs bg-gray-50 border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-sky-500 focus:border-sky-500 resize-y"
                    placeholder="<!-- Live chat widget -->&#10;<script src='https://chat-widget.example/embed.js'></script>&#10;&#10;<!-- Facebook Pixel -->&#10;<script>...</script>"
                    spellcheck="false"></textarea>
            </div>
        </div>

        <!-- Enhancements Panel -->
        <div class="cz-panel">
            <div class="cz-panel-header" @click="ccPanels.enhancements = !ccPanels.enhancements">
                <h3>
                    <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    Enhancements
                </h3>
                <svg class="w-4 h-4 text-gray-400 transition-transform" :class="ccPanels.enhancements ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </div>
            <div x-show="ccPanels.enhancements" x-collapse class="cz-panel-body">

                <!-- Smooth Scroll toggle -->
                <div class="cz-toggle-row">
                    <div>
                        <span class="cz-toggle-label">Smooth Scroll</span>
                        <p class="cz-toggle-desc">Enable smooth scrolling for anchor links</p>
                    </div>
                    <button type="button" @click="customCodeSettings.smooth_scroll = customCodeSettings.smooth_scroll ? 0 : 1"
                        class="cz-toggle" :class="customCodeSettings.smooth_scroll ? 'cz-toggle-on' : 'cz-toggle-off'">
                        <span class="cz-toggle-knob" :class="customCodeSettings.smooth_scroll ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                    </button>
                </div>

                <hr class="cz-divider">

                <!-- Page Transition -->
                <div>
                    <div class="cz-toggle-row">
                        <div>
                            <span class="cz-toggle-label">Page Transition</span>
                            <p class="cz-toggle-desc">Animate page load with a smooth entrance effect</p>
                        </div>
                        <button type="button" @click="customCodeSettings.page_transition = customCodeSettings.page_transition ? 0 : 1"
                            class="cz-toggle" :class="customCodeSettings.page_transition ? 'cz-toggle-on' : 'cz-toggle-off'">
                            <span class="cz-toggle-knob" :class="customCodeSettings.page_transition ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                        </button>
                    </div>
                    <div x-show="customCodeSettings.page_transition" class="cz-indent" style="margin-top:0.75rem;">
                        <label class="cz-label">Transition Style</label>
                        <select x-model="customCodeSettings.page_transition_style" class="cz-select" style="max-width:14rem;">
                            <option value="fade">Fade In</option>
                            <option value="slide-up">Slide Up</option>
                            <option value="zoom">Zoom In</option>
                        </select>
                    </div>
                </div>

                <hr class="cz-divider">

                <!-- Scroll to Top Button -->
                <div>
                    <div class="cz-toggle-row">
                        <div>
                            <span class="cz-toggle-label">Scroll to Top Button</span>
                            <p class="cz-toggle-desc">Show a floating button to scroll back to top</p>
                        </div>
                        <button type="button" @click="customCodeSettings.scroll_to_top = customCodeSettings.scroll_to_top ? 0 : 1"
                            class="cz-toggle" :class="customCodeSettings.scroll_to_top ? 'cz-toggle-on' : 'cz-toggle-off'">
                            <span class="cz-toggle-knob" :class="customCodeSettings.scroll_to_top ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                        </button>
                    </div>

                    <!-- Scroll-to-top options (shown when enabled) -->
                    <div x-show="customCodeSettings.scroll_to_top" class="cz-indent" style="margin-top:0.75rem;">
                        <div class="space-y-3">
                        <!-- Colors -->
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="cz-label">Background</label>
                                <div class="cz-color-wrap">
                                    <input type="color" x-model="customCodeSettings.scroll_to_top_bg" class="cz-color-input">
                                    <input type="text" x-model="customCodeSettings.scroll_to_top_bg" class="cz-color-hex" maxlength="9">
                                </div>
                            </div>
                            <div>
                                <label class="cz-label">Icon Color</label>
                                <div class="cz-color-wrap">
                                    <input type="color" x-model="customCodeSettings.scroll_to_top_color" class="cz-color-input">
                                    <input type="text" x-model="customCodeSettings.scroll_to_top_color" class="cz-color-hex" maxlength="9">
                                </div>
                            </div>
                        </div>
                        <!-- Size, Radius, Offset -->
                        <div class="grid grid-cols-3 gap-3">
                            <div>
                                <label class="cz-label">Size (px)</label>
                                <input type="number" x-model="customCodeSettings.scroll_to_top_size" min="28" max="72" class="cz-input">
                            </div>
                            <div>
                                <label class="cz-label">Roundness (%)</label>
                                <input type="number" x-model="customCodeSettings.scroll_to_top_radius" min="0" max="50" class="cz-input">
                            </div>
                            <div>
                                <label class="cz-label">Offset (px)</label>
                                <input type="number" x-model="customCodeSettings.scroll_to_top_offset" min="8" max="80" class="cz-input">
                            </div>
                        </div>
                        <!-- Position -->
                        <div>
                            <label class="cz-label">Position</label>
                            <select x-model="customCodeSettings.scroll_to_top_position" class="cz-select" style="max-width:10rem;">
                                <option value="right">Bottom Right</option>
                                <option value="left">Bottom Left</option>
                            </select>
                        </div>
                        <!-- Live preview mini -->
                        <div class="flex items-center gap-3 pt-1">
                            <span class="cz-hint">Preview:</span>
                            <button type="button" disabled
                                :style="'width:' + customCodeSettings.scroll_to_top_size + 'px;height:' + customCodeSettings.scroll_to_top_size + 'px;border-radius:' + customCodeSettings.scroll_to_top_radius + '%;background:' + customCodeSettings.scroll_to_top_bg + ';color:' + customCodeSettings.scroll_to_top_color + ';display:flex;align-items:center;justify-content:center;border:none;box-shadow:0 2px 8px rgba(0,0,0,0.15);'"
                                class="cursor-default">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
                            </button>
                        </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Info note -->
        <p class="text-[10px] text-gray-400">
            <strong>Security note:</strong> Code injection fields accept raw HTML/JS and are restricted to administrators only. Custom CSS is sanitized to prevent style injection.
        </p>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- THEME SETTINGS TAB -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <div x-show="activeTab === 'theme'" class="grid grid-cols-1 xl:grid-cols-12 gap-6 cz-tab-grid">
        <div class="xl:col-span-8 space-y-5">
            <div class="cz-panel">
                <div class="cz-panel-header" @click="tlPanels.site = !tlPanels.site">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5z"/></svg>
                        Site Layout
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="tlPanels.site ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="tlPanels.site" x-collapse class="cz-panel-body">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Layout Mode -->
                        <div>
                            <label class="cz-label">Layout Mode</label>
                            <select x-model="themeLayoutSettings.layout_mode" class="cz-select">
                                <option value="contained">Contained</option>
                                <option value="boxed">Boxed</option>
                                <option value="full-width">Full Width</option>
                            </select>
                            <p class="text-[10px] text-gray-400 mt-1">Contained = max-width centered. Boxed = centered with shadow. Full = edge-to-edge.</p>
                        </div>
                        <!-- Site Max Width -->
                        <div>
                            <label class="cz-label">Site Max Width (px)</label>
                            <input type="number" x-model="themeLayoutSettings.site_max_width" min="960" max="1920" step="10" class="cz-input">
                            <p class="text-[10px] text-gray-400 mt-1">Outer container width. 960–1920px.</p>
                        </div>
                        <!-- Content Max Width -->
                        <div>
                            <label class="cz-label">Content Max Width (px)</label>
                            <input type="number" x-model="themeLayoutSettings.content_max_width" min="480" max="1200" step="10" class="cz-input">
                            <p class="text-[10px] text-gray-400 mt-1">Width of the main content column.</p>
                        </div>
                        <!-- Horizontal Padding -->
                        <div>
                            <label class="cz-label">Horizontal Padding (px)</label>
                            <input type="number" x-model="themeLayoutSettings.content_padding_x" min="0" max="100" class="cz-input">
                        </div>
                        <!-- Top Padding -->
                        <div>
                            <label class="cz-label">Top Padding (px)</label>
                            <input type="number" x-model="themeLayoutSettings.content_padding_top" min="0" max="100" class="cz-input">
                        </div>
                        <!-- Bottom Padding -->
                        <div>
                            <label class="cz-label">Bottom Padding (px)</label>
                            <input type="number" x-model="themeLayoutSettings.content_padding_bottom" min="0" max="100" class="cz-input">
                        </div>
                    </div>
                </div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-4 text-sm text-slate-600">
                <div class="font-semibold text-slate-800 mb-1">Shell ownership</div>
                Theme Settings now owns shell geometry only: the outer site width, main content width, and shell padding.
                Canonical list, article, and entity presentation lives in the Entities tab so list and detail controls stop drifting away from the shared entity contract.
            </div>
        </div>

        <div class="xl:col-span-4 space-y-5 cz-preview-column">
            <div class="cz-panel sticky top-20">
                <div class="cz-panel-header">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        Layout Preview
                    </h3>
                </div>
                <div class="cz-panel-body space-y-4">
                    <div class="flex gap-1 bg-gray-100 rounded-lg p-0.5">
                        <button @click="tlPreviewMode = 'page'" class="flex-1 text-[10px] font-medium py-1 rounded-md transition-colors"
                            :class="tlPreviewMode === 'page' ? 'bg-white shadow-sm text-gray-700' : 'text-gray-400 hover:text-gray-600'">Page</button>
                        <button @click="tlPreviewMode = 'stats'" class="flex-1 text-[10px] font-medium py-1 rounded-md transition-colors"
                            :class="tlPreviewMode === 'stats' ? 'bg-white shadow-sm text-gray-700' : 'text-gray-400 hover:text-gray-600'">Summary</button>
                    </div>

                    <div x-show="tlPreviewMode === 'page'" class="border border-gray-200 rounded-lg overflow-hidden bg-white" style="min-height:280px;">
                        <div class="flex items-center gap-1.5 px-2.5 py-1.5 bg-gray-100 border-b border-gray-200">
                            <div class="flex gap-1"><span class="w-1.5 h-1.5 rounded-full bg-red-300"></span><span class="w-1.5 h-1.5 rounded-full bg-yellow-300"></span><span class="w-1.5 h-1.5 rounded-full bg-green-300"></span></div>
                            <div class="flex-1 bg-white rounded-sm border border-gray-200 px-2 py-0.5 text-[8px] text-gray-400 truncate ml-1">example.com/page</div>
                        </div>
                        <div class="relative" :class="themeLayoutSettings.layout_mode === 'boxed' ? 'bg-gray-100 p-1.5' : 'bg-white'">
                            <div class="mx-auto" :class="themeLayoutSettings.layout_mode === 'boxed' ? 'bg-white shadow-sm rounded' : ''">
                                <div class="flex items-center justify-between px-3 py-1.5 border-b border-gray-100">
                                    <div class="flex items-center gap-1.5">
                                        <div class="w-4 h-4 rounded bg-sky-100"></div>
                                        <div class="w-10 h-1.5 bg-gray-300 rounded"></div>
                                    </div>
                                    <div class="flex gap-2">
                                        <div class="w-6 h-1 bg-gray-200 rounded"></div>
                                        <div class="w-6 h-1 bg-gray-200 rounded"></div>
                                        <div class="w-6 h-1 bg-gray-200 rounded"></div>
                                    </div>
                                </div>
                                <div class="px-3 py-3">
                                    <div class="mx-auto"
                                         :style="'max-width:' + Math.min(100, Math.round(themeLayoutSettings.content_max_width / themeLayoutSettings.site_max_width * 100)) + '%'">
                                        <div class="h-2.5 bg-gray-800 rounded w-4/5 mb-2"></div>
                                        <div class="w-full bg-gradient-to-br from-sky-50 to-indigo-50 rounded-md mb-3 flex items-center justify-center" style="height:60px;">
                                            <svg class="w-5 h-5 text-sky-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                        </div>
                                        <div class="space-y-1.5">
                                            <div class="h-1 bg-gray-200 rounded w-full"></div>
                                            <div class="h-1 bg-gray-200 rounded w-11/12"></div>
                                            <div class="h-1 bg-gray-200 rounded w-full"></div>
                                            <div class="h-1 bg-gray-200 rounded w-4/5"></div>
                                            <div class="h-1 bg-gray-100 rounded w-0 my-1"></div>
                                            <div class="h-1 bg-gray-200 rounded w-full"></div>
                                            <div class="h-1 bg-gray-200 rounded w-9/12"></div>
                                            <div class="h-1 bg-gray-200 rounded w-full"></div>
                                            <div class="h-1 bg-gray-200 rounded w-2/3"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="px-3 py-1.5 border-t border-gray-100 bg-gray-50">
                                    <div class="flex justify-center gap-2">
                                        <div class="w-6 h-0.5 bg-gray-200 rounded"></div>
                                        <div class="w-6 h-0.5 bg-gray-200 rounded"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div x-show="tlPreviewMode === 'stats'" class="space-y-3">
                        <div class="space-y-2 text-xs text-gray-600">
                            <div class="flex justify-between"><span class="text-gray-400">Layout</span><span class="font-medium capitalize" x-text="themeLayoutSettings.layout_mode"></span></div>
                            <div class="flex justify-between"><span class="text-gray-400">Site Width</span><span class="font-medium" x-text="themeLayoutSettings.site_max_width + 'px'"></span></div>
                            <div class="flex justify-between"><span class="text-gray-400">Content Width</span><span class="font-medium" x-text="themeLayoutSettings.content_max_width + 'px'"></span></div>
                            <div class="flex justify-between"><span class="text-gray-400">Padding</span><span class="font-medium" x-text="themeLayoutSettings.content_padding_x + ' / ' + themeLayoutSettings.content_padding_top + ' / ' + themeLayoutSettings.content_padding_bottom + 'px'"></span></div>
                        </div>
                        <div>
                            <p class="text-[10px] font-semibold uppercase text-gray-400 tracking-wider mb-1.5">Width Ratio</p>
                            <div class="space-y-1.5">
                                <div>
                                    <div class="flex justify-between text-[9px] text-gray-400 mb-0.5"><span>Site</span><span x-text="themeLayoutSettings.site_max_width + 'px'"></span></div>
                                    <div class="h-2 bg-gray-100 rounded-full overflow-hidden"><div class="h-full bg-gray-400 rounded-full" style="width:100%"></div></div>
                                </div>
                                <div>
                                    <div class="flex justify-between text-[9px] text-gray-400 mb-0.5"><span>Content</span><span x-text="themeLayoutSettings.content_max_width + 'px'"></span></div>
                                    <div class="h-2 bg-gray-100 rounded-full overflow-hidden"><div class="h-full bg-sky-400 rounded-full" :style="'width:' + Math.round(themeLayoutSettings.content_max_width / themeLayoutSettings.site_max_width * 100) + '%'"></div></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div x-show="activeTab === 'commerce'" class="grid grid-cols-1 xl:grid-cols-12 gap-6 cz-tab-grid">
        <div class="xl:col-span-8 space-y-5">
            <div class="cz-panel">
                <div class="cz-panel-header" @click="tlPanels.commerceGuide = !tlPanels.commerceGuide">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6l4 2M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
                        Entity Contract
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="tlPanels.commerceGuide ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="tlPanels.commerceGuide" x-collapse class="cz-panel-body space-y-3 text-sm text-slate-600">
                    {if customizer_scope == 'ecommerce'}
                    <p>The ecommerce workspace edits canonical entity presentation without forking the CMS entity list and entity view contracts.</p>
                    <p>Use this tab for canonical detail, article, and list presentation. Header, sidebar, colors, footer, and Theme Settings stay shell-only so list and single controls live in one place.</p>
                    {else}
                    <p>This entities tab applies canonical presentation to pages, posts, lists, shop, category, and product routes while the active theme shell keeps ownership of the site header, footer, sidebar, and shared layout.</p>
                    <p>Use this tab for canonical detail, article, and list presentation without switching away from the active theme shell.</p>
                    {/if}
                </div>
            </div>

            <div class="cz-panel">
                <div class="cz-panel-header" @click="tlPanels.commerceEntity = !tlPanels.commerceEntity">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h10"/></svg>
                        Entity Presentation
                    </h3>
                    <svg class="w-4 h-4 text-gray-400 transition-transform" :class="tlPanels.commerceEntity ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </div>
                <div x-show="tlPanels.commerceEntity" x-collapse class="cz-panel-body space-y-5">
                    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 space-y-4">
                        <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                            <div class="space-y-1.5">
                                <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-400">Schema Workspace</p>
                                <h4 class="text-sm font-semibold text-slate-800">Registry-driven entity contexts</h4>
                                <p class="text-xs text-slate-500">Choose a representative entity context. These controls are rendered from the entity-context registry and still save to the canonical entity presentation section.</p>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                <template x-for="exampleId in entityContextExampleIds()" :key="'entity-example-' + exampleId">
                                    <button type="button"
                                        @click="entityContextExampleId = exampleId"
                                        class="rounded-full border px-3 py-1.5 text-xs font-medium transition-colors"
                                        :class="entityContextExampleId === exampleId ? 'border-sky-500 bg-sky-600 text-white shadow-sm' : 'border-slate-200 bg-white text-slate-600 hover:border-sky-300 hover:text-sky-700'">
                                        <span x-text="entityContextExampleLabel(exampleId)"></span>
                                    </button>
                                </template>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                            <div class="rounded-lg border border-white/70 bg-white px-3 py-3">
                                <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-400">Entity Type</div>
                                <div class="mt-1 text-sm font-semibold text-slate-800" x-text="entityContextActiveEntityType()"></div>
                            </div>
                            <div class="rounded-lg border border-white/70 bg-white px-3 py-3">
                                <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-400">Base Context</div>
                                <div class="mt-1 text-sm font-semibold text-slate-800" x-text="entityContextActiveBaseLabel()"></div>
                            </div>
                            <div class="rounded-lg border border-white/70 bg-white px-3 py-3">
                                <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-400">Extensions</div>
                                <div class="mt-1 text-sm font-semibold text-slate-800" x-text="entityContextActiveExtensionSummary()"></div>
                            </div>
                        </div>
                        <p class="text-xs text-slate-500" x-text="entityContextActiveDescription()"></p>
                        <div class="flex flex-wrap gap-2">
                            <template x-for="capabilityId in entityContextActiveCapabilities()" :key="'entity-capability-' + capabilityId">
                                <span class="inline-flex items-center rounded-full bg-slate-900 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-white" x-text="entityContextCapabilityLabel(capabilityId)"></span>
                            </template>
                            <span x-show="entityContextActiveCapabilities().length === 0" class="text-xs text-slate-400">This context uses only the shared entity layout sections.</span>
                        </div>
                    </div>

                    <template x-for="section in entityContextActiveSections()" :key="'entity-section-' + section.id">
                        <div class="rounded-xl border border-slate-200 bg-white p-4 space-y-4">
                            <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
                                <div>
                                    <h4 class="text-sm font-semibold text-slate-800" x-text="section.label"></h4>
                                    <p x-show="section.description" class="text-[11px] text-slate-500 mt-1" x-text="section.description"></p>
                                </div>
                                <div class="flex flex-wrap gap-1.5" x-show="entityContextSectionRequirementLabels(section).length > 0">
                                    <template x-for="label in entityContextSectionRequirementLabels(section)" :key="section.id + '-requirement-' + label">
                                        <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-600" x-text="label"></span>
                                    </template>
                                </div>
                            </div>

                            <div x-show="section.fields.length === 0" class="rounded-lg border border-dashed border-slate-200 bg-slate-50 px-3 py-3 text-xs text-slate-500">
                                This context does not add dedicated design controls here. It reuses the shared canonical entity sections above.
                            </div>

                            <div x-show="section.fields.length > 0" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                                <template x-for="field in section.fields" :key="section.id + '-' + field.name">
                                    <div :class="entityContextFieldWrapperClass(field)">
                                        <template x-if="field.type === 'select' || field.type === 'font_select'">
                                            <div>
                                                <label class="cz-label" x-text="field.label"></label>
                                                <select class="cz-select" x-model="entityPresentationSettings[field.name]">
                                                    <option x-show="field.empty_option_label" value="" x-text="field.empty_option_label"></option>
                                                    <template x-for="option in entityContextFieldOptions(field)" :key="field.name + '-' + option.value">
                                                        <option :value="option.value" x-text="option.label"></option>
                                                    </template>
                                                </select>
                                                <p x-show="field.description" class="text-[10px] text-gray-400 mt-1" x-text="field.description"></p>
                                            </div>
                                        </template>

                                        <template x-if="field.type === 'range'">
                                            <div>
                                                <label class="cz-label" x-text="field.label"></label>
                                                <div class="cz-range-row">
                                                    <input type="range" :min="field.min ?? 0" :max="field.max ?? 100" :step="field.step ?? 1" x-model="entityPresentationSettings[field.name]">
                                                    <span class="cz-range-value" x-text="entityContextFieldDisplayValue(field)"></span>
                                                </div>
                                                <p x-show="field.description" class="text-[10px] text-gray-400 mt-1" x-text="field.description"></p>
                                            </div>
                                        </template>

                                        <template x-if="field.type === 'number'">
                                            <div>
                                                <label class="cz-label" x-text="field.label"></label>
                                                <input type="number" class="cz-input" :min="field.min ?? null" :max="field.max ?? null" :step="field.step ?? 1" x-model="entityPresentationSettings[field.name]">
                                                <p class="text-[10px] text-gray-400 mt-1">
                                                    <span x-show="field.description" x-text="field.description"></span>
                                                    <span x-show="!field.description && field.unit" x-text="'Unit: ' + field.unit"></span>
                                                </p>
                                            </div>
                                        </template>

                                        <template x-if="field.type === 'text'">
                                            <div>
                                                <label class="cz-label" x-text="field.label"></label>
                                                <input type="text" class="cz-input" :placeholder="field.placeholder || ''" x-model="entityPresentationSettings[field.name]">
                                                <p x-show="field.description" class="text-[10px] text-gray-400 mt-1" x-text="field.description"></p>
                                            </div>
                                        </template>

                                        <template x-if="field.type === 'toggle'">
                                            <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 flex items-center justify-between gap-3 h-full">
                                                <div>
                                                    <div class="cz-toggle-label" x-text="field.label"></div>
                                                    <p x-show="field.description" class="text-[10px] text-slate-500 mt-1" x-text="field.description"></p>
                                                </div>
                                                <button type="button" @click="entityPresentationSettings[field.name] = entityPresentationSettings[field.name] == 1 ? 0 : 1"
                                                    class="cz-toggle" :class="entityPresentationSettings[field.name] == 1 ? 'cz-toggle-on' : 'cz-toggle-off'">
                                                    <span class="cz-toggle-knob" :class="entityPresentationSettings[field.name] == 1 ? 'cz-toggle-knob-on' : 'cz-toggle-knob-off'"></span>
                                                </button>
                                            </div>
                                        </template>
                                    </div>
                                </template>
                            </div>
                        </div>
                    </template>

                    <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-xs text-slate-600">
                        <div class="font-semibold text-slate-800 mb-1">Profile behavior</div>
                        <div x-show="entityPresentationSettings.entity_layout_profile === 'default'">Default keeps pricing and actions in the main reading flow ahead of the body.</div>
                        <div x-show="entityPresentationSettings.entity_layout_profile === 'commerce'">Commerce moves pricing and actions into a dedicated summary rail for storefront-oriented entities.</div>
                        <div x-show="entityPresentationSettings.entity_layout_profile === 'content'">Content prioritizes the title and body first, then places pricing and actions after the narrative content.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="xl:col-span-4 space-y-5 cz-preview-column">
            <div class="cz-panel sticky top-20">
                <div class="cz-panel-header">
                    <h3>
                        <svg class="w-4 h-4 inline -mt-0.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        Entity Summary
                    </h3>
                </div>
                <div class="cz-panel-body space-y-4">
                    <div class="flex items-center justify-between text-[10px] uppercase tracking-[0.14em] text-gray-400">
                        <span>Canonical Entity Contract</span>
                        <span class="{if customizer_scope == 'ecommerce'}text-amber-700{else}text-emerald-700{/if}">{if customizer_scope == 'ecommerce'}Ecommerce Scope{else}Active Theme Shell{/if}</span>
                    </div>
                    <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 space-y-2">
                        <div class="flex items-center justify-between gap-3">
                            <div>
                                <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-400">Active Schema Example</div>
                                <div class="text-sm font-semibold text-slate-800" x-text="entityContextExampleLabel(entityContextExampleId)"></div>
                            </div>
                            <div class="text-right text-[10px] uppercase tracking-[0.12em] text-slate-400">
                                <div>Capabilities</div>
                                <div class="mt-1 text-sm font-semibold text-slate-700" x-text="entityContextActiveCapabilities().length"></div>
                            </div>
                        </div>
                        <p class="text-[11px] leading-5 text-slate-500" x-text="entityContextActiveDescription()"></p>
                    </div>
                    <div class="space-y-3 text-sm">
                        <div class="flex justify-between"><span class="text-gray-400">Entity Profile</span><span class="font-medium capitalize" x-text="entityPresentationSettings.entity_layout_profile"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Schema Example</span><span class="font-medium" x-text="entityContextExampleLabel(entityContextExampleId)"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Base Context</span><span class="font-medium" x-text="entityContextActiveBaseLabel()"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Extensions</span><span class="font-medium" x-text="entityContextActiveExtensionSummary()"></span></div>
                        <div class="flex justify-between" x-show="entityContextHasCapability('pricing')"><span class="text-gray-400">Pricing Variant</span><span class="font-medium capitalize" x-text="entityPreviewVariantLabel(entityPreviewPricingVariant())"></span></div>
                        <div class="flex justify-between" x-show="entityContextHasCapability('booking') || entityContextHasCapability('inquiry')"><span class="text-gray-400">Action Variant</span><span class="font-medium capitalize" x-text="entityPreviewVariantLabel(entityPreviewActionVariant())"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Summary Width</span><span class="font-medium" x-text="entityPresentationSettings.entity_summary_width + 'px'"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Sticky Rail</span><span class="font-medium" x-text="entityPresentationSettings.entity_summary_sticky == 1 ? 'On' : 'Off'"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Media Ratio</span><span class="font-medium" x-text="entityPresentationSettings.entity_media_ratio"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Spacing</span><span class="font-medium capitalize" x-text="entityPresentationSettings.entity_spacing_scale"></span></div>
                        <div class="flex justify-between" x-show="entityContextHasCapability('booking') || entityContextHasCapability('inquiry')"><span class="text-gray-400">Action Size</span><span class="font-medium uppercase" x-text="entityPresentationSettings.entity_action_size"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Card Density</span><span class="font-medium capitalize" x-text="entityPresentationSettings.entity_list_card_density"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Filter Summary</span><span class="font-medium" x-text="entityPresentationSettings.entity_list_show_filter_summary == 1 ? 'On' : 'Off'"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Shop Categories</span><span class="font-medium" x-text="entityPresentationSettings.entity_list_category_navigation === 'dropdown' ? 'Dropdown' : 'List'"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Card Excerpts</span><span class="font-medium" x-text="entityPresentationSettings.entity_list_show_excerpt == 1 ? 'On' : 'Off'"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Excerpt Length</span><span class="font-medium" x-text="entityPresentationSettings.entity_list_excerpt_length + ' chars'"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">List Layout</span><span class="font-medium capitalize" x-text="entityPresentationSettings.blog_layout + (entityPresentationSettings.blog_layout !== 'list' ? ' (' + entityPresentationSettings.blog_columns + ' cols)' : '')"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">List Elements</span><span class="font-medium" x-text="[entityPresentationSettings.blog_show_author == 1 ? 'Author' : '', entityPresentationSettings.blog_show_date == 1 ? 'Date' : '', entityPresentationSettings.blog_show_excerpt == 1 ? 'Excerpt' : '', entityPresentationSettings.blog_show_readmore == 1 ? 'Read More' : ''].filter(Boolean).join(', ') || 'None'"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Title Font</span><span class="font-medium" x-text="catalogFontLabel(entityPresentationSettings.entity_list_title_font, 'Theme heading')"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Text Font</span><span class="font-medium" x-text="catalogFontLabel(entityPresentationSettings.entity_list_text_font, 'Theme body')"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Title Size</span><span class="font-medium" x-text="entityPresentationSettings.entity_list_title_size + 'px'"></span></div>
                        <div class="flex justify-between" x-show="entityContextHasCapability('pricing')"><span class="text-gray-400">Price Size</span><span class="font-medium" x-text="entityPresentationSettings.entity_list_price_size + 'px'"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Card Min Width</span><span class="font-medium" x-text="entityPresentationSettings.entity_list_card_min_width + 'px'"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Title Clamp</span><span class="font-medium" x-text="entityPresentationSettings.entity_list_title_lines + ' lines'"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Detail Width</span><span class="font-medium" x-text="entityPresentationSettings.single_max_width + 'px'"></span></div>
                        <div class="flex justify-between"><span class="text-gray-400">Detail Elements</span><span class="font-medium" x-text="[entityPresentationSettings.single_show_author == 1 ? 'Author' : '', entityPresentationSettings.single_show_date == 1 ? 'Date' : '', entityPresentationSettings.single_show_categories == 1 ? 'Cats' : '', entityPresentationSettings.single_show_tags == 1 ? 'Tags' : '', entityPresentationSettings.single_show_nav == 1 ? 'Back Link' : ''].filter(Boolean).join(', ') || 'None'"></span></div>
                        <div class="flex justify-between" x-show="entityContextHasCapability('pricing')"><span class="text-gray-400">List Price Variant</span><span class="font-medium capitalize" x-text="entityPreviewVariantLabel(entityPreviewListPricingVariant())"></span></div>
                        <div class="flex justify-between" x-show="entityContextHasCapability('inventory')"><span class="text-gray-400">List Inventory Variant</span><span class="font-medium capitalize" x-text="entityPreviewVariantLabel(entityPreviewListInventoryVariant())"></span></div>
                        <div class="flex justify-between" x-show="entityContextHasCapability('progress_tracking')"><span class="text-gray-400">List Progress Variant</span><span class="font-medium capitalize" x-text="entityPreviewVariantLabel(entityPreviewListProgressVariant())"></span></div>
                    </div>
                    <div class="rounded-lg border border-gray-200 bg-white p-3 space-y-3">
                        <div :style="entityPreviewHeroStyle()">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        </div>
                        <div :style="entityPreviewLayoutStyle()">
                            <div class="space-y-2">
                                <div class="h-3 bg-slate-800 rounded w-2/3"></div>
                                <div class="space-y-1.5">
                                    <div class="h-1 bg-gray-200 rounded w-full"></div>
                                    <div class="h-1 bg-gray-200 rounded w-5/6"></div>
                                </div>
                            </div>
                            <div x-show="entityPresentationSettings.entity_layout_profile === 'commerce' && (entityContextHasCapability('pricing') || entityContextHasCapability('inventory') || entityContextHasCapability('booking') || entityContextHasCapability('inquiry'))" :style="entityPreviewSummaryStyle()">
                                <div x-show="entityContextHasCapability('pricing')" :style="entityPreviewSummaryPricingStyle()">
                                    <span :style="entityPreviewSummaryCurrentPriceStyle()">USD 79.00</span>
                                    <span x-show="entityPreviewPricingVariant() !== 'minimal'" class="text-xs line-through text-gray-400">99.00</span>
                                    <span x-show="entityPreviewPricingVariant() === 'featured'" class="inline-flex items-center rounded-full bg-slate-900 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.12em] text-white">Offer</span>
                                </div>
                                <div x-show="entityContextHasCapability('inventory')" class="inline-flex items-center rounded-full px-2.5 py-1 text-[10px] font-semibold mb-2" :style="entityPreviewInventoryStyle('low')">Only 3 left</div>
                                <div x-show="entityContextHasCapability('booking') || entityContextHasCapability('inquiry')" :style="entityPreviewActionGroupStyle()">
                                    <span x-show="entityContextHasCapability('booking')" :style="entityPreviewPrimaryActionStyle()" x-text="entityContextHasCapability('pricing') ? 'Add to Cart' : 'Book Now'"></span>
                                    <span x-show="entityContextHasCapability('inquiry')" :style="entityPreviewSecondaryActionStyle()">Ask a Question</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="rounded-lg border border-gray-200 bg-white p-3 space-y-3">
                        <div class="flex items-center justify-between text-[10px] uppercase tracking-[0.14em] text-gray-400">
                            <span>List Card Preview</span>
                            <span x-text="entityPreviewVariantLabel(entityPreviewListPricingVariant()) + ' / ' + entityPreviewVariantLabel(entityPreviewListInventoryVariant()) + ' / ' + entityPreviewVariantLabel(entityPreviewListProgressVariant())"></span>
                        </div>
                        <div :style="entityPreviewListCardStyle()">
                            <div class="space-y-1.5">
                                <div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-400" :style="entityPreviewCatalogLabelStyle()">New in</div>
                                <div class="text-slate-900" :style="entityPreviewCatalogTitleStyle()">Long catalog product names wrap cleanly without colliding with adjacent cards.</div>
                                <p x-show="entityPresentationSettings.entity_list_show_excerpt == 1" class="text-[11px] leading-5 text-slate-500" :style="entityPreviewCatalogExcerptStyle()">Small-batch loaf baked daily and finished with a blistered crust.</p>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                <div x-show="entityContextHasCapability('pricing')" :style="entityPreviewListPricingStyle()">
                                    <span :style="entityPreviewListPricingCurrentStyle()">USD 12.00</span>
                                    <span x-show="entityPreviewListPricingVariant() !== 'minimal'" class="text-[10px] line-through text-gray-400">16.00</span>
                                    <span x-show="entityPreviewListPricingVariant() === 'featured'" class="inline-flex items-center rounded-full bg-slate-900 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.12em] text-white">Offer</span>
                                </div>
                                <span x-show="entityContextHasCapability('inventory')" :style="entityPreviewListInventoryStyle()" x-text="entityPreviewListInventoryLabel()"></span>
                            </div>
                            <div x-show="entityContextHasCapability('progress_tracking')" :style="entityPreviewListProgressStyle()">
                                <span class="text-[10px] font-medium text-slate-500">25% complete</span>
                                <span :style="entityPreviewListProgressTrackStyle()">
                                    <span :style="entityPreviewListProgressBarStyle()"></span>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="text-xs text-slate-500">These controls alter the canonical entity presentation layer. CMS content routes can still resolve to the content profile while ecommerce routes use the commerce profile inside the same shared contract.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Unsaved changes indicator -->
    <div x-show="dirty" x-transition class="fixed bottom-4 left-1/2 -translate-x-1/2 z-30">
        <div class="flex items-center gap-3 bg-gray-900 text-white px-5 py-2.5 rounded-full shadow-lg text-sm">
            <span class="w-2 h-2 bg-amber-400 rounded-full animate-pulse"></span>
            Unsaved changes
            <button @click="save()" class="px-3 py-1 bg-sky-600 rounded-full text-xs font-medium hover:bg-sky-500 transition-colors">Save</button>
        </div>
    </div>
</div>

<script>
function themeCustomizer() {
    return {
        activeTab: '{if customizer_scope == 'ecommerce'}navigation{else}footer{/if}',
        saving: false,
        dirty: false,
        studioViewport: 'desktop',
        dirtySections: { footer: false, header: false, sidebar: false, colors: false, custom_code: false, theme: false, entity_presentation: false },
        customizerScope: '{if customizer_scope}{customizer_scope}{else}native{/if}',
        customizerApiBase: '{if customizer_api_base}{customizer_api_base}{else}{base_url}/api/v1/cms/customizer{/if}',
        draggedWidgetId: null,
        expandedWidgets: {},
        panels: { layout: true, colors: false, bar: true, widgets: true, help: false },
        nPanels: { sources: true, desktop: true, mobile: true },
        hPanels: { layout: true, branding: false, cta: false, colors: false, dropdown: false, transparent: false, widgets: false, mobile: false },
        sPanels: { layout: true, appearance: false, widgets: true },
        cPanels: { brand: true, body: false, typo: false, layout: false, storefront: true },
        ccPanels: { css: true, head: false, body: false, enhancements: true },
        tlPanels: { site: true, blog: true, single: false, entity: true, commerceGuide: true, commerceEntity: true },
        tlPreviewMode: 'page',

        // Theme layout settings (hydrated from server)
        themeLayoutSettings: {},

        // Canonical entity presentation settings (hydrated from server)
        entityPresentationSettings: {},
        themeManifestBlockVariants: {},
        entityContextCatalog: {},
        entityContextExamples: {},
        entityContextExampleId: '',

        // Footer settings (hydrated from server)
        footerSettings: {},

        // Colors & typography settings (hydrated from server)
        colorsSettings: {},
        // Custom code settings (hydrated from server)
        customCodeSettings: {},
        footerWidgets: [],

        // Header settings (hydrated from server)
        headerSettings: {},
        headerWidgets: [],
        expandedHeaderWidgets: {},

        // Sidebar settings (hydrated from server)
        sidebarSettings: {},
        sidebarWidgets: [],
        expandedSidebarWidgets: {},

        // Transient overlay color decomposition (hex + opacity)
        _overlayHex: '#000000',
        _overlayOpacity: 50,
        _mobileBgHex: '#ffffff',
        _mobileBgOpacity: 100,

        // Available menus for nav_menu widget
        availableMenus: [],
        availableMenuLocations: [],
        availableSidebarTemplates: [],
        sidebarTemplateFileExists: false,

        // Site info
        siteTitle: '',
        siteTagline: '',

        // Widget type definitions
        widgetTypes: [
            { type: 'text',         label: 'Text',          icon: '📝', desc: 'Rich text content block' },
            { type: 'custom_html',  label: 'Custom HTML',   icon: '🔧', desc: 'Raw HTML, embeds, or scripts' },
            { type: 'nav_menu',     label: 'Navigation',    icon: '☰',  desc: 'Display a site navigation menu' },
            { type: 'recent_posts', label: 'Recent Posts',  icon: '📄', desc: 'List of latest published posts' },
            { type: 'social_links', label: 'Social Links',  icon: '🔗', desc: 'Icons from CMS social settings' },
            { type: 'contact_info', label: 'Contact Info',  icon: '📍', desc: 'Address, phone, and email' },
        ],

        sidebarWidgetTypes: [
            { type: 'text',         label: 'Text',          icon: '📝', desc: 'Rich text content block' },
            { type: 'custom_html',  label: 'Custom HTML',   icon: '🔧', desc: 'Raw HTML, embeds, or scripts' },
            { type: 'nav_menu',     label: 'Navigation',    icon: '☰',  desc: 'Display a site navigation menu' },
            { type: 'recent_posts', label: 'Recent Posts',  icon: '📄', desc: 'List of latest published posts' },
            { type: 'social_links', label: 'Social Links',  icon: '🔗', desc: 'Icons from CMS social settings' },
            { type: 'contact_info', label: 'Contact Info',  icon: '📍', desc: 'Address, phone, and email' },
            { type: 'search_box',   label: 'Search Box',    icon: '🔎', desc: 'Site search input and button' },
            { type: 'categories',   label: 'Categories',    icon: '🗂️', desc: 'List post categories with counts' },
            { type: 'tag_cloud',    label: 'Tag Cloud',     icon: '🏷️', desc: 'Popular tags from published posts' },
            { type: 'archives',     label: 'Archives',      icon: '🗓️', desc: 'Browse posts by month/year' },
            { type: 'cta_button',   label: 'CTA Button',    icon: '🔘', desc: 'Prominent call-to-action link' },
        ],

        // Header widget types (subset suitable for header bar)
        headerWidgetTypes: [
            { type: 'text',         label: 'Text',          icon: '📝', desc: 'Short inline text / announcement' },
            { type: 'custom_html',  label: 'Custom HTML',   icon: '🔧', desc: 'Raw HTML snippet' },
            { type: 'social_links', label: 'Social Links',  icon: '🔗', desc: 'Social media icons' },
            { type: 'contact_info', label: 'Contact Info',  icon: '📞', desc: 'Phone and email' },
            { type: 'nav_menu',     label: 'Navigation',    icon: '☰',  desc: 'Display a site menu' },
            { type: 'button',       label: 'Button / Link', icon: '🔘', desc: 'Small CTA or link button' },
            { type: 'opening_hours',label: 'Opening Hours', icon: '🕐', desc: 'Business hours display' },
        ],

        // Color field definitions
        widgetColorFields: [
            { key: 'bg_color',         label: 'Background' },
            { key: 'text_color',       label: 'Text' },
            { key: 'link_color',       label: 'Links' },
            { key: 'link_hover_color', label: 'Link Hover' },
            { key: 'title_color',      label: 'Widget Titles' },
        ],
        barColorFields: [
            { key: 'bar_bg_color',         label: 'Background' },
            { key: 'bar_text_color',       label: 'Text' },
            { key: 'bar_link_color',       label: 'Links' },
            { key: 'bar_link_hover_color', label: 'Link Hover' },
        ],

        // Header color field definitions
        headerColorFields: [
            { key: 'bg_color',         label: 'Background' },
            { key: 'text_color',       label: 'Text' },
            { key: 'link_color',       label: 'Links' },
            { key: 'link_hover_color', label: 'Link Hover' },
            { key: 'logo_color',       label: 'Logo' },
            { key: 'border_color',     label: 'Border' },
        ],
        headerMobileColorFields: [
            { key: 'mobile_bg_color',   label: 'Mobile Background' },
            { key: 'mobile_text_color', label: 'Mobile Text' },
        ],
        headerDropdownColorFields: [
            { key: 'dropdown_bg_color', label: 'Dropdown Background' },
            { key: 'dropdown_text_color', label: 'Dropdown Text' },
            { key: 'dropdown_hover_bg_color', label: 'Item Hover Background' },
            { key: 'dropdown_hover_text_color', label: 'Item Hover Text' },
            { key: 'dropdown_border_color', label: 'Dropdown Border' },
        ],

        // Top bar color fields
        topbarColorFields: [
            { key: 'topbar_bg_color',         label: 'Background' },
            { key: 'topbar_text_color',       label: 'Text' },
            { key: 'topbar_link_color',       label: 'Links' },
            { key: 'topbar_link_hover_color', label: 'Link Hover' },
        ],
        sidebarColorFields: [
            { key: 'widget_bg_color', label: 'Widget Background' },
            { key: 'widget_text_color', label: 'Widget Text' },
            { key: 'widget_title_color', label: 'Widget Title' },
            { key: 'widget_border_color', label: 'Widget Border' },
            { key: 'widget_link_color', label: 'Widget Link' },
            { key: 'widget_link_hover_color', label: 'Widget Link Hover' },
        ],

        // Colors & Typography field definitions
        brandColorFields: [
            { key: 'color_primary',   label: 'Primary' },
            { key: 'color_secondary', label: 'Secondary' },
            { key: 'color_accent',    label: 'Accent' },
        ],
        bodyColorFields: [
            { key: 'body_bg_color',   label: 'Background' },
            { key: 'body_text_color', label: 'Body Text' },
            { key: 'body_text_light', label: 'Muted Text' },
            { key: 'body_link_color', label: 'Links' },
            { key: 'body_link_hover', label: 'Link Hover' },
            { key: 'border_color',    label: 'Borders' },
            { key: 'light_bg_color',  label: 'Light Surface' },
        ],
        storefrontSurfaceColorFields: [
            { key: 'storefront_surface_bg', label: 'Summary Surface' },
            { key: 'storefront_surface_border', label: 'Summary Border' },
            { key: 'storefront_price_color', label: 'Price' },
            { key: 'storefront_badge_bg', label: 'Badge Background' },
            { key: 'storefront_badge_text', label: 'Badge Text' },
        ],
        storefrontActionColorFields: [
            { key: 'storefront_cta_bg', label: 'Primary CTA Background' },
            { key: 'storefront_cta_text', label: 'Primary CTA Text' },
            { key: 'storefront_secondary_bg', label: 'Secondary Background' },
            { key: 'storefront_secondary_text', label: 'Secondary Text' },
            { key: 'storefront_secondary_border', label: 'Secondary Border' },
        ],
        storefrontInventoryColorFields: [
            { key: 'storefront_success_bg', label: 'In Stock Background' },
            { key: 'storefront_success_text', label: 'In Stock Text' },
            { key: 'storefront_warning_bg', label: 'Low Stock Background' },
            { key: 'storefront_warning_text', label: 'Low Stock Text' },
            { key: 'storefront_danger_bg', label: 'Out Background' },
            { key: 'storefront_danger_text', label: 'Out Text' },
        ],
        fontOptions: [
            { value: 'Inter',            label: 'Inter' },
            { value: 'Roboto',           label: 'Roboto' },
            { value: 'Open Sans',        label: 'Open Sans' },
            { value: 'Lato',             label: 'Lato' },
            { value: 'Montserrat',       label: 'Montserrat' },
            { value: 'Poppins',          label: 'Poppins' },
            { value: 'Playfair Display', label: 'Playfair Display' },
            { value: 'Merriweather',     label: 'Merriweather' },
            { value: 'DM Sans',          label: 'DM Sans' },
            { value: 'Nunito',           label: 'Nunito' },
            { value: 'Source Sans Pro',  label: 'Source Sans Pro' },
            { value: 'Georgia',          label: 'Georgia' },
            { value: 'system-ui',        label: 'System UI' },
        ],

        studioPreviewHref() {
            return this.customizerScope === 'ecommerce' ? '{base_url}/ecommerce/shop' : '{base_url}/cms';
        },

        studioPreviewLabel() {
            return this.customizerScope === 'ecommerce' ? 'Storefront preview target' : 'Theme shell preview target';
        },

        studioStatusLabel() {
            if (this.saving) return 'Saving changes';
            if (this.dirty) return 'Unsaved changes';
            return 'All changes saved';
        },

        studioStatusDetail() {
            if (this.saving) return 'Applying your latest theme updates now.';
            if (this.dirty) return 'Review the preview and save when you are ready to publish.';
            return 'The live preview reflects the currently saved theme settings.';
        },

        entityContextExampleIds() {
            const available = Object.keys(this.entityContextExamples || {});
            const preferred = ['content', 'business', 'guidance', 'hybrid'];
            const ordered = preferred.filter((id) => available.includes(id));
            available.sort().forEach((id) => {
                if (!ordered.includes(id)) {
                    ordered.push(id);
                }
            });
            return ordered;
        },

        entityContextPreferredExampleId() {
            const available = this.entityContextExampleIds();
            const preferred = this.customizerScope === 'ecommerce'
                ? ['hybrid', 'business', 'guidance', 'content']
                : ['content', 'business', 'guidance', 'hybrid'];

            for (const id of preferred) {
                if (available.includes(id)) {
                    return id;
                }
            }

            return available[0] || '';
        },

        entityContextExampleLabel(exampleId) {
            const example = (this.entityContextExamples || {})[exampleId] || {};
            const explicit = ((example.label || '') + '').trim();
            return explicit !== '' ? explicit : this.entityPreviewVariantLabel(exampleId);
        },

        entityContextActiveExample() {
            const available = this.entityContextExampleIds();
            if (available.length === 0) {
                return {};
            }

            return (this.entityContextExamples || {})[this.entityContextExampleId] || (this.entityContextExamples || {})[available[0]] || {};
        },

        entityContextActiveSchema() {
            const example = this.entityContextActiveExample();
            return example && typeof example.schema === 'object' && example.schema ? example.schema : {};
        },

        entityContextActiveResolvedContext() {
            const example = this.entityContextActiveExample();
            return example && typeof example.resolved_context === 'object' && example.resolved_context ? example.resolved_context : {};
        },

        entityContextActiveEntityType() {
            const resolved = this.entityContextActiveResolvedContext();
            const entityType = ((resolved.entity_type || '') + '').trim();
            return entityType !== '' ? entityType : 'page';
        },

        entityContextActiveBaseLabel() {
            const resolved = this.entityContextActiveResolvedContext();
            const binding = resolved && typeof resolved.binding === 'object' && resolved.binding ? resolved.binding : {};
            const base = ((binding.base || '') + '').trim();
            return base !== '' ? this.entityPreviewVariantLabel(base) : 'None';
        },

        entityContextActiveExtensionSummary() {
            const resolved = this.entityContextActiveResolvedContext();
            const binding = resolved && typeof resolved.binding === 'object' && resolved.binding ? resolved.binding : {};
            const extensions = Array.isArray(binding.extensions) ? binding.extensions : [];
            if (extensions.length === 0) {
                return 'None';
            }
            return extensions.map((extensionId) => this.entityPreviewVariantLabel(extensionId)).join(', ');
        },

        entityContextActiveDescription() {
            const example = this.entityContextActiveExample();
            const description = ((example.description || '') + '').trim();
            if (description !== '') {
                return description;
            }

            return 'Schema derived from the entity context registry.';
        },

        entityContextActiveCapabilities() {
            const schema = this.entityContextActiveSchema();
            if (Array.isArray(schema.resolved_capabilities)) {
                return schema.resolved_capabilities;
            }

            const resolved = this.entityContextActiveResolvedContext();
            return Array.isArray(resolved.capability_ids) ? resolved.capability_ids : [];
        },

        entityContextHasCapability(capabilityId) {
            return this.entityContextActiveCapabilities().includes(capabilityId);
        },

        entityContextCapabilityLabel(capabilityId) {
            const catalog = this.entityContextCatalog && typeof this.entityContextCatalog.capabilities === 'object'
                ? this.entityContextCatalog.capabilities
                : {};
            const capability = catalog[capabilityId] || {};
            const label = ((capability.label || '') + '').trim();
            return label !== '' ? label : this.entityPreviewVariantLabel(capabilityId);
        },

        entityContextVisibilitySatisfied(visibility) {
            const rules = visibility && typeof visibility === 'object' ? visibility : {};
            const active = this.entityContextActiveCapabilities();
            const requiresAny = Array.isArray(rules.requires_any_capabilities) ? rules.requires_any_capabilities : [];
            const requiresAll = Array.isArray(rules.requires_all_capabilities) ? rules.requires_all_capabilities : [];

            if (requiresAny.length > 0 && !requiresAny.some((capabilityId) => active.includes(capabilityId))) {
                return false;
            }

            if (requiresAll.length > 0 && !requiresAll.every((capabilityId) => active.includes(capabilityId))) {
                return false;
            }

            return true;
        },

        entityContextFieldDependencyMet(field) {
            const dependency = field && typeof field.depends_on === 'object' && !Array.isArray(field.depends_on)
                ? field.depends_on
                : null;
            if (!dependency) {
                return true;
            }

            const dependencyField = ((dependency.field || '') + '').trim();
            if (dependencyField === '') {
                return true;
            }

            const currentValue = this.entityPresentationSettings[dependencyField];
            const operator = ((dependency.operator || '==') + '').trim();
            const expected = dependency.value;

            if (operator === '!=') {
                return String(currentValue) !== String(expected);
            }
            if (operator === 'truthy') {
                return !!currentValue && String(currentValue) !== '0';
            }
            if (operator === 'falsy') {
                return !currentValue || String(currentValue) === '0';
            }

            return String(currentValue) === String(expected);
        },

        entityContextSectionVisible(section) {
            return this.entityContextVisibilitySatisfied(section && typeof section.visibility === 'object' ? section.visibility : {});
        },

        entityContextFieldVisible(field) {
            return this.entityContextVisibilitySatisfied(field && typeof field.visibility === 'object' ? field.visibility : {})
                && this.entityContextFieldDependencyMet(field);
        },

        entityContextSectionRequirementLabels(section) {
            const visibility = section && typeof section.visibility === 'object' ? section.visibility : {};
            const required = [];
            const requiresAny = Array.isArray(visibility.requires_any_capabilities) ? visibility.requires_any_capabilities : [];
            const requiresAll = Array.isArray(visibility.requires_all_capabilities) ? visibility.requires_all_capabilities : [];

            requiresAny.concat(requiresAll).forEach((capabilityId) => {
                const label = this.entityContextCapabilityLabel(capabilityId);
                if (label !== '' && !required.includes(label)) {
                    required.push(label);
                }
            });

            return required;
        },

        entityContextFieldOptions(field) {
            return Array.isArray(field && field.options) ? field.options : [];
        },

        entityContextFieldDisplayValue(field) {
            const fallback = field && field.default !== undefined && field.default !== null ? field.default : '';
            const rawValue = field ? this.entityPresentationSettings[field.name] : '';
            const value = rawValue === undefined || rawValue === null || rawValue === '' ? fallback : rawValue;
            const unit = ((field && field.unit) || '') + '';
            return '' + value + (unit !== '' ? ' ' + unit : '');
        },

        entityContextFieldWrapperClass(field) {
            return field && field.type === 'text' ? 'sm:col-span-2' : '';
        },

        entityContextActiveSections() {
            const schema = this.entityContextActiveSchema();
            const sections = Array.isArray(schema.sections) ? schema.sections : [];

            return sections
                .filter((section) => this.entityContextSectionVisible(section))
                .map((section) => {
                    const fields = Array.isArray(section.fields) ? section.fields.filter((field) => this.entityContextFieldVisible(field)) : [];
                    return Object.assign({}, section, { fields });
                })
                .filter((section) => section.fields.length > 0 || (((section.description || '') + '').trim() !== ''));
        },

        tabDescription() {
            if (this.customizerScope === 'ecommerce') {
                if (this.activeTab === 'header') return 'Branding, top bar content, sticky behavior, and the visual shell of the storefront header.';
                if (this.activeTab === 'navigation') return 'Desktop and mobile menu selection, dropdown behavior, search visibility, and responsive navigation patterns.';
                if (this.activeTab === 'sidebar') return 'Sidebar widgets, placement, template targeting, and storefront rail behavior for commerce pages.';
                if (this.activeTab === 'footer') return 'Footer composition, split widget container and holder widths, footer-bar content, and navigation-driven footer structure.';
                if (this.activeTab === 'colors') return 'Store palette, typography, and shared surface tokens for the ecommerce storefront.';
                if (this.activeTab === 'custom_code') return 'Custom CSS overrides, code injection, and advanced storefront enhancements scoped to ecommerce.';
                if (this.activeTab === 'theme') return 'Shared shell layout, container width, content width, and shell spacing for the storefront wrapper.';
                if (this.activeTab === 'commerce') return 'Canonical entity presentation across CMS and commerce routes: detail layout, list presentation, and approved block variants.';
                return 'Configure the storefront shell and the canonical entity contract from one workspace.';
            }

            if (this.activeTab === 'header') return 'Customize your site\'s header layout, navigation, and styling.';
            if (this.activeTab === 'navigation') return 'Choose desktop and mobile menu sources, dropdown behavior, and responsive navigation patterns.';
            if (this.activeTab === 'sidebar') return 'Configure sidebar widgets, placement, and template targeting.';
            if (this.activeTab === 'colors') return 'Global colors, typography, and body styles used when header and footer tabs do not override them.';
            if (this.activeTab === 'custom_code') return 'Custom CSS overrides, code injection, and advanced enhancements.';
            if (this.activeTab === 'theme') return 'Site shell layout, content width, and shared spacing. Canonical list and detail presentation lives in Entities.';
            if (this.activeTab === 'commerce') return 'Canonical entity presentation for pages, posts, lists, and commerce routes inside the active theme shell.';
            return 'Customize your site\'s footer layout, widgets, and styling.';
        },

        entitySpacingConfig() {
            const settings = this.entitySettings();
            const scale = settings.entity_spacing_scale || 'comfortable';
            if (scale === 'compact') {
                return { gap: '12px', pad: '12px' };
            }
            if (scale === 'airy') {
                return { gap: '24px', pad: '20px' };
            }
            return { gap: '16px', pad: '16px' };
        },

        entityActionConfig() {
            const settings = this.entitySettings();
            const size = settings.entity_action_size || 'md';
            if (size === 'sm') {
                return { px: '12px', py: '8px', font: '11px' };
            }
            if (size === 'lg') {
                return { px: '20px', py: '12px', font: '14px' };
            }
            return { px: '16px', py: '10px', font: '12px' };
        },

        entityPreviewHeroStyle() {
            const settings = this.entitySettings();
            const ratio = settings.entity_media_ratio || 'auto';
            let css = 'background:linear-gradient(135deg,#dbeafe 0%,#e0f2fe 100%);border-radius:12px;display:flex;align-items:center;justify-content:center;color:#64748b;';
            if (ratio === '16:9') css += 'aspect-ratio:16 / 9;';
            else if (ratio === '4:3') css += 'aspect-ratio:4 / 3;';
            else if (ratio === '1:1') css += 'aspect-ratio:1 / 1;';
            else css += 'height:88px;';
            return css;
        },

        entityPreviewLayoutStyle() {
            const settings = this.entitySettings();
            const gap = this.entitySpacingConfig().gap;
            if ((settings.entity_layout_profile || 'default') === 'commerce') {
                return 'display:grid;grid-template-columns:minmax(0,1fr) ' + (settings.entity_summary_width || 320) + 'px;gap:' + gap + ';align-items:start;';
            }
            return 'display:block;';
        },

        entitySettings() {
            return this.entityPresentationSettings;
        },

        entityPreviewEffectiveVariant(blockId, selectedValue) {
            const explicit = ((selectedValue ?? '') + '').trim();
            if (explicit !== '') {
                return explicit;
            }
            const manifestValue = ((this.themeManifestBlockVariants?.[blockId] ?? '') + '').trim();
            return manifestValue !== '' ? manifestValue : 'default';
        },

        entityPreviewVariantLabel(variant) {
            const normalized = (((variant || 'default') + '').replace(/-/g, ' ')).trim();
            if (normalized === '') {
                return 'Default';
            }
            return normalized.charAt(0).toUpperCase() + normalized.slice(1);
        },

        catalogFontLabel(value, fallbackLabel) {
            const normalized = ((value || '') + '').trim();
            return normalized !== '' ? normalized : fallbackLabel;
        },

        previewFontFamily(value, fallback = 'system-ui,-apple-system,BlinkMacSystemFont,sans-serif') {
            const normalized = ((value || '') + '').replace(/[\'"]/g, '').trim();
            if (normalized === '') return fallback;
            const lower = normalized.toLowerCase();
            if (lower === 'system-ui') return 'system-ui,-apple-system,BlinkMacSystemFont,sans-serif';
            if (lower === 'serif' || lower === 'sans-serif' || lower === 'monospace') return lower;
            if (lower === 'georgia') return '\'Georgia\',serif';
            return '\'' + normalized + '\',sans-serif';
        },

        entityPreviewPricingVariant() {
            return this.entityPreviewEffectiveVariant('pricing', this.entitySettings().entity_pricing_variant);
        },

        entityPreviewActionVariant() {
            return this.entityPreviewEffectiveVariant('action', this.entitySettings().entity_action_variant);
        },

        entityPreviewListPricingVariant() {
            return this.entityPreviewEffectiveVariant('list-card-pricing', this.entitySettings().entity_list_pricing_variant);
        },

        entityPreviewListInventoryVariant() {
            return this.entityPreviewEffectiveVariant('list-card-inventory', this.entitySettings().entity_list_inventory_variant);
        },

        entityPreviewListProgressVariant() {
            return this.entityPreviewEffectiveVariant('list-card-progress', this.entitySettings().entity_list_progress_variant);
        },

        colorAlpha(color, alpha, fallback = '#000000') {
            const value = (color || fallback || '#000000').trim();
            const hex = value.match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/i);
            if (hex) {
                let normalized = hex[1];
                if (normalized.length === 3) {
                    normalized = normalized.split('').map((ch) => ch + ch).join('');
                }
                const red = parseInt(normalized.slice(0, 2), 16);
                const green = parseInt(normalized.slice(2, 4), 16);
                const blue = parseInt(normalized.slice(4, 6), 16);
                return 'rgba(' + red + ',' + green + ',' + blue + ',' + alpha + ')';
            }
            const rgb = value.match(/^rgba?\(\s*([0-9.]+)\s*,\s*([0-9.]+)\s*,\s*([0-9.]+)(?:\s*,\s*[0-9.]+\s*)?\)$/i);
            if (rgb) {
                return 'rgba(' + rgb[1] + ',' + rgb[2] + ',' + rgb[3] + ',' + alpha + ')';
            }
            return 'rgba(0,0,0,' + alpha + ')';
        },

        entityPreviewSummaryStyle() {
            return 'background:' + (this.colorsSettings.storefront_surface_bg || '#ffffff')
                + ';border:1px solid ' + (this.colorsSettings.storefront_surface_border || '#e2e8f0')
                + ';border-radius:16px;padding:' + this.entitySpacingConfig().pad
                + ';box-shadow:0 10px 24px ' + this.colorAlpha(this.colorsSettings.body_text_color || '#1e293b', 0.06) + ';';
        },

        entityPreviewSummaryPricingStyle() {
            const variant = this.entityPreviewPricingVariant();
            let css = 'display:flex;align-items:flex-end;flex-wrap:wrap;gap:8px;margin-bottom:8px;';
            if (variant === 'featured') {
                css += 'padding:12px;border:1px solid ' + this.colorAlpha(this.colorsSettings.storefront_cta_bg || '#0284c7', 0.18)
                    + ';background:' + this.colorAlpha(this.colorsSettings.storefront_cta_bg || '#0284c7', 0.1)
                    + ';border-radius:16px;';
            }
            return css;
        },

        entityPreviewSummaryCurrentPriceStyle() {
            const variant = this.entityPreviewPricingVariant();
            return 'color:' + (this.colorsSettings.storefront_price_color || '#0f172a')
                + ';font-weight:700;'
                + (variant === 'minimal' ? 'font-size:15px;' : 'font-size:18px;');
        },

        entityPreviewPrimaryActionStyle() {
            const size = this.entityActionConfig();
            return 'background:' + (this.colorsSettings.storefront_cta_bg || '#0284c7')
                + ';color:' + (this.colorsSettings.storefront_cta_text || '#ffffff')
                + ';padding:' + size.py + ' ' + size.px
                + ';font-size:' + size.font
                + ';border-radius:12px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;';
        },

        entityPreviewSecondaryActionStyle() {
            const size = this.entityActionConfig();
            return 'background:' + (this.colorsSettings.storefront_secondary_bg || '#ffffff')
                + ';color:' + (this.colorsSettings.storefront_secondary_text || '#334155')
                + ';border:1px solid ' + (this.colorsSettings.storefront_secondary_border || '#cbd5e1')
                + ';padding:' + size.py + ' ' + size.px
                + ';font-size:' + size.font
                + ';border-radius:12px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;';
        },

        entityPreviewActionGroupStyle() {
            return this.entityPreviewActionVariant() === 'inline'
                ? 'display:flex;flex-wrap:wrap;gap:8px;align-items:center;'
                : 'display:flex;flex-direction:column;gap:8px;';
        },

        entityPreviewInventoryStyle(kind) {
            if (kind === 'low') {
                return 'background:' + (this.colorsSettings.storefront_warning_bg || '#fffbeb') + ';color:' + (this.colorsSettings.storefront_warning_text || '#b45309') + ';';
            }
            if (kind === 'out') {
                return 'background:' + (this.colorsSettings.storefront_danger_bg || '#fef2f2') + ';color:' + (this.colorsSettings.storefront_danger_text || '#dc2626') + ';';
            }
            return 'background:' + (this.colorsSettings.storefront_success_bg || '#ecfdf5') + ';color:' + (this.colorsSettings.storefront_success_text || '#047857') + ';';
        },

        entityPreviewCatalogLabelStyle() {
            const font = this.previewFontFamily(this.entitySettings().entity_list_text_font || this.colorsSettings.font_body || 'Inter');
            return 'font-family:' + font + ';';
        },

        entityPreviewCatalogTitleStyle() {
            const settings = this.entitySettings();
            const font = this.previewFontFamily(settings.entity_list_title_font || this.colorsSettings.font_heading || 'Inter');
            const size = parseInt(settings.entity_list_title_size || 19, 10) || 19;
            const lines = Math.max(1, Math.min(4, parseInt(settings.entity_list_title_lines || 2, 10) || 2));
            return 'font-family:' + font + ';font-size:' + size + 'px;line-height:1.08;font-weight:700;letter-spacing:-0.03em;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:' + lines + ';overflow:hidden;overflow-wrap:anywhere;min-height:calc(1.08em * ' + lines + ');';
        },

        entityPreviewCatalogExcerptStyle() {
            const font = this.previewFontFamily(this.entitySettings().entity_list_text_font || this.colorsSettings.font_body || 'Inter');
            return 'font-family:' + font + ';';
        },

        entityPreviewListCardStyle() {
            const density = this.entitySettings().entity_list_card_density || 'comfortable';
            let pad = '12px';
            let gap = '10px';
            if (density === 'compact') {
                pad = '10px';
                gap = '8px';
            } else if (density === 'airy') {
                pad = '16px';
                gap = '14px';
            }
            return 'border:1px solid ' + (this.colorsSettings.storefront_surface_border || '#e2e8f0')
                + ';background:' + (this.colorsSettings.storefront_surface_bg || '#ffffff')
                + ';border-radius:16px;padding:' + pad + ';display:grid;gap:' + gap + ';';
        },

        entityPreviewListPricingStyle() {
            const variant = this.entityPreviewListPricingVariant();
            let css = 'display:inline-flex;align-items:center;flex-wrap:wrap;gap:8px;';
            if (variant === 'featured') {
                css += 'padding:8px 10px;border:1px solid ' + this.colorAlpha(this.colorsSettings.storefront_cta_bg || '#0284c7', 0.18)
                    + ';background:' + this.colorAlpha(this.colorsSettings.storefront_cta_bg || '#0284c7', 0.1)
                    + ';border-radius:14px;';
            }
            return css;
        },

        entityPreviewListPricingCurrentStyle() {
            const variant = this.entityPreviewListPricingVariant();
            const priceSize = parseInt(this.entitySettings().entity_list_price_size || 17, 10) || 17;
            return 'color:' + (this.colorsSettings.storefront_price_color || '#0f172a')
                + ';font-weight:700;'
                + (variant === 'minimal' ? 'font-size:' + Math.max(12, priceSize - 2) + 'px;text-transform:none;' : 'font-size:' + priceSize + 'px;');
        },

        entityPreviewListInventoryStyle() {
            return 'display:inline-flex;align-items:center;border-radius:9999px;padding:4px 10px;font-size:10px;font-weight:600;'
                + this.entityPreviewInventoryStyle('low');
        },

        entityPreviewListInventoryLabel() {
            return this.entityPreviewListInventoryVariant() === 'compact' ? '3 left' : 'Only 3 left';
        },

        entityPreviewListProgressStyle() {
            return this.entityPreviewListProgressVariant() === 'inline'
                ? 'display:flex;align-items:center;gap:8px;'
                : 'display:grid;gap:6px;';
        },

        entityPreviewListProgressTrackStyle() {
            const width = this.entityPreviewListProgressVariant() === 'inline' ? '110px' : '100%';
            return 'display:inline-flex;align-items:center;overflow:hidden;background:' + this.colorAlpha(this.colorsSettings.body_text_color || '#1e293b', 0.08) + ';border-radius:9999px;height:6px;width:' + width + ';';
        },

        entityPreviewListProgressBarStyle() {
            return 'display:block;height:100%;width:25%;background:' + (this.colorsSettings.storefront_cta_bg || '#0284c7') + ';border-radius:9999px;';
        },

        entityPreviewSidebarLayoutStyle() {
            const gap = (this.sidebarSettings.gap || 32) + 'px';
            const width = (this.sidebarSettings.width || 300) + 'px';
            if (this.sidebarSettings.enabled != 1) {
                return 'display:block;';
            }
            if (this.sidebarSettings.placement === 'left') {
                return 'display:grid;grid-template-columns:' + width + ' minmax(0,1fr);gap:' + gap + ';align-items:start;';
            }
            return 'display:grid;grid-template-columns:minmax(0,1fr) ' + width + ';gap:' + gap + ';align-items:start;';
        },

        entityPreviewSidebarRailStyle() {
            return 'background:' + (this.sidebarSettings.widget_bg_color || '#ffffff')
                + ';border:1px solid ' + (this.sidebarSettings.widget_border_color || '#e2e8f0')
                + ';border-radius:' + (this.sidebarSettings.widget_radius || 10) + 'px'
                + ';padding:' + (this.sidebarSettings.widget_padding || 16) + 'px'
                + ';color:' + (this.sidebarSettings.widget_text_color || '#334155') + ';';
        },

        sidebarDefaultTemplateKey() {
            return (this.availableSidebarTemplates[0] && this.availableSidebarTemplates[0].key) ? this.availableSidebarTemplates[0].key : 'home';
        },

        sidebarNormalizeTemplateRules() {
            const validKeys = new Set((Array.isArray(this.availableSidebarTemplates) ? this.availableSidebarTemplates : [])
                .map((t) => (t && t.key ? t.key : ''))
                .filter(Boolean));
            let rules = Array.isArray(this.sidebarSettings.template_rules) ? this.sidebarSettings.template_rules : [];
            if (rules.length === 0 && this.sidebarSettings.template_scope) {
                rules = [this.sidebarSettings.template_scope];
            }
            rules = [...new Set(rules
                .map((rule) => ((rule ?? '') + '').trim())
                .filter((rule) => validKeys.has(rule)))];
            if (this.sidebarSettings.scope_mode === 'template' && rules.length === 0) {
                const fallback = this.sidebarDefaultTemplateKey();
                if (fallback) {
                    rules = [fallback];
                }
            }
            this.sidebarSettings.template_rules = rules;
            this.sidebarSettings.template_scope = rules[0] || this.sidebarDefaultTemplateKey();
        },

        sidebarTemplateRuleChecked(key) {
            const rules = Array.isArray(this.sidebarSettings.template_rules) ? this.sidebarSettings.template_rules : [];
            return rules.includes(key);
        },

        toggleSidebarTemplateRule(key) {
            const rules = Array.isArray(this.sidebarSettings.template_rules) ? [...this.sidebarSettings.template_rules] : [];
            const index = rules.indexOf(key);
            if (index >= 0) {
                rules.splice(index, 1);
            } else {
                rules.push(key);
            }
            this.sidebarSettings.template_rules = rules;
            this.sidebarNormalizeTemplateRules();
        },

        sidebarSelectedTemplateCountLabel() {
            const count = Array.isArray(this.sidebarSettings.template_rules) ? this.sidebarSettings.template_rules.length : 0;
            if (count === 0) return 'No targets selected';
            if (count === 1) return '1 target selected';
            return count + ' targets selected';
        },

        sidebarScopeSummary() {
            const rules = Array.isArray(this.sidebarSettings.template_rules) ? this.sidebarSettings.template_rules : [];
            const labels = (Array.isArray(this.availableSidebarTemplates) ? this.availableSidebarTemplates : [])
                .filter((template) => rules.includes(template.key))
                .map((template) => (template.label || template.key || '').replace(/ Template$/, ''));

            if (this.sidebarSettings.scope_mode === 'exclude_templates') {
                if (labels.length === 0) return 'all route targets';
                const preview = labels.slice(0, 3).join(', ');
                const remainder = labels.length > 3 ? ' +' + (labels.length - 3) : '';
                return 'all targets except ' + preview + remainder;
            }

            if (this.sidebarSettings.scope_mode === 'template') {
                if (labels.length === 0) return 'selected targets';
                const preview = labels.slice(0, 3).join(', ');
                const remainder = labels.length > 3 ? ' +' + (labels.length - 3) : '';
                return preview + remainder;
            }

            return 'all route targets';
        },

        entityPreviewHeaderOffset() {
            if (this.headerSettings.sticky != 1) return '0px';
            const explicitHeight = this.headerSettings.height && this.headerSettings.height !== 'auto' ? parseInt(this.headerSettings.height, 10) : 64;
            const topbarHeight = this.headerSettings.show_topbar == 1 && this.headerWidgets.length > 0 ? 24 : 0;
            return (explicitHeight + topbarHeight + 16) + 'px';
        },

        markSectionDirty(section) {
            if (Object.prototype.hasOwnProperty.call(this.dirtySections, section)) {
                this.dirtySections[section] = true;
                this.dirty = true;
            }
        },

        syncDirtyState() {
            this.dirty = Object.values(this.dirtySections).some(Boolean);
        },

        sectionsToSave() {
            const sections = Object.keys(this.dirtySections).filter(section => this.dirtySections[section]);
            return sections;
        },

        sectionPayload(section) {
            if (section === 'footer') {
                return { settings: this.footerSettings, widgets: this.footerWidgets };
            }
            if (section === 'header') {
                return { settings: this.headerSettings, widgets: this.headerWidgets };
            }
            if (section === 'sidebar') {
                return { settings: this.sidebarSettings, widgets: this.sidebarWidgets };
            }
            if (section === 'colors') {
                return { settings: this.colorsSettings };
            }
            if (section === 'custom_code') {
                return { settings: this.customCodeSettings };
            }
            if (section === 'entity_presentation') {
                return { settings: this.entityPresentationSettings };
            }
            return { settings: this.themeLayoutSettings };
        },

        async saveSection(apiBase, section) {
            const res = await fetch(apiBase + '/' + section, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': CMS_CSRF },
                body: JSON.stringify(Object.assign({ _token: CMS_CSRF }, this.sectionPayload(section))),
            });
            const data = await res.json();
            return { section, ok: !!data.ok, error: data.error || '', data };
        },

        init() {
            // Hydrate from server-rendered JSON
            try {
                this.footerSettings = JSON.parse(document.getElementById('cz-footer-settings').textContent);
                if (this.footerSettings.widget_container_width === undefined) this.footerSettings.widget_container_width = this.footerSettings.inner_width === 'full-width' ? 'full' : 'contained';
                if (this.footerSettings.widget_inner_width_mode === undefined) this.footerSettings.widget_inner_width_mode = this.footerSettings.inner_width === 'full-width' ? 'full' : 'contained';
                if (this.footerSettings.widget_inner_custom_width === undefined || this.footerSettings.widget_inner_custom_width === '') this.footerSettings.widget_inner_custom_width = '960px';
                if (this.footerSettings.inner_width === undefined) this.footerSettings.inner_width = 'contained';
            } catch (e) {
                this.footerSettings = {
                    columns: 3, widget_container_width: 'contained', widget_inner_width_mode: 'contained', widget_inner_custom_width: '960px', inner_width: 'contained',
                    bg_color: '#1e293b', text_color: '#cbd5e1', link_color: '#94a3b8', link_hover_color: '#ffffff', title_color: '#f1f5f9',
                    bar_bg_color: '#0f172a', bar_text_color: '#64748b', bar_link_color: '#94a3b8', bar_link_hover_color: '#ffffff',
                    copyright_text: '{literal}© {current_year} {site_title}. All rights reserved.{/literal}',
                    show_footer_bar: 1, show_admin_link: 1, padding_top: '40', padding_bottom: '40',
                };
            }
            try {
                this.footerWidgets = JSON.parse(document.getElementById('cz-footer-widgets').textContent);
            } catch (e) {
                this.footerWidgets = [];
            }
            try {
                this.availableMenus = JSON.parse(document.getElementById('cz-available-menus').textContent);
            } catch (e) {
                this.availableMenus = [];
            }
            try {
                this.availableMenuLocations = JSON.parse(document.getElementById('cz-menu-locations').textContent);
            } catch (e) {
                this.availableMenuLocations = (this.availableMenus || [])
                    .filter(m => m && m.location)
                    .map(m => ({ slug: m.location, name: m.location, menu_name: m.name || '' }));
            }
            this.availableMenuLocations = (Array.isArray(this.availableMenuLocations) ? this.availableMenuLocations : [])
                .filter(loc => loc && (loc.slug || loc.label || loc.name))
                .map(loc => ({
                    ...loc,
                    slug: loc.slug || loc.location || loc.name || loc.label,
                    label: loc.label || loc.name || loc.slug || loc.location || 'Menu',
                    name: loc.name || loc.label || loc.slug || loc.location || 'Menu',
                    menu_name: loc.menu_name || '',
                }));
            try {
                this.availableSidebarTemplates = JSON.parse(document.getElementById('cz-sidebar-templates').textContent);
                if (!Array.isArray(this.availableSidebarTemplates) || this.availableSidebarTemplates.length === 0) {
                    this.availableSidebarTemplates = [{ key: 'home', label: 'Home / Front Page' }];
                }
            } catch (e) {
                this.availableSidebarTemplates = [{ key: 'home', label: 'Home / Front Page' }];
            }
            try {
                this.sidebarTemplateFileExists = ((JSON.parse(document.getElementById('cz-sidebar-template-file-exists').textContent) || 0) == 1);
            } catch (e) {
                this.sidebarTemplateFileExists = false;
            }
            this.siteTitle = document.getElementById('cz-site-title')?.textContent || '';
            this.siteTagline = document.getElementById('cz-site-tagline')?.textContent || '';

            // Hydrate header settings
            try {
                this.headerSettings = JSON.parse(document.getElementById('cz-header-settings').textContent);
                // Ensure new fields have defaults for data saved before they existed
                if (this.headerSettings.header_bg_opacity === undefined) this.headerSettings.header_bg_opacity = 100;
                if (this.headerSettings.mobile_menu_location === undefined) this.headerSettings.mobile_menu_location = '';
                if (this.headerSettings.mobile_menu_align === undefined) this.headerSettings.mobile_menu_align = 'left';
                if (this.headerSettings.mobile_hover_bg_color === undefined) this.headerSettings.mobile_hover_bg_color = '#f1f5f9';
                if (this.headerSettings.mobile_active_bg_color === undefined) this.headerSettings.mobile_active_bg_color = '#e2e8f0';
                if (this.headerSettings.dropdown_bg_color === undefined) this.headerSettings.dropdown_bg_color = '#ffffff';
                if (this.headerSettings.dropdown_text_color === undefined) this.headerSettings.dropdown_text_color = '#1f2937';
                if (this.headerSettings.dropdown_hover_bg_color === undefined) this.headerSettings.dropdown_hover_bg_color = '#f8fafc';
                if (this.headerSettings.dropdown_hover_text_color === undefined) this.headerSettings.dropdown_hover_text_color = '#2563eb';
                if (this.headerSettings.dropdown_border_color === undefined) this.headerSettings.dropdown_border_color = '#e5e7eb';
                if (this.headerSettings.dropdown_min_width === undefined) this.headerSettings.dropdown_min_width = '220';
                if (this.headerSettings.dropdown_radius === undefined) this.headerSettings.dropdown_radius = '8';
                if (this.headerSettings.dropdown_item_padding_y === undefined) this.headerSettings.dropdown_item_padding_y = '10';
                const legacyHeaderWidth = (this.headerSettings.header_inner_width || this.headerSettings.inner_width) === 'full-width' ? 'full' : 'contained';
                const legacyTopbarWidth = (this.headerSettings.topbar_inner_width || this.headerSettings.inner_width) === 'full-width' ? 'full' : 'contained';
                if (!['contained', 'full'].includes(this.headerSettings.header_container_width)) this.headerSettings.header_container_width = legacyHeaderWidth === 'full' ? 'full' : 'contained';
                if (!['boxed', 'contained', 'full', 'custom'].includes(this.headerSettings.header_inner_width_mode)) this.headerSettings.header_inner_width_mode = legacyHeaderWidth;
                if (this.headerSettings.header_inner_custom_width === undefined || this.headerSettings.header_inner_custom_width === '') this.headerSettings.header_inner_custom_width = '960px';
                if (!['contained', 'full'].includes(this.headerSettings.topbar_container_width)) this.headerSettings.topbar_container_width = legacyTopbarWidth === 'full' ? 'full' : 'contained';
                if (!['boxed', 'contained', 'full', 'custom'].includes(this.headerSettings.topbar_inner_width_mode)) this.headerSettings.topbar_inner_width_mode = legacyTopbarWidth;
                if (this.headerSettings.topbar_inner_custom_width === undefined || this.headerSettings.topbar_inner_custom_width === '') this.headerSettings.topbar_inner_custom_width = '960px';
                this.headerSettings.header_inner_width = this.headerSettings.header_inner_width_mode === 'full' ? 'full-width' : 'contained';
                this.headerSettings.topbar_inner_width = this.headerSettings.topbar_inner_width_mode === 'full' ? 'full-width' : 'contained';
                this.headerSettings.inner_width = this.headerSettings.header_inner_width;
                // Decompose mobile menu background color into picker-friendly hex + opacity
                let _mb = (this.headerSettings.mobile_bg_color || '#ffffff').trim();
                let _mh = /^#([0-9a-fA-F]{6})$/.exec(_mb);
                let _mm = /rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/.exec(_mb);
                if (_mh) {
                    this._mobileBgHex = '#' + _mh[1].toLowerCase();
                    this._mobileBgOpacity = 100;
                } else if (_mm) {
                    this._mobileBgHex = '#' + [_mm[1],_mm[2],_mm[3]].map(v=>parseInt(v).toString(16).padStart(2,'0')).join('');
                    this._mobileBgOpacity = Math.max(0, Math.min(100, Math.round((parseFloat(_mm[4] ?? 1)) * 100)));
                }
                // Decompose overlay color into picker-friendly hex + opacity
                let _oc = (this.headerSettings.mobile_overlay_color || 'rgba(0,0,0,0.5)');
                let _om = /rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/.exec(_oc);
                if (_om) {
                    this._overlayHex = '#' + [_om[1],_om[2],_om[3]].map(v=>parseInt(v).toString(16).padStart(2,'0')).join('');
                    this._overlayOpacity = Math.round((parseFloat(_om[4] ?? 1)) * 100);
                }
            } catch (e) {
                this.headerSettings = {
                    layout: 'default', sticky: 1, show_tagline: 0, show_search: 0, show_cta_button: 0,
                    cta_text: 'Get Started', cta_url: '#', cta_style: 'primary', inner_width: 'contained',
                    header_container_width: 'contained', header_inner_width_mode: 'contained', header_inner_custom_width: '960px', header_inner_width: 'contained',
                    topbar_container_width: 'contained', topbar_inner_width_mode: 'contained', topbar_inner_custom_width: '960px', topbar_inner_width: 'contained',
                    logo_image_url: '', logo_max_height: '40', favicon_url: '',
                    padding_top: '12', padding_bottom: '12',
                    bg_color: '#ffffff', text_color: '#1f2937', link_color: '#1f2937', link_hover_color: '#2563eb',
                    dropdown_bg_color: '#ffffff', dropdown_text_color: '#1f2937', dropdown_hover_bg_color: '#f8fafc', dropdown_hover_text_color: '#2563eb', dropdown_border_color: '#e5e7eb',
                    dropdown_min_width: '220', dropdown_radius: '8', dropdown_item_padding_y: '10',
                    logo_color: '#1f2937', border_color: '#e5e7eb', mobile_bg_color: '#ffffff', mobile_text_color: '#1f2937',
                    height: 'auto', menu_location: 'primary', transparent_home: 0,
                    header_bg_opacity: 100, transparent_text_color: '#ffffff', transparent_logo_color: '#ffffff',
                    show_topbar: 1, topbar_bg_color: '#1e293b', topbar_text_color: '#e2e8f0',
                    topbar_link_color: '#93c5fd', topbar_link_hover_color: '#ffffff',
                    topbar_font_size: '13', topbar_font_weight: 'normal', topbar_align: 'center',
                    topbar_padding_y: '6', topbar_border_bottom: 1,
                    mobile_menu_style: 'dropdown', mobile_canvas_direction: 'left', mobile_canvas_width: '300', mobile_menu_location: '', mobile_menu_align: 'left', mobile_hover_bg_color: '#f1f5f9', mobile_active_bg_color: '#e2e8f0',
                    mobile_logo_url: '', mobile_logo_max_height: '36', mobile_breakpoint: '768',
                    mobile_close_on_link: 1, mobile_overlay: 1, mobile_overlay_color: 'rgba(0,0,0,0.5)',
                };
                this._mobileBgHex = '#ffffff';
                this._mobileBgOpacity = 100;
            }

            // Hydrate header widgets
            try {
                this.headerWidgets = JSON.parse(document.getElementById('cz-header-widgets').textContent);
                if (!Array.isArray(this.headerWidgets)) this.headerWidgets = [];
            } catch (e) {
                this.headerWidgets = [];
            }

            // Hydrate sidebar settings/widgets
            try {
                this.sidebarSettings = JSON.parse(document.getElementById('cz-sidebar-settings').textContent);
                if (this.sidebarSettings.enabled === undefined) this.sidebarSettings.enabled = 0;
                if (!['general', 'exclude_templates', 'template'].includes(this.sidebarSettings.scope_mode)) this.sidebarSettings.scope_mode = 'general';
                const _defaultSidebarTpl = this.sidebarDefaultTemplateKey();
                if (this.sidebarSettings.template_scope === undefined) this.sidebarSettings.template_scope = _defaultSidebarTpl;
                if (!this.availableSidebarTemplates.find(t => t.key === this.sidebarSettings.template_scope)) this.sidebarSettings.template_scope = _defaultSidebarTpl;
                if (!Array.isArray(this.sidebarSettings.template_rules)) this.sidebarSettings.template_rules = [];
                if (this.sidebarSettings.placement === undefined) this.sidebarSettings.placement = 'right';
                if (this.sidebarSettings.width === undefined) this.sidebarSettings.width = '300';
                if (this.sidebarSettings.gap === undefined) this.sidebarSettings.gap = '32';
                if (this.sidebarSettings.sticky === undefined) this.sidebarSettings.sticky = 0;
                if (this.sidebarSettings.widget_bg_color === undefined) this.sidebarSettings.widget_bg_color = '#ffffff';
                if (this.sidebarSettings.widget_text_color === undefined) this.sidebarSettings.widget_text_color = '#334155';
                if (this.sidebarSettings.widget_title_color === undefined) this.sidebarSettings.widget_title_color = '#0f172a';
                if (this.sidebarSettings.widget_border_color === undefined) this.sidebarSettings.widget_border_color = '#e2e8f0';
                if (this.sidebarSettings.widget_link_color === undefined) this.sidebarSettings.widget_link_color = '#2563eb';
                if (this.sidebarSettings.widget_link_hover_color === undefined) this.sidebarSettings.widget_link_hover_color = '#1d4ed8';
                if (this.sidebarSettings.widget_padding === undefined) this.sidebarSettings.widget_padding = '16';
                if (this.sidebarSettings.widget_radius === undefined) this.sidebarSettings.widget_radius = '10';
                this.sidebarNormalizeTemplateRules();
            } catch (e) {
                const _defaultSidebarTpl = this.sidebarDefaultTemplateKey();
                this.sidebarSettings = {
                    enabled: 0, scope_mode: 'general', template_scope: _defaultSidebarTpl, placement: 'right',
                    template_rules: [],
                    width: '300', gap: '32', sticky: 0,
                    widget_bg_color: '#ffffff', widget_text_color: '#334155', widget_title_color: '#0f172a',
                    widget_border_color: '#e2e8f0', widget_link_color: '#2563eb', widget_link_hover_color: '#1d4ed8',
                    widget_padding: '16', widget_radius: '10',
                };
            }
            try {
                this.sidebarWidgets = JSON.parse(document.getElementById('cz-sidebar-widgets').textContent);
                if (!Array.isArray(this.sidebarWidgets)) this.sidebarWidgets = [];
            } catch (e) {
                this.sidebarWidgets = [];
            }

            // Hydrate colors & typography settings
            try {
                this.colorsSettings = JSON.parse(document.getElementById('cz-colors-settings').textContent);
                if (this.colorsSettings.storefront_surface_bg === undefined) this.colorsSettings.storefront_surface_bg = '#ffffff';
                if (this.colorsSettings.storefront_surface_border === undefined) this.colorsSettings.storefront_surface_border = '#e2e8f0';
                if (this.colorsSettings.storefront_price_color === undefined) this.colorsSettings.storefront_price_color = '#0f172a';
                if (this.colorsSettings.storefront_badge_bg === undefined) this.colorsSettings.storefront_badge_bg = '#fee2e2';
                if (this.colorsSettings.storefront_badge_text === undefined) this.colorsSettings.storefront_badge_text = '#b91c1c';
                if (this.colorsSettings.storefront_cta_bg === undefined) this.colorsSettings.storefront_cta_bg = '#0284c7';
                if (this.colorsSettings.storefront_cta_text === undefined) this.colorsSettings.storefront_cta_text = '#ffffff';
                if (this.colorsSettings.storefront_secondary_bg === undefined) this.colorsSettings.storefront_secondary_bg = '#ffffff';
                if (this.colorsSettings.storefront_secondary_text === undefined) this.colorsSettings.storefront_secondary_text = '#334155';
                if (this.colorsSettings.storefront_secondary_border === undefined) this.colorsSettings.storefront_secondary_border = '#cbd5e1';
                if (this.colorsSettings.storefront_success_bg === undefined) this.colorsSettings.storefront_success_bg = '#ecfdf5';
                if (this.colorsSettings.storefront_success_text === undefined) this.colorsSettings.storefront_success_text = '#047857';
                if (this.colorsSettings.storefront_warning_bg === undefined) this.colorsSettings.storefront_warning_bg = '#fffbeb';
                if (this.colorsSettings.storefront_warning_text === undefined) this.colorsSettings.storefront_warning_text = '#b45309';
                if (this.colorsSettings.storefront_danger_bg === undefined) this.colorsSettings.storefront_danger_bg = '#fef2f2';
                if (this.colorsSettings.storefront_danger_text === undefined) this.colorsSettings.storefront_danger_text = '#dc2626';
            } catch (e) {
                this.colorsSettings = {
                    color_primary: '#3b82f6', color_secondary: '#64748b', color_accent: '#f59e0b',
                    body_bg_color: '#ffffff', body_text_color: '#1e293b', body_text_light: '#64748b',
                    body_link_color: '#3b82f6', body_link_hover: '#2563eb',
                    border_color: '#e2e8f0', light_bg_color: '#f8fafc',
                    storefront_surface_bg: '#ffffff', storefront_surface_border: '#e2e8f0', storefront_price_color: '#0f172a',
                    storefront_badge_bg: '#fee2e2', storefront_badge_text: '#b91c1c',
                    storefront_cta_bg: '#0284c7', storefront_cta_text: '#ffffff',
                    storefront_secondary_bg: '#ffffff', storefront_secondary_text: '#334155', storefront_secondary_border: '#cbd5e1',
                    storefront_success_bg: '#ecfdf5', storefront_success_text: '#047857',
                    storefront_warning_bg: '#fffbeb', storefront_warning_text: '#b45309',
                    storefront_danger_bg: '#fef2f2', storefront_danger_text: '#dc2626',
                    font_body: 'Inter', font_heading: 'Inter', font_size_base: '16', line_height: '1.6',
                    heading_color: '', h1_size: '2.5', h2_size: '2', h3_size: '1.5', h4_size: '1.25',
                    container_width: '1200', border_radius: '0.5',
                };
            }

            // Hydrate custom code settings
            try {
                this.customCodeSettings = JSON.parse(document.getElementById('cz-custom-code-settings').textContent);
            } catch (e) {
                this.customCodeSettings = {
                    custom_css: '', head_code: '', body_end_code: '',
                    scroll_to_top: 0, scroll_to_top_bg: '#3b82f6', scroll_to_top_color: '#ffffff',
                    scroll_to_top_size: '44', scroll_to_top_radius: '50', scroll_to_top_position: 'right', scroll_to_top_offset: '24',
                    smooth_scroll: 0, page_transition: 0, page_transition_style: 'fade',
                };
            }

            // Hydrate theme layout settings
            try {
                this.themeManifestBlockVariants = JSON.parse(document.getElementById('cz-theme-manifest-block-variants').textContent) || {};
            } catch (e) {
                this.themeManifestBlockVariants = {};
            }
            try {
                this.entityContextCatalog = JSON.parse(document.getElementById('cz-entity-context-catalog').textContent) || {};
            } catch (e) {
                this.entityContextCatalog = {};
            }
            try {
                this.entityContextExamples = JSON.parse(document.getElementById('cz-entity-context-examples').textContent) || {};
            } catch (e) {
                this.entityContextExamples = {};
            }
            this.entityContextExampleId = this.entityContextPreferredExampleId();

            const themeLayoutDefaults = {
                layout_mode: 'contained', site_max_width: 1280, content_max_width: 768,
                content_padding_x: 16, content_padding_top: 32, content_padding_bottom: 32,
            };
            try {
                this.themeLayoutSettings = JSON.parse(document.getElementById('cz-theme-layout-settings').textContent) || {};
            } catch (e) {
                this.themeLayoutSettings = {};
            }
            const rawThemeLayoutSettings = this.themeLayoutSettings || {};
            const legacyThemePresentation = {};
            [
                'blog_layout',
                'blog_columns',
                'blog_gap',
                'blog_card_border',
                'blog_card_shadow',
                'blog_card_radius',
                'blog_featured_image',
                'blog_image_height',
                'blog_image_ratio',
                'blog_show_author',
                'blog_show_date',
                'blog_show_excerpt',
                'blog_show_readmore',
                'blog_readmore_text',
                'single_max_width',
                'single_show_author',
                'single_show_date',
                'single_show_categories',
                'single_show_tags',
                'single_show_nav',
            ].forEach((key) => {
                if (rawThemeLayoutSettings[key] !== undefined) {
                    legacyThemePresentation[key] = rawThemeLayoutSettings[key];
                }
            });
            this.themeLayoutSettings = Object.assign({}, themeLayoutDefaults, {
                layout_mode: rawThemeLayoutSettings.layout_mode,
                site_max_width: rawThemeLayoutSettings.site_max_width,
                content_max_width: rawThemeLayoutSettings.content_max_width,
                content_padding_x: rawThemeLayoutSettings.content_padding_x,
                content_padding_top: rawThemeLayoutSettings.content_padding_top,
                content_padding_bottom: rawThemeLayoutSettings.content_padding_bottom,
            });

            const entityPresentationDefaults = {
                entity_layout_profile: this.customizerScope === 'ecommerce' ? 'commerce' : 'default',
                entity_pricing_variant: '',
                entity_action_variant: '',
                entity_list_pricing_variant: '',
                entity_list_inventory_variant: '',
                entity_list_progress_variant: '',
                entity_summary_width: 320,
                entity_summary_sticky: 1,
                entity_media_ratio: 'auto',
                entity_spacing_scale: 'comfortable',
                entity_action_size: 'md',
                entity_list_show_filter_summary: 1,
                entity_list_category_navigation: 'list',
                entity_list_card_density: 'comfortable',
                entity_list_show_excerpt: 1,
                entity_list_excerpt_length: 120,
                entity_list_title_font: '',
                entity_list_text_font: '',
                entity_list_title_size: 19,
                entity_list_price_size: 17,
                entity_list_card_min_width: 240,
                entity_list_title_lines: 2,
                blog_layout: 'list',
                blog_columns: 2,
                blog_gap: 24,
                blog_card_border: 1,
                blog_card_shadow: 1,
                blog_card_radius: 8,
                blog_featured_image: 1,
                blog_image_height: 208,
                blog_image_ratio: 'auto',
                blog_show_author: 1,
                blog_show_date: 1,
                blog_show_excerpt: 1,
                blog_show_readmore: 1,
                blog_readmore_text: 'Read more →',
                single_max_width: 768,
                single_show_author: 1,
                single_show_date: 1,
                single_show_categories: 1,
                single_show_tags: 1,
                single_show_nav: 1,
            };
            try {
                this.entityPresentationSettings = JSON.parse(document.getElementById('cz-entity-presentation-settings').textContent) || {};
            } catch (e) {
                this.entityPresentationSettings = {};
            }
            this.entityPresentationSettings = Object.assign({}, entityPresentationDefaults, legacyThemePresentation, this.entityPresentationSettings || {});

            // Watch for changes
            this.$watch('footerSettings', () => { this.markSectionDirty('footer'); }, { deep: true });
            this.$watch('footerWidgets', () => { this.markSectionDirty('footer'); }, { deep: true });
            this.$watch('headerSettings', () => { this.markSectionDirty('header'); }, { deep: true });
            this.$watch('headerWidgets', () => { this.markSectionDirty('header'); }, { deep: true });
            this.$watch('sidebarSettings', () => { this.markSectionDirty('sidebar'); }, { deep: true });
            this.$watch('sidebarWidgets', () => { this.markSectionDirty('sidebar'); }, { deep: true });
            this.$watch('colorsSettings', () => { this.markSectionDirty('colors'); }, { deep: true });
            this.$watch('customCodeSettings', () => { this.markSectionDirty('custom_code'); }, { deep: true });
            this.$watch('themeLayoutSettings', () => { this.markSectionDirty('theme'); }, { deep: true });
            this.$watch('entityPresentationSettings', () => { this.markSectionDirty('entity_presentation'); }, { deep: true });
        },

        // Widget helpers
        addWidget(type) {
            const id = 'w_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6);
            const defaultProps = { title: '' };
            if (type === 'text') defaultProps.content = '';
            if (type === 'custom_html') defaultProps.content = '';
            if (type === 'nav_menu') defaultProps.menu_id = 0;
            if (type === 'recent_posts') defaultProps.count = 5;
            if (type === 'contact_info') { defaultProps.address = ''; defaultProps.phone = ''; defaultProps.email = ''; }

            // Place in first column with space, or column 1
            let targetCol = 1;
            for (let c = 1; c <= this.footerSettings.columns; c++) {
                if (this.widgetsInColumn(c).length === 0) { targetCol = c; break; }
            }

            this.footerWidgets.push({ id, type, area: targetCol, props: defaultProps });
            this.expandedWidgets[id] = true;
        },

        removeWidget(id) {
            this.footerWidgets = this.footerWidgets.filter(w => w.id !== id);
            delete this.expandedWidgets[id];
        },

        toggleWidget(id) {
            this.expandedWidgets[id] = !this.expandedWidgets[id];
        },

        widgetsInColumn(col) {
            return this.footerWidgets.filter(w => w.area === col);
        },

        moveWidgetUp(id) {
            const idx = this.footerWidgets.findIndex(w => w.id === id);
            if (idx > 0) {
                const temp = this.footerWidgets[idx];
                this.footerWidgets[idx] = this.footerWidgets[idx - 1];
                this.footerWidgets[idx - 1] = temp;
                this.footerWidgets = [...this.footerWidgets]; // trigger reactivity
            }
        },

        moveWidgetDown(id) {
            const idx = this.footerWidgets.findIndex(w => w.id === id);
            if (idx < this.footerWidgets.length - 1) {
                const temp = this.footerWidgets[idx];
                this.footerWidgets[idx] = this.footerWidgets[idx + 1];
                this.footerWidgets[idx + 1] = temp;
                this.footerWidgets = [...this.footerWidgets];
            }
        },

        handleWidgetDrop(event, col) {
            const wid = event.dataTransfer.getData('text/plain');
            const widget = this.footerWidgets.find(w => w.id === wid);
            if (widget) {
                widget.area = col;
                this.footerWidgets = [...this.footerWidgets];
            }
        },

        widgetTypeLabel(type) {
            const wt = this.widgetTypes.find(w => w.type === type);
            return wt ? wt.label : type;
        },

        widgetBadgeClass(type) {
            const map = {
                text: 'bg-blue-50 text-blue-600',
                custom_html: 'bg-amber-50 text-amber-600',
                nav_menu: 'bg-emerald-50 text-emerald-600',
                recent_posts: 'bg-purple-50 text-purple-600',
                social_links: 'bg-pink-50 text-pink-600',
                contact_info: 'bg-orange-50 text-orange-600',
            };
            return map[type] || 'bg-gray-50 text-gray-600';
        },

        footerPreviewWidgetContainerLabel() {
            return (this.footerSettings.widget_container_width || 'contained') === 'full'
                ? 'Full + gutters'
                : 'Contained';
        },

        headerPreviewContainerLabel(mode) {
            return (mode || 'contained') === 'full' ? 'Full + gutters' : 'Contained';
        },

        headerPreviewHolderLabel(mode, customWidth) {
            const resolvedMode = mode || 'contained';
            if (resolvedMode === 'custom') {
                return customWidth || 'Custom';
            }
            return resolvedMode.charAt(0).toUpperCase() + resolvedMode.slice(1);
        },

        headerPreviewContainerStyle(mode) {
            if ((mode || 'contained') === 'full') {
                return 'width:100%;max-width:none;margin:0;padding-left:16px;padding-right:16px;box-sizing:border-box;';
            }
            return 'max-width:88%;margin:0 auto;';
        },

        headerPreviewHolderStyle(mode, customWidth) {
            const resolvedMode = mode || 'contained';
            if (resolvedMode === 'boxed') return 'width:100%;max-width:min(72%, 768px);margin:0 auto;';
            if (resolvedMode === 'custom') return 'width:100%;max-width:' + (customWidth || '960px') + ';margin:0 auto;';
            if (resolvedMode === 'full') return 'width:100%;max-width:none;';
            return 'width:100%;max-width:100%;margin:0 auto;';
        },

        headerPreviewShellStyle(mode) {
            return this.headerPreviewHolderStyle((mode || 'contained') === 'full-width' ? 'full' : 'contained', '960px');
        },

        footerPreviewWidgetHolderLabel() {
            const mode = this.footerSettings.widget_inner_width_mode || 'contained';
            if (mode === 'custom') {
                return this.footerSettings.widget_inner_custom_width || 'Custom';
            }
            return mode.charAt(0).toUpperCase() + mode.slice(1);
        },

        footerPreviewFooterBarLabel() {
            return (this.footerSettings.inner_width || 'contained') === 'full-width' ? 'Full' : 'Contained';
        },

        footerPreviewWidgetContainerStyle() {
            let style = 'color:' + this.footerSettings.text_color + ';padding:' + this.footerSettings.padding_top + 'px 0 ' + this.footerSettings.padding_bottom + 'px;';
            if ((this.footerSettings.widget_container_width || 'contained') === 'full') {
                style += 'padding-left:16px;padding-right:16px;box-sizing:border-box;';
            } else {
                style += 'max-width:88%;margin:0 auto;';
            }
            return style;
        },

        footerPreviewWidgetHolderStyle() {
            const mode = this.footerSettings.widget_inner_width_mode || 'contained';
            if (mode === 'boxed') return 'width:100%;max-width:min(72%, 768px);margin:0 auto;';
            if (mode === 'custom') return 'width:100%;max-width:' + (this.footerSettings.widget_inner_custom_width || '960px') + ';margin:0 auto;';
            if (mode === 'full') return 'width:100%;max-width:none;';
            return 'width:100%;max-width:100%;margin:0 auto;';
        },

        footerPreviewFooterBarInnerStyle() {
            return (this.footerSettings.inner_width || 'contained') === 'full-width'
                ? 'width:100%;'
                : 'max-width:88%;margin:0 auto;';
        },

        sidebarWidgetTypeLabel(type) {
            const wt = this.sidebarWidgetTypes.find(w => w.type === type);
            return wt ? wt.label : type;
        },

        sidebarWidgetBadgeClass(type) {
            const map = {
                text: 'bg-blue-50 text-blue-600',
                custom_html: 'bg-amber-50 text-amber-600',
                nav_menu: 'bg-emerald-50 text-emerald-600',
                recent_posts: 'bg-purple-50 text-purple-600',
                social_links: 'bg-pink-50 text-pink-600',
                contact_info: 'bg-orange-50 text-orange-600',
                search_box: 'bg-cyan-50 text-cyan-600',
                categories: 'bg-lime-50 text-lime-700',
                tag_cloud: 'bg-fuchsia-50 text-fuchsia-600',
                archives: 'bg-violet-50 text-violet-600',
                cta_button: 'bg-indigo-50 text-indigo-600',
            };
            return map[type] || 'bg-gray-50 text-gray-600';
        },

        previewCopyright() {
            let txt = this.footerSettings.copyright_text || '';
            txt = txt.replace(/\{current_year\}/g, new Date().getFullYear());
            txt = txt.replace(/\{site_title\}/g, this.siteTitle);
            return txt;
        },

        // --- Header widget helpers ---
        addHeaderWidget(type) {
            const id = 'hw_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6);
            const props = {};
            if (type === 'text') { props.content = ''; props.font_size = '13'; props.font_weight = 'normal'; }
            if (type === 'custom_html') props.content = '';
            if (type === 'contact_info') { props.phone = ''; props.email = ''; props.address = ''; }
            if (type === 'nav_menu') { props.menu_id = 0; }
            if (type === 'button') { props.text = 'Click'; props.url = '#'; props.style = 'primary'; props.new_tab = 0; }
            if (type === 'opening_hours') { props.text = 'Mon-Fri: 9AM - 5PM'; props.icon = 1; }
            this.headerWidgets.push({ id, type, props });
            this.expandedHeaderWidgets[id] = true;
        },

        removeHeaderWidget(id) {
            this.headerWidgets = this.headerWidgets.filter(w => w.id !== id);
            delete this.expandedHeaderWidgets[id];
        },

        toggleHeaderWidget(id) {
            this.expandedHeaderWidgets[id] = !this.expandedHeaderWidgets[id];
        },

        moveHeaderWidgetUp(idx) {
            if (idx > 0) {
                const temp = this.headerWidgets[idx];
                this.headerWidgets[idx] = this.headerWidgets[idx - 1];
                this.headerWidgets[idx - 1] = temp;
                this.headerWidgets = [...this.headerWidgets];
            }
        },

        moveHeaderWidgetDown(idx) {
            if (idx < this.headerWidgets.length - 1) {
                const temp = this.headerWidgets[idx];
                this.headerWidgets[idx] = this.headerWidgets[idx + 1];
                this.headerWidgets[idx + 1] = temp;
                this.headerWidgets = [...this.headerWidgets];
            }
        },

        headerWidgetTypeLabel(type) {
            const wt = this.headerWidgetTypes.find(w => w.type === type);
            return wt ? wt.label : type;
        },

        headerWidgetBadgeClass(type) {
            const map = {
                text: 'bg-blue-50 text-blue-600',
                custom_html: 'bg-amber-50 text-amber-600',
                social_links: 'bg-pink-50 text-pink-600',
                contact_info: 'bg-orange-50 text-orange-600',
                nav_menu: 'bg-emerald-50 text-emerald-600',
                button: 'bg-purple-50 text-purple-600',
                opening_hours: 'bg-teal-50 text-teal-600',
            };
            return map[type] || 'bg-gray-50 text-gray-600';
        },

        // --- Sidebar widget helpers ---
        addSidebarWidget(type) {
            const id = 'sw_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6);
            const props = { title: '' };
            if (type === 'text') props.content = '';
            if (type === 'custom_html') props.content = '';
            if (type === 'nav_menu') props.menu_id = 0;
            if (type === 'recent_posts') props.count = 5;
            if (type === 'search_box') { props.placeholder = 'Search…'; props.button_label = 'Search'; }
            if (type === 'categories') { props.count = 8; props.show_count = 1; }
            if (type === 'tag_cloud') props.count = 20;
            if (type === 'archives') { props.count = 12; props.show_count = 1; }
            if (type === 'cta_button') { props.text = 'Learn More'; props.url = '#'; props.new_tab = 0; }
            if (type === 'contact_info') { props.address = ''; props.phone = ''; props.email = ''; }
            this.sidebarWidgets.push({ id, type, props });
            this.expandedSidebarWidgets[id] = true;
        },

        removeSidebarWidget(id) {
            this.sidebarWidgets = this.sidebarWidgets.filter(w => w.id !== id);
            delete this.expandedSidebarWidgets[id];
        },

        toggleSidebarWidget(id) {
            this.expandedSidebarWidgets[id] = !this.expandedSidebarWidgets[id];
        },

        moveSidebarWidgetUp(idx) {
            if (idx > 0) {
                const temp = this.sidebarWidgets[idx];
                this.sidebarWidgets[idx] = this.sidebarWidgets[idx - 1];
                this.sidebarWidgets[idx - 1] = temp;
                this.sidebarWidgets = [...this.sidebarWidgets];
            }
        },

        moveSidebarWidgetDown(idx) {
            if (idx < this.sidebarWidgets.length - 1) {
                const temp = this.sidebarWidgets[idx];
                this.sidebarWidgets[idx] = this.sidebarWidgets[idx + 1];
                this.sidebarWidgets[idx + 1] = temp;
                this.sidebarWidgets = [...this.sidebarWidgets];
            }
        },

        // --- Image upload for header branding ---
        async uploadHeaderImage(event, settingKey) {
            const file = event.target.files[0];
            if (!file) return;
            const formData = new FormData();
            formData.append('file', file);
            formData.append('_token', CMS_CSRF);
            try {
                const res = await fetch(CMS_BASE + '/api/v1/cms/media/upload', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'X-CSRF-TOKEN': CMS_CSRF },
                    body: formData,
                });
                const data = await res.json();
                if (data.ok && data.url) {
                    this.headerSettings[settingKey] = data.url;
                    toast('Image uploaded', 'success');
                } else {
                    toast(data.error || 'Upload failed', 'error');
                }
            } catch (e) {
                toast('Upload error: ' + e.message, 'error');
            }
            event.target.value = '';
        },

        async save() {
            const sections = this.sectionsToSave();
            if (sections.length === 0) {
                toast('No changes to save', 'success');
                return;
            }

            this.saving = true;
            try {
                const apiBase = this.customizerApiBase;

                const results = await Promise.all(sections.map(section => this.saveSection(apiBase, section)));
                const failed = results.find(result => !result.ok);

                if (!failed) {
                    sections.forEach(section => {
                        this.dirtySections[section] = false;
                    });
                    this.syncDirtyState();
                    toast('Customization saved', 'success');
                } else {
                    toast(failed.error || 'Save failed', 'error');
                }
            } catch (e) {
                toast('Network error: ' + e.message, 'error');
            }
            this.saving = false;
        },

        resetDefaults() {
            if (this.activeTab === 'colors') {
                if (!confirm('Reset all colors & typography to defaults? This cannot be undone.')) return;
                this.colorsSettings = {
                    color_primary: '#3b82f6', color_secondary: '#64748b', color_accent: '#f59e0b',
                    body_bg_color: '#ffffff', body_text_color: '#1e293b', body_text_light: '#64748b',
                    body_link_color: '#3b82f6', body_link_hover: '#2563eb',
                    border_color: '#e2e8f0', light_bg_color: '#f8fafc',
                    storefront_surface_bg: '#ffffff', storefront_surface_border: '#e2e8f0', storefront_price_color: '#0f172a',
                    storefront_badge_bg: '#fee2e2', storefront_badge_text: '#b91c1c', storefront_cta_bg: '#0284c7', storefront_cta_text: '#ffffff',
                    storefront_secondary_bg: '#ffffff', storefront_secondary_text: '#334155', storefront_secondary_border: '#cbd5e1',
                    storefront_success_bg: '#ecfdf5', storefront_success_text: '#047857', storefront_warning_bg: '#fffbeb', storefront_warning_text: '#b45309',
                    storefront_danger_bg: '#fef2f2', storefront_danger_text: '#dc2626',
                    font_body: 'Inter', font_heading: 'Inter', font_size_base: '16', line_height: '1.6',
                    heading_color: '', h1_size: '2.5', h2_size: '2', h3_size: '1.5', h4_size: '1.25',
                    container_width: '1200', border_radius: '0.5',
                };
            } else if (this.activeTab === 'custom_code') {
                if (!confirm('Reset all custom code settings to defaults? This cannot be undone.')) return;
                this.customCodeSettings = {
                    custom_css: '', head_code: '', body_end_code: '',
                    scroll_to_top: 0, scroll_to_top_bg: '#3b82f6', scroll_to_top_color: '#ffffff',
                    scroll_to_top_size: '44', scroll_to_top_radius: '50', scroll_to_top_position: 'right', scroll_to_top_offset: '24',
                    smooth_scroll: 0, page_transition: 0, page_transition_style: 'fade',
                };
            } else if (this.activeTab === 'header' || this.activeTab === 'navigation') {
                if (!confirm('Reset all header settings to defaults? This cannot be undone.')) return;
                this.headerSettings = {
                    layout: 'default', sticky: 1, show_tagline: 0, show_search: 0, show_cta_button: 0,
                    cta_text: 'Get Started', cta_url: '#', cta_style: 'primary', inner_width: 'contained',
                    header_container_width: 'contained', header_inner_width_mode: 'contained', header_inner_custom_width: '960px', header_inner_width: 'contained',
                    topbar_container_width: 'contained', topbar_inner_width_mode: 'contained', topbar_inner_custom_width: '960px', topbar_inner_width: 'contained',
                    logo_image_url: '', logo_max_height: '40', favicon_url: '',
                    padding_top: '12', padding_bottom: '12',
                    bg_color: '#ffffff', text_color: '#1f2937', link_color: '#1f2937', link_hover_color: '#2563eb',
                    dropdown_bg_color: '#ffffff', dropdown_text_color: '#1f2937', dropdown_hover_bg_color: '#f8fafc', dropdown_hover_text_color: '#2563eb', dropdown_border_color: '#e5e7eb',
                    dropdown_min_width: '220', dropdown_radius: '8', dropdown_item_padding_y: '10',
                    logo_color: '#1f2937', border_color: '#e5e7eb', mobile_bg_color: '#ffffff', mobile_text_color: '#1f2937',
                    height: 'auto', menu_location: 'primary', transparent_home: 0,
                    header_bg_opacity: 100, transparent_text_color: '#ffffff', transparent_logo_color: '#ffffff',
                    show_topbar: 1, topbar_bg_color: '#1e293b', topbar_text_color: '#e2e8f0',
                    topbar_link_color: '#93c5fd', topbar_link_hover_color: '#ffffff',
                    topbar_font_size: '13', topbar_font_weight: 'normal', topbar_align: 'center',
                    topbar_padding_y: '6', topbar_border_bottom: 1,
                    mobile_menu_style: 'dropdown', mobile_canvas_direction: 'left', mobile_canvas_width: '300', mobile_menu_location: '', mobile_menu_align: 'left', mobile_hover_bg_color: '#f1f5f9', mobile_active_bg_color: '#e2e8f0',
                    mobile_logo_url: '', mobile_logo_max_height: '36', mobile_breakpoint: '768',
                    mobile_close_on_link: 1, mobile_overlay: 1, mobile_overlay_color: 'rgba(0,0,0,0.5)',
                };
                this._mobileBgHex = '#ffffff';
                this._mobileBgOpacity = 100;
                this.headerWidgets = [];
            } else if (this.activeTab === 'commerce') {
                if (!confirm('Reset entity presentation settings to defaults? This resets the canonical entity presentation controls.')) return;
                this.entityPresentationSettings = {
                    entity_layout_profile: 'commerce',
                    entity_pricing_variant: '',
                    entity_action_variant: '',
                    entity_list_pricing_variant: '',
                    entity_list_inventory_variant: '',
                    entity_list_progress_variant: '',
                    entity_summary_width: 320,
                    entity_summary_sticky: 1,
                    entity_media_ratio: 'auto',
                    entity_spacing_scale: 'comfortable',
                    entity_action_size: 'md',
                    entity_list_show_filter_summary: 1,
                    entity_list_category_navigation: 'list',
                    entity_list_card_density: 'comfortable',
                    entity_list_show_excerpt: 1,
                    entity_list_excerpt_length: 120,
                    entity_list_title_font: '',
                    entity_list_text_font: '',
                    entity_list_title_size: 19,
                    entity_list_price_size: 17,
                    entity_list_card_min_width: 240,
                    entity_list_title_lines: 2,
                    blog_layout: 'list',
                    blog_columns: 2,
                    blog_gap: 24,
                    blog_card_border: 1,
                    blog_card_shadow: 1,
                    blog_card_radius: 8,
                    blog_featured_image: 1,
                    blog_image_height: 208,
                    blog_image_ratio: 'auto',
                    blog_show_author: 1,
                    blog_show_date: 1,
                    blog_show_excerpt: 1,
                    blog_show_readmore: 1,
                    blog_readmore_text: 'Read more →',
                    single_max_width: 768,
                    single_show_author: 1,
                    single_show_date: 1,
                    single_show_categories: 1,
                    single_show_tags: 1,
                    single_show_nav: 1,
                };
            } else if (this.activeTab === 'theme') {
                if (!confirm('Reset all theme layout settings to defaults? This cannot be undone.')) return;
                this.themeLayoutSettings = {
                    layout_mode: 'contained', site_max_width: 1280, content_max_width: 768,
                    content_padding_x: 16, content_padding_top: 32, content_padding_bottom: 32,
                };
            } else if (this.activeTab === 'sidebar') {
                if (!confirm('Reset all sidebar settings to defaults? This cannot be undone.')) return;
                const _defaultSidebarTpl = this.sidebarDefaultTemplateKey();
                this.sidebarSettings = {
                    enabled: 0, scope_mode: 'general', template_scope: _defaultSidebarTpl, placement: 'right',
                    template_rules: [],
                    width: '300', gap: '32', sticky: 0,
                    widget_bg_color: '#ffffff', widget_text_color: '#334155', widget_title_color: '#0f172a',
                    widget_border_color: '#e2e8f0', widget_link_color: '#2563eb', widget_link_hover_color: '#1d4ed8',
                    widget_padding: '16', widget_radius: '10',
                };
                this.sidebarWidgets = [];
            } else {
                if (!confirm('Reset all footer settings to defaults? This cannot be undone.')) return;
                this.footerSettings = {
                    columns: 3, widget_container_width: 'contained', widget_inner_width_mode: 'contained', widget_inner_custom_width: '960px', inner_width: 'contained',
                    bg_color: '#1e293b', text_color: '#cbd5e1', link_color: '#94a3b8', link_hover_color: '#ffffff', title_color: '#f1f5f9',
                    bar_bg_color: '#0f172a', bar_text_color: '#64748b', bar_link_color: '#94a3b8', bar_link_hover_color: '#ffffff',
                    copyright_text: '{literal}© {current_year} {site_title}. All rights reserved.{/literal}',
                    show_footer_bar: 1, show_admin_link: 1, padding_top: '40', padding_bottom: '40',
                };
                this.footerWidgets = [];
            }
            this.dirty = true;
        },
    };
}
</script>

<!-- Server-rendered JSON hydration data -->
<script type="application/json" id="cz-footer-settings">{footer_settings_json|raw}</script>
<script type="application/json" id="cz-footer-widgets">{footer_widgets_json|raw}</script>
<script type="application/json" id="cz-header-settings">{header_settings_json|raw}</script>
<script type="application/json" id="cz-header-widgets">{header_widgets_json|raw}</script>
<script type="application/json" id="cz-sidebar-settings">{sidebar_settings_json|raw}</script>
<script type="application/json" id="cz-sidebar-widgets">{sidebar_widgets_json|raw}</script>
<script type="application/json" id="cz-sidebar-templates">{sidebar_templates_json|raw}</script>
<script type="application/json" id="cz-sidebar-template-file-exists">{sidebar_template_file_exists}</script>
<script type="application/json" id="cz-colors-settings">{colors_settings_json|raw}</script>
<script type="application/json" id="cz-custom-code-settings">{custom_code_settings_json|raw}</script>
<script type="application/json" id="cz-theme-layout-settings">{theme_layout_settings_json|raw}</script>
<script type="application/json" id="cz-entity-presentation-settings">{entity_presentation_settings_json|raw}</script>
<script type="application/json" id="cz-theme-manifest-block-variants">{theme_manifest_block_variants_json|raw}</script>
<script type="application/json" id="cz-entity-context-catalog">{entity_context_catalog_json|raw}</script>
<script type="application/json" id="cz-entity-context-examples">{entity_context_examples_json|raw}</script>
<script type="application/json" id="cz-available-menus">{available_menus_json|raw}</script>
