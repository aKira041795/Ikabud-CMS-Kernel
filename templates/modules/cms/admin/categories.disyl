{extends "modules/cms/layouts/admin.disyl"}

{block content}
<div x-data="categoriesAdmin()" class="p-4 lg:p-6 space-y-4">
    <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-gray-900">Categories</h2>
        <button type="button" @click="showAdd = true" class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-white bg-sky-600 rounded-lg hover:bg-sky-700 transition-colors shadow-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Add Category
        </button>
    </div>

    <!-- Add / Edit form -->
    <div x-show="showAdd || editId" x-cloak class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
        <h3 class="text-sm font-bold text-gray-900 mb-3" x-text="editId ? 'Edit Category' : 'New Category'"></h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Name</label>
                <input type="text" x-model="catForm.name" @input="autoSlug()" placeholder="Category name" class="w-full text-sm border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500">
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Slug</label>
                <input type="text" x-model="catForm.slug" placeholder="category-slug" class="w-full text-sm border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500 font-mono">
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Parent</label>
                <select x-model="catForm.parent_id" class="w-full text-sm border border-gray-300 rounded-lg px-3 py-2 bg-white">
                    <option value="">None (top level)</option>
                    <template x-for="c in allCategories" :key="c.id">
                        <option :value="c.id" x-text="c.name" :disabled="c.id == editId"></option>
                    </template>
                </select>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Description</label>
                <input type="text" x-model="catForm.description" placeholder="Optional description" class="w-full text-sm border border-gray-300 rounded-lg px-3 py-2">
            </div>
        </div>
        <div class="flex items-center gap-2 mt-4">
            <button type="button" @click="saveCategory()" :disabled="saving" class="px-4 py-2 text-sm font-medium text-white bg-sky-600 rounded-lg hover:bg-sky-700 disabled:opacity-50 transition-colors">
                <span x-text="saving ? 'Saving...' : (editId ? 'Update' : 'Create')"></span>
            </button>
            <button type="button" @click="cancelEdit()" class="px-4 py-2 text-sm text-gray-500 hover:text-gray-700">Cancel</button>
        </div>
    </div>

    <!-- Category list -->
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
        <template x-if="allCategories.length === 0">
            <div class="p-8 text-center text-gray-400">
                <svg class="w-8 h-8 mx-auto mb-2 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
                <p class="text-sm">No categories yet</p>
            </div>
        </template>
        <table class="w-full text-sm" x-show="allCategories.length > 0">
            <thead>
                <tr class="bg-gray-50 border-b border-gray-200">
                    <th class="text-left px-4 py-2.5 font-semibold text-gray-600 text-xs uppercase tracking-wider">Name</th>
                    <th class="text-left px-4 py-2.5 font-semibold text-gray-600 text-xs uppercase tracking-wider hidden md:table-cell">Slug</th>
                    <th class="text-left px-4 py-2.5 font-semibold text-gray-600 text-xs uppercase tracking-wider hidden lg:table-cell">Description</th>
                    <th class="text-center px-4 py-2.5 font-semibold text-gray-600 text-xs uppercase tracking-wider w-20">Posts</th>
                    <th class="text-right px-4 py-2.5 font-semibold text-gray-600 text-xs uppercase tracking-wider w-28">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <template x-for="cat in allCategories" :key="cat.id">
                    <tr class="hover:bg-gray-50/50 transition-colors">
                        <td class="px-4 py-3">
                            <span class="font-medium text-gray-900" x-text="cat.name"></span>
                            <template x-if="cat.parent_id">
                                <span class="ml-1 text-[10px] text-gray-400">— child</span>
                            </template>
                        </td>
                        <td class="px-4 py-3 text-gray-500 font-mono text-xs hidden md:table-cell" x-text="cat.slug"></td>
                        <td class="px-4 py-3 text-gray-400 text-xs hidden lg:table-cell" x-text="cat.description || '—'"></td>
                        <td class="px-4 py-3 text-center">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600" x-text="catCounts[cat.id] || 0"></span>
                        </td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex items-center justify-end gap-1">
                                <button type="button" @click="startEdit(cat)" class="p-1.5 rounded text-gray-400 hover:text-sky-600 hover:bg-sky-50 transition-colors" title="Edit">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                </button>
                                <button type="button" @click="deleteCategory(cat.id, cat.name)" class="p-1.5 rounded text-gray-400 hover:text-red-600 hover:bg-red-50 transition-colors" title="Delete">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                </template>
            </tbody>
        </table>
    </div>
</div>

{/block}

{block scripts}
<script>
function categoriesAdmin() {
    return {
        allCategories: {categories | json},
        catCounts: {cat_counts | json},
        showAdd: false,
        editId: null,
        saving: false,
        catForm: { name: '', slug: '', description: '', parent_id: '' },
        autoSlug() {
            if (!this.editId) {
                this.catForm.slug = this.catForm.name.toLowerCase().replace(/[^a-z0-9\s-]/g, '').replace(/[\s-]+/g, '-').replace(/^-|-$/g, '');
            }
        },
        cancelEdit() {
            this.showAdd = false;
            this.editId = null;
            this.catForm = { name: '', slug: '', description: '', parent_id: '' };
        },
        startEdit(cat) {
            this.editId = cat.id;
            this.showAdd = false;
            this.catForm = { name: cat.name, slug: cat.slug, description: cat.description || '', parent_id: cat.parent_id || '' };
        },
        async saveCategory() {
            if (!this.catForm.name.trim()) { toast('Name is required', 'error'); return; }
            this.saving = true;
            try {
                const url = this.editId
                    ? CMS_BASE + '/api/v1/cms/categories/' + this.editId
                    : CMS_BASE + '/api/v1/cms/categories';
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': CMS_CSRF },
                    body: JSON.stringify(this.catForm),
                });
                const data = await res.json();
                if (data.ok) {
                    toast(this.editId ? 'Category updated' : 'Category created');
                    setTimeout(() => location.reload(), 500);
                } else {
                    toast(data.error || 'Failed', 'error');
                }
            } catch (e) {
                toast('Network error', 'error');
            }
            this.saving = false;
        },
        async deleteCategory(id, name) {
            if (!confirm('Delete category "' + name + '"? Posts will be unassigned.')) return;
            try {
                const res = await fetch(CMS_BASE + '/api/v1/cms/categories/' + id + '/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': CMS_CSRF },
                });
                const data = await res.json();
                if (data.ok) {
                    toast('Category deleted');
                    this.allCategories = this.allCategories.filter(c => c.id !== id);
                } else {
                    toast(data.error || 'Failed', 'error');
                }
            } catch (e) {
                toast('Network error', 'error');
            }
        },
    };
}
</script>
{/block}
