{extends "modules/cms/layouts/admin.disyl"}

{block content}
<!-- Quick actions -->
<div class="flex flex-wrap gap-2 mb-6">
    <a href="{base_url}/cms/admin/content/create?type=post" class="inline-flex items-center gap-1.5 px-4 py-2 bg-sky-600 text-white text-sm font-medium rounded-lg hover:bg-sky-700 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        New Post
    </a>
    <a href="{base_url}/cms/admin/content/create?type=page" class="inline-flex items-center gap-1.5 px-4 py-2 bg-white text-gray-700 text-sm font-medium rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        New Page
    </a>
    <a href="{base_url}/cms/admin/media" class="inline-flex items-center gap-1.5 px-4 py-2 bg-white text-gray-700 text-sm font-medium rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        Media Library
    </a>
    <a href="{base_url}/cms" target="_blank" class="inline-flex items-center gap-1.5 px-4 py-2 bg-white text-gray-700 text-sm font-medium rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        View Site
    </a>
</div>

<!-- Stats grid -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-white rounded-lg border border-gray-200 p-5">
        <div class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Posts</div>
        <div class="text-3xl font-bold text-gray-900">{post_total}</div>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 p-5">
        <div class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Pages</div>
        <div class="text-3xl font-bold text-gray-900">{page_total}</div>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 p-5">
        <div class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Media Files</div>
        <div class="text-3xl font-bold text-gray-900">{media_count}</div>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 p-5">
        <div class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">CMS Users</div>
        <div class="text-3xl font-bold text-gray-900">{user_count}</div>
    </div>
</div>

<!-- Two-column layout for recent content + activity -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <!-- Recent content -->
    <div class="bg-white rounded-lg border border-gray-200">
        <div class="px-5 py-3 border-b border-gray-200 font-semibold text-sm text-gray-700">Recently Updated</div>
        {if recent_content | count == 0}
        <div class="px-5 py-10 text-center text-gray-400">
            No content yet. Create your first post to get started.
        </div>
        {/if}
        {foreach recent_content as item}
        <a href="{base_url}/cms/admin/content/edit/{item.id}" class="flex items-center gap-3 px-5 py-3 border-b border-gray-100 last:border-b-0 hover:bg-gray-50 transition-colors no-underline">
            <span class="flex-1 text-sm font-medium text-gray-900 truncate">{item.title}</span>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold {if item.type == 'post'}bg-sky-50 text-sky-700{else}bg-violet-50 text-violet-700{/if}">{item.type}</span>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold {if item.status == 'published'}bg-emerald-50 text-emerald-700{else}bg-amber-50 text-amber-700{/if}">{item.status}</span>
            <span class="text-xs text-gray-400 hidden md:inline">{item.updated_at}</span>
        </a>
        {/foreach}
    </div>

    <!-- Activity feed -->
    <div class="bg-white rounded-lg border border-gray-200">
        <div class="px-5 py-3 border-b border-gray-200 font-semibold text-sm text-gray-700">Activity Feed</div>
        {if activity_feed | count == 0}
        <div class="px-5 py-10 text-center text-gray-400 text-sm">
            No recent activity.
        </div>
        {/if}
        {foreach activity_feed as evt}
        <div class="flex items-start gap-3 px-5 py-2.5 border-b border-gray-100 last:border-b-0">
            <div class="mt-1 shrink-0">
                {if evt.action == 'cms.content.created' || evt.action == 'content.create'}<span class="block w-2 h-2 rounded-full bg-sky-400"></span>
                {else}{if evt.action == 'cms.content.published' || evt.action == 'content.publish'}<span class="block w-2 h-2 rounded-full bg-emerald-500"></span>
                {else}{if evt.action == 'cms.content.deleted' || evt.action == 'content.trash'}<span class="block w-2 h-2 rounded-full bg-red-400"></span>
                {else}{if evt.action == 'cms.media.uploaded' || evt.action == 'media.upload'}<span class="block w-2 h-2 rounded-full bg-violet-400"></span>
                {else}<span class="block w-2 h-2 rounded-full bg-gray-300"></span>
                {/if}{/if}{/if}{/if}
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-xs text-gray-700">
                    <span class="font-medium">{if evt.actor_name}{evt.actor_name}{else}System{/if}</span>
                    <span class="text-gray-400"> — </span>
                    <span class="text-gray-500">{evt.action}</span>
                    {if evt.entity_type}<span class="text-gray-400"> on </span><span class="text-gray-500">{evt.entity_type}</span>{/if}
                    {if evt.entity_id}<span class="text-gray-400"> #{evt.entity_id}</span>{/if}
                </p>
                <p class="text-[11px] text-gray-400 mt-0.5">{evt.created_at}</p>
            </div>
        </div>
        {/foreach}
    </div>
</div>
{/block}
