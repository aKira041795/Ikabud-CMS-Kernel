<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Student Account — CMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://unpkg.com/alpinejs@3.14.3/dist/cdn.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        cms: {
                            50: '#f0f9ff', 100: '#e0f2fe', 200: '#bae6fd', 300: '#7dd3fc',
                            400: '#38bdf8', 500: '#0ea5e9', 600: '#0284c7', 700: '#0369a1',
                            800: '#075985', 900: '#0c4a6e', 950: '#082f49'
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="min-h-screen bg-[radial-gradient(circle_at_top,_rgba(14,165,233,0.18),_transparent_42%),linear-gradient(135deg,#020617_0%,#0f172a_45%,#082f49_100%)] px-4 py-10">
    <div class="mx-auto grid w-full max-w-5xl gap-8 lg:grid-cols-[1.1fr_0.9fr]">
        <section class="rounded-[2rem] border border-white/10 bg-slate-950/55 p-8 text-white shadow-2xl backdrop-blur">
            <div class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold uppercase tracking-[0.22em] text-sky-200">Student Onboarding</div>
            <h1 class="mt-5 text-4xl font-black tracking-tight">Create the student account before enrollment continues.</h1>
            <p class="mt-4 max-w-2xl text-base leading-7 text-slate-200">New Moodle learners need a CMS account first. We send a 6-digit verification code to the student email, approve the account after the code is confirmed, then return the learner to the exact course enrollment step.</p>
            <div class="mt-8 grid gap-4 sm:grid-cols-3">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                    <div class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-200">Step 1</div>
                    <div class="mt-2 text-sm font-semibold text-white">Create account</div>
                    <p class="mt-1 text-sm leading-6 text-slate-300">Collect student name, email, and password in the CMS.</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                    <div class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-200">Step 2</div>
                    <div class="mt-2 text-sm font-semibold text-white">Approve by email code</div>
                    <p class="mt-1 text-sm leading-6 text-slate-300">The system email bridge sends the 2FA verification code to the student inbox.</p>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                    <div class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-200">Step 3</div>
                    <div class="mt-2 text-sm font-semibold text-white">Return to Moodle flow</div>
                    <p class="mt-1 text-sm leading-6 text-slate-300">After approval, the student is signed in and redirected back to continue enrollment.</p>
                </div>
            </div>
        </section>

        <section class="rounded-[2rem] border border-slate-200 bg-white/95 p-8 shadow-2xl backdrop-blur" x-data="cmsRegister()">
            <div class="flex items-center gap-3">
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-sky-600 shadow-lg shadow-sky-600/20">
                    <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 1.657-1.79 3-4 3s-4-1.343-4-3 1.79-3 4-3 4 1.343 4 3zm0 0V7a4 4 0 118 0v4m-8 0v4m8-4v4m-8 0a4 4 0 008 0"></path></svg>
                </div>
                <div>
                    <div class="text-xl font-extrabold tracking-tight text-slate-900">Create Student Account</div>
                    <div class="text-sm text-slate-500">Email verification is required before Moodle enrollment can continue.</div>
                </div>
            </div>

            <div x-show="error" x-text="error" class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" style="display:none;"></div>
            <div x-show="info" x-text="info" class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700" style="display:none;"></div>

            <div x-show="stage === 'form'" class="mt-6">
                <form @submit.prevent="submit()" class="space-y-4">
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-slate-600">Full Name</label>
                        <input type="text" x-model="form.display_name" autocomplete="name" required class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20" />
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-slate-600">Email</label>
                        <input type="email" x-model="form.email" autocomplete="email" required class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20" />
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-slate-600">Password</label>
                        <input type="password" x-model="form.password" autocomplete="new-password" required class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20" />
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-slate-600">Confirm Password</label>
                        <input type="password" x-model="form.confirm_password" autocomplete="new-password" required class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20" />
                    </div>
                    <button type="submit" :disabled="loading" class="w-full rounded-xl bg-sky-600 py-3 font-semibold text-white transition-colors hover:bg-sky-700 disabled:opacity-60">
                        <span x-text="loading ? 'Sending verification code...' : 'Create account and send code'"></span>
                    </button>
                </form>
            </div>

            <div x-show="stage === 'verify'" class="mt-6 space-y-5" style="display:none;">
                <div class="rounded-2xl border border-sky-100 bg-sky-50 px-4 py-4 text-sm text-slate-700">
                    <div class="font-semibold text-slate-900">Approval required</div>
                    <p class="mt-1">We sent a 6-digit verification code to <span class="font-semibold" x-text="maskedEmail || 'your email address'"></span>. Enter it below to approve the student account and continue into enrollment.</p>
                </div>
                <form @submit.prevent="verify()" class="space-y-4">
                    <div>
                        <label class="mb-1 block text-xs font-semibold text-slate-600">Verification Code</label>
                        <input type="text" x-model="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required class="w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-center text-lg font-semibold tracking-[0.35em] focus:border-sky-500 focus:outline-none focus:ring-2 focus:ring-sky-500/20" />
                    </div>
                    <button type="submit" :disabled="loading" class="w-full rounded-xl bg-slate-900 py-3 font-semibold text-white transition-colors hover:bg-slate-800 disabled:opacity-60">
                        <span x-text="loading ? 'Approving account...' : 'Approve and continue'"></span>
                    </button>
                </form>
                <div class="flex items-center justify-between text-sm">
                    <button type="button" @click="stage = 'form'; error = ''; info = ''; code = ''" class="font-medium text-slate-500 hover:text-slate-700">Edit details</button>
                    <button type="button" @click="resend()" :disabled="loading" class="font-semibold text-sky-700 hover:text-sky-900 disabled:opacity-60">Resend code</button>
                </div>
            </div>

            <div class="mt-8 border-t border-slate-100 pt-5 text-sm text-slate-500">
                Already have an account? <a href="{login_url}" class="font-semibold text-sky-700 hover:text-sky-900">Sign in instead</a>
            </div>
        </section>
    </div>

    <script>
        function cmsRegister() {
            return {
                stage: 'form',
                loading: false,
                error: '',
                info: '',
                code: '',
                ticket: '',
                maskedEmail: '',
                form: {
                    display_name: '',
                    email: '',
                    password: '',
                    confirm_password: '',
                },
                async submit() {
                    this.error = '';
                    this.info = '';
                    this.loading = true;
                    try {
                        const response = await fetch('{base_url}/api/v1/cms/auth/register', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                            body: JSON.stringify({
                                ...this.form,
                                redirect: '{redirect_path}',
                            }),
                        });
                        const data = await response.json();
                        if (!response.ok || !data.ok) {
                            throw new Error(data.error || 'Unable to start registration.');
                        }
                        this.ticket = data.ticket || '';
                        this.maskedEmail = data.masked_email || this.form.email;
                        this.info = data.message || 'Verification code sent.';
                        this.stage = 'verify';
                        this.code = '';
                    } catch (error) {
                        this.error = error instanceof Error ? error.message : 'Unable to start registration.';
                    } finally {
                        this.loading = false;
                    }
                },
                async verify() {
                    this.error = '';
                    this.info = '';
                    this.loading = true;
                    try {
                        const response = await fetch('{base_url}/api/v1/cms/auth/register/verify', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                            body: JSON.stringify({
                                ticket: this.ticket,
                                code: this.code,
                            }),
                        });
                        const data = await response.json();
                        if (!response.ok || !data.ok) {
                            throw new Error(data.error || 'Unable to verify account.');
                        }
                        const redirectPath = data.redirect || '{redirect_path}' || '/cms/admin';
                        window.location.href = '{base_url}' + redirectPath;
                    } catch (error) {
                        this.error = error instanceof Error ? error.message : 'Unable to verify account.';
                    } finally {
                        this.loading = false;
                    }
                },
                async resend() {
                    this.error = '';
                    this.info = '';
                    this.loading = true;
                    try {
                        const response = await fetch('{base_url}/api/v1/cms/auth/register/resend', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                            body: JSON.stringify({ ticket: this.ticket }),
                        });
                        const data = await response.json();
                        if (!response.ok || !data.ok) {
                            throw new Error(data.error || 'Unable to resend verification code.');
                        }
                        this.ticket = data.ticket || this.ticket;
                        this.maskedEmail = data.masked_email || this.maskedEmail;
                        this.info = data.message || 'Verification code resent.';
                    } catch (error) {
                        this.error = error instanceof Error ? error.message : 'Unable to resend verification code.';
                    } finally {
                        this.loading = false;
                    }
                },
            };
        }
    </script>
</body>
</html>