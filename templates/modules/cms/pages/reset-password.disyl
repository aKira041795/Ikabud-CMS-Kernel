<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password — CMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://unpkg.com/alpinejs@3.14.3/dist/cdn.min.js"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-slate-950 via-slate-900 to-sky-950 flex items-center justify-center px-4">
    <div class="w-full max-w-md">
        <div class="bg-white/95 backdrop-blur rounded-2xl shadow-2xl border border-white/10 overflow-hidden">
            <div class="px-8 pt-8 pb-6" x-data="cmsResetPassword()">
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight text-center">Reset Password</h1>
                <p class="mt-2 text-sm text-slate-500 text-center">Enter a new password for your CMS account.</p>

                <template x-if="!tokenValid">
                    <div class="mt-4 text-sm bg-amber-50 border border-amber-200 text-amber-700 px-4 py-3 rounded-lg">
                        This reset link is invalid or expired.
                    </div>
                </template>

                <div x-show="error" x-text="error" class="mt-4 text-sm bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg" style="display:none;"></div>
                <div x-show="message" x-text="message" class="mt-4 text-sm bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-lg" style="display:none;"></div>

                <form @submit.prevent="submit()" class="mt-6 space-y-4" x-show="tokenValid" style="display:none;">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">New Password</label>
                        <input type="password" x-model="password" minlength="8" autocomplete="new-password" required
                               class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Confirm Password</label>
                        <input type="password" x-model="confirmPassword" minlength="8" autocomplete="new-password" required
                               class="w-full px-4 py-3 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-500" />
                    </div>
                    <button type="submit" :disabled="loading"
                            class="w-full py-3 rounded-lg bg-sky-600 text-white font-semibold hover:bg-sky-700 disabled:opacity-60 transition-colors">
                        <span x-text="loading ? 'Resetting...' : 'Reset Password'"></span>
                    </button>
                </form>

                <div class="mt-6 text-xs text-slate-400 text-center">
                    <a href="{base_url}/cms/login" class="hover:text-slate-600">Back to sign in</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        function cmsResetPassword() {
            return {
                token: '{reset_token}',
                tokenValid: '{token_valid}' === '1' || '{token_valid}' === 'true',
                password: '',
                confirmPassword: '',
                loading: false,
                error: '',
                message: '',
                async submit() {
                    this.loading = true;
                    this.error = '';
                    this.message = '';
                    try {
                        const res = await fetch('{base_url}/api/v1/cms/auth/reset-password', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                token: this.token,
                                password: this.password,
                                confirm_password: this.confirmPassword,
                            }),
                        });
                        const data = await res.json();
                        if (!res.ok || !data.ok) {
                            this.error = data.error || 'Unable to reset password.';
                        } else {
                            this.message = data.message || 'Password reset successful.';
                            setTimeout(() => {
                                window.location.href = '{base_url}' + (data.redirect || '/cms/login');
                            }, 1200);
                        }
                    } catch (e) {
                        this.error = 'Network error.';
                    }
                    this.loading = false;
                },
            };
        }
    </script>
</body>
</html>
