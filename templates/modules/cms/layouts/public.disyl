<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title|default:"Untitled"}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    {if theme_style_url}<link rel="stylesheet" href="{theme_style_url}">{/if}
    {if colors_style}{colors_style|raw}{/if}
    {if theme_layout_style}{theme_layout_style|raw}{/if}
    {if storefront_theme_css}{storefront_theme_css|raw}{/if}
    {if custom_css}{custom_css|raw}{/if}
    {if head_code}{head_code|raw}{/if}
    <style>
        .prose h2 { margin: 2rem 0 0.75rem; font-size: 1.4rem; font-weight: 700; }
        .prose h3 { margin: 1.5rem 0 0.5rem; font-size: 1.15rem; font-weight: 600; }
        .prose p { margin: 0 0 1rem; }
        .prose img { max-width: 100%; border-radius: 0.5rem; margin: 1rem 0; }
        .prose img.alignleft, .prose .alignleft img, .prose img[style*="float: left"], .prose img[style*="float:left"] { float: left; margin: 0 1rem 0 0; max-width: 50%; }
        .prose img.alignright, .prose .alignright img, .prose img[style*="float: right"], .prose img[style*="float:right"] { float: right; margin: 0 0 0 1rem; max-width: 50%; }
        .prose img.aligncenter, .prose .aligncenter img { display: block; margin-left: auto; margin-right: auto; }
        .prose blockquote { border-left: 4px solid var(--color-primary, #0ea5e9); padding: 0.5rem 1rem; margin: 1rem 0; background: var(--color-light-bg, #f0f9ff); border-radius: 0 0.5rem 0.5rem 0; }
        .prose pre { background: #1e293b; color: #e2e8f0; padding: 1rem; border-radius: 0.5rem; overflow-x: auto; font-size: 0.875rem; }
        .prose code { background: var(--color-light-bg, #f1f5f9); padding: 0.15rem 0.4rem; border-radius: 4px; font-size: 0.9em; }
        .prose pre code { background: none; padding: 0; }
        .prose ul, .prose ol { padding-left: 1.5rem; margin: 0 0 1rem; }
        .prose li { margin-bottom: 0.4rem; }
        .prose a { color: var(--color-link, #0ea5e9); text-decoration: underline; }
        .prose blockquote cite { display: block; margin-top: 0.5rem; font-size: 0.875rem; color: var(--color-text-light, #64748b); font-style: normal; }
        .cms-btn-wrap { margin: 1.25rem 0; }
        .cms-btn { display: inline-block; padding: 0.625rem 1.5rem; border-radius: var(--radius-md, 0.5rem); font-weight: 600; font-size: 0.9rem; text-decoration: none !important; transition: all 0.15s; }
        .cms-btn-primary { background: var(--color-primary, #0ea5e9); color: #fff; }
        .cms-btn-primary:hover { opacity: 0.92; }
        .cms-btn-outline { border: 2px solid var(--color-primary, #0ea5e9); color: var(--color-primary, #0ea5e9); background: transparent; }
        .cms-btn-outline:hover { background: var(--color-light-bg, #f0f9ff); }
        .cms-gallery { display: grid; gap: 0.5rem; margin: 1.25rem 0; }
        .cms-gallery-cols-2 { grid-template-columns: repeat(2, 1fr); }
        .cms-gallery-cols-3 { grid-template-columns: repeat(3, 1fr); }
        .cms-gallery-cols-4 { grid-template-columns: repeat(4, 1fr); }
        .cms-gallery-cols-5 { grid-template-columns: repeat(5, 1fr); }
        .cms-gallery-cols-6 { grid-template-columns: repeat(6, 1fr); }
        .cms-gallery-item { margin: 0; }
        .cms-gallery-item img { width: 100%; height: 200px; object-fit: cover; border-radius: var(--radius-sm, 0.375rem); }
        .cms-columns { margin: 1.25rem 0; }
        .cms-column { min-width: 0; }
        .cms-section { width: 100%; }
        .cms-section-inner { box-sizing: border-box; }
        .cms-embed { margin: 1.25rem 0; }
        .cms-embed-responsive { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: var(--radius-md, 0.5rem); }
        .cms-embed-responsive iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }
        .cms-separator { border: none; border-top: 2px solid var(--color-border, #e2e8f0); margin: 1.5rem 0; }
        .cms-separator-dashed { border-top-style: dashed; }
        .cms-separator-dotted { border-top-style: dotted; }
        .cms-separator-double { border-top-style: double; border-top-width: 4px; }
        .cms-nav .cms-menu { list-style: none; display: flex; flex-wrap: wrap; gap: 1rem; padding: 0; margin: 0; }
        .cms-nav .cms-menu a { color: var(--color-text, #374151); text-decoration: none; font-size: 0.875rem; }
        .cms-nav .cms-menu a:hover { color: var(--color-primary, #0ea5e9); }
        .cms-nav .cms-menu .current-menu-item > a { color: var(--color-primary, #0ea5e9); font-weight: 600; }
        .cms-nav .cms-submenu { list-style: none; padding: 0.25rem 0 0 1rem; }
        .cms-nav .cms-menu li { position: relative; }
        .cms-nav .cms-menu .has-children > .cms-submenu { display: none; position: absolute; top: 100%; left: 0; min-width: 180px; background: #fff; border: 1px solid var(--color-border, #e5e7eb); border-radius: var(--radius-md, 0.5rem); padding: 0.5rem 0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); z-index: 50; }
        .cms-nav .cms-menu .has-children:hover > .cms-submenu { display: block; }
        .cms-nav .cms-menu .has-children > .cms-submenu li { display: block; }
        .cms-nav .cms-menu .has-children > .cms-submenu a { display: block; padding: 0.375rem 1rem; white-space: nowrap; }
        .cms-content-with-sidebar { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, var(--sidebar-width, 300px)); gap: var(--sidebar-gap, 2rem); align-items: start; }
        .cms-content-with-sidebar.sidebar-left { grid-template-columns: minmax(220px, var(--sidebar-width, 300px)) minmax(0, 1fr); }
        .cms-content-with-sidebar .cms-main-slot { min-width: 0; }
        .cms-content-with-sidebar .cms-sidebar-slot { min-width: 0; }
        @media (max-width: 640px) {
            .cms-gallery-cols-3, .cms-gallery-cols-4, .cms-gallery-cols-5, .cms-gallery-cols-6 { grid-template-columns: repeat(2, 1fr); }
            .cms-columns-stack { grid-template-columns: 1fr !important; }
        }
        @media (max-width: 1024px) {
            .cms-content-with-sidebar,
            .cms-content-with-sidebar.sidebar-left { display: block; }
            .cms-content-with-sidebar .cms-sidebar-slot { margin-top: 1.5rem; }
        }
    </style>
    <link rel="alternate" type="application/rss+xml" title="{site_title|default:"Blog"} RSS Feed" href="{base_url}/cms/feed">
    {block head}{/block}
    <noscript><style>body:not(.cz-loaded),[data-animate]{opacity:1!important;transform:none!important;}</style></noscript>
</head>
<body class="min-h-screen {if builder_enabled && builder_page_settings.body_class}{builder_page_settings.body_class}{/if}">
    {if has_customized_header}
    {customized_header|raw}
    {else}
    <header class="site-header">
        <div class="cms-public-shell px-4 py-4 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div class="min-w-0">
                <a href="{base_url}/cms" class="text-lg font-bold text-gray-900 hover:text-sky-600 no-underline">{site_title|default:"Blog"}</a>
                {if site_tagline}<p class="mt-1 text-sm text-gray-500">{site_tagline}</p>{/if}
            </div>
            <nav class="flex items-center gap-4 text-sm">
                {if primary_menu}
                <div class="cms-nav">{primary_menu|raw}</div>
                {else}
                <a href="{base_url}/cms/blog" class="text-gray-500 hover:text-gray-800 no-underline">Posts</a>
                <a href="{base_url}/cms/search" class="text-gray-500 hover:text-gray-800 no-underline">Search</a>
                {/if}
                <a href="{base_url}/cms/admin" class="text-gray-400 hover:text-gray-600 no-underline text-xs">Admin</a>
            </nav>
        </div>
    </header>
    {/if}

    <div class="site-content">
        <div class="{if builder_enabled && !(has_customized_sidebar || force_customized_sidebar || cms_global_sidebar_force)}w-full{else}cms-public-shell{/if}">
            <div class="{if (has_customized_sidebar || force_customized_sidebar || cms_global_sidebar_force)}cms-content-with-sidebar {if sidebar_position == 'left'}sidebar-left{/if}{/if}"{if (has_customized_sidebar || force_customized_sidebar || cms_global_sidebar_force)} style="--sidebar-width:{sidebar_width|default:'300'}px;"{/if}>
                {if (has_customized_sidebar || force_customized_sidebar || cms_global_sidebar_force)}
                {if sidebar_position == 'left'}
                <aside class="cms-sidebar-slot">
                    {customized_sidebar|raw}
                </aside>
                {/if}
                {/if}
                <main id="main-content" class="{if builder_enabled && !(has_customized_sidebar || force_customized_sidebar || cms_global_sidebar_force)}w-full{else}cms-public-main{/if}{if (has_customized_sidebar || force_customized_sidebar || cms_global_sidebar_force)} cms-main-slot{/if}" role="main">
                    {block content}{/block}
                </main>
                {if (has_customized_sidebar || force_customized_sidebar || cms_global_sidebar_force)}
                {if sidebar_position == 'left'}
                {else}
                <aside class="cms-sidebar-slot">
                    {customized_sidebar|raw}
                </aside>
                {/if}
                {/if}
            </div>
        </div>
    </div>

    {if has_customized_footer}
    {customized_footer|raw}
    {else}
    <footer class="mt-12">
        <div class="cms-public-shell px-4 py-6 text-center text-xs text-gray-400">
            {if social_links}
            <div class="mb-3">
                {foreach social_links as sl}
                <a href="{sl.url}" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-gray-600 no-underline mx-1">{sl.label}</a>
                {/foreach}
            </div>
            {/if}
            {if footer_menu}
            <div class="mb-3">{footer_menu|raw}</div>
            {/if}
            &copy; {current_year|default:"2025"} {site_title|default:"CMS"}. Powered by CMS Module.
        </div>
    </footer>
    {/if}
    <script>
        (function () {
            function revealCmsContent() {
                if (document.body) {
                    document.body.classList.add('cz-loaded');
                }
                document.querySelectorAll('[data-animate]').forEach(function (el) {
                    el.classList.add('cms-animated');
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', revealCmsContent, { once: true });
            } else {
                revealCmsContent();
            }
        })();
    </script>
    {if theme_script_url}<script src="{theme_script_url}" defer></script>{/if}
    {if builder_enabled}
    <script src="{base_url}/assets/cms/builder-public.js"></script>
    {/if}
    {if body_end_code}{body_end_code|raw}{/if}
    
    {* ── Global Lightbox for standard content editor images ── *}
    <div x-data="{
        lightboxModalSrc: null,
        init() {
            // Apply cursor-zoom-in to all eligible images
            const attachCursors = () => {
                document.querySelectorAll('.cms-entity-body img').forEach(img => {
                    if (!img.closest('a')) {
                        img.classList.add('cursor-zoom-in');
                    }
                });
            };
            
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', attachCursors);
            } else {
                attachCursors();
            }

            // Delegate click events globally
            window.addEventListener('click', (e) => {
                if (e.target.tagName !== 'IMG') return;
                if (!e.target.closest('.cms-entity-body')) return;
                if (e.target.closest('a')) return; // Skip if it's already a link

                this.lightboxModalSrc = e.target.src;
            });
        }
    }">
        <template x-teleport="body">
            <div x-show="lightboxModalSrc" 
                 style="display: none;"
                 class="fixed inset-0 z-[99999] flex items-center justify-center p-4 sm:p-8 bg-black/90 cursor-zoom-out"
                 x-transition.opacity.duration.200ms
                 @click="lightboxModalSrc = null"
                 @keydown.escape.window="lightboxModalSrc = null">
                 
                 <button type="button" class="absolute top-4 right-4 p-2 text-white/70 hover:text-white transition-colors z-10 focus:outline-none" @click="lightboxModalSrc = null">
                     <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                 </button>

                 <img :src="lightboxModalSrc" @click.stop class="max-w-full max-h-full object-contain rounded shadow-2xl transition-transform duration-200 cursor-default" :class="lightboxModalSrc ? 'scale-100' : 'scale-95'" />
            </div>
        </template>
    </div>
    {block scripts}{/block}
</body>
</html>
