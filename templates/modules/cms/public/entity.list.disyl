{extends "_cms_active_theme/layouts/public.disyl"}

{block head}
{if cms_head}{cms_head | raw}{/if}
{/block}

{block content}
<section
    class="cms-entity-list cms-entity-list--density-{entity_presentation.list_card_density|default:'comfortable'} w-full max-w-5xl mx-auto px-4 py-8"
    data-public-render-origin="{public_render_origin|default:'cms'}"
    data-public-route-kind="{public_route_kind|default:'generic'}"
    data-public-presentation-mode="{public_presentation_mode|default:'traditional'}"
    data-list-search="{entity_list_context.search|default:''}"
    data-list-category-slug="{entity_list_context.category_slug|default:''}"
    data-list-result-count="{entity_list_context.result_count|default:0}"
    data-list-active-filter-count="{entity_list_context.active_filter_count|default:0}"
>

    {if list_title}
    <header class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">{list_title}</h1>
        {if list_description}<p class="text-gray-500 mt-1">{list_description}</p>{/if}
        {if entity_presentation.list_show_filter_summary and (entity_list_context.result_label or entity_list_context.category_name or entity_list_context.search)}
        <div class="mt-3 flex flex-wrap gap-2 text-xs font-medium text-gray-500">
            {if entity_list_context.result_label}<span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-1">{entity_list_context.result_label}</span>{/if}
            {if entity_list_context.category_name}<span class="inline-flex items-center rounded-full bg-sky-50 px-2.5 py-1 text-sky-700">Category: {entity_list_context.category_name}</span>{/if}
            {if entity_list_context.search}<span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 text-amber-700">Search: &quot;{entity_list_context.search}&quot;</span>{/if}
        </div>
        {/if}
    </header>
    {/if}

    {if entity_list_context.search_action_url or entity_list_context.available_categories | count > 0}
    <div class="cms-entity-list__controls mb-6 rounded-2xl border border-gray-100 bg-white/90 p-4 shadow-sm">
        <form method="get" action="{entity_list_context.search_action_url|default:entity_list_context.base_list_url}" class="flex flex-col gap-3 md:flex-row md:items-center">
            {if entity_list_context.category_id > 0 and entity_list_context.category_slug == ''}<input type="hidden" name="cat" value="{entity_list_context.category_id}">{/if}
            <input
                type="text"
                name="search"
                value="{entity_list_context.search|default:''}"
                placeholder="Search products"
                class="min-w-0 flex-1 rounded-xl border border-gray-200 px-4 py-2.5 text-sm text-gray-700 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-100"
            >
            <button type="submit" class="inline-flex items-center justify-center rounded-xl bg-sky-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-sky-700">Search</button>
        </form>

        {if entity_presentation.list_category_navigation == 'dropdown'}
        <form method="get" action="{entity_list_context.all_items_url|default:entity_list_context.base_list_url}" class="cms-entity-list__category-picker mt-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            {if entity_list_context.search}<input type="hidden" name="search" value="{entity_list_context.search}">{/if}
            <label for="cms-entity-list-category" class="text-xs font-semibold uppercase tracking-[0.14em] text-gray-500">Shop Categories</label>
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                <select id="cms-entity-list-category" name="cat" class="min-w-[220px] rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm text-gray-700 shadow-sm focus:border-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-100">
                    <option value="" {if entity_list_context.category_id == 0 and entity_list_context.category_slug == ''}selected{/if}>All Products</option>
                    {foreach entity_list_context.available_categories as category}
                    <option value="{category.id}" {if category.is_active}selected{/if}>{category.name}</option>
                    {/foreach}
                </select>
                <button type="submit" class="inline-flex items-center justify-center rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 transition-colors hover:border-sky-200 hover:text-sky-700">Browse</button>
            </div>
        </form>
        {else}
        <nav class="mt-4 flex flex-wrap gap-2" aria-label="Categories">
            <a href="{entity_list_context.all_items_url|default:entity_list_context.base_list_url}" class="inline-flex items-center rounded-full border px-3 py-1.5 text-sm transition-colors {if entity_list_context.category_id == 0 and entity_list_context.category_slug == ''}border-sky-600 bg-sky-600 text-white{else}border-gray-200 bg-white text-gray-600 hover:border-sky-200 hover:text-sky-700{/if}">All Products</a>
            {foreach entity_list_context.available_categories as category}
            <a href="{category.url}" class="inline-flex items-center rounded-full border px-3 py-1.5 text-sm transition-colors {if category.is_active}border-sky-600 bg-sky-600 text-white{else}border-gray-200 bg-white text-gray-600 hover:border-sky-200 hover:text-sky-700{/if}">{category.name}</a>
            {/foreach}
        </nav>
        {/if}
        {/if}
    </div>
    {/if}

    {if items}
    <div class="cms-entity-list__grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {foreach items as item}
        <div
            class="cms-entity-card group bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow overflow-hidden"
            data-entity-kind="list-item"
            data-entity-type="{item.entity_type|default:content_type|default:'generic'}"
            data-entity-id="{item.id|default:''}"
            data-entity-slug="{item.slug|default:''}"
        >
            <a href="{item.url}" class="block no-underline text-inherit">
                {if item.primary_image_url}
                <div class="aspect-video overflow-hidden bg-gray-100">
                    <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                         src="{item.primary_image_url}"
                         alt="{item.title}">
                </div>
                {/if}

                <div class="cms-entity-card__body p-4">
                    <h2 class="cms-entity-card__title text-base font-semibold text-gray-900 group-hover:text-sky-600 leading-snug mb-1">{item.title}</h2>

                    {if item.list_card_excerpt}
                    <p class="cms-entity-card__excerpt text-sm text-gray-500 line-clamp-2">{item.list_card_excerpt}</p>
                    {/if}

                    {if item.list_card_pricing_html}{item.list_card_pricing_html | raw}{/if}
                    {if item.list_card_inventory_html}{item.list_card_inventory_html | raw}{/if}
                    {if item.list_card_progress_html}{item.list_card_progress_html | raw}{/if}
                </div>
            </a>

            {if item.list_card_action_html}
            <div class="cms-entity-card__actions px-4 pb-3 pt-2 border-t border-gray-50">
                {item.list_card_action_html | raw}
            </div>
            {/if}
        </div>
        {/foreach}
    </div>

    {if pagination}
    <nav class="mt-8 flex items-center justify-center gap-2" aria-label="Pagination">
        {if pagination.prev_url}<a href="{pagination.prev_url}" class="px-4 py-2 text-sm rounded-lg border border-gray-200 hover:bg-gray-50">&larr; Previous</a>{/if}
        <span class="text-sm text-gray-500">Page {pagination.current} of {pagination.total}</span>
        {if pagination.next_url}<a href="{pagination.next_url}" class="px-4 py-2 text-sm rounded-lg border border-gray-200 hover:bg-gray-50">Next &rarr;</a>{/if}
    </nav>
    {/if}

    {else}
    <div class="rounded-2xl border border-dashed border-gray-200 bg-white/70 px-6 py-12 text-center text-gray-500">
        <p>No items found.</p>
        {if entity_list_context.all_items_url and entity_list_context.active_filter_count > 0}
        <a href="{entity_list_context.all_items_url}" class="mt-3 inline-flex items-center text-sm font-medium text-sky-600 hover:text-sky-700">Browse all products</a>
        {/if}
    </div>
    {/if}

</section>
{/block}
