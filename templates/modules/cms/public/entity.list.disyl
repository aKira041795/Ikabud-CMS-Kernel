{extends "modules/cms/layouts/public.disyl"}

{block head}
{if cms_head}{cms_head | raw}{/if}
{/block}

{block content}
<section
    class="cms-entity-list cms-entity-list--density-{entity_presentation.list_card_density|default:'comfortable'} w-full max-w-5xl mx-auto px-4 py-8"
    data-public-render-origin="{public_render_origin|default:'cms'}"
    data-public-route-kind="{public_route_kind|default:'generic'}"
    data-public-presentation-mode="{public_presentation_mode|default:'traditional'}"
    data-list-search="{entity_list_context.search|default:''}"
    data-list-category-slug="{entity_list_context.category_slug|default:''}"
    data-list-result-count="{entity_list_context.result_count|default:0}"
    data-list-active-filter-count="{entity_list_context.active_filter_count|default:0}"
>

    {if list_title}
    <header class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">{list_title}</h1>
        {if list_description}<p class="text-gray-500 mt-1">{list_description}</p>{/if}
        {if entity_presentation.list_show_filter_summary and (entity_list_context.result_label or entity_list_context.category_name or entity_list_context.search)}
        <div class="mt-3 flex flex-wrap gap-2 text-xs font-medium text-gray-500">
            {if entity_list_context.result_label}<span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-1">{entity_list_context.result_label}</span>{/if}
            {if entity_list_context.category_name}<span class="inline-flex items-center rounded-full bg-sky-50 px-2.5 py-1 text-sky-700">Category: {entity_list_context.category_name}</span>{/if}
            {if entity_list_context.search}<span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 text-amber-700">Search: &quot;{entity_list_context.search}&quot;</span>{/if}
        </div>
        {/if}
    </header>
    {/if}

    {if items}
    <div class="cms-entity-list__grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {foreach items as item}
        <a
            href="{item.url}"
            class="cms-entity-card group block bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow overflow-hidden no-underline"
            data-entity-kind="list-item"
            data-entity-type="{item.entity_type|default:content_type|default:'generic'}"
            data-entity-id="{item.id|default:''}"
            data-entity-slug="{item.slug|default:''}"
        >

            {if item.primary_image_url}
            <div class="aspect-video overflow-hidden bg-gray-100">
                <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                     src="{item.primary_image_url}"
                     alt="{item.title}">
            </div>
            {/if}

            <div class="cms-entity-card__body p-4">
                <h2 class="text-base font-semibold text-gray-900 group-hover:text-sky-600 leading-snug mb-1">{item.title}</h2>

                {if item.list_card_excerpt}
                <p class="cms-entity-card__excerpt text-sm text-gray-500 line-clamp-2">{item.list_card_excerpt}</p>
                {/if}

                {if item.list_card_pricing_html}{item.list_card_pricing_html | raw}{/if}
                {if item.list_card_inventory_html}{item.list_card_inventory_html | raw}{/if}
                {if item.list_card_progress_html}{item.list_card_progress_html | raw}{/if}
            </div>
        </a>
        {/foreach}
    </div>

    {if pagination}
    <nav class="mt-8 flex items-center justify-center gap-2" aria-label="Pagination">
        {if pagination.prev_url}<a href="{pagination.prev_url}" class="px-4 py-2 text-sm rounded-lg border border-gray-200 hover:bg-gray-50">&larr; Previous</a>{/if}
        <span class="text-sm text-gray-500">Page {pagination.current} of {pagination.total}</span>
        {if pagination.next_url}<a href="{pagination.next_url}" class="px-4 py-2 text-sm rounded-lg border border-gray-200 hover:bg-gray-50">Next &rarr;</a>{/if}
    </nav>
    {/if}

    {else}
    <p class="text-gray-500">No items found.</p>
    {/if}

</section>
{/block}
