{* pricing.minimal.block.disyl — subdued editorial price label *}
{if capabilities.pricing}
<div class="cms-pricing-block cms-pricing-block-minimal my-4 text-sm font-medium text-slate-600">
    <span class="uppercase tracking-[0.16em] text-slate-400">Price</span>
    <span class="cms-price-current ml-2 text-base font-semibold text-slate-900">
        {if capability_data.pricing.sale_price}
            {capability_data.pricing.currency} {capability_data.pricing.sale_price | number_format:2}
        {else}
            {capability_data.pricing.currency} {capability_data.pricing.price | number_format:2}
        {/if}
    </span>
    {if capability_data.pricing.sale_price}
    <span class="cms-price-previous ml-2 text-sm text-slate-400 line-through">{capability_data.pricing.currency} {capability_data.pricing.price | number_format:2}</span>
    {/if}
</div>
{/if}
