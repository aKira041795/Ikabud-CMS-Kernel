{if capabilities.pricing and capability_data.pricing.price}
<div class="cms-entity-card__pricing cms-entity-card__pricing--featured mt-2 flex flex-wrap items-center gap-2 rounded-xl border border-sky-100 bg-sky-50/80 px-3 py-2">
    {if capability_data.pricing.sale_price}
    <span class="cms-price-current text-sm font-bold text-slate-900">{capability_data.pricing.currency} {capability_data.pricing.sale_price | number_format:2}</span>
    <span class="cms-price-previous text-xs text-slate-400 line-through">{capability_data.pricing.currency} {capability_data.pricing.price | number_format:2}</span>
    <span class="cms-price-badge inline-flex items-center rounded-full bg-slate-900 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.12em] text-white">Sale</span>
    {else}
    <span class="cms-price-current text-sm font-bold text-slate-900">{capability_data.pricing.currency} {capability_data.pricing.price | number_format:2}</span>
    {/if}
</div>
{/if}