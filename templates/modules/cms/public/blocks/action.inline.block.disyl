{if action_sections}{action_sections | raw}{else}
<div class="cms-action-block cms-action-block-inline my-6 flex flex-wrap items-center gap-2.5 rounded-xl border border-slate-200 bg-white/90 p-3">
    {if capabilities.pricing and cart_enabled}
        {if not capabilities.inventory or capability_data.inventory.in_stock and not capability_data.inventory.out_of_stock}
    <form method="POST" action="{cart_action_url}" class="inline">
        <input type="hidden" name="product_id" value="{entity.id}">
        <input type="hidden" name="qty" value="1">
        <button type="submit"
                class="cms-btn-primary inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-slate-800 active:bg-slate-950">
            Add to Cart
        </button>
    </form>
        {else}
    <span class="cms-btn-disabled inline-flex items-center gap-2 rounded-xl bg-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-500">
        Out of Stock
    </span>
        {/if}
    {elseif capabilities.pricing and not cart_enabled}
    <span class="cms-btn-disabled inline-flex items-center gap-2 rounded-xl bg-slate-100 px-5 py-2.5 text-sm font-semibold text-slate-500">
        Price shown - cart coming soon
    </span>
    {/if}

    {if capabilities.booking}
    <a href="{base_url}/cms/{entity.type}/{entity.slug}/book"
       class="cms-btn-secondary inline-flex items-center gap-2 rounded-xl border border-sky-600 px-5 py-2.5 text-sm font-semibold text-sky-600 hover:bg-sky-50 transition-colors">
        Book Now
    </a>
    {/if}

    {if capabilities.inquiry}
    <a href="{base_url}/cms/{entity.type}/{entity.slug}/inquire"
       class="cms-btn-secondary inline-flex items-center gap-2 rounded-xl border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
        {if capability_data.inquiry.label}{capability_data.inquiry.label}{else}Inquire{/if}
    </a>
    {/if}
</div>
{/if}