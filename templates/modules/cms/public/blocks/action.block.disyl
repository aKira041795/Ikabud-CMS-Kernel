{* action.block.disyl — primary CTA: buy / book / inquire (capability-driven) *}
{* @requires entity.capability.pricing.data@1, entity.capability.booking.data@1, entity.capability.inquiry.data@1 *}
{if action_sections}{action_sections | raw}{else}
<div class="cms-action-block my-8 flex flex-wrap gap-3 items-center">

    {* ecommerce: buy button (pricing + cart endpoint must exist) *}
    {if capabilities.pricing and cart_enabled}
        {if not capabilities.inventory or capability_data.inventory.in_stock}
        <form method="POST" action="{cart_action_url}" class="inline">
            <input type="hidden" name="entity_id" value="{entity.id}">
            <input type="hidden" name="_csrf" value="{csrf_token}">
            <button type="submit"
                    class="cms-btn-primary inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-sky-600 text-white font-semibold text-sm hover:bg-sky-700 active:bg-sky-800 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M3 3h2l.4 2M7 13h10l4-9H5.4M7 13l-1.5 6h13M7 13L5.4 5M17 13l1.5 6M9 21a1 1 0 100-2 1 1 0 000 2zm8 0a1 1 0 100-2 1 1 0 000 2z"/>
                </svg>
                Add to Cart
            </button>
        </form>
        {else}
        <button type="button" disabled
                class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-gray-200 text-gray-400 font-semibold text-sm cursor-not-allowed">
            Out of Stock
        </button>
        {/if}
    {elseif capabilities.pricing and not cart_enabled}
        <span class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-gray-100 text-gray-500 font-semibold text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 3h2l.4 2M7 13h10l4-9H5.4M7 13l-1.5 6h13M7 13L5.4 5M17 13l1.5 6M9 21a1 1 0 100-2 1 1 0 000 2zm8 0a1 1 0 100-2 1 1 0 000 2z"/>
            </svg>
            Price shown — cart coming soon
        </span>
    {/if}

    {* booking: opens booking flow *}
    {if capabilities.booking}
    <a href="{base_url}/{entity.slug}/book"
       class="cms-btn-secondary inline-flex items-center gap-2 px-6 py-2.5 rounded-lg border border-sky-600 text-sky-600 font-semibold text-sm hover:bg-sky-50 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        Book Now
    </a>
    {/if}

    {* inquiry: opens a simple contact form *}
    {if capabilities.inquiry}
    <a href="{base_url}/{entity.slug}/inquire"
       class="cms-btn-secondary inline-flex items-center gap-2 px-6 py-2.5 rounded-lg border border-gray-300 text-gray-700 font-semibold text-sm hover:bg-gray-50 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        {if capability_data.inquiry.label}{capability_data.inquiry.label}{else}Inquire{/if}
    </a>
    {/if}

</div>
{/if}
