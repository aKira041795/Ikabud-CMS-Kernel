{* pricing.featured.block.disyl — featured commerce price card *}
{if capability_data.pricing}
<div class="cms-pricing-block cms-pricing-block-featured my-4 rounded-2xl border border-sky-100 bg-gradient-to-br from-sky-50 via-white to-cyan-50 p-5 shadow-sm">
    <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-sky-700">Featured offer</div>
    <div class="mt-3 flex items-end gap-3">
        {if capability_data.pricing.sale_price}
        <span class="text-3xl font-bold leading-none text-slate-900">{capability_data.pricing.currency} {capability_data.pricing.sale_price | number_format:2}</span>
        <span class="pb-1 text-base text-slate-400 line-through">{capability_data.pricing.currency} {capability_data.pricing.price | number_format:2}</span>
        {else}
        <span class="text-3xl font-bold leading-none text-slate-900">{capability_data.pricing.currency} {capability_data.pricing.price | number_format:2}</span>
        {/if}
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center rounded-full bg-slate-900 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.12em] text-white">Ready to purchase</span>
        {if capability_data.pricing.sale_price}
        <span class="inline-flex items-center rounded-full bg-rose-50 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.12em] text-rose-700">Sale active</span>
        {/if}
    </div>
</div>
{/if}
