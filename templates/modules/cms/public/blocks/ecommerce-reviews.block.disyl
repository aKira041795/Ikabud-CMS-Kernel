{if public_render_origin == 'ecommerce' and (content_type == 'product' or product.id or storefront.product.id)}
<section class="mt-10 border-t border-gray-200 pt-8" id="product-reviews">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
            <h2 class="text-xl font-semibold text-gray-900">Customer Reviews</h2>
            <p class="mt-1 text-sm text-gray-500">{review_summary.label|default:'No reviews yet'}</p>
        </div>
        {if review_summary.has_reviews}
        <div class="rounded-xl bg-amber-50 px-4 py-3 text-right text-sm text-amber-800">
            <div class="text-lg font-semibold">{review_summary.average_rating_formatted}/5</div>
            <div>{review_summary.approved_count} {if review_summary.approved_count == 1}review{else}reviews{/if}</div>
        </div>
        {/if}
    </div>

    {if reviews | count > 0}
    <div class="mt-6 space-y-4">
        {foreach reviews as review}
        <article class="rounded-2xl border border-gray-100 bg-white p-4 shadow-sm">
            <div class="flex flex-wrap items-center gap-2 text-sm">
                <span class="font-semibold text-gray-900">{review.reviewer_name}</span>
                <span class="text-amber-600 font-medium">{review.rating}/5</span>
                {if review.verified_purchase}<span class="inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-semibold text-emerald-700">Verified purchase</span>{/if}
                <span class="text-xs text-gray-400">{review.created_at}</span>
            </div>
            <p class="mt-3 whitespace-pre-line text-sm leading-6 text-gray-700">{review.review_body}</p>
        </article>
        {/foreach}
    </div>
    {else}
    <div class="mt-6 rounded-2xl border border-dashed border-gray-200 bg-gray-50 px-4 py-5 text-sm text-gray-500">
        No approved reviews yet. Be the first to leave one.
    </div>
    {/if}

    <div class="mt-8 rounded-2xl border border-gray-200 bg-gray-50 p-5">
        <h3 class="text-base font-semibold text-gray-900">Write a Review</h3>
        <p class="mt-1 text-sm text-gray-500">Reviews are moderated before they appear on the product page.</p>

        <form class="mt-4 space-y-3" data-review-form data-product-id="{entity.id|default:product.id|default:storefront.product.id}">
            {if not public_customer_is_logged_in}
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                <input type="text" name="guest_name" placeholder="Your name" class="w-full rounded-xl border border-gray-300 px-3 py-2 text-sm text-gray-900 outline-none focus:border-orange-500">
                <input type="email" name="guest_email" placeholder="Your email" class="w-full rounded-xl border border-gray-300 px-3 py-2 text-sm text-gray-900 outline-none focus:border-orange-500">
            </div>
            {/if}
            <div>
                <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.14em] text-gray-500">Rating</label>
                <select name="rating" class="w-full rounded-xl border border-gray-300 px-3 py-2 text-sm text-gray-900 outline-none focus:border-orange-500">
                    <option value="">Select a rating</option>
                    <option value="5">5 - Excellent</option>
                    <option value="4">4 - Very good</option>
                    <option value="3">3 - Good</option>
                    <option value="2">2 - Fair</option>
                    <option value="1">1 - Poor</option>
                </select>
            </div>
            <div>
                <label class="mb-1 block text-xs font-semibold uppercase tracking-[0.14em] text-gray-500">Review</label>
                <textarea name="review_body" rows="5" class="w-full rounded-xl border border-gray-300 px-3 py-2 text-sm text-gray-900 outline-none focus:border-orange-500" placeholder="Tell other customers what you liked, what could be better, and who this product is for."></textarea>
            </div>
            <div class="flex items-center justify-between gap-3">
                <p class="text-xs text-gray-500">Approved reviews appear automatically after moderation.</p>
                <button type="submit" class="inline-flex items-center justify-center rounded-xl bg-orange-600 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-700">Submit Review</button>
            </div>
            <div class="hidden rounded-xl border px-3 py-2 text-sm" data-review-message></div>
        </form>
    </div>
</section>

<script>
(function () {
    var forms = document.querySelectorAll('[data-review-form]');
    if (!forms.length) {
        return;
    }

    forms.forEach(function (form) {
        form.addEventListener('submit', async function (event) {
            event.preventDefault();

            var productId = form.getAttribute('data-product-id');
            var message = form.querySelector('[data-review-message]');
            var submitButton = form.querySelector('button[type="submit"]');
            var formData = new FormData(form);
            var payload = {};

            formData.forEach(function (value, key) {
                payload[key] = value;
            });

            if (!productId) {
                return;
            }

            if (message) {
                message.classList.add('hidden');
                message.textContent = '';
            }

            if (submitButton) {
                submitButton.disabled = true;
                submitButton.textContent = 'Submitting...';
            }

            try {
                var response = await fetch('{base_url}/api/v1/ecommerce/products/' + productId + '/reviews', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(payload)
                });
                var data = await response.json();

                if (!response.ok || !data.ok) {
                    throw new Error(data.error || 'Could not submit review.');
                }

                form.reset();
                if (message) {
                    message.textContent = data.message || 'Review submitted for moderation.';
                    message.className = 'rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-700';
                }
            } catch (error) {
                if (message) {
                    message.textContent = error && error.message ? error.message : 'Could not submit review.';
                    message.className = 'rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700';
                }
            } finally {
                if (message) {
                    message.classList.remove('hidden');
                }
                if (submitButton) {
                    submitButton.disabled = false;
                    submitButton.textContent = 'Submit Review';
                }
            }
        });
    });
})();
</script>
{/if}
