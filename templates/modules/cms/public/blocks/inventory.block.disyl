{* inventory.block.disyl — stock badge *}
{* @requires entity.capability.inventory.data@1 *}
{if capability_data.inventory}
<div class="cms-inventory-block my-2">
    {if capability_data.inventory.in_stock}
    {if capability_data.inventory.low_stock}
    <span class="cms-inventory-pill cms-inventory-pill--low inline-flex items-center gap-1 text-sm text-amber-700 bg-amber-50 border border-amber-100 rounded-full px-2.5 py-0.5">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.981-1.742 2.981H4.419c-1.53 0-2.492-1.647-1.742-2.98l5.58-9.92zM11 13a1 1 0 10-2 0 1 1 0 002 0zm-1-6a1 1 0 00-1 1v3a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
        Low Stock
        {if capability_data.inventory.track_stock and capability_data.inventory.stock_qty != null}
        <span class="text-amber-600">({capability_data.inventory.stock_qty} left)</span>
        {/if}
    </span>
    {else}
    <span class="cms-inventory-pill cms-inventory-pill--ok inline-flex items-center gap-1 text-sm text-green-700 bg-green-50 border border-green-100 rounded-full px-2.5 py-0.5">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 00-1.414 0L8 12.586l-3.293-3.293a1 1 0 00-1.414 1.414l4 4a1 1 0 001.414 0l8-8a1 1 0 000-1.414z" clip-rule="evenodd"/></svg>
        In Stock
        {if capability_data.inventory.track_stock and capability_data.inventory.stock_qty != null}
        <span class="text-green-500">({capability_data.inventory.stock_qty} left)</span>
        {/if}
    </span>
    {/if}
    {elseif capability_data.inventory.out_of_stock or not capability_data.inventory.in_stock}
    <span class="cms-inventory-pill cms-inventory-pill--out inline-flex items-center gap-1 text-sm text-red-600 bg-red-50 border border-red-100 rounded-full px-2.5 py-0.5">Out of Stock</span>
    {else}
    <span class="cms-inventory-pill cms-inventory-pill--ok inline-flex items-center gap-1 text-sm text-green-700 bg-green-50 border border-green-100 rounded-full px-2.5 py-0.5">In Stock</span>
    {/if}
    {if capability_data.inventory.sku}
    <span class="ml-2 text-xs text-gray-400">SKU: {capability_data.inventory.sku}</span>
    {/if}
</div>
{/if}
