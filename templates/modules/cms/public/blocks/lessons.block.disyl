{* lessons.block.disyl — ordered chapter/lesson index *}
{* @requires entity.capability.lessons_index.data@1 *}
{if capabilities.lessons_index and capability_data.lessons_index.items}
<div class="cms-lessons-block my-8 border border-gray-100 rounded-xl overflow-hidden">
    <div class="cms-lessons-header bg-gray-50 px-5 py-3 border-b border-gray-100">
        <h3 class="cms-lessons-title text-base font-semibold text-gray-800">Contents</h3>
    </div>
    <ol class="cms-lessons-list divide-y divide-gray-100">
        {foreach capability_data.lessons_index.items as lesson loop}
        <li class="cms-lessons-item flex items-center gap-3 px-5 py-3 hover:bg-gray-50 transition-colors">
            <span class="cms-lessons-index text-sm font-mono text-gray-400 w-6 shrink-0">{loop.index1}.</span>
            <a href="{base_url}/cms/{capability_data.lessons_index.child_type}/{lesson.slug}"
               class="cms-lessons-link flex-1 text-sm text-gray-700 hover:text-sky-600 no-underline truncate
               {if lesson.status != 'published'} opacity-50 pointer-events-none{/if}">
                {lesson.title}
            </a>
            {if lesson.status != 'published'}
            <span class="cms-lessons-status text-xs text-gray-400 shrink-0">Draft</span>
            {/if}
        </li>
        {/foreach}
    </ol>
</div>
{/if}
