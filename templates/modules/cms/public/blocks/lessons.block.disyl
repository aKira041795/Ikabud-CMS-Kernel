{* lessons.block.disyl — ordered chapter/lesson index *}
{if capability_data.lessonsindex and capability_data.lessonsindex.items}
<div class="cms-lessons-block my-8 border border-gray-100 rounded-xl overflow-hidden">
    <div class="bg-gray-50 px-5 py-3 border-b border-gray-100">
        <h3 class="text-base font-semibold text-gray-800">Contents</h3>
    </div>
    <ol class="divide-y divide-gray-100">
        {foreach capability_data.lessonsindex.items as lesson loop}
        <li class="flex items-center gap-3 px-5 py-3 hover:bg-gray-50 transition-colors">
            <span class="text-sm font-mono text-gray-400 w-6 shrink-0">{loop.index1}.</span>
            <a href="{base_url}/{lesson.slug}"
               class="flex-1 text-sm text-gray-700 hover:text-sky-600 no-underline truncate
               {if lesson.status != 'publish'} opacity-50 pointer-events-none{/if}">
                {lesson.title}
            </a>
            {if lesson.status != 'publish'}
            <span class="text-xs text-gray-400 shrink-0">Draft</span>
            {/if}
        </li>
        {/foreach}
    </ol>
</div>
{/if}
