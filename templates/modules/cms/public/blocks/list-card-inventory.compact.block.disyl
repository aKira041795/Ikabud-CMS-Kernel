{if capabilities.inventory and capability_data.inventory.track_stock}
<div class="cms-entity-card__inventory cms-entity-card__inventory--compact mt-2 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-500">
    {if capability_data.inventory.out_of_stock or not capability_data.inventory.in_stock}
    <span class="cms-inventory-pill cms-inventory-pill--out inline-flex items-center rounded-full bg-red-50 px-2 py-0.5 text-red-600">Out</span>
    {elseif capability_data.inventory.low_stock}
    <span class="cms-inventory-pill cms-inventory-pill--low inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-amber-700">{capability_data.inventory.stock_qty} left</span>
    {else}
    <span class="cms-inventory-pill cms-inventory-pill--ok inline-flex items-center rounded-full bg-emerald-50 px-2 py-0.5 text-emerald-700">In stock</span>
    {/if}
</div>
{/if}