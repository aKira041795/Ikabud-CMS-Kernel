{if capability_data.inventory}
<div class="cms-inventory-block cms-inventory-block-compact my-2 flex flex-wrap items-center gap-2 text-xs font-semibold">
    {if capability_data.inventory.out_of_stock or not capability_data.inventory.in_stock}
    <span class="cms-inventory-pill cms-inventory-pill--out inline-flex items-center rounded-full bg-red-50 px-2.5 py-1 text-red-600">Out of stock</span>
    {elseif capability_data.inventory.low_stock}
    <span class="cms-inventory-pill cms-inventory-pill--low inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 text-amber-700">Low stock</span>
    {else}
    <span class="cms-inventory-pill cms-inventory-pill--ok inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-1 text-emerald-700">In stock</span>
    {/if}
    {if capability_data.inventory.track_stock and capability_data.inventory.stock_qty != null}
    <span class="text-slate-400">{capability_data.inventory.stock_qty} left</span>
    {/if}
    {if capability_data.inventory.sku}
    <span class="text-slate-400">SKU {capability_data.inventory.sku}</span>
    {/if}
</div>
{/if}