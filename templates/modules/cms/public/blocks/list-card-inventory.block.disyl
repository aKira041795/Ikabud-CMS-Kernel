{if capability_data.inventory and capability_data.inventory.track_stock}
<div class="cms-entity-card__inventory mt-2 text-xs font-medium">
    {if capability_data.inventory.out_of_stock or not capability_data.inventory.in_stock}
    <span class="cms-inventory-pill cms-inventory-pill--out inline-flex items-center rounded-full bg-red-50 px-2.5 py-1 text-red-600">Out of stock</span>
    {elseif capability_data.inventory.low_stock}
    <span class="cms-inventory-pill cms-inventory-pill--low inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 text-amber-700">Low stock - only {capability_data.inventory.stock_qty} left</span>
    {/if}
</div>
{/if}