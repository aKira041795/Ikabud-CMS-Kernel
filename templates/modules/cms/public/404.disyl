{extends "modules/cms/layouts/public.disyl"}

{block content}
<section class="mx-auto max-w-4xl px-4 py-12 md:py-20">
    <div class="relative overflow-hidden rounded-[2rem] border border-sky-100 bg-white shadow-[0_30px_80px_rgba(15,23,42,0.08)]">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(14,165,233,0.18),_transparent_42%),radial-gradient(circle_at_bottom_right,_rgba(251,191,36,0.18),_transparent_36%)]"></div>
        <div class="relative grid gap-8 p-8 md:grid-cols-[auto,1fr] md:items-center md:p-12">
            <div class="inline-flex h-24 w-24 items-center justify-center rounded-[1.75rem] bg-slate-900 text-3xl font-black tracking-[0.18em] text-white shadow-lg shadow-slate-900/15">
                404
            </div>

            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.32em] text-sky-600">CMS Public Page</p>
                <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 md:text-5xl">{not_found_title|default:"Page not found"}</h1>
                <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-600 md:text-base">{not_found_body|default:"The page you requested could not be found or may have moved."}</p>

                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <a href="{not_found_primary_href|default:'/cms'}" class="inline-flex items-center justify-center rounded-full bg-slate-900 px-5 py-3 text-sm font-semibold text-white no-underline transition-transform hover:-translate-y-0.5 hover:bg-slate-800">{not_found_primary_label|default:"Go to Home"}</a>
                    <a href="{not_found_secondary_href|default:'/cms/blog'}" class="inline-flex items-center justify-center rounded-full border border-slate-200 bg-white px-5 py-3 text-sm font-semibold text-slate-700 no-underline transition-colors hover:border-sky-200 hover:text-sky-700">{not_found_secondary_label|default:"Browse Posts"}</a>
                </div>

                <div class="mt-8 rounded-[1.5rem] border border-slate-100 bg-slate-50/90 p-5">
                    <p class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Try a Search Instead</p>
                    <form action="{not_found_search_action|default:'/cms/search'}" method="GET" class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center">
                        <input type="search" name="q" placeholder="Search posts, pages, and products" class="min-w-0 flex-1 rounded-full border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm outline-none transition-colors focus:border-sky-400 focus:ring-2 focus:ring-sky-100">
                        <button type="submit" class="inline-flex items-center justify-center rounded-full bg-sky-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-sky-700">Search</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
{/block}