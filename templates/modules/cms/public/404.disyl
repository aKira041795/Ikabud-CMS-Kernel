{extends "pages/404.disyl"}

{block content}
{* Pass CMS-specific context for link resolution *}
{include parent() with {
    base_url: '/cms',
    gui: gui,
    not_found_title: not_found_title|default:'Page not found',
    not_found_body: not_found_body|default:'The page you requested could not be found or may have moved.'
}}
{/block}