{extends "modules/cms/layouts/public.disyl"}

{block head}
{if cms_head}{cms_head | raw}{/if}
{if structured_data}{structured_data | raw}{/if}
{/block}

{block content}
{cache key='cms:page:' + content.slug|default:'_' + ':' + content.updated_at|default:'0' ttl=300 tags=['cms:content:item','cms:content:list','cms:menu','cms:settings']}
{if builder_enabled}
<article class="w-full {builder_page_settings.container_class}">
    {content_html | raw}
</article>
{else}
<article class="max-w-3xl mx-auto">
    <header class="mb-8">
        <h1 class="text-3xl font-bold  leading-tight">{content.title}</h1>
    </header>

    <div class="prose text-gray-700 leading-relaxed text-base">
        {content_html | raw}
    </div>
</article>
{/if}
{/cache}
{/block}
