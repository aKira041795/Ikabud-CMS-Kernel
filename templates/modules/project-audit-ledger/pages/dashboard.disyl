{extends "modules/project-audit-ledger/layouts/admin.disyl"}

{block content}
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Active Projects</div>
        <div class="text-2xl font-bold text-gray-900">{active_projects}</div>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Total Contract Value</div>
        <div class="text-2xl font-bold text-green-700">₱{total_contract|number_format:2}</div>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Pending Approvals</div>
        <div class="text-2xl font-bold text-amber-700">{pending_approvals}</div>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Low Stock Items</div>
        <div class="text-2xl font-bold text-red-700">{low_stock_count}</div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="px-5 py-4 border-b border-gray-200">
            <h2 class="font-semibold text-gray-900">Recent Projects</h2>
        </div>
        {if recent_projects|count > 0}
        <div class="divide-y divide-gray-100">
            {for p in recent_projects}
            <div class="px-5 py-3 flex justify-between items-center">
                <div>
                    <div class="text-sm font-medium text-gray-900">{p.title}</div>
                    <div class="text-xs text-gray-500">{p.project_id} · {p.status}</div>
                </div>
                <a href="/admin/project-audit-ledger/projects/{p.id}" class="text-xs text-pal-600 hover:text-pal-700 font-medium">View</a>
            </div>
            {/for}
        </div>
        {else}
        <div class="p-5 text-center text-gray-400 text-sm">No projects yet.</div>
        {/if}
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="px-5 py-4 border-b border-gray-200">
            <h2 class="font-semibold text-gray-900">Recent Expenses</h2>
        </div>
        {if recent_expenses|count > 0}
        <div class="divide-y divide-gray-100">
            {for e in recent_expenses}
            <div class="px-5 py-3 flex justify-between items-center">
                <div>
                    <div class="text-sm font-medium text-gray-900">{e.description}</div>
                    <div class="text-xs text-gray-500">{e.category_name|default:'—'} · {e.expense_date}</div>
                </div>
                <div class="text-sm font-semibold text-gray-900">₱{e.amount|number_format:2}</div>
            </div>
            {/for}
        </div>
        {else}
        <div class="p-5 text-center text-gray-400 text-sm">No expenses yet.</div>
        {/if}
    </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
    <div class="grid grid-cols-3 gap-5 text-center">
        <div>
            <div class="text-xs font-semibold text-gray-500 uppercase">Total Expenses</div>
            <div class="text-xl font-bold text-gray-900">₱{total_expenses|number_format:2}</div>
        </div>
        <div>
            <div class="text-xs font-semibold text-gray-500 uppercase">Collected</div>
            <div class="text-xl font-bold text-green-700">₱{total_collected|number_format:2}</div>
        </div>
        <div>
            <div class="text-xs font-semibold text-gray-500 uppercase">Est. Profit</div>
            <div class="text-xl font-bold text-blue-700">₱{est_profit|number_format:2}</div>
        </div>
    </div>
</div>
{/block}
