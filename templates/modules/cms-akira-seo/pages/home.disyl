{extends "modules/cms/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-xl font-bold text-slate-900">CMS Akira SEO</h1>
            <p class="mt-0.5 text-sm text-slate-500">SEO extension for the CMS Akira suite. Optimize content metadata, sitemaps, and search visibility.</p>
        </div>
    </div>

    <!-- Contract card -->
    <div class="rounded-[28px] border border-slate-200 bg-white/92 shadow-[0_18px_40px_rgba(15,23,42,0.05)] p-8">
        <h2 class="text-base font-bold text-slate-900 mb-3">What this module provides</h2>
        <p class="text-sm text-slate-600 leading-relaxed">
            Builds meta titles, descriptions, and canonical paths for content. It is consumed by content enrichment and
            composition (<code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">akira.content.enrich@1</code> /
            <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">akira.content.compose@1</code>) during public rendering.
            When the module is disabled, CMS Akira Core falls back to a deterministic metadata builder — content stays readable.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
            <span class="text-[11px] font-medium bg-slate-100 text-slate-600 rounded-full px-3 py-1">Exposes: <code>akira.seo.meta.build@1</code></span>
            <span class="text-[11px] font-medium bg-emerald-50 text-emerald-700 rounded-full px-3 py-1">Graceful fallback when disabled</span>
        </div>
    </div>

    <!-- Manage card -->
    <div class="rounded-[24px] border border-slate-200 bg-white/92 shadow-[0_18px_40px_rgba(15,23,42,0.05)] p-6">
        <div class="flex items-center justify-between gap-4">
            <div>
                <div class="font-semibold text-slate-900">SEO output</div>
                <p class="text-sm text-slate-500">Metadata is rendered automatically in public head output by the CMS module.</p>
            </div>
            <a href="{base_url}/cms/admin/settings" class="shrink-0 text-sm font-medium text-sky-600 hover:text-sky-800 no-underline">Open CMS Settings →</a>
        </div>
    </div>
</div>
{/block}
