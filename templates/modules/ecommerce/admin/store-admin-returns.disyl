{extends "modules/ecommerce/layouts/store-admin.disyl"}

{block content}
<div class="space-y-5">
    <div class="bg-white rounded-xl border border-gray-200 p-5">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div>
                <h2 class="text-lg font-semibold text-gray-900">Return Requests</h2>
                <p class="mt-1 text-sm text-gray-500">Review requests tied to products sold by this store.</p>
            </div>
            <form method="get" action="" class="flex items-center gap-3">
                <select name="status" class="border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white">
                    <option value="">All statuses</option>
                    <option value="pending" {if filters.status == 'pending'}selected{/if}>Pending</option>
                    <option value="approved" {if filters.status == 'approved'}selected{/if}>Approved</option>
                    <option value="rejected" {if filters.status == 'rejected'}selected{/if}>Rejected</option>
                    <option value="cancelled" {if filters.status == 'cancelled'}selected{/if}>Cancelled</option>
                </select>
                <button type="submit" class="inline-flex items-center rounded-lg bg-orange-600 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-700">Filter</button>
            </form>
        </div>
    </div>

    {if message}
    <div class="rounded-lg border px-4 py-3 text-sm {if message.type == 'success'}border-emerald-200 bg-emerald-50 text-emerald-800{else}border-red-200 bg-red-50 text-red-700{/if}">{message.text | escape}</div>
    {/if}

    {if !can_edit}
    <div class="bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 text-sm text-amber-700">
        You have read-only access to returns. Contact an owner or manager to review requests.
    </div>
    {/if}

    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        {if return_requests | count == 0}
        <div class="px-5 py-12 text-center text-sm text-slate-500">No return requests match the current filter.</div>
        {else}
        <table class="w-full text-sm">
            <thead class="bg-gray-50/80 border-b border-gray-200 text-[11px] uppercase tracking-wider font-semibold text-slate-600">
                <tr>
                    <th class="px-4 py-3 text-left">Request</th>
                    <th class="px-4 py-3 text-left">Items</th>
                    <th class="px-4 py-3 text-left">Customer</th>
                    <th class="px-4 py-3 text-left">Status</th>
                    <th class="px-4 py-3 text-left">Created</th>
                    <th class="px-4 py-3 text-right">Order</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {foreach return_requests as request}
                <tr class="hover:bg-gray-50 align-top">
                    <td class="px-4 py-3">
                        <div class="font-semibold text-gray-900">{request.request_number | escape}</div>
                        <div class="mt-1 text-xs text-slate-500">{request.reason | escape}</div>
                        {if request.admin_note}<div class="mt-1 text-xs text-slate-500">Note: {request.admin_note | escape}</div>{/if}
                    </td>
                    <td class="px-4 py-3 text-gray-700">
                        <div class="text-xs text-slate-500">{request.total_qty_requested} item{if request.total_qty_requested == 1}{else}s{/if}</div>
                        {foreach request.items as item}
                        <div class="mt-1 text-xs text-gray-700">{item.product_title | escape} × {item.qty_requested}</div>
                        {/foreach}
                    </td>
                    <td class="px-4 py-3 text-gray-700">{request.customer_name | default:request.created_by_name | default:'Customer'}</td>
                    <td class="px-4 py-3">
                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold
                            {if request.status == 'pending'}bg-amber-100 text-amber-800
                            {elseif request.status == 'approved'}bg-emerald-100 text-emerald-800
                            {elseif request.status == 'rejected'}bg-red-100 text-red-700
                            {else}bg-gray-100 text-gray-600{/if}">{request.status}</span>
                        {if can_edit && request.status == 'pending'}
                        <form method="post" action="" class="mt-3 space-y-2">
                            <input type="hidden" name="_token" value="{csrf_token}">
                            <input type="hidden" name="request_id" value="{request.id}">
                            <textarea name="admin_note" rows="2" placeholder="Optional note" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-xs resize-none focus:border-orange-500 outline-none"></textarea>
                            <div class="flex items-center gap-2">
                                <button type="submit" name="action" value="approve" class="px-3 py-1.5 rounded-lg bg-emerald-600 text-white text-xs font-semibold hover:bg-emerald-700">Approve</button>
                                <button type="submit" name="action" value="reject" class="px-3 py-1.5 rounded-lg bg-red-600 text-white text-xs font-semibold hover:bg-red-700">Reject</button>
                                <button type="submit" name="action" value="cancel" class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 text-xs font-semibold hover:bg-slate-200">Cancel</button>
                            </div>
                        </form>
                        {/if}
                    </td>
                    <td class="px-4 py-3 text-slate-600">{request.created_at | date:'M j, Y g:i A'}</td>
                    <td class="px-4 py-3 text-right">
                        <a href="{base_url}/ecommerce/store-admin/{store.id}/orders?search={request.order_number | url_encode}" class="text-orange-600 hover:text-orange-700 font-medium">{request.order_number | escape}</a>
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
        {/if}
    </div>

    {if total_pages > 1}
    <div class="flex items-center justify-between text-sm text-slate-500">
        <span>{total} requests</span>
        <div class="flex items-center gap-2">
            {if page > 1}<a href="?page={page - 1}&status={filters.status | escape}" class="px-3 py-1 border border-gray-200 rounded-lg hover:bg-gray-50">← Prev</a>{/if}
            <span>Page {page} / {total_pages}</span>
            {if page < total_pages}<a href="?page={page + 1}&status={filters.status | escape}" class="px-3 py-1 border border-gray-200 rounded-lg hover:bg-gray-50">Next →</a>{/if}
        </div>
    </div>
    {/if}
</div>
{/block}