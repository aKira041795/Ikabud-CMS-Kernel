{extends "modules/ecommerce/layouts/admin.disyl"}

{block content}
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2 space-y-4">
        <!-- Order header -->
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h2 class="text-lg font-bold text-gray-900">{order.order_number}</h2>
                    <p class="text-sm text-slate-500">{order.created_at}</p>
                </div>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold
                    {if order.status == 'pending'}bg-amber-50 text-amber-700
                    {elseif order.status == 'processing'}bg-blue-50 text-blue-700
                    {elseif order.status == 'shipped'}bg-purple-50 text-purple-700
                    {elseif order.status == 'delivered'}bg-emerald-50 text-emerald-700
                    {else}bg-gray-100 text-gray-600{/if}">{order.status}</span>
            </div>

            {if authority_scope == 'store' && authority_store}
            <div class="mb-4 rounded-lg border border-orange-200 bg-orange-50 px-4 py-3 text-sm text-orange-900">
                <div class="font-semibold">Store-owned order</div>
                <div class="mt-1">Global admin keeps visibility, but fulfillment authority belongs to {authority_store.name | escape}.</div>
                {if authority_store_admin_url}
                <a href="{authority_store_admin_url}" class="mt-2 inline-flex text-xs font-semibold text-orange-700 hover:text-orange-800">Open in store admin</a>
                {/if}
            </div>
            {/if}

            <!-- Items -->
            <table class="w-full text-sm">
                <thead class="border-b border-gray-200">
                    <tr class="text-left text-[11px] text-slate-600 uppercase tracking-wider font-semibold">
                        <th class="pb-2">Product</th>
                        <th class="pb-2 text-right">Unit Price</th>
                        <th class="pb-2 text-center">Qty</th>
                        <th class="pb-2 text-right">Line Total</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {foreach order.items as item}
                    <tr>
                        <td class="py-2">
                            <div class="font-medium text-gray-900">{item.product_title}</div>
                            {if item.sku}<div class="text-xs text-slate-500">{item.sku}</div>{/if}
                            {if item.variant_label}<div class="text-xs text-gray-500">{item.variant_label}</div>{/if}
                        </td>
                        <td class="py-2 text-right text-gray-700">{currency_symbol}{item.unit_price}</td>
                        <td class="py-2 text-center text-gray-700">{item.qty}</td>
                        <td class="py-2 text-right font-semibold text-gray-900">{currency_symbol}{item.line_total}</td>
                    </tr>
                    {/foreach}
                </tbody>
            </table>

            <!-- Totals -->
            <div class="mt-4 pt-4 border-t border-gray-200 space-y-1 text-sm">
                <div class="flex justify-between text-gray-600"><span>Subtotal</span><span>{currency_symbol}{order.subtotal}</span></div>
                {if order.discount_amount > 0}
                <div class="flex justify-between text-emerald-600"><span>Discount</span><span>−{currency_symbol}{order.discount_amount}</span></div>
                {/if}
                {if order.tax_amount > 0}
                <div class="flex justify-between text-gray-600"><span>Tax</span><span>{currency_symbol}{order.tax_amount}</span></div>
                {/if}
                {if order.shipping_amount > 0}
                <div class="flex justify-between text-gray-600"><span>Shipping</span><span>{currency_symbol}{order.shipping_amount}</span></div>
                {/if}
                {if refund_summary.has_refunds}
                <div class="flex justify-between text-red-600"><span>Refunded</span><span>−{refund_summary.total_refunded_amount_fmt}</span></div>
                {/if}
                <div class="flex justify-between font-bold text-gray-900 text-base pt-1 border-t border-gray-200">
                    <span>Total</span><span>{currency_symbol}{order.total}</span>
                </div>
            </div>
        </div>

        {if refunds | count > 0}
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-sm font-semibold text-gray-800">Refund History</h3>
                <span class="text-xs text-slate-500">{refund_summary.total_refunded_amount_fmt} refunded</span>
            </div>
            <div class="space-y-3">
                {foreach refunds as refund}
                <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 text-sm">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <div class="font-semibold text-gray-900">{refund.refund_number}</div>
                            <div class="text-xs text-gray-500 mt-1">{refund.created_at}{if refund.created_by_name} · {refund.created_by_name}{/if}</div>
                        </div>
                        <div class="text-right">
                            <div class="font-semibold text-red-600">−{currency_symbol}{refund.refunded_amount}</div>
                            <div class="text-xs text-gray-500">{refund.status}</div>
                        </div>
                    </div>
                    {if refund.reason}<p class="mt-2 text-gray-700">{refund.reason}</p>{/if}
                    {if refund.items | count > 0}
                    <div class="mt-3 space-y-1.5 text-xs text-gray-600">
                        {foreach refund.items as item}
                        <div class="flex justify-between gap-3"><span>{item.product_title} × {item.qty_refunded}</span><span>{if item.restock_qty > 0}Restocked {item.restock_qty}{else}No restock{/if}</span></div>
                        {/foreach}
                    </div>
                    {/if}
                </div>
                {/foreach}
            </div>
        </div>
        {/if}

        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <div class="flex items-center justify-between mb-3 gap-3">
                <div>
                    <h3 class="text-sm font-semibold text-gray-800">Return Requests</h3>
                    <p class="mt-1 text-xs text-slate-500">Customer return authorizations linked to this order.</p>
                </div>
                <a href="{base_url}/ecommerce/admin/returns" class="text-xs font-semibold text-orange-600 hover:text-orange-700">View all returns</a>
            </div>
            {if order.return_requests | count == 0}
            <div class="rounded-lg border border-dashed border-gray-200 bg-gray-50 px-4 py-4 text-sm text-gray-500">No return requests have been submitted for this order.</div>
            {else}
            <div class="space-y-4">
                {foreach order.return_requests as request}
                <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 text-sm space-y-3">
                    <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
                        <div>
                            <div class="font-semibold text-gray-900">{request.request_number}</div>
                            <div class="mt-1 text-xs text-gray-500">{request.created_at}{if request.created_by_name} · {request.created_by_name}{/if}</div>
                        </div>
                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold {if request.status == 'pending'}bg-amber-100 text-amber-800{elseif request.status == 'approved'}bg-emerald-100 text-emerald-800{elseif request.status == 'rejected'}bg-red-100 text-red-700{else}bg-gray-100 text-gray-600{/if}">{request.status}</span>
                    </div>
                    <div class="text-gray-700">{request.reason}</div>
                    <div class="text-xs text-gray-500">Condition: {request.condition_label}</div>
                    {if request.customer_note}<div class="text-sm text-gray-600">Customer note: {request.customer_note}</div>{/if}
                    {if request.admin_note}<div class="text-sm text-gray-600">Admin note: {request.admin_note}</div>{/if}
                    {if request.wms_reference_number}<div class="text-xs font-semibold text-sky-700">WMS return: {request.wms_reference_number}</div>{/if}
                    {if request.wms_sync_error}<div class="text-xs text-red-600">WMS sync: {request.wms_sync_error}</div>{/if}
                    <div class="space-y-1.5 text-xs text-gray-600">
                        {foreach request.items as item}
                        <div class="flex justify-between gap-3"><span>{item.product_title} × {item.qty_requested}</span><span>{item.condition_label}</span></div>
                        {/foreach}
                    </div>
                    {if can_manage_order && request.status == 'pending'}
                    <form method="post" action="" class="space-y-3 border-t border-gray-200 pt-3">
                        <input type="hidden" name="_token" value="{csrf_token}">
                        <input type="hidden" name="action" value="review_return_request">
                        <input type="hidden" name="return_request_id" value="{request.id}">
                        <textarea name="return_admin_note" rows="2" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" placeholder="Optional note for the customer or warehouse team."></textarea>
                        <div class="flex gap-3">
                            <button type="submit" name="review_status" value="approved" class="inline-flex items-center rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700">Approve</button>
                            <button type="submit" name="review_status" value="rejected" class="inline-flex items-center rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700">Reject</button>
                        </div>
                    </form>
                    {/if}
                </div>
                {/foreach}
            </div>
            {/if}
        </div>

        {if order_bookings | count > 0}
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <h3 class="text-sm font-semibold text-gray-800 mb-3">Bookings</h3>
            <div class="space-y-3">
                {foreach order_bookings as bk}
                <div class="flex flex-col gap-2 rounded-lg border border-gray-100 bg-gray-50 p-3 sm:flex-row sm:items-start sm:justify-between">
                    <div class="space-y-1 text-sm">
                        <div class="font-medium text-gray-900">{bk.product_title}</div>
                        <div class="text-gray-600">{bk.scheduled_for | date:'M j, Y g:i A'} &mdash; {bk.duration_minutes} min</div>
                        {if bk.status == 'cancelled' && bk.cancel_reason}<div class="text-xs text-red-600">Reason: {bk.cancel_reason}</div>{/if}
                        {if bk.status == 'cancelled' && bk.cancelled_at}<div class="text-xs text-slate-500">Cancelled: {bk.cancelled_at | date:'M j, Y g:i A'}</div>{/if}
                        {if bk.rescheduled_from_id}<div class="text-xs text-slate-500">Rescheduled from booking #{bk.rescheduled_from_id}</div>{/if}
                        {if bk.reminder_sent_at}<div class="text-xs text-slate-500">Reminder sent: {bk.reminder_sent_at | date:'M j, Y g:i A'}</div>{/if}
                    </div>
                    <span class="inline-flex items-center self-start rounded-full px-2 py-0.5 text-xs font-semibold {if bk.status == 'confirmed'}bg-emerald-100 text-emerald-700{elseif bk.status == 'pending'}bg-amber-100 text-amber-700{elseif bk.status == 'cancelled'}bg-red-100 text-red-700{elseif bk.status == 'rescheduled'}bg-blue-100 text-blue-700{else}bg-gray-100 text-gray-600{/if}">{bk.status}</span>
                </div>
                {/foreach}
            </div>
        </div>
        {/if}

        <!-- Addresses -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <h3 class="text-sm font-semibold text-gray-800 mb-3">Billing Address</h3>
                <address class="text-sm text-gray-600 not-italic space-y-0.5">
                    <div class="font-medium">{order.billing.first_name} {order.billing.last_name}</div>
                    {if order.billing.email}<div>{order.billing.email}</div>{/if}
                    <div>{order.billing.address_line1}</div>
                    {if order.billing.address_line2}<div>{order.billing.address_line2}</div>{/if}
                    <div>{order.billing.city}{if order.billing.state}, {order.billing.state}{/if} {order.billing.postal_code}</div>
                    {if order.billing.country}<div>{order.billing.country}</div>{/if}
                    {if order.billing.phone}<div>{order.billing.phone}</div>{/if}
                </address>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <h3 class="text-sm font-semibold text-gray-800 mb-3">Shipping Address</h3>
                <address class="text-sm text-gray-600 not-italic space-y-0.5">
                    <div class="font-medium">{order.shipping.first_name} {order.shipping.last_name}</div>
                    <div>{order.shipping.address_line1}</div>
                    {if order.shipping.address_line2}<div>{order.shipping.address_line2}</div>{/if}
                    <div>{order.shipping.city}{if order.shipping.state}, {order.shipping.state}{/if} {order.shipping.postal_code}</div>
                    {if order.shipping.country}<div>{order.shipping.country}</div>{/if}
                    {if order.shipping.phone}<div>{order.shipping.phone}</div>{/if}
                </address>
            </div>
        </div>

        {if order.shipment_tracking.has_tracking}
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <h3 class="text-sm font-semibold text-gray-800 mb-3">Shipment Tracking</h3>
            <div class="space-y-2 text-sm text-gray-700">
                {if order.shipment_tracking.carrier}<div class="flex justify-between gap-4"><span class="text-gray-500">Carrier</span><span class="font-medium text-right">{order.shipment_tracking.carrier}</span></div>{/if}
                {if order.shipment_tracking.tracking_number}<div class="flex justify-between gap-4"><span class="text-gray-500">Tracking Number</span><span class="font-medium text-right">{order.shipment_tracking.tracking_number}</span></div>{/if}
                {if order.shipment_tracking.tracking_url}<div class="flex justify-between gap-4"><span class="text-gray-500">Tracking Link</span><a href="{order.shipment_tracking.tracking_url}" target="_blank" rel="noopener" class="font-medium text-orange-600 hover:underline text-right">Open tracking</a></div>{/if}
            </div>
        </div>
        {/if}
    </div>

    <!-- Sidebar -->
    <div class="space-y-4">
        <!-- Update status -->
        {if not can_manage_order}
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <h3 class="text-sm font-semibold text-gray-800 mb-3">Order Authority</h3>
            <p class="text-sm text-gray-600">This order is visible here for oversight, but operational changes are locked because the assigned store owns fulfillment.</p>
            {if authority_store_admin_url}
            <a href="{authority_store_admin_url}" class="mt-3 inline-flex text-sm font-medium text-orange-600 hover:text-orange-700">Open store workspace</a>
            {/if}
        </div>
        {/if}

        {if can_manage_order && allowed_statuses | count > 0}
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <h3 class="text-sm font-semibold text-gray-800 mb-3">Update Status</h3>
            <form method="post" action="" class="space-y-3">
                <input type="hidden" name="_token" value="{csrf_token}">
                <input type="hidden" name="action" value="update_status">
                <select name="status" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
                    {foreach allowed_statuses as s}
                    <option value="{s}">{s}</option>
                    {/foreach}
                </select>
                  <input type="text" name="tracking_carrier" value="{order.shipment_tracking.carrier | default:''}" placeholder="Carrier (for shipped orders)"
                      class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
                  <input type="text" name="tracking_number" value="{order.shipment_tracking.tracking_number | default:''}" placeholder="Tracking number"
                      class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
                  <input type="url" name="tracking_url" value="{order.shipment_tracking.tracking_url | default:''}" placeholder="Tracking URL"
                      class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
                <input type="text" name="note" placeholder="Note (optional)"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
                <button type="submit" class="w-full px-4 py-2 bg-orange-600 text-white text-sm font-medium rounded-lg hover:bg-orange-700">Update Status</button>
            </form>
        </div>
        {/if}

             {if can_manage_order && (order.status == 'shipped' || order.status == 'delivered')}
             <div class="bg-white rounded-xl border border-gray-200 p-5">
                 <h3 class="text-sm font-semibold text-gray-800 mb-3">Update Tracking</h3>
                 <form method="post" action="" class="space-y-3">
                  <input type="hidden" name="_token" value="{csrf_token}">
                  <input type="hidden" name="action" value="update_tracking">
                  <input type="text" name="tracking_carrier" value="{order.shipment_tracking.carrier | default:''}" placeholder="Carrier"
                      class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
                  <input type="text" name="tracking_number" value="{order.shipment_tracking.tracking_number | default:''}" placeholder="Tracking number"
                      class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
                  <input type="url" name="tracking_url" value="{order.shipment_tracking.tracking_url | default:''}" placeholder="Tracking URL"
                      class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
                  <input type="text" name="tracking_note" placeholder="Note (optional)"
                      class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
                  <button type="submit" class="w-full px-4 py-2 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50">Save Tracking</button>
                 </form>
             </div>
             {/if}

        <!-- Payment -->
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <h3 class="text-sm font-semibold text-gray-800 mb-3">Payment</h3>
            <div class="text-sm text-gray-600 space-y-1">
                <div class="flex justify-between">
                    <span>Status</span>
                    <span class="font-semibold {if order.payment_status == 'paid'}text-emerald-600{else}text-amber-600{/if}">{order.payment_status}</span>
                </div>
                {if order.payment}
                <div class="flex justify-between"><span>Method</span><span>{order.payment.gateway}</span></div>
                {/if}
                {if refund_summary.has_refunds}
                <div class="flex justify-between"><span>Refunded</span><span class="font-semibold text-red-600">{refund_summary.total_refunded_amount_fmt}</span></div>
                <div class="flex justify-between"><span>Still refundable</span><span>{refund_summary.refundable_amount_fmt}</span></div>
                {/if}
            </div>
            {if can_manage_order && order.payment_status == 'pending'}
            <form method="post" action="" class="mt-3">
                <input type="hidden" name="_token" value="{csrf_token}">
                <input type="hidden" name="action" value="mark_paid">
                <button type="submit" class="w-full px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-lg hover:bg-emerald-700">Mark as Paid</button>
            </form>
            {/if}
        </div>

        {if can_manage_order && refund_summary.refundable_amount > 0 and order.payment_status == 'paid'}
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <h3 class="text-sm font-semibold text-gray-800 mb-3">Create Refund</h3>
            <form method="post" action="" class="space-y-3">
                <input type="hidden" name="_token" value="{csrf_token}">
                <input type="hidden" name="action" value="create_refund">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Refund Amount</label>
                    <input type="number" name="refund_amount" step="0.01" min="0.01" max="{refund_summary.refundable_amount}" value="{refund_summary.refundable_amount}"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm">
                    <p class="mt-1 text-xs text-slate-500">Up to {refund_summary.refundable_amount_fmt} can still be refunded.</p>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Reason</label>
                    <textarea name="refund_reason" rows="3" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" placeholder="Explain why this refund is being issued."></textarea>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Internal Note</label>
                    <textarea name="refund_note" rows="2" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" placeholder="Optional note for staff."></textarea>
                </div>
                <div class="space-y-2">
                    <div class="text-xs font-semibold text-gray-600 uppercase tracking-wider">Refundable Item Quantities</div>
                    {foreach order.items as item}
                    {if item.refundable_qty > 0}
                    <label class="flex items-center justify-between gap-3 text-sm text-gray-700">
                        <span class="min-w-0">
                            <span class="block font-medium text-gray-900">{item.product_title}</span>
                            <span class="block text-xs text-slate-500">Ordered {item.qty}{if item.refunded_qty > 0} · Already refunded {item.refunded_qty}{/if}</span>
                        </span>
                        <input type="number" name="refund_qty[{item.id}]" min="0" max="{item.refundable_qty}" value="0"
                               class="w-20 border border-gray-300 rounded-lg px-2 py-1.5 text-sm text-right">
                    </label>
                    {/if}
                    {/foreach}
                </div>
                <label class="flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" name="restock_inventory" value="1" class="rounded">
                    <span>Restock selected quantities</span>
                </label>
                <button type="submit" class="w-full px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700">Create Refund</button>
            </form>
        </div>
        {/if}

        <!-- Customer note -->
        {if order.customer_note}
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <h3 class="text-sm font-semibold text-gray-800 mb-2">Customer Note</h3>
            <p class="text-sm text-gray-600">{order.customer_note}</p>
        </div>
        {/if}

        <!-- Digital Licenses -->
        {if order.licenses | count > 0}
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <h3 class="text-sm font-semibold text-gray-800 mb-3">Digital Licenses</h3>
            <div class="space-y-3">
                {foreach order.licenses as lic}
                <div class="bg-gray-50 rounded-lg p-3 text-xs space-y-1.5">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="font-mono font-semibold text-gray-800">{lic.target_module}</span>
                        {if lic.target_tier}
                        <span class="px-1.5 py-0.5 rounded text-xs font-medium bg-violet-50 text-violet-700">{lic.target_tier}</span>
                        {/if}
                        <span class="px-1.5 py-0.5 rounded text-xs font-medium {if lic.status == 'active'}bg-emerald-50 text-emerald-700{else}bg-gray-100 text-gray-500{/if}">{lic.status}</span>
                    </div>
                    <div class="flex items-center gap-2 mt-1">
                        <span class="text-slate-500 font-mono text-[10px] truncate flex-1 select-none" title="Use the Copy or Download button to get the full license key">{lic.license_key | truncate:40}…</span>
                        <button type="button"
                            onclick="ecCopyLicenseKey(this)"
                            data-key="{lic.license_key | esc_attr}"
                            class="flex-shrink-0 inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                            Copy
                        </button>
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="text-slate-500">
                            {if lic.downloaded_at}Downloaded {lic.downloaded_at}{else}Not downloaded yet{/if}
                        </div>
                        <div class="flex items-center gap-2">
                            {if lic.download_token}
                            <a href="/ecommerce/admin/licenses/{lic.id}/download"
                               class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-white bg-orange-600 hover:bg-orange-700 rounded">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 3v12"/></svg>
                                Download
                            </a>
                            {/if}
                            {if can_manage_order}
                            <form action="" method="post" class="inline" onsubmit="return confirm('Are you sure you want to generate a new license key? The old key will be invalidated.')">
                                <input type="hidden" name="_token" value="{csrf_token}">
                                <input type="hidden" name="action" value="regenerate_license">
                                <input type="hidden" name="license_id" value="{lic.id}">
                                <button type="submit" class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 rounded">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                    Regenerate Key
                                </button>
                            </form>
                            {/if}
                        </div>
                    </div>
                </div>
                {/foreach}
            </div>
        </div>
        {/if}

        {if order.subscriptions | count > 0}
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <h3 class="text-sm font-semibold text-gray-800 mb-3">Subscriptions</h3>
            <div class="space-y-3">
                {foreach order.subscriptions as subscription}
                <div class="bg-amber-50 border border-amber-100 rounded-lg p-3 text-xs space-y-1.5">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="font-semibold text-gray-900">{subscription.product_title}</span>
                        <span class="px-1.5 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800">{subscription.status | replace:'_':' ' | title}</span>
                        <span class="px-1.5 py-0.5 rounded text-xs font-medium bg-white text-gray-700">Every {subscription.interval_label}</span>
                    </div>
                    <div class="text-gray-700">{subscription.recurring_label}</div>
                    {if subscription.trial_label}<div class="text-amber-700">{subscription.trial_label}</div>{/if}
                    {if subscription.next_renewal_at}<div class="text-gray-500">Next renewal: {subscription.next_renewal_at}</div>{/if}
                    {if subscription.cancelled_at}<div class="text-red-600">Cancelled: {subscription.cancelled_at}</div>{/if}
                </div>
                {/foreach}
            </div>
        </div>
        {/if}
    </div>
</div>
{/block}

{block scripts}
<script>
function ecCopyLicenseKey(btn) {
    var k = btn.getAttribute('data-key');
    var svgIcon = '<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg> Copy';
    function done() {
        btn.textContent = 'Copied!';
        setTimeout(function () { btn.innerHTML = svgIcon; }, 1500);
    }
    function fallback() {
        var ta = document.createElement('textarea');
        ta.value = k;
        ta.style.cssText = 'position:fixed;opacity:0;top:0;left:0;width:1px;height:1px';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        try { document.execCommand('copy'); done(); } catch (e) { alert('Copy failed — use the Download button instead.'); }
        document.body.removeChild(ta);
    }
    if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(k).then(done, fallback);
    } else {
        fallback();
    }
}
</script>
{/block}
