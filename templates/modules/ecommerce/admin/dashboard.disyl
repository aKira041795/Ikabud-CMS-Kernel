{extends "modules/ecommerce/layouts/admin.disyl"}

{block content}
<!-- Stats row -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-white rounded-xl border border-gray-200 p-5">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Today's Revenue</div>
        <div class="text-2xl font-bold text-gray-900">{ec_settings.currency_symbol}{today_revenue}</div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-5">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Today's Orders</div>
        <div class="text-2xl font-bold text-gray-900">{today_orders}</div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-5">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Pending Orders</div>
        <div class="text-2xl font-bold {if pending_orders > 0}text-orange-600{else}text-gray-900{/if}">{pending_orders}</div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-5">
        <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-500 mb-1.5">This Month</div>
        <div class="text-2xl font-bold text-gray-900">{ec_settings.currency_symbol}{month_revenue}</div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <!-- Recent orders -->
    <div class="lg:col-span-2 bg-white rounded-xl border border-gray-200">
        <div class="px-5 py-3.5 border-b border-gray-100 flex items-center justify-between">
            <span class="text-[13px] font-semibold text-gray-800">Recent Orders</span>
            <a href="{base_url}/ecommerce/admin/orders" class="text-xs font-medium text-orange-600 hover:text-orange-700">View all →</a>
        </div>
        {if recent_orders | count == 0}
        <div class="px-5 py-10 text-center text-slate-500 text-sm">No orders yet.</div>
        {/if}
        {foreach recent_orders as order}
        <a href="{base_url}/ecommerce/admin/orders/{order.id}" class="flex items-center gap-3 px-5 py-3 border-b border-gray-100 last:border-b-0 hover:bg-gray-50 transition-colors no-underline">
            <div class="flex-1 min-w-0">
                <div class="text-sm font-medium text-gray-900">{order.order_number}</div>
                <div class="text-xs text-slate-500 truncate">{order.resolved_customer_name | default:order.guest_name | default:order.guest_email | default:'Guest'}</div>
                {if order.authority_scope == 'store' && order.authority_store_name}
                <div class="mt-1 text-[11px] font-medium text-orange-700 truncate">Store authority: {order.authority_store_name | escape}</div>
                {/if}
            </div>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold
                {if order.status == 'pending'}bg-amber-50 text-amber-700
                {elseif order.status == 'processing'}bg-blue-50 text-blue-700
                {elseif order.status == 'shipped'}bg-purple-50 text-purple-700
                {elseif order.status == 'delivered'}bg-emerald-50 text-emerald-700
                {else}bg-gray-100 text-gray-600{/if}">{order.status}</span>
            <span class="text-sm font-semibold text-gray-900">{order.total_amount_fmt | default:(ec_settings.currency_symbol ~ order.total)}</span>
        </a>
        {/foreach}
    </div>

    <!-- Low stock alerts -->
    <div class="bg-white rounded-xl border border-gray-200">
        <div class="px-5 py-3.5 border-b border-gray-100 flex items-center">
            <span class="text-[13px] font-semibold text-gray-800">Low Stock</span>
            {if low_stock.count > 0}
            <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-red-50 text-red-700">{low_stock.count}</span>
            {/if}
        </div>
        {if low_stock.count == 0}
        <div class="px-5 py-10 text-center text-slate-500 text-sm">All products in stock.</div>
        {/if}
        {foreach low_stock.items as item}
        <a href="{base_url}/ecommerce/admin/products/{item.id}/edit" class="flex items-center justify-between px-5 py-3 border-b border-gray-100 last:border-b-0 hover:bg-gray-50 no-underline">
            <div class="min-w-0">
                <div class="text-sm font-medium text-gray-900 truncate">{item.title}</div>
                <div class="text-xs text-slate-500">{item.sku}</div>
            </div>
            <span class="text-sm font-bold {if item.stock_qty == 0}text-red-600{else}text-orange-600{/if}">{item.stock_qty} left</span>
        </a>
        {/foreach}
    </div>
</div>
{/block}
