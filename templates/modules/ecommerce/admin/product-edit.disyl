{extends "modules/ecommerce/layouts/admin.disyl"}

{block content}
<form method="post" action="" enctype="multipart/form-data" id="ec-product-form">
    <input type="hidden" name="_token" value="{csrf_token}">
    <input type="hidden" name="featured_image_id" value="{product.featured_image_id | default:''}">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- Main column -->
        <div class="lg:col-span-2 space-y-4">
            {if error}
            <div class="px-4 py-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm">{error}</div>
            {/if}
            <!-- Basic info -->
            <div class="bg-white rounded-lg border border-gray-200 p-5 space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Product Title</label>
                          <input type="text" name="title" value="{product.title | default:''}" required id="ec-product-title"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Slug</label>
                          <input type="text" name="slug" value="{product.slug | default:''}" id="ec-product-slug"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none font-mono text-gray-600">
                          <p class="mt-1 text-xs text-gray-400" id="ec-product-slug-hint">Generated from the title until you edit it manually.</p>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Short Description</label>
                    <textarea name="excerpt" rows="3"
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none resize-none">{product.excerpt | default:''}</textarea>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Full Description</label>
                    <textarea name="body" rows="8"
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none font-mono">{product.body | default:''}</textarea>
                </div>
            </div>
        </div>

        <!-- Sidebar column -->
        <div class="space-y-4">
            <!-- Publish -->
            <div class="bg-white rounded-lg border border-gray-200 p-5">
                <h3 class="font-semibold text-sm text-gray-700 mb-3">Publish</h3>
                <select name="status" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm mb-3 focus:border-orange-500 outline-none">
                    <option value="draft" {if product.status == 'draft'}selected{/if}>Draft</option>
                    <option value="published" {if product.status == 'published'}selected{/if}>Published</option>
                    <option value="private" {if product.status == 'private'}selected{/if}>Private</option>
                </select>
                <div class="flex gap-2">
                    <button type="submit" class="flex-1 px-4 py-2 bg-orange-600 text-white text-sm font-medium rounded-lg hover:bg-orange-700">Save</button>
                    {if product.id}
                    <a href="{base_url}/cms/product/{product.slug}" target="_blank" class="px-3 py-2 border text-sm rounded-lg hover:bg-gray-50">View</a>
                    {/if}
                </div>
            </div>

            <!-- Pricing -->
            <div class="bg-white rounded-lg border border-gray-200 p-5">
                <h3 class="font-semibold text-sm text-gray-700 mb-3">Pricing</h3>
                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Regular Price</label>
                        <input type="number" name="price" step="0.01" min="0"
                               value="{product.pricing.price | default:''}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Sale Price</label>
                        <input type="number" name="sale_price" step="0.01" min="0"
                               value="{product.pricing.sale_price | default:''}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                </div>
            </div>

            <!-- Featured image -->
            <div class="bg-white rounded-lg border border-gray-200 p-5">
                <h3 class="font-semibold text-sm text-gray-700 mb-3">Product Image</h3>
                {if featured_image_url}
                <img src="{featured_image_url}" alt="{product.title | default:'Product image'}" class="w-full h-40 object-cover rounded-lg border border-gray-200 mb-3">
                <label class="flex items-center gap-2 text-xs text-gray-600 mb-3">
                    <input type="checkbox" name="remove_featured_image" value="1" class="rounded">
                    <span>Remove current image</span>
                </label>
                {/if}
                <input type="file" name="featured_image" accept="image/jpeg,image/png,image/gif,image/webp,image/svg+xml"
                       class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-3 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-orange-50 file:text-orange-700 hover:file:bg-orange-100">
                <p class="mt-2 text-xs text-gray-400">Upload a featured product image. Leave blank to keep the current image. If SKU is empty, one will be generated automatically on save.</p>
            </div>

            <!-- Inventory -->
            <div class="bg-white rounded-lg border border-gray-200 p-5">
                <h3 class="font-semibold text-sm text-gray-700 mb-3">Inventory</h3>
                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">SKU</label>
                           <input type="text" name="sku" value="{product.inventory.sku | default:''}" id="ec-product-sku"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                           <p class="mt-1 text-xs text-gray-400" id="ec-product-sku-hint">Mirrors the slug until you set a custom SKU.</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="checkbox" name="track_stock" id="track_stock" value="on" class="rounded"
                               {if product.inventory.track_stock}checked{/if}>
                        <label for="track_stock" class="text-xs font-medium text-gray-700">Track stock quantity</label>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Stock Quantity</label>
                        <input type="number" name="stock_qty" min="0"
                               value="{product.inventory.stock_qty | default:'0'}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                </div>
            </div>

            <!-- Category -->
            <div class="bg-white rounded-lg border border-gray-200 p-5">
                <h3 class="font-semibold text-sm text-gray-700 mb-3">Category</h3>
                <select name="category_id" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    <option value="">No category</option>
                    {foreach categories as cat}
                    <option value="{cat.id}" {if selected_category_id == cat.id}selected{/if}>{cat.name}</option>
                    {/foreach}
                </select>
            </div>

            <!-- Digital License -->
            <div class="bg-white rounded-lg border border-gray-200 p-5">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="font-semibold text-sm text-gray-700">Digital Product</h3>
                    <span class="text-xs text-gray-400">File delivery &amp; JWT key on purchase</span>
                </div>
                <div class="space-y-3">
                    <div class="flex items-center gap-2">
                        <input type="checkbox" name="is_digital" id="is_digital" value="1" class="rounded"
                               {if product.is_digital}checked{/if}>
                        <label for="is_digital" class="text-xs font-medium text-gray-700">This is a digital product — deliver a file and/or license key on purchase</label>
                    </div>

                    <!-- Downloadable File -->
                    <div class="pt-1">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Downloadable File</label>
                        {if product.download_file_name}
                        <div class="flex items-center gap-2 mb-2 p-2 bg-gray-50 rounded border border-gray-200 text-xs text-gray-700" id="ec-current-digital-file">
                            <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                            <span class="flex-1 truncate">{product.download_file_name}</span>
                            <label class="flex items-center gap-1 text-red-600 cursor-pointer">
                                <input type="checkbox" name="remove_digital_file" value="1" class="rounded" id="ec-remove-digital-file">
                                Remove
                            </label>
                        </div>
                        {/if}
                        <div {if product.download_file_name}id="ec-replace-digital-file" class="hidden"{/if}>
                            <label class="flex flex-col items-center justify-center w-full border-2 border-dashed border-gray-200 rounded-lg p-4 cursor-pointer hover:border-orange-400 hover:bg-orange-50 transition-colors" id="ec-digital-file-label">
                                <svg class="w-6 h-6 text-gray-300 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                                <span class="text-xs text-gray-500" id="ec-digital-file-label-text">Click to upload or drag & drop</span>
                                <span class="text-xs text-gray-400 mt-0.5">ZIP, PDF, EPUB, MP3, MP4 and more (max 64 MB)</span>
                                <input type="file" name="digital_file" id="ec-digital-file-input" class="hidden"
                                       accept=".zip,.pdf,.epub,.mp3,.mp4,.m4a,.ogg,.m4v,.svg,.txt,.json,.tar,.gz,.bz2,.7z,.rar">
                            </label>
                        </div>
                        {if product.download_file_name}
                        <button type="button" id="ec-replace-digital-btn"
                                class="mt-1.5 text-xs text-orange-600 hover:underline">
                            Replace file
                        </button>
                        {/if}
                    </div>

                    <!-- JWT License fields -->
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">License Module ID</label>
                        <input type="text" name="license_module" value="{product.license_module | default:''}"
                               placeholder="e.g. my-plugin"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-xs font-mono focus:border-orange-500 outline-none">
                        <p class="mt-1 text-xs text-gray-400">Leave blank to skip JWT key generation. Set to the module ID embedded in the JWT <code>aud</code> claim.</p>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">License Tier</label>
                        <input type="text" name="license_tier" value="{product.license_tier | default:'pro'}"
                               placeholder="pro"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-xs font-mono focus:border-orange-500 outline-none">
                        <p class="mt-1 text-xs text-gray-400">e.g. <code>free</code>, <code>pro</code>, <code>enterprise</code>. Embedded in the JWT <code>tier</code> claim.</p>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">License Duration (days)</label>
                        <input type="number" name="license_duration_days" min="1"
                               value="{product.license_duration_days | default:'365'}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-xs focus:border-orange-500 outline-none">
                        <p class="mt-1 text-xs text-gray-400">How many days from purchase before the license JWT expires. Use a large value (e.g. 36500) for lifetime licenses.</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</form>
{/block}

{block scripts}
<script>
    (function () {
        var form = document.getElementById('ec-product-form');
        if (!form) {
            return;
        }

        var titleInput = document.getElementById('ec-product-title');
        var slugInput = document.getElementById('ec-product-slug');
        var skuInput = document.getElementById('ec-product-sku');
        var slugHint = document.getElementById('ec-product-slug-hint');
        var skuHint = document.getElementById('ec-product-sku-hint');

        if (!titleInput || !slugInput || !skuInput) {
            return;
        }

        function slugify(value) {
            return String(value || '')
                .toLowerCase()
                .trim()
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-+|-+$/g, '')
                .replace(/-{2,}/g, '-');
        }

        function skuify(value) {
            var normalized = String(value || '')
                .toUpperCase()
                .trim()
                .replace(/[^A-Z0-9]+/g, '-')
                .replace(/^-+|-+$/g, '')
                .replace(/-{2,}/g, '-');

            return normalized.slice(0, 80);
        }

        function currentAutoSlug() {
            return slugify(titleInput.value) || 'product';
        }

        function currentAutoSku() {
            return skuify(slugInput.value || titleInput.value) || 'PRODUCT';
        }

        var slugManual = slugInput.value.trim() !== '' && slugInput.value.trim() !== currentAutoSlug();
        var skuManual = skuInput.value.trim() !== '' && skuInput.value.trim() !== currentAutoSku();

        function updateHints() {
            if (slugHint) {
                slugHint.textContent = slugManual
                    ? 'Custom slug locked. Clear it to follow the title again.'
                    : 'Generated from the title until you edit it manually.';
            }

            if (skuHint) {
                skuHint.textContent = skuManual
                    ? 'Custom SKU locked. Clear it to follow the slug again.'
                    : 'Mirrors the slug until you set a custom SKU.';
            }
        }

        function syncGeneratedFields(force) {
            if (!slugManual || force || slugInput.value.trim() === '') {
                slugInput.value = currentAutoSlug();
                slugManual = false;
            }

            if (!skuManual || force || skuInput.value.trim() === '') {
                skuInput.value = currentAutoSku();
                skuManual = false;
            }

            updateHints();
        }

        titleInput.addEventListener('input', function () {
            syncGeneratedFields(false);
        });

        slugInput.addEventListener('input', function () {
            var normalized = slugify(slugInput.value);
            slugInput.value = normalized;
            slugManual = normalized !== '' && normalized !== currentAutoSlug();
            if (!skuManual) {
                skuInput.value = currentAutoSku();
            }
            updateHints();
        });

        skuInput.addEventListener('input', function () {
            var normalized = skuify(skuInput.value);
            skuInput.value = normalized;
            skuManual = normalized !== '' && normalized !== currentAutoSku();
            updateHints();
        });

        slugInput.addEventListener('blur', function () {
            if (slugInput.value.trim() === '') {
                slugManual = false;
                syncGeneratedFields(true);
            }
        });

        skuInput.addEventListener('blur', function () {
            if (skuInput.value.trim() === '') {
                skuManual = false;
                syncGeneratedFields(true);
            }
        });

        syncGeneratedFields(false);
    })();

    // ── Digital file upload UX ────────────────────────────────────────
    (function () {
        var fileInput  = document.getElementById('ec-digital-file-input');
        var labelText  = document.getElementById('ec-digital-file-label-text');
        var replaceBtn = document.getElementById('ec-replace-digital-btn');
        var replaceDiv = document.getElementById('ec-replace-digital-file');
        var removeChk  = document.getElementById('ec-remove-digital-file');

        if (fileInput && labelText) {
            fileInput.addEventListener('change', function () {
                if (fileInput.files && fileInput.files.length > 0) {
                    labelText.textContent = fileInput.files[0].name;
                } else {
                    labelText.textContent = 'Click to upload or drag & drop';
                }
            });
        }

        if (replaceBtn && replaceDiv) {
            replaceBtn.addEventListener('click', function () {
                replaceDiv.classList.remove('hidden');
                replaceBtn.classList.add('hidden');
            });
        }

        if (removeChk && replaceDiv) {
            removeChk.addEventListener('change', function () {
                if (removeChk.checked) {
                    replaceDiv.classList.add('hidden');
                    if (replaceBtn) replaceBtn.classList.add('hidden');
                } else {
                    if (replaceBtn) replaceBtn.classList.remove('hidden');
                }
            });
        }
    })();
</script>
{/block}
