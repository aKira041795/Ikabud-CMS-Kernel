{extends "modules/ecommerce/layouts/admin.disyl"}

{block content}
<div class="space-y-5">

    {if message}
    <div class="px-4 py-3 rounded-xl border text-sm {if message.type == 'error'}bg-red-50 border-red-200 text-red-700{else}bg-emerald-50 border-emerald-200 text-emerald-700{/if}">{message.text}</div>
    {/if}

    {if !storage_ok}
    <div class="px-4 py-3 rounded-xl border bg-amber-50 border-amber-200 text-amber-800 text-sm">
        <strong>Migration required.</strong> The stores tables are not yet created. Run the ecommerce migrations to enable multi-store support.
    </div>
    {/if}

    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-lg font-bold text-gray-900">Stores</h1>
            <p class="text-sm text-slate-500 mt-0.5">Manage storefronts, branches, and per-store product overrides.</p>
        </div>
        <a href="{base_url}/ecommerce/admin/stores/create"
           class="px-4 py-2 bg-orange-600 text-white text-sm font-semibold rounded-lg hover:bg-orange-700 transition-colors">
            + New Store
        </a>
    </div>

    <!-- Search -->
    <form method="get" class="flex gap-2 items-center">
        <input type="text" name="search" value="{search | escape}" placeholder="Search by name, code or slug…"
               class="flex-1 max-w-xs border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
        <button type="submit" class="px-4 py-2 bg-slate-700 text-white text-sm font-semibold rounded-lg hover:bg-slate-800 transition-colors">Search</button>
        {if search}<a href="{base_url}/ecommerce/admin/stores" class="px-3 py-2 text-sm text-slate-500 hover:text-slate-700">Clear</a>{/if}
    </form>

    <!-- Table -->
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        {if stores}
        <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Store</th>
                    <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Code / Slug</th>
                    <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                    <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {foreach stores as store}
                <tr class="hover:bg-gray-50 transition-colors">
                    <td class="px-4 py-3">
                        <div class="font-semibold text-gray-900">{store.name | escape}
                            {if store.is_default}
                            <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-orange-100 text-orange-700">Default</span>
                            {/if}
                        </div>
                        {if store.description}<div class="text-xs text-slate-400 mt-0.5 truncate max-w-xs">{store.description | escape}</div>{/if}
                    </td>
                    <td class="px-4 py-3">
                        <div class="font-mono text-xs text-slate-600">{store.code | escape}</div>
                        <div class="font-mono text-xs text-slate-400 mt-0.5">{store.slug | escape}</div>
                    </td>
                    <td class="px-4 py-3">
                        {if store.is_active}
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Active
                        </span>
                        {else}
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-500">
                            <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>Inactive
                        </span>
                        {/if}
                    </td>
                    <td class="px-4 py-3 text-right">
                        <div class="flex items-center justify-end gap-2">
                            {if !store.is_default}
                            <form method="post" action="{base_url}/ecommerce/admin/stores/{store.id}/edit" class="inline">
                                <input type="hidden" name="_token" value="{csrf_token}">
                                <input type="hidden" name="action" value="set_default">
                                <button type="submit" class="px-2.5 py-1 text-xs font-medium text-slate-600 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">Set Default</button>
                            </form>
                            {/if}
                            <a href="{base_url}/ecommerce/admin/stores/{store.id}/edit"
                               class="px-2.5 py-1 text-xs font-medium text-slate-700 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">Edit</a>
                        </div>
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>

        <!-- Pagination -->
        {if total_pages > 1}
        <div class="px-4 py-3 border-t border-gray-100 flex items-center justify-between text-xs text-slate-500">
            <span>{total} store{if total != 1}s{/if}</span>
            <div class="flex gap-1">
                {if page > 1}<a href="?page={page - 1}{if search}&search={search | url_encode}{/if}" class="px-2 py-1 rounded border border-gray-200 hover:bg-gray-50">← Prev</a>{/if}
                <span class="px-2 py-1">Page {page} of {total_pages}</span>
                {if page < total_pages}<a href="?page={page + 1}{if search}&search={search | url_encode}{/if}" class="px-2 py-1 rounded border border-gray-200 hover:bg-gray-50">Next →</a>{/if}
            </div>
        </div>
        {/if}

        {else}
        <div class="text-center py-16 text-slate-400">
            <svg class="w-10 h-10 mx-auto mb-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            <p class="text-sm font-medium text-slate-500">{if search}No stores match your search.{else}No stores yet.{/if}</p>
            {if !search}<a href="{base_url}/ecommerce/admin/stores/create" class="mt-3 inline-block text-sm text-orange-600 hover:underline">Create your first store →</a>{/if}
        </div>
        {/if}
    </div>

</div>
{/block}
