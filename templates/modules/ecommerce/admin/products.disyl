{extends "modules/ecommerce/layouts/admin.disyl"}

{block content}
<!-- Toolbar -->
<div class="flex flex-wrap items-center gap-3 mb-5">
    <a href="{base_url}/ecommerce/admin/products/create" class="inline-flex items-center gap-1.5 px-4 py-2 bg-orange-600 text-white text-sm font-medium rounded-lg hover:bg-orange-700">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Add Product
    </a>
    <a href="{base_url}/ecommerce/admin/import-export" class="inline-flex items-center gap-1.5 px-4 py-2 bg-white border border-gray-300 text-sm font-medium rounded-lg hover:bg-gray-50">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 16V4m0 12l4-4m-4 4l-4-4M4 20h16"/></svg>
        Import / Export
    </a>
    <form method="get" action="" class="flex gap-2 flex-1">
        <input type="text" name="search" value="{search}" placeholder="Search products…"
               class="border border-gray-300 rounded-lg px-3 py-2 text-sm flex-1 min-w-0 focus:border-orange-500 focus:ring-1 focus:ring-orange-500 outline-none">
        <select name="status" class="border border-gray-300 rounded-lg px-3 py-2 text-sm">
            <option value="">All statuses</option>
            <option value="published" {if status == 'published'}selected{/if}>Published</option>
            <option value="draft" {if status == 'draft'}selected{/if}>Draft</option>
        </select>
        <button type="submit" class="px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm hover:bg-gray-50">Filter</button>
    </form>
</div>

<!-- Product table -->
<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-gray-50/80 text-slate-600 text-[11px] uppercase tracking-wider font-semibold">
            <tr>
                <th class="px-5 py-3 text-left">Product</th>
                <th class="px-4 py-3 text-left">SKU</th>
                <th class="px-4 py-3 text-right">Price</th>
                <th class="px-4 py-3 text-center">Stock</th>
                <th class="px-4 py-3 text-center">Status</th>
                <th class="px-4 py-3 text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            {if products | count == 0}
            <tr><td colspan="6" class="px-5 py-10 text-center text-slate-500">No products found.</td></tr>
            {/if}
            {foreach products as p}
            <tr class="hover:bg-gray-50">
                <td class="px-5 py-3">
                    <div class="font-medium text-gray-900">{p.title}</div>
                    <div class="text-xs text-slate-500">/cms/product/{p.slug}</div>
                </td>
                <td class="px-4 py-3 text-slate-600">{p.inventory.sku | default:'—'}</td>
                <td class="px-4 py-3 text-right font-medium">
                    {if p.pricing.on_sale}
                    <span class="line-through text-gray-400 mr-1">{p.pricing.regular_fmt}</span>
                    <span class="text-emerald-600">{p.pricing.formatted}</span>
                    {else}
                    {p.pricing.formatted | default:'—'}
                    {/if}
                </td>
                <td class="px-4 py-3 text-center">
                    {if p.inventory.track_stock}
                    <span class="{if p.inventory.stock_qty == 0}text-red-600 font-semibold{elseif p.inventory.low_stock}text-orange-500 font-semibold{else}text-gray-700{/if}">
                        {p.inventory.stock_qty}
                    </span>
                    {else}
                    <span class="text-gray-400">∞</span>
                    {/if}
                </td>
                <td class="px-4 py-3 text-center">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold
                        {if p.status == 'published'}bg-emerald-50 text-emerald-700{else}bg-amber-50 text-amber-700{/if}">
                        {p.status}
                    </span>
                </td>
                <td class="px-4 py-3 text-right">
                    <a href="{base_url}/ecommerce/admin/products/{p.id}/edit" class="text-xs text-orange-600 hover:text-orange-700 font-medium mr-3">Edit</a>
                    <a href="{base_url}/cms/product/{p.slug}" target="_blank" class="text-xs text-gray-500 hover:text-gray-700">View</a>
                </td>
            </tr>
            {/foreach}
        </tbody>
    </table>
</div>

<!-- Pagination -->
{if total_pages > 1}
<div class="mt-4 flex items-center justify-between text-sm text-gray-500">
    <span>{total} products</span>
    <div class="flex gap-1">
        {if page > 1}<a href="?page={page - 1}&search={search}&status={status}" class="px-3 py-1.5 border rounded hover:bg-gray-50">←</a>{/if}
        <span class="px-3 py-1.5 bg-white border rounded text-gray-700">{page} / {total_pages}</span>
        {if page < total_pages}<a href="?page={page + 1}&search={search}&status={status}" class="px-3 py-1.5 border rounded hover:bg-gray-50">→</a>{/if}
    </div>
</div>
{/if}
{/block}
