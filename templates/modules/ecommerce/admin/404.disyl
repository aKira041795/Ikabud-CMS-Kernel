{extends "modules/ecommerce/layouts/admin.disyl"}

{block content}
<div class="flex flex-col items-center justify-center py-24 text-center">
    <div class="text-7xl font-black text-gray-200 mb-4">404</div>
    <h1 class="text-xl font-bold text-gray-800 mb-2">Not Found</h1>
    <p class="text-gray-500 text-sm mb-6">{message | default:'The requested resource could not be found.'}</p>
    <a href="javascript:history.back()" class="inline-flex items-center px-4 py-2 rounded-lg border border-gray-300 text-sm font-medium text-gray-700 hover:bg-gray-50">← Go Back</a>
</div>
{/block}
