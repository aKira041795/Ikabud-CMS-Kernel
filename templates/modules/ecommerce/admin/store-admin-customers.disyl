{extends "modules/ecommerce/layouts/store-admin.disyl"}

{block content}
<div class="space-y-5">
    <div class="flex flex-wrap items-center gap-3 justify-between">
        <div>
            <h1 class="text-xl font-bold text-gray-900">Customers</h1>
            <p class="mt-1 text-sm text-slate-500">Customers who placed orders containing this store's products.</p>
        </div>
        <form method="get" action="" class="flex gap-2">
            <input type="text" name="search" value="{search | escape}" placeholder="Search name, email, order…"
                   class="w-72 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
            <button type="submit" class="px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm hover:bg-gray-50">Search</button>
        </form>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <table class="w-full text-sm">
            <thead class="bg-gray-50/80 text-slate-600 text-[11px] uppercase tracking-wider font-semibold">
                <tr>
                    <th class="px-5 py-3 text-left">Customer</th>
                    <th class="px-4 py-3 text-left">Email</th>
                    <th class="px-4 py-3 text-center">Type</th>
                    <th class="px-4 py-3 text-center">Orders</th>
                    <th class="px-4 py-3 text-right">Store Revenue</th>
                    <th class="px-4 py-3 text-right">Last Order</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {if customers | count == 0}
                <tr>
                    <td colspan="6" class="px-5 py-10 text-center text-slate-500">No customers found.</td>
                </tr>
                {/if}
                {foreach customers as c}
                <tr class="hover:bg-gray-50">
                    <td class="px-5 py-3">
                        <div class="font-medium text-gray-900">{c.display_name | default:c.username | default:'Customer'}</div>
                        {if c.username}<div class="text-xs text-slate-500">@{c.username | escape}</div>{/if}
                    </td>
                    <td class="px-4 py-3 text-slate-700">{c.email | default:'—'}</td>
                    <td class="px-4 py-3 text-center">
                        {if c.customer_id}
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 text-emerald-700">registered</span>
                        {else}
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-slate-100 text-slate-600">guest</span>
                        {/if}
                    </td>
                    <td class="px-4 py-3 text-center text-gray-700">{c.order_count}</td>
                    <td class="px-4 py-3 text-right text-gray-700">{currency_sym}{c.lifetime_value | number_format:2}</td>
                    <td class="px-4 py-3 text-right text-xs text-slate-500">{c.last_order_at}</td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>

    {if total_pages > 1}
    <div class="flex items-center justify-between text-sm text-slate-500">
        <span>{total} customers</span>
        <div class="flex items-center gap-2">
            {if page > 1}<a href="?page={page - 1}&search={search | url_encode}" class="px-3 py-1 border border-gray-200 rounded-lg hover:bg-gray-50">← Prev</a>{/if}
            <span>Page {page} / {total_pages}</span>
            {if page < total_pages}<a href="?page={page + 1}&search={search | url_encode}" class="px-3 py-1 border border-gray-200 rounded-lg hover:bg-gray-50">Next →</a>{/if}
        </div>
    </div>
    {/if}
</div>
{/block}