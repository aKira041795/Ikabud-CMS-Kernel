{extends "modules/ecommerce/layouts/admin.disyl"}

{block content}
<div class="max-w-2xl">
    <form method="post" action="" class="space-y-5">
        <input type="hidden" name="_token" value="{csrf_token}">
        <div class="bg-white rounded-lg border border-gray-200 p-5 space-y-4">
            <h3 class="font-semibold text-gray-700">Ecommerce Settings</h3>
            <div class="space-y-4">
                {foreach settings_fields as field}
                <div>
                    {if field.is_checkbox}
                    <div class="flex items-center gap-2">
                        <input type="checkbox" name="{field.key}" id="field_{field.key}" value="1"
                               {if field.is_checked}checked{/if} class="rounded">
                        <label for="field_{field.key}" class="text-sm font-medium text-gray-700">{field.label}</label>
                    </div>
                    {elseif field.is_select}
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{field.label}</label>
                          <select name="{field.key}" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none {field.control_class}">
                        {foreach field.options as opt}
                        <option value="{opt.value}" {if opt.selected}selected{/if}>{opt.label}</option>
                        {/foreach}
                    </select>
                    {elseif field.is_textarea}
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{field.label}</label>
                    <textarea name="{field.key}" rows="4"
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none {field.control_class}">{field.current_value}</textarea>
                    {else}
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{field.label}</label>
                    <input type="{field.input_type}" name="{field.key}" value="{field.current_value}"
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none {field.control_class}">
                    {/if}

                    {if field.description}
                    <p class="mt-1 text-xs text-gray-500">{field.description}</p>
                    {/if}
                </div>
                {/foreach}
            </div>
        </div>
        <div>
            <button type="submit" class="px-6 py-2 bg-orange-600 text-white text-sm font-medium rounded-lg hover:bg-orange-700">Save Settings</button>
        </div>
    </form>
</div>
{/block}
