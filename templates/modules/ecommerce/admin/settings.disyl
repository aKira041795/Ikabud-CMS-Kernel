{extends "modules/ecommerce/layouts/admin.disyl"}

{block content}
<div class="max-w-4xl">

    {if message}
    <div class="mb-5 px-4 py-3 rounded-lg border text-sm {if message.type == 'error'}bg-red-50 border-red-200 text-red-700{else}bg-emerald-50 border-emerald-200 text-emerald-700{/if}">{message.text}</div>
    {/if}

    <form method="post" action="" class="space-y-6">
        <input type="hidden" name="_token" value="{csrf_token}">

        {* ── Section 1: Store & Currency ─────────────────────────────── *}
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-100 bg-gray-50">
                <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-widest">Store &amp; Currency</h3>
            </div>
            <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5">

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.currency.label}</label>
                    <select name="currency" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none font-mono">
                        {foreach settings_map.currency.options as opt}
                        <option value="{opt.value}" {if opt.selected}selected{/if}>{opt.label}</option>
                        {/foreach}
                    </select>
                    <p class="mt-1 text-xs text-gray-500">{settings_map.currency.description}</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.currency_symbol.label}</label>
                    <input type="text" name="currency_symbol" value="{settings_map.currency_symbol.current_value}"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none font-mono">
                    <p class="mt-1 text-xs text-gray-500">{settings_map.currency_symbol.description}</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.order_number_prefix.label}</label>
                    <input type="text" name="order_number_prefix" value="{settings_map.order_number_prefix.current_value}"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none font-mono">
                    <p class="mt-1 text-xs text-gray-500">{settings_map.order_number_prefix.description}</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.low_stock_threshold.label}</label>
                    <input type="number" name="low_stock_threshold" value="{settings_map.low_stock_threshold.current_value}"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    <p class="mt-1 text-xs text-gray-500">{settings_map.low_stock_threshold.description}</p>
                </div>

            </div>
        </div>

        {* ── Section 1a: Tax Rules ──────────────────────────────────── *}
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-100 bg-gray-50">
                <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-widest">Tax Rules</h3>
            </div>
            <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.tax_default_country.label}</label>
                    <input type="text" name="tax_default_country" value="{settings_map.tax_default_country.current_value}"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none font-mono uppercase">
                    <p class="mt-1 text-xs text-gray-500">{settings_map.tax_default_country.description}</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.tax_rate.label}</label>
                    <input type="number" name="tax_rate" value="{settings_map.tax_rate.current_value}"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    <p class="mt-1 text-xs text-gray-500">{settings_map.tax_rate.description}</p>
                </div>

                <div class="sm:col-span-2">
                    <div class="flex items-center gap-2 pt-1">
                        <input type="checkbox" name="tax_inclusive" id="field_tax_inclusive" value="1"
                               {if settings_map.tax_inclusive.is_checked}checked{/if} class="rounded">
                        <label for="field_tax_inclusive" class="text-sm font-medium text-gray-700">{settings_map.tax_inclusive.label}</label>
                    </div>
                    <p class="mt-1 text-xs text-gray-500">{settings_map.tax_inclusive.description}</p>
                </div>

                <div class="sm:col-span-2">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.tax_standard_rules.label}</label>
                    <textarea name="tax_standard_rules" rows="4"
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none font-mono">{settings_map.tax_standard_rules.current_value}</textarea>
                    <p class="mt-1 text-xs text-gray-500">{settings_map.tax_standard_rules.description}</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.tax_reduced_rules.label}</label>
                    <textarea name="tax_reduced_rules" rows="4"
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none font-mono">{settings_map.tax_reduced_rules.current_value}</textarea>
                    <p class="mt-1 text-xs text-gray-500">{settings_map.tax_reduced_rules.description}</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.tax_zero_rules.label}</label>
                    <textarea name="tax_zero_rules" rows="4"
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none font-mono">{settings_map.tax_zero_rules.current_value}</textarea>
                    <p class="mt-1 text-xs text-gray-500">{settings_map.tax_zero_rules.description}</p>
                </div>
            </div>
        </div>

        {* ── Section 1b: Notifications ───────────────────────────────── *}
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-100 bg-gray-50">
                <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-widest">Store Notifications &amp; Email</h3>
            </div>
            <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.admin_email.label}</label>
                    <input type="email" name="admin_email" value="{settings_map.admin_email.current_value}"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    <p class="mt-1 text-xs text-gray-500">{settings_map.admin_email.description}</p>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.admin_notification_email.label}</label>
                    <input type="email" name="admin_notification_email" value="{settings_map.admin_notification_email.current_value}"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    <p class="mt-1 text-xs text-gray-500">{settings_map.admin_notification_email.description}</p>
                </div>
            </div>
        </div>

        {* ── Section 2: Storefront ───────────────────────────────────── *}
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-100 bg-gray-50">
                <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-widest">Storefront</h3>
            </div>
            <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5">

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.shop_page_title.label}</label>
                    <input type="text" name="shop_page_title" value="{settings_map.shop_page_title.current_value}"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    <p class="mt-1 text-xs text-gray-500">{settings_map.shop_page_title.description}</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.products_per_page.label}</label>
                    <input type="number" name="products_per_page" value="{settings_map.products_per_page.current_value}"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    <p class="mt-1 text-xs text-gray-500">{settings_map.products_per_page.description}</p>
                </div>

                <div class="sm:col-span-2">
                    <div class="flex items-center gap-2">
                        <input type="checkbox" name="guest_checkout" id="field_guest_checkout" value="1"
                               {if settings_map.guest_checkout.is_checked}checked{/if} class="rounded">
                        <label for="field_guest_checkout" class="text-sm font-medium text-gray-700">{settings_map.guest_checkout.label}</label>
                    </div>
                    <p class="mt-1 text-xs text-gray-500">{settings_map.guest_checkout.description}</p>
                </div>

                <div class="sm:col-span-2">
                    <div class="flex items-center gap-2">
                        <input type="checkbox" name="require_account_for_digital" id="field_require_account_for_digital" value="1"
                               {if settings_map.require_account_for_digital.is_checked}checked{/if} class="rounded">
                        <label for="field_require_account_for_digital" class="text-sm font-medium text-gray-700">{settings_map.require_account_for_digital.label}</label>
                    </div>
                    <p class="mt-1 text-xs text-gray-500">{settings_map.require_account_for_digital.description}</p>
                </div>

            </div>
        </div>

        {* ── Section 2b: Shipping Rules ───────────────────────────── *}
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-100 bg-gray-50">
                <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-widest">Shipping Rules</h3>
            </div>
            <div class="p-5 grid grid-cols-1 gap-x-6 gap-y-5">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.shipping_default_country.label}</label>
                    <input type="text" name="shipping_default_country" value="{settings_map.shipping_default_country.current_value}"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none font-mono uppercase">
                    <p class="mt-1 text-xs text-gray-500">{settings_map.shipping_default_country.description}</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.shipping_table_rate_rules.label}</label>
                    <textarea name="shipping_table_rate_rules" rows="6"
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none font-mono">{settings_map.shipping_table_rate_rules.current_value}</textarea>
                    <p class="mt-1 text-xs text-gray-500">{settings_map.shipping_table_rate_rules.description}</p>
                </div>
            </div>
        </div>

        {* ── Section 3: Payment Gateway ─────────────────────────────── *}
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-100 bg-gray-50">
                <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-widest">Payment Gateway</h3>
            </div>
            <div class="p-5 space-y-5">

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.payment_gateway.label}</label>
                        <select name="payment_gateway" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                            {foreach settings_map.payment_gateway.options as opt}
                            <option value="{opt.value}" {if opt.selected}selected{/if}>{opt.label}</option>
                            {/foreach}
                        </select>
                        <p class="mt-1 text-xs text-gray-500">{settings_map.payment_gateway.description}</p>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.payment_gateway_mode.label}</label>
                        <select name="payment_gateway_mode" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                            {foreach settings_map.payment_gateway_mode.options as opt}
                            <option value="{opt.value}" {if opt.selected}selected{/if}>{opt.label}</option>
                            {/foreach}
                        </select>
                        <p class="mt-1 text-xs text-gray-500">{settings_map.payment_gateway_mode.description}</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.payment_method_label.label}</label>
                        <input type="text" name="payment_method_label" value="{settings_map.payment_method_label.current_value}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                        <p class="mt-1 text-xs text-gray-500">{settings_map.payment_method_label.description}</p>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.paymongo_allowed_methods.label}</label>
                        <input type="text" name="paymongo_allowed_methods" value="{settings_map.paymongo_allowed_methods.current_value}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none font-mono">
                        <p class="mt-1 text-xs text-gray-500">{settings_map.paymongo_allowed_methods.description}</p>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.stripe_allowed_payment_methods.label}</label>
                        <input type="text" name="stripe_allowed_payment_methods" value="{settings_map.stripe_allowed_payment_methods.current_value}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none font-mono">
                        <p class="mt-1 text-xs text-gray-500">{settings_map.stripe_allowed_payment_methods.description}</p>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.payment_instructions.label}</label>
                    <textarea name="payment_instructions" rows="3"
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">{settings_map.payment_instructions.current_value}</textarea>
                    <p class="mt-1 text-xs text-gray-500">{settings_map.payment_instructions.description}</p>
                </div>

                <div class="pt-4 border-t border-gray-100">
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-widest mb-3">PayMongo API Keys</p>

                    {* PayMongo how-to callout *}
                    <div class="mb-4 rounded-lg border border-violet-100 bg-violet-50 px-4 py-3">
                        <p class="text-xs font-semibold text-violet-700 mb-2">How to get your PayMongo API keys</p>
                        <ol class="list-decimal list-inside space-y-1 text-xs text-violet-800">
                            <li>Log in to your PayMongo dashboard at <a href="https://dashboard.paymongo.com" target="_blank" rel="noopener" class="underline hover:text-violet-900">dashboard.paymongo.com</a>.</li>
                            <li>Go to <strong>Developers &rarr; API Keys</strong>.</li>
                            <li>Copy your <strong>Public Key</strong> (<code class="font-mono bg-violet-100 px-1 rounded">pk_test_…</code> for sandbox, <code class="font-mono bg-violet-100 px-1 rounded">pk_live_…</code> for live) and paste it below.</li>
                            <li>Copy your <strong>Secret Key</strong> (<code class="font-mono bg-violet-100 px-1 rounded">sk_test_…</code> / <code class="font-mono bg-violet-100 px-1 rounded">sk_live_…</code>) and paste it below. <strong>Never expose this to clients.</strong></li>
                        </ol>
                        <p class="mt-2 text-xs font-semibold text-violet-700 mb-1">How to get your Webhook Secret</p>
                        <ol class="list-decimal list-inside space-y-1 text-xs text-violet-800">
                            <li>In the PayMongo dashboard go to <strong>Developers &rarr; Webhooks</strong>.</li>
                            <li>Click <strong>Add Endpoint</strong> and enter your webhook URL:</li>
                        </ol>
                        <pre class="mt-1.5 mb-2 rounded bg-violet-900/10 px-3 py-2 text-xs font-mono text-violet-900 overflow-x-auto select-all">{base_url}/api/v1/ecommerce/webhooks/paymongo</pre>
                        <ol class="list-decimal list-inside space-y-1 text-xs text-violet-800" start="3">
                            <li>Subscribe to the <strong>payment.paid</strong> and <strong>payment.failed</strong> events.</li>
                            <li>Copy the generated <strong>Webhook Secret</strong> and paste it in the field below.</li>
                        </ol>
                        <p class="mt-2 text-xs text-violet-600">Use <strong>sandbox</strong> mode and <code class="font-mono bg-violet-100 px-1 rounded">pk_test_</code> keys while testing. Switch to <strong>live</strong> and <code class="font-mono bg-violet-100 px-1 rounded">pk_live_</code> keys before going to production.</p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.paymongo_public_key.label}</label>
                            <input type="text" name="paymongo_public_key" value="{settings_map.paymongo_public_key.current_value}"
                                   placeholder="pk_test_…"
                                   class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                            <p class="mt-1 text-xs text-gray-500">{settings_map.paymongo_public_key.description}</p>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">
                                {settings_map.paymongo_secret_key.label}
                                <span class="ml-1 font-normal text-red-500">— keep secret</span>
                            </label>
                            <input type="text" name="paymongo_secret_key" value="{settings_map.paymongo_secret_key.current_value}"
                                   placeholder="sk_test_…"
                                   class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                            <p class="mt-1 text-xs text-gray-500">{settings_map.paymongo_secret_key.description}</p>
                        </div>
                        <div class="sm:col-span-2">
                            <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.paymongo_webhook_secret.label}</label>
                            <input type="text" name="paymongo_webhook_secret" value="{settings_map.paymongo_webhook_secret.current_value}"
                                   placeholder="whsec_…"
                                   class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                            <p class="mt-1 text-xs text-gray-500">{settings_map.paymongo_webhook_secret.description}</p>
                        </div>
                    </div>
                </div>

                <div class="pt-4 border-t border-gray-100">
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-widest mb-3">Stripe API Keys</p>

                    <div class="mb-4 rounded-lg border border-sky-100 bg-sky-50 px-4 py-3">
                        <p class="text-xs font-semibold text-sky-700 mb-2">How to get your Stripe API keys</p>
                        <ol class="list-decimal list-inside space-y-1 text-xs text-sky-800">
                            <li>Log in to your Stripe dashboard at <a href="https://dashboard.stripe.com" target="_blank" rel="noopener" class="underline hover:text-sky-900">dashboard.stripe.com</a>.</li>
                            <li>Open <strong>Developers &rarr; API keys</strong>.</li>
                            <li>Copy your <strong>Publishable key</strong> (<code class="font-mono bg-sky-100 px-1 rounded">pk_test_…</code> or <code class="font-mono bg-sky-100 px-1 rounded">pk_live_…</code>) and paste it below.</li>
                            <li>Copy your <strong>Secret key</strong> (<code class="font-mono bg-sky-100 px-1 rounded">sk_test_…</code> or <code class="font-mono bg-sky-100 px-1 rounded">sk_live_…</code>) and paste it below. <strong>Never expose this to clients.</strong></li>
                        </ol>
                        <p class="mt-2 text-xs font-semibold text-sky-700 mb-1">How to get your Webhook Secret</p>
                        <ol class="list-decimal list-inside space-y-1 text-xs text-sky-800">
                            <li>In the Stripe dashboard go to <strong>Developers &rarr; Webhooks</strong>.</li>
                            <li>Add an endpoint with this URL:</li>
                        </ol>
                        <pre class="mt-1.5 mb-2 rounded bg-sky-900/10 px-3 py-2 text-xs font-mono text-sky-900 overflow-x-auto select-all">{base_url}/api/v1/ecommerce/webhooks/stripe</pre>
                        <ol class="list-decimal list-inside space-y-1 text-xs text-sky-800" start="3">
                            <li>Subscribe to <strong>checkout.session.completed</strong> and <strong>payment_intent.succeeded</strong>.</li>
                            <li>Copy the endpoint signing secret and paste it below.</li>
                        </ol>
                        <p class="mt-2 text-xs text-sky-600">Use test mode while validating the checkout flow, then switch both Stripe and this module to live mode together.</p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.stripe_publishable_key.label}</label>
                            <input type="text" name="stripe_publishable_key" value="{settings_map.stripe_publishable_key.current_value}"
                                   placeholder="pk_test_…"
                                   class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                            <p class="mt-1 text-xs text-gray-500">{settings_map.stripe_publishable_key.description}</p>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">
                                {settings_map.stripe_secret_key.label}
                                <span class="ml-1 font-normal text-red-500">— keep secret</span>
                            </label>
                            <input type="text" name="stripe_secret_key" value="{settings_map.stripe_secret_key.current_value}"
                                   placeholder="sk_test_…"
                                   class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                            <p class="mt-1 text-xs text-gray-500">{settings_map.stripe_secret_key.description}</p>
                        </div>
                        <div class="sm:col-span-2">
                            <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.stripe_webhook_secret.label}</label>
                            <input type="text" name="stripe_webhook_secret" value="{settings_map.stripe_webhook_secret.current_value}"
                                   placeholder="whsec_…"
                                   class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                            <p class="mt-1 text-xs text-gray-500">{settings_map.stripe_webhook_secret.description}</p>
                        </div>
                    </div>
                </div>

                <div class="pt-4 border-t border-gray-100">
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-widest mb-3">PayPal API Keys</p>

                    <div class="mb-4 rounded-lg border border-blue-100 bg-blue-50 px-4 py-3">
                        <p class="text-xs font-semibold text-blue-700 mb-2">How to get your PayPal API keys</p>
                        <ol class="list-decimal list-inside space-y-1 text-xs text-blue-800">
                            <li>Log in to the PayPal developer dashboard at <a href="https://developer.paypal.com" target="_blank" rel="noopener" class="underline hover:text-blue-900">developer.paypal.com</a>.</li>
                            <li>Open <strong>Apps &amp; Credentials</strong> and create or select your REST app.</li>
                            <li>Copy the <strong>Client ID</strong> and <strong>Secret</strong> for the current mode and paste them below.</li>
                        </ol>
                        <p class="mt-2 text-xs font-semibold text-blue-700 mb-1">Webhook setup</p>
                        <ol class="list-decimal list-inside space-y-1 text-xs text-blue-800">
                            <li>Create a webhook for this endpoint:</li>
                        </ol>
                        <pre class="mt-1.5 mb-2 rounded bg-blue-900/10 px-3 py-2 text-xs font-mono text-blue-900 overflow-x-auto select-all">{base_url}/api/v1/ecommerce/webhooks/paypal</pre>
                        <ol class="list-decimal list-inside space-y-1 text-xs text-blue-800" start="2">
                            <li>Subscribe to <strong>PAYMENT.CAPTURE.COMPLETED</strong>.</li>
                            <li>Copy the webhook ID and paste it below.</li>
                        </ol>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.paypal_client_id.label}</label>
                            <input type="text" name="paypal_client_id" value="{settings_map.paypal_client_id.current_value}"
                                   placeholder="PayPal client ID"
                                   class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                            <p class="mt-1 text-xs text-gray-500">{settings_map.paypal_client_id.description}</p>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">
                                {settings_map.paypal_secret.label}
                                <span class="ml-1 font-normal text-red-500">— keep secret</span>
                            </label>
                            <input type="text" name="paypal_secret" value="{settings_map.paypal_secret.current_value}"
                                   placeholder="PayPal secret"
                                   class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                            <p class="mt-1 text-xs text-gray-500">{settings_map.paypal_secret.description}</p>
                        </div>
                        <div class="sm:col-span-2">
                            <label class="block text-xs font-semibold text-gray-600 mb-1">{settings_map.paypal_webhook_id.label}</label>
                            <input type="text" name="paypal_webhook_id" value="{settings_map.paypal_webhook_id.current_value}"
                                   placeholder="Webhook ID"
                                   class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                            <p class="mt-1 text-xs text-gray-500">{settings_map.paypal_webhook_id.description}</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        {* ── Section 4: Digital Licenses ────────────────────────────── *}
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <div class="px-5 py-4 border-b border-gray-100 bg-gray-50 flex items-center justify-between gap-4">
                <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-widest">Digital Licenses</h3>
                <span class="text-xs text-gray-400">Used to sign &amp; verify software license JWTs issued on digital product purchases</span>
            </div>

            {* How-to callout *}
            <div class="mx-5 mt-5 rounded-lg border border-blue-100 bg-blue-50 px-4 py-3">
                <p class="text-xs font-semibold text-blue-700 mb-2">How to generate your RSA key pair</p>
                <ol class="list-decimal list-inside space-y-1 text-xs text-blue-800">
                    <li>Open a terminal on your server or local machine.</li>
                    <li>Generate a 2048-bit RSA private key:</li>
                </ol>
                <pre class="mt-1.5 mb-2 rounded bg-blue-900/10 px-3 py-2 text-xs font-mono text-blue-900 overflow-x-auto select-all">openssl genrsa -out private.pem 2048</pre>
                <ol class="list-decimal list-inside space-y-1 text-xs text-blue-800" start="3">
                    <li>Extract the matching public key:</li>
                </ol>
                <pre class="mt-1.5 mb-2 rounded bg-blue-900/10 px-3 py-2 text-xs font-mono text-blue-900 overflow-x-auto select-all">openssl rsa -in private.pem -pubout -out public.pem</pre>
                <ol class="list-decimal list-inside space-y-1 text-xs text-blue-800" start="4">
                    <li>Paste the full contents of <code class="font-mono bg-blue-100 px-1 rounded">private.pem</code> in the Private Key field below.</li>
                    <li>Paste the full contents of <code class="font-mono bg-blue-100 px-1 rounded">public.pem</code> in the Public Key field below.</li>
                    <li>Distribute <code class="font-mono bg-blue-100 px-1 rounded">public.pem</code> to module consumers — they use it to verify license JWTs offline. <strong>Never share the private key.</strong></li>
                </ol>
                <p class="mt-2 text-xs text-blue-600">Leave both fields blank to disable automatic license generation on digital orders.</p>
            </div>

            <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5">

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">
                        {settings_map.license_private_key_pem.label}
                        <span class="ml-1 font-normal text-red-500">&#8203;— keep secret</span>
                    </label>
                    <textarea name="license_private_key_pem" rows="8"
                              placeholder="-----BEGIN RSA PRIVATE KEY-----&#10;...&#10;-----END RSA PRIVATE KEY-----"
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-xs font-mono focus:border-orange-500 outline-none resize-y">{settings_map.license_private_key_pem.current_value}</textarea>
                    <p class="mt-1 text-xs text-gray-500">Stored server-side only. Never exposed to the frontend.</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">
                        {settings_map.license_public_key_pem.label}
                        <span class="ml-1 font-normal text-gray-400">— safe to share</span>
                    </label>
                    <textarea name="license_public_key_pem" rows="8"
                              placeholder="-----BEGIN PUBLIC KEY-----&#10;...&#10;-----END PUBLIC KEY-----"
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-xs font-mono focus:border-orange-500 outline-none resize-y">{settings_map.license_public_key_pem.current_value}</textarea>
                    <p class="mt-1 text-xs text-gray-500">Give this to module authors so they can verify license tokens without contacting your server.</p>
                </div>

            </div>
        </div>

        <div>
            <button type="submit" class="px-6 py-2 bg-orange-600 text-white text-sm font-medium rounded-lg hover:bg-orange-700">Save Settings</button>
        </div>

    </form>
</div>
{/block}
