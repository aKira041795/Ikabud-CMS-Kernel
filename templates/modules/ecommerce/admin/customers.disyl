{extends "modules/ecommerce/layouts/admin.disyl"}

{block content}
<!-- Flash message -->
{if message}
<div class="mb-4 px-4 py-3 rounded-lg text-sm font-medium
    {if message.type == 'success'}bg-emerald-50 text-emerald-800 border border-emerald-200
    {else}bg-red-50 text-red-800 border border-red-200{/if}">
    {message.text}
</div>
{/if}

<!-- Search / Filters -->
<div class="flex flex-wrap items-center gap-3 mb-5">
    <a href="{base_url}/ecommerce/admin/import-export" class="inline-flex items-center gap-1.5 px-4 py-2 bg-white border border-gray-300 text-sm font-medium rounded-lg hover:bg-gray-50">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 16V4m0 12l4-4m-4 4l-4-4M4 20h16"/></svg>
        Import / Export
    </a>
    <form method="get" action="" class="flex gap-2 flex-1">
        <input type="text" name="search" value="{search}" placeholder="Search name, username, email…"
               class="flex-1 max-w-xs border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
        <button type="submit" class="px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm hover:bg-gray-50">Search</button>
        {if search}<a href="?" class="px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm text-gray-500 hover:bg-gray-50">Clear</a>{/if}
    </form>
</div>

<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-gray-50/80 text-slate-600 text-[11px] uppercase tracking-wider font-semibold">
            <tr>
                <th class="px-5 py-3 text-left">Customer</th>
                <th class="px-4 py-3 text-left">Email</th>
                <th class="px-4 py-3 text-center">Status</th>
                <th class="px-4 py-3 text-center">Orders</th>
                <th class="px-4 py-3 text-right">Lifetime Value</th>
                <th class="px-4 py-3 text-right">Joined</th>
                <th class="px-4 py-3 text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            {if customers | count == 0}
            <tr>
                <td colspan="7" class="px-5 py-10 text-center text-slate-500">No customers found.</td>
            </tr>
            {/if}
            {foreach customers as c}
            <tr class="hover:bg-gray-50">
                <td class="px-5 py-3">
                    <div class="font-medium text-gray-900">{c.display_name | default:c.username}</div>
                    <div class="text-xs text-slate-500">@{c.username}</div>
                </td>
                <td class="px-4 py-3 text-slate-700">{c.email}</td>
                <td class="px-4 py-3 text-center">
                    {if c.is_active}
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 text-emerald-700">active</span>
                    {else}
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-gray-100 text-gray-500">disabled</span>
                    {/if}
                </td>
                <td class="px-4 py-3 text-center text-gray-700">{c.order_count}</td>
                <td class="px-4 py-3 text-right text-gray-700">
                    {if c.lifetime_value}{ec_settings.currency_symbol}{c.lifetime_value | number_format:2}{else}—{/if}
                </td>
                <td class="px-4 py-3 text-right text-xs text-slate-500">{c.created_at}</td>
                <td class="px-4 py-3 text-right">
                    <a href="{base_url}/ecommerce/admin/customers/{c.id}/edit"
                       class="text-xs text-blue-600 hover:text-blue-800 font-medium mr-3">Edit</a>
                    <form method="post" action="{base_url}/ecommerce/admin/customers/{c.id}/edit"
                          class="inline"
                          onsubmit="return confirm('Permanently delete {c.display_name | default:c.email}? This cannot be undone.')">
                        <input type="hidden" name="_token" value="{csrf_token}">
                        <input type="hidden" name="action" value="delete">
                        <button type="submit" class="text-xs text-red-500 hover:text-red-700">Delete</button>
                    </form>
                </td>
            </tr>
            {/foreach}
        </tbody>
    </table>
</div>

<!-- Pagination -->
{if total_pages > 1}
<div class="mt-4 flex items-center justify-between text-sm text-gray-500">
    <span>{total} customers</span>
    <div class="flex gap-1">
        {if page > 1}<a href="?page={page - 1}{if search}&search={search}{/if}" class="px-3 py-1.5 border rounded hover:bg-gray-50">←</a>{/if}
        <span class="px-3 py-1.5 bg-white border rounded text-gray-700">{page} / {total_pages}</span>
        {if page < total_pages}<a href="?page={page + 1}{if search}&search={search}{/if}" class="px-3 py-1.5 border rounded hover:bg-gray-50">→</a>{/if}
    </div>
</div>
{/if}
{/block}
