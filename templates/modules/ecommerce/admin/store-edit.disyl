{extends "modules/ecommerce/layouts/admin.disyl"}

{block content}
<div class="max-w-2xl space-y-5">

    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-sm text-slate-500">
        <a href="{base_url}/ecommerce/admin/stores" class="hover:text-orange-600 transition-colors">Stores</a>
        <span>/</span>
        <span class="text-gray-700 font-medium">{if is_new}New Store{else}{input.name | escape}{/if}</span>
    </div>

    {if message}
    <div class="px-4 py-3 rounded-xl border text-sm {if message.type == 'error'}bg-red-50 border-red-200 text-red-700{else}bg-emerald-50 border-emerald-200 text-emerald-700{/if}">{message.text}</div>
    {/if}

    <!-- Main form -->
    <form method="post" action="" class="space-y-5">
        <input type="hidden" name="_token" value="{csrf_token}">
        <input type="hidden" name="action" value="save">

        <!-- Identity -->
        <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
            <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Identity</h2>

            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Store Name <span class="text-red-500">*</span></label>
                <input type="text" name="name" value="{input.name | escape}" required
                       placeholder="e.g. Main Store"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Code <span class="text-red-500">*</span></label>
                    <input type="text" name="code" value="{input.code | escape}" required
                           placeholder="main" pattern="[a-z0-9_-]+"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                    <p class="text-xs text-slate-400 mt-1">Lowercase letters, numbers, hyphens.</p>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Slug</label>
                    <input type="text" name="slug" value="{input.slug | escape}"
                           placeholder="auto-generated from code"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                    <p class="text-xs text-slate-400 mt-1">Used in <code>?store=slug</code> and headers.</p>
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Description</label>
                <textarea name="description" rows="2" placeholder="Optional store description…"
                          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm resize-none focus:border-orange-500 outline-none">{input.description | escape}</textarea>
            </div>
        </div>

        <!-- Flags -->
        <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-3">
            <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Flags</h2>
            <label class="flex items-center gap-3 cursor-pointer">
                <input type="checkbox" name="is_active" value="1" {if input.is_active}checked{/if}
                       class="w-4 h-4 text-orange-600 border-gray-300 rounded focus:ring-orange-500">
                <span class="text-sm font-medium text-gray-700">Active</span>
                <span class="text-xs text-slate-400">Inactive stores are hidden from the storefront.</span>
            </label>
            <label class="flex items-center gap-3 cursor-pointer">
                <input type="checkbox" name="is_default" value="1" {if input.is_default}checked{/if}
                       class="w-4 h-4 text-orange-600 border-gray-300 rounded focus:ring-orange-500">
                <span class="text-sm font-medium text-gray-700">Default store</span>
                <span class="text-xs text-slate-400">Used when no store context is specified. Only one store can be the default.</span>
            </label>
        </div>

        <!-- Store-level settings overrides -->
        <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
            <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Store-Level Settings</h2>
            <p class="text-xs text-slate-500">Leave blank to inherit global settings.</p>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Currency Code</label>
                    <input type="text" name="setting_currency" value="{input.setting_currency | escape}"
                           placeholder="e.g. USD"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Currency Symbol</label>
                    <input type="text" name="setting_currency_symbol" value="{input.setting_currency_symbol | escape}"
                           placeholder="e.g. $"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Timezone</label>
                    <input type="text" name="setting_timezone" value="{input.setting_timezone | escape}"
                           placeholder="e.g. Asia/Manila"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Tax Rate (%)</label>
                    <input type="text" name="setting_tax_rate" value="{input.setting_tax_rate | escape}"
                           placeholder="e.g. 12"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Checkout Note</label>
                <input type="text" name="setting_checkout_note" value="{input.setting_checkout_note | escape}"
                       placeholder="e.g. Pickup available Mon–Sat 9am–6pm"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
            </div>
        </div>

        <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-5">
            <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Storefront Overrides</h2>
            <p class="text-xs text-slate-500">Set store-specific theme, banner, social links, and hours. Leave each mode on default to inherit the tenant ecommerce settings.</p>

            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Theme Preset</label>
                <select name="setting_storefront_theme" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none bg-white">
                    <option value="">Use platform default</option>
                    <option value="orange" {if input.setting_storefront_theme == 'orange'}selected{/if}>Orange</option>
                    <option value="indigo" {if input.setting_storefront_theme == 'indigo'}selected{/if}>Indigo</option>
                    <option value="emerald" {if input.setting_storefront_theme == 'emerald'}selected{/if}>Emerald</option>
                    <option value="rose" {if input.setting_storefront_theme == 'rose'}selected{/if}>Rose</option>
                </select>
            </div>

            <div class="border-t border-gray-100 pt-5 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Banner Mode</label>
                    <select name="setting_store_banner_mode" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none bg-white">
                        <option value="">Use platform default</option>
                        <option value="show" {if input.setting_store_banner_mode == 'show'}selected{/if}>Use store-specific banner</option>
                        <option value="hide" {if input.setting_store_banner_mode == 'hide'}selected{/if}>Hide banner for this store</option>
                    </select>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Banner Headline</label>
                        <input type="text" name="setting_store_banner_headline" value="{input.setting_store_banner_headline | escape}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none"
                               placeholder="Welcome to Main Store">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Banner Subtext</label>
                        <input type="text" name="setting_store_banner_subtext" value="{input.setting_store_banner_subtext | escape}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none"
                               placeholder="New arrivals, store exclusives, and promos">
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Banner Image URL</label>
                        <input type="url" name="setting_store_banner_image_url" value="{input.setting_store_banner_image_url | escape}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none"
                               placeholder="https://...">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">CTA Text</label>
                        <input type="text" name="setting_store_banner_cta_text" value="{input.setting_store_banner_cta_text | escape}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none"
                               placeholder="Shop this store">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">CTA URL</label>
                        <input type="text" name="setting_store_banner_cta_url" value="{input.setting_store_banner_cta_url | escape}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none"
                               placeholder="/ecommerce/shop?store={input.slug | escape}">
                    </div>
                </div>
            </div>

            <div class="border-t border-gray-100 pt-5 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Social Links Mode</label>
                    <select name="setting_social_links_mode" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none bg-white">
                        <option value="">Use platform default</option>
                        <option value="custom" {if input.setting_social_links_mode == 'custom'}selected{/if}>Use store-specific social links</option>
                        <option value="hide" {if input.setting_social_links_mode == 'hide'}selected{/if}>Hide social links for this store</option>
                    </select>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Facebook URL</label>
                        <input type="url" name="setting_social_facebook" value="{input.setting_social_facebook | escape}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none"
                               placeholder="https://facebook.com/...">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Instagram URL</label>
                        <input type="url" name="setting_social_instagram" value="{input.setting_social_instagram | escape}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none"
                               placeholder="https://instagram.com/...">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">TikTok URL</label>
                        <input type="url" name="setting_social_tiktok" value="{input.setting_social_tiktok | escape}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none"
                               placeholder="https://tiktok.com/@...">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">X / Twitter URL</label>
                        <input type="url" name="setting_social_twitter" value="{input.setting_social_twitter | escape}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none"
                               placeholder="https://x.com/...">
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">YouTube URL</label>
                        <input type="url" name="setting_social_youtube" value="{input.setting_social_youtube | escape}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none"
                               placeholder="https://youtube.com/@...">
                    </div>
                </div>
            </div>

            <div class="border-t border-gray-100 pt-5 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Hours Mode</label>
                    <select name="setting_store_hours_mode" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none bg-white">
                        <option value="">Use platform default</option>
                        <option value="custom" {if input.setting_store_hours_mode == 'custom'}selected{/if}>Use store-specific hours</option>
                        <option value="hide" {if input.setting_store_hours_mode == 'hide'}selected{/if}>Hide hours for this store</option>
                    </select>
                </div>
                <div class="space-y-3">
                    {foreach storefront_hours_form_schedule as day}
                    <div class="flex flex-wrap items-center gap-4 rounded-lg border border-gray-100 px-4 py-3">
                        <div class="w-24 text-sm font-medium text-gray-700">{day.label}</div>
                        <label class="flex items-center gap-2 text-sm text-gray-700">
                            <input type="checkbox" name="setting_store_hours[{day.key}][open]" value="1" {if day.open}checked{/if} class="rounded border-gray-300">
                            Open
                        </label>
                        <div class="flex items-center gap-2 text-sm text-gray-600">
                            <label class="text-xs font-semibold text-gray-500">From</label>
                            <input type="time" name="setting_store_hours[{day.key}][from]" value="{day.from}"
                                   class="border border-gray-300 rounded-lg px-2 py-1 text-sm focus:border-orange-500 outline-none">
                            <label class="text-xs font-semibold text-gray-500">To</label>
                            <input type="time" name="setting_store_hours[{day.key}][to]" value="{day.to}"
                                   class="border border-gray-300 rounded-lg px-2 py-1 text-sm focus:border-orange-500 outline-none">
                        </div>
                    </div>
                    {/foreach}
                </div>
            </div>
        </div>

        <!-- Save / Cancel -->
        <div class="flex items-center justify-between pt-1">
            <a href="{base_url}/ecommerce/admin/stores"
               class="px-4 py-2 text-sm font-medium text-slate-600 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors">
                Cancel
            </a>
            <button type="submit"
                    class="px-6 py-2 bg-orange-600 text-white text-sm font-semibold rounded-lg hover:bg-orange-700 transition-colors">
                {if is_new}Create Store{else}Save Changes{/if}
            </button>
        </div>
    </form>

    <!-- Inventory Source (edit only — Phase 7C) -->
    {if !is_new}
    <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
        <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Inventory Source</h2>
        <p class="text-xs text-slate-500">Controls where stock levels are read from for this store. Defaults to local tracking; choose WMS to pull from a linked warehouse.</p>

        <form method="post" action="" class="space-y-4">
            <input type="hidden" name="_token" value="{csrf_token}">
            <input type="hidden" name="action" value="save_inventory_source">

            <div class="flex items-center gap-6">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="inventory_source_type" value="local"
                           {if inventory_source.source_type == 'wms'}class="border-gray-300"{else}checked class="border-gray-300"{/if}>
                    <span class="text-sm font-medium text-gray-700">Local</span>
                    <span class="text-xs text-slate-400">Use on-hand stock tracked by the platform</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="inventory_source_type" value="wms"
                           {if inventory_source.source_type == 'wms'}checked{/if} class="border-gray-300">
                    <span class="text-sm font-medium text-gray-700">WMS / Warehouse</span>
                    <span class="text-xs text-slate-400">Pull stock from a linked warehouse</span>
                </label>
            </div>

            <div id="wms-warehouse-row" class="{if inventory_source.source_type == 'wms'}block{else}hidden{/if}">
                <label class="block text-xs font-semibold text-gray-600 mb-1">Warehouse ID</label>
                <input type="number" name="inventory_warehouse_id" min="1"
                       value="{inventory_source.warehouse_id | escape}"
                       placeholder="Numeric warehouse ID from WMS module"
                       class="w-48 border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
            </div>

            <div>
                <button type="submit" class="px-4 py-2 bg-slate-700 text-white text-sm font-medium rounded-lg hover:bg-slate-800">
                    Save Inventory Source
                </button>
            </div>
        </form>

        <script>
        (function () {
            var radios = document.querySelectorAll('[name=inventory_source_type]');
            var row = document.getElementById('wms-warehouse-row');
            if (!radios.length || !row) return;
            function update() {
                var v = document.querySelector('[name=inventory_source_type]:checked');
                row.className = (v && v.value === 'wms') ? 'block' : 'hidden';
            }
            radios.forEach(function (r) { r.addEventListener('change', update); });
        })();
        </script>
    </div>
    {/if}

    <!-- Store Users (edit only — Phase 4) -->
    {if !is_new}
    <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
        <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Store Users</h2>
        <p class="text-xs text-slate-500">Assign users as owners, managers, or supervisors of this store. Enter the user's numeric ID from the platform. Owners and managers can manage products and orders; supervisors have read-only access.</p>

        {if store_users | count > 0}
        <table class="w-full text-sm">
            <thead class="text-[11px] uppercase tracking-wider text-slate-500">
                <tr>
                    <th class="py-1 text-left">User</th>
                    <th class="py-1 text-left">Role</th>
                    <th class="py-1 text-left">Assigned</th>
                    <th class="py-1"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {foreach store_users as su}
                <tr>
                    <td class="py-1.5 text-gray-700">
                        {if su.display_name}{su.display_name | escape}{else}#{su.user_id}{/if}
                        {if su.email}<div class="text-xs text-slate-400">{su.email | escape}</div>{/if}
                    </td>
                    <td class="py-1.5">
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold
                            {if su.role == 'owner'}bg-amber-50 text-amber-700{elseif su.role == 'manager'}bg-blue-50 text-blue-700{else}bg-emerald-50 text-emerald-700{/if}">
                            {su.role}
                        </span>
                    </td>
                    <td class="py-1.5 text-slate-400 text-xs">{su.created_at}</td>
                    <td class="py-1.5 text-right">
                        <form method="post" action="" class="inline">
                            <input type="hidden" name="_token" value="{csrf_token}">
                            <input type="hidden" name="action" value="remove_user">
                            <input type="hidden" name="remove_user_id" value="{su.user_id}">
                            <button type="submit" class="text-xs text-red-500 hover:text-red-700">Remove</button>
                        </form>
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
        {/if}

        <form method="post" action="" class="flex items-end gap-3 flex-wrap">
            <input type="hidden" name="_token" value="{csrf_token}">
            <input type="hidden" name="action" value="assign_user">
            <div class="flex-1 min-w-[200px]">
                <label class="block text-xs font-semibold text-gray-600 mb-1">User</label>
                {if cms_users_list | count > 0}
                <select name="assign_user_id" required
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none bg-white">
                    <option value="">Select a user…</option>
                    {foreach cms_users_list as cu}
                    <option value="{cu.id}">{cu.display_name | escape} &lt;{cu.email | escape}&gt;</option>
                    {/foreach}
                </select>
                {else}
                <input type="number" name="assign_user_id" min="1" placeholder="User ID (e.g. 42)"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                {/if}
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Role</label>
                <select name="assign_role"
                        class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none bg-white">
                    <option value="owner">Owner</option>
                    <option value="manager">Manager</option>
                    <option value="supervisor">Supervisor</option>
                </select>
            </div>
            <button type="submit" class="px-4 py-2 bg-slate-700 text-white text-sm font-medium rounded-lg hover:bg-slate-800">
                Add User
            </button>
        </form>
    </div>
    {/if}

    <!-- Danger zone (edit only) -->
    {if !is_new}
    <div class="bg-white rounded-xl border border-red-200 p-5 space-y-3">
        <h2 class="text-sm font-bold text-red-700 uppercase tracking-wider">Danger Zone</h2>

        {if input.is_default}
        <p class="text-sm text-slate-500">This is the default store and cannot be deleted. Assign another store as default first.</p>
        {else}
        <p class="text-sm text-slate-500">Deleting a store removes its product overrides and inventory sources. Orders that reference this store retain their <code>store_id</code> for historical records.</p>
        <form method="post" action="" onsubmit="return confirm('Delete this store? This cannot be undone.')">
            <input type="hidden" name="_token" value="{csrf_token}">
            <input type="hidden" name="action" value="delete">
            <button type="submit"
                    class="px-4 py-2 bg-red-600 text-white text-sm font-semibold rounded-lg hover:bg-red-700 transition-colors">
                Delete Store
            </button>
        </form>
        {/if}
    </div>
    {/if}

</div>

<script>
    // Auto-generate slug from code field when slug is empty
    (function () {
        var codeInput = document.querySelector('[name=code]');
        var slugInput = document.querySelector('[name=slug]');
        if (!codeInput || !slugInput) return;
        codeInput.addEventListener('input', function () {
            if (slugInput.value === '' || slugInput.dataset.autoSlug === '1') {
                slugInput.value = codeInput.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
                slugInput.dataset.autoSlug = '1';
            }
        });
        slugInput.addEventListener('input', function () {
            slugInput.dataset.autoSlug = '';
        });
    })();

    // Pre-fill settings from existing settings_json for edit mode
    (function () {
        var raw = {if input.settings_json}'{input.settings_json | escape_js}'{else}null{/if};
        if (!raw) return;
        try {
            var s = JSON.parse(raw);
            ['currency','currency_symbol','timezone','tax_rate','checkout_note','storefront_theme','store_banner_mode','store_banner_headline','store_banner_subtext','store_banner_image_url','store_banner_cta_text','store_banner_cta_url','social_links_mode','social_facebook','social_instagram','social_tiktok','social_twitter','social_youtube','store_hours_mode'].forEach(function(k){
                var el = document.querySelector('[name=setting_' + k + ']');
                if (el && s[k]) el.value = s[k];
            });
        } catch(e){}
    })();
</script>
{/block}
