{extends "modules/ecommerce/layouts/store-admin.disyl"}

{block content}
<div class="max-w-4xl space-y-5">
    <div>
        <h1 class="text-xl font-bold text-gray-900">Store Settings</h1>
        <p class="mt-1 text-sm text-slate-500">Manage this store's identity, local settings, inventory source, and team access.</p>
    </div>

    {if message}
    <div class="px-4 py-3 rounded-xl border text-sm {if message.type == 'error'}bg-red-50 border-red-200 text-red-700{else}bg-emerald-50 border-emerald-200 text-emerald-700{/if}">{message.text | escape}</div>
    {/if}

    <form method="post" action="" class="space-y-5">
        <input type="hidden" name="_token" value="{csrf_token}">
        <input type="hidden" name="action" value="save">

        <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
            <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Identity</h2>
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Store Name</label>
                <input type="text" name="name" value="{input.name | escape}" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Code</label>
                    <input type="text" name="code" value="{input.code | escape}" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Slug</label>
                    <input type="text" name="slug" value="{input.slug | escape}" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Description</label>
                <textarea name="description" rows="3" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm resize-none focus:border-orange-500 outline-none">{input.description | escape}</textarea>
            </div>
            <label class="flex items-center gap-3 cursor-pointer">
                <input type="checkbox" name="is_active" value="1" {if input.is_active}checked{/if} class="w-4 h-4 text-orange-600 border-gray-300 rounded focus:ring-orange-500">
                <span class="text-sm font-medium text-gray-700">Active</span>
                <span class="text-xs text-slate-400">Inactive stores are hidden from the storefront.</span>
            </label>
        </div>

        <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
            <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Store-Level Settings</h2>
            <p class="text-xs text-slate-500">Leave blank to inherit the platform defaults.</p>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Currency Code</label>
                    <input type="text" name="setting_currency" value="{input.setting_currency | escape}" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Currency Symbol</label>
                    <input type="text" name="setting_currency_symbol" value="{input.setting_currency_symbol | escape}" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Timezone</label>
                    <input type="text" name="setting_timezone" value="{input.setting_timezone | escape}" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Tax Rate (%)</label>
                    <input type="text" name="setting_tax_rate" value="{input.setting_tax_rate | escape}" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Checkout Note</label>
                <input type="text" name="setting_checkout_note" value="{input.setting_checkout_note | escape}" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
            </div>
            <div class="flex justify-end">
                <button type="submit" class="px-5 py-2 bg-orange-600 text-white text-sm font-semibold rounded-lg hover:bg-orange-700 transition-colors">Save Settings</button>
            </div>
        </div>
    </form>

    <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
        <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Inventory Source</h2>
        <form method="post" action="" class="space-y-4">
            <input type="hidden" name="_token" value="{csrf_token}">
            <input type="hidden" name="action" value="save_inventory_source">

            <div class="flex items-center gap-6 flex-wrap">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="inventory_source_type" value="local" {if inventory_source.source_type == 'wms'}{else}checked{/if} class="border-gray-300">
                    <span class="text-sm font-medium text-gray-700">Local</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="radio" name="inventory_source_type" value="wms" {if inventory_source.source_type == 'wms'}checked{/if} class="border-gray-300">
                    <span class="text-sm font-medium text-gray-700">WMS / Warehouse</span>
                </label>
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Warehouse</label>
                <select name="inventory_warehouse_id" class="w-full max-w-sm border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none bg-white">
                    <option value="">Select a warehouse…</option>
                    {foreach warehouses as warehouse}
                    <option value="{warehouse.id}" {if inventory_source.warehouse_id == warehouse.id}selected{/if}>{warehouse.name | escape} ({warehouse.code | escape})</option>
                    {/foreach}
                </select>
            </div>

            <button type="submit" class="px-4 py-2 bg-slate-700 text-white text-sm font-medium rounded-lg hover:bg-slate-800">Save Inventory Source</button>
        </form>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
        <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Store Team</h2>
        <p class="text-xs text-slate-500">Owners can assign owners, managers, and supervisors for this store.</p>

        {if store_users | count > 0}
        <table class="w-full text-sm">
            <thead class="text-[11px] uppercase tracking-wider text-slate-500">
                <tr>
                    <th class="py-1 text-left">User</th>
                    <th class="py-1 text-left">Role</th>
                    <th class="py-1 text-left">Assigned</th>
                    <th class="py-1"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {foreach store_users as su}
                <tr>
                    <td class="py-1.5 text-gray-700">
                        {if su.display_name}{su.display_name | escape}{else}#{su.user_id}{/if}
                        {if su.email}<div class="text-xs text-slate-400">{su.email | escape}</div>{/if}
                    </td>
                    <td class="py-1.5">
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold {if su.role == 'owner'}bg-amber-50 text-amber-700{elseif su.role == 'manager'}bg-blue-50 text-blue-700{else}bg-emerald-50 text-emerald-700{/if}">{su.role}</span>
                    </td>
                    <td class="py-1.5 text-slate-400 text-xs">{su.created_at}</td>
                    <td class="py-1.5 text-right">
                        <form method="post" action="" class="inline">
                            <input type="hidden" name="_token" value="{csrf_token}">
                            <input type="hidden" name="action" value="remove_user">
                            <input type="hidden" name="remove_user_id" value="{su.user_id}">
                            <button type="submit" class="text-xs text-red-500 hover:text-red-700">Remove</button>
                        </form>
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
        {/if}

        <form method="post" action="" class="flex items-end gap-3 flex-wrap">
            <input type="hidden" name="_token" value="{csrf_token}">
            <input type="hidden" name="action" value="assign_user">
            <div class="flex-1 min-w-[220px]">
                <label class="block text-xs font-semibold text-gray-600 mb-1">User</label>
                <select name="assign_user_id" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none bg-white">
                    <option value="">Select a user…</option>
                    {foreach cms_users_list as cu}
                    <option value="{cu.id}">{cu.display_name | escape} &lt;{cu.email | escape}&gt;</option>
                    {/foreach}
                </select>
            </div>
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Role</label>
                <select name="assign_role" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none bg-white">
                    <option value="owner">Owner</option>
                    <option value="manager">Manager</option>
                    <option value="supervisor">Supervisor</option>
                </select>
            </div>
            <button type="submit" class="px-4 py-2 bg-slate-700 text-white text-sm font-medium rounded-lg hover:bg-slate-800">Add User</button>
        </form>
    </div>
</div>
{/block}