{extends "modules/ecommerce/layouts/admin.disyl"}

{block content}
<div class="max-w-5xl space-y-6">

    {if message}
    <div class="px-4 py-3 rounded-lg border text-sm {if message.type == 'error'}bg-red-50 border-red-200 text-red-700{else}bg-emerald-50 border-emerald-200 text-emerald-700{/if}">{message.text}</div>
    {/if}

    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 bg-gray-50">
            <h2 class="text-base font-semibold text-gray-900">Order Email Templates</h2>
            <p class="mt-1 text-sm text-gray-500">Customize the subject and message for the two ecommerce order emails. The system adds the heading, order summary, item list, and action blocks automatically.</p>
        </div>
        <div class="px-5 py-3 border-b border-amber-100 bg-amber-50 text-sm text-amber-900">
            Admin notification emails use the store notification address from Settings. Customer-facing emails still use the configured admin email for reply-to and from handling. Line breaks in the message are preserved.
        </div>

        <form method="post" action="" class="p-5 space-y-6">
            <input type="hidden" name="_token" value="{csrf_token}">

            <section class="rounded-xl border border-gray-200 overflow-hidden">
                <div class="px-5 py-4 border-b border-gray-100 bg-white flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <h3 class="text-sm font-semibold text-gray-900">Admin Notification</h3>
                        <p class="text-sm text-gray-500">Sent to the admin notification email whenever a new order is placed.</p>
                    </div>
                    <span class="inline-flex items-center rounded-full bg-orange-100 px-2.5 py-1 text-xs font-semibold text-orange-700">Order Event</span>
                </div>
                <div class="p-5 space-y-4">
                    <div class="flex flex-wrap items-center gap-2 text-xs text-gray-600">
                        <span class="font-semibold uppercase tracking-wide text-gray-500">Placeholders</span>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;order_number&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;source&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;source_suffix&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;customer_name&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;customer_line&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;customer_email&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;order_total&#125;</code>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Subject</label>
                        <input type="text" name="email_tpl_admin_order_subject" value="{email_templates.admin_order_notification.subject}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Message Content</label>
                        <textarea name="email_tpl_admin_order_message" rows="10"
                                  placeholder="Example: A new order has been placed from {customer_line}."
                                  class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm leading-6 focus:border-orange-500 outline-none resize-y">{email_templates.admin_order_notification.message}</textarea>
                        <p class="mt-1 text-xs text-gray-500">Write the message in plain text. The order details table and the “View Order in Admin” action are added automatically below.</p>
                    </div>
                </div>
            </section>

            <section class="rounded-xl border border-gray-200 overflow-hidden">
                <div class="px-5 py-4 border-b border-gray-100 bg-white flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <h3 class="text-sm font-semibold text-gray-900">Customer Order Confirmation</h3>
                        <p class="text-sm text-gray-500">Sent to the customer after checkout succeeds.</p>
                    </div>
                    <span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-1 text-xs font-semibold text-blue-700">Customer Email</span>
                </div>
                <div class="p-5 space-y-4">
                    <div class="flex flex-wrap items-center gap-2 text-xs text-gray-600">
                        <span class="font-semibold uppercase tracking-wide text-gray-500">Placeholders</span>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;order_number&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;customer_name&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;customer_greeting&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;customer_email&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;order_total&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;my_orders_url&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;login_url&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;forgot_password_url&#125;</code>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Subject</label>
                        <input type="text" name="email_tpl_customer_order_subject" value="{email_templates.customer_order_confirmation.subject}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Message Content</label>
                        <textarea name="email_tpl_customer_order_message" rows="10"
                                  placeholder="Example: Hi {customer_greeting}, thank you for your order."
                                  class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm leading-6 focus:border-orange-500 outline-none resize-y">{email_templates.customer_order_confirmation.message}</textarea>
                        <p class="mt-1 text-xs text-gray-500">Write the message in plain text. The order summary, item list, and account-access block are added automatically below.</p>
                    </div>
                </div>
            </section>

            <section class="rounded-xl border border-gray-200 overflow-hidden">
                <div class="px-5 py-4 border-b border-gray-100 bg-white flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <h3 class="text-sm font-semibold text-gray-900">Abandoned Cart Recovery</h3>
                        <p class="text-sm text-gray-500">Sent by the abandoned-cart cron job when a shopper leaves the checkout flow without completing an order.</p>
                    </div>
                    <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-700">Recovery Email</span>
                </div>
                <div class="p-5 space-y-4">
                    <div class="flex flex-wrap items-center gap-2 text-xs text-gray-600">
                        <span class="font-semibold uppercase tracking-wide text-gray-500">Placeholders</span>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;customer_greeting&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;customer_email&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;cart_item_count&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;cart_total&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;recovery_url&#125;</code>
                        <code class="rounded bg-gray-100 px-2 py-1">&#123;recovery_stage&#125;</code>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Subject</label>
                        <input type="text" name="email_tpl_abandoned_cart_subject" value="{email_templates.abandoned_cart_recovery.subject}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Message Content</label>
                        <textarea name="email_tpl_abandoned_cart_message" rows="8"
                                  placeholder="Example: Hi {customer_greeting}, your cart is still waiting for you."
                                  class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm leading-6 focus:border-orange-500 outline-none resize-y">{email_templates.abandoned_cart_recovery.message}</textarea>
                        <p class="mt-1 text-xs text-gray-500">Write the message in plain text. The cart summary and the return-to-checkout action are added automatically below.</p>
                    </div>
                </div>
            </section>

            <div class="flex items-center justify-end gap-3">
                <button type="submit" class="px-6 py-2 bg-orange-600 text-white text-sm font-medium rounded-lg hover:bg-orange-700">Save Templates</button>
            </div>
        </form>
    </div>
</div>
{/block}