{extends "modules/ecommerce/layouts/admin.disyl"}

{block content}
<div class="mb-4">
    <a href="{base_url}/ecommerce/admin/customers" class="text-sm text-gray-500 hover:text-orange-600">← Back to Customers</a>
</div>

<!-- Flash message -->
{if message}
<div class="mb-4 px-4 py-3 rounded-lg text-sm font-medium
    {if message.type == 'success'}bg-emerald-50 text-emerald-800 border border-emerald-200
    {else}bg-red-50 text-red-800 border border-red-200{/if}">
    {message.text}
</div>
{/if}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Edit form (left 2/3) -->
    <div class="lg:col-span-2 space-y-5">
        <!-- Customer details form -->
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <h3 class="font-semibold text-sm text-gray-800 mb-4">Customer Details</h3>
            <form method="post" action="" class="space-y-4">
                <input type="hidden" name="_token" value="{csrf_token}">
                <input type="hidden" name="action" value="update">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Display Name</label>
                        <input type="text" name="display_name" value="{customer.display_name}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Username</label>
                        <input type="text" value="{customer.username}" disabled
                               class="w-full border border-gray-100 bg-gray-50 rounded-lg px-3 py-2 text-sm text-slate-500">
                        <p class="text-xs text-slate-500 mt-1">Username cannot be changed here.</p>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Email</label>
                    <input type="email" name="email" value="{customer.email}" required
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                </div>

                <div class="flex items-center gap-3">
                    <input type="checkbox" name="is_active" id="is_active" value="1"
                           {if customer.is_active}checked{/if}
                           class="w-4 h-4 rounded border-gray-300 text-orange-600">
                    <label for="is_active" class="text-sm text-gray-700">Account active (can log in)</label>
                </div>

                <div class="flex items-center justify-between pt-2">
                    <button type="submit" class="px-4 py-2 bg-orange-600 text-white text-sm font-medium rounded-lg hover:bg-orange-700">
                        Save Changes
                    </button>
                    <div class="text-xs text-slate-500">
                        Joined: {customer.created_at}
                        {if customer.last_login_at}· Last login: {customer.last_login_at}{/if}
                    </div>
                </div>
            </form>
        </div>

        <!-- Saved Addresses -->
        {if addresses | count > 0}
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <div class="px-5 py-3 border-b border-gray-200 font-semibold text-sm text-gray-800">Saved Addresses</div>
            {foreach addresses as addr}
            <div class="px-5 py-4 border-b border-gray-100 last:border-b-0 text-sm">
                <div class="flex items-center gap-2 mb-1">
                    <span class="font-medium text-gray-800">{addr.label}</span>
                    {if addr.is_default}<span class="text-[10px] px-1.5 py-0.5 bg-orange-50 text-orange-600 rounded font-semibold">default</span>{/if}
                </div>
                <div class="text-gray-600">
                    {addr.first_name} {addr.last_name}<br>
                    {addr.address_line1}{if addr.address_line2}, {addr.address_line2}{/if}<br>
                    {addr.city}{if addr.state}, {addr.state}{/if} {addr.postal_code} · {addr.country}
                </div>
                {if addr.phone}<div class="text-slate-500 text-xs mt-0.5">{addr.phone}</div>{/if}
            </div>
            {/foreach}
        </div>
        {/if}

        <!-- Recent Orders -->
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <div class="px-5 py-3 border-b border-gray-200 font-semibold text-sm text-gray-800">
                Order History
                <span class="ml-2 text-xs font-normal text-slate-500">({customer.order_count} total)</span>
            </div>
            {if orders | count == 0}
            <div class="px-5 py-8 text-center text-slate-500 text-sm">No orders yet.</div>
            {/if}
            {foreach orders as o}
            <a href="{base_url}/ecommerce/admin/orders/{o.id}"
               class="flex items-center justify-between px-5 py-3 border-b border-gray-100 last:border-b-0 hover:bg-gray-50">
                <div>
                    <span class="font-mono text-xs font-semibold text-gray-800">{o.order_number}</span>
                    <span class="ml-2 text-xs text-slate-500">{o.created_at}</span>
                </div>
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold
                        {if o.status == 'pending'}bg-amber-50 text-amber-700
                        {elseif o.status == 'processing'}bg-blue-50 text-blue-700
                        {elseif o.status == 'delivered'}bg-emerald-50 text-emerald-700
                        {else}bg-gray-100 text-gray-600{/if}">{o.status}</span>
                    <span class="font-semibold text-sm text-gray-900">{ec_settings.currency_symbol}{o.total}</span>
                </div>
            </a>
            {/foreach}
        </div>
    </div>

    <!-- Sidebar (right 1/3) -->
    <div class="space-y-5">
        <!-- Stats card -->
        <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-3">
            <h3 class="font-semibold text-sm text-gray-800">Summary</h3>
            <div class="flex justify-between text-sm">
                <span class="text-gray-500">Total Orders</span>
                <span class="font-semibold text-gray-900">{customer.order_count}</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-gray-500">Lifetime Value</span>
                <span class="font-semibold text-gray-900">
                    {if customer.lifetime_value}{ec_settings.currency_symbol}{customer.lifetime_value}{else}—{/if}
                </span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-gray-500">Account Status</span>
                {if customer.is_active}
                <span class="text-emerald-600 font-medium">Active</span>
                {else}
                <span class="text-red-500 font-medium">Disabled</span>
                {/if}
            </div>
        </div>

        <!-- Danger zone -->
        <div class="bg-white rounded-lg border border-red-200 p-5">
            <h3 class="font-semibold text-sm text-red-700 mb-3">Danger Zone</h3>
            <p class="text-xs text-gray-500 mb-3">
                Deleting this customer is permanent. Their order history will be retained but de-linked. Saved addresses will be removed.
            </p>
            <form method="post" action=""
                  onsubmit="return confirm('Permanently delete this customer? This cannot be undone.')">
                <input type="hidden" name="_token" value="{csrf_token}">
                <input type="hidden" name="action" value="delete">
                <button type="submit"
                        class="w-full px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700">
                    Delete Customer
                </button>
            </form>
        </div>
    </div>
</div>
{/block}
