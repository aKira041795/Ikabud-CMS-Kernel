{extends "modules/ecommerce/layouts/admin.disyl"}

{block content}
<!-- Filters -->
<form method="get" action="" class="flex flex-wrap gap-2 mb-5">
    <input type="text" name="search" value="{filters.search}" placeholder="Order #, name, email…"
           class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
    <select name="status" class="border border-gray-300 rounded-lg px-3 py-2 text-sm">
        <option value="">All statuses</option>
        <option value="pending"    {if filters.status == 'pending'}selected{/if}>Pending</option>
        <option value="processing" {if filters.status == 'processing'}selected{/if}>Processing</option>
        <option value="shipped"    {if filters.status == 'shipped'}selected{/if}>Shipped</option>
        <option value="delivered"  {if filters.status == 'delivered'}selected{/if}>Delivered</option>
        <option value="cancelled"  {if filters.status == 'cancelled'}selected{/if}>Cancelled</option>
        <option value="refunded"   {if filters.status == 'refunded'}selected{/if}>Refunded</option>
    </select>
    <select name="source" class="border border-gray-300 rounded-lg px-3 py-2 text-sm">
        <option value="">All sources</option>
        <option value="web" {if filters.source == 'web'}selected{/if}>Web</option>
        <option value="pos" {if filters.source == 'pos'}selected{/if}>POS</option>
    </select>
    <input type="date" name="date_from" value="{filters.date_from}" class="border border-gray-300 rounded-lg px-3 py-2 text-sm">
    <input type="date" name="date_to"   value="{filters.date_to}"   class="border border-gray-300 rounded-lg px-3 py-2 text-sm">
    <button type="submit" class="px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm hover:bg-gray-50">Filter</button>
</form>

<!-- Orders table -->
<div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
        <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
            <tr>
                <th class="px-5 py-3 text-left">Order</th>
                <th class="px-4 py-3 text-left">Customer</th>
                <th class="px-4 py-3 text-center">Source</th>
                <th class="px-4 py-3 text-center">Status</th>
                <th class="px-4 py-3 text-center">Payment</th>
                <th class="px-4 py-3 text-right">Total</th>
                <th class="px-4 py-3 text-right">Date</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            {if orders | count == 0}
            <tr><td colspan="7" class="px-5 py-10 text-center text-gray-400">No orders found.</td></tr>
            {/if}
            {foreach orders as o}
            <tr class="hover:bg-gray-50 cursor-pointer" onclick="location.href='{base_url}/ecommerce/admin/orders/{o.id}'">
                <td class="px-5 py-3 font-mono text-xs font-semibold text-gray-700">{o.order_number}</td>
                <td class="px-4 py-3 text-gray-700">{o.guest_name | default:o.guest_email | default:'Guest'}</td>
                <td class="px-4 py-3 text-center">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold
                        {if o.source == 'pos'}bg-violet-50 text-violet-700{else}bg-sky-50 text-sky-700{/if}">
                        {o.source}
                    </span>
                </td>
                <td class="px-4 py-3 text-center">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold
                        {if o.status == 'pending'}bg-amber-50 text-amber-700
                        {elseif o.status == 'processing'}bg-blue-50 text-blue-700
                        {elseif o.status == 'shipped'}bg-purple-50 text-purple-700
                        {elseif o.status == 'delivered'}bg-emerald-50 text-emerald-700
                        {else}bg-gray-100 text-gray-600{/if}">{o.status}</span>
                </td>
                <td class="px-4 py-3 text-center">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold
                        {if o.payment_status == 'paid'}bg-emerald-50 text-emerald-700{else}bg-amber-50 text-amber-700{/if}">
                        {o.payment_status}
                    </span>
                </td>
                <td class="px-4 py-3 text-right font-semibold text-gray-900">{ec_settings.currency_symbol | default:'$'}{o.total}</td>
                <td class="px-4 py-3 text-right text-xs text-gray-400">{o.created_at}</td>
            </tr>
            {/foreach}
        </tbody>
    </table>
</div>
<!-- Pagination -->
{if total_pages > 1}
<div class="mt-4 flex items-center justify-between text-sm text-gray-500">
    <span>{total} orders</span>
    <div class="flex gap-1">
        {if page > 1}<a href="?page={page - 1}" class="px-3 py-1.5 border rounded hover:bg-gray-50">←</a>{/if}
        <span class="px-3 py-1.5 bg-white border rounded text-gray-700">{page} / {total_pages}</span>
        {if page < total_pages}<a href="?page={page + 1}" class="px-3 py-1.5 border rounded hover:bg-gray-50">→</a>{/if}
    </div>
</div>
{/if}
{/block}
