{extends "modules/ecommerce/layouts/admin.disyl"}

{block content}
<div class="space-y-5">

    {if message}
    <div class="px-4 py-3 rounded-xl border text-sm {if message.type == 'error'}bg-red-50 border-red-200 text-red-700{else}bg-emerald-50 border-emerald-200 text-emerald-700{/if}">{message.text}</div>
    {/if}

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Active</div>
            <div class="mt-1 text-2xl font-bold text-gray-900">{counts.active | default:'0'}</div>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Expired</div>
            <div class="mt-1 text-2xl font-bold text-gray-900">{counts.expired | default:'0'}</div>
        </div>
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Cancelled</div>
            <div class="mt-1 text-2xl font-bold text-gray-900">{counts.cancelled | default:'0'}</div>
        </div>
    </div>

    <!-- Actions bar -->
    <div class="flex items-center justify-between">
        <div class="text-sm text-slate-500">{total | default:'0'} membership{if total != 1}s{/if}</div>
        <button type="button" onclick="document.getElementById('ec-grant-modal').classList.remove('hidden')"
                class="px-4 py-2 bg-orange-600 text-white text-sm font-semibold rounded-lg hover:bg-orange-700 transition-colors">
            + Grant Membership
        </button>
    </div>

    <!-- Grant Membership Modal -->
    <div id="ec-grant-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm">
        <div class="bg-white rounded-2xl border border-gray-200 shadow-xl w-full max-w-md mx-4 p-6">
            <h2 class="text-base font-semibold text-gray-900 mb-4">Grant Membership</h2>
            <form method="post" action="" class="space-y-4">
                <input type="hidden" name="_token" value="{csrf_token}">
                <input type="hidden" name="action" value="grant">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Customer Email</label>
                    <input type="email" name="customer_email" required placeholder="customer@example.com"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Tier</label>
                        <input type="text" name="tier" value="member" placeholder="member"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono focus:border-orange-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Duration (days)</label>
                        <input type="number" name="duration_days" value="365" min="1"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                </div>
                <p class="text-xs text-slate-500">The membership activates immediately from today.</p>
                <div class="flex gap-3 pt-1">
                    <button type="submit" class="flex-1 px-4 py-2 bg-orange-600 text-white text-sm font-semibold rounded-lg hover:bg-orange-700">Grant</button>
                    <button type="button" onclick="document.getElementById('ec-grant-modal').classList.add('hidden')"
                            class="flex-1 px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg hover:bg-gray-50">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Extend Modal -->
    <div id="ec-extend-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm">
        <div class="bg-white rounded-2xl border border-gray-200 shadow-xl w-full max-w-sm mx-4 p-6">
            <h2 class="text-base font-semibold text-gray-900 mb-4">Extend Membership</h2>
            <form method="post" action="" class="space-y-4">
                <input type="hidden" name="_token" value="{csrf_token}">
                <input type="hidden" name="action" value="extend">
                <input type="hidden" name="id" id="ec-extend-id" value="">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Extend by (days)</label>
                    <input type="number" name="extend_days" value="30" min="1"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                </div>
                <div class="flex gap-3 pt-1">
                    <button type="submit" class="flex-1 px-4 py-2 bg-orange-600 text-white text-sm font-semibold rounded-lg hover:bg-orange-700">Extend</button>
                    <button type="button" onclick="document.getElementById('ec-extend-modal').classList.add('hidden')"
                            class="flex-1 px-4 py-2 border border-gray-300 text-sm font-medium rounded-lg hover:bg-gray-50">Cancel</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-xl border border-gray-200 p-4">
        <form method="get" action="" class="flex flex-wrap items-end gap-3">
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Status</label>
                <select name="status" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    <option value="">All</option>
                    <option value="active" {if status == 'active'}selected{/if}>Active</option>
                    <option value="expired" {if status == 'expired'}selected{/if}>Expired</option>
                    <option value="cancelled" {if status == 'cancelled'}selected{/if}>Cancelled</option>
                </select>
            </div>
            <div class="flex-1 min-w-[200px]">
                <label class="block text-xs font-semibold text-gray-600 mb-1">Search</label>
                <input type="text" name="search" value="{search}" placeholder="Customer, product, or tier…"
                       class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
            </div>
            <button type="submit" class="px-4 py-2 bg-orange-600 text-white text-sm font-medium rounded-lg hover:bg-orange-700">Filter</button>
        </form>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-gray-50/80 text-left text-[11px] uppercase tracking-wider font-semibold text-slate-600">
                    <tr>
                        <th class="px-4 py-3">Customer</th>
                        <th class="px-4 py-3">Product</th>
                        <th class="px-4 py-3">Tier</th>
                        <th class="px-4 py-3">Status</th>
                        <th class="px-4 py-3">Duration</th>
                        <th class="px-4 py-3">Starts</th>
                        <th class="px-4 py-3">Expires</th>
                        <th class="px-4 py-3">Order</th>
                        <th class="px-4 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {if memberships | count == 0}
                    <tr><td colspan="9" class="px-4 py-10 text-center text-slate-500">No memberships found.</td></tr>
                    {/if}
                    {foreach memberships as m}
                    <tr class="hover:bg-gray-50/50">
                        <td class="px-4 py-3">
                            <div class="font-medium text-gray-900">{m.customer_name | default:'—'}</div>
                            <div class="text-xs text-slate-500">{m.customer_email | default:''}</div>
                        </td>
                        <td class="px-4 py-3 text-gray-700">{m.product_title | default:'—'}</td>
                        <td class="px-4 py-3">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-violet-50 text-violet-700">{m.tier_label | default:m.membership_tier}</span>
                        </td>
                        <td class="px-4 py-3">
                            {if m.is_active}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700">Active</span>
                            {elseif m.status == 'cancelled'}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-red-50 text-red-700">Cancelled</span>
                            {else}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-gray-100 text-gray-600">Expired</span>
                            {/if}
                        </td>
                        <td class="px-4 py-3 text-slate-600">{m.duration_days} days</td>
                        <td class="px-4 py-3 text-slate-600 text-xs">{m.starts_at | default:'—'}</td>
                        <td class="px-4 py-3 text-slate-600 text-xs">{m.ends_at | default:'Never'}</td>
                        <td class="px-4 py-3">
                            {if m.order_id}<a href="{base_url}/ecommerce/admin/orders/{m.order_id}" class="text-orange-600 hover:underline text-xs font-medium">#{m.order_id}</a>{else}—{/if}
                        </td>
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-2">
                                <button type="button" onclick="ecExtendMembership('{m.id}')" class="text-xs text-blue-600 hover:underline font-medium">Extend</button>
                                {if m.status != 'cancelled'}
                                <form method="post" action="" class="inline" onsubmit="return confirm('Revoke this membership?')">
                                    <input type="hidden" name="_token" value="{csrf_token}">
                                    <input type="hidden" name="action" value="revoke">
                                    <input type="hidden" name="id" value="{m.id}">
                                    <button type="submit" class="text-xs text-red-600 hover:underline font-medium">Revoke</button>
                                </form>
                                {/if}
                            </div>
                        </td>
                    </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>

        {if total_pages > 1}
        <div class="px-4 py-3 border-t border-gray-100 flex items-center justify-between text-xs text-slate-500">
            <span>Page {page} of {total_pages} · {total} memberships</span>
            <div class="flex gap-1">
                {if page > 1}<a href="?page={page - 1}&status={status}&search={search}" class="px-3 py-1 rounded-lg border hover:bg-gray-50">Prev</a>{/if}
                {if page < total_pages}<a href="?page={page + 1}&status={status}&search={search}" class="px-3 py-1 rounded-lg border hover:bg-gray-50">Next</a>{/if}
            </div>
        </div>
        {/if}
    </div>

</div>
{/block}

{block scripts}
<script>
function ecExtendMembership(id) {
    document.getElementById('ec-extend-id').value = id;
    document.getElementById('ec-extend-modal').classList.remove('hidden');
}
</script>
{/block}
