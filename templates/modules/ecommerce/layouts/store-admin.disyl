<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title} — Shop Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://unpkg.com/alpinejs@3.14.3/dist/cdn.min.js"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <script>
        tailwind.config = {
            theme: { extend: { colors: {
                ec: { 50:'#fff7ed',100:'#ffedd5',200:'#fed7aa',300:'#fdba74',400:'#fb923c',500:'#f97316',600:'#ea580c',700:'#c2410c',800:'#9a3412',900:'#7c2d12' }
            }}}
        }
    </script>
    <style>
        [x-cloak]{ display:none !important; }
        .ec-admin { color:#1f2937; -webkit-font-smoothing:antialiased; }
        .ec-admin main { color:#1e293b; line-height:1.58; }
        .ec-admin main h1,.ec-admin main h2,.ec-admin main h3 { color:#0f172a; }
        .ec-admin main .text-gray-400 { color:#64748b !important; }
        .ec-admin main .text-gray-500 { color:#475569 !important; }
        .ec-admin main .text-gray-600 { color:#334155 !important; }
        .ec-admin main .text-gray-700 { color:#1e293b !important; }
        .ec-admin main input,.ec-admin main select,.ec-admin main textarea { color:#0f172a; font-weight:500; }
        .ec-admin main label { color:#334155; font-weight:600; }
        .ec-nav-item { display:flex; align-items:center; padding:7px 12px; border-radius:6px; font-size:13px; font-weight:500; transition:all .15s ease; }
        .ec-nav-item:hover { background:rgba(255,255,255,.08); }
        .ec-nav-item.active { background:rgba(255,255,255,.12); color:#fff; font-weight:600; }
        .ec-nav-item:not(.active):not(.disabled) { color:rgba(203,213,225,.9); }
        .ec-nav-item:not(.active):not(.disabled):hover { color:#f1f5f9; }
        .ec-nav-item.disabled { color:rgba(148,163,184,.3); pointer-events:none; cursor:default; }
        .ec-nav-item svg { opacity:.7; }
        .ec-nav-item.active svg,.ec-nav-item:hover svg { opacity:1; }
        .ec-nav-item.disabled svg { opacity:.25; }
        .ec-nav-section { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:rgba(148,163,184,.6); padding:16px 12px 4px 12px; }
    </style>
    {block head}{/block}
</head>
<body class="ec-admin bg-gray-50 min-h-screen" x-data="{ sidebarOpen: true }">
<div class="flex h-screen overflow-hidden">

    <!-- Sidebar -->
    <aside class="hidden lg:flex lg:flex-col bg-slate-900 text-white transition-all duration-200"
           :class="sidebarOpen ? 'w-[232px]' : 'w-16'">

        <!-- Store identity header -->
        <div class="flex items-center h-14 px-4 border-b border-white/[.06] shrink-0 gap-2.5">
            <svg class="w-6 h-6 text-orange-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            <div class="overflow-hidden" x-show="sidebarOpen" x-cloak>
                <p class="font-bold text-[13px] text-white/90 truncate leading-tight">{store.name | escape}</p>
                <p class="text-[10px] font-semibold uppercase tracking-wider leading-tight
                    {if store_role == 'owner'}text-amber-400
                    {elseif store_role == 'manager'}text-blue-400
                    {elseif store_role == 'supervisor'}text-emerald-400
                    {else}text-slate-400{/if}">{store_role}</p>
            </div>
        </div>

        <nav class="flex-1 overflow-y-auto py-2 px-2 space-y-px">

            {* ── Overview ─────────────────────────────────────── *}
            <a href="{base_url}/ecommerce/store-admin/{store.id}" class="ec-nav-item {if current_page == 'dashboard'}active{/if}">
                <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                <span class="ml-3" x-show="sidebarOpen" x-cloak>Dashboard</span>
            </a>

            {* ── Orders & Sales ──────────────────────────────── *}
            <div class="ec-nav-section" x-show="sidebarOpen" x-cloak>Orders &amp; Sales</div>
            <a href="{base_url}/ecommerce/store-admin/{store.id}/orders" class="ec-nav-item {if current_page == 'orders'}active{/if}">
                <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                <span class="ml-3" x-show="sidebarOpen" x-cloak>Orders</span>
            </a>
            <span class="ec-nav-item disabled">
                <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 14l-4-4m0 0l4-4m-4 4h11a4 4 0 014 4v4"/></svg>
                <span class="ml-3" x-show="sidebarOpen" x-cloak>Returns</span>
            </span>
            <span class="ec-nav-item disabled">
                <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"/></svg>
                <span class="ml-3" x-show="sidebarOpen" x-cloak>Abandoned Carts</span>
            </span>

            {* ── Catalog ─────────────────────────────────────── *}
            <div class="ec-nav-section" x-show="sidebarOpen" x-cloak>Catalog</div>
            <a href="{base_url}/ecommerce/store-admin/{store.id}/products" class="ec-nav-item {if current_page == 'products'}active{/if}">
                <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                <span class="ml-3" x-show="sidebarOpen" x-cloak>Products</span>
            </a>
            <span class="ec-nav-item disabled">
                <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
                <span class="ml-3" x-show="sidebarOpen" x-cloak>Categories</span>
            </span>
            <a href="{base_url}/ecommerce/store-admin/{store.id}/coupons" class="ec-nav-item {if current_page == 'coupons'}active{/if}">
                <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>
                <span class="ml-3" x-show="sidebarOpen" x-cloak>Coupons</span>
            </a>
            <a href="{base_url}/ecommerce/store-admin/{store.id}/reviews" class="ec-nav-item {if current_page == 'reviews'}active{/if}">
                <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.02 3.136a1 1 0 00.95.69h3.298c.969 0 1.371 1.24.588 1.81l-2.668 1.938a1 1 0 00-.364 1.118l1.02 3.136c.3.921-.755 1.688-1.538 1.118l-2.668-1.938a1 1 0 00-1.176 0l-2.668 1.938c-.783.57-1.838-.197-1.539-1.118l1.02-3.136a1 1 0 00-.364-1.118L2.243 8.563c-.783-.57-.38-1.81.588-1.81H6.13a1 1 0 00.95-.69l1.02-3.136z"/></svg>
                <span class="ml-3" x-show="sidebarOpen" x-cloak>Reviews</span>
            </a>

            {* ── Customers ───────────────────────────────────── *}
            <div class="ec-nav-section" x-show="sidebarOpen" x-cloak>Customers</div>
            <span class="ec-nav-item disabled">
                <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <span class="ml-3" x-show="sidebarOpen" x-cloak>Customers</span>
            </span>
            <span class="ec-nav-item disabled">
                <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18C2.754 7.5 2.25 8.004 2.25 8.625v1.5c0 .621.504 1.125 1.125 1.125z"/></svg>
                <span class="ml-3" x-show="sidebarOpen" x-cloak>Loyalty &amp; Rewards</span>
            </span>

            {* ── Analytics ───────────────────────────────────── *}
            <div class="ec-nav-section" x-show="sidebarOpen" x-cloak>Analytics</div>
            <span class="ec-nav-item disabled">
                <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                <span class="ml-3" x-show="sidebarOpen" x-cloak>Reports</span>
            </span>

            {* ── Operations ──────────────────────────────────── *}
            <div class="ec-nav-section" x-show="sidebarOpen" x-cloak>Operations</div>
            <a href="{base_url}/ecommerce/pos" class="ec-nav-item {if current_page == 'pos'}active{/if}">
                <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                <span class="ml-3" x-show="sidebarOpen" x-cloak>Point of Sale</span>
            </a>
            <span class="ec-nav-item disabled">
                <svg class="w-[18px] h-[18px] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/></svg>
                <span class="ml-3" x-show="sidebarOpen" x-cloak>Import / Export</span>
            </span>

            {* ── Back to My Stores ───────────────────────────── *}
            <div class="mt-3 pt-3 border-t border-white/[.06] px-3" x-show="sidebarOpen" x-cloak>
                <a href="{base_url}/ecommerce/my-stores"
                   class="text-[11px] font-medium text-slate-500 hover:text-slate-300 transition-colors">
                    ← My Stores
                </a>
            </div>
        </nav>
    </aside>

    <!-- Main area -->
    <div class="flex-1 flex flex-col overflow-hidden">

        <!-- Top bar -->
        <header class="bg-white border-b border-gray-200/80 px-6 h-14 flex items-center justify-between shrink-0">
            <div class="flex items-center gap-3">
                <button @click="sidebarOpen = !sidebarOpen"
                        class="hidden lg:inline-flex text-gray-400 hover:text-gray-700 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
                <h1 class="text-base font-semibold text-gray-900">{page_title}</h1>
            </div>
            <div class="flex items-center gap-4">
                <a href="{base_url}/ecommerce/shop?store={store.slug | escape}" target="_blank"
                   class="text-[13px] font-medium text-gray-500 hover:text-gray-800 transition-colors">
                    View Store
                </a>
                <div class="h-4 w-px bg-gray-200"></div>
                <span class="text-[13px] font-medium text-gray-600">{user.display_name | default:'User'}</span>
            </div>
        </header>

        <!-- Flash message -->
        {if message}
        <div class="mx-6 mt-4 px-4 py-3 rounded-lg text-sm font-medium
                    {if message.type == 'success'}bg-emerald-50 text-emerald-800 border border-emerald-200
                    {else}bg-red-50 text-red-800 border border-red-200{/if}"
             x-data x-init="setTimeout(() => $el.remove(), 5000)">
            {message.text}
        </div>
        {/if}

        <!-- Page content -->
        <main class="flex-1 overflow-y-auto p-6">
            {block content}{/block}
        </main>
    </div>
</div>
{block scripts}{/block}
</body>
</html>
