<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{if storefront.page.title}{storefront.page.title}{else}{page_title}{/if}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    {if theme_style_url}<link rel="stylesheet" href="{theme_style_url}">{/if}
    {if colors_style}{colors_style|raw}{/if}
    {if theme_layout_style}{theme_layout_style|raw}{/if}
    {if custom_css}{custom_css|raw}{/if}
    {if storefront_theme_css}{storefront_theme_css|raw}{/if}
    {if head_code}{head_code|raw}{/if}
    {block head}{/block}
</head>
<body class="{if active_theme_slug}{active_theme_slug}{/if} ecommerce-public bg-white text-gray-900 min-h-screen">
<div class="{if active_theme_slug == 'entity-commerce-poc'}poc-shell{/if}">
    {if active_theme_slug == 'entity-commerce-poc'}<div class="poc-shell__backdrop"></div>{/if}

{set header_region_present = header_region.present|default:has_customized_header|default:false}
{set header_region_html = header_region.html|default:customized_header|default:''}
{set footer_region_present = footer_region.present|default:has_customized_footer|default:false}
{set footer_region_html = footer_region.html|default:customized_footer|default:''}

{if header_region_present}
{header_region_html|raw}
{else}
<header class="border-b border-gray-200 bg-white sticky top-0 z-10">
    <div class="cms-public-shell px-4 sm:px-6 py-4 flex items-center justify-between">
        <a href="{if storefront.navigation.shop_url}{storefront.navigation.shop_url}{else}{base_url}/ecommerce/shop{/if}" class="font-bold text-xl text-gray-900">Shop</a>
        <nav class="hidden md:flex items-center gap-6 text-sm">
            <a href="{if storefront.navigation.shop_url}{storefront.navigation.shop_url}{else}{base_url}/ecommerce/shop{/if}" class="text-gray-600 hover:text-gray-900">Products</a>
            <a href="{base_url}/ecommerce/my-wishlist" class="text-gray-600 hover:text-gray-900">Wishlist</a>
            <a href="{base_url}/ecommerce/compare" class="text-gray-600 hover:text-gray-900">Compare</a>
            <a href="{base_url}/ecommerce/my-orders" class="text-gray-600 hover:text-gray-900">My Orders</a>
        </nav>
        {if ec_currency.selector_enabled}
        <label class="hidden md:flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em] text-gray-500">
            <span>Currency</span>
            <select id="ec-currency-switcher" class="rounded-lg border border-gray-300 bg-white px-2 py-1.5 text-xs font-medium text-gray-700">
                {foreach ec_currency.available as option}
                <option value="{option.code}" {if option.is_current}selected{/if}>{option.code}</option>
                {/foreach}
            </select>
        </label>
        {/if}
        <div class="flex items-center gap-2">
        <a href="{base_url}/ecommerce/my-wishlist" class="relative inline-flex items-center gap-1.5 px-4 py-2 border border-rose-200 text-rose-700 text-sm font-medium rounded-lg hover:bg-rose-50">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 0 1 6.364 0L12 7.636l1.318-1.318a4.5 4.5 0 1 1 6.364 6.364L12 20.364 4.318 12.682a4.5 4.5 0 0 1 0-6.364Z"/></svg>
            Wishlist
            <span class="ml-1 {if storefront.wishlist.count|default:wishlist_count|default:0 > 0}inline-flex{else}hidden{/if} items-center justify-center min-w-[1.25rem] h-5 px-1 bg-rose-600 text-white text-xs font-bold rounded-full">{storefront.wishlist.count|default:wishlist_count|default:0}</span>
        </a>
        <a href="{base_url}/ecommerce/compare" class="relative inline-flex items-center gap-1.5 px-4 py-2 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17H7A2 2 0 015 15V5a2 2 0 012-2h2m6 14h2a2 2 0 002-2V5a2 2 0 00-2-2h-2m-6 14h6M9 7h6"/></svg>
            Compare
            <span class="ml-1 {if storefront.compare.count|default:compare_count|default:0 > 0}inline-flex{else}hidden{/if} items-center justify-center min-w-[1.25rem] h-5 px-1 bg-gray-900 text-white text-xs font-bold rounded-full">{storefront.compare.count|default:compare_count|default:0}</span>
        </a>
        <a href="{base_url}/ecommerce/cart" class="relative inline-flex items-center gap-1.5 px-4 py-2 bg-orange-600 text-white text-sm font-medium rounded-lg hover:bg-orange-700">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
            Cart
            {if storefront.page.kind}
            <span id="cart-count-badge" class="ml-1 {if storefront.cart.count > 0}inline-flex{else}hidden{/if} items-center justify-center w-5 h-5 bg-white text-orange-600 text-xs font-bold rounded-full">{storefront.cart.count}</span>
            {else}
            <span id="cart-count-badge" class="ml-1 {if cart_count > 0}inline-flex{else}hidden{/if} items-center justify-center w-5 h-5 bg-white text-orange-600 text-xs font-bold rounded-full">{cart_count}</span>
            {/if}
        </a>
        </div>
    </div>
</header>
{/if}

<main class="{if active_theme_slug == 'entity-commerce-poc'}poc-main{else}cms-public-main{/if}">
    {if public_render_origin == 'ecommerce' && public_customer_is_logged_in}
    <section class="cms-public-shell px-4 sm:px-6 pt-6">
        <div class="rounded-2xl border border-orange-100 bg-gradient-to-r from-orange-50 via-white to-slate-50 px-4 py-4 shadow-sm sm:px-5 sm:py-5">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-orange-700">Signed In</div>
                    <h2 class="mt-1 text-lg font-semibold text-gray-900">Welcome back, {public_customer_display_name}</h2>
                    <p class="mt-1 text-sm text-gray-600">Shopping with <strong>{public_customer_email}</strong>. Your recent ecommerce activity stays linked to this account.</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <a href="{if public_customer_wishlist_url}{public_customer_wishlist_url}{else}{base_url}/ecommerce/my-wishlist{/if}" class="inline-flex items-center rounded-lg border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-medium text-rose-700 hover:bg-rose-100">Wishlist</a>
                    <a href="{public_customer_orders_url}" class="inline-flex items-center rounded-lg bg-orange-600 px-4 py-2 text-sm font-medium text-white hover:bg-orange-700">My Orders</a>
                    {if public_customer_has_admin_access}
                    <a href="{public_customer_admin_url}" class="inline-flex items-center rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">CMS Admin</a>
                    {/if}
                    <a href="{base_url}/auth/logout?redirect=/ecommerce/shop" class="inline-flex items-center rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Log Out</a>
                </div>
            </div>
        </div>
    </section>
    {/if}
    {if active_theme_slug == 'entity-commerce-poc'}<div class="poc-main__inner"><div class="poc-content"><div class="px-6 py-8 sm:px-8 sm:py-10">{/if}
    {block content}{/block}
    {if active_theme_slug == 'entity-commerce-poc'}</div></div></div>{/if}
</main>

{if footer_region_present}
{footer_region_html|raw}
{else}
<footer class="mt-16 border-t border-gray-200 py-8 text-center text-sm text-gray-400">
    <div class="cms-public-shell px-4 sm:px-6">
        {if social_links | count > 0}
        <div class="flex items-center justify-center gap-4 mb-4">
            {foreach social_links as sl}
            <a href="{sl.url | escape}" target="_blank" rel="noopener noreferrer"
               aria-label="{sl.label | escape}"
               class="inline-flex items-center justify-center w-8 h-8 rounded-full text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition-colors">
                {if sl.key == 'facebook'}
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.522-4.477-10-10-10S2 6.478 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
                {elseif sl.key == 'instagram'}
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                {elseif sl.key == 'tiktok'}
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V9.09a8.16 8.16 0 004.77 1.52V7.16a4.85 4.85 0 01-1-.47z"/></svg>
                {elseif sl.key == 'twitter'}
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                {elseif sl.key == 'youtube'}
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                {/if}
            </a>
            {/foreach}
        </div>
        {/if}
        &copy; {year} Shop. Powered by Ikabud CMS.
    </div>
</footer>
{/if}

{if theme_script_url}<script src="{theme_script_url}" defer></script>{/if}
{if body_end_code}{body_end_code|raw}{/if}
<script>
    (function () {
        var switcher = document.getElementById('ec-currency-switcher');
        if (!switcher) {
            return;
        }

        switcher.addEventListener('change', function () {
            var url = new URL(window.location.href);
            url.searchParams.set('currency', switcher.value);
            window.location.href = url.toString();
        });
    })();
</script>
{block scripts}{/block}
</div>
</body>
</html>
