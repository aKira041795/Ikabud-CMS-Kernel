<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{if storefront.page.title}{storefront.page.title}{else}{page_title}{/if}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    {if theme_style_url}<link rel="stylesheet" href="{theme_style_url}">{/if}
    {if colors_style}{colors_style|raw}{/if}
    {if theme_layout_style}{theme_layout_style|raw}{/if}
    {if custom_css}{custom_css|raw}{/if}
    {if head_code}{head_code|raw}{/if}
    {block head}{/block}
</head>
<body class="{if active_theme_slug}{active_theme_slug}{/if} ecommerce-public bg-white text-gray-900 min-h-screen">
<div class="{if active_theme_slug == 'entity-commerce-poc'}poc-shell{/if}">
    {if active_theme_slug == 'entity-commerce-poc'}<div class="poc-shell__backdrop"></div>{/if}

{if has_customized_header}
{customized_header|raw}
{else}
<header class="border-b border-gray-200 bg-white sticky top-0 z-10">
    <div class="cms-public-shell px-4 sm:px-6 py-4 flex items-center justify-between">
        <a href="{if storefront.navigation.shop_url}{storefront.navigation.shop_url}{else}{base_url}/ecommerce/shop{/if}" class="font-bold text-xl text-gray-900">Shop</a>
        <nav class="hidden md:flex items-center gap-6 text-sm">
            <a href="{if storefront.navigation.shop_url}{storefront.navigation.shop_url}{else}{base_url}/ecommerce/shop{/if}" class="text-gray-600 hover:text-gray-900">Products</a>
            <a href="{base_url}/ecommerce/my-orders" class="text-gray-600 hover:text-gray-900">My Orders</a>
        </nav>
        <a href="{base_url}/ecommerce/cart" class="relative inline-flex items-center gap-1.5 px-4 py-2 bg-orange-600 text-white text-sm font-medium rounded-lg hover:bg-orange-700">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
            Cart
            {if storefront.page.kind}
            <span id="cart-count-badge" class="ml-1 {if storefront.cart.count > 0}inline-flex{else}hidden{/if} items-center justify-center w-5 h-5 bg-white text-orange-600 text-xs font-bold rounded-full">{storefront.cart.count}</span>
            {else}
            <span id="cart-count-badge" class="ml-1 {if cart_count > 0}inline-flex{else}hidden{/if} items-center justify-center w-5 h-5 bg-white text-orange-600 text-xs font-bold rounded-full">{cart_count}</span>
            {/if}
        </a>
    </div>
</header>
{/if}

<main class="{if active_theme_slug == 'entity-commerce-poc'}poc-main{else}cms-public-main{/if}">
    {if public_render_origin == 'ecommerce' && public_customer_is_logged_in}
    <section class="cms-public-shell px-4 sm:px-6 pt-6">
        <div class="rounded-2xl border border-orange-100 bg-gradient-to-r from-orange-50 via-white to-slate-50 px-4 py-4 shadow-sm sm:px-5 sm:py-5">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-orange-700">Signed In</div>
                    <h2 class="mt-1 text-lg font-semibold text-gray-900">Welcome back, {public_customer_display_name}</h2>
                    <p class="mt-1 text-sm text-gray-600">Shopping with <strong>{public_customer_email}</strong>. Your recent ecommerce activity stays linked to this account.</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <a href="{public_customer_orders_url}" class="inline-flex items-center rounded-lg bg-orange-600 px-4 py-2 text-sm font-medium text-white hover:bg-orange-700">My Orders</a>
                    {if public_customer_has_admin_access}
                    <a href="{public_customer_admin_url}" class="inline-flex items-center rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">CMS Admin</a>
                    {/if}
                    <a href="{base_url}/auth/logout?redirect=/ecommerce/shop" class="inline-flex items-center rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Log Out</a>
                </div>
            </div>
        </div>
    </section>
    {/if}
    {if active_theme_slug == 'entity-commerce-poc'}<div class="poc-main__inner"><div class="poc-content"><div class="px-6 py-8 sm:px-8 sm:py-10">{/if}
    {block content}{/block}
    {if active_theme_slug == 'entity-commerce-poc'}</div></div></div>{/if}
</main>

{if has_customized_footer}
{customized_footer|raw}
{else}
<footer class="mt-16 border-t border-gray-200 py-8 text-center text-sm text-gray-400">
    <div class="cms-public-shell px-4 sm:px-6">&copy; {year} Shop. Powered by Ikabud CMS.</div>
</footer>
{/if}

{if theme_script_url}<script src="{theme_script_url}" defer></script>{/if}
{if body_end_code}{body_end_code|raw}{/if}
{block scripts}{/block}
</div>
</body>
</html>
