<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
</head>
<body class="bg-white text-gray-900 min-h-screen">
<header class="border-b border-gray-200 bg-white sticky top-0 z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
        <a href="{base_url}/ecommerce/shop" class="font-bold text-xl text-gray-900">Shop</a>
        <nav class="hidden md:flex items-center gap-6 text-sm">
            <a href="{base_url}/ecommerce/shop" class="text-gray-600 hover:text-gray-900">Products</a>
            <a href="{base_url}/my-orders" class="text-gray-600 hover:text-gray-900">My Orders</a>
        </nav>
        <a href="{base_url}/cart" class="relative inline-flex items-center gap-1.5 px-4 py-2 bg-orange-600 text-white text-sm font-medium rounded-lg hover:bg-orange-700">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
            Cart
            {if cart_count > 0}
            <span class="ml-1 inline-flex items-center justify-center w-5 h-5 bg-white text-orange-600 text-xs font-bold rounded-full">{cart_count}</span>
            {/if}
        </a>
    </div>
</header>
<main class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    {block content}{/block}
</main>
<footer class="mt-16 border-t border-gray-200 py-8 text-center text-sm text-gray-400">
    &copy; {year} Shop. Powered by Ikabud CMS.
</footer>
</body>
</html>
