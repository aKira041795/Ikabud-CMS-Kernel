<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title} — Store Portal</title>
    <!-- Rollback: replace the compiled stylesheet below with the previous Tailwind runtime script. -->
    <link rel="stylesheet" href="/assets/tailwind/app.css">
    <style>
        body { color:#0f172a; -webkit-font-smoothing:antialiased; }
    </style>
    {block head}{/block}
</head>
<body class="min-h-screen bg-[radial-gradient(circle_at_top,_rgba(251,146,60,0.16),_transparent_38%),linear-gradient(180deg,#fff7ed_0%,#ffffff_34%,#f8fafc_100%)]">
    <header class="border-b border-orange-100/80 bg-white/80 backdrop-blur">
        <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-6">
            <div>
                <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-orange-500">Store Portal</p>
                <h1 class="text-lg font-semibold text-slate-900">{page_title}</h1>
            </div>
            <div class="flex items-center gap-4 text-sm">
                <a href="{base_url}/ecommerce/shop" class="font-medium text-slate-500 transition-colors hover:text-slate-900">View Shop</a>
                <div class="h-4 w-px bg-slate-200"></div>
                <span class="font-medium text-slate-600">{user.display_name | default:'User'}</span>
            </div>
        </div>
    </header>

    <main class="mx-auto w-full max-w-6xl px-6 py-10">
        {block content}{/block}
    </main>

    {block scripts}{/block}
</body>
</html>