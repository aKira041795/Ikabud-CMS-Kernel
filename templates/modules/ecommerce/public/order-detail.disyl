{extends "modules/ecommerce/layouts/public.disyl"}

{block content}
<div class="max-w-5xl mx-auto space-y-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
        <div>
            <div class="text-sm text-gray-500 mb-1">Order Details</div>
            <h1 class="text-2xl font-bold text-gray-900">#{order.order_number}</h1>
            <p class="text-sm text-gray-500 mt-2">Placed on {order.created_at | date:'M j, Y g:i A'}</p>
        </div>
        <div class="flex flex-col items-start md:items-end gap-2">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold
                {if order.status == 'pending'}bg-amber-50 text-amber-700
                {elseif order.status == 'processing'}bg-blue-50 text-blue-700
                {elseif order.status == 'shipped'}bg-indigo-50 text-indigo-700
                {elseif order.status == 'delivered' || order.status == 'completed'}bg-emerald-50 text-emerald-700
                {elseif order.status == 'cancelled'}bg-gray-100 text-gray-600
                {else}bg-gray-100 text-gray-600{/if}">{order.status}</span>
            <div class="text-right">
                <div class="text-xs uppercase tracking-wide text-gray-400">Total</div>
                <div class="text-xl font-bold text-gray-900">{order.currency_symbol | default:ec_settings.currency_symbol}{order.total_amount}</div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <div class="xl:col-span-2 space-y-6">
            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <h2 class="font-semibold text-gray-900 mb-4">Order Progress</h2>
                <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
                    {foreach ['pending', 'processing', 'shipped', 'delivered'] as stage}
                    <div class="rounded-xl border px-3 py-3 text-sm
                        {if order.status == stage || (stage == 'pending' && (order.status == 'processing' || order.status == 'shipped' || order.status == 'delivered')) || (stage == 'processing' && (order.status == 'shipped' || order.status == 'delivered')) || (stage == 'shipped' && order.status == 'delivered')}
                        border-orange-200 bg-orange-50 text-orange-700
                        {else}
                        border-gray-200 bg-gray-50 text-gray-500
                        {/if}">
                        <div class="font-semibold capitalize">{stage}</div>
                    </div>
                    {/foreach}
                </div>

                <div class="mt-5 space-y-3">
                    {foreach order.status_history as entry}
                    <div class="flex gap-3">
                        <div class="mt-1 h-2.5 w-2.5 rounded-full bg-orange-500 flex-shrink-0"></div>
                        <div>
                            <div class="text-sm font-medium text-gray-900 capitalize">{entry.status}</div>
                            <div class="text-xs text-gray-500">{entry.created_at | date:'M j, Y g:i A'}{if entry.source} • {entry.source | replace:'_':' '}{/if}</div>
                            {if entry.note}<div class="mt-1 text-sm text-gray-600">{entry.note}</div>{/if}
                        </div>
                    </div>
                    {/foreach}
                </div>
            </div>

            <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
                <div class="px-5 py-4 border-b border-gray-200">
                    <h2 class="font-semibold text-gray-900">Items</h2>
                </div>
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 border-b border-gray-200 text-xs uppercase tracking-wide text-gray-500">
                        <tr>
                            <th class="px-5 py-3 text-left">Product</th>
                            <th class="px-5 py-3 text-right">Unit</th>
                            <th class="px-5 py-3 text-center">Qty</th>
                            <th class="px-5 py-3 text-right">Line Total</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {foreach order.items as item}
                        <tr>
                            <td class="px-5 py-4">
                                <div class="font-medium text-gray-900">{item.product_title}</div>
                                {if item.variant_label}<div class="text-xs text-gray-500 mt-1">{item.variant_label}</div>{/if}
                                {if item.sku}<div class="text-xs text-gray-400 mt-1">SKU: {item.sku}</div>{/if}
                                {if item.license_key}
                                <div class="mt-2 w-full max-w-full rounded bg-blue-50 px-2 py-2 text-xs text-blue-700">
                                    <div class="font-semibold uppercase tracking-wide text-[10px] text-blue-800">Key</div>
                                    <code class="mt-1 block w-full max-w-full whitespace-normal break-all font-mono text-[11px] text-blue-900">{item.license_key}</code>
                                </div>
                                {/if}
                            </td>
                            <td class="px-5 py-4 text-right text-gray-700">{order.currency_symbol | default:ec_settings.currency_symbol}{item.unit_price}</td>
                            <td class="px-5 py-4 text-center text-gray-600">{item.qty}</td>
                            <td class="px-5 py-4 text-right font-semibold text-gray-900">{order.currency_symbol | default:ec_settings.currency_symbol}{item.line_total}</td>
                        </tr>
                        {/foreach}
                    </tbody>
                    <tfoot class="bg-gray-50 border-t border-gray-200">
                        <tr>
                            <td colspan="3" class="px-5 py-2 text-sm text-gray-600">Subtotal</td>
                            <td class="px-5 py-2 text-sm text-right text-gray-700">{order.currency_symbol | default:ec_settings.currency_symbol}{order.subtotal_amount | default:order.subtotal}</td>
                        </tr>
                        {if order.discount_amount > 0}
                        <tr>
                            <td colspan="3" class="px-5 py-2 text-sm text-emerald-700">Discount</td>
                            <td class="px-5 py-2 text-sm text-right text-emerald-700">−{order.currency_symbol | default:ec_settings.currency_symbol}{order.discount_amount}</td>
                        </tr>
                        {/if}
                        {if order.tax_amount > 0}
                        <tr>
                            <td colspan="3" class="px-5 py-2 text-sm text-gray-600">Tax</td>
                            <td class="px-5 py-2 text-sm text-right text-gray-700">{order.currency_symbol | default:ec_settings.currency_symbol}{order.tax_amount}</td>
                        </tr>
                        {/if}
                        {if order.shipping_amount > 0}
                        <tr>
                            <td colspan="3" class="px-5 py-2 text-sm text-gray-600">Shipping</td>
                            <td class="px-5 py-2 text-sm text-right text-gray-700">{order.currency_symbol | default:ec_settings.currency_symbol}{order.shipping_amount}</td>
                        </tr>
                        {/if}
                        <tr>
                            <td colspan="3" class="px-5 py-3 font-bold text-gray-900">Total</td>
                            <td class="px-5 py-3 text-right font-bold text-gray-900">{order.currency_symbol | default:ec_settings.currency_symbol}{order.total_amount}</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            {if order.customer_note}
            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <h2 class="font-semibold text-gray-900 mb-2">Customer Note</h2>
                <p class="text-sm text-gray-600 whitespace-pre-line">{order.customer_note}</p>
            </div>
            {/if}

            {if order.licenses | count > 0}
            <div class="bg-white rounded-xl border border-orange-200 overflow-hidden">
                <div class="px-5 py-4 border-b border-orange-200 bg-orange-50 flex items-center gap-2">
                    <svg class="w-5 h-5 text-orange-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                    <h2 class="font-semibold text-orange-800">Digital Licenses</h2>
                </div>
                <div class="divide-y divide-gray-100">
                    {foreach order.licenses as lic}
                    <div class="p-5 space-y-3">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-orange-100 text-orange-800">{lic.target_module}</span>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-700">{lic.target_tier | ucfirst}</span>
                            {if lic.status == 'active'}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">Active</span>
                            {else}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-500">{lic.status}</span>
                            {/if}
                        </div>
                        <div>
                            <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">License Key (JWT)</div>
                            <code class="block w-full text-xs bg-gray-50 border border-gray-200 rounded px-3 py-2 break-all text-gray-700 select-all">{lic.license_key}</code>
                        </div>
                        {if lic.download_token}
                        <div class="flex items-center gap-3">
                            <a href="{base_url}/ecommerce/download/{lic.download_token}"
                               class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-orange-600 hover:bg-orange-700 text-white text-sm font-medium">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                                Download License File
                            </a>
                            {if lic.downloaded_at}
                            <span class="text-xs text-gray-400">First downloaded {lic.downloaded_at | date:'M j, Y'}</span>
                            {/if}
                        </div>
                        {/if}
                    </div>
                    {/foreach}
                </div>
            </div>
            {/if}
        </div>

        <div class="space-y-6">
            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <h2 class="font-semibold text-gray-900 mb-3">Shipping Address</h2>
                <div class="text-sm text-gray-700 space-y-1">
                    <div class="font-medium text-gray-900">{order.shipping.first_name} {order.shipping.last_name}</div>
                    <div>{order.shipping.address_line1}</div>
                    {if order.shipping.address_line2}<div>{order.shipping.address_line2}</div>{/if}
                    <div>{order.shipping.city}{if order.shipping.state}, {order.shipping.state}{/if} {order.shipping.postal_code}</div>
                    {if order.shipping.country}<div>{order.shipping.country}</div>{/if}
                    {if order.shipping.phone}<div>{order.shipping.phone}</div>{/if}
                </div>
            </div>

            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <h2 class="font-semibold text-gray-900 mb-3">Billing Address</h2>
                <div class="text-sm text-gray-700 space-y-1">
                    <div class="font-medium text-gray-900">{order.billing.first_name} {order.billing.last_name}</div>
                    {if order.billing.email}<div>{order.billing.email}</div>{/if}
                    <div>{order.billing.address_line1}</div>
                    {if order.billing.address_line2}<div>{order.billing.address_line2}</div>{/if}
                    <div>{order.billing.city}{if order.billing.state}, {order.billing.state}{/if} {order.billing.postal_code}</div>
                    {if order.billing.country}<div>{order.billing.country}</div>{/if}
                    {if order.billing.phone}<div>{order.billing.phone}</div>{/if}
                </div>
            </div>

            <div class="bg-white rounded-xl border border-gray-200 p-5 text-sm text-gray-700">
                <div class="flex justify-between py-1"><span>Payment Status</span><span class="font-semibold">{order.payment_status}</span></div>
                <div class="flex justify-between py-1"><span>Order Status</span><span class="font-semibold">{order.status}</span></div>
                {if order.payment}<div class="flex justify-between py-1"><span>Payment Method</span><span class="font-semibold">{order.payment.gateway}</span></div>{/if}
            </div>
        </div>
    </div>

    <div>
        <a href="{base_url}/ecommerce/my-orders" class="inline-flex items-center px-5 py-2.5 rounded-lg border border-gray-300 text-sm font-medium text-gray-700 hover:bg-gray-50">← Back to My Orders</a>
    </div>
</div>
{/block}