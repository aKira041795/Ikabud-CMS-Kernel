{extends "modules/ecommerce/layouts/public.disyl"}

{block content}
<div class="max-w-5xl mx-auto space-y-6">
    {if message}
    <div class="rounded-xl border px-4 py-3 text-sm {if message.type == 'success'}border-emerald-200 bg-emerald-50 text-emerald-800{else}border-red-200 bg-red-50 text-red-700{/if}">{message.text}</div>
    {/if}

    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
        <div>
            <div class="text-sm text-gray-500 mb-1">Order Details</div>
            <h1 class="text-2xl font-bold text-gray-900">#{order.order_number}</h1>
            <p class="text-sm text-gray-500 mt-2">Placed on {order.created_at | date:'M j, Y g:i A'}</p>
        </div>
        <div class="flex flex-col items-start md:items-end gap-2">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold
                {if order.status == 'pending'}bg-amber-50 text-amber-700
                {elseif order.status == 'processing'}bg-blue-50 text-blue-700
                {elseif order.status == 'shipped'}bg-indigo-50 text-indigo-700
                {elseif order.status == 'delivered' || order.status == 'completed'}bg-emerald-50 text-emerald-700
                {elseif order.status == 'cancelled'}bg-gray-100 text-gray-600
                {else}bg-gray-100 text-gray-600{/if}">{order.status}</span>
            <div class="text-right">
                <div class="text-xs uppercase tracking-wide text-gray-400">Total</div>
                <div class="text-xl font-bold text-gray-900">{order.currency_symbol | default:ec_settings.currency_symbol}{order.total_amount}</div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <div class="xl:col-span-2 space-y-6">
            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <h2 class="font-semibold text-gray-900 mb-4">Order Progress</h2>
                <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
                    {foreach ['pending', 'processing', 'shipped', 'delivered'] as stage}
                    <div class="rounded-xl border px-3 py-3 text-sm
                        {if order.status == stage || (stage == 'pending' && (order.status == 'processing' || order.status == 'shipped' || order.status == 'delivered')) || (stage == 'processing' && (order.status == 'shipped' || order.status == 'delivered')) || (stage == 'shipped' && order.status == 'delivered')}
                        border-orange-200 bg-orange-50 text-orange-700
                        {else}
                        border-gray-200 bg-gray-50 text-gray-500
                        {/if}">
                        <div class="font-semibold capitalize">{stage}</div>
                    </div>
                    {/foreach}
                </div>

                <div class="mt-5 space-y-3">
                    {foreach order.status_history as entry}
                    <div class="flex gap-3">
                        <div class="mt-1 h-2.5 w-2.5 rounded-full bg-orange-500 flex-shrink-0"></div>
                        <div>
                            <div class="text-sm font-medium text-gray-900 capitalize">{entry.status}</div>
                            <div class="text-xs text-gray-500">{entry.created_at | date:'M j, Y g:i A'}{if entry.source} • {entry.source | replace:'_':' '}{/if}</div>
                            {if entry.note}<div class="mt-1 text-sm text-gray-600">{entry.note}</div>{/if}
                        </div>
                    </div>
                    {/foreach}
                </div>

                {if order.refund_summary.has_refunds}
                <div class="mt-5 rounded-xl border border-red-100 bg-red-50 p-4 text-sm text-red-700">
                    <div class="font-semibold">Refunded: {order.refund_summary.total_refunded_amount_fmt}</div>
                    <div class="mt-1">{order.refund_summary.refund_count} refund {if order.refund_summary.refund_count == 1}record{else}records{/if} on this order.</div>
                </div>
                {/if}

                {if order.shipment_tracking.has_tracking}
                <div class="mt-5 rounded-xl border border-blue-100 bg-blue-50 p-4 text-sm text-blue-800">
                    <div class="font-semibold">Shipment Tracking</div>
                    {if order.shipment_tracking.carrier}<div class="mt-1">Carrier: {order.shipment_tracking.carrier}</div>{/if}
                    {if order.shipment_tracking.tracking_number}<div class="mt-1">Tracking Number: {order.shipment_tracking.tracking_number}</div>{/if}
                    {if order.shipment_tracking.tracking_url}<div class="mt-2"><a href="{order.shipment_tracking.tracking_url}" target="_blank" rel="noopener" class="font-semibold text-blue-700 hover:underline">Track Shipment</a></div>{/if}
                </div>
                {/if}
            </div>

            <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
                <div class="px-5 py-4 border-b border-gray-200">
                    <h2 class="font-semibold text-gray-900">Items</h2>
                </div>
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 border-b border-gray-200 text-xs uppercase tracking-wide text-gray-500">
                        <tr>
                            <th class="px-5 py-3 text-left">Product</th>
                            <th class="px-5 py-3 text-right">Unit</th>
                            <th class="px-5 py-3 text-center">Qty</th>
                            <th class="px-5 py-3 text-right">Line Total</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {foreach order.items as item}
                        <tr>
                            <td class="px-5 py-4">
                                <div class="font-medium text-gray-900">{item.product_title}</div>
                                {if item.variant_label}<div class="text-xs text-gray-500 mt-1">{item.variant_label}</div>{/if}
                                {if item.sku}<div class="text-xs text-gray-400 mt-1">SKU: {item.sku}</div>{/if}
                                {if item.selected_addons | count > 0}
                                <div class="mt-2 text-xs text-gray-500">Add-ons: {foreach item.selected_addons as addon}{addon.label}{if !loop.last}, {/if}{/foreach}</div>
                                {/if}
                                {if item.booking.has_booking}
                                <div class="mt-2 text-xs text-sky-700">Appointment: {item.booking.scheduled_date} at {item.booking.scheduled_time}</div>
                                {/if}
                                {if item.memberships | count > 0}
                                <div class="mt-2 text-xs text-sky-700">Membership: {foreach item.memberships as membership}{membership.tier_label}{if !loop.last}, {/if}{/foreach}</div>
                                {/if}
                                {if item.license_key}
                                <div class="mt-2 w-full max-w-full rounded bg-blue-50 px-2 py-2 text-xs text-blue-700">
                                    <div class="font-semibold uppercase tracking-wide text-[10px] text-blue-800">Key</div>
                                    <code class="mt-1 block w-full max-w-full whitespace-normal break-all font-mono text-[11px] text-blue-900">{item.license_key}</code>
                                </div>
                                {/if}
                            </td>
                            <td class="px-5 py-4 text-right text-gray-700">{order.currency_symbol | default:ec_settings.currency_symbol}{item.unit_price}</td>
                            <td class="px-5 py-4 text-center text-gray-600">{item.qty}</td>
                            <td class="px-5 py-4 text-right font-semibold text-gray-900">{order.currency_symbol | default:ec_settings.currency_symbol}{item.line_total}</td>
                        </tr>
                        {/foreach}
                    </tbody>
                    <tfoot class="bg-gray-50 border-t border-gray-200">
                        <tr>
                            <td colspan="3" class="px-5 py-2 text-sm text-gray-600">Subtotal</td>
                            <td class="px-5 py-2 text-sm text-right text-gray-700">{order.subtotal_amount_fmt}</td>
                        </tr>
                        {if order.non_loyalty_discount_amount > 0}
                        <tr>
                            <td colspan="3" class="px-5 py-2 text-sm text-emerald-700">Discount</td>
                            <td class="px-5 py-2 text-sm text-right text-emerald-700">−{order.non_loyalty_discount_amount_fmt}</td>
                        </tr>
                        {/if}
                        {if order.loyalty_points_redeemed > 0}
                        <tr>
                            <td colspan="3" class="px-5 py-2 text-sm text-orange-700">Loyalty ({order.loyalty_points_redeemed} pts)</td>
                            <td class="px-5 py-2 text-sm text-right text-orange-700">−{order.loyalty_discount_amount_fmt}</td>
                        </tr>
                        {/if}
                        {if order.tax_amount > 0}
                        <tr>
                            <td colspan="3" class="px-5 py-2 text-sm text-gray-600">Tax</td>
                            <td class="px-5 py-2 text-sm text-right text-gray-700">{order.tax_amount_fmt}</td>
                        </tr>
                        {/if}
                        {if order.shipping_amount > 0}
                        <tr>
                            <td colspan="3" class="px-5 py-2 text-sm text-gray-600">Shipping</td>
                            <td class="px-5 py-2 text-sm text-right text-gray-700">{order.shipping_amount_fmt}</td>
                        </tr>
                        {/if}
                        {if order.refund_summary.has_refunds}
                        <tr>
                            <td colspan="3" class="px-5 py-2 text-sm text-red-700">Refunded</td>
                            <td class="px-5 py-2 text-sm text-right text-red-700">−{order.refund_summary.total_refunded_amount_fmt}</td>
                        </tr>
                        {/if}
                        <tr>
                            <td colspan="3" class="px-5 py-3 font-bold text-gray-900">Total</td>
                            <td class="px-5 py-3 text-right font-bold text-gray-900">{order.total_amount_fmt}</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            {if order.memberships | count > 0 || order.bookings | count > 0}
            <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
                {if order.memberships | count > 0}
                <div class="bg-white rounded-xl border border-gray-200 p-5">
                    <h2 class="font-semibold text-gray-900 mb-3">Membership Activations</h2>
                    <div class="space-y-3">
                        {foreach order.memberships as membership}
                        <div class="rounded-xl border border-sky-100 bg-sky-50 p-4 text-sm text-sky-900">
                            <div class="font-semibold">{membership.tier_label}</div>
                            <div class="mt-1">Status: {membership.status}</div>
                            {if membership.starts_at}<div class="mt-1 text-xs text-sky-700">Starts {membership.starts_at | date:'M j, Y g:i A'}</div>{/if}
                            {if membership.ends_at}<div class="mt-1 text-xs text-sky-700">Ends {membership.ends_at | date:'M j, Y g:i A'}</div>{/if}
                        </div>
                        {/foreach}
                    </div>
                </div>
                {/if}

                {if order.bookings | count > 0}
                <div class="bg-white rounded-xl border border-gray-200 p-5">
                    <h2 class="font-semibold text-gray-900 mb-3">Booked Appointments</h2>
                    <div class="space-y-3">
                        {foreach order.bookings as booking}
                        <div class="rounded-xl border border-indigo-100 bg-indigo-50 p-4 text-sm text-indigo-900">
                            <div class="font-semibold">{booking.product_title}</div>
                            <div class="mt-1">{booking.scheduled_for | date:'M j, Y g:i A'}</div>
                            <div class="mt-1 text-xs text-indigo-700">Status: {booking.status}</div>
                            {if booking.notes}<div class="mt-2 text-xs text-indigo-700">Notes: {booking.notes}</div>{/if}
                        </div>
                        {/foreach}
                    </div>
                </div>
                {/if}
            </div>
            {/if}

            {if order.refunds | count > 0}
            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <h2 class="font-semibold text-gray-900 mb-3">Refund Activity</h2>
                <div class="space-y-3">
                    {foreach order.refunds as refund}
                    <div class="rounded-xl border border-gray-100 bg-gray-50 p-4 text-sm">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <div class="font-semibold text-gray-900">{refund.refund_number}</div>
                                <div class="mt-1 text-xs text-gray-500">{refund.created_at}</div>
                            </div>
                            <div class="font-semibold text-red-600">−{order.currency_symbol | default:ec_settings.currency_symbol}{refund.refunded_amount}</div>
                        </div>
                        {if refund.reason}<p class="mt-2 text-gray-700">{refund.reason}</p>{/if}
                        {if refund.items | count > 0}
                        <div class="mt-3 space-y-1 text-xs text-gray-500">
                            {foreach refund.items as item}
                            <div>{item.product_title} × {item.qty_refunded}{if item.restock_qty > 0} · Restocked{/if}</div>
                            {/foreach}
                        </div>
                        {/if}
                    </div>
                    {/foreach}
                </div>
            </div>
            {/if}

            <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
                <div class="flex items-center justify-between gap-3">
                    <div>
                        <h2 class="font-semibold text-gray-900">Returns</h2>
                        <p class="mt-1 text-sm text-gray-500">Track return requests for this order and submit a new request when delivered items are still eligible.</p>
                    </div>
                    {if order.return_summary.pending_count > 0}
                    <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800">{order.return_summary.pending_count} pending</span>
                    {/if}
                </div>

                {if order.return_requests | count > 0}
                <div class="space-y-3">
                    {foreach order.return_requests as request}
                    <div class="rounded-xl border border-gray-100 bg-gray-50 p-4 text-sm">
                        <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
                            <div>
                                <div class="font-semibold text-gray-900">{request.request_number}</div>
                                <div class="mt-1 text-xs text-gray-500">Submitted {request.created_at | date:'M j, Y g:i A'}</div>
                            </div>
                            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold {if request.status == 'pending'}bg-amber-100 text-amber-800{elseif request.status == 'approved'}bg-emerald-100 text-emerald-800{elseif request.status == 'rejected'}bg-red-100 text-red-700{else}bg-gray-100 text-gray-600{/if}">{request.status}</span>
                        </div>
                        <div class="mt-3 text-gray-700">{request.reason}</div>
                        <div class="mt-2 text-xs text-gray-500">Condition: {request.condition_label}</div>
                        {if request.customer_note}<div class="mt-2 text-sm text-gray-600">Customer note: {request.customer_note}</div>{/if}
                        {if request.admin_note}<div class="mt-2 text-sm text-gray-600">Admin note: {request.admin_note}</div>{/if}
                        {if request.wms_reference_number}<div class="mt-2 text-xs font-semibold text-sky-700">Warehouse reference: {request.wms_reference_number}</div>{/if}
                        {if request.wms_sync_error}<div class="mt-2 text-xs text-red-600">Warehouse sync: {request.wms_sync_error}</div>{/if}
                        <div class="mt-3 space-y-1 text-xs text-gray-500">
                            {foreach request.items as item}
                            <div>{item.product_title} × {item.qty_requested}</div>
                            {/foreach}
                        </div>
                    </div>
                    {/foreach}
                </div>
                {/if}

                {if order.return_summary.can_request}
                <form method="post" action="" class="space-y-4 rounded-xl border border-gray-200 bg-gray-50 p-4">
                    <input type="hidden" name="_token" value="{csrf_token}">
                    <input type="hidden" name="action" value="request_return">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-gray-500 mb-2">Reason</label>
                        <textarea name="return_reason" rows="3" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-800" placeholder="Describe why you need to return these items."></textarea>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-gray-500 mb-2">Condition</label>
                        <select name="return_condition" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-800">
                            <option value="unknown">Unknown</option>
                            <option value="good">Good</option>
                            <option value="damaged">Damaged</option>
                            <option value="expired">Expired</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-gray-500 mb-2">Item Quantities</label>
                        <div class="space-y-3">
                            {foreach order.items as item}
                            {if item.returnable_qty > 0}
                            <label class="flex items-center justify-between gap-4 rounded-lg border border-gray-200 bg-white px-3 py-3 text-sm">
                                <span class="min-w-0">
                                    <span class="block font-medium text-gray-900">{item.product_title}</span>
                                    <span class="block text-xs text-gray-400">Eligible to return: {item.returnable_qty}</span>
                                </span>
                                <input type="number" name="return_qty[{item.id}]" min="0" max="{item.returnable_qty}" value="0" class="w-20 rounded-lg border border-gray-300 px-2 py-1.5 text-right text-sm text-gray-800">
                            </label>
                            {/if}
                            {/foreach}
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-[0.14em] text-gray-500 mb-2">Additional Note</label>
                        <textarea name="return_note" rows="2" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-800" placeholder="Optional details for the support team."></textarea>
                    </div>
                    <button type="submit" class="inline-flex items-center rounded-lg bg-sky-700 px-4 py-2 text-sm font-semibold text-white hover:bg-sky-800">Request Return</button>
                </form>
                {elseif not order.has_return_requests}
                <div class="rounded-xl border border-dashed border-gray-200 px-4 py-4 text-sm text-gray-500">This order no longer has any quantities eligible for a new return request.</div>
                {/if}
            </div>

            {if message_threads | count > 0}
            <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
                <div>
                    <h2 class="font-semibold text-gray-900">Store Messages</h2>
                    <p class="mt-1 text-sm text-gray-500">Contact the store teams handling items in this order.</p>
                </div>

                <div class="space-y-4">
                    {foreach message_threads as thread}
                    <div class="rounded-xl border border-gray-200 overflow-hidden">
                        <div class="border-b border-gray-200 bg-gray-50 px-4 py-3">
                            <div class="font-semibold text-gray-900">{thread.store.name | escape}</div>
                            <div class="text-xs text-gray-500">Store support thread</div>
                        </div>
                        <div class="space-y-3 px-4 py-4">
                            {if thread.messages | count > 0}
                            {foreach thread.messages as thread_message}
                            <div class="rounded-xl px-4 py-3 text-sm {if thread_message.sender_type == 'store'}bg-orange-50 text-orange-900 border border-orange-100{else}bg-gray-50 text-gray-800 border border-gray-200{/if}">
                                <div class="flex items-center justify-between gap-3">
                                    <div class="font-semibold">{thread_message.sender_name | escape}</div>
                                    <div class="text-xs text-gray-500">{thread_message.created_at | date:'M j, Y g:i A'}</div>
                                </div>
                                <div class="mt-2 whitespace-pre-line">{thread_message.body | escape}</div>
                            </div>
                            {/foreach}
                            {else}
                            <div class="rounded-xl border border-dashed border-gray-200 px-4 py-4 text-sm text-gray-500">No messages yet. Send the first update to this store.</div>
                            {/if}
                        </div>
                        <form method="post" action="" class="border-t border-gray-200 bg-white px-4 py-4 space-y-3">
                            <input type="hidden" name="_token" value="{csrf_token}">
                            <input type="hidden" name="action" value="send_message">
                            <input type="hidden" name="store_id" value="{thread.store.id}">
                            <textarea name="message_body" rows="3" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-800" placeholder="Ask about packing, delivery timing, stock, or item-specific issues."></textarea>
                            <button type="submit" class="inline-flex items-center rounded-lg bg-orange-600 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-700">Send Message</button>
                        </form>
                    </div>
                    {/foreach}
                </div>
            </div>
            {/if}

            {if order.customer_note}
            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <h2 class="font-semibold text-gray-900 mb-2">Customer Note</h2>
                <p class="text-sm text-gray-600 whitespace-pre-line">{order.customer_note}</p>
            </div>
            {/if}

            {if order.licenses | count > 0}
            <div class="bg-white rounded-xl border border-orange-200 overflow-hidden">
                <div class="px-5 py-4 border-b border-orange-200 bg-orange-50 flex items-center gap-2">
                    <svg class="w-5 h-5 text-orange-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                    <h2 class="font-semibold text-orange-800">Digital Licenses</h2>
                </div>
                <div class="divide-y divide-gray-100">
                    {foreach order.licenses as lic}
                    <div class="p-5 space-y-3">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-orange-100 text-orange-800">{lic.target_module}</span>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-700">{lic.target_tier | ucfirst}</span>
                            {if lic.status == 'active'}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">Active</span>
                            {else}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-500">{lic.status}</span>
                            {/if}
                        </div>
                        <div>
                            <div class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">License Key (JWT)</div>
                            <code class="block w-full text-xs bg-gray-50 border border-gray-200 rounded px-3 py-2 break-all text-gray-700 select-all">{lic.license_key}</code>
                        </div>
                        {if lic.download_token}
                        <div class="flex items-center gap-3">
                            <a href="{base_url}/ecommerce/download/{lic.download_token}"
                               class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-orange-600 hover:bg-orange-700 text-white text-sm font-medium">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                                Download License File
                            </a>
                            {if lic.downloaded_at}
                            <span class="text-xs text-gray-400">First downloaded {lic.downloaded_at | date:'M j, Y'}</span>
                            {/if}
                        </div>
                        {/if}
                    </div>
                    {/foreach}
                </div>
            </div>
            {/if}

            {if order.subscriptions | count > 0}
            <div class="bg-white rounded-xl border border-amber-200 overflow-hidden">
                <div class="px-5 py-4 border-b border-amber-200 bg-amber-50">
                    <h2 class="font-semibold text-amber-900">Subscriptions</h2>
                </div>
                <div class="divide-y divide-gray-100">
                    {foreach order.subscriptions as subscription}
                    <div class="p-5 space-y-2 text-sm text-gray-700">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="font-semibold text-gray-900">{subscription.product_title}</span>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">{subscription.status | replace:'_':' ' | title}</span>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-700">Every {subscription.interval_label}</span>
                        </div>
                        <div>{subscription.recurring_label}</div>
                        {if subscription.trial_label}<div class="text-amber-700">{subscription.trial_label}</div>{/if}
                        {if subscription.next_renewal_at}<div class="text-gray-500">Next renewal: {subscription.next_renewal_at | date:'M j, Y g:i A'}</div>{/if}
                        {if subscription.cancelled_at}<div class="text-red-600">Cancelled {subscription.cancelled_at | date:'M j, Y g:i A'}</div>{/if}
                    </div>
                    {/foreach}
                </div>
            </div>
            {/if}
        </div>

        <div class="space-y-6">
            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <h2 class="font-semibold text-gray-900 mb-3">Shipping Address</h2>
                <div class="text-sm text-gray-700 space-y-1">
                    <div class="font-medium text-gray-900">{order.shipping.first_name} {order.shipping.last_name}</div>
                    <div>{order.shipping.address_line1}</div>
                    {if order.shipping.address_line2}<div>{order.shipping.address_line2}</div>{/if}
                    <div>{order.shipping.city}{if order.shipping.state}, {order.shipping.state}{/if} {order.shipping.postal_code}</div>
                    {if order.shipping.country}<div>{order.shipping.country}</div>{/if}
                    {if order.shipping.phone}<div>{order.shipping.phone}</div>{/if}
                </div>
            </div>

            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <h2 class="font-semibold text-gray-900 mb-3">Billing Address</h2>
                <div class="text-sm text-gray-700 space-y-1">
                    <div class="font-medium text-gray-900">{order.billing.first_name} {order.billing.last_name}</div>
                    {if order.billing.email}<div>{order.billing.email}</div>{/if}
                    <div>{order.billing.address_line1}</div>
                    {if order.billing.address_line2}<div>{order.billing.address_line2}</div>{/if}
                    <div>{order.billing.city}{if order.billing.state}, {order.billing.state}{/if} {order.billing.postal_code}</div>
                    {if order.billing.country}<div>{order.billing.country}</div>{/if}
                    {if order.billing.phone}<div>{order.billing.phone}</div>{/if}
                </div>
            </div>

            <div class="bg-white rounded-xl border border-gray-200 p-5 text-sm text-gray-700">
                <div class="flex justify-between py-1"><span>Payment Status</span><span class="font-semibold">{order.payment_status}</span></div>
                <div class="flex justify-between py-1"><span>Order Status</span><span class="font-semibold">{order.status}</span></div>
                {if order.payment}<div class="flex justify-between py-1"><span>Payment Method</span><span class="font-semibold">{order.payment.gateway}</span></div>{/if}
                {if order.shipment_tracking.tracking_number}<div class="flex justify-between py-1"><span>Tracking Number</span><span class="font-semibold">{order.shipment_tracking.tracking_number}</span></div>{/if}
                {if order.refund_summary.has_refunds}<div class="flex justify-between py-1"><span>Refunded</span><span class="font-semibold text-red-600">{order.refund_summary.total_refunded_amount_fmt}</span></div>{/if}
            </div>
        </div>
    </div>

    <div>
        <a href="{base_url}/ecommerce/my-orders" class="inline-flex items-center px-5 py-2.5 rounded-lg border border-gray-300 text-sm font-medium text-gray-700 hover:bg-gray-50">← Back to My Orders</a>
    </div>
</div>
{/block}