{extends "modules/ecommerce/layouts/public.disyl"}

{block content}
<div
    class="max-w-5xl mx-auto"
    data-storefront-route-kind="{storefront.route.kind|default:public_route_kind|default:'product_detail'}"
    data-storefront-mode="{storefront.route.mode|default:public_presentation_mode|default:'traditional'}"
    data-storefront-page-kind="{storefront.page.kind|default:'detail'}"
    data-storefront-product-id="{storefront.product.id|default:product.id|default:''}"
>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <!-- Image -->
        <div>
            <div class="aspect-square rounded-xl overflow-hidden bg-gray-100">
                <img src="{if storefront.product.primary_image_url|default:product.primary_image_url}{storefront.product.primary_image_url|default:product.primary_image_url}{else}{base_url}/assets/ecommerce/product-placeholder.svg{/if}" alt="{storefront.product.title|default:product.title}" class="w-full h-full object-cover">
            </div>
            {if storefront.product.gallery_images | count > 0}
            <div class="mt-4 grid grid-cols-4 gap-3">
                {foreach storefront.product.gallery_images as image}
                <a href="{image.url}" class="block aspect-square overflow-hidden rounded-lg border border-gray-200 bg-gray-50" target="_blank" rel="noopener noreferrer">
                    <img src="{image.thumb}" alt="{if image.caption}{image.caption}{else}{storefront.product.title|default:product.title}{/if}" class="w-full h-full object-cover">
                </a>
                {/foreach}
            </div>
            {elseif product.gallery_images | count > 0}
            <div class="mt-4 grid grid-cols-4 gap-3">
                {foreach product.gallery_images as image}
                <a href="{image.url}" class="block aspect-square overflow-hidden rounded-lg border border-gray-200 bg-gray-50" target="_blank" rel="noopener noreferrer">
                    <img src="{image.thumb}" alt="{if image.caption}{image.caption}{else}{product.title}{/if}" class="w-full h-full object-cover">
                </a>
                {/foreach}
            </div>
            {/if}
        </div>

        <!-- Info -->
        <div>
            <nav class="text-xs text-gray-400 mb-3">
                <a href="{if storefront.navigation.shop_url}{storefront.navigation.shop_url}{else}{base_url}/ecommerce/shop{/if}" class="hover:text-gray-600">Shop</a>
                {if storefront.product.categories | count > 0}
                <span class="mx-1">›</span>
                <a href="{if storefront.product.categories.0.url}{storefront.product.categories.0.url}{else}{base_url}/ecommerce/shop/category/{storefront.product.categories.0.slug|default:product.categories.0.slug}{/if}" class="hover:text-gray-600">{storefront.product.categories.0.name|default:product.categories.0.name}</a>
                {elseif product.categories | count > 0}
                <span class="mx-1">›</span>
                <a href="{base_url}/ecommerce/shop/category/{product.categories.0.slug}" class="hover:text-gray-600">{product.categories.0.name}</a>
                {/if}
            </nav>

            <h1 class="text-2xl font-bold text-gray-900 mb-2">{storefront.page.title|default:storefront.product.title|default:product.title}</h1>
            {if storefront.product.review_summary.has_reviews|default:product.review_summary.has_reviews}
            <div class="mb-3 text-sm font-medium text-amber-700">{storefront.product.review_summary.average_rating_formatted|default:product.review_summary.average_rating_formatted}/5 · {storefront.product.review_summary.approved_count|default:product.review_summary.approved_count} {if storefront.product.review_summary.approved_count|default:product.review_summary.approved_count == 1}review{else}reviews{/if}</div>
            {/if}

            <!-- Price -->
            <div class="flex items-baseline gap-3 mb-4">
                {if storefront.product.pricing.on_sale|default:product.pricing.on_sale}
                <span class="text-3xl font-bold text-orange-600">{storefront.product.pricing.formatted|default:product.pricing.formatted}</span>
                <span class="text-lg text-gray-400 line-through">{storefront.product.pricing.regular_fmt|default:product.pricing.regular_fmt}</span>
                <span class="text-sm font-medium text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded">{storefront.product.badges.sale|default:'Sale'}</span>
                {else}
                <span class="text-3xl font-bold text-gray-900">{storefront.product.pricing.formatted|default:product.pricing.formatted|default:'Contact for price'}</span>
                {/if}
            </div>

            {if storefront.page.description|default:storefront.product.excerpt|default:product.excerpt}
            <p class="text-gray-600 mb-4">{storefront.page.description|default:storefront.product.excerpt|default:product.excerpt}</p>
            {/if}

            {if storefront.product.product_type == 'subscription'}
            <div class="mb-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
                <div class="font-semibold">Subscription product</div>
                <div class="mt-1">{storefront.product.subscription_summary.recurring_label}</div>
                {if storefront.product.subscription_summary.trial_label}
                <div class="mt-1 text-amber-800">{storefront.product.subscription_summary.trial_label}</div>
                {/if}
                <div class="mt-1 text-amber-800">Subscriptions must be purchased separately from one-time products.</div>
            </div>
            {elseif product.product_type == 'subscription'}
            <div class="mb-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
                <div class="font-semibold">Subscription product</div>
                <div class="mt-1">{product.subscription_summary.recurring_label}</div>
                {if product.subscription_summary.trial_label}
                <div class="mt-1 text-amber-800">{product.subscription_summary.trial_label}</div>
                {/if}
                <div class="mt-1 text-amber-800">Subscriptions must be purchased separately from one-time products.</div>
            </div>
            {/if}

            {if storefront.product.product_type == 'membership'}
            <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900">
                <div class="font-semibold">Membership product</div>
                <div class="mt-1">Activates the {storefront.product.membership_summary.tier_label | default:'member'} tier for {storefront.product.membership_summary.duration_label | default:'365 days access'} once the order is paid.</div>
            </div>
            {elseif product.product_type == 'membership'}
            <div class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-900">
                <div class="font-semibold">Membership product</div>
                <div class="mt-1">Activates the {product.membership_summary.tier_label | default:'member'} tier for {product.membership_summary.duration_label | default:'365 days access'} once the order is paid.</div>
            </div>
            {/if}

            {if storefront.product.membership_gate.requires_membership and !storefront.product.membership_gate.allowed}
            <div class="mb-4 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900">
                <div class="font-semibold">Members-only access</div>
                <div class="mt-1">{storefront.product.membership_gate.message}</div>
                <a href="{if storefront.product.membership_gate.login_required}{base_url}/cms/login?redirect=/ecommerce/shop/{product.slug | default:storefront.product.slug}{else}{base_url}/ecommerce/my-memberships{/if}" class="mt-3 inline-flex items-center rounded-lg bg-sky-700 px-4 py-2 text-xs font-semibold text-white hover:bg-sky-800">{if storefront.product.membership_gate.login_required}Sign In to Unlock{else}View My Memberships{/if}</a>
            </div>
            {elseif product.membership_gate.requires_membership and !product.membership_gate.allowed}
            <div class="mb-4 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900">
                <div class="font-semibold">Members-only access</div>
                <div class="mt-1">{product.membership_gate.message}</div>
                <a href="{if product.membership_gate.login_required}{base_url}/cms/login?redirect=/ecommerce/shop/{product.slug}{else}{base_url}/ecommerce/my-memberships{/if}" class="mt-3 inline-flex items-center rounded-lg bg-sky-700 px-4 py-2 text-xs font-semibold text-white hover:bg-sky-800">{if product.membership_gate.login_required}Sign In to Unlock{else}View My Memberships{/if}</a>
            </div>
            {/if}

            <!-- Stock -->
            {if storefront.product.id}
            {if storefront.product.bundle_children | count > 0}
            <div class="flex items-center gap-2 mb-4">
                <span class="inline-block w-2 h-2 rounded-full {if storefront.product.bundle_summary.all_in_stock}bg-emerald-400{else}bg-red-400{/if}"></span>
                <span class="text-sm {if storefront.product.bundle_summary.all_in_stock}text-emerald-700{else}text-red-600 font-medium{/if}">
                    {if storefront.product.bundle_summary.all_in_stock}
                    Bundle includes {storefront.product.bundle_summary.item_count} item{if storefront.product.bundle_summary.item_count == 1}{else}s{/if}
                    {else}
                    One or more bundle items are unavailable
                    {/if}
                </span>
            </div>
            {else}
            <div class="flex items-center gap-2 mb-4">
                <span class="inline-block w-2 h-2 rounded-full {if storefront.product.inventory.badge.tone == 'danger'}bg-red-400{elseif storefront.product.inventory.badge.tone == 'warning'}bg-amber-400{elseif storefront.product.inventory.badge.tone == 'success'}bg-emerald-400{else}bg-gray-400{/if}"></span>
                <span class="text-sm {if storefront.product.inventory.badge.tone == 'danger'}text-red-600 font-medium{elseif storefront.product.inventory.badge.tone == 'warning'}text-amber-700 font-medium{elseif storefront.product.inventory.badge.tone == 'success'}text-emerald-700{else}text-gray-500{/if}">{storefront.product.inventory.badge.label}</span>
            </div>
            {/if}
            {elseif product.bundle_children | count > 0}
            <div class="flex items-center gap-2 mb-4">
                <span class="inline-block w-2 h-2 rounded-full {if product.bundle_summary.all_in_stock}bg-emerald-400{else}bg-red-400{/if}"></span>
                <span class="text-sm {if product.bundle_summary.all_in_stock}text-emerald-700{else}text-red-600 font-medium{/if}">
                    {if product.bundle_summary.all_in_stock}
                    Bundle includes {product.bundle_summary.item_count} item{if product.bundle_summary.item_count == 1}{else}s{/if}
                    {else}
                    One or more bundle items are unavailable
                    {/if}
                </span>
            </div>
            {elseif product.inventory.track_stock}
            <div class="flex items-center gap-2 mb-4">
                {if product.inventory.in_stock}
                <span class="inline-block w-2 h-2 rounded-full {if product.inventory.low_stock}bg-amber-400{else}bg-emerald-400{/if}"></span>
                <span class="text-sm {if product.inventory.low_stock}text-amber-700 font-medium{else}text-emerald-700{/if}">
                    {if product.inventory.low_stock}
                    Low stock ({product.inventory.stock_qty} left)
                    {else}
                    In stock ({product.inventory.stock_qty} available)
                    {/if}
                </span>
                {elseif product.inventory.out_of_stock or not product.inventory.in_stock}
                <span class="inline-block w-2 h-2 rounded-full bg-red-400"></span>
                <span class="text-sm text-red-600 font-medium">Out of stock</span>
                {else}
                <span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span>
                <span class="text-sm text-emerald-700">In stock</span>
                {/if}
            </div>
            {/if}

            {if storefront.product.id && (!storefront.product.membership_gate.requires_membership || storefront.product.membership_gate.allowed) && !storefront.product.is_external_product && storefront.product.bundle_children | count == 0 && storefront.product.grouped_children | count == 0}
                {if storefront.product.addons | count > 0}
            <div class="mb-6 rounded-xl border border-gray-200 p-4">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-lg font-semibold text-gray-900">Add-ons</h2>
                    <span class="text-xs text-gray-500">Optional extras</span>
                </div>
                <div class="space-y-2">
                    {foreach storefront.product.addons as addon}
                    <label class="flex items-start gap-3 rounded-lg border border-gray-100 px-3 py-3 text-sm">
                        <input type="checkbox" value="{addon.id}" data-product-addon class="mt-0.5 rounded border-gray-300 text-orange-600">
                        <span class="flex-1">
                            <span class="block font-medium text-gray-900">{addon.label}</span>
                            {if addon.description}<span class="mt-1 block text-xs text-gray-500">{addon.description}</span>{/if}
                        </span>
                        <span class="font-semibold text-gray-900">+{storefront.product.pricing.currency_symbol | default:ec_settings.currency_symbol}{addon.price}</span>
                    </label>
                    {/foreach}
                </div>
            </div>
                {/if}
                {if storefront.product.booking.enabled}
            <div class="mb-6 rounded-xl border border-gray-200 p-4">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-lg font-semibold text-gray-900">Book Appointment</h2>
                    <span class="text-xs text-gray-500">{storefront.product.booking.summary}</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Date</label>
                        <input type="date" data-booking-date class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Time</label>
                        <select data-booking-time class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                            <option value="">Select a time</option>
                            {foreach storefront.product.booking.time_slots as slot}
                            <option value="{slot}">{slot}</option>
                            {/foreach}
                        </select>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Appointment Notes</label>
                        <textarea data-booking-notes rows="2" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none" placeholder="Share anything needed before the appointment."></textarea>
                    </div>
                </div>
            </div>
                {/if}
            {elseif product.id && (!product.membership_gate.requires_membership || product.membership_gate.allowed) && !product.is_external_product && product.bundle_children | count == 0 && product.grouped_children | count == 0}
                {if product.addons | count > 0}
            <div class="mb-6 rounded-xl border border-gray-200 p-4">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-lg font-semibold text-gray-900">Add-ons</h2>
                    <span class="text-xs text-gray-500">Optional extras</span>
                </div>
                <div class="space-y-2">
                    {foreach product.addons as addon}
                    <label class="flex items-start gap-3 rounded-lg border border-gray-100 px-3 py-3 text-sm">
                        <input type="checkbox" value="{addon.id}" data-product-addon class="mt-0.5 rounded border-gray-300 text-orange-600">
                        <span class="flex-1">
                            <span class="block font-medium text-gray-900">{addon.label}</span>
                            {if addon.description}<span class="mt-1 block text-xs text-gray-500">{addon.description}</span>{/if}
                        </span>
                        <span class="font-semibold text-gray-900">+{product.currency_symbol | default:ec_settings.currency_symbol}{addon.price}</span>
                    </label>
                    {/foreach}
                </div>
            </div>
                {/if}
                {if product.booking.enabled}
            <div class="mb-6 rounded-xl border border-gray-200 p-4">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-lg font-semibold text-gray-900">Book Appointment</h2>
                    <span class="text-xs text-gray-500">{product.booking.summary}</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Date</label>
                        <input type="date" data-booking-date class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Time</label>
                        <select data-booking-time class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                            <option value="">Select a time</option>
                            {foreach product.booking.time_slots as slot}
                            <option value="{slot}">{slot}</option>
                            {/foreach}
                        </select>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Appointment Notes</label>
                        <textarea data-booking-notes rows="2" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none" placeholder="Share anything needed before the appointment."></textarea>
                    </div>
                </div>
            </div>
                {/if}
            {/if}

            <!-- Add to cart -->
            {if storefront.product.id}
                {if storefront.product.is_external_product and storefront.product.external_product_url}
            <div class="mb-6 rounded-xl border border-sky-200 bg-sky-50 p-4">
                <div class="text-sm text-sky-900 mb-3">This product is purchased through an external checkout partner.</div>
                <a href="{storefront.product.external_product_url}" target="_blank" rel="noopener noreferrer sponsored"
                   class="inline-flex w-full items-center justify-center px-6 py-3 bg-sky-700 text-white font-medium rounded-lg hover:bg-sky-800">
                    {storefront.product.external_product_button_text | default:'Buy Externally'}
                </a>
            </div>
                {elseif storefront.product.bundle_children | count > 0}
            <div class="mb-6 rounded-xl border border-gray-200 p-4" id="bundle-products-form">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-lg font-semibold text-gray-900">Bundle Includes</h2>
                    <span class="text-xs text-gray-500">Fixed quantities</span>
                </div>
                <div class="space-y-3">
                    {foreach storefront.product.bundle_children as child}
                    <div class="flex items-center gap-3 rounded-lg border border-gray-100 px-3 py-3">
                        <img src="{if child.primary_image_url}{child.primary_image_url}{else}{base_url}/assets/ecommerce/product-placeholder.svg{/if}" alt="{child.title}" class="w-14 h-14 rounded-lg object-cover bg-gray-100">
                        <div class="flex-1 min-w-0">
                            <div class="font-medium text-gray-900">{child.title}</div>
                            <div class="text-sm text-gray-500">Qty {child.bundle_qty} · {child.pricing.formatted | default:'Contact for price'} · {child.inventory.badge.label}</div>
                        </div>
                    </div>
                    {/foreach}
                </div>
                <div class="mt-4 rounded-lg bg-gray-50 px-4 py-3 text-sm text-gray-600 space-y-1.5">
                    <div class="flex justify-between"><span>Included items</span><span>{storefront.product.bundle_summary.child_subtotal_fmt}</span></div>
                    <div class="flex justify-between font-semibold text-gray-900"><span>Bundle total</span><span>{storefront.product.bundle_summary.bundle_total_fmt | default:storefront.product.pricing.formatted}</span></div>
                    {if storefront.product.bundle_summary.has_savings}
                    <div class="flex justify-between text-emerald-600"><span>You save</span><span>{storefront.product.bundle_summary.savings_fmt}</span></div>
                    {/if}
                </div>
                <div class="mt-4 flex gap-3" id="bundle-add-to-cart-form">
                    <input type="number" value="1" min="1" class="w-20 border border-gray-300 rounded-lg px-3 py-2 text-sm text-center focus:border-orange-500 outline-none" data-bundle-qty-input>
                    {if storefront.product.bundle_summary.all_in_stock}
                    <button onclick="addBundleToCart({storefront.product.id|default:product.id}, event)"
                            class="flex-1 px-6 py-2 bg-orange-600 text-white font-medium rounded-lg hover:bg-orange-700">
                        Add Bundle to Cart
                    </button>
                    {else}
                    <button disabled class="flex-1 px-6 py-2 bg-gray-200 text-gray-400 font-medium rounded-lg cursor-not-allowed">
                        Bundle Unavailable
                    </button>
                    {/if}
                </div>
            </div>
                {elseif storefront.product.grouped_children | count > 0}
            <div class="mb-6 rounded-xl border border-gray-200 p-4" id="grouped-products-form">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-lg font-semibold text-gray-900">Grouped Products</h2>
                    <span class="text-xs text-gray-500">Adjust quantities before adding to cart</span>
                </div>
                <div class="space-y-3">
                    {foreach storefront.product.grouped_children as child}
                    <div class="flex items-center gap-3 rounded-lg border border-gray-100 px-3 py-3" data-grouped-child-row data-product-id="{child.id}">
                        <img src="{if child.primary_image_url}{child.primary_image_url}{else}{base_url}/assets/ecommerce/product-placeholder.svg{/if}" alt="{child.title}" class="w-14 h-14 rounded-lg object-cover bg-gray-100">
                        <div class="flex-1 min-w-0">
                            <div class="font-medium text-gray-900">{child.title}</div>
                            <div class="text-sm text-gray-500">{child.pricing.formatted | default:'Contact for price'} · {child.inventory.badge.label}</div>
                        </div>
                        <input type="number" value="{child.grouped_qty}" min="0" class="w-20 border border-gray-300 rounded-lg px-3 py-2 text-sm text-center focus:border-orange-500 outline-none" data-grouped-child-qty>
                    </div>
                    {/foreach}
                </div>
                <button onclick="addGroupedToCart({storefront.product.id|default:product.id}, event)"
                        class="w-full mt-4 px-6 py-3 bg-orange-600 text-white font-medium rounded-lg hover:bg-orange-700">
                    Add Selected Items to Cart
                </button>
            </div>
                {elseif storefront.product.membership_gate.requires_membership and !storefront.product.membership_gate.allowed}
            <button disabled class="w-full px-6 py-3 bg-gray-200 text-gray-400 font-medium rounded-lg cursor-not-allowed mb-6">Membership Required</button>
                {elseif storefront.product.inventory.in_stock}
                    {if storefront.product.inventory.out_of_stock}
            <button disabled class="w-full px-6 py-3 bg-gray-200 text-gray-400 font-medium rounded-lg cursor-not-allowed mb-6">Out of Stock</button>
                    {elseif storefront.product.product_type == 'subscription'}
            <button onclick="addToCart({storefront.product.id|default:product.id}, 1)"
                    class="w-full px-6 py-3 bg-amber-600 text-white font-medium rounded-lg hover:bg-amber-700 mb-6">
                Start Subscription
            </button>
                    {else}
            <div class="flex gap-3 mb-6" id="add-to-cart-form">
                <input type="number" id="qty-input" value="1" min="1"
                       {if storefront.product.inventory.track_stock}max="{storefront.product.inventory.stock_qty}"{/if}
                       class="w-20 border border-gray-300 rounded-lg px-3 py-2 text-sm text-center focus:border-orange-500 outline-none">
                <button onclick="addToCart({storefront.product.id|default:product.id}, document.getElementById('qty-input').value)"
                        class="flex-1 px-6 py-2 bg-orange-600 text-white font-medium rounded-lg hover:bg-orange-700">
                    Add to Cart
                </button>
            </div>
                    {/if}
                {else}
            <button disabled class="w-full px-6 py-3 bg-gray-200 text-gray-400 font-medium rounded-lg cursor-not-allowed mb-6">Out of Stock</button>
                {/if}
            {elseif product.is_external_product and product.external_product_url}
            <div class="mb-6 rounded-xl border border-sky-200 bg-sky-50 p-4">
                <div class="text-sm text-sky-900 mb-3">This product is purchased through an external checkout partner.</div>
                <a href="{product.external_product_url}" target="_blank" rel="noopener noreferrer sponsored"
                   class="inline-flex w-full items-center justify-center px-6 py-3 bg-sky-700 text-white font-medium rounded-lg hover:bg-sky-800">
                    {product.external_product_button_text | default:'Buy Externally'}
                </a>
            </div>
            {elseif product.bundle_children | count > 0}
            <div class="mb-6 rounded-xl border border-gray-200 p-4" id="bundle-products-form">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-lg font-semibold text-gray-900">Bundle Includes</h2>
                    <span class="text-xs text-gray-500">Fixed quantities</span>
                </div>
                <div class="space-y-3">
                    {foreach product.bundle_children as child}
                    <div class="flex items-center gap-3 rounded-lg border border-gray-100 px-3 py-3">
                        <img src="{if child.primary_image_url}{child.primary_image_url}{else}{base_url}/assets/ecommerce/product-placeholder.svg{/if}" alt="{child.title}" class="w-14 h-14 rounded-lg object-cover bg-gray-100">
                        <div class="flex-1 min-w-0">
                            <div class="font-medium text-gray-900">{child.title}</div>
                            <div class="text-sm text-gray-500">Qty {child.bundle_qty} · {child.pricing.formatted | default:'Contact for price'} · {if child.inventory.low_stock}Low stock{elseif child.inventory.in_stock}In stock{else}Out of stock{/if}</div>
                        </div>
                    </div>
                    {/foreach}
                </div>
                <div class="mt-4 rounded-lg bg-gray-50 px-4 py-3 text-sm text-gray-600 space-y-1.5">
                    <div class="flex justify-between"><span>Included items</span><span>{product.bundle_summary.child_subtotal_fmt}</span></div>
                    <div class="flex justify-between font-semibold text-gray-900"><span>Bundle total</span><span>{product.bundle_summary.bundle_total_fmt | default:product.pricing.formatted}</span></div>
                    {if product.bundle_summary.has_savings}
                    <div class="flex justify-between text-emerald-600"><span>You save</span><span>{product.bundle_summary.savings_fmt}</span></div>
                    {/if}
                </div>
                <div class="mt-4 flex gap-3" id="bundle-add-to-cart-form">
                    <input type="number" value="1" min="1" class="w-20 border border-gray-300 rounded-lg px-3 py-2 text-sm text-center focus:border-orange-500 outline-none" data-bundle-qty-input>
                    {if product.bundle_summary.all_in_stock}
                    <button onclick="addBundleToCart({product.id}, event)"
                            class="flex-1 px-6 py-2 bg-orange-600 text-white font-medium rounded-lg hover:bg-orange-700">
                        Add Bundle to Cart
                    </button>
                    {else}
                    <button disabled class="flex-1 px-6 py-2 bg-gray-200 text-gray-400 font-medium rounded-lg cursor-not-allowed">
                        Bundle Unavailable
                    </button>
                    {/if}
                </div>
            </div>
            {elseif product.grouped_children | count > 0}
            <div class="mb-6 rounded-xl border border-gray-200 p-4" id="grouped-products-form">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-lg font-semibold text-gray-900">Grouped Products</h2>
                    <span class="text-xs text-gray-500">Adjust quantities before adding to cart</span>
                </div>
                <div class="space-y-3">
                    {foreach product.grouped_children as child}
                    <div class="flex items-center gap-3 rounded-lg border border-gray-100 px-3 py-3" data-grouped-child-row data-product-id="{child.id}">
                        <img src="{if child.primary_image_url}{child.primary_image_url}{else}{base_url}/assets/ecommerce/product-placeholder.svg{/if}" alt="{child.title}" class="w-14 h-14 rounded-lg object-cover bg-gray-100">
                        <div class="flex-1 min-w-0">
                            <div class="font-medium text-gray-900">{child.title}</div>
                            <div class="text-sm text-gray-500">{child.pricing.formatted | default:'Contact for price'} · {if child.inventory.low_stock}Low stock{elseif child.inventory.in_stock}In stock{else}Out of stock{/if}</div>
                        </div>
                        <input type="number" value="{child.grouped_qty}" min="0" class="w-20 border border-gray-300 rounded-lg px-3 py-2 text-sm text-center focus:border-orange-500 outline-none" data-grouped-child-qty>
                    </div>
                    {/foreach}
                </div>
                <button onclick="addGroupedToCart({product.id}, event)"
                        class="w-full mt-4 px-6 py-3 bg-orange-600 text-white font-medium rounded-lg hover:bg-orange-700">
                    Add Selected Items to Cart
                </button>
            </div>
            {elseif product.membership_gate.requires_membership and !product.membership_gate.allowed}
            <button disabled class="w-full px-6 py-3 bg-gray-200 text-gray-400 font-medium rounded-lg cursor-not-allowed mb-6">Membership Required</button>
            {elseif product.inventory.in_stock}
                {if product.inventory.out_of_stock}
            <button disabled class="w-full px-6 py-3 bg-gray-200 text-gray-400 font-medium rounded-lg cursor-not-allowed mb-6">Out of Stock</button>
                {elseif product.product_type == 'subscription'}
            <button onclick="addToCart({product.id}, 1)"
                    class="w-full px-6 py-3 bg-amber-600 text-white font-medium rounded-lg hover:bg-amber-700 mb-6">
                Start Subscription
            </button>
                {else}
            <div class="flex gap-3 mb-6" id="add-to-cart-form">
                <input type="number" id="qty-input" value="1" min="1"
                       {if product.inventory.track_stock}max="{product.inventory.stock_qty}"{/if}
                       class="w-20 border border-gray-300 rounded-lg px-3 py-2 text-sm text-center focus:border-orange-500 outline-none">
                <button onclick="addToCart({product.id}, document.getElementById('qty-input').value)"
                        class="flex-1 px-6 py-2 bg-orange-600 text-white font-medium rounded-lg hover:bg-orange-700">
                    Add to Cart
                </button>
            </div>
                {/if}
            {else}
            <button disabled class="w-full px-6 py-3 bg-gray-200 text-gray-400 font-medium rounded-lg cursor-not-allowed mb-6">Out of Stock</button>
            {/if}

            <!-- Full description -->
            {if storefront.product.body|default:product.body}
            <div class="prose prose-sm text-gray-700 border-t border-gray-200 pt-4">
                {storefront.product.body|default:product.body | raw}
            </div>
            {/if}

            {include "modules/cms/public/blocks/ecommerce-product-wishlist.block.disyl"}
            {include "modules/cms/public/blocks/ecommerce-product-compare.block.disyl"}
        </div>
    </div>
    {include "modules/cms/public/blocks/ecommerce-product-relations.block.disyl"}
    {include "modules/cms/public/blocks/ecommerce-recently-viewed.block.disyl"}
    {if reviews_enabled}
    {include "modules/cms/public/blocks/ecommerce-reviews.block.disyl"}
    {/if}
</div>

<script>
const __ecCsrf = '{csrf_token}';
const __ecProductTitle = '{storefront.product.title|default:product.title}';
const __ecProductImage = '{storefront.product.primary_image_url|default:product.primary_image_url}';
const __ecProductPrice = '{storefront.product.pricing.formatted|default:product.pricing.formatted}';
const __ecBaseUrl = '{base_url}';
function updateCartBadge(count) {
    const badge = document.getElementById('cart-count-badge');
    if (!badge) {
        return;
    }

    const nextCount = Number(count || 0);
    if (nextCount > 0) {
        badge.textContent = String(nextCount);
        badge.classList.remove('hidden');
        badge.classList.add('inline-flex');
    } else {
        badge.textContent = '0';
        badge.classList.add('hidden');
        badge.classList.remove('inline-flex');
    }
}

function collectProductPurchaseOptions() {
    const addOns = Array.from(document.querySelectorAll('[data-product-addon]:checked')).map((input) => input.value);
    const bookingDate = document.querySelector('[data-booking-date]');
    const bookingTime = document.querySelector('[data-booking-time]');
    const bookingNotes = document.querySelector('[data-booking-notes]');

    return {
        add_ons: addOns,
        booking: {
            date: bookingDate ? bookingDate.value : '',
            time: bookingTime ? bookingTime.value : '',
            notes: bookingNotes ? bookingNotes.value : '',
        },
    };
}

async function addToCart(productId, qty) {
    const btn = event.target;
    btn.disabled = true;
    btn.textContent = 'Adding…';
    const options = collectProductPurchaseOptions();
    try {
        const res = await fetch('{base_url}/api/v1/ecommerce/cart/add', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-TOKEN': __ecCsrf},
            body: JSON.stringify({ product_id: productId, qty: parseInt(qty) || 1, add_ons: options.add_ons, booking: options.booking }),
        });
        const data = await res.json();
        if (data.ok) {
            showCartPanel(data);
            btn.textContent = 'Added!';
            btn.classList.remove('bg-orange-600', 'hover:bg-orange-700');
            btn.classList.add('bg-emerald-600');
            setTimeout(() => {
                btn.disabled = false;
                btn.textContent = 'Add to Cart';
                btn.classList.add('bg-orange-600', 'hover:bg-orange-700');
                btn.classList.remove('bg-emerald-600');
            }, 2000);
        } else {
            alert(data.error || 'Could not add to cart');
            btn.disabled = false;
            btn.textContent = 'Add to Cart';
        }
    } catch(e) {
        alert('Error. Please try again.');
        btn.disabled = false;
        btn.textContent = 'Add to Cart';
    }
}

async function addBundleToCart(productId, clickEvent) {
    const btn = clickEvent && clickEvent.currentTarget ? clickEvent.currentTarget : null;
    if (!btn) {
        return;
    }

    const qtyInput = document.querySelector('[data-bundle-qty-input]');
    const qty = qtyInput ? parseInt(qtyInput.value || '1', 10) : 1;

    btn.disabled = true;
    btn.textContent = 'Adding…';
    try {
        const res = await fetch('{base_url}/api/v1/ecommerce/cart/add', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-TOKEN': __ecCsrf},
            body: JSON.stringify({ product_id: productId, qty: qty > 0 ? qty : 1 }),
        });
        const data = await res.json();
        if (data.ok) {
            showCartPanel(data);
            btn.textContent = 'Added!';
            btn.classList.remove('bg-orange-600', 'hover:bg-orange-700');
            btn.classList.add('bg-emerald-600');
            setTimeout(() => {
                btn.disabled = false;
                btn.textContent = 'Add Bundle to Cart';
                btn.classList.add('bg-orange-600', 'hover:bg-orange-700');
                btn.classList.remove('bg-emerald-600');
            }, 2000);
        } else {
            alert(data.error || 'Could not add bundle to cart');
            btn.disabled = false;
            btn.textContent = 'Add Bundle to Cart';
        }
    } catch (e) {
        alert('Error. Please try again.');
        btn.disabled = false;
        btn.textContent = 'Add Bundle to Cart';
    }
}

async function addGroupedToCart(parentProductId, clickEvent) {
    const btn = clickEvent && clickEvent.currentTarget ? clickEvent.currentTarget : null;
    if (!btn) {
        return;
    }

    const rows = Array.from(document.querySelectorAll('[data-grouped-child-row]'));
    const groupedItems = rows.map((row) => ({
        product_id: parseInt(row.getAttribute('data-product-id') || '0', 10),
        qty: parseInt((row.querySelector('[data-grouped-child-qty]') || {}).value || '0', 10),
    })).filter((item) => item.product_id > 0 && item.qty > 0);

    if (groupedItems.length === 0) {
        alert('Select at least one grouped product quantity.');
        return;
    }

    btn.disabled = true;
    btn.textContent = 'Adding…';
    try {
        const res = await fetch('{base_url}/api/v1/ecommerce/cart/add', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'X-CSRF-TOKEN': __ecCsrf},
            body: JSON.stringify({ grouped_parent_id: parentProductId, grouped_items: groupedItems }),
        });
        const data = await res.json();
        if (data.ok) {
            showCartPanel(data);
            btn.textContent = 'Added!';
            btn.classList.remove('bg-orange-600', 'hover:bg-orange-700');
            btn.classList.add('bg-emerald-600');
            setTimeout(() => {
                btn.disabled = false;
                btn.textContent = 'Add Selected Items to Cart';
                btn.classList.add('bg-orange-600', 'hover:bg-orange-700');
                btn.classList.remove('bg-emerald-600');
            }, 2000);
        } else {
            alert(data.error || 'Could not add grouped products to cart');
            btn.disabled = false;
            btn.textContent = 'Add Selected Items to Cart';
        }
    } catch (e) {
        alert('Error. Please try again.');
        btn.disabled = false;
        btn.textContent = 'Add Selected Items to Cart';
    }
}

let __ecCartPanelEl = null;
let __ecCartPanelTimer = null;
function __ecBuildCartPanel() {
    if (__ecCartPanelEl) return;
    const el = document.createElement('div');
    el.id = 'ec-cart-panel-overlay';
    el.style.cssText = 'position:fixed;inset:0;z-index:9999;display:flex;align-items:flex-start;justify-content:flex-end;padding:1rem;pointer-events:none;';
    el.innerHTML = `
        <div id="ec-cart-panel" style="background:#fff;border-radius:20px;box-shadow:0 24px 48px rgba(15,23,42,0.18);width:100%;max-width:380px;pointer-events:auto;transform:translateX(110%);transition:transform 0.28s cubic-bezier(0.22,1,0.36,1);overflow:hidden;">
            <div style="padding:1.1rem 1.1rem 0;display:flex;align-items:center;justify-content:space-between;gap:0.75rem;">
                <div style="display:flex;align-items:center;gap:0.55rem;">
                    <svg style="width:18px;height:18px;color:#16a34a;" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
                    <span style="font-size:0.82rem;font-weight:700;color:#16a34a;letter-spacing:0.02em;">Added to cart</span>
                </div>
                <button onclick="__ecDismissCartPanel()" aria-label="Close" style="background:none;border:none;cursor:pointer;padding:0.25rem;color:#94a3b8;">
                    <svg style="width:18px;height:18px;" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div style="padding:1rem 1.1rem;display:flex;gap:0.85rem;align-items:center;border-bottom:1px solid #f1f5f9;">
                <div style="width:72px;min-width:72px;height:72px;border-radius:12px;overflow:hidden;background:#f8fafc;">
                    <img id="ec-cart-panel-img-el" src="" alt="" style="width:100%;height:100%;object-fit:cover;display:block;">
                </div>
                <div style="min-width:0;flex:1;">
                    <p id="ec-cart-panel-title" style="margin:0 0 0.3rem;font-size:0.92rem;font-weight:700;color:#111827;line-height:1.3;"></p>
                    <p id="ec-cart-panel-price" style="margin:0;font-size:0.88rem;font-weight:600;color:#ea580c;"></p>
                </div>
            </div>
            <div style="padding:0.75rem 1.1rem;background:#f8fafc;display:flex;align-items:center;justify-content:space-between;">
                <span id="ec-cart-panel-summary" style="font-size:0.82rem;color:#64748b;"></span>
                <span id="ec-cart-panel-total" style="font-size:0.9rem;font-weight:700;color:#111827;"></span>
            </div>
            <div style="padding:0.9rem 1.1rem 1.1rem;display:flex;flex-direction:column;gap:0.6rem;">
                <a id="ec-cart-panel-checkout-btn" href="" style="display:block;text-align:center;padding:0.7rem 1rem;border-radius:999px;background:#0f172a;color:#fff;font-size:0.9rem;font-weight:700;text-decoration:none;">Proceed to Checkout</a>
                <a id="ec-cart-panel-cart-btn" href="" style="display:block;text-align:center;padding:0.65rem 1rem;border-radius:999px;border:1.5px solid #e2e8f0;background:#fff;color:#334155;font-size:0.86rem;font-weight:600;text-decoration:none;">View Cart</a>
                <button onclick="__ecDismissCartPanel()" style="background:none;border:none;cursor:pointer;color:#94a3b8;font-size:0.8rem;padding:0.15rem;text-decoration:underline;">Continue Shopping</button>
            </div>
        </div>`;
    document.body.appendChild(el);
    __ecCartPanelEl = el;
    document.getElementById('ec-cart-panel-checkout-btn').href = __ecBaseUrl + '/ecommerce/checkout';
    document.getElementById('ec-cart-panel-cart-btn').href = __ecBaseUrl + '/ecommerce/cart';
}
function showCartPanel(data) {
    __ecBuildCartPanel();
    const panel = document.getElementById('ec-cart-panel');
    const totals = (data && data.cart && data.cart.totals) ? data.cart.totals : {};
    const count = totals.item_count || 0;
    document.getElementById('ec-cart-panel-title').textContent = __ecProductTitle || 'Item';
    const imgEl = document.getElementById('ec-cart-panel-img-el');
    imgEl.src = __ecProductImage || '';
    imgEl.style.display = __ecProductImage ? 'block' : 'none';
    document.getElementById('ec-cart-panel-price').textContent = __ecProductPrice || '';
    document.getElementById('ec-cart-panel-summary').textContent = count + ' item' + (count === 1 ? '' : 's') + ' in cart';
    document.getElementById('ec-cart-panel-total').textContent = totals.total_fmt || '';
    updateCartBadge(count);
    __ecCartPanelEl.style.pointerEvents = 'auto';
    requestAnimationFrame(() => { panel.style.transform = 'translateX(0)'; });
    clearTimeout(__ecCartPanelTimer);
    __ecCartPanelTimer = setTimeout(__ecDismissCartPanel, 6000);
}
function __ecDismissCartPanel() {
    clearTimeout(__ecCartPanelTimer);
    if (!__ecCartPanelEl) return;
    const panel = document.getElementById('ec-cart-panel');
    if (panel) panel.style.transform = 'translateX(110%)';
    __ecCartPanelEl.style.pointerEvents = 'none';
}
</script>
{/block}
