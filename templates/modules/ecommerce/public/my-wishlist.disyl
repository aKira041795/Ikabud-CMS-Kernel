{extends "modules/ecommerce/layouts/public.disyl"}

{block content}
<div class="max-w-5xl mx-auto space-y-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">My Wishlist</h1>
            <p class="mt-1 text-sm text-gray-500">Products you saved for later, all in one place.</p>
        </div>
        <div class="flex flex-wrap gap-2 text-xs font-semibold">
            <a href="{base_url}/ecommerce/my-orders" class="inline-flex items-center rounded-full border border-gray-200 bg-white px-3 py-1.5 text-gray-700 hover:bg-gray-50">Orders</a>
            <a href="{base_url}/ecommerce/rewards" class="inline-flex items-center rounded-full border border-orange-200 bg-orange-50 px-3 py-1.5 text-orange-700 hover:bg-orange-100">Rewards</a>
            <a href="{base_url}/ecommerce/my-memberships" class="inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-3 py-1.5 text-sky-700 hover:bg-sky-100">Memberships</a>
            <a href="{base_url}/ecommerce/my-bookings" class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1.5 text-indigo-700 hover:bg-indigo-100">Bookings</a>
        </div>
    </div>

    {if message.text}
    <div class="rounded-xl border px-4 py-3 text-sm {if message.type == 'success'}border-emerald-200 bg-emerald-50 text-emerald-800{else}border-red-200 bg-red-50 text-red-700{/if}">{message.text}</div>
    {/if}

    {if wishlist_items | count == 0}
    <div class="rounded-2xl border border-dashed border-gray-200 bg-white px-6 py-12 text-center">
        <div class="text-lg font-semibold text-gray-900">Your wishlist is empty</div>
        <p class="mt-2 text-sm text-gray-500">Save products from the shop or product pages to keep them here for later.</p>
        <a href="{base_url}/ecommerce/shop" class="mt-4 inline-flex items-center rounded-lg bg-orange-600 px-4 py-2 text-sm font-semibold text-white hover:bg-orange-700">Browse Products</a>
    </div>
    {else}
    <div class="flex items-center justify-between rounded-2xl border border-rose-100 bg-gradient-to-r from-rose-50 via-white to-orange-50 px-5 py-4">
        <div>
            <div class="text-xs font-semibold uppercase tracking-[0.16em] text-rose-600">Saved Items</div>
            <div class="mt-1 text-lg font-semibold text-gray-900">{wishlist_count} {if wishlist_count == 1}product{else}products{/if} in your wishlist</div>
        </div>
        <form method="post" action="{base_url}/ecommerce/wishlist">
            <input type="hidden" name="_token" value="{csrf_token}">
            <input type="hidden" name="action" value="clear">
            <input type="hidden" name="return_to" value="/ecommerce/my-wishlist">
            <button type="submit" class="inline-flex items-center rounded-lg border border-rose-200 bg-white px-4 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-50">Clear Wishlist</button>
        </form>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-3">
        {foreach wishlist_items as item}
        <article class="rounded-2xl border border-gray-200 bg-white shadow-sm overflow-hidden">
            <a href="{item.url}" class="block no-underline text-inherit">
                <div class="aspect-square overflow-hidden bg-gray-100">
                    <img src="{if item.primary_image_url}{item.primary_image_url}{else}{base_url}/assets/ecommerce/product-placeholder.svg{/if}" alt="{item.title}" class="h-full w-full object-cover">
                </div>
                <div class="p-5">
                    <h2 class="text-base font-semibold text-gray-900">{item.title}</h2>
                    {if item.excerpt}<p class="mt-2 text-sm text-gray-500 line-clamp-2">{item.excerpt}</p>{/if}
                    <div class="mt-3 flex items-center gap-2">
                        <span class="text-lg font-bold text-gray-900">{item.pricing.formatted|default:'—'}</span>
                        {if item.pricing.on_sale && item.pricing.regular_fmt}<span class="text-sm text-gray-400 line-through">{item.pricing.regular_fmt}</span>{/if}
                    </div>
                    {if item.inventory.badge.label}
                    <div class="mt-2 text-xs font-medium {if item.inventory.badge.tone == 'danger'}text-red-500{elseif item.inventory.badge.tone == 'warning'}text-amber-600{elseif item.inventory.badge.tone == 'success'}text-emerald-600{else}text-gray-500{/if}">{item.inventory.badge.label}</div>
                    {/if}
                </div>
            </a>
            <div class="grid grid-cols-2 gap-3 border-t border-gray-100 p-5">
                <a href="{item.url}" class="inline-flex items-center justify-center rounded-lg border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">View Product</a>
                <form method="post" action="{base_url}/ecommerce/wishlist">
                    <input type="hidden" name="_token" value="{csrf_token}">
                    <input type="hidden" name="action" value="remove">
                    <input type="hidden" name="product_id" value="{item.id}">
                    <input type="hidden" name="return_to" value="/ecommerce/my-wishlist">
                    <button type="submit" class="w-full rounded-lg bg-rose-600 px-3 py-2 text-sm font-semibold text-white hover:bg-rose-700">Remove</button>
                </form>
            </div>
        </article>
        {/foreach}
    </div>
    {/if}
</div>
{/block}
