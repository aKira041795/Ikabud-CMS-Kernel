{extends "modules/ecommerce/layouts/public.disyl"}

{block content}
<div
    class="flex gap-8"
    data-storefront-route-kind="{storefront.route.kind|default:public_route_kind|default:'shop_index'}"
    data-storefront-mode="{storefront.route.mode|default:public_presentation_mode|default:'traditional'}"
    data-storefront-page-kind="{storefront.page.kind|default:'catalog'}"
    data-storefront-result-total="{storefront.collection.total|default:total|default:0}"
>
    <!-- Sidebar: categories -->
    {if storefront.navigation.categories | count > 0}
    <aside class="w-44 shrink-0 hidden md:block">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Categories</h3>
        <nav class="space-y-1">
            <a href="{if storefront.navigation.all_items_url}{storefront.navigation.all_items_url}{else}{base_url}/ecommerce/shop{/if}" class="block text-sm px-3 py-1.5 rounded hover:bg-gray-50 {if storefront.filters.category_id|default:category_id == 0}font-semibold text-orange-600{else}text-gray-700{/if}">All Products</a>
            {foreach storefront.navigation.categories as cat}
            <a href="{if cat.url}{cat.url}{else}{base_url}/ecommerce/shop/category/{cat.slug}{/if}" class="block text-sm px-3 py-1.5 rounded hover:bg-gray-50 {if cat.is_active or storefront.filters.category_id|default:category_id == cat.id}font-semibold text-orange-600{else}text-gray-700{/if}">{cat.name}</a>
            {/foreach}
        </nav>

        {if storefront.filters.attribute_facets | count > 0}
        <form method="get" action="{if storefront.navigation.search_action_url}{storefront.navigation.search_action_url}{else}{base_url}/ecommerce/shop{/if}" class="mt-6 space-y-4">
            {if storefront.filters.search}<input type="hidden" name="search" value="{storefront.filters.search}">{/if}
            <div>
                <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Filter</h3>
                <div class="space-y-4">
                    {foreach storefront.filters.attribute_facets as facet}
                    <div>
                        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">{facet.attribute_name}</div>
                        <div class="space-y-1.5">
                            {foreach facet.values as value}
                            <label class="flex items-center justify-between gap-2 text-sm text-gray-700">
                                <span class="flex items-center gap-2">
                                    <input type="checkbox" name="attr[{facet.attribute_slug}][]" value="{value.value_slug}" class="rounded border-gray-300" {if value.is_selected}checked{/if}>
                                    <span>{value.value_label}</span>
                                </span>
                                <span class="text-xs text-gray-400">{value.count}</span>
                            </label>
                            {/foreach}
                        </div>
                    </div>
                    {/foreach}
                </div>
            </div>
            <div class="flex flex-col gap-2">
                <button type="submit" class="px-3 py-2 bg-orange-600 text-white text-sm rounded-lg hover:bg-orange-700">Apply Filters</button>
                <a href="{if storefront.navigation.all_items_url}{storefront.navigation.all_items_url}{else}{base_url}/ecommerce/shop{/if}" class="text-xs text-gray-500 hover:text-gray-700">Reset filters</a>
            </div>
        </form>
        {/if}
    </aside>
    {elseif categories | count > 0}
    <aside class="w-44 shrink-0 hidden md:block">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Categories</h3>
        <nav class="space-y-1">
            <a href="{base_url}/ecommerce/shop" class="block text-sm px-3 py-1.5 rounded hover:bg-gray-50 {if category_id == 0}font-semibold text-orange-600{else}text-gray-700{/if}">All Products</a>
            {foreach categories as cat}
            <a href="{base_url}/ecommerce/shop/category/{cat.slug}" class="block text-sm px-3 py-1.5 rounded hover:bg-gray-50 {if category_id == cat.id}font-semibold text-orange-600{else}text-gray-700{/if}">{cat.name}</a>
            {/foreach}
        </nav>
    </aside>
    {/if}

    <!-- Main: product grid -->
    <div class="flex-1">
        <div class="flex items-center justify-between mb-5">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">{storefront.page.title|default:page_title}</h1>
                {if storefront.page.description}
                <p class="mt-1 text-sm text-gray-500">{storefront.page.description}</p>
                {/if}
            </div>
            <form method="get" action="{if storefront.navigation.search_action_url}{storefront.navigation.search_action_url}{else}{base_url}/ecommerce/shop{/if}" class="flex gap-2">
                {if storefront.filters.category_id|default:category_id > 0}<input type="hidden" name="cat" value="{storefront.filters.category_id|default:category_id}">{/if}
                {if storefront.filters.attribute_filters | count > 0}
                {foreach storefront.filters.attribute_filters as attrSlug => attrValues}
                {foreach attrValues as attrValue}
                <input type="hidden" name="attr[{attrSlug}][]" value="{attrValue}">
                {/foreach}
                {/foreach}
                {/if}
                <input type="text" name="search" value="{storefront.filters.search|default:search}" placeholder="Search…"
                       class="border border-gray-300 rounded-lg px-3 py-2 text-sm">
                <button type="submit" class="px-4 py-2 bg-orange-600 text-white text-sm rounded-lg hover:bg-orange-700">Search</button>
            </form>
        </div>

        {if storefront.collection.items | count > 0}
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-6">
            {foreach storefront.collection.items as p}
            <article class="group rounded-xl border border-gray-200 overflow-hidden hover:shadow-md transition-shadow bg-white">
                <a href="{if p.url}{p.url}{else}{base_url}/ecommerce/shop/{p.slug}{/if}" class="no-underline block">
                <div class="aspect-square overflow-hidden bg-gray-100">
                    <img src="{if p.primary_image_url|default:p.featured_image_url}{p.primary_image_url|default:p.featured_image_url}{else}{base_url}/assets/ecommerce/product-placeholder.svg{/if}" alt="{p.title}"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                </div>
                <div class="p-4">
                    <h3 class="font-medium text-gray-900 truncate text-sm">{p.title}</h3>
                    {if p.excerpt}<p class="text-xs text-gray-400 mt-1 line-clamp-2">{p.excerpt}</p>{/if}
                    <div class="mt-2 flex items-center gap-2">
                        {if p.pricing.on_sale}
                        <span class="font-bold text-orange-600">{p.pricing.formatted}</span>
                        <span class="text-xs text-gray-400 line-through">{p.pricing.regular_fmt}</span>
                        {if p.badges.sale|default:p.sale_badge_text}<span class="rounded-full bg-orange-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-orange-700">{p.badges.sale|default:p.sale_badge_text}</span>{/if}
                        {else}
                        <span class="font-bold text-gray-900">{p.pricing.formatted|default:'—'}</span>
                        {/if}
                    </div>
                    {if p.review_summary.has_reviews|default:false}
                    <div class="mt-1 text-xs text-amber-700 font-medium">{p.review_summary.average_rating_formatted}/5 · {p.review_summary.approved_count} {if p.review_summary.approved_count == 1}review{else}reviews{/if}</div>
                    {/if}
                    {if p.inventory.badge.label|default:p.inventory_badge_text}
                    <div class="mt-1 text-xs font-medium {if p.inventory.badge.tone|default:p.inventory_badge_tone == 'danger'}text-red-500{elseif p.inventory.badge.tone|default:p.inventory_badge_tone == 'warning'}text-amber-600{elseif p.inventory.badge.tone|default:p.inventory_badge_tone == 'success'}text-emerald-600{else}text-gray-500{/if}">{p.inventory.badge.label|default:p.inventory_badge_text}</div>
                    {elseif p.inventory.track_stock && (p.inventory.out_of_stock || !p.inventory.in_stock)}
                    <div class="mt-1 text-xs text-red-500 font-medium">Out of stock</div>
                    {elseif p.inventory.track_stock && p.inventory.low_stock}
                    <div class="mt-1 text-xs text-amber-600 font-medium">Low stock - only {p.inventory.stock_qty} left</div>
                    {/if}
                </div>
                </a>
                <div class="px-4 pb-4">
                    <form method="post" action="{base_url}/ecommerce/compare">
                        <input type="hidden" name="_token" value="{csrf_token}">
                        <input type="hidden" name="action" value="{if p.is_compared}remove{else}add{/if}">
                        <input type="hidden" name="product_id" value="{p.id}">
                        <input type="hidden" name="return_to" value="{current_request_uri|default:'/ecommerce/shop'}">
                        <button type="submit" class="w-full rounded-lg border px-3 py-2 text-sm font-medium {if p.is_compared}border-slate-300 bg-slate-100 text-slate-700 hover:bg-slate-200{else}border-slate-900 bg-slate-900 text-white hover:bg-slate-800{/if}">{if p.is_compared}Remove From Compare{else}Add to Compare{/if}</button>
                    </form>
                </div>
            </article>
            {/foreach}
        </div>
        {elseif products | count > 0}
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-6">
            {foreach products as p}
            <article class="group rounded-xl border border-gray-200 overflow-hidden hover:shadow-md transition-shadow bg-white">
                <a href="{base_url}/ecommerce/shop/{p.slug}" class="no-underline block">
                <div class="aspect-square overflow-hidden bg-gray-100">
                    <img src="{if p.primary_image_url}{p.primary_image_url}{else}{base_url}/assets/ecommerce/product-placeholder.svg{/if}" alt="{p.title}"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                </div>
                <div class="p-4">
                    <h3 class="font-medium text-gray-900 truncate text-sm">{p.title}</h3>
                    {if p.excerpt}<p class="text-xs text-gray-400 mt-1 line-clamp-2">{p.excerpt}</p>{/if}
                    <div class="mt-2 flex items-center gap-2">
                        {if p.pricing.on_sale}
                        <span class="font-bold text-orange-600">{p.pricing.formatted}</span>
                        <span class="text-xs text-gray-400 line-through">{p.pricing.regular_fmt}</span>
                        {else}
                        <span class="font-bold text-gray-900">{p.pricing.formatted|default:'—'}</span>
                        {/if}
                    </div>
                    {if p.review_summary.has_reviews|default:false}
                    <div class="mt-1 text-xs text-amber-700 font-medium">{p.review_summary.average_rating_formatted}/5 · {p.review_summary.approved_count} {if p.review_summary.approved_count == 1}review{else}reviews{/if}</div>
                    {/if}
                    {if p.inventory.track_stock && (p.inventory.out_of_stock || !p.inventory.in_stock)}
                    <div class="mt-1 text-xs text-red-500 font-medium">Out of stock</div>
                    {elseif p.inventory.track_stock && p.inventory.low_stock}
                    <div class="mt-1 text-xs text-amber-600 font-medium">Low stock - only {p.inventory.stock_qty} left</div>
                    {/if}
                </div>
                </a>
                <div class="px-4 pb-4">
                    <form method="post" action="{base_url}/ecommerce/compare">
                        <input type="hidden" name="_token" value="{csrf_token}">
                        <input type="hidden" name="action" value="{if p.is_compared}remove{else}add{/if}">
                        <input type="hidden" name="product_id" value="{p.id}">
                        <input type="hidden" name="return_to" value="{current_request_uri|default:'/ecommerce/shop'}">
                        <button type="submit" class="w-full rounded-lg border px-3 py-2 text-sm font-medium {if p.is_compared}border-slate-300 bg-slate-100 text-slate-700 hover:bg-slate-200{else}border-slate-900 bg-slate-900 text-white hover:bg-slate-800{/if}">{if p.is_compared}Remove From Compare{else}Add to Compare{/if}</button>
                    </form>
                </div>
            </article>
            {/foreach}
        </div>

        <!-- Pagination -->
        {if storefront.collection.pagination.total|default:total_pages > 1}
        <div class="mt-10 flex items-center justify-center gap-2">
            {if storefront.collection.pagination.prev_url}<a href="{storefront.collection.pagination.prev_url}" class="px-4 py-2 border rounded-lg text-sm hover:bg-gray-50">← Prev</a>{elseif page > 1}<a href="?page={page - 1}" class="px-4 py-2 border rounded-lg text-sm hover:bg-gray-50">← Prev</a>{/if}
            <span class="px-4 py-2 text-sm text-gray-500">Page {storefront.collection.pagination.current|default:page} of {storefront.collection.pagination.total|default:total_pages}</span>
            {if storefront.collection.pagination.next_url}<a href="{storefront.collection.pagination.next_url}" class="px-4 py-2 border rounded-lg text-sm hover:bg-gray-50">Next →</a>{elseif page < total_pages}<a href="?page={page + 1}" class="px-4 py-2 border rounded-lg text-sm hover:bg-gray-50">Next →</a>{/if}
        </div>
        {/if}

        {else}
        <div class="text-center py-20 text-gray-400">
            <p class="text-lg">No products found.</p>
            <a href="{if storefront.navigation.all_items_url}{storefront.navigation.all_items_url}{else}{base_url}/ecommerce/shop{/if}" class="text-orange-600 text-sm mt-2 inline-block">Browse all →</a>
        </div>
        {/if}
    </div>
</div>
{/block}
