{if public_render_origin == 'ecommerce' and (store_banner.headline or store_banner.subtext or store_banner.image_url or social_links | count > 0 or store_hours_schedule | count > 0)}
<div
    class="ec-storefront-chrome"
    data-storefront-chrome="shared"
    data-storefront-theme="{storefront_theme|default:'orange'}"
    data-storefront-social-count="{social_links|count}"
    style="display:grid; gap:20px; margin:0 0 28px;{if store_hours_schedule | count > 0} grid-template-columns:minmax(0,1.7fr) minmax(260px,0.9fr); align-items:stretch;{/if}"
>
    <section
        class="ec-storefront-chrome__hero"
        style="position:relative; overflow:hidden; display:flex; flex-direction:column; justify-content:space-between; gap:18px; min-width:0; padding:28px; border-radius:24px; border:1px solid rgba(148, 163, 184, 0.22); box-shadow:0 20px 40px rgba(15, 23, 42, 0.08); background:{if store_banner.image_url}linear-gradient(135deg, rgba(15, 23, 42, 0.86), rgba(15, 23, 42, 0.58)), url('{store_banner.image_url | escape}') center/cover no-repeat{else}linear-gradient(135deg, var(--storefront-secondary-bg, #fff7ed), #ffffff){/if}; color:{if store_banner.image_url}#fffaf2{else}var(--color-text, #111827){/if};"
    >
        <div style="display:grid; gap:12px;">
            <p style="margin:0; font-size:0.75rem; letter-spacing:0.18em; text-transform:uppercase; font-weight:700; color:{if store_banner.image_url}rgba(255, 250, 242, 0.78){else}var(--color-primary, #ea580c){/if};">
                {if active_store.name}{active_store.name | escape}{elseif store.name}{store.name | escape}{else}Storefront{/if}
            </p>
            <div style="display:grid; gap:10px; max-width:44rem;">
                <h2 style="margin:0; font-size:clamp(1.9rem, 3.8vw, 3.2rem); line-height:1.02; font-weight:800; letter-spacing:-0.04em; color:inherit;">
                    {if store_banner.headline}{store_banner.headline | escape}{elseif active_store.name}{active_store.name | escape}{elseif store.name}{store.name | escape}{else}{storefront.page.title|default:page_title|default:'Storefront'}{/if}
                </h2>
                {if store_banner.subtext or active_store.description or store.description}
                <p style="margin:0; font-size:1rem; line-height:1.6; color:{if store_banner.image_url}rgba(255, 250, 242, 0.82){else}var(--color-muted, #475569){/if};">
                    {if store_banner.subtext}{store_banner.subtext | escape}{elseif active_store.description}{active_store.description | escape}{else}{store.description | escape}{/if}
                </p>
                {/if}
            </div>
        </div>

        <div style="display:flex; flex-wrap:wrap; gap:10px; align-items:center;">
            {if store_banner.cta_text}
            <a
                href="{store_banner.cta_url | escape}"
                style="display:inline-flex; align-items:center; justify-content:center; min-height:42px; padding:0 16px; border-radius:999px; text-decoration:none; font-size:0.9rem; font-weight:700; background:var(--storefront-cta-bg, var(--color-primary, #ea580c)); color:#ffffff;"
            >
                {store_banner.cta_text | escape}
            </a>
            {/if}
            {foreach social_links as sl}
            <a
                href="{sl.url | escape}"
                target="_blank"
                rel="noopener noreferrer"
                style="display:inline-flex; align-items:center; justify-content:center; min-height:42px; padding:0 14px; border-radius:999px; text-decoration:none; font-size:0.84rem; font-weight:700; border:1px solid rgba(148, 163, 184, 0.28); background:{if store_banner.image_url}rgba(255, 250, 242, 0.12){else}rgba(255, 255, 255, 0.82){/if}; color:inherit;"
            >
                {sl.label | escape}
            </a>
            {/foreach}
        </div>
    </section>

    {if store_hours_schedule | count > 0}
    <aside
        class="ec-storefront-chrome__hours"
        data-storefront-hours="true"
        style="display:block; padding:24px; border-radius:24px; border:1px solid rgba(148, 163, 184, 0.18); background:var(--storefront-surface-bg, #ffffff); box-shadow:0 16px 34px rgba(15, 23, 42, 0.08);"
    >
        <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:14px; margin-bottom:14px;">
            <div>
                <p style="margin:0 0 8px; font-size:0.75rem; letter-spacing:0.18em; text-transform:uppercase; font-weight:700; color:var(--color-primary, #ea580c);">Store Hours</p>
                <h3 style="margin:0; font-size:1.35rem; line-height:1.1; color:var(--color-text, #111827);">{if store_is_open}Open now{else}Closed now{/if}</h3>
            </div>
            <span style="display:inline-flex; align-items:center; justify-content:center; min-height:32px; padding:0 12px; border-radius:999px; font-size:0.76rem; font-weight:700; background:{if store_is_open}var(--storefront-success-bg, #dcfce7){else}var(--storefront-danger-bg, #fee2e2){/if}; color:{if store_is_open}var(--storefront-success-text, #166534){else}var(--storefront-danger-text, #b91c1c){/if};">
                {if store_is_open}Open{else}Closed{/if}
            </span>
        </div>
        <div style="display:grid; gap:10px;">
            {foreach store_hours_schedule as day}
            <div
                data-storefront-hours-day="{day.key}"
                style="display:flex; align-items:center; justify-content:space-between; gap:12px; padding:10px 14px; border-radius:16px; border:1px solid {if day.today}rgba(234, 88, 12, 0.16){else}rgba(148, 163, 184, 0.16){/if}; background:{if day.today}rgba(255, 237, 213, 0.78){else}rgba(248, 250, 252, 0.92){/if};"
            >
                <strong style="font-size:0.9rem; color:var(--color-text, #111827);">{day.label}</strong>
                <span style="font-size:0.9rem; color:var(--color-muted, #64748b);">{if day.open}{day.from} - {day.to}{else}Closed{/if}</span>
            </div>
            {/foreach}
        </div>
    </aside>
    {/if}
</div>
{/if}