{extends "modules/ecommerce/layouts/public.disyl"}

{block content}
<div class="max-w-7xl mx-auto space-y-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
            <div class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Comparison</div>
            <h1 class="mt-1 text-3xl font-bold text-slate-900">Compare Products</h1>
            <p class="mt-2 max-w-2xl text-sm text-slate-600">Review up to four products side by side across pricing, availability, ratings, and product metadata.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <a href="{base_url}/ecommerce/shop" class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Browse More Products</a>
            {if compare_products | count > 0}
            <form method="post" action="{base_url}/ecommerce/compare">
                <input type="hidden" name="_token" value="{csrf_token}">
                <input type="hidden" name="action" value="clear">
                <input type="hidden" name="return_to" value="/ecommerce/compare">
                <button type="submit" class="inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">Clear Comparison</button>
            </form>
            {/if}
        </div>
    </div>

    {if message}
    <div class="rounded-xl border px-4 py-3 text-sm {if message.type == 'success'}border-emerald-200 bg-emerald-50 text-emerald-800{else}border-red-200 bg-red-50 text-red-700{/if}">{message.text}</div>
    {/if}

    {if compare_products | count == 0}
    <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-16 text-center">
        <h2 class="text-xl font-semibold text-slate-900">Your comparison list is empty</h2>
        <p class="mt-2 text-sm text-slate-600">Add products from the shop or product pages to build a shortlist before you decide.</p>
        <a href="{base_url}/ecommerce/shop" class="mt-6 inline-flex items-center rounded-lg bg-orange-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-orange-700">Start Comparing</a>
    </div>
    {else}
    <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="min-w-[960px] w-full border-collapse">
            <thead>
                <tr class="border-b border-slate-200 bg-slate-50 align-top">
                    <th class="w-48 px-4 py-4 text-left text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Feature</th>
                    {foreach compare_products as item}
                    <th class="px-4 py-4 text-left">
                        <div class="flex flex-col gap-3 min-w-[220px]">
                            <a href="{item.url}" class="flex items-center gap-3 no-underline text-inherit">
                                <img src="{if item.primary_image_url}{item.primary_image_url}{else}{base_url}/assets/ecommerce/product-placeholder.svg{/if}" alt="{item.title}" class="h-16 w-16 rounded-xl object-cover bg-slate-100">
                                <div>
                                    <div class="text-sm font-semibold text-slate-900">{item.title}</div>
                                    <div class="mt-1 text-xs text-slate-500">{item.pricing.formatted|default:'Contact for price'}</div>
                                </div>
                            </a>
                            <div class="flex flex-wrap items-center gap-2">
                                <a href="{item.url}" class="inline-flex items-center rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50">View Product</a>
                                <form method="post" action="{base_url}/ecommerce/compare">
                                    <input type="hidden" name="_token" value="{csrf_token}">
                                    <input type="hidden" name="action" value="remove">
                                    <input type="hidden" name="product_id" value="{item.id}">
                                    <input type="hidden" name="return_to" value="/ecommerce/compare">
                                    <button type="submit" class="inline-flex items-center rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-800">Remove</button>
                                </form>
                            </div>
                        </div>
                    </th>
                    {/foreach}
                </tr>
            </thead>
            <tbody>
                {foreach compare_rows as row}
                <tr class="border-b border-slate-100 last:border-b-0">
                    <th class="bg-slate-50 px-4 py-3 text-left text-sm font-semibold text-slate-700">{row.label}</th>
                    {foreach row.values as value}
                    <td class="px-4 py-3 text-sm text-slate-600 align-top">{value}</td>
                    {/foreach}
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>
    {/if}
</div>
{/block}