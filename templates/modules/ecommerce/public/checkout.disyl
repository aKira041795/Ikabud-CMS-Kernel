{extends "modules/ecommerce/layouts/public.disyl"}

{block content}
<div class="max-w-4xl mx-auto">
    <div class="mb-6 flex items-center justify-between gap-4">
        <h1 class="text-2xl font-bold text-gray-900">Checkout</h1>
        <div class="rounded-full border border-gray-200 bg-white px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-gray-500">{ec_settings.currency}</div>
    </div>

    <form id="checkout-form" class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-5">
            {if cart_has_digital && !is_customer}
            <div class="flex gap-3 rounded-xl border border-orange-200 bg-orange-50 px-4 py-3">
                <svg class="w-5 h-5 text-orange-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M12 2a10 10 0 100 20A10 10 0 0012 2z"/></svg>
                <div class="text-sm text-orange-800">
                    <span class="font-semibold">Your cart contains digital products.</span>
                    {if require_account_for_digital}
                    An account will be created automatically using your email address so you can access your downloads from
                    <strong>My Orders</strong> at any time. Your license key will also be emailed to you.
                    {else}
                    Your license key and download link will be sent to the email address you enter below.
                    {/if}
                </div>
            </div>
            {/if}

            {if cart.subscription.has_subscription}
            <div class="flex gap-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3">
                <svg class="w-5 h-5 text-amber-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-2.21 0-4 1.79-4 4m4-4c2.21 0 4 1.79 4 4m-4-4V3m0 9a4 4 0 100 8 4 4 0 000-8z"/></svg>
                <div class="text-sm text-amber-900">
                    <span class="font-semibold">Subscription checkout.</span>
                    {cart.subscription.primary_item.product_title} renews at {cart.subscription.primary_item.recurring_label}.
                    {if cart.subscription.primary_item.trial_label}
                    <span class="block mt-1 text-amber-800">{cart.subscription.primary_item.trial_label}</span>
                    {/if}
                    <span class="block mt-1 text-amber-800">Subscriptions must be purchased separately from one-time products.</span>
                </div>
            </div>
            {/if}

            {if cart.validation_errors | count > 0}
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                {cart.validation_errors.0}
            </div>
            {/if}

            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <h2 class="font-semibold text-gray-900 mb-4">Contact &amp; Billing</h2>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">First Name *</label>
                        <input type="text" name="billing[first_name]" required value="{user.first_name | default:''}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Last Name *</label>
                        <input type="text" name="billing[last_name]" required value="{user.last_name | default:''}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                    <div class="col-span-2">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Email *</label>
                        <input type="email" name="billing[email]" required value="{user.email | default:''}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                    <div class="col-span-2">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Address *</label>
                        <input type="text" name="billing[address_line1]" required placeholder="Street address"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none mb-2">
                        <input type="text" name="billing[address_line2]" placeholder="Apartment, suite, etc."
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">City *</label>
                        <input type="text" name="billing[city]" required
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">State / Region</label>
                        <input type="text" name="billing[state]"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Postal Code</label>
                        <input type="text" name="billing[postal_code]"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Country *</label>
                        <input type="text" name="billing[country]" required placeholder="US" value="{shipping_defaults.country | default:''}"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                    <div class="col-span-2">
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Phone</label>
                        <input type="tel" name="billing[phone]"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none">
                    </div>
                </div>
            </div>

            {if requires_shipping}
            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <h2 class="font-semibold text-gray-900 mb-4">Shipping</h2>
                <p class="mb-3 text-sm text-gray-500">Rates update when you change the destination country, state, city, or postal code.</p>
                <div id="shipping-rate-options" class="space-y-2">
                    {if shipping_quote.rates | count > 0}
                    {foreach shipping_quote.rates as rate}
                    <label class="flex items-center gap-3 cursor-pointer rounded-lg border border-gray-200 p-3 hover:border-orange-500 has-[:checked]:border-orange-500 has-[:checked]:bg-orange-50">
                        <input type="radio" name="shipping_rate_id" value="{rate.id}" class="text-orange-600" {if shipping_quote.selected_rate_id == rate.id}checked{/if}>
                        <span class="flex-1 text-sm font-medium text-gray-900">
                            {rate.name}
                            {if rate.carrier || rate.estimated_days}
                            <span class="mt-1 block text-xs font-normal text-gray-500">{if rate.carrier}{rate.carrier}{/if}{if rate.carrier && rate.estimated_days} · {/if}{if rate.estimated_days}{rate.estimated_days}{/if}</span>
                            {/if}
                        </span>
                        <span class="text-sm font-semibold text-gray-900">{if rate.rate == 0}Free{else}{rate.rate_fmt}{/if}</span>
                    </label>
                    {/foreach}
                    {else}
                    <div class="rounded-lg border border-dashed border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-500">No shipping rates are available for this destination yet.</div>
                    {/if}
                </div>
                <div id="shipping-rate-error" class="mt-2 hidden text-xs text-red-600"></div>
            </div>
            {/if}

            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <h2 class="font-semibold text-gray-900 mb-3">Payment</h2>
                <div class="flex items-center gap-3 rounded-lg border border-gray-200 p-3 bg-gray-50">
                    <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                    <span class="text-sm text-gray-700">{payment_label}</span>
                </div>
                <div class="mt-3">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Order Note (optional)</label>
                    <textarea name="customer_note" rows="2" placeholder="Notes about your order"
                              class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:border-orange-500 outline-none resize-none"></textarea>
                </div>
            </div>
        </div>

        <div>
            <div class="bg-white rounded-xl border border-gray-200 p-5 sticky top-24">
                <h2 class="font-semibold text-gray-900 mb-4">Order Summary</h2>
                <div class="space-y-2 text-sm mb-4">
                    {foreach cart.items as item}
                    <div class="flex justify-between">
                        <span class="text-gray-600 truncate mr-2">
                            {item.product_title} × {item.qty}
                            {if item.selected_addons | count > 0}<span class="block text-xs text-gray-400">Add-ons: {foreach item.selected_addons as addon}{addon.label}{if !loop.last}, {/if}{/foreach}</span>{/if}
                            {if item.booking.has_booking}<span class="block text-xs text-sky-700">Appointment: {item.booking.scheduled_date} at {item.booking.scheduled_time}</span>{/if}
                        </span>
                        <span class="text-gray-900 font-medium shrink-0">{item.line_total_fmt}</span>
                    </div>
                    {/foreach}
                </div>
                <div class="border-t border-gray-200 pt-3 space-y-1.5 text-sm">
                    <div class="flex justify-between text-gray-600"><span>Subtotal</span><span>{checkout_totals.subtotal_fmt}</span></div>
                    {if checkout_totals.non_loyalty_discount_amount > 0}
                    <div class="flex justify-between text-emerald-600"><span>Discount</span><span>−{checkout_totals.non_loyalty_discount_amount_fmt}</span></div>
                    {/if}
                    {if checkout_totals.loyalty_points_applied > 0}
                    <div class="flex justify-between text-orange-600"><span>Loyalty ({checkout_totals.loyalty_points_applied} pts)</span><span>−{checkout_totals.loyalty_discount_amount_fmt}</span></div>
                    {/if}
                    <div id="checkout-tax-row" class="flex justify-between text-gray-600{if checkout_totals.tax <= 0} hidden{/if}"><span id="checkout-tax-label">{checkout_totals.tax_label | default:'Tax'}</span><span id="checkout-tax-value">{checkout_totals.tax_fmt}</span></div>
                    {if requires_shipping}
                    <div id="checkout-shipping-row" class="flex justify-between text-gray-600"><span>Shipping</span><span id="checkout-shipping-value">{checkout_totals.shipping_fmt}</span></div>
                    {/if}
                    <div class="flex justify-between font-bold text-gray-900 text-base pt-1 border-t border-gray-200">
                        <span>Total</span><span id="checkout-total-value">{checkout_totals.total_fmt}</span>
                    </div>
                </div>
                <input type="hidden" name="_token" value="{csrf_token}">
                <button type="button" onclick="submitCheckout()"
                        class="mt-4 w-full py-3 bg-orange-600 text-white font-medium rounded-lg hover:bg-orange-700 text-sm" id="place-order-btn">
                    Place Order
                </button>
                <div id="checkout-error" class="mt-2 text-xs text-red-600 hidden"></div>
            </div>
        </div>
    </form>
</div>

<script>
const checkoutRequiresShipping = {if requires_shipping}true{else}false{/if};
const abandonedCartEnabled = {if abandoned_cart_enabled}true{else}false{/if};
let abandonedCartCaptureTimer = null;

function collectCheckoutData() {
    const form = document.getElementById('checkout-form');
    const data = {};
    const fd = new FormData(form);

    data.billing = {};
    data.shipping = {};
    for (const [key, val] of fd.entries()) {
        if (key.startsWith('billing[') && key.endsWith(']')) {
            data.billing[key.slice(8, -1)] = val;
        } else if (key.startsWith('shipping[') && key.endsWith(']')) {
            data.shipping[key.slice(9, -1)] = val;
        } else if (key === 'shipping_rate_id') {
            data.shipping_rate_id = parseInt(val, 10);
        } else if (key === 'customer_note') {
            data.customer_note = val;
        } else if (key === '_token') {
            data._token = val;
        }
    }

    return data;
}

function escapeHtml(value) {
    return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

async function captureAbandonedCartLead() {
    if (!abandonedCartEnabled) {
        return;
    }

    const data = collectCheckoutData();
    const billing = data.billing || {};
    if (!billing.email || !String(billing.email).includes('@')) {
        return;
    }

    try {
        await fetch('{base_url}/api/v1/ecommerce/abandoned-carts/capture', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
            body: JSON.stringify(data),
        });
    } catch (error) {
    }
}

function scheduleAbandonedCartCapture() {
    if (!abandonedCartEnabled) {
        return;
    }

    window.clearTimeout(abandonedCartCaptureTimer);
    abandonedCartCaptureTimer = window.setTimeout(captureAbandonedCartLead, 600);
}

function updateCheckoutTotals(totals) {
    const taxRow = document.getElementById('checkout-tax-row');
    const taxLabel = document.getElementById('checkout-tax-label');
    const taxValue = document.getElementById('checkout-tax-value');
    const shippingValue = document.getElementById('checkout-shipping-value');
    const totalValue = document.getElementById('checkout-total-value');

    if (taxRow && taxLabel && taxValue) {
        if ((totals.tax || 0) > 0) {
            taxRow.classList.remove('hidden');
            taxLabel.textContent = totals.tax_label || 'Tax';
            taxValue.textContent = totals.tax_fmt || '';
        } else {
            taxRow.classList.add('hidden');
        }
    }

    if (shippingValue && totals.shipping_fmt) {
        shippingValue.textContent = totals.shipping_fmt;
    }
    if (totalValue && totals.total_fmt) {
        totalValue.textContent = totals.total_fmt;
    }
}

function renderShippingRates(quote) {
    const container = document.getElementById('shipping-rate-options');
    if (!container) {
        return;
    }

    if (!quote.rates || quote.rates.length === 0) {
        container.innerHTML = '<div class="rounded-lg border border-dashed border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-500">No shipping rates are available for this destination yet.</div>';
        return;
    }

    container.innerHTML = quote.rates.map((rate) => {
        const note = [rate.carrier || '', rate.estimated_days || ''].filter(Boolean).join(' · ');
        const checked = quote.selected_rate_id === rate.id ? ' checked' : '';
        const price = Number(rate.rate || 0) === 0 ? 'Free' : escapeHtml(rate.rate_fmt || '');
        return '<label class="flex items-center gap-3 cursor-pointer rounded-lg border border-gray-200 p-3 hover:border-orange-500 has-[:checked]:border-orange-500 has-[:checked]:bg-orange-50">'
            + '<input type="radio" name="shipping_rate_id" value="' + escapeHtml(rate.id) + '" class="text-orange-600"' + checked + '>'
            + '<span class="flex-1 text-sm font-medium text-gray-900">' + escapeHtml(rate.name || rate.label || 'Shipping')
            + (note ? '<span class="mt-1 block text-xs font-normal text-gray-500">' + escapeHtml(note) + '</span>' : '')
            + '</span>'
            + '<span class="text-sm font-semibold text-gray-900">' + price + '</span>'
            + '</label>';
    }).join('');
}

async function refreshShippingQuote(preserveSelection = true) {
    if (!checkoutRequiresShipping) {
        return true;
    }

    const errorEl = document.getElementById('shipping-rate-error');
    const data = collectCheckoutData();
    const params = new URLSearchParams();
    const selectedRateId = preserveSelection ? data.shipping_rate_id : null;

    Object.entries(data.billing || {}).forEach(([key, value]) => {
        params.append('address[' + key + ']', value);
    });
    if (selectedRateId) {
        params.append('selected_rate_id', selectedRateId);
    }

    if (errorEl) {
        errorEl.classList.add('hidden');
        errorEl.textContent = '';
    }

    try {
        const res = await fetch('{base_url}/api/v1/ecommerce/shipping/rates?' + params.toString(), {
            headers: {'X-Requested-With': 'XMLHttpRequest'},
        });
        const result = await res.json();
        if (!result.ok) {
            throw new Error(result.error || 'Could not refresh shipping rates.');
        }

        renderShippingRates(result);
        updateCheckoutTotals(result.totals || {});
        return !!(result.selected_rate_id || !result.requires_shipping);
    } catch (error) {
        if (errorEl) {
            errorEl.textContent = error && error.message ? error.message : 'Could not refresh shipping rates.';
            errorEl.classList.remove('hidden');
        }
        return false;
    }
}

async function submitCheckout() {
    const btn = document.getElementById('place-order-btn');
    const errEl = document.getElementById('checkout-error');
    btn.disabled = true;
    btn.textContent = 'Placing order...';
    errEl.classList.add('hidden');

    if (checkoutRequiresShipping) {
        const quoteOk = await refreshShippingQuote(true);
        const selectedRate = document.querySelector('input[name="shipping_rate_id"]:checked');
        if (!quoteOk || !selectedRate) {
            errEl.textContent = 'Select a valid shipping method before placing the order.';
            errEl.classList.remove('hidden');
            btn.disabled = false;
            btn.textContent = 'Place Order';
            return;
        }
    }

    const data = collectCheckoutData();

    try {
        const res = await fetch('{base_url}/api/v1/ecommerce/checkout', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
            body: JSON.stringify(data),
        });
        const result = await res.json();
        if (result.ok) {
            window.location.href = result.redirect_url;
        } else {
            errEl.textContent = result.error || 'Could not place order.';
            errEl.classList.remove('hidden');
            btn.disabled = false;
            btn.textContent = 'Place Order';
        }
    } catch (error) {
        errEl.textContent = 'Network error. Please try again.';
        errEl.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Place Order';
    }
}

if (checkoutRequiresShipping) {
    ['country', 'state', 'city', 'postal_code'].forEach((field) => {
        const input = document.querySelector('[name="billing[' + field + ']"]');
        if (!input) {
            return;
        }
        input.addEventListener('change', () => { refreshShippingQuote(false); });
        input.addEventListener('blur', () => { refreshShippingQuote(false); });
    });

    document.addEventListener('change', (event) => {
        if (event.target && event.target.name === 'shipping_rate_id') {
            refreshShippingQuote(true);
        }
    });

    refreshShippingQuote(true);
}

document.querySelectorAll('#checkout-form input[name^="billing["]').forEach((input) => {
    input.addEventListener('blur', scheduleAbandonedCartCapture);
    input.addEventListener('change', scheduleAbandonedCartCapture);
});

if (abandonedCartEnabled) {
    scheduleAbandonedCartCapture();
}
</script>
{/block}
