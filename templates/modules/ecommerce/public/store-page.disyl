{extends "modules/ecommerce/layouts/public.disyl"}

{block content}
{if store_banner.headline or store_banner.subtext}
<div class="max-w-5xl mx-auto px-4 pt-8">
    <div class="relative overflow-hidden rounded-2xl {if store_banner.image_url}bg-gray-900{else}bg-orange-600{/if}"
         {if store_banner.image_url}style="background-image:url('{store_banner.image_url | escape}');background-size:cover;background-position:center;"{/if}>
        {if store_banner.image_url}<div class="absolute inset-0 bg-black/50"></div>{/if}
        <div class="relative z-10 px-8 py-12 text-center text-white">
            {if store_banner.headline}<h2 class="text-3xl font-bold tracking-tight">{store_banner.headline | escape}</h2>{/if}
            {if store_banner.subtext}<p class="mt-2 text-lg opacity-90">{store_banner.subtext | escape}</p>{/if}
            {if store_banner.cta_text}
            <a href="{store_banner.cta_url | escape}" class="mt-6 inline-flex items-center px-6 py-3 bg-white text-gray-900 font-semibold rounded-xl hover:bg-gray-100 transition-colors">
                {store_banner.cta_text | escape}
            </a>
            {/if}
        </div>
    </div>
</div>
{/if}
<div class="max-w-5xl mx-auto py-10 px-4 space-y-8">

    <!-- Store header -->
    <div class="bg-white rounded-xl border border-gray-200 p-6 flex flex-col gap-6 lg:flex-row lg:items-start">
        <div class="w-16 h-16 rounded-full bg-orange-100 flex items-center justify-center shrink-0">
            <span class="text-orange-700 font-bold text-3xl">{store.name | substr:0:1 | escape | upper}</span>
        </div>
        <div class="flex-1">
            <h1 class="text-2xl font-bold text-gray-900">{store.name | escape}</h1>
            {if store.description}
            <p class="mt-1 text-sm text-gray-600">{store.description | escape}</p>
            {/if}
            <div class="mt-3 flex flex-wrap gap-3">
                <a href="{shop_url}" class="inline-flex items-center gap-1.5 px-4 py-2 bg-orange-600 text-white text-sm font-medium rounded-lg hover:bg-orange-700">
                    Browse All Products from this Store
                </a>
                <a href="{base_url}/ecommerce/stores" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium text-gray-700 rounded-lg hover:bg-gray-50">
                    ← All Stores
                </a>
            </div>
        </div>
        {if store_hours_schedule | count > 0}
        <div class="rounded-xl border border-gray-200 bg-gray-50 px-4 py-4 min-w-[240px]">
            <div class="flex items-center justify-between gap-3">
                <h2 class="text-sm font-semibold text-gray-800">Store Hours</h2>
                {if store_is_open}
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-700 bg-emerald-50 rounded-full px-2 py-0.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block"></span> Open Now
                </span>
                {else}
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-rose-700 bg-rose-50 rounded-full px-2 py-0.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-400 inline-block"></span> Closed
                </span>
                {/if}
            </div>
            <div class="mt-3 space-y-1.5">
                {foreach store_hours_schedule as day}
                <div class="flex items-center justify-between text-xs {if day.today}font-semibold text-gray-800{else}text-gray-500{/if}">
                    <span>{day.label | substr:0:3}</span>
                    {if day.open}
                    <span>{day.from}–{day.to}</span>
                    {else}
                    <span class="text-gray-400">Closed</span>
                    {/if}
                </div>
                {/foreach}
            </div>
        </div>
        {/if}
    </div>

    <!-- Featured products from this store -->
    <div>
        <h2 class="text-lg font-semibold text-gray-800 mb-4">
            {if total > 0}Products ({total}){else}Products{/if}
        </h2>

        {if products | count == 0}
        <div class="text-center py-16 text-gray-400 bg-white rounded-xl border border-gray-200">
            <p class="text-base">No products available in this store yet.</p>
            <a href="{base_url}/ecommerce/shop" class="text-orange-600 text-sm mt-2 inline-block">Browse all products →</a>
        </div>
        {else}
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-5">
            {foreach products as p}
            <article class="group rounded-xl border border-gray-200 overflow-hidden hover:shadow-md transition-shadow bg-white">
                <a href="{base_url}/ecommerce/shop/{p.slug}" class="no-underline block">
                <div class="aspect-square overflow-hidden bg-gray-100">
                    <img src="{if p.primary_image_url}{p.primary_image_url}{else}{base_url}/assets/ecommerce/product-placeholder.svg{/if}"
                         alt="{p.title | escape}"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                </div>
                <div class="p-4">
                    <h3 class="font-medium text-gray-900 truncate text-sm">{p.title | escape}</h3>
                    {if p.excerpt}<p class="text-xs text-gray-400 mt-1 line-clamp-2">{p.excerpt | escape}</p>{/if}
                    <div class="mt-2 flex items-center gap-2">
                        {if p.pricing.on_sale}
                        <span class="font-bold text-orange-600">{p.pricing.formatted}</span>
                        <span class="text-xs text-gray-400 line-through">{p.pricing.regular_fmt}</span>
                        {else}
                        <span class="font-bold text-gray-900">{p.pricing.formatted|default:'—'}</span>
                        {/if}
                    </div>
                    {if p.inventory.track_stock && (p.inventory.out_of_stock || !p.inventory.in_stock)}
                    <div class="mt-1 text-xs text-red-500 font-medium">Out of stock</div>
                    {elseif p.inventory.track_stock && p.inventory.low_stock}
                    <div class="mt-1 text-xs text-amber-600 font-medium">Low stock</div>
                    {/if}
                </div>
                </a>
            </article>
            {/foreach}
        </div>

        {if total > products | count}
        <div class="mt-6 text-center">
            <a href="{shop_url}" class="inline-flex items-center gap-2 px-6 py-2 border border-orange-600 text-orange-600 text-sm font-medium rounded-lg hover:bg-orange-50">
                View All {total} Products from this Store →
            </a>
        </div>
        {/if}
        {/if}
    </div>

</div>
{/block}
