{extends "modules/ecommerce/layouts/public.disyl"}

{block content}
<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">My Bookings</h1>
            <p class="mt-1 text-sm text-gray-500">Appointments and services reserved through bookable ecommerce products.</p>
        </div>
        <div class="flex flex-wrap gap-2 text-xs font-semibold">
            <a href="{base_url}/ecommerce/my-wishlist" class="inline-flex items-center rounded-full border border-rose-200 bg-rose-50 px-3 py-1.5 text-rose-700 hover:bg-rose-100">Wishlist</a>
            <a href="{base_url}/ecommerce/my-orders" class="inline-flex items-center rounded-full border border-gray-200 bg-white px-3 py-1.5 text-gray-700 hover:bg-gray-50">Orders</a>
            <a href="{base_url}/ecommerce/my-memberships" class="inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-3 py-1.5 text-sky-700 hover:bg-sky-100">Memberships</a>
            <a href="{base_url}/ecommerce/rewards" class="inline-flex items-center rounded-full border border-orange-200 bg-orange-50 px-3 py-1.5 text-orange-700 hover:bg-orange-100">Rewards</a>
        </div>
    </div>

    {if flash}
    <div class="rounded-xl px-4 py-3 text-sm font-medium {if flash.type == 'success'}bg-emerald-50 text-emerald-800 border border-emerald-200{else}bg-red-50 text-red-800 border border-red-200{/if}">{flash.message}</div>
    {/if}

    {if bookings | count == 0}
    <div class="rounded-2xl border border-dashed border-gray-200 bg-white px-6 py-12 text-center">
        <div class="text-lg font-semibold text-gray-900">No bookings yet</div>
        <p class="mt-2 text-sm text-gray-500">Appointments appear here after you purchase a bookable product.</p>
    </div>
    {else}
    <div class="space-y-4">
        {foreach bookings as booking}
        <div class="rounded-2xl border {if booking.status == 'cancelled'}border-red-100{elseif booking.status == 'rescheduled'}border-gray-200{else}border-indigo-100{/if} bg-white p-5 shadow-sm">
            <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                <div>
                    <div class="text-lg font-semibold text-gray-900">{booking.product_title}</div>
                    <div class="mt-1 text-sm text-indigo-700">{booking.scheduled_for | date:'M j, Y g:i A'}</div>
                </div>
                <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold {if booking.status == 'confirmed'}bg-emerald-100 text-emerald-700{elseif booking.status == 'pending'}bg-amber-100 text-amber-700{elseif booking.status == 'cancelled'}bg-red-100 text-red-700{elseif booking.status == 'rescheduled'}bg-blue-100 text-blue-700{else}bg-gray-100 text-gray-600{/if}">{booking.status}</span>
            </div>
            <dl class="mt-4 grid grid-cols-1 gap-2 text-sm text-gray-600 md:grid-cols-3">
                <div><dt class="text-xs uppercase tracking-[0.14em] text-gray-400">Duration</dt><dd class="mt-1">{booking.duration_minutes} minutes</dd></div>
                <div><dt class="text-xs uppercase tracking-[0.14em] text-gray-400">Ends</dt><dd class="mt-1">{if booking.ends_at}{booking.ends_at | date:'M j, Y g:i A'}{else}TBD{/if}</dd></div>
                <div><dt class="text-xs uppercase tracking-[0.14em] text-gray-400">Order</dt><dd class="mt-1">{if booking.order_id}<a href="{base_url}/ecommerce/my-orders/{booking.order_id}" class="text-indigo-700 hover:underline">#{booking.order_id}</a>{else}N/A{/if}</dd></div>
            </dl>
            {if booking.notes}
            <div class="mt-4 rounded-xl bg-indigo-50 px-4 py-3 text-sm text-indigo-900">{booking.notes}</div>
            {/if}
            {if booking.status == 'cancelled' && booking.cancel_reason}
            <div class="mt-3 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-800">Cancellation reason: {booking.cancel_reason}</div>
            {/if}
            {if booking.status == 'rescheduled' && booking.rescheduled_from_id}
            <div class="mt-3 text-xs text-gray-400">This booking was replaced by a rescheduled appointment.</div>
            {/if}

            {if booking.can_reschedule || booking.can_cancel}
            <div class="mt-4 flex flex-wrap gap-3 border-t border-gray-100 pt-4">
                {if booking.can_reschedule}
                <details class="group w-full sm:w-auto">
                    <summary class="cursor-pointer inline-flex items-center gap-1.5 rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-2 text-xs font-semibold text-indigo-700 hover:bg-indigo-100">Reschedule</summary>
                    <form method="post" action="{base_url}/ecommerce/my-bookings/reschedule" class="mt-3 space-y-3 rounded-xl border border-indigo-100 bg-indigo-50/50 p-4">
                        <input type="hidden" name="_token" value="{csrf_token}">
                        <input type="hidden" name="booking_id" value="{booking.id}">
                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 mb-1">New Date</label>
                                <input type="date" name="reschedule_date" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-600 mb-1">New Time</label>
                                {if booking.product_config.time_slots | count > 0}
                                <select name="reschedule_time" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
                                    <option value="">Select time</option>
                                    {foreach booking.product_config.time_slots as slot}
                                    <option value="{slot}">{slot}</option>
                                    {/foreach}
                                </select>
                                {else}
                                <input type="time" name="reschedule_time" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
                                {/if}
                            </div>
                        </div>
                        <button type="submit" class="rounded-lg bg-indigo-600 px-4 py-2 text-xs font-semibold text-white hover:bg-indigo-700">Confirm Reschedule</button>
                    </form>
                </details>
                {/if}
                {if booking.can_cancel}
                <details class="group w-full sm:w-auto">
                    <summary class="cursor-pointer inline-flex items-center gap-1.5 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-700 hover:bg-red-100">Cancel Booking</summary>
                    <form method="post" action="{base_url}/ecommerce/my-bookings/cancel" class="mt-3 space-y-3 rounded-xl border border-red-100 bg-red-50/50 p-4" onsubmit="return confirm('Are you sure you want to cancel this booking?')">
                        <input type="hidden" name="_token" value="{csrf_token}">
                        <input type="hidden" name="booking_id" value="{booking.id}">
                        <div>
                            <label class="block text-xs font-semibold text-gray-600 mb-1">Reason (optional)</label>
                            <textarea name="cancel_reason" rows="2" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" placeholder="Why are you cancelling?"></textarea>
                        </div>
                        <button type="submit" class="rounded-lg bg-red-600 px-4 py-2 text-xs font-semibold text-white hover:bg-red-700">Confirm Cancellation</button>
                    </form>
                </details>
                {/if}
            </div>
            {/if}
        </div>
        {/foreach}
    </div>
    {/if}
</div>
{/block}