{extends "modules/ecommerce/layouts/public.disyl"}

{block content}
<div class="max-w-2xl mx-auto text-center py-10">
    <div class="mb-6 flex items-center justify-center">
        <div class="w-16 h-16 rounded-full bg-emerald-100 flex items-center justify-center">
            <svg class="w-8 h-8 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        </div>
    </div>
    <h1 class="text-2xl font-bold text-gray-900">Order placed — thank you!</h1>
    <p class="text-gray-500 mt-2">
        Order <span class="font-semibold text-gray-900">#{order.order_number}</span> has been received.
        Confirmation sent to <strong>{order.customer_email}</strong>.
    </p>

    <!-- Payment instructions -->
    {if payment_label}
    <div class="mt-6 rounded-xl border border-blue-200 bg-blue-50 p-5 text-left text-sm text-blue-900">
        <div class="font-semibold mb-1">Next step: Payment</div>
        <p>{payment_label}</p>
    </div>
    {/if}

    <!-- Order details -->
    <div class="mt-8 bg-white rounded-xl border border-gray-200 text-left overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-200">
            <h2 class="font-semibold text-gray-900">Order Details</h2>
        </div>
        <table class="w-full text-sm">
            <tbody class="divide-y divide-gray-100">
                {foreach order.items as item}
                <tr class="px-5">
                    <td class="px-5 py-3 text-gray-700">
                        <div>{item.product_title}</div>
                        {if item.selected_addons | count > 0}<div class="mt-1 text-xs text-gray-400">Add-ons: {foreach item.selected_addons as addon}{addon.label}{if !loop.last}, {/if}{/foreach}</div>{/if}
                        {if item.booking.has_booking}<div class="mt-1 text-xs text-sky-700">Appointment: {item.booking.scheduled_date} at {item.booking.scheduled_time}</div>{/if}
                        {if item.memberships | count > 0}<div class="mt-1 text-xs text-sky-700">Membership: {foreach item.memberships as membership}{membership.tier_label}{if !loop.last}, {/if}{/foreach}</div>{/if}
                    </td>
                    <td class="px-5 py-3 text-gray-400 text-center">× {item.qty}</td>
                    <td class="px-5 py-3 text-gray-900 font-medium text-right">{item.line_total_fmt}</td>
                </tr>
                {/foreach}
            </tbody>
            <tfoot class="bg-gray-50">
                {if order.non_loyalty_discount_amount > 0}
                <tr>
                    <td colspan="2" class="px-5 py-2 text-sm text-emerald-700">Discount</td>
                    <td class="px-5 py-2 text-sm text-emerald-700 text-right">−{order.non_loyalty_discount_amount_fmt}</td>
                </tr>
                {/if}
                {if order.loyalty_points_redeemed > 0}
                <tr>
                    <td colspan="2" class="px-5 py-2 text-sm text-orange-700">Loyalty ({order.loyalty_points_redeemed} pts)</td>
                    <td class="px-5 py-2 text-sm text-orange-700 text-right">−{order.loyalty_discount_amount_fmt}</td>
                </tr>
                {/if}
                {if order.tax_amount > 0}
                <tr>
                    <td colspan="2" class="px-5 py-2 text-sm text-gray-600">Tax</td>
                    <td class="px-5 py-2 text-sm text-gray-600 text-right">{order.tax_amount_fmt}</td>
                </tr>
                {/if}
                {if order.shipping_amount > 0}
                <tr>
                    <td colspan="2" class="px-5 py-2 text-sm text-gray-600">Shipping</td>
                    <td class="px-5 py-2 text-sm text-gray-600 text-right">{order.shipping_amount_fmt}</td>
                </tr>
                {/if}
                <tr class="border-t border-gray-200">
                    <td colspan="2" class="px-5 py-3 font-bold text-gray-900">Total</td>
                    <td class="px-5 py-3 font-bold text-gray-900 text-right">{order.total_amount_fmt}</td>
                </tr>
            </tfoot>
        </table>
    </div>

    {if order.memberships | count > 0 || order.bookings | count > 0}
    <div class="mt-4 grid grid-cols-1 gap-4 text-left md:grid-cols-2">
        {if order.memberships | count > 0}
        <div class="rounded-xl border border-sky-200 bg-sky-50 p-5 text-sm text-sky-900">
            <div class="font-semibold mb-2">Memberships Activated</div>
            {foreach order.memberships as membership}
            <div>{membership.tier_label}{if membership.ends_at} through {membership.ends_at | date:'M j, Y'}{/if}</div>
            {/foreach}
        </div>
        {/if}
        {if order.bookings | count > 0}
        <div class="rounded-xl border border-indigo-200 bg-indigo-50 p-5 text-sm text-indigo-900">
            <div class="font-semibold mb-2">Appointments Scheduled</div>
            {foreach order.bookings as booking}
            <div>{booking.product_title}: {booking.scheduled_for | date:'M j, Y g:i A'}</div>
            {/foreach}
        </div>
        {/if}
    </div>
    {/if}

    <!-- Shipping address -->
    <div class="mt-4 bg-white rounded-xl border border-gray-200 p-5 text-left text-sm text-gray-700">
        <div class="font-semibold text-gray-900 mb-2">Shipping to</div>
        <div>{order.shipping.first_name} {order.shipping.last_name}</div>
        <div>{order.shipping.address_line1}</div>
        {if order.shipping.address_line2}<div>{order.shipping.address_line2}</div>{/if}
        <div>{order.shipping.city}{if order.shipping.state}, {order.shipping.state}{/if} {order.shipping.postal_code}</div>
        {if order.shipping.country}<div>{order.shipping.country}</div>{/if}
        {if order.shipping.phone}<div>{order.shipping.phone}</div>{/if}
    </div>

    <div class="mt-6 flex items-center justify-center gap-4">
        {if is_logged_in}
        <a href="{base_url}/ecommerce/my-orders" class="px-6 py-2.5 bg-orange-600 text-white text-sm font-medium rounded-lg hover:bg-orange-700">View My Orders</a>
        {/if}
        <a href="{base_url}/ecommerce/shop" class="px-6 py-2.5 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50">Continue Shopping</a>
    </div>
</div>
{/block}
