<section class="moodle-panel">
    <div class="moodle-panel__body">
        <div class="moodle-kicker">Learning</div>
        <h3 class="moodle-panel__title">{block_title}</h3>

        {if courses | count > 0}
        <div class="moodle-grid" style="margin-top: 1.5rem;">
            {foreach courses as course}
            <article class="moodle-card">
                {if course.image}
                <div class="moodle-card__media">
                    <img src="{course.image}" alt="Course thumbnail" loading="lazy">
                </div>
                {/if}
                <div class="moodle-card__body">
                    <div class="moodle-kicker">Course #{course.moodle_course_id}</div>
                    <h4 class="moodle-card__title">{course.title}</h4>
                    <p class="moodle-card__summary">{course.summary | strip_tags | default:'Course details unavailable at this time.' | truncate:120}</p>
                </div>
                <div class="moodle-card__footer">
                    <span class="moodle-card__footer-copy">Self-paced</span>
                    <a href="/cms/courses/{course.moodle_course_id}" class="moodle-button moodle-button--primary">View Details</a>
                </div>
            </article>
            {/foreach}
        </div>
        <div class="moodle-actions">
            <a href="/cms/courses" class="moodle-button">Browse All Courses</a>
        </div>
        {else}
        <div class="moodle-empty" style="margin-top: 1.5rem;">No cached courses available at the moment.</div>
        {/if}
    </div>
</section>
</section>
