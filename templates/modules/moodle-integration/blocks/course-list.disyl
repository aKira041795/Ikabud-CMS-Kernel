<section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="mb-5 flex items-end justify-between gap-4">
        <div>
            <div class="text-xs font-semibold uppercase tracking-[0.25em] text-sky-600">Learning</div>
            <h3 class="mt-2 text-2xl font-bold text-slate-900">{block_title}</h3>
        </div>
        <a href="/cms/courses" class="text-sm font-semibold text-sky-700">View all</a>
    </div>
    {if courses | count > 0}
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
        {foreach courses as course}
        <a href="/cms/courses/{course.moodle_course_id}" class="rounded-2xl border border-slate-200 p-4 hover:border-sky-300 hover:bg-sky-50/40">
            <div class="text-sm font-semibold text-slate-900">{course.title}</div>
            <div class="mt-2 text-xs text-slate-500">Course #{course.moodle_course_id}</div>
        </a>
        {/foreach}
    </div>
    {else}
    <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-4 py-10 text-center text-sm text-slate-500">No cached courses available.</div>
    {/if}
</section>