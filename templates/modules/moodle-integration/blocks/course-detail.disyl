<section class="moodle-panel">
    <div class="moodle-panel__body">
        {if course}
        <div class="moodle-kicker">Featured Course</div>
        <h3 class="moodle-panel__title">{course.title}</h3>
        <p class="moodle-card__summary">{course.summary | strip_tags | default:'Course details unavailable.'}</p>
        <div class="moodle-actions">
            <a href="/cms/courses/{course.moodle_course_id}" class="moodle-button moodle-button--primary">Open details</a>
        </div>
        {else}
        <div class="moodle-empty">Course details are unavailable until this course is synced into the local cache.</div>
        {/if}
    </div>
</section>
