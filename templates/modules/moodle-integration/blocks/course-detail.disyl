<section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
    {if course}
    <div class="text-xs font-semibold uppercase tracking-[0.25em] text-sky-600">Featured Course</div>
    <h3 class="mt-2 text-2xl font-bold text-slate-900">{course.title}</h3>
    <div class="mt-4 text-sm leading-6 text-slate-600">{course.summary | strip_tags | default:'Course details unavailable.'}</div>
    <a href="/cms/courses/{course.moodle_course_id}" class="mt-5 inline-flex items-center rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white">Open details</a>
    {else}
    <div class="text-sm text-slate-500">Course details are unavailable until this course is synced into the local cache.</div>
    {/if}
</section>