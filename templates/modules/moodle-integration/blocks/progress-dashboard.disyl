<section class="moodle-panel moodle-progress-board">
    <div class="moodle-panel__body">
    <div class="moodle-progress-board__header">
        <div>
            <div class="moodle-kicker">Dashboard</div>
            <h3 class="moodle-panel__title">{block_title}</h3>
            <p class="moodle-page__lead">A quick snapshot of course completion and progress that has already synced back from Moodle into this learner record.</p>
        </div>
        {if is_authenticated}
        <div class="moodle-page__meta">
            <span class="moodle-page__pill">{course_count} tracked courses</span>
            <span class="moodle-page__pill">{completed_count} completed</span>
        </div>
        {/if}
    </div>
    {if not is_authenticated}
    <div class="moodle-empty moodle-empty--soft">
        <div class="moodle-kicker">Learner Access</div>
        <h4 class="moodle-panel__title">Sign in to load your Moodle progress dashboard.</h4>
        <p class="moodle-page__lead">Progress appears here only for the authenticated learner account linked to the Moodle bridge.</p>
        <div class="moodle-actions">
            <a href="{login_url}" class="moodle-button moodle-button--primary">Sign in</a>
        </div>
    </div>
    {elseif courses | count > 0}
    <div class="moodle-progress-board__grid">
        <div class="moodle-progress-metric">
            <div class="moodle-progress-metric__label">Average Progress</div>
            <div class="moodle-progress-metric__value">{average_progress}%</div>
        </div>
        <div class="moodle-progress-metric">
            <div class="moodle-progress-metric__label">Completed Paths</div>
            <div class="moodle-progress-metric__value">{completed_count}</div>
        </div>
    </div>
    <div class="moodle-progress-list">
        {foreach courses as course}
        <article class="moodle-progress-card">
            <div class="moodle-progress-card__body">
                <div class="moodle-progress-card__header">
                    <div>
                        <h4 class="moodle-progress-card__title">{course.title | default:'Untitled Course'}</h4>
                        <div class="moodle-progress-card__meta">Status: {course.status | default:'not_started'} • Last synced: {course.last_synced | default:'Pending sync'}</div>
                    </div>
                    <div class="moodle-stat-pill">{course.progress_percent | default:0}%</div>
                </div>
                <div class="moodle-progress-bar" aria-label="Course progress">
                    <span class="moodle-progress-bar__value" style="width:{course.progress_percent | default:0}%;"></span>
                </div>
                <div class="moodle-progress-card__footer">
                    <div class="moodle-stat">{if queued_course_id > 0 and course.moodle_course_id == queued_course_id}Recently queued from enrollment.{else}Local progress cache is ready for launch.{/if}</div>
                    <a href="/cms/course/{course.moodle_course_id}/launch" class="moodle-button">Launch</a>
                </div>
            </div>
        </article>
        {/foreach}
    </div>
    {else}
    <div class="moodle-empty moodle-empty--soft">No progress data available yet. Once enrollment sync completes, course completion bars will appear here.</div>
    {/if}
</div>
</section>