{theme_styles | raw}
<section class="moodle-page moodle-page--courses">
    <div class="moodle-page__intro">
        <div class="moodle-page__intro-body">
            <div class="moodle-page__eyebrow">Learning Center</div>
            <p class="moodle-page__lead">Courses are served from the local cache, so this page continues to work even when Moodle itself is temporarily offline.</p>
            <div class="moodle-page__meta">
                <span class="moodle-page__pill">Tenant cache ready</span>
                <span class="moodle-page__pill">Launches use Moodle SSO</span>
            </div>
        </div>
    </div>

    {if not is_configured}
    <div class="moodle-page__notice">Moodle is not configured for this tenant yet. Cached results will appear here after configuration and sync.</div>
    {/if}

    {if courses | count > 0}
    <div class="cms-entity-list__grid moodle-grid">
        {foreach courses as course}
        <article class="cms-entity-card moodle-card group">
            {if course.image}
            <div class="moodle-card__media">
                <img src="{course.image}" alt="{course.title}" onerror="this.parentNode.style.display='none'">
            </div>
            {/if}
            <div class="cms-entity-card__body moodle-card__body">
                <div class="moodle-kicker">Course #{course.moodle_course_id}</div>
                <h2 class="cms-entity-card__title moodle-card__title">{course.title}</h2>
                <p class="cms-entity-card__excerpt moodle-card__summary">{course.summary | strip_tags | default:'Course summary unavailable.' | truncate:120}</p>
            </div>
            <div class="moodle-card__footer" style="flex-direction: column; align-items: stretch; gap: 1rem;">
                <div class="moodle-card__footer-copy" style="text-align: center;">Open details, then queue enrollment before launching.</div>
                <div class="moodle-actions" style="margin-top: 0; display: grid; gap: 0.5rem; grid-template-columns: 1fr 1fr;">
                    <a href="/cms/courses/{course.moodle_course_id}" class="moodle-button moodle-button--primary" style="width: 100%;">View details</a>
                    <a href="/cms/course/{course.moodle_course_id}/enroll" class="moodle-button" style="width: 100%;">Enroll</a>
                </div>
            </div>
        </article>
        {/foreach}
    </div>
    {else}
    <div class="moodle-empty">No cached courses are available yet.</div>
    {/if}
</section>
