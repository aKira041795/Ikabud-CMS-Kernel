{!-- Dashboard Stats Cards - Returned by HTMX polling --}

{!-- Row 1: Primary KPI Cards --}
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    {!-- Active Cases --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 relative overflow-hidden">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-3xl font-bold text-gray-900">{stats.active_cases | default:'0'}</p>
                <p class="text-sm text-gray-500 mt-1">Active Cases</p>
            </div>
            <div class="w-12 h-12 bg-indigo-50 rounded-xl flex items-center justify-center">
                <i class="fas fa-folder-open text-indigo-600 text-lg"></i>
            </div>
        </div>
        <div class="absolute bottom-0 left-0 right-0 h-1 bg-indigo-500"></div>
    </div>
    
    {!-- Critical Cases --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 relative overflow-hidden">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-3xl font-bold {if stats.critical_cases > 0}text-red-600{else}text-gray-900{/if}">{stats.critical_cases | default:'0'}</p>
                <p class="text-sm text-gray-500 mt-1">Critical</p>
            </div>
            <div class="w-12 h-12 bg-red-50 rounded-xl flex items-center justify-center">
                <i class="fas fa-exclamation-triangle text-red-500 text-lg"></i>
            </div>
        </div>
        {if stats.critical_cases > 0}
        <a href="{base_url}/cases?severity=critical" class="block mt-2 text-xs text-red-600 hover:underline font-medium">
            <i class="fas fa-arrow-right mr-1"></i> View critical
        </a>
        {/if}
        <div class="absolute bottom-0 left-0 right-0 h-1 bg-red-500"></div>
    </div>
    
    {!-- Today's Appointments --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 relative overflow-hidden">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-3xl font-bold text-gray-900">{stats.today_appointments | default:'0'}</p>
                <p class="text-sm text-gray-500 mt-1">Today's Appointments</p>
            </div>
            <div class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center">
                <i class="fas fa-calendar-check text-green-600 text-lg"></i>
            </div>
        </div>
        <div class="absolute bottom-0 left-0 right-0 h-1 bg-green-500"></div>
    </div>
    
    {!-- Pending Approvals --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 relative overflow-hidden">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-3xl font-bold {if stats.pending_approvals > 0}text-amber-600{else}text-gray-900{/if}">{stats.pending_approvals | default:'0'}</p>
                <p class="text-sm text-gray-500 mt-1">Pending Approvals</p>
            </div>
            <div class="w-12 h-12 bg-amber-50 rounded-xl flex items-center justify-center">
                <i class="fas fa-hourglass-half text-amber-500 text-lg"></i>
            </div>
        </div>
        {if stats.pending_approvals > 0}
        <a href="{base_url}/appointments?status=pending" class="block mt-2 text-xs text-amber-600 hover:underline font-medium">
            <i class="fas fa-arrow-right mr-1"></i> Review now
        </a>
        {/if}
        <div class="absolute bottom-0 left-0 right-0 h-1 bg-amber-500"></div>
    </div>
</div>

{!-- Row 2: Secondary Stats --}
<div class="grid grid-cols-3 gap-4 mb-6">
    {!-- Cases This Month --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex items-center space-x-4">
        <div class="w-10 h-10 bg-blue-50 rounded-lg flex items-center justify-center flex-shrink-0">
            <i class="fas fa-chart-line text-blue-600"></i>
        </div>
        <div>
            <p class="text-xl font-bold text-gray-900">{stats.cases_this_month | default:'0'}</p>
            <p class="text-xs text-gray-500">New This Month</p>
        </div>
    </div>
    
    {!-- Session Hours This Week --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex items-center space-x-4">
        <div class="w-10 h-10 bg-purple-50 rounded-lg flex items-center justify-center flex-shrink-0">
            <i class="fas fa-clock text-purple-600"></i>
        </div>
        <div>
            <p class="text-xl font-bold text-gray-900">{stats.session_hours_week | default:'0'}h</p>
            <p class="text-xs text-gray-500">Session Hours (Week)</p>
        </div>
    </div>
    
    {!-- Overdue Follow-ups --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex items-center space-x-4 {if stats.overdue_followups > 0}border-orange-200 bg-orange-50{/if}">
        <div class="w-10 h-10 {if stats.overdue_followups > 0}bg-orange-100{else}bg-gray-50{/if} rounded-lg flex items-center justify-center flex-shrink-0">
            <i class="fas fa-bell {if stats.overdue_followups > 0}text-orange-600{else}text-gray-400{/if}"></i>
        </div>
        <div>
            <p class="text-xl font-bold {if stats.overdue_followups > 0}text-orange-600{else}text-gray-900{/if}">{stats.overdue_followups | default:'0'}</p>
            <p class="text-xs text-gray-500">Overdue Follow-ups</p>
        </div>
    </div>
</div>

{!-- Row 3: Category Breakdown + Overdue Follow-ups --}
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {!-- Cases by Category Mini-Chart --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
        <h3 class="text-sm font-semibold text-gray-700 mb-3">
            <i class="fas fa-th-large text-indigo-500 mr-2"></i>Active Cases by Category
        </h3>
        {if stats.category_breakdown | count > 0}
        <div class="space-y-2">
            {each stats.category_breakdown as cat}
            <div class="flex items-center justify-between text-sm">
                <span class="text-gray-600 w-28 truncate">{cat.name}</span>
                <div class="flex-1 mx-3">
                    <div class="w-full h-2 bg-gray-100 rounded-full overflow-hidden">
                        <div class="h-full bg-indigo-500 rounded-full" style="width: {cat.pct}%"></div>
                    </div>
                </div>
                <span class="text-gray-900 font-medium w-8 text-right">{cat.count}</span>
            </div>
            {/each}
        </div>
        {else}
        <p class="text-sm text-gray-400 text-center py-4">No active cases</p>
        {/if}
    </div>
    
    {!-- Overdue Follow-ups List --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
        <h3 class="text-sm font-semibold text-gray-700 mb-3">
            <i class="fas fa-clock text-orange-500 mr-2"></i>Overdue Follow-ups
        </h3>
        {if stats.overdue_cases | count > 0}
        <div class="space-y-2">
            {each stats.overdue_cases as oc}
            <a href="{base_url}/cases/{oc.id}" 
               hx-get="/pages/cases/{oc.id}" hx-target="#main-content" hx-push-url="{base_url}/cases/{oc.id}"
               class="flex items-center justify-between p-2 rounded-lg hover:bg-orange-50 transition group">
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-gray-900 truncate group-hover:text-orange-700">{oc.student_name}</p>
                    <p class="text-xs text-gray-500">{oc.case_number} &middot; Due: {oc.next_followup_date}</p>
                </div>
                <span class="ml-2 px-2 py-0.5 text-xs font-medium rounded-full
                    {if oc.severity == 'critical'}bg-red-100 text-red-700
                    {elseif oc.severity == 'high'}bg-orange-100 text-orange-700
                    {else}bg-gray-100 text-gray-600{/if}">
                    {oc.severity}
                </span>
            </a>
            {/each}
        </div>
        {else}
        <div class="text-center py-4">
            <i class="fas fa-check-circle text-2xl text-green-300 mb-2"></i>
            <p class="text-sm text-gray-400">All follow-ups are on track</p>
        </div>
        {/if}
    </div>
</div>
