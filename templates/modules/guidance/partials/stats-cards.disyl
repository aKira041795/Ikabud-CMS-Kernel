{!-- Dashboard Stats Cards - Guidance Counseling System --}
{!-- 5-card layout: Total Students, Low Risk, Moderate Risk, High Risk, Probationary --}

<div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-5 gap-4 mb-6">

    {!-- Total Students --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
        <div class="w-14 h-14 rounded-full bg-teal-100 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-users text-teal-600 text-xl"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-gray-900">{stats.total_students | default:'0'}</p>
            <p class="text-sm font-medium text-gray-700">Total Students</p>
            <p class="text-xs text-gray-400">All enrolled students</p>
        </div>
    </div>

    {!-- Low Risk --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
        <div class="w-14 h-14 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-shield-alt text-green-600 text-xl"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-gray-900">{stats.low_risk | default:'0'}</p>
            <p class="text-sm font-medium text-gray-700">Low Risk</p>
            <p class="text-xs text-gray-400">{stats.low_risk_pct | default:'0'}% of total</p>
        </div>
    </div>

    {!-- Moderate Risk --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
        <div class="w-14 h-14 rounded-full bg-orange-100 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-exclamation-circle text-orange-500 text-xl"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-gray-900">{stats.moderate_risk | default:'0'}</p>
            <p class="text-sm font-medium text-gray-700">Moderate Risk</p>
            <p class="text-xs text-gray-400">{stats.moderate_risk_pct | default:'0'}% of total</p>
        </div>
    </div>

    {!-- High Risk --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
        <div class="w-14 h-14 rounded-full bg-red-100 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-exclamation-triangle text-red-500 text-xl"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-gray-900">{stats.high_risk | default:'0'}</p>
            <p class="text-sm font-medium text-gray-700">High Risk</p>
            <p class="text-xs text-gray-400">{stats.high_risk_pct | default:'0'}% of total</p>
        </div>
    </div>

    {!-- Probationary --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
        <div class="w-14 h-14 rounded-full bg-purple-100 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-user-clock text-purple-500 text-xl"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-gray-900">{stats.probationary | default:'0'}</p>
            <p class="text-sm font-medium text-gray-700">Probationary</p>
            <p class="text-xs text-gray-400">{stats.probationary_pct | default:'0'}% of total</p>
        </div>
    </div>

</div>
