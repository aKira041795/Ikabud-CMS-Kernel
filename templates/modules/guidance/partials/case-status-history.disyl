{if history}
<div class="divide-y divide-gray-100">
    {foreach history as item}
    <div class="px-6 py-4">
        <div class="flex items-start justify-between gap-3">
            <div>
                <div class="flex items-center gap-2 text-sm font-medium text-gray-900">
                    <span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-semibold text-indigo-700 border border-indigo-200">
                        {item.new_status | title}
                    </span>
                    {if item.previous_status}
                    <span class="text-xs text-gray-400">from {item.previous_status | title}</span>
                    {/if}
                </div>
                <div class="mt-1 text-xs text-gray-500">
                    {item.changed_by_name | default:'System'}
                </div>
            </div>
            <div class="text-xs text-gray-400 whitespace-nowrap">{item.created_at}</div>
        </div>
        {if item.notes}
        <div class="mt-2 text-sm text-gray-600">{item.notes | esc_html | nl2br}</div>
        {/if}
    </div>
    {/foreach}
</div>
{else}
<div class="px-6 py-8 text-sm text-gray-500 text-center">
    <i class="fas fa-clock-rotate-left mr-2"></i>No status changes recorded yet.
</div>
{/if}