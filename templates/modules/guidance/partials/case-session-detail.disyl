{!-- Case Session Detail Panel --}
{!-- Rendered by apiGuidanceCaseSessionDetail --}

<div class="flex flex-col h-full border-l-0">

    {!-- Panel header --}
    <div class="px-5 py-3.5 border-b border-gray-100 flex items-center justify-between bg-white">
        <span class="text-xs font-semibold text-gray-700 uppercase tracking-wide flex items-center gap-2">
            <i class="fas fa-clipboard-list text-teal-500"></i> Session Details
        </span>
        {if appt.status == 'completed'}
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-green-100 text-green-700">Completed</span>
        {elseif appt.status == 'cancelled'}
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-red-100 text-red-600">Cancelled</span>
        {elseif appt.status == 'no_show'}
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-orange-100 text-orange-700">No Show</span>
        {elseif appt.status == 'in_progress'}
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-amber-100 text-amber-700">In Progress</span>
        {elseif appt.status == 'scheduled' || appt.status == 'confirmed'}
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-blue-100 text-blue-700">{appt.status | title}</span>
        {else}
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-gray-100 text-gray-600">{appt.status | title}</span>
        {/if}
    </div>

    {!-- Detail fields --}
    <div class="px-5 py-4 space-y-3 border-b border-gray-100">
        <div>
            <div class="text-[11px] font-semibold text-gray-400 uppercase tracking-wide mb-0.5">Purpose / Type</div>
            <div class="text-sm font-semibold text-gray-800">{appt.type_name | default:'—' | esc_html}</div>
            {if appt.purpose}
            <div class="text-xs text-gray-500 mt-0.5">{appt.purpose | esc_html}</div>
            {/if}
        </div>
        <div>
            <div class="text-[11px] font-semibold text-gray-400 uppercase tracking-wide mb-0.5">Date &amp; Time</div>
            <div class="text-sm text-gray-700">
                {appt.formatted_date} &bull;
                {appt.formatted_time}{if appt.formatted_end} &ndash; {appt.formatted_end}{/if}
            </div>
        </div>
        <div>
            <div class="text-[11px] font-semibold text-gray-400 uppercase tracking-wide mb-0.5">Counselor</div>
            <div class="text-sm text-gray-700">{appt.counselor_name | default:'—' | esc_html}</div>
        </div>
        <div>
            <div class="text-[11px] font-semibold text-gray-400 uppercase tracking-wide mb-0.5">Duration</div>
            <div class="text-sm text-gray-700">{appt.duration_label | default:'—' | esc_html}</div>
        </div>
        {if appt.location}
        <div>
            <div class="text-[11px] font-semibold text-gray-400 uppercase tracking-wide mb-0.5">Location</div>
            <div class="text-sm text-gray-700">{appt.location | esc_html}</div>
        </div>
        {/if}
        <div>
            <div class="text-[11px] font-semibold text-gray-400 uppercase tracking-wide mb-1">Status</div>
            {if appt.status == 'completed'}
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-200">
                <i class="fas fa-check-circle text-[10px]"></i> Went to Session
            </span>
            {elseif appt.status == 'no_show'}
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-orange-50 text-orange-700 border border-orange-200">
                <i class="fas fa-clock text-[10px]"></i> Did Not Show Up
            </span>
            {elseif appt.status == 'cancelled'}
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-600 border border-red-200">
                <i class="fas fa-times-circle text-[10px]"></i> Cancelled
            </span>
            {elseif appt.status == 'in_progress'}
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                <i class="fas fa-circle text-[10px]"></i> Follow-up Needed
            </span>
            {else}
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                <i class="fas fa-calendar-check text-[10px]"></i> {appt.status | title}
            </span>
            {/if}
        </div>
    </div>

    {!-- Session Summary --}
    <div class="px-5 py-4 border-b border-gray-100">
        <div class="text-xs font-semibold text-gray-700 mb-2">Session Summary</div>
        {if note.note_content}
        <p class="text-xs text-gray-600 leading-relaxed whitespace-pre-wrap">{note.note_content | esc_html}</p>
        {else}
        <p class="text-xs text-gray-300 italic">No summary recorded for this session.</p>
        {/if}
    </div>

    {!-- Notes / Recommendations --}
    {if note.observation_recommendation}
    <div class="px-5 py-4 border-b border-gray-100">
        <div class="text-xs font-semibold text-gray-700 mb-2">Notes / Recommendations</div>
        <p class="text-xs text-gray-600 leading-relaxed whitespace-pre-wrap">{note.observation_recommendation | esc_html}</p>
    </div>
    {/if}

    {!-- Attachments --}
    {if attachments | count > 0}
    <div class="px-5 py-4 border-b border-gray-100">
        <div class="text-xs font-semibold text-gray-700 mb-3">Attachments</div>
        <div class="space-y-2">
            {for att in attachments}
            <div class="flex items-center gap-2 p-2.5 rounded-lg border border-gray-100 bg-gray-50 group hover:border-teal-200 transition-colors">
                <div class="w-8 h-8 rounded-lg bg-red-50 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-file-pdf text-red-500 text-xs"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-xs font-medium text-gray-700 truncate">{att.file_name | esc_html}</div>
                    <div class="text-[11px] text-gray-400 uppercase tracking-wide">{att.file_type | upper | default:'FILE'}</div>
                </div>
                <button class="w-7 h-7 flex items-center justify-center rounded-lg text-gray-400 hover:bg-teal-50 hover:text-teal-600 transition-colors opacity-0 group-hover:opacity-100">
                    <i class="fas fa-download text-[10px]"></i>
                </button>
            </div>
            {/for}
        </div>
    </div>
    {/if}

    {!-- Action buttons --}
    <div class="px-5 py-4 flex items-center gap-2 mt-auto">
        <button hx-get="/pages/appointments/{appt.id}/edit"
                hx-target="#modal-container" hx-swap="innerHTML"
                class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg border border-gray-200 text-xs font-semibold text-gray-700 hover:bg-gray-50 transition-colors">
            <i class="fas fa-edit text-[10px]"></i> Edit Record
        </button>
        <button hx-get="/pages/appointments/{appt.id}/followup"
                hx-target="#modal-container" hx-swap="innerHTML"
                class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg bg-teal-700 text-white text-xs font-semibold hover:bg-teal-800 transition-colors shadow-sm">
            <i class="fas fa-plus text-[10px]"></i> Add Follow-up
        </button>
    </div>

</div>
