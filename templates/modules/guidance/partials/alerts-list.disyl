{!-- Alerts list partial — rendered by apiGuidanceAlertsList --}

{if notifications}

    {foreach notifications as n}
    <div id="alert-row-{n.id}"
         class="alert-row flex items-start gap-4 px-6 py-4 border-b border-gray-50 hover:bg-gray-50 transition-colors {if !n.is_read}bg-teal-50{/if}"
         {if n.link}hx-get="{n.link}" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="{base_url}{n.link}"{/if}
         hx-on:click="guidanceMarkOneRead({n.id})"
         style="cursor:{if n.link}pointer{else}default{/if}">

        {!-- Type icon with unread dot --}
        <div class="relative flex-shrink-0 mt-0.5">
            <span class="w-10 h-10 rounded-full flex items-center justify-center {n.type_icon_bg}">
                <i class="fas {n.type_icon} text-sm"></i>
            </span>
            {if !n.is_read}
            <span class="alert-unread-dot absolute -top-0.5 -right-0.5 w-3 h-3 bg-blue-500 border-2 border-white rounded-full"></span>
            {/if}
        </div>

        {!-- Body --}
        <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-3">
                <div class="flex-1 min-w-0">
                    <p class="text-sm {if !n.is_read}font-bold{else}font-semibold{/if} text-gray-900">{n.title | esc_html}</p>
                    <p class="text-sm text-gray-500 mt-0.5">{n.message | esc_html}</p>
                    <div class="flex items-center gap-2 mt-1.5 flex-wrap">
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium {n.type_badge}">{n.type_label}</span>
                        <span class="text-xs text-gray-400">&bull; {n.time_ago}</span>
                    </div>
                </div>
                <div class="flex items-center gap-2 flex-shrink-0 mt-0.5">
                    {if !n.is_read}
                    <span class="alert-new-badge inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-teal-50 text-teal-700 border border-teal-200">New</span>
                    {else}
                    <span class="alert-new-badge text-xs text-gray-400 font-medium">Read</span>
                    {/if}
                    {if n.link}
                    <span class="text-gray-300 ml-1"><i class="fas fa-chevron-right text-xs"></i></span>
                    {/if}
                </div>
            </div>
        </div>

    </div>
    {/foreach}

    {!-- Footer: count + pagination --}
    <div class="flex items-center justify-between px-6 py-4 border-t border-gray-100 bg-gray-50/60">
        <p class="text-sm text-gray-500">
            {if total > 0}
            Showing {from} to {to} of {total} alert{if total != 1}s{/if}
            {else}
            No alerts found
            {/if}
        </p>
        {if total_pages > 1}
        <div class="flex items-center gap-1">

            {!-- Prev --}
            <button type="button"
                    onclick="document.getElementById('af-page').value='{prev_page}'"
                    hx-get="/api/alerts" hx-target="#alerts-list" hx-include="#af" hx-swap="innerHTML"
                    {if !has_prev}disabled{/if}
                    class="w-8 h-8 flex items-center justify-center rounded-lg border text-sm transition {if has_prev}border-gray-200 hover:bg-gray-100 text-gray-600{else}border-gray-100 text-gray-300 cursor-not-allowed{/if}">
                <i class="fas fa-chevron-left text-xs"></i>
            </button>

            {!-- Page numbers --}
            {foreach page_links as pl}
            {if pl.ellipsis}
            <span class="w-8 h-8 flex items-center justify-center text-gray-400 text-sm">&hellip;</span>
            {else}
            <button type="button"
                    onclick="document.getElementById('af-page').value='{pl.num}'"
                    hx-get="/api/alerts" hx-target="#alerts-list" hx-include="#af" hx-swap="innerHTML"
                    class="w-8 h-8 flex items-center justify-center rounded-lg text-sm font-medium transition {if pl.active}bg-teal-600 text-white border border-teal-600{else}border border-gray-200 hover:bg-gray-100 text-gray-600{/if}">
                {pl.num}
            </button>
            {/if}
            {/foreach}

            {!-- Next --}
            <button type="button"
                    onclick="document.getElementById('af-page').value='{next_page}'"
                    hx-get="/api/alerts" hx-target="#alerts-list" hx-include="#af" hx-swap="innerHTML"
                    {if !has_next}disabled{/if}
                    class="w-8 h-8 flex items-center justify-center rounded-lg border text-sm transition {if has_next}border-gray-200 hover:bg-gray-100 text-gray-600{else}border-gray-100 text-gray-300 cursor-not-allowed{/if}">
                <i class="fas fa-chevron-right text-xs"></i>
            </button>

        </div>
        {/if}
    </div>

{else}

    {!-- Empty state --}
    <div class="flex flex-col items-center justify-center py-20 text-center">
        <div class="w-16 h-16 rounded-full bg-gray-50 flex items-center justify-center mb-4">
            <i class="fas fa-bell-slash text-2xl text-gray-300"></i>
        </div>
        <h3 class="text-base font-semibold text-gray-700 mb-1">No notifications</h3>
        <p class="text-sm text-gray-400">Nothing to show for this filter.</p>
    </div>

{/if}
