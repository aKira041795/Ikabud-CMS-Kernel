{!-- Pending Approvals Widget --}
{if pending_appointments | count > 0}
<div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
    <div class="flex items-center justify-between mb-3">
        <h3 class="text-sm font-semibold text-amber-800">
            <i class="fas fa-hourglass-half mr-2"></i> Pending Approvals
        </h3>
        <span class="px-2 py-0.5 bg-amber-200 text-amber-800 text-xs font-medium rounded-full">
            {pending_appointments | count}
        </span>
    </div>
    
    <div class="space-y-2 max-h-48 overflow-y-auto">
        {foreach pending_appointments as appt}
        <div class="bg-white rounded-lg p-3 border border-amber-100 shadow-sm">
            <div class="flex items-start justify-between">
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-900 truncate">{appt.student_name}</p>
                    <p class="text-xs text-gray-500">
                        {appt.scheduled_date | date:'M d'} at {appt.scheduled_time | date:'g:i A'}
                    </p>
                    {if appt.type_name}
                    <span class="inline-block mt-1 px-1.5 py-0.5 bg-gray-100 text-gray-600 text-xs rounded">
                        {appt.type_name}
                    </span>
                    {/if}
                </div>
                <div class="flex space-x-1 ml-2">
                    <button hx-post="/api/appointments/{appt.id}/approve" 
                            hx-swap="none"
                            hx-confirm="Approve this appointment?"
                            class="p-1.5 bg-green-100 text-green-700 rounded hover:bg-green-200 transition-colors"
                            title="Approve">
                        <i class="fas fa-check text-xs"></i>
                    </button>
                    <button hx-post="/api/appointments/{appt.id}/reject" 
                            hx-swap="none"
                            hx-confirm="Reject this appointment?"
                            class="p-1.5 bg-red-100 text-red-700 rounded hover:bg-red-200 transition-colors"
                            title="Reject">
                        <i class="fas fa-times text-xs"></i>
                    </button>
                </div>
            </div>
        </div>
        {/foreach}
    </div>
    
    {if pending_appointments | count > 3}
    <a href="{base_url}/appointments?status=pending" class="block mt-3 text-center text-xs text-amber-700 hover:underline">
        View all pending appointments →
    </a>
    {/if}
</div>
{/if}
