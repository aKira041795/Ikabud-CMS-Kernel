{!-- Users Table Partial --}

{!-- Stat Pills (admin only) --}
{if is_admin}
<div class="flex flex-wrap gap-3 mb-5">
    <div class="flex items-center gap-2 px-3 py-2 bg-purple-50 rounded-lg border border-purple-100">
        <i class="fas fa-user-shield text-purple-500 text-sm"></i>
        <span class="text-sm font-semibold text-purple-700">{stats.admin | default:'0'}</span>
        <span class="text-xs text-purple-600">Admins</span>
    </div>
    <div class="flex items-center gap-2 px-3 py-2 bg-blue-50 rounded-lg border border-blue-100">
        <i class="fas fa-user-md text-blue-500 text-sm"></i>
        <span class="text-sm font-semibold text-blue-700">{stats.counselor | default:'0'}</span>
        <span class="text-xs text-blue-600">Counselors</span>
    </div>
    <div class="flex items-center gap-2 px-3 py-2 bg-green-50 rounded-lg border border-green-100">
        <i class="fas fa-user-tie text-green-500 text-sm"></i>
        <span class="text-sm font-semibold text-green-700">{stats.supervisor | default:'0'}</span>
        <span class="text-xs text-green-600">Supervisors</span>
    </div>
    <div class="flex items-center gap-2 px-3 py-2 bg-gray-50 rounded-lg border border-gray-200 ml-auto">
        <span class="text-xs text-gray-500">Showing <strong class="text-gray-700">{result_count | default:'0'}</strong> users</span>
    </div>
</div>
{/if}

{if users | count > 0}
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
                {if is_admin}
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Colleges</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Joined</th>
                {/if}
                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            {foreach users as user}
            <tr class="hover:bg-gray-50 group transition">
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                        <div class="w-9 h-9 rounded-full flex items-center justify-center text-white font-medium text-sm
                            {if user.role == 'admin'}bg-purple-600
                            {elseif user.role == 'counselor'}bg-blue-600
                            {elseif user.role == 'supervisor'}bg-green-600
                            {else}bg-gray-500{/if}">
                            {user.first_name | first | upper}{user.last_name | first | upper}
                        </div>
                        <div class="ml-3">
                            <div class="text-sm font-semibold text-gray-900">{user.first_name} {user.last_name}</div>
                        </div>
                    </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{user.email}</td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <span class="px-2.5 py-1 text-xs font-semibold rounded-full inline-flex items-center gap-1
                        {if user.role == 'admin'}bg-purple-100 text-purple-800
                        {elseif user.role == 'counselor'}bg-blue-100 text-blue-800
                        {elseif user.role == 'supervisor'}bg-green-100 text-green-800
                        {else}bg-gray-100 text-gray-600{/if}">
                        {if user.role == 'admin'}<i class="fas fa-user-shield text-[10px]"></i>{/if}
                        {if user.role == 'counselor'}<i class="fas fa-user-md text-[10px]"></i>{/if}
                        {if user.role == 'supervisor'}<i class="fas fa-user-tie text-[10px]"></i>{/if}
                        {user.role | capitalize}
                    </span>
                </td>
                {if is_admin}
                <td class="px-6 py-4 whitespace-nowrap">
                    {if user.id == current_user_id}
                    <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 text-green-700">Active</span>
                    <span class="text-[10px] text-gray-400 ml-1">(you)</span>
                    {elseif user.is_active == '1'}
                    <button hx-post="{base_url}/api/users/{user.id}/toggle-active"
                            hx-confirm="Deactivate this user? They will not be able to log in."
                            hx-target="#users-list" hx-swap="innerHTML"
                            class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 text-green-700 hover:bg-green-200 transition cursor-pointer" title="Click to deactivate">
                        <i class="fas fa-toggle-on mr-0.5 text-[10px]"></i>Active
                    </button>
                    {else}
                    <button hx-post="{base_url}/api/users/{user.id}/toggle-active"
                            hx-confirm="Activate this user?"
                            hx-target="#users-list" hx-swap="innerHTML"
                            class="px-2 py-0.5 text-xs font-medium rounded-full bg-red-100 text-red-700 hover:bg-red-200 transition cursor-pointer" title="Click to activate">
                        <i class="fas fa-toggle-off mr-0.5 text-[10px]"></i>Inactive
                    </button>
                    {/if}
                </td>
                <td class="px-6 py-4">
                    {if user.colleges_display}
                    <span class="text-xs font-medium text-indigo-700 bg-indigo-50 border border-indigo-200 rounded px-2 py-0.5">{user.colleges_display}</span>
                    {else}
                    <span class="text-xs text-gray-400 italic">—</span>
                    {/if}
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{user.created_at | date:'M d, Y'}</td>
                {/if}
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                    <div class="flex items-center justify-end gap-1 opacity-70 group-hover:opacity-100 transition">
                        <button hx-get="{base_url}/pages/users/{user.id}/edit" hx-target="#modal-container" hx-swap="innerHTML"
                                class="p-1.5 bg-indigo-50 text-indigo-600 rounded-lg hover:bg-indigo-100 transition" title="Edit">
                            <i class="fas fa-pen text-xs"></i>
                        </button>
                        {if is_admin}
                        {if user.id != current_user_id}
                        <button hx-delete="{base_url}/api/users/{user.id}" hx-confirm="Are you sure you want to delete this user?" hx-target="#users-list" hx-swap="innerHTML"
                                class="p-1.5 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition" title="Delete">
                            <i class="fas fa-trash text-xs"></i>
                        </button>
                        {/if}
                        {/if}
                    </div>
                </td>
            </tr>
            {/foreach}
        </tbody>
    </table>
</div>

{else}
<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-12 text-center">
    <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <i class="fas fa-users text-gray-400 text-2xl"></i>
    </div>
    <h3 class="text-lg font-medium text-gray-900 mb-2">No users found</h3>
    <p class="text-gray-500 mb-4">Try adjusting your search or add a new user.</p>
    <button hx-get="{base_url}/pages/users/new" hx-target="#modal-container" hx-swap="innerHTML"
            class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition">
        <i class="fas fa-user-plus mr-2"></i> Add User
    </button>
</div>
{/if}
