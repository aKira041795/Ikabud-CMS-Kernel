{!-- Appointment Reports Tab --}
<div class="space-y-4">

    {if has_date_filter}
    <div class="flex items-center gap-2 text-xs text-teal-700 bg-teal-50 border border-teal-200 rounded-lg px-3 py-2 w-fit">
        <i class="fas fa-filter"></i>
        Showing results for <strong>{start_date}</strong> – <strong>{end_date}</strong>
    </div>
    {/if}

    {!-- Status Summary Cards --}
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm px-4 py-3 text-center">
            <p class="text-2xl font-bold text-green-600">{counts.completed | default:'0'}</p>
            <p class="text-xs text-gray-500 mt-0.5">Completed</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm px-4 py-3 text-center">
            <p class="text-2xl font-bold text-teal-600">{counts.scheduled | default:'0'}</p>
            <p class="text-xs text-gray-500 mt-0.5">Scheduled</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm px-4 py-3 text-center">
            <p class="text-2xl font-bold text-blue-600">{counts.confirmed | default:'0'}</p>
            <p class="text-xs text-gray-500 mt-0.5">Confirmed</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm px-4 py-3 text-center">
            <p class="text-2xl font-bold text-orange-500">{counts.no_show | default:'0'}</p>
            <p class="text-xs text-gray-500 mt-0.5">No Show</p>
        </div>
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm px-4 py-3 text-center">
            <p class="text-2xl font-bold text-red-500">{counts.cancelled | default:'0'}</p>
            <p class="text-xs text-gray-500 mt-0.5">Cancelled</p>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
            <h3 class="text-sm font-semibold text-gray-800 flex items-center gap-2">
                <i class="fas fa-calendar-alt text-teal-600"></i>
                Appointment Records
            </h3>
            <span class="text-xs text-gray-500">{appointments | count} records</span>
        </div>

        {if appointments}
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-100 text-xs text-gray-500 uppercase tracking-wide">
                        <th class="px-4 py-3 text-left font-medium">Date</th>
                        <th class="px-4 py-3 text-left font-medium">Time</th>
                        <th class="px-4 py-3 text-left font-medium">Student</th>
                        <th class="px-4 py-3 text-left font-medium">Case No.</th>
                        <th class="px-4 py-3 text-left font-medium">Course / Year</th>
                        <th class="px-4 py-3 text-left font-medium">Counselor</th>
                        <th class="px-4 py-3 text-left font-medium">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    {foreach appointments as a}
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-3 text-gray-600 whitespace-nowrap text-xs">{a.scheduled_date | default:'—' | esc_html}</td>
                        <td class="px-4 py-3 text-gray-600 whitespace-nowrap text-xs">{a.scheduled_time | default:'—' | esc_html}</td>
                        <td class="px-4 py-3 font-medium text-gray-900">{a.student_name | esc_html}</td>
                        <td class="px-4 py-3 text-gray-500 font-mono text-xs">{a.case_number | default:'—' | esc_html}</td>
                        <td class="px-4 py-3 text-gray-600 text-xs">{a.college_code | esc_html} {if a.student_grade}· {a.student_grade | esc_html}{/if}</td>
                        <td class="px-4 py-3 text-gray-600">{a.counselor_name | default:'—' | esc_html}</td>
                        <td class="px-4 py-3">
                            {if a.status == 'completed'}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Completed</span>
                            {elseif a.status == 'confirmed'}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Confirmed</span>
                            {elseif a.status == 'scheduled'}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-teal-100 text-teal-800">Scheduled</span>
                            {elseif a.status == 'no_show'}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">No Show</span>
                            {elseif a.status == 'cancelled'}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Cancelled</span>
                            {else}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">{a.status | title | esc_html}</span>
                            {/if}
                        </td>
                    </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
        {else}
        <div class="flex flex-col items-center justify-center py-16 text-gray-400">
            <i class="fas fa-calendar-alt text-3xl mb-3"></i>
            <p class="text-sm">No appointments found for the selected filters.</p>
        </div>
        {/if}
    </div>

</div>
