{!-- Session Records List Partial --}
{!-- Rendered by apiGuidanceAppointments when session_records=1 --}

{if appointments|count > 0}
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 border-b border-gray-100">
                    <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider px-4 py-3">Date &amp; Time</th>
                    <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider px-4 py-3">Student</th>
                    <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider px-4 py-3 hidden md:table-cell">Purpose / Type</th>
                    <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider px-4 py-3 hidden lg:table-cell">Counselor</th>
                    <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider px-4 py-3">Status</th>
                    <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider px-4 py-3 hidden xl:table-cell">Duration</th>
                    <th class="text-right text-xs font-semibold text-gray-500 uppercase tracking-wider px-4 py-3">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
                {foreach appointments as row}
                <tr class="hover:bg-gray-50 transition-colors group">
                    {!-- Date & Time --}
                    <td class="px-4 py-3 align-middle">
                        <div class="font-medium text-gray-800 text-xs">{row.scheduled_date | date_format:'M j, Y'}</div>
                        <div class="text-xs text-gray-400 mt-0.5">{row.scheduled_time | time_format}</div>
                    </td>

                    {!-- Student --}
                    <td class="px-4 py-3 align-middle">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-full bg-teal-100 text-teal-700 flex items-center justify-center font-bold text-xs flex-shrink-0">
                                {row.student_name | substr:0:1 | upper}
                            </div>
                            <div>
                                <div class="font-medium text-gray-800 text-xs leading-tight">{row.student_name | esc_html}</div>
                                {if row.case_number}
                                <div class="text-xs text-gray-400 mt-0.5">{row.case_number}</div>
                                {/if}
                                {if row.college_code}
                                <div class="text-xs text-gray-300">{row.college_code | esc_html}{if row.student_grade} · {row.student_grade | esc_html}{/if}</div>
                                {/if}
                            </div>
                        </div>
                    </td>

                    {!-- Purpose / Type --}
                    <td class="px-4 py-3 align-middle hidden md:table-cell">
                        <div class="text-xs font-medium text-gray-700">{row.type_name | default:'—' | esc_html}</div>
                        {if row.purpose}
                        <div class="text-xs text-gray-400 mt-0.5">{row.purpose | esc_html}</div>
                        {/if}
                    </td>

                    {!-- Counselor --}
                    <td class="px-4 py-3 align-middle hidden lg:table-cell">
                        <div class="text-xs text-gray-700">{row.counselor_name | default:'—' | esc_html}</div>
                    </td>

                    {!-- Status --}
                    <td class="px-4 py-3 align-middle">
                        {if row.status_key == 'completed'}
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-green-100 text-green-700 text-xs font-semibold whitespace-nowrap">
                            <i class="fas fa-check-circle text-[10px]"></i> Went to Session
                        </span>
                        {elseif row.status_key == 'no_show'}
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-orange-100 text-orange-700 text-xs font-semibold whitespace-nowrap">
                            <i class="fas fa-user-times text-[10px]"></i> Did Not Show Up
                        </span>
                        {elseif row.status_key == 'cancelled'}
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-red-100 text-red-700 text-xs font-semibold whitespace-nowrap">
                            <i class="fas fa-times-circle text-[10px]"></i> Cancelled
                        </span>
                        {else}
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 text-xs font-semibold whitespace-nowrap">
                            {row.status | esc_html}
                        </span>
                        {/if}
                    </td>

                    {!-- Duration --}
                    <td class="px-4 py-3 align-middle hidden xl:table-cell">
                        {if row.duration_minutes}
                        <div class="text-xs text-gray-500">{row.duration_minutes} mins</div>
                        {else}
                        <div class="text-xs text-gray-300">—</div>
                        {/if}
                    </td>

                    {!-- Action --}
                    <td class="px-4 py-3 align-middle text-right">
                        <div class="flex items-center justify-end gap-1">
                            <button type="button"
                                    onclick="loadSessionDetail({row.id})"
                                    class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded-lg bg-teal-50 text-teal-700 hover:bg-teal-100 transition">
                                <i class="fas fa-eye text-[10px]"></i> View Details
                            </button>
                            <div class="relative" x-data="{ open: false }">
                                <button @click="open = !open" @click.outside="open = false"
                                        class="w-7 h-7 flex items-center justify-center rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-600 transition">
                                    <i class="fas fa-chevron-down text-[10px]"></i>
                                </button>
                                <div x-show="open" x-cloak
                                     class="absolute right-0 top-8 z-20 w-44 bg-white rounded-lg shadow-lg border border-gray-100 py-1 text-xs">
                                    <button type="button" onclick="loadSessionDetail({row.id}); document.querySelectorAll('[x-data]').forEach(el => el._x_dataStack && (el._x_dataStack[0].open = false))"
                                            class="w-full text-left px-3 py-2 hover:bg-gray-50 text-gray-700 flex items-center gap-2">
                                        <i class="fas fa-eye text-teal-500 w-3"></i> View Details
                                    </button>
                                    <button hx-get="{base_url}/pages/appointments/{row.id}/edit"
                                            hx-target="#modal-container" hx-swap="innerHTML"
                                            class="w-full text-left px-3 py-2 hover:bg-gray-50 text-gray-700 flex items-center gap-2">
                                        <i class="fas fa-calendar-alt text-blue-500 w-3"></i> Edit Appointment
                                    </button>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>

    {!-- Pagination --}
    <div class="px-4 py-3 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div class="text-xs text-gray-500">
            {if sr_total > 0}
            Showing {sr_from} to {sr_to} of {sr_total} entries
            {else}
            No entries found
            {/if}
        </div>
        {if sr_page_count > 1}
        <div class="flex items-center gap-1" id="sr-pagination">
            {!-- Prev --}
            {if sr_page > 1}
            <button type="button"
                    onclick="loadSessionPage({sr_page - 1})"
                    class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 text-xs border border-gray-200">
                <i class="fas fa-chevron-left text-[10px]"></i>
            </button>
            {else}
            <span class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-300 text-xs border border-gray-100 cursor-not-allowed">
                <i class="fas fa-chevron-left text-[10px]"></i>
            </span>
            {/if}

            {!-- Page numbers --}
            {foreach sr_pages as pg}
            {if pg == '...'}
            <span class="w-8 h-8 flex items-center justify-center text-gray-400 text-xs">…</span>
            {elseif pg == sr_page}
            <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-teal-600 text-white text-xs font-semibold">{pg}</span>
            {else}
            <button type="button"
                    onclick="loadSessionPage({pg})"
                    class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-600 hover:bg-gray-100 text-xs border border-gray-200">
                {pg}
            </button>
            {/if}
            {/foreach}

            {!-- Next --}
            {if sr_page < sr_page_count}
            <button type="button"
                    onclick="loadSessionPage({sr_page + 1})"
                    class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 text-xs border border-gray-200">
                <i class="fas fa-chevron-right text-[10px]"></i>
            </button>
            {else}
            <span class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-300 text-xs border border-gray-100 cursor-not-allowed">
                <i class="fas fa-chevron-right text-[10px]"></i>
            </span>
            {/if}
        </div>
        {/if}
    </div>
</div>
{else}
<div class="bg-white rounded-xl shadow-sm border border-gray-100 py-16 text-center text-gray-400">
    <div class="w-16 h-16 mx-auto rounded-full bg-gray-100 flex items-center justify-center mb-4">
        <i class="fas fa-clipboard-list text-2xl text-gray-300"></i>
    </div>
    <p class="text-sm font-medium text-gray-500 mb-1">No session records found</p>
    <p class="text-xs text-gray-400">Try adjusting your filters or check Appointments for upcoming bookings.</p>
</div>
{/if}

{if appointments|count > 0}
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 border-b border-gray-100">
                    <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider px-4 py-3">Date &amp; Time</th>
                    <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider px-4 py-3">Student</th>
                    <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider px-4 py-3 hidden md:table-cell">Purpose / Type</th>
                    <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider px-4 py-3 hidden lg:table-cell">Counselor</th>
                    <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider px-4 py-3">Status</th>
                    <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider px-4 py-3 hidden xl:table-cell">Duration</th>
                    <th class="text-right text-xs font-semibold text-gray-500 uppercase tracking-wider px-4 py-3">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
                {foreach appointments as row}
                <tr class="hover:bg-gray-50 transition-colors group">
                    {!-- Date & Time --}
                    <td class="px-4 py-3 align-middle">
                        <div class="font-medium text-gray-800 text-xs">{row.scheduled_date | date_format:'M j, Y'}</div>
                        <div class="text-xs text-gray-400 mt-0.5">{row.scheduled_time | time_format}</div>
                    </td>

                    {!-- Student --}
                    <td class="px-4 py-3 align-middle">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-full bg-teal-100 text-teal-700 flex items-center justify-center font-semibold text-xs flex-shrink-0">
                                {row.student_name | substr:0:1 | upper}
                            </div>
                            <div>
                                <div class="font-medium text-gray-800 text-xs leading-tight">{row.student_name | esc_html}</div>
                                {if row.case_number}
                                <div class="text-xs text-gray-400 mt-0.5">{row.case_number}</div>
                                {/if}
                            </div>
                        </div>
                    </td>

                    {!-- Purpose / Type --}
                    <td class="px-4 py-3 align-middle hidden md:table-cell">
                        <div class="text-xs text-gray-700">{row.type_name | default:'—' | esc_html}</div>
                    </td>

                    {!-- Counselor --}
                    <td class="px-4 py-3 align-middle hidden lg:table-cell">
                        <div class="text-xs text-gray-700">{row.counselor_name | default:'—' | esc_html}</div>
                    </td>

                    {!-- Status --}
                    <td class="px-4 py-3 align-middle">
                        {if row.status_key == 'completed'}
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-green-100 text-green-700 text-xs font-semibold whitespace-nowrap">
                            <i class="fas fa-check-circle text-[10px]"></i> Went to Session
                        </span>
                        {elseif row.status_key == 'no_show'}
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-orange-100 text-orange-700 text-xs font-semibold whitespace-nowrap">
                            <i class="fas fa-user-times text-[10px]"></i> Did Not Show Up
                        </span>
                        {elseif row.status_key == 'cancelled'}
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-red-100 text-red-700 text-xs font-semibold whitespace-nowrap">
                            <i class="fas fa-times-circle text-[10px]"></i> Cancelled
                        </span>
                        {else}
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-gray-100 text-gray-600 text-xs font-semibold whitespace-nowrap">
                            {row.status | esc_html}
                        </span>
                        {/if}
                    </td>

                    {!-- Duration --}
                    <td class="px-4 py-3 align-middle hidden xl:table-cell">
                        <div class="text-xs text-gray-500">{row.duration | default:'—'}</div>
                    </td>

                    {!-- Action --}
                    <td class="px-4 py-3 align-middle text-right">
                        <div class="flex items-center justify-end gap-1">
                            <button hx-get="{base_url}/pages/appointments/{row.id}/edit" hx-target="#modal-container" hx-swap="innerHTML"
                                    class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded-lg bg-teal-50 text-teal-700 hover:bg-teal-100 transition">
                                <i class="fas fa-eye text-[10px]"></i> View Details
                            </button>
                        </div>
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>

    {!-- Pagination hint --}
    {if total > 50}
    <div class="px-4 py-3 border-t border-gray-100 text-xs text-gray-400 flex items-center justify-between">
        <span>Showing 50 of {total} records</span>
        <span class="text-gray-300">More results — refine your filters to narrow results</span>
    </div>
    {else}
    <div class="px-4 py-3 border-t border-gray-100 text-xs text-gray-400">
        Showing {total} record{if total != 1}s{/if}
    </div>
    {/if}
</div>
{else}
<div class="bg-white rounded-xl shadow-sm border border-gray-100 py-16 text-center text-gray-400">
    <div class="w-16 h-16 mx-auto rounded-full bg-gray-100 flex items-center justify-center mb-4">
        <i class="fas fa-clipboard-list text-2xl text-gray-300"></i>
    </div>
    <p class="text-sm font-medium text-gray-500 mb-1">No session records found</p>
    <p class="text-xs text-gray-400">Try adjusting your filters or date range.</p>
</div>
{/if}
