{!-- Case Note Detail Panel --}
{!-- Rendered by apiGuidanceCaseNoteDetail --}

<div class="flex flex-col h-full">

    {!-- Header --}
    <div class="px-6 py-4 border-b border-gray-100">
        <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
                <h3 class="text-sm font-bold text-gray-900 leading-snug">{note.note_title | esc_html}</h3>
                <p class="text-[11px] text-gray-400 mt-1">
                    Created by <span class="font-medium text-gray-600">{note.counselor_name | esc_html | default:'—'}</span>
                    {if note.formatted_created} on <span class="text-gray-600">{note.formatted_created}</span>{/if}
                </p>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0 mt-0.5">
                <button hx-get="/admin/guidance/pages/cases/{case_id}/notes/{note.id}/edit"
                        hx-target="#modal-container" hx-swap="innerHTML"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-gray-200 text-xs font-semibold text-gray-600 hover:bg-gray-50 transition-colors">
                    <i class="fas fa-pen text-[10px]"></i> Edit Note
                </button>
                <button class="w-7 h-7 flex items-center justify-center rounded-lg border border-gray-200 text-gray-400 hover:bg-gray-50 transition-colors">
                    <i class="fas fa-ellipsis-v text-xs"></i>
                </button>
            </div>
        </div>
    </div>

    {!-- Meta fields --}
    <div class="px-6 py-4 border-b border-gray-100 space-y-3">
        <div class="flex items-start gap-3">
            <span class="text-xs font-semibold text-gray-400 w-32 flex-shrink-0 pt-0.5">Note Type</span>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold bg-teal-50 text-teal-700 border border-teal-100">{note.note_type_label | esc_html}</span>
        </div>
        {if note.session_type}
        <div class="flex items-start gap-3">
            <span class="text-xs font-semibold text-gray-400 w-32 flex-shrink-0 pt-0.5">Related To</span>
            <span class="text-xs text-gray-700">
                {if note.session_type == 'walk-in'}Walk-in Counseling Session
                {elseif note.session_type == 'follow-up'}Follow-up Counseling Session
                {elseif note.session_type == 'referred'}Referred Counseling Session
                {else}{note.session_type | title} Session{/if}
                {if note.apt_type_name} &mdash; {note.apt_type_name | esc_html}{/if}
            </span>
        </div>
        {/if}
        {if note.formatted_apt_time}
        <div class="flex items-start gap-3">
            <span class="text-xs font-semibold text-gray-400 w-32 flex-shrink-0 pt-0.5">Related Session</span>
            <span class="text-xs text-gray-700">
                {note.formatted_date} &bull; {note.formatted_apt_time}{if note.formatted_apt_end} &ndash; {note.formatted_apt_end}{/if}
                {if note.apt_type_name} <span class="text-gray-400">({note.apt_type_name | esc_html})</span>{/if}
            </span>
        </div>
        {/if}
        {if note.risk_level && note.risk_level != 'none'}
        <div class="flex items-start gap-3">
            <span class="text-xs font-semibold text-gray-400 w-32 flex-shrink-0 pt-0.5">Risk Level</span>
            {if note.risk_level == 'critical'}
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-bold bg-red-100 text-red-700">
                <i class="fas fa-exclamation-circle text-[10px]"></i> Critical
            </span>
            {elseif note.risk_level == 'high'}
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-bold bg-orange-100 text-orange-700">
                <i class="fas fa-exclamation-triangle text-[10px]"></i> High
            </span>
            {elseif note.risk_level == 'moderate'}
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-bold bg-amber-100 text-amber-700">
                <i class="fas fa-minus-circle text-[10px]"></i> Moderate
            </span>
            {else}
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-bold bg-gray-100 text-gray-600">
                {note.risk_level | title}
            </span>
            {/if}
        </div>
        {/if}
    </div>

    {!-- Note Content --}
    <div class="px-6 py-4 border-b border-gray-100">
        <div class="text-xs font-bold text-gray-800 mb-2">Note Content</div>
        {if note.note_content}
        <p class="text-sm text-gray-700 leading-relaxed whitespace-pre-wrap">{note.note_content | esc_html}</p>
        {else}
        <p class="text-xs text-gray-300 italic">No content recorded.</p>
        {/if}
    </div>

    {!-- Notes / Recommendations --}
    {if note.observation_recommendation}
    <div class="px-6 py-4 border-b border-gray-100">
        <div class="text-xs font-bold text-gray-800 mb-2">Notes / Recommendations</div>
        <p class="text-sm text-gray-700 leading-relaxed whitespace-pre-wrap">{note.observation_recommendation | esc_html}</p>
    </div>
    {/if}

    {!-- Follow-up --}
    {if note.followup_required}
    <div class="px-6 py-3 border-b border-gray-100 bg-amber-50">
        <div class="flex items-center gap-2 text-xs text-amber-700">
            <i class="fas fa-flag text-amber-500"></i>
            <span class="font-semibold">Follow-up Required</span>
            {if note.followup_notes}
            <span class="text-amber-600 font-normal">&mdash; {note.followup_notes | esc_html}</span>
            {/if}
        </div>
    </div>
    {/if}

    {!-- Attachments --}
    {if attachments | count > 0}
    <div class="px-6 py-4 border-b border-gray-100">
        <div class="text-xs font-bold text-gray-800 mb-3">Attachments ({attachments | count})</div>
        <div class="space-y-2">
            {for att in attachments}
            <div class="flex items-center gap-3 p-2.5 rounded-lg border border-gray-200 bg-white group hover:border-teal-200 transition-colors">
                <div class="w-9 h-9 rounded-lg bg-red-50 border border-red-100 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-file-pdf text-red-500 text-sm"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-xs font-semibold text-gray-800 truncate">{att.file_name | esc_html}</div>
                    <div class="text-[11px] text-gray-400 mt-0.5">
                        {att.file_type | upper | default:'FILE'}{if att.file_size_label} &bull; {att.file_size_label}{/if}
                    </div>
                </div>
                <button class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-400 hover:bg-teal-50 hover:text-teal-600 transition-colors flex-shrink-0" title="Download">
                    <i class="fas fa-arrow-down text-xs"></i>
                </button>
            </div>
            {/for}
        </div>
    </div>
    {/if}

    {!-- Tags row (placeholder — expandable when tags data exists) --}

    {!-- Action buttons --}
    <div class="px-6 py-4 flex items-center gap-2 mt-auto">
        <button hx-get="/admin/guidance/pages/cases/{case_id}/notes/{note.id}/edit"
                hx-target="#modal-container" hx-swap="innerHTML"
                class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg border border-gray-200 text-xs font-semibold text-gray-700 hover:bg-gray-50 transition-colors">
            <i class="fas fa-edit text-[10px]"></i> Edit Note
        </button>
        <button hx-get="/admin/guidance/pages/cases/{case_id}/notes/new"
                hx-target="#modal-container" hx-swap="innerHTML"
                class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg bg-teal-700 text-white text-xs font-semibold hover:bg-teal-800 transition-colors shadow-sm">
            <i class="fas fa-plus text-[10px]"></i> Add Note
        </button>
    </div>

</div>
