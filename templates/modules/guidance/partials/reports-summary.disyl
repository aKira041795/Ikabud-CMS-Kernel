{!-- Reports Summary Partial — Dynamic Data --}

{!-- Date filter indicator --}
{if has_date_filter}
<div class="mb-4 px-4 py-2 bg-indigo-50 border border-indigo-200 rounded-lg text-sm text-indigo-700">
    <i class="fas fa-filter mr-1"></i> Showing data from <strong>{start_date}</strong> to <strong>{end_date}</strong>
</div>
{/if}

{!-- KPI Summary Cards --}
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
        <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Total Cases</span>
            <div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center"><i class="fas fa-folder text-indigo-600 text-sm"></i></div>
        </div>
        <p class="text-3xl font-bold text-gray-900">{summary.total_cases | default:'0'}</p>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
        <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Active</span>
            <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center"><i class="fas fa-folder-open text-blue-600 text-sm"></i></div>
        </div>
        <p class="text-3xl font-bold text-blue-600">{summary.active_cases | default:'0'}</p>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
        <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Resolved</span>
            <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center"><i class="fas fa-check-circle text-green-600 text-sm"></i></div>
        </div>
        <p class="text-3xl font-bold text-green-600">{summary.closed_cases | default:'0'}</p>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
        <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-semibold text-red-400 uppercase tracking-wide">Critical</span>
            <div class="w-8 h-8 bg-red-100 rounded-lg flex items-center justify-center"><i class="fas fa-exclamation-triangle text-red-600 text-sm"></i></div>
        </div>
        <p class="text-3xl font-bold text-red-600">{summary.critical_cases | default:'0'}</p>
    </div>
</div>

{!-- Session & Notes Stats --}
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-gradient-to-br from-indigo-50 to-white rounded-xl border border-indigo-100 p-4 text-center">
        <p class="text-2xl font-bold text-indigo-700">{summary.total_notes | default:'0'}</p>
        <p class="text-xs text-gray-500 mt-1">Session Notes</p>
    </div>
    <div class="bg-gradient-to-br from-purple-50 to-white rounded-xl border border-purple-100 p-4 text-center">
        <p class="text-2xl font-bold text-purple-700">{summary.total_session_hours | default:'0'}</p>
        <p class="text-xs text-gray-500 mt-1">Session Hours</p>
    </div>
    <div class="bg-gradient-to-br from-cyan-50 to-white rounded-xl border border-cyan-100 p-4 text-center">
        <p class="text-2xl font-bold text-cyan-700">{appointments.upcoming | default:'0'}</p>
        <p class="text-xs text-gray-500 mt-1">Upcoming Appts</p>
    </div>
    <div class="bg-gradient-to-br from-orange-50 to-white rounded-xl border border-orange-100 p-4 text-center">
        <p class="text-2xl font-bold text-orange-700">{summary.high_priority_cases | default:'0'}</p>
        <p class="text-xs text-gray-500 mt-1">High Priority</p>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    {!-- Cases by Status --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wide mb-4"><i class="fas fa-chart-pie text-indigo-500 mr-2"></i>Cases by Status</h3>
        <div class="space-y-3">
            <div class="flex justify-between items-center">
                <div class="flex items-center"><span class="w-3 h-3 rounded-full bg-blue-500 mr-2"></span><span class="text-sm text-gray-600">Open</span></div>
                <span class="px-3 py-0.5 bg-blue-100 text-blue-800 rounded-full text-sm font-semibold">{by_status.open | default:'0'}</span>
            </div>
            <div class="flex justify-between items-center">
                <div class="flex items-center"><span class="w-3 h-3 rounded-full bg-yellow-500 mr-2"></span><span class="text-sm text-gray-600">In Progress</span></div>
                <span class="px-3 py-0.5 bg-yellow-100 text-yellow-800 rounded-full text-sm font-semibold">{by_status.in_progress | default:'0'}</span>
            </div>
            <div class="flex justify-between items-center">
                <div class="flex items-center"><span class="w-3 h-3 rounded-full bg-gray-400 mr-2"></span><span class="text-sm text-gray-600">On Hold</span></div>
                <span class="px-3 py-0.5 bg-gray-100 text-gray-800 rounded-full text-sm font-semibold">{by_status.on_hold | default:'0'}</span>
            </div>
            <div class="flex justify-between items-center">
                <div class="flex items-center"><span class="w-3 h-3 rounded-full bg-green-500 mr-2"></span><span class="text-sm text-gray-600">Closed</span></div>
                <span class="px-3 py-0.5 bg-green-100 text-green-800 rounded-full text-sm font-semibold">{by_status.closed | default:'0'}</span>
            </div>
        </div>
    </div>
    
    {!-- Cases by Severity --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wide mb-4"><i class="fas fa-shield-alt text-red-500 mr-2"></i>Cases by Severity</h3>
        <div class="space-y-3">
            <div class="flex justify-between items-center">
                <div class="flex items-center"><span class="w-3 h-3 rounded-full bg-red-600 mr-2"></span><span class="text-sm text-gray-600">Critical</span></div>
                <span class="px-3 py-0.5 bg-red-100 text-red-800 rounded-full text-sm font-semibold">{by_severity.critical | default:'0'}</span>
            </div>
            <div class="flex justify-between items-center">
                <div class="flex items-center"><span class="w-3 h-3 rounded-full bg-orange-500 mr-2"></span><span class="text-sm text-gray-600">High</span></div>
                <span class="px-3 py-0.5 bg-orange-100 text-orange-800 rounded-full text-sm font-semibold">{by_severity.high | default:'0'}</span>
            </div>
            <div class="flex justify-between items-center">
                <div class="flex items-center"><span class="w-3 h-3 rounded-full bg-yellow-500 mr-2"></span><span class="text-sm text-gray-600">Medium</span></div>
                <span class="px-3 py-0.5 bg-yellow-100 text-yellow-800 rounded-full text-sm font-semibold">{by_severity.medium | default:'0'}</span>
            </div>
            <div class="flex justify-between items-center">
                <div class="flex items-center"><span class="w-3 h-3 rounded-full bg-green-500 mr-2"></span><span class="text-sm text-gray-600">Low</span></div>
                <span class="px-3 py-0.5 bg-green-100 text-green-800 rounded-full text-sm font-semibold">{by_severity.low | default:'0'}</span>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    {!-- Cases by Category (dynamic) --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wide mb-4"><i class="fas fa-tags text-violet-500 mr-2"></i>Cases by Category</h3>
        {if category_items}
        <div class="space-y-3">
            {each category_items as item}
            <div class="flex items-center justify-between">
                <span class="text-sm text-gray-700 w-28 truncate">{item.name}</span>
                <div class="flex items-center flex-1 ml-3">
                    <div class="flex-1 h-2.5 bg-gray-100 rounded-full overflow-hidden">
                        <div class="h-full bg-indigo-500 rounded-full" style="width: {item.pct}%"></div>
                    </div>
                    <span class="ml-3 text-xs font-semibold text-gray-500 w-16 text-right">{item.count} ({item.pct}%)</span>
                </div>
            </div>
            {/each}
        </div>
        {else}
        <p class="text-sm text-gray-400 italic">No cases recorded</p>
        {/if}
    </div>
    
    {!-- Appointments Summary --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wide mb-4"><i class="fas fa-calendar-check text-teal-500 mr-2"></i>Appointments</h3>
        <div class="space-y-2">
            <div class="flex items-center justify-between p-2.5 bg-green-50 rounded-lg">
                <span class="text-sm text-green-800"><i class="fas fa-check mr-2"></i>Completed</span>
                <span class="text-lg font-bold text-green-600">{appointments.completed | default:'0'}</span>
            </div>
            <div class="flex items-center justify-between p-2.5 bg-blue-50 rounded-lg">
                <span class="text-sm text-blue-800"><i class="fas fa-calendar mr-2"></i>Scheduled</span>
                <span class="text-lg font-bold text-blue-600">{appointments.scheduled | default:'0'}</span>
            </div>
            <div class="flex items-center justify-between p-2.5 bg-amber-50 rounded-lg">
                <span class="text-sm text-amber-800"><i class="fas fa-clock mr-2"></i>Pending</span>
                <span class="text-lg font-bold text-amber-600">{appointments.pending | default:'0'}</span>
            </div>
            <div class="flex items-center justify-between p-2.5 bg-red-50 rounded-lg">
                <span class="text-sm text-red-800"><i class="fas fa-user-slash mr-2"></i>No-shows</span>
                <span class="text-lg font-bold text-red-600">{appointments.no_show | default:'0'}</span>
            </div>
            <div class="flex items-center justify-between p-2.5 bg-gray-50 rounded-lg">
                <span class="text-sm text-gray-600"><i class="fas fa-ban mr-2"></i>Cancelled</span>
                <span class="text-lg font-bold text-gray-500">{appointments.cancelled | default:'0'}</span>
            </div>
        </div>
    </div>
</div>

{!-- Monthly Trend --}
{if monthly_trend}
<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-6">
    <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wide mb-4"><i class="fas fa-chart-bar text-indigo-500 mr-2"></i>Monthly Trend (Last 6 Months)</h3>
    <div class="flex items-end gap-3 h-40">
        {each monthly_trend as m}
        <div class="flex-1 flex flex-col items-center gap-1">
            <div class="w-full flex flex-col items-center gap-0.5" style="height:120px;justify-content:flex-end;">
                <div class="w-full max-w-[28px] bg-indigo-500 rounded-t" style="height: calc({m.opened} * 20px); min-height:4px;" title="Opened: {m.opened}"></div>
                <div class="w-full max-w-[28px] bg-green-400 rounded-t" style="height: calc({m.closed} * 20px); min-height:2px;" title="Closed: {m.closed}"></div>
            </div>
            <span class="text-[10px] text-gray-400 mt-1">{m.label}</span>
        </div>
        {/each}
    </div>
    <div class="flex items-center gap-4 mt-3 text-xs text-gray-500">
        <span><span class="inline-block w-3 h-3 bg-indigo-500 rounded mr-1"></span>Opened</span>
        <span><span class="inline-block w-3 h-3 bg-green-400 rounded mr-1"></span>Closed</span>
    </div>
</div>
{/if}

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    {!-- Referral Sources --}
    {if by_referral}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wide mb-4"><i class="fas fa-directions text-cyan-500 mr-2"></i>Referral Sources</h3>
        <div class="space-y-2">
            {each by_referral as src => count}
            <div class="flex justify-between items-center">
                <span class="text-sm text-gray-600 capitalize">{src}</span>
                <span class="px-3 py-0.5 bg-cyan-50 text-cyan-700 rounded-full text-sm font-semibold">{count}</span>
            </div>
            {/each}
        </div>
    </div>
    {/if}
    
    {!-- Risk Distribution --}
    {if risk_distribution}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wide mb-4"><i class="fas fa-heartbeat text-rose-500 mr-2"></i>Risk Distribution (Sessions)</h3>
        <div class="space-y-2">
            {each risk_distribution as level => count}
            <div class="flex justify-between items-center">
                <span class="text-sm text-gray-600 capitalize">{level}</span>
                <span class="px-3 py-0.5 bg-rose-50 text-rose-700 rounded-full text-sm font-semibold">{count}</span>
            </div>
            {/each}
        </div>
    </div>
    {/if}
</div>

{!-- Counselor Caseload (admin/supervisor only) --}
{if counselor_stats}
<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-6">
    <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wide mb-4"><i class="fas fa-users text-indigo-500 mr-2"></i>Counselor Caseload</h3>
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-gray-200">
                    <th class="text-left py-2 px-3 text-gray-500 font-semibold">Counselor</th>
                    <th class="text-center py-2 px-3 text-gray-500 font-semibold">Active</th>
                    <th class="text-center py-2 px-3 text-gray-500 font-semibold">Closed</th>
                    <th class="text-center py-2 px-3 text-gray-500 font-semibold">Total</th>
                    <th class="text-left py-2 px-3 text-gray-500 font-semibold w-40">Load</th>
                </tr>
            </thead>
            <tbody>
                {each counselor_stats as cs}
                <tr class="border-b border-gray-50 hover:bg-gray-50">
                    <td class="py-2.5 px-3 font-medium text-gray-800">{cs.name}</td>
                    <td class="py-2.5 px-3 text-center"><span class="px-2 py-0.5 bg-blue-100 text-blue-700 rounded-full text-xs font-semibold">{cs.active}</span></td>
                    <td class="py-2.5 px-3 text-center"><span class="px-2 py-0.5 bg-green-100 text-green-700 rounded-full text-xs font-semibold">{cs.closed}</span></td>
                    <td class="py-2.5 px-3 text-center text-gray-600">{cs.total}</td>
                    <td class="py-2.5 px-3">
                        <div class="w-full h-2 bg-gray-100 rounded-full overflow-hidden">
                            <div class="h-full bg-indigo-500 rounded-full" style="width: min(100%, calc({cs.active} * 10%))"></div>
                        </div>
                    </td>
                </tr>
                {/each}
            </tbody>
        </table>
    </div>
</div>
{/if}
