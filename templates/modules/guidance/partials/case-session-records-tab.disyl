{!-- Case Session Records Tab Partial --}
{!-- Rendered by apiGuidanceCaseSessionRecords --}

{!-- Header --}
<div class="px-6 py-5 border-b border-gray-100 flex items-start justify-between gap-4 flex-wrap">
    <div>
        <h2 class="text-base font-semibold text-gray-900">Session Records</h2>
        <p class="text-xs text-gray-400 mt-0.5">View historical session outcomes and attendance for this student.</p>
    </div>
    <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gray-200 text-sm text-gray-500 bg-gray-50">
            <i class="fas fa-history text-xs text-gray-400"></i> Historical statuses only
        </span>
        <button hx-get="/admin/guidance/pages/appointments/new?case_id={case_id}" hx-target="#modal-container" hx-swap="innerHTML"
                class="inline-flex items-center gap-1.5 px-4 py-2 bg-teal-700 text-white text-sm font-semibold rounded-lg hover:bg-teal-800 transition-colors shadow-sm">
            <i class="fas fa-plus text-xs"></i> Add Session
        </button>
    </div>
</div>

{!-- Stats row --}
<div class="grid grid-cols-5 divide-x divide-gray-100 border-b border-gray-100">
    <div class="px-5 py-4 flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-teal-50 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-calendar-alt text-teal-600 text-sm"></i>
        </div>
        <div>
            <div class="text-xl font-bold text-gray-900">{total}</div>
            <div class="text-[11px] text-gray-400 uppercase tracking-wide">Total Sessions</div>
        </div>
    </div>
    <div class="px-5 py-4 flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-check-circle text-green-500 text-sm"></i>
        </div>
        <div>
            <div class="text-xl font-bold text-gray-900">{cnt_completed}</div>
            <div class="text-[11px] text-gray-400 uppercase tracking-wide">Completed</div>
        </div>
    </div>
    <div class="px-5 py-4 flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-amber-50 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-clock text-amber-500 text-sm"></i>
        </div>
        <div>
            <div class="text-xl font-bold text-gray-900">{cnt_in_progress}</div>
            <div class="text-[11px] text-gray-400 uppercase tracking-wide">In Progress</div>
        </div>
    </div>
    <div class="px-5 py-4 flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-red-50 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-times-circle text-red-400 text-sm"></i>
        </div>
        <div>
            <div class="text-xl font-bold text-gray-900">{cnt_cancelled}</div>
            <div class="text-[11px] text-gray-400 uppercase tracking-wide">Cancelled</div>
        </div>
    </div>
    <div class="px-5 py-4 flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-orange-50 flex items-center justify-center flex-shrink-0">
            <i class="fas fa-user-times text-orange-400 text-sm"></i>
        </div>
        <div>
            <div class="text-xl font-bold text-gray-900">{cnt_no_show}</div>
            <div class="text-[11px] text-gray-400 uppercase tracking-wide">No Show</div>
        </div>
    </div>
</div>

{!-- Two-column layout: table + detail panel --}
<div class="flex gap-0 min-h-0">

    {!-- Left: session table --}
    <div class="flex-1 min-w-0 border-r border-gray-100">
        <div class="overflow-x-auto">
            <table class="min-w-full">
                <thead>
                    <tr class="border-b border-gray-100 bg-gray-50/50">
                        <th class="px-5 py-3 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider w-36">Date &amp; Time</th>
                        <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Purpose / Type</th>
                        <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider w-32">Counselor</th>
                        <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider w-24">Duration</th>
                        <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider w-40">Status</th>
                        <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider w-28">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    {if sessions | count > 0}
                    {for session in sessions}
                    <tr class="hover:bg-gray-50/60 transition-colors cursor-pointer"
                        onclick="loadCaseSessionDetail({session.id})">

                        {!-- Date & Time --}
                        <td class="px-5 py-4">
                            <div class="text-sm font-semibold text-gray-800">{session.formatted_date}</div>
                            <div class="text-xs text-gray-400 mt-0.5">{session.formatted_time}</div>
                        </td>

                        {!-- Purpose / Type --}
                        <td class="px-4 py-4">
                            <div class="text-sm font-semibold text-gray-900">{session.type_name | default:'Session' | esc_html}</div>
                            {if session.purpose}
                            <div class="text-xs text-gray-400 mt-0.5">{session.purpose | esc_html}</div>
                            {/if}
                        </td>

                        {!-- Counselor --}
                        <td class="px-4 py-4 text-sm text-gray-600 whitespace-nowrap">{session.counselor_name | default:'—' | esc_html}</td>

                        {!-- Duration --}
                        <td class="px-4 py-4 text-sm text-gray-500 whitespace-nowrap">
                            {if session.duration_minutes}{session.duration_minutes} mins{else}<span class="text-gray-300">—</span>{/if}
                        </td>

                        {!-- Status --}
                        <td class="px-4 py-4">
                            {if session.status == 'completed'}
                            <div class="inline-flex flex-col gap-0.5">
                                <span class="inline-flex items-center gap-1 text-xs font-bold text-green-700">
                                    <i class="fas fa-check-circle"></i> Completed
                                </span>
                                <span class="text-[11px] text-green-600">Went to Session</span>
                            </div>
                            {elseif session.status == 'cancelled'}
                            <div class="inline-flex flex-col gap-0.5">
                                <span class="inline-flex items-center gap-1 text-xs font-bold text-red-600">
                                    <i class="fas fa-times-circle"></i> Cancelled
                                </span>
                                <span class="text-[11px] text-red-500">Cancelled</span>
                            </div>
                            {elseif session.status == 'no_show'}
                            <div class="inline-flex flex-col gap-0.5">
                                <span class="inline-flex items-center gap-1 text-xs font-bold text-orange-600">
                                    <i class="fas fa-user-times"></i> Did Not Show Up
                                </span>
                                <span class="text-[11px] text-orange-500">No Show</span>
                            </div>
                            {elseif session.status == 'in_progress'}
                            <div class="inline-flex flex-col gap-0.5">
                                <span class="inline-flex items-center gap-1 text-xs font-bold text-amber-600">
                                    <i class="fas fa-circle"></i> In Progress
                                </span>
                                <span class="text-[11px] text-amber-500">Follow-up Needed</span>
                            </div>
                            {elseif session.status == 'scheduled' || session.status == 'confirmed'}
                            <div class="inline-flex flex-col gap-0.5">
                                <span class="inline-flex items-center gap-1 text-xs font-bold text-blue-700">
                                    <i class="fas fa-calendar-check"></i> {session.status | title}
                                </span>
                                <span class="text-[11px] text-blue-500">Upcoming</span>
                            </div>
                            {elseif session.status == 'pending' || session.status == 'requested'}
                            <div class="inline-flex flex-col gap-0.5">
                                <span class="inline-flex items-center gap-1 text-xs font-bold text-indigo-700">
                                    <i class="fas fa-hourglass-half"></i> Pending
                                </span>
                                <span class="text-[11px] text-indigo-500">Pending Review</span>
                            </div>
                            {else}
                            <span class="inline-flex items-center gap-1 text-xs font-semibold text-gray-500">
                                {session.status | title | esc_html}
                            </span>
                            {/if}
                        </td>

                        {!-- Actions --}
                        <td class="px-4 py-4">
                            <div class="flex items-center gap-1">
                                <button type="button"
                                        onclick="event.stopPropagation(); loadCaseSessionDetail({session.id})"
                                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-teal-200 text-xs font-semibold text-teal-700 hover:bg-teal-50 transition-colors">
                                    <i class="fas fa-eye text-[10px]"></i> View Details
                                </button>
                                <button type="button"
                                        hx-get="{base_url}/pages/appointments/{session.id}/edit"
                                        hx-target="#modal-container" hx-swap="innerHTML"
                                        onclick="event.stopPropagation()"
                                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-gray-200 text-xs font-semibold text-gray-700 hover:bg-gray-50 transition-colors">
                                    <i class="fas fa-edit text-[10px]"></i> Edit
                                </button>
                            </div>
                        </td>
                    </tr>
                    {/for}
                    {else}
                    <tr>
                        <td colspan="6" class="px-6 py-14 text-center text-gray-400">
                            <i class="fas fa-clipboard-list text-4xl text-gray-200 block mb-3"></i>
                            <p class="text-sm">No session records found.</p>
                        </td>
                    </tr>
                    {/if}
                </tbody>
            </table>
        </div>

        {!-- Footer --}
        <div class="px-5 py-3 border-t border-gray-100 text-xs text-gray-400 flex items-center justify-between">
            {if total > 0}
            <span>Showing {from} to {to} of {total} session{if total != 1}s{/if}</span>
            {else}
            <span>No sessions found</span>
            {/if}
            {if total_pages > 1}
            <div class="flex items-center gap-1">
                {if page > 1}
                <button type="button"
                        hx-get="/admin/guidance/api/cases/{case_id}/session-records?page={page - 1}"
                        hx-target="#case-sessions-tab" hx-swap="innerHTML"
                        class="w-7 h-7 flex items-center justify-center rounded border border-gray-200 text-gray-500 hover:bg-gray-50">
                    <i class="fas fa-chevron-left text-[10px]"></i>
                </button>
                {/if}
                <span class="px-3 py-1 rounded bg-teal-600 text-white text-xs font-semibold">{page}</span>
                {if page < total_pages}
                <button type="button"
                        hx-get="/admin/guidance/api/cases/{case_id}/session-records?page={page + 1}"
                        hx-target="#case-sessions-tab" hx-swap="innerHTML"
                        class="w-7 h-7 flex items-center justify-center rounded border border-gray-200 text-gray-500 hover:bg-gray-50">
                    <i class="fas fa-chevron-right text-[10px]"></i>
                </button>
                {/if}
            </div>
            {/if}
        </div>

        {!-- Status Legend --}
        <div class="px-5 py-4 border-t border-gray-100 bg-gray-50/40">
            <p class="text-[11px] font-semibold text-gray-500 uppercase tracking-wide mb-3">Status Legend</p>
            <div class="flex flex-wrap gap-5">
                <div class="flex items-start gap-1.5">
                    <i class="fas fa-check-circle text-green-500 text-xs mt-0.5"></i>
                    <div>
                        <div class="text-xs font-semibold text-green-700">Went to Session</div>
                        <div class="text-[11px] text-gray-400">Student attended the session.</div>
                    </div>
                </div>
                <div class="flex items-start gap-1.5">
                    <i class="fas fa-user-times text-orange-500 text-xs mt-0.5"></i>
                    <div>
                        <div class="text-xs font-semibold text-orange-600">Did Not Show Up</div>
                        <div class="text-[11px] text-gray-400">Student did not attend.</div>
                    </div>
                </div>
                <div class="flex items-start gap-1.5">
                    <i class="fas fa-times-circle text-red-500 text-xs mt-0.5"></i>
                    <div>
                        <div class="text-xs font-semibold text-red-600">Cancelled</div>
                        <div class="text-[11px] text-gray-400">Session was cancelled.</div>
                    </div>
                </div>
                <div class="flex items-start gap-1.5">
                    <i class="fas fa-circle text-amber-500 text-xs mt-0.5"></i>
                    <div>
                        <div class="text-xs font-semibold text-amber-600">In Progress</div>
                        <div class="text-[11px] text-gray-400">Session is ongoing or needs follow-up.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {!-- Right: session detail panel --}
    <div class="w-72 xl:w-80 flex-shrink-0" id="session-detail-outer">
        <div id="session-detail-container" class="h-full">
            {!-- Placeholder shown until a session is selected --}
            <div class="h-full flex flex-col items-center justify-center p-8 text-center text-gray-300 min-h-64">
                <i class="fas fa-clipboard-list text-5xl mb-4"></i>
                <p class="text-sm font-medium text-gray-400">Session Details</p>
                <p class="text-xs text-gray-300 mt-1">Select a session from the table to view its details.</p>
            </div>
        </div>
    </div>

</div>

{!-- JS: load session detail via HTMX --}
<script>
function loadCaseSessionDetail(apptId) {
    htmx.ajax('GET', '/admin/guidance/api/cases/{case_id}/session-records/' + apptId + '/detail', {
        target: '#session-detail-container',
        swap: 'innerHTML'
    });
}
</script>
