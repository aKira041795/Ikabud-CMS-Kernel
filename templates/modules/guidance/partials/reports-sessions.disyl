{!-- Session Reports Tab --}
<div class="space-y-4">

    {if has_date_filter}
    <div class="flex items-center gap-2 text-xs text-teal-700 bg-teal-50 border border-teal-200 rounded-lg px-3 py-2 w-fit">
        <i class="fas fa-filter"></i>
        Showing results for <strong>{start_date}</strong> – <strong>{end_date}</strong>
    </div>
    {/if}

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
            <h3 class="text-sm font-semibold text-gray-800 flex items-center gap-2">
                <i class="fas fa-calendar-check text-teal-600"></i>
                Counseling Sessions
            </h3>
            <span class="text-xs text-gray-500">{sessions | count} records</span>
        </div>

        {if sessions}
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead>
                    <tr class="bg-gray-50 border-b border-gray-100 text-xs text-gray-500 uppercase tracking-wide">
                        <th class="px-4 py-3 text-left font-medium">Date</th>
                        <th class="px-4 py-3 text-left font-medium">Student</th>
                        <th class="px-4 py-3 text-left font-medium">Case No.</th>
                        <th class="px-4 py-3 text-left font-medium">Course / Year</th>
                        <th class="px-4 py-3 text-left font-medium">Counselor</th>
                        <th class="px-4 py-3 text-left font-medium">Session Type</th>
                        <th class="px-4 py-3 text-center font-medium">Duration</th>
                        <th class="px-4 py-3 text-left font-medium">Risk Level</th>
                        <th class="px-4 py-3 text-left font-medium">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    {foreach sessions as s}
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-3 text-gray-600 whitespace-nowrap text-xs">{s.session_date | default:'—' | esc_html}</td>
                        <td class="px-4 py-3 font-medium text-gray-900">{s.student_name | default:'—' | esc_html}</td>
                        <td class="px-4 py-3 text-gray-500 font-mono text-xs">{s.case_number | default:'—' | esc_html}</td>
                        <td class="px-4 py-3 text-gray-600 text-xs">{s.college_code | esc_html} {if s.student_grade}· {s.student_grade | esc_html}{/if}</td>
                        <td class="px-4 py-3 text-gray-600">{s.counselor_name | default:'—' | esc_html}</td>
                        <td class="px-4 py-3 text-gray-600">{s.session_type | default:'—' | title | esc_html}</td>
                        <td class="px-4 py-3 text-center text-gray-600 text-xs">
                            {if s.session_duration_minutes}
                            {s.session_duration_minutes} min
                            {else}
                            —
                            {/if}
                        </td>
                        <td class="px-4 py-3">
                            {if s.risk_level == 'high'}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">High</span>
                            {elseif s.risk_level == 'critical'}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Critical</span>
                            {elseif s.risk_level == 'low'}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Low</span>
                            {elseif s.risk_level == 'moderate'}
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Moderate</span>
                            {else}
                            <span class="text-gray-400 text-xs">—</span>
                            {/if}
                        </td>
                        <td class="px-4 py-3 text-gray-600 text-xs">{s.student_status | default:'—' | title | esc_html}</td>
                    </tr>
                    {/foreach}
                </tbody>
            </table>
        </div>
        {else}
        <div class="flex flex-col items-center justify-center py-16 text-gray-400">
            <i class="fas fa-calendar-check text-3xl mb-3"></i>
            <p class="text-sm">No session records found for the selected filters.</p>
        </div>
        {/if}
    </div>

</div>
