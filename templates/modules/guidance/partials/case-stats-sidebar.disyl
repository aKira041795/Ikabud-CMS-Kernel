{!-- Case / Student Quick Stats Sidebar Panel --}
<div class="bg-gray-900 rounded-xl shadow-lg border border-gray-800 p-5">
    <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-4 flex items-center gap-2">
        <i class="fas fa-chart-bar text-teal-400"></i> Quick Stats
    </h3>

    {!-- Total --}
    <div class="flex items-center justify-between py-2">
        <span class="text-sm text-gray-300">Total Students</span>
        <span class="text-2xl font-bold text-white">{stats.total | default:'0'}</span>
    </div>

    <div class="border-t border-gray-700 mt-2 pt-3 space-y-3">
        {!-- Low Risk --}
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-green-400 flex-shrink-0"></span>
                <span class="text-sm text-gray-300">Low Risk</span>
            </div>
            <span class="text-lg font-bold text-green-400">{stats.low_risk | default:'0'}</span>
        </div>

        {!-- Moderate Risk --}
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400 flex-shrink-0"></span>
                <span class="text-sm text-gray-300">Moderate Risk</span>
            </div>
            <span class="text-lg font-bold text-amber-400">{stats.moderate_risk | default:'0'}</span>
        </div>

        {!-- High Risk --}
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-red-400 flex-shrink-0"></span>
                <span class="text-sm text-gray-300">High Risk</span>
            </div>
            <span class="text-lg font-bold text-red-400">{stats.high_risk | default:'0'}</span>
        </div>

        <div class="border-t border-gray-700 pt-3">
            {!-- Probationary --}
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-purple-400 flex-shrink-0"></span>
                    <span class="text-sm text-gray-300">Probationary</span>
                </div>
                <span class="text-lg font-bold text-purple-400">{stats.probationary | default:'0'}</span>
            </div>
        </div>
    </div>
</div>
