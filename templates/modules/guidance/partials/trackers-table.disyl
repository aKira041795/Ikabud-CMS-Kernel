{if trackers | count > 0}

    {foreach trackers as t}
    <div class="grid grid-cols-[2fr_110px_200px_240px_140px] gap-0 px-5 py-4 border-b border-gray-50 hover:bg-gray-50/60 transition-colors items-center">

        {!-- TRACKER column --}
        <div class="flex items-start gap-3 min-w-0 pr-4">
            <div class="w-10 h-10 rounded-xl {t.icon_bg} flex items-center justify-center flex-shrink-0 mt-0.5">
                <i class="fas {t.icon_class} text-white text-sm"></i>
            </div>
            <div class="min-w-0">
                <a hx-get="{base_url}/pages/trackers/{t.id}"
                   hx-target="#main-content"
                   hx-push-url="{base_url}/trackers/{t.id}"
                   class="text-sm font-semibold text-gray-900 hover:text-indigo-600 cursor-pointer truncate block">{t.name | esc_html}</a>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5 mt-1 text-xs text-gray-400">
                    {if t.academic_year}
                    <span><i class="fas fa-graduation-cap mr-1"></i>{t.academic_year}</span>
                    {/if}
                    <span><i class="fas fa-users mr-1"></i>{t.student_count} students</span>
                    {if t.college_name}
                    <span><i class="fas fa-building-columns mr-1"></i>{t.college_name | esc_html}</span>
                    {/if}
                </div>
                <div class="text-xs text-gray-400 mt-0.5">
                    Last updated: {t.updated_at_fmt}
                </div>
            </div>
        </div>

        {!-- STATUS column --}
        <div>
            {if t.is_active}
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-100">
                <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Active
            </span>
            {else}
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-600 border border-gray-200">
                <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span> Inactive
            </span>
            {/if}
        </div>

        {!-- PROGRESS column --}
        <div class="pr-4">
            <div class="flex items-center gap-2 mb-1">
                <div class="flex-1 bg-gray-100 rounded-full h-2 overflow-hidden">
                    <div class="h-2 rounded-full bg-teal-500 transition-all" style="width:{t.progress_pct}%"></div>
                </div>
                <span class="text-sm font-semibold text-gray-700 w-10 text-right">{t.progress_pct}%</span>
            </div>
            <div class="text-xs text-gray-400">{t.progress_done} of {t.progress_total} completed</div>
        </div>

        {!-- REQUIREMENTS column --}
        <div class="flex items-center gap-4">
            <div class="text-center">
                <div class="text-base font-bold text-teal-600">{t.submitted_count}</div>
                <div class="text-xs text-gray-400">Submitted</div>
            </div>
            <div class="text-center">
                <div class="text-base font-bold text-orange-500">{t.pending_count}</div>
                <div class="text-xs text-gray-400">Pending</div>
            </div>
            <div class="text-center">
                <div class="text-base font-bold text-purple-600">{t.in_review_count}</div>
                <div class="text-xs text-gray-400">In Review</div>
            </div>
        </div>

        {!-- ACTIONS column --}
        <div class="flex items-center justify-end gap-1" x-data="{ open: false }">
            <a hx-get="{base_url}/pages/trackers/{t.id}"
               hx-target="#main-content"
               hx-push-url="{base_url}/trackers/{t.id}"
               class="px-3 py-1.5 text-xs font-medium text-gray-700 border border-gray-200 rounded-lg hover:bg-gray-100 transition cursor-pointer">
                View
            </a>
            <button type="button"
                    hx-get="{base_url}/pages/trackers/{t.id}/edit"
                    hx-target="#modal-container"
                    hx-swap="innerHTML"
                    class="px-3 py-1.5 text-xs font-medium text-gray-700 border border-gray-200 rounded-lg hover:bg-gray-100 transition">
                Edit
            </button>
            <div class="relative">
                <button type="button" @click="open = !open"
                        class="w-7 h-7 flex items-center justify-center text-gray-400 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition">
                    <i class="fas fa-ellipsis-v text-xs"></i>
                </button>
                <div x-show="open" x-cloak @click.away="open = false"
                     class="absolute right-0 top-8 z-20 w-40 bg-white border border-gray-100 rounded-xl shadow-lg py-1 text-sm">
                    <button type="button"
                            hx-post="{base_url}/api/trackers/{t.id}/toggle"
                            hx-swap="none"
                            @click="open = false"
                            class="w-full text-left px-4 py-2 hover:bg-gray-50 text-gray-700 transition">
                        {if t.is_active}Deactivate{else}Activate{/if}
                    </button>
                    <button type="button"
                            hx-delete="{base_url}/api/trackers/{t.id}"
                            hx-swap="none"
                            hx-confirm="Delete this tracker and all its data? This cannot be undone."
                            @click="open = false"
                            class="w-full text-left px-4 py-2 hover:bg-red-50 text-red-600 transition">
                        Delete
                    </button>
                </div>
            </div>
        </div>

    </div>
    {/foreach}

    {!-- Footer: count + pagination --}
    <div class="flex items-center justify-between px-5 py-4 border-t border-gray-100 bg-gray-50/60">
        <p class="text-sm text-gray-500">
            {if total > 0}
            Showing {from} to {to} of {total} tracker{if total != 1}s{/if}
            {else}
            No trackers found
            {/if}
        </p>
        {if total_pages > 1}
        <div class="flex items-center gap-1">

            <button type="button"
                    onclick="document.getElementById('tf-page-h').value='{prev_page}'"
                    hx-get="{base_url}/api/trackers" hx-target="#tracker-list" hx-include="#tf" hx-swap="innerHTML"
                    {if !has_prev}disabled{/if}
                    class="w-8 h-8 flex items-center justify-center rounded-lg border text-sm transition {if has_prev}border-gray-200 hover:bg-gray-100 text-gray-600{else}border-gray-100 text-gray-300 cursor-not-allowed{/if}">
                <i class="fas fa-chevron-left text-xs"></i>
            </button>

            {foreach page_links as pl}
            {if pl.ellipsis}
            <span class="w-8 h-8 flex items-center justify-center text-gray-400 text-sm">&hellip;</span>
            {else}
            <button type="button"
                    onclick="document.getElementById('tf-page-h').value='{pl.num}'"
                    hx-get="{base_url}/api/trackers" hx-target="#tracker-list" hx-include="#tf" hx-swap="innerHTML"
                    class="w-8 h-8 flex items-center justify-center rounded-lg text-sm font-medium transition {if pl.active}bg-indigo-600 text-white border border-indigo-600{else}border border-gray-200 hover:bg-gray-100 text-gray-600{/if}">
                {pl.num}
            </button>
            {/if}
            {/foreach}

            <button type="button"
                    onclick="document.getElementById('tf-page-h').value='{next_page}'"
                    hx-get="{base_url}/api/trackers" hx-target="#tracker-list" hx-include="#tf" hx-swap="innerHTML"
                    {if !has_next}disabled{/if}
                    class="w-8 h-8 flex items-center justify-center rounded-lg border text-sm transition {if has_next}border-gray-200 hover:bg-gray-100 text-gray-600{else}border-gray-100 text-gray-300 cursor-not-allowed{/if}">
                <i class="fas fa-chevron-right text-xs"></i>
            </button>

        </div>
        {/if}
    </div>

{else}

    <div class="flex flex-col items-center justify-center py-20 text-center">
        <div class="w-16 h-16 rounded-full bg-gray-50 flex items-center justify-center mb-4">
            <i class="fas fa-clipboard-list text-2xl text-gray-300"></i>
        </div>
        <h3 class="text-base font-semibold text-gray-700 mb-1">No trackers found</h3>
        <p class="text-sm text-gray-400">Try adjusting your filters or create a new tracker.</p>
    </div>

{/if}

