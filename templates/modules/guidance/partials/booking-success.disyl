<div class="text-center py-8">
    <div class="inline-flex items-center justify-center w-20 h-20 bg-green-100 rounded-full mb-6">
        <i class="fas fa-check text-green-600 text-4xl"></i>
    </div>
    
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Request Submitted!</h2>
    <p class="text-gray-600 mb-6">Your appointment request has been received.</p>
    
    <div class="bg-gray-50 rounded-lg p-4 text-left max-w-sm mx-auto mb-6">
        <div class="space-y-2 text-sm">
            <div class="flex justify-between">
                <span class="text-gray-600">Reference #:</span>
                <span class="font-medium">APT-{appointment_id}</span>
            </div>
            <div class="flex justify-between">
                <span class="text-gray-600">Name:</span>
                <span class="font-medium">{student_name}</span>
            </div>
            <div class="flex justify-between">
                <span class="text-gray-600">Date:</span>
                <span class="font-medium">{scheduled_date}</span>
            </div>
            <div class="flex justify-between">
                <span class="text-gray-600">Time:</span>
                <span class="font-medium">{scheduled_time}</span>
            </div>
        </div>
    </div>
    
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 text-sm text-blue-800 mb-6">
        <i class="fas fa-envelope mr-2"></i>
        A confirmation email will be sent to <strong>{student_email}</strong> once your appointment is approved.
    </div>
    
    <div class="space-y-3">
        <a href="{base_url}/book" class="inline-block px-6 py-2.5 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors">
            <i class="fas fa-calendar-plus mr-2"></i> Book Another Appointment
        </a>
    </div>
</div>
