{!-- Case Appointments Tab Partial --}
{!-- Rendered by apiGuidanceCaseAppointments --}

<div x-data="{
    filter: 'all',
    raw: {appointments | json_attr},
    get rows() {
        if (this.filter === 'all')       return this.raw;
        if (this.filter === 'upcoming')  return this.raw.filter(a => ['scheduled','confirmed','pending','requested'].includes(a.status));
        if (this.filter === 'completed') return this.raw.filter(a => a.status === 'completed');
        if (this.filter === 'no_show')   return this.raw.filter(a => a.status === 'no_show');
        if (this.filter === 'cancelled') return this.raw.filter(a => a.status === 'cancelled');
        return this.raw;
    }
}" class="overflow-hidden">

    {!-- Header --}
    <div class="px-6 py-5 border-b border-gray-100 flex items-start justify-between gap-4 flex-wrap">
        <div>
            <h2 class="text-base font-semibold text-gray-900">Appointments</h2>
            <p class="text-xs text-gray-400 mt-0.5">View and manage all appointments for this student.</p>
        </div>
        <div class="flex items-center gap-2">
            <button class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gray-200 text-sm text-gray-600 hover:bg-gray-50 transition-colors">
                <i class="fas fa-filter text-xs text-gray-400"></i> Filter
            </button>
            <button hx-get="/pages/appointments/new" hx-target="#modal-container"
                    class="inline-flex items-center gap-1.5 px-4 py-2 bg-teal-700 text-white text-sm font-semibold rounded-lg hover:bg-teal-800 transition-colors shadow-sm">
                <i class="fas fa-plus text-xs"></i> New Appointment
            </button>
        </div>
    </div>

    {!-- Sub-tabs --}
    <div class="px-6 pt-4 pb-0 flex items-center gap-1 flex-wrap border-b border-gray-100">
        <button @click="filter = 'all'"
                :class="filter === 'all' ? 'bg-white border border-gray-200 text-gray-800 shadow-sm' : 'text-gray-500 hover:text-gray-700 border border-transparent'"
                class="px-4 py-1.5 rounded-md text-sm font-medium transition-all mb-3">
            All
        </button>
        <button @click="filter = 'upcoming'"
                :class="filter === 'upcoming' ? 'bg-white border border-gray-200 text-gray-800 shadow-sm' : 'text-gray-500 hover:text-gray-700 border border-transparent'"
                class="px-4 py-1.5 rounded-md text-sm font-medium transition-all mb-3">
            Upcoming
        </button>
        <button @click="filter = 'completed'"
                :class="filter === 'completed' ? 'bg-white border border-gray-200 text-gray-800 shadow-sm' : 'text-gray-500 hover:text-gray-700 border border-transparent'"
                class="px-4 py-1.5 rounded-md text-sm font-medium transition-all mb-3">
            Completed (Attended)
        </button>
        <button @click="filter = 'no_show'"
                :class="filter === 'no_show' ? 'bg-white border border-gray-200 text-gray-800 shadow-sm' : 'text-gray-500 hover:text-gray-700 border border-transparent'"
                class="px-4 py-1.5 rounded-md text-sm font-medium transition-all mb-3">
            Did Not Show Up
        </button>
        <button @click="filter = 'cancelled'"
                :class="filter === 'cancelled' ? 'bg-white border border-gray-200 text-gray-800 shadow-sm' : 'text-gray-500 hover:text-gray-700 border border-transparent'"
                class="px-4 py-1.5 rounded-md text-sm font-medium transition-all mb-3">
            Cancelled
        </button>
    </div>

    {!-- Table --}
    <div class="overflow-x-auto">
        <table class="min-w-full">
            <thead>
                <tr class="border-b border-gray-100 bg-gray-50/50">
                    <th class="px-6 py-3 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider w-44">Date &amp; Time</th>
                    <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider">Purpose</th>
                    <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider w-36">Counselor</th>
                    <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider w-36">Status</th>
                    <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider w-40">Attendance</th>
                    <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider w-24">Duration</th>
                    <th class="px-4 py-3 text-left text-[11px] font-semibold text-gray-400 uppercase tracking-wider w-28">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">

                <template x-if="rows.length === 0">
                    <tr>
                        <td colspan="7" class="px-6 py-14 text-center text-gray-400">
                            <i class="fas fa-calendar-times text-4xl text-gray-200 block mb-3"></i>
                            <p class="text-sm">No appointments found.</p>
                        </td>
                    </tr>
                </template>

                <template x-for="appt in rows" :key="appt.id">
                    <tr class="hover:bg-gray-50/50 transition-colors">

                        {!-- Date & Time --}
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-semibold text-gray-800" x-text="appt.formatted_date"></div>
                            <div class="text-xs text-gray-400 mt-0.5"
                                 x-text="appt.formatted_time + (appt.formatted_end ? ' \u2013 ' + appt.formatted_end : '')"></div>
                        </td>

                        {!-- Purpose --}
                        <td class="px-4 py-4">
                            <div class="text-sm font-semibold text-gray-900" x-text="appt.type_name || 'Session'"></div>
                            <div class="text-xs text-gray-400 mt-0.5 max-w-xs truncate" x-show="appt.purpose" x-text="appt.purpose"></div>
                        </td>

                        {!-- Counselor --}
                        <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600" x-text="appt.counselor_name || '\u2014'"></td>

                        {!-- Status badge --}
                        <td class="px-4 py-4 whitespace-nowrap">
                            <span x-show="appt.status === 'scheduled'"
                                  class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-blue-100 text-blue-700">SCHEDULED</span>
                            <span x-show="appt.status === 'confirmed'"
                                  class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-teal-100 text-teal-700">CONFIRMED</span>
                            <span x-show="appt.status === 'completed'"
                                  class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-green-100 text-green-700">COMPLETED</span>
                            <span x-show="appt.status === 'no_show'"
                                  class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-orange-100 text-orange-700">DID NOT SHOW UP</span>
                            <span x-show="appt.status === 'cancelled'"
                                  class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-red-100 text-red-600">CANCELLED</span>
                            <span x-show="['pending','requested'].includes(appt.status)"
                                  class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-indigo-100 text-indigo-700">PENDING</span>
                            <span x-show="appt.status === 'rejected'"
                                  class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-red-50 text-red-500">REJECTED</span>
                            <span x-show="!['scheduled','confirmed','completed','no_show','cancelled','pending','requested','rejected'].includes(appt.status)"
                                  class="inline-flex items-center px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-gray-100 text-gray-500"
                                  x-text="(appt.status || '\u2014').toUpperCase()"></span>
                        </td>

                        {!-- Attendance badge --}
                        <td class="px-4 py-4 whitespace-nowrap">
                            <span x-show="appt.status === 'completed'"
                                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-200">
                                <i class="fas fa-check-circle text-[10px]"></i> Went to Session
                            </span>
                            <span x-show="appt.status === 'no_show'"
                                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-orange-50 text-orange-700 border border-orange-200">
                                <i class="fas fa-clock text-[10px]"></i> Did Not Show Up
                            </span>
                            <span x-show="appt.status === 'cancelled'"
                                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-red-50 text-red-600 border border-red-200">
                                <i class="fas fa-times-circle text-[10px]"></i> Cancelled
                            </span>
                            <span x-show="['scheduled','confirmed'].includes(appt.status)"
                                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                                <i class="fas fa-calendar-check text-[10px]"></i> Scheduled
                            </span>
                            <span x-show="!['scheduled','confirmed','completed','no_show','cancelled'].includes(appt.status)"
                                  class="text-gray-300 text-sm">&mdash;</span>
                        </td>

                        {!-- Duration --}
                        <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-500">
                            <span x-show="appt.duration_minutes && appt.status !== 'cancelled'" x-text="appt.duration_minutes + ' mins'"></span>
                            <span x-show="!appt.duration_minutes || appt.status === 'cancelled'" class="text-gray-300">&mdash;</span>
                        </td>

                        {!-- Actions --}
                        <td class="px-4 py-4 whitespace-nowrap">
                            <div class="flex items-center gap-1">
                                <button @click="htmx.ajax('GET', '{base_url}/appointments/' + appt.id, {target: '#modal-container', swap: 'innerHTML'})"
                                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-teal-200 text-xs font-semibold text-teal-700 hover:bg-teal-50 transition-colors">
                                    <i class="fas fa-eye text-[10px]"></i> View
                                </button>
                                <button class="w-7 h-7 flex items-center justify-center rounded-lg border border-gray-200 text-gray-400 hover:bg-gray-50 transition-colors">
                                    <i class="fas fa-chevron-down text-[10px]"></i>
                                </button>
                            </div>
                        </td>

                    </tr>
                </template>

            </tbody>
        </table>
    </div>

    {!-- Footer count --}
    <div class="px-6 py-3 border-t border-gray-100 text-xs text-gray-400 flex items-center justify-between">
        <span x-text="'Showing 1 to ' + rows.length + ' of ' + rows.length + ' appointment' + (rows.length !== 1 ? 's' : '')"></span>
    </div>

    {!-- Attendance Legend --}
    <div class="px-6 py-4 border-t border-gray-100 bg-gray-50/40">
        <p class="text-[11px] font-semibold text-gray-500 uppercase tracking-wide mb-3">Attendance Status Legend</p>
        <div class="flex flex-wrap gap-6">
            <div class="flex items-start gap-2">
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-green-700">
                    <i class="fas fa-check-circle"></i> Went to Session
                </span>
                <span class="text-xs text-gray-400">Student attended the appointment.</span>
            </div>
            <div class="flex items-start gap-2">
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-orange-600">
                    <i class="fas fa-clock"></i> Did Not Show Up
                </span>
                <span class="text-xs text-gray-400">Student did not attend the appointment.</span>
            </div>
            <div class="flex items-start gap-2">
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-red-600">
                    <i class="fas fa-times-circle"></i> Cancelled
                </span>
                <span class="text-xs text-gray-400">Appointment was cancelled.</span>
            </div>
            <div class="flex items-start gap-2">
                <span class="inline-flex items-center gap-1 text-xs font-semibold text-blue-700">
                    <i class="fas fa-calendar-check"></i> Scheduled
                </span>
                <span class="text-xs text-gray-400">Appointment is scheduled for a future date.</span>
            </div>
        </div>
    </div>

</div>
