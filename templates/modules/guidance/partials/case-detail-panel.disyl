{!-- Case Detail Panel - Dashboard Workspace --}

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6" data-panel-case-id="{case.id}" data-panel-pane="{panel_mode}" {if selected_note_id}data-panel-note-id="{selected_note_id}"{/if}>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-5 pt-4 pb-2 border-b border-gray-50 flex items-center justify-between">
            <div class="flex items-center gap-2 text-sm text-gray-500">
                <a href="{base_url}/cases"
                   hx-get="{base_url}/pages/cases" hx-target="#main-content" hx-push-url="{base_url}/cases"
                   class="hover:text-teal-600 transition-colors">Students</a>
                <i class="fas fa-chevron-right text-xs text-gray-300"></i>
                <span class="text-gray-700 font-medium">{case.student_name | esc_html}</span>
            </div>
            <button onclick="document.getElementById('case-detail-panel').innerHTML=''"
                    class="text-xs text-gray-400 hover:text-gray-600 flex items-center gap-1 border border-gray-200 rounded px-2 py-1 hover:bg-gray-50 transition">
                <i class="fas fa-chevron-left text-[10px]"></i> Back
            </button>
        </div>

        <div class="p-5 flex items-start gap-4">
            <div class="w-16 h-16 rounded-full bg-gray-200 flex items-center justify-center flex-shrink-0">
                <i class="fas fa-user text-gray-400 text-2xl"></i>
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-3 flex-wrap">
                    <h2 class="text-lg font-bold text-gray-900">{case.student_name | esc_html}</h2>
                    {if case.student_status == 'probationary'}
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-violet-100 text-violet-700 uppercase tracking-wide">Probationary</span>
                    {elseif case.student_status == 'regular'}
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-700 uppercase tracking-wide">Regular</span>
                    {/if}
                </div>
                <div class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1.5 text-xs">
                    <div class="flex items-center gap-2">
                        <span class="text-gray-400 w-24 flex-shrink-0">Client Code</span>
                        <span class="font-medium text-gray-700">{case.case_number | esc_html | default:'—'}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-gray-400 w-24 flex-shrink-0">Contact No.</span>
                        <span class="font-medium text-gray-700">{case.student_mobile | esc_html | default:'—'}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-gray-400 w-24 flex-shrink-0">Gender</span>
                        <span class="font-medium text-gray-700">{case.gender | title | esc_html | default:'—'}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-gray-400 w-24 flex-shrink-0">Overall Status</span>
                        <span class="font-medium text-gray-700">{case.student_status | title | esc_html | default:'—'}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-gray-400 w-24 flex-shrink-0">Course</span>
                        <span class="font-medium text-gray-700">{case.college_code | esc_html | default:'—'}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-gray-400 w-24 flex-shrink-0">Severity</span>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold uppercase
                            {if case.severity == 'high' || case.severity == 'critical'}bg-red-100 text-red-700
                            {elseif case.severity == 'medium' || case.severity == 'moderate'}bg-orange-100 text-orange-700
                            {else}bg-green-100 text-green-700{/if}">
                            {if case.severity == 'high' || case.severity == 'critical'}High Risk
                            {elseif case.severity == 'medium' || case.severity == 'moderate'}Moderate Risk
                            {else}Low Risk{/if}
                        </span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-gray-400 w-24 flex-shrink-0">Year Level</span>
                        <span class="font-medium text-gray-700">{case.student_grade | esc_html | default:'—'}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-gray-400 w-24 flex-shrink-0">Counselor</span>
                        <span class="font-medium text-gray-700">{case.counselor_name | esc_html | default:'—'}</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-t border-gray-100">
            <div class="px-5 py-3 flex items-center justify-between gap-3">
                <div>
                    <h3 class="text-sm font-semibold text-gray-800">Session Record History</h3>
                    <p class="text-xs text-gray-400 mt-0.5">Select a session record to review it in the workspace on the right.</p>
                </div>
                <button hx-get="{panel_create_href}"
                        hx-target="{panel_target}" hx-swap="innerHTML"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-teal-700 text-white text-xs font-semibold rounded-lg hover:bg-teal-800 transition shadow-sm whitespace-nowrap">
                    <i class="fas fa-plus text-[10px]"></i> Add Session Record
                </button>
            </div>

            {if notes | count > 0}
            <div class="overflow-x-auto">
                <table class="w-full text-xs">
                    <thead>
                        <tr class="bg-gray-50 border-y border-gray-100">
                            <th class="px-4 py-2 text-left font-semibold text-gray-500 uppercase tracking-wide">Date</th>
                            <th class="px-4 py-2 text-left font-semibold text-gray-500 uppercase tracking-wide">Session</th>
                            <th class="px-4 py-2 text-left font-semibold text-gray-500 uppercase tracking-wide">Risk</th>
                            <th class="px-4 py-2 text-left font-semibold text-gray-500 uppercase tracking-wide">Counselor</th>
                            <th class="px-4 py-2 text-left font-semibold text-gray-500 uppercase tracking-wide">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {for note in notes}
                        <tr class="border-b border-gray-50 transition-colors {if selected_note_id == note.id}bg-teal-50/70{else}hover:bg-gray-50{/if}">
                            <td class="px-4 py-3 text-gray-700 whitespace-nowrap">{note.session_date | date:'M j, Y'}</td>
                            <td class="px-4 py-3 text-gray-700">
                                {if note.session_type == 'walk-in'}Walk-in
                                {elseif note.session_type == 'follow-up'}Follow-up
                                {elseif note.session_type == 'referred'}Referred
                                {else}Session{/if}
                            </td>
                            <td class="px-4 py-3">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold uppercase
                                    {if note.risk_level == 'high' || note.risk_level == 'critical'}bg-red-100 text-red-700
                                    {elseif note.risk_level == 'medium' || note.risk_level == 'moderate'}bg-orange-100 text-orange-700
                                    {elseif note.risk_level == 'low'}bg-green-100 text-green-700
                                    {else}bg-gray-100 text-gray-500{/if}">
                                    {if note.risk_level == 'high' || note.risk_level == 'critical'}High Risk
                                    {elseif note.risk_level == 'medium' || note.risk_level == 'moderate'}Moderate Risk
                                    {elseif note.risk_level == 'low'}Low Risk
                                    {else}—{/if}
                                </span>
                            </td>
                            <td class="px-4 py-3 text-gray-600">{note.counselor_name | esc_html | default:'—'}</td>
                            <td class="px-4 py-3">
                                <button hx-get="{base_url}/api/cases/{case.id}/panel?pane=view&amp;note_id={note.id}"
                                        hx-target="{panel_target}" hx-swap="innerHTML"
                                        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border text-[11px] font-semibold transition
                                            {if selected_note_id == note.id}border-teal-200 bg-teal-100 text-teal-700
                                            {else}border-gray-200 bg-white text-gray-600 hover:bg-gray-50{/if}">
                                    <i class="fas fa-eye text-[10px]"></i>
                                    {if selected_note_id == note.id}Viewing{else}View{/if}
                                </button>
                            </td>
                        </tr>
                        {/for}
                    </tbody>
                </table>
            </div>
            {else}
            <div class="px-5 py-8 text-center text-gray-400 text-sm">
                <i class="fas fa-clipboard text-2xl mb-2 text-gray-300 block"></i>
                No session records yet.
            </div>
            {/if}
        </div>
    </div>

    {if panel_mode == 'view' && selected_note_id}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex flex-col">
        <div hx-get="{base_url}/api/cases/{case.id}/notes/{selected_note_id}?panel=1"
             hx-trigger="load"
             hx-target="this"
             hx-swap="innerHTML"
             class="flex-1 min-h-[24rem]">
            <div class="h-full flex items-center justify-center text-sm text-gray-400">
                <i class="fas fa-spinner fa-spin mr-2"></i> Loading session...
            </div>
        </div>
    </div>
    {elseif panel_mode == 'create'}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex flex-col">
        <div class="px-5 pt-4 pb-3 border-b border-gray-100 flex items-start justify-between gap-3">
            <div>
                <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-600">Session Workspace</p>
                <h2 class="text-base font-semibold text-gray-900 mt-1">New Counseling Session</h2>
                <p class="text-xs text-gray-400 mt-1">Use the workspace to add a new record, then the panel will reopen on the saved session.</p>
            </div>
            <button hx-get="{panel_overview_href}" hx-target="{panel_target}" hx-swap="innerHTML"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-gray-200 text-xs font-semibold text-gray-600 hover:bg-gray-50 transition whitespace-nowrap">
                <i class="fas fa-arrow-left text-[10px]"></i> Back to Summary
            </button>
        </div>

        <form hx-post="{base_url}/api/cases/{case.id}/notes"
              hx-swap="none"
              class="p-5 flex flex-col gap-4 flex-1">
            <input type="hidden" name="note_type" value="session">

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Session Type <span class="text-red-500">*</span></label>
                    <select name="session_type" required
                            class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                        <option value="walk-in">Walk-in</option>
                        <option value="follow-up">Follow-up</option>
                        <option value="referred">Referred</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Session Date <span class="text-red-500">*</span></label>
                    <input type="date" name="session_date" value="{today}" required
                           class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:border-teal-500" />
                </div>
            </div>

            <div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Risk Level</label>
                    <select name="risk_level"
                            class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                        <option value="none">None</option>
                        <option value="low" {if create_default_risk_level == 'low'}selected{/if}>Low</option>
                        <option value="moderate" {if create_default_risk_level == 'moderate'}selected{/if}>Moderate</option>
                        <option value="high" {if create_default_risk_level == 'high'}selected{/if}>High</option>
                        <option value="critical" {if create_default_risk_level == 'critical'}selected{/if}>Critical</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Counseling Report <span class="text-red-500">*</span></label>
                <textarea name="note_content" rows="6" required placeholder="Document the counseling session..."
                          class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 resize-y"></textarea>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Observation &amp; Recommendation</label>
                <textarea name="observation_recommendation" rows="4" placeholder="Add observations, recommendations, or follow-up notes..."
                          class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 resize-y"></textarea>
            </div>

            <label class="inline-flex items-center gap-2 text-sm text-gray-700">
                <input type="checkbox" name="followup_required" value="1" class="rounded border-gray-300 text-teal-600 focus:ring-teal-500">
                <span>Follow-up required</span>
            </label>

            <div class="flex items-center justify-end gap-3 pt-2 mt-auto">
                <button type="button"
                        hx-get="{panel_overview_href}" hx-target="{panel_target}" hx-swap="innerHTML"
                        class="px-4 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                    Cancel
                </button>
                <button type="submit"
                        class="px-6 py-2 text-sm font-semibold text-white bg-teal-700 rounded-lg hover:bg-teal-800 transition shadow-sm">
                    Save Session
                </button>
            </div>
        </form>
    </div>
    {else}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex flex-col">
        <div class="px-5 pt-4 pb-3 border-b border-gray-100 flex items-start justify-between gap-3">
            <div>
                <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-600">Session Workspace</p>
                <h2 class="text-base font-semibold text-gray-900 mt-1">Review or Record a Session</h2>
                <p class="text-xs text-gray-400 mt-1">Keep viewing and creating counseling sessions in one coordinated panel.</p>
            </div>
            <button onclick="document.getElementById('case-detail-panel').innerHTML=''"
                    class="text-xs text-gray-400 hover:text-gray-600 flex items-center gap-1 border border-gray-200 rounded px-2 py-1 hover:bg-gray-50 transition whitespace-nowrap">
                <i class="fas fa-times text-[10px]"></i> Close
            </button>
        </div>

        <div class="p-5 flex-1 flex flex-col gap-5">
            <div class="grid grid-cols-2 gap-3">
                <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
                    <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-400">Total Sessions</p>
                    <p class="text-2xl font-bold text-gray-900 mt-2">{session_count}</p>
                    <p class="text-xs text-gray-500 mt-1">Recorded counseling notes for this student.</p>
                </div>
                <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
                    <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-400">Current Severity</p>
                    <div class="mt-2">
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold uppercase
                            {if case.severity == 'high' || case.severity == 'critical'}bg-red-100 text-red-700
                            {elseif case.severity == 'medium' || case.severity == 'moderate'}bg-orange-100 text-orange-700
                            {else}bg-green-100 text-green-700{/if}">
                            {if case.severity == 'high' || case.severity == 'critical'}High Risk
                            {elseif case.severity == 'medium' || case.severity == 'moderate'}Moderate Risk
                            {else}Low Risk{/if}
                        </span>
                    </div>
                    <p class="text-xs text-gray-500 mt-2">Use the history table to open a prior session or start a new one.</p>
                </div>
            </div>

            {if latest_note}
            <div class="rounded-2xl border border-teal-100 bg-teal-50/60 p-4">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <p class="text-[11px] font-semibold uppercase tracking-wide text-teal-600">Latest Session</p>
                        <h3 class="text-sm font-semibold text-gray-900 mt-1">{latest_note.note_title | esc_html}</h3>
                        <p class="text-xs text-gray-500 mt-1">{latest_note.session_date | date:'M j, Y'} by {latest_note.counselor_name | esc_html | default:'—'}</p>
                    </div>
                    <button hx-get="{base_url}/api/cases/{case.id}/panel?pane=view&amp;note_id={latest_note.id}"
                            hx-target="{panel_target}" hx-swap="innerHTML"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-teal-200 text-xs font-semibold text-teal-700 hover:bg-teal-50 transition whitespace-nowrap">
                        <i class="fas fa-eye text-[10px]"></i> View Latest
                    </button>
                </div>
                {if latest_note.note_preview}
                <p class="text-sm text-gray-600 leading-relaxed mt-3">{latest_note.note_preview | esc_html}</p>
                {/if}
            </div>
            {else}
            <div class="rounded-2xl border border-dashed border-gray-300 bg-gray-50 px-5 py-8 text-center">
                <i class="fas fa-notes-medical text-2xl text-gray-300"></i>
                <h3 class="text-sm font-semibold text-gray-700 mt-3">No session records yet</h3>
                <p class="text-xs text-gray-500 mt-1">Start the first counseling session record for this student from the workspace.</p>
            </div>
            {/if}

            <div class="mt-auto flex items-center justify-between gap-3">
                <a href="{base_url}/cases/{case.id}"
                   hx-get="{base_url}/pages/cases/{case.id}" hx-target="#main-content" hx-push-url="{base_url}/cases/{case.id}"
                   class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gray-200 text-sm font-medium text-gray-600 hover:bg-gray-50 transition">
                    <i class="fas fa-arrow-up-right-from-square text-[11px]"></i> Open Full Case
                </a>
                <button hx-get="{panel_create_href}"
                        hx-target="{panel_target}" hx-swap="innerHTML"
                        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-teal-700 text-white text-sm font-semibold hover:bg-teal-800 transition shadow-sm">
                    <i class="fas fa-plus text-[10px]"></i> Add Session Record
                </button>
            </div>
        </div>
    </div>
    {/if}

</div>
