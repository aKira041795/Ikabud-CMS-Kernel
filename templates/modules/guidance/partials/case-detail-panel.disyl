{!-- Case Detail Panel - Dashboard Inline View --}
{!-- Split: left = student profile + session history table, right = add new session form --}

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    {!-- LEFT: Student Profile + Session History --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">

        {!-- Breadcrumb / back --}
        <div class="px-5 pt-4 pb-2 border-b border-gray-50 flex items-center justify-between">
            <div class="flex items-center gap-2 text-sm text-gray-500">
                <a href="{base_url}/cases"
                   hx-get="{base_url}/pages/cases" hx-target="#main-content" hx-push-url="{base_url}/cases"
                   class="hover:text-teal-600 transition-colors">Students</a>
                <i class="fas fa-chevron-right text-xs text-gray-300"></i>
                <span class="text-gray-700 font-medium">{case.student_name | esc_html}</span>
            </div>
            <button onclick="document.getElementById('case-detail-panel').innerHTML=''"
                    class="text-xs text-gray-400 hover:text-gray-600 flex items-center gap-1 border border-gray-200 rounded px-2 py-1 hover:bg-gray-50 transition">
                <i class="fas fa-chevron-left text-[10px]"></i> Back
            </button>
        </div>

        {!-- Profile --}
        <div class="p-5 flex items-start gap-4">
            <div class="w-16 h-16 rounded-full bg-gray-200 flex items-center justify-center flex-shrink-0">
                <i class="fas fa-user text-gray-400 text-2xl"></i>
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-3 flex-wrap">
                    <h2 class="text-lg font-bold text-gray-900">{case.student_name | esc_html}</h2>
                    {if case.student_status == 'probationary'}
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-violet-100 text-violet-700 uppercase tracking-wide">Probationary</span>
                    {elseif case.student_status == 'regular'}
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-700 uppercase tracking-wide">Regular</span>
                    {/if}
                </div>
                <div class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1.5 text-xs">
                    <div class="flex items-center gap-2">
                        <span class="text-gray-400 w-24 flex-shrink-0">Client Code</span>
                        <span class="font-medium text-gray-700">{case.case_number | esc_html | default:'—'}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-gray-400 w-24 flex-shrink-0">Contact No.</span>
                        <span class="font-medium text-gray-700">{case.student_mobile | esc_html | default:'—'}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-gray-400 w-24 flex-shrink-0">Gender</span>
                        <span class="font-medium text-gray-700">{case.gender | title | esc_html | default:'—'}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-gray-400 w-24 flex-shrink-0">Overall Status</span>
                        <span class="font-medium text-gray-700">{case.student_status | title | esc_html | default:'—'}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-gray-400 w-24 flex-shrink-0">Course</span>
                        <span class="font-medium text-gray-700">{case.college_code | esc_html | default:'—'}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-gray-400 w-24 flex-shrink-0">Severity</span>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold uppercase
                            {if case.severity == 'high' || case.severity == 'critical'}bg-red-100 text-red-700
                            {elseif case.severity == 'medium'}bg-orange-100 text-orange-700
                            {else}bg-green-100 text-green-700{/if}">
                            {if case.severity == 'high' || case.severity == 'critical'}High Risk
                            {elseif case.severity == 'medium'}Moderate Risk
                            {else}Low Risk{/if}
                        </span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-gray-400 w-24 flex-shrink-0">Year Level</span>
                        <span class="font-medium text-gray-700">{case.student_grade | esc_html | default:'—'}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-gray-400 w-24 flex-shrink-0">Status</span>
                        <span class="font-medium text-gray-700">{case.student_status | title | esc_html | default:'—'}</span>
                    </div>
                </div>
            </div>
        </div>

        {!-- Session History table --}
        <div class="border-t border-gray-100">
            <div class="px-5 py-3 flex items-center justify-between">
                <h3 class="text-sm font-semibold text-gray-800">Counseling Session History</h3>
                <button hx-get="{base_url}/pages/cases/{case.id}/notes/new"
                        hx-target="#modal-container" hx-swap="innerHTML"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-teal-700 text-white text-xs font-semibold rounded-lg hover:bg-teal-800 transition shadow-sm">
                    <i class="fas fa-plus text-[10px]"></i> Add New Session
                </button>
            </div>

            {if notes | count > 0}
            <div class="overflow-x-auto" x-data="{openNote: null}">
                <table class="w-full text-xs">
                    <thead>
                        <tr class="bg-gray-50 border-y border-gray-100">
                            <th class="px-4 py-2 text-left font-semibold text-gray-500 uppercase tracking-wide">Date</th>
                            <th class="px-4 py-2 text-left font-semibold text-gray-500 uppercase tracking-wide">Severity</th>
                            <th class="px-4 py-2 text-left font-semibold text-gray-500 uppercase tracking-wide">Status</th>
                            <th class="px-4 py-2 text-left font-semibold text-gray-500 uppercase tracking-wide">Counselor</th>
                            <th class="px-4 py-2 text-left font-semibold text-gray-500 uppercase tracking-wide">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {for note in notes}
                        <tr class="border-b border-gray-50 hover:bg-gray-50 transition-colors">
                            <td class="px-4 py-2 text-gray-700">{note.session_date | date:'M j, Y'}</td>
                            <td class="px-4 py-2">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold uppercase
                                    {if note.risk_level == 'high' || note.risk_level == 'critical'}bg-red-100 text-red-700
                                    {elseif note.risk_level == 'medium'}bg-orange-100 text-orange-700
                                    {elseif note.risk_level == 'low'}bg-green-100 text-green-700
                                    {else}bg-gray-100 text-gray-500{/if}">
                                    {if note.risk_level == 'high' || note.risk_level == 'critical'}High Risk
                                    {elseif note.risk_level == 'medium'}Moderate Risk
                                    {elseif note.risk_level == 'low'}Low Risk
                                    {else}—{/if}
                                </span>
                            </td>
                            <td class="px-4 py-2">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold uppercase
                                    {if note.student_status == 'probationary'}bg-violet-100 text-violet-700
                                    {elseif note.student_status == 'regular'}bg-blue-100 text-blue-700
                                    {else}bg-gray-100 text-gray-500{/if}">
                                    {note.student_status | title | esc_html | default:'—'}
                                </span>
                            </td>
                            <td class="px-4 py-2 text-gray-600">{note.counselor_name | esc_html | default:'—'}</td>
                            <td class="px-4 py-2">
                                <button @click="openNote = (openNote === {note.id} ? null : {note.id})"
                                        class="w-7 h-7 rounded-lg bg-teal-50 text-teal-600 hover:bg-teal-100 transition flex items-center justify-center">
                                    <i class="fas fa-eye text-[10px]"></i>
                                </button>
                            </td>
                        </tr>
                        <tr x-show="openNote === {note.id}" x-cloak>
                            <td colspan="5" class="px-4 py-3 text-xs text-gray-600 italic bg-gray-50 border-b border-gray-100">
                                {note.note_content | esc_html | nl2br}
                                {if note.observation_recommendation}
                                <div class="mt-2 pt-2 border-t border-gray-200">
                                    <span class="font-semibold not-italic text-gray-500">Counselor Notes: </span>{note.observation_recommendation | esc_html | nl2br}
                                </div>
                                {/if}
                            </td>
                        </tr>
                        {/for}
                    </tbody>
                </table>
            </div>
            {else}
            <div class="px-5 py-8 text-center text-gray-400 text-sm">
                <i class="fas fa-clipboard text-2xl mb-2 text-gray-300 block"></i>
                No session records yet.
            </div>
            {/if}
        </div>
    </div>

    {!-- RIGHT: Add New Counseling Session form --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex flex-col">
        <div class="px-5 pt-4 pb-2 border-b border-gray-100 flex items-center justify-between">
            <h2 class="text-base font-semibold text-gray-900">Add New Counseling Session</h2>
            <button onclick="document.getElementById('case-detail-panel').innerHTML=''"
                    class="text-xs text-gray-400 hover:text-gray-600 flex items-center gap-1 border border-gray-200 rounded px-2 py-1 hover:bg-gray-50 transition">
                <i class="fas fa-chevron-left text-[10px]"></i> Back
            </button>
        </div>

        <form hx-post="{base_url}/api/cases/{case.id}/notes"
              hx-swap="none"
              class="p-5 flex flex-col gap-4 flex-1"
              data-panel-case-id="{case.id}">
            <input type="hidden" name="note_type" value="session">

            <div class="grid grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Date <span class="text-red-500">*</span></label>
                    <input type="date" name="session_date" value="{today}" required
                           class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:border-teal-500" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Severity <span class="text-red-500">*</span></label>
                    <select name="risk_level" required
                            class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                        <option value="low" {if case.severity == 'low'}selected{/if}>Low Risk</option>
                        <option value="medium" {if case.severity == 'medium'}selected{/if}>Moderate Risk</option>
                        <option value="high" {if case.severity == 'high' || case.severity == 'critical'}selected{/if}>High Risk</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Status <span class="text-red-500">*</span></label>
                    <select name="student_status" required
                            class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                        <option value="probationary" {if case.student_status == 'probationary'}selected{/if}>Probationary</option>
                        <option value="regular" {if case.student_status == 'regular'}selected{/if}>Regular</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Counseling Report <span class="text-red-500">*</span></label>
                <textarea name="note_content" rows="4" required placeholder="Enter counseling report..."
                          class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 resize-none"></textarea>
            </div>

            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Counselor's Notes</label>
                <textarea name="observation_recommendation" rows="4" placeholder="Enter counselor's notes..."
                          class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 resize-none"></textarea>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <button type="button"
                        onclick="document.getElementById('case-detail-panel').innerHTML=''"
                        class="px-4 py-2 text-sm font-medium text-gray-600 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                    Cancel
                </button>
                <button type="submit"
                        class="px-6 py-2 text-sm font-semibold text-white bg-teal-700 rounded-lg hover:bg-teal-800 transition shadow-sm">
                    Save Session
                </button>
            </div>
        </form>
    </div>

</div>
