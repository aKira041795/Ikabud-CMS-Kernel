{!-- Case Notes Tab --}
{!-- Rendered by apiGuidanceCaseNotes (HTMX) --}

{!-- Header --}
<div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-white">
    <div>
        <h2 class="text-base font-bold text-gray-900">Notes</h2>
        <p class="text-xs text-gray-400 mt-0.5">View and manage notes about the student.</p>
    </div>
    <button hx-get="/admin/guidance/pages/cases/{case_id}/notes/new"
            hx-target="#modal-container" hx-swap="innerHTML"
            class="inline-flex items-center gap-1.5 px-4 py-2 bg-teal-700 text-white text-sm font-semibold rounded-lg hover:bg-teal-800 transition-colors shadow-sm">
        <i class="fas fa-plus text-xs"></i> Add Note
    </button>
</div>

{!-- Two-column layout --}
<div class="flex min-h-[520px]">

    {!-- LEFT: note list --}
    <div class="w-72 xl:w-80 flex-shrink-0 border-r border-gray-100 flex flex-col bg-white" id="notes-list-col">

        {!-- Search + filter bar --}
        <div class="px-4 py-3 border-b border-gray-100">
            <div class="text-xs font-semibold text-gray-600 mb-2">All Notes ({total})</div>
            <div class="flex items-center gap-2">
                <div class="flex-1 relative">
                    <i class="fas fa-search absolute left-2.5 top-1/2 -translate-y-1/2 text-gray-300 text-[11px]"></i>
                    <input type="text" id="notes-search-input" placeholder="Search notes..."
                           value="{search | esc_attr}"
                           class="w-full pl-7 pr-3 py-1.5 text-xs border border-gray-200 rounded-lg focus:outline-none focus:border-teal-400 bg-gray-50"
                           oninput="debounceNoteSearch(this.value)">
                </div>
                <button class="w-7 h-7 flex items-center justify-center rounded-lg border border-gray-200 text-gray-400 hover:bg-gray-50 flex-shrink-0">
                    <i class="fas fa-filter text-[11px]"></i>
                </button>
            </div>
        </div>

        {!-- Note rows --}
        <div class="flex-1 overflow-y-auto divide-y divide-gray-50" id="notes-list-rows">
            {if notes | count > 0}
            {for note in notes}
            <div class="group px-4 py-3 cursor-pointer hover:bg-gray-50 transition-colors border-l-2 border-transparent"
                 id="note-row-{note.id}"
                 onclick="loadCaseNoteDetail({note.id})">

                <div class="flex items-start gap-3">
                    {!-- Icon by note_type --}
                    {if note.note_type == 'session'}
                    <div class="w-8 h-8 rounded-lg bg-teal-50 border border-teal-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <i class="fas fa-comment-dots text-teal-500 text-xs"></i>
                    </div>
                    {elseif note.note_type == 'phone'}
                    <div class="w-8 h-8 rounded-lg bg-blue-50 border border-blue-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <i class="fas fa-phone text-blue-500 text-xs"></i>
                    </div>
                    {elseif note.note_type == 'observation'}
                    <div class="w-8 h-8 rounded-lg bg-purple-50 border border-purple-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <i class="fas fa-eye text-purple-500 text-xs"></i>
                    </div>
                    {elseif note.note_type == 'consultation'}
                    <div class="w-8 h-8 rounded-lg bg-orange-50 border border-orange-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <i class="fas fa-users text-orange-500 text-xs"></i>
                    </div>
                    {elseif note.note_type == 'followup'}
                    <div class="w-8 h-8 rounded-lg bg-indigo-50 border border-indigo-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <i class="fas fa-redo text-indigo-500 text-xs"></i>
                    </div>
                    {elseif note.note_type == 'referral'}
                    <div class="w-8 h-8 rounded-lg bg-amber-50 border border-amber-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <i class="fas fa-share text-amber-500 text-xs"></i>
                    </div>
                    {else}
                    <div class="w-8 h-8 rounded-lg bg-gray-100 border border-gray-200 flex items-center justify-center flex-shrink-0 mt-0.5">
                        <i class="fas fa-sticky-note text-gray-400 text-xs"></i>
                    </div>
                    {/if}

                    <div class="flex-1 min-w-0">
                        <div class="text-xs font-semibold text-gray-800 leading-snug truncate">{note.note_title | esc_html}</div>
                        <div class="text-[11px] text-gray-400 mt-0.5 truncate">
                            {note.counselor_name | esc_html} &bull; {note.formatted_date}{if note.formatted_time} &bull; {note.formatted_time}{/if}
                        </div>
                        <div class="text-[11px] text-gray-500 mt-1 line-clamp-2 leading-relaxed">{note.note_preview | esc_html}</div>
                    </div>
                </div>
            </div>
            {/for}
            {else}
            <div class="flex flex-col items-center justify-center py-14 text-gray-300">
                <i class="fas fa-sticky-note text-3xl mb-3"></i>
                <p class="text-xs">No notes yet</p>
            </div>
            {/if}
        </div>

        {!-- Footer count --}
        <div class="px-4 py-2.5 border-t border-gray-100 bg-gray-50">
            <span class="text-[11px] text-gray-400">Showing {from} to {to} of {total} notes</span>
        </div>
    </div>

    {!-- RIGHT: detail panel --}
    <div class="flex-1 min-w-0 bg-white">
        <div id="note-detail-container" class="h-full">
            {!-- Placeholder --}
            <div class="flex flex-col items-center justify-center h-full py-20 text-gray-300">
                <i class="fas fa-hand-pointer text-3xl mb-3"></i>
                <p class="text-sm font-medium text-gray-400">Select a note to view its details.</p>
                <p class="text-xs text-gray-300 mt-1">Click any note from the list on the left.</p>
            </div>
        </div>
    </div>
</div>

{!-- Pagination (below layout) --}
{if total_pages > 1}
<div class="px-6 py-3 border-t border-gray-100 flex items-center justify-between bg-gray-50 text-xs text-gray-500">
    <span>Page {page} of {total_pages}</span>
    <div class="flex items-center gap-1">
        {if page > 1}
        <button hx-get="/admin/guidance/api/cases/{case_id}/notes?page={page - 1}{if search}&amp;q={search | url_encode}{/if}"
                hx-target="#case-notes-tab" hx-swap="innerHTML"
                onclick="clearCaseNoteDetailSelection()"
                class="px-3 py-1.5 rounded-lg border border-gray-200 text-xs font-medium text-gray-600 hover:bg-white transition-colors">
            &laquo; Prev
        </button>
        {/if}
        {if page < total_pages}
        <button hx-get="/admin/guidance/api/cases/{case_id}/notes?page={page + 1}{if search}&amp;q={search | url_encode}{/if}"
                hx-target="#case-notes-tab" hx-swap="innerHTML"
                onclick="clearCaseNoteDetailSelection()"
                class="px-3 py-1.5 rounded-lg border border-gray-200 text-xs font-medium text-gray-600 hover:bg-white transition-colors">
            Next &raquo;
        </button>
        {/if}
    </div>
</div>
{/if}

<script>
function caseNoteDetailPlaceholderHtml() {
    return '<div class="flex flex-col items-center justify-center h-full py-20 text-gray-300">'
        + '<i class="fas fa-hand-pointer text-3xl mb-3"></i>'
        + '<p class="text-sm font-medium text-gray-400">Select a note to view its details.</p>'
        + '<p class="text-xs text-gray-300 mt-1">Click any note from the list on the left.</p>'
        + '</div>';
}

function clearCaseNoteDetailSelection() {
    var notesTab = document.getElementById('case-notes-tab');
    if (notesTab) {
        delete notesTab.dataset.selectedNoteId;
    }

    document.querySelectorAll('#notes-list-rows > div[id^="note-row-"]').forEach(function(r) {
        r.classList.remove('bg-teal-50', 'border-l-teal-500');
        r.classList.add('border-l-transparent');
    });

    var detailContainer = document.getElementById('note-detail-container');
    if (detailContainer) {
        detailContainer.innerHTML = caseNoteDetailPlaceholderHtml();
    }
}

function loadCaseNoteDetail(noteId, options) {
    var settings = options || {};
    var notesTab = document.getElementById('case-notes-tab');
    if (notesTab && !settings.skipStore) {
        notesTab.dataset.selectedNoteId = String(noteId);
    }

    // Highlight selected row
    document.querySelectorAll('#notes-list-rows > div[id^="note-row-"]').forEach(function(r) {
        r.classList.remove('bg-teal-50', 'border-l-teal-500');
        r.classList.add('border-l-transparent');
    });
    var row = document.getElementById('note-row-' + noteId);
    if (row) {
        row.classList.add('bg-teal-50', 'border-l-teal-500');
        row.classList.remove('border-l-transparent');
    }
    htmx.ajax('GET', '/admin/guidance/api/cases/{case_id}/notes/' + noteId, {
        target: '#note-detail-container',
        swap: 'innerHTML'
    });
}

var _noteSearchTimer = null;
function debounceNoteSearch(val) {
    clearTimeout(_noteSearchTimer);
    _noteSearchTimer = setTimeout(function() {
        clearCaseNoteDetailSelection();
        htmx.ajax('GET', '/admin/guidance/api/cases/{case_id}/notes?q=' + encodeURIComponent(val), {
            target: '#case-notes-tab',
            swap: 'innerHTML'
        });
    }, 350);
}

if (!window.__guidanceCaseNoteDetailRestoreBound) {
    window.__guidanceCaseNoteDetailRestoreBound = true;

    document.addEventListener('htmx:afterSwap', function(evt) {
        var target = evt.detail && evt.detail.target ? evt.detail.target : null;
        if (!target || target.id !== 'case-notes-tab') {
            return;
        }

        var selectedNoteId = target.dataset.selectedNoteId;
        if (!selectedNoteId) {
            clearCaseNoteDetailSelection();
            return;
        }

        requestAnimationFrame(function() {
            loadCaseNoteDetail(selectedNoteId, { skipStore: true });
        });
    });
}
</script>
