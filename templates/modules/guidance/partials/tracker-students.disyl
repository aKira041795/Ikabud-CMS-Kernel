{!-- Stats summary --}
{if total > 0}
<div class="flex flex-wrap gap-3 mb-5">
    <div class="flex items-center gap-2 px-3 py-2 bg-indigo-50 rounded-lg border border-indigo-100">
        <i class="fas fa-users text-indigo-500 text-sm"></i>
        <span class="text-sm font-semibold text-indigo-700">{total}</span>
        <span class="text-xs text-indigo-600">Students</span>
    </div>
</div>
{/if}

{if students}
<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Student</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">College</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Year / Section</th>
                    {foreach items as item}
                    <th class="px-3 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider whitespace-nowrap" title="{item.name}">
                        <span class="block max-w-[80px] truncate mx-auto">{item.name}</span>
                    </th>
                    {/foreach}
                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Progress</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {foreach students as student}
                <tr class="hover:bg-gray-50 transition">
                    <td class="px-4 py-3">
                        <div class="font-medium text-gray-800 text-sm">{student.student_name}</div>
                        {if student.student_id}<div class="text-xs text-gray-400">{student.student_id}</div>{/if}
                        {if student.email}<div class="text-xs text-gray-400">{student.email}</div>{/if}
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-600">{student.college_name | default:'-'}</td>
                    <td class="px-4 py-3 text-sm text-gray-600">
                        {if student.year_level}{student.year_level}{/if}
                        {if student.section} / {student.section}{/if}
                        {if !student.year_level and !student.section}-{/if}
                    </td>
                    {foreach student.cells as cell}
                    <td class="px-3 py-3 text-center">
                        {if cell.status == 'submitted'}
                        <button hx-post="/api/trackers/{tracker_id}/submissions" 
                                hx-vals='{"tracker_student_id":"{cell.student_id | raw}","tracker_item_id":"{cell.item_id | raw}","status":"verified"}'
                                hx-swap="none"
                                class="w-7 h-7 rounded-full bg-blue-100 text-blue-600 hover:bg-green-100 hover:text-green-600 transition inline-flex items-center justify-center" title="Submitted - click to verify">
                            <i class="fas fa-check text-xs"></i>
                        </button>
                        {elseif cell.status == 'verified'}
                        <span class="w-7 h-7 rounded-full bg-green-100 text-green-600 inline-flex items-center justify-center" title="Verified">
                            <i class="fas fa-check-double text-xs"></i>
                        </span>
                        {elseif cell.status == 'rejected'}
                        <button hx-post="/api/trackers/{tracker_id}/submissions" 
                                hx-vals='{"tracker_student_id":"{cell.student_id | raw}","tracker_item_id":"{cell.item_id | raw}","status":"submitted"}'
                                hx-swap="none"
                                class="w-7 h-7 rounded-full bg-red-100 text-red-600 hover:bg-blue-100 hover:text-blue-600 transition inline-flex items-center justify-center" title="Rejected - click to resubmit">
                            <i class="fas fa-times text-xs"></i>
                        </button>
                        {else}
                        <button hx-post="/api/trackers/{tracker_id}/submissions" 
                                hx-vals='{"tracker_student_id":"{cell.student_id | raw}","tracker_item_id":"{cell.item_id | raw}","status":"submitted"}'
                                hx-swap="none"
                                class="w-7 h-7 rounded-full bg-gray-100 text-gray-400 hover:bg-blue-100 hover:text-blue-600 transition inline-flex items-center justify-center" title="Pending - click to mark submitted">
                            <i class="fas fa-minus text-xs"></i>
                        </button>
                        {/if}
                    </td>
                    {/foreach}
                    <td class="px-4 py-3 text-center">
                        <div class="flex items-center justify-center gap-2">
                            <div class="w-20 bg-gray-200 rounded-full h-2">
                                <div class="h-2 rounded-full transition-all {if student.completion >= 80}bg-green-500{elseif student.completion >= 50}bg-yellow-500{else}bg-indigo-500{/if}" style="width: {student.completion | raw}%"></div>
                            </div>
                            <span class="text-xs font-medium text-gray-600 w-10">{student.completion}%</span>
                        </div>
                        <div class="text-xs text-gray-400 mt-0.5">{student.completed_count}/{student.total_items}</div>
                    </td>
                    <td class="px-4 py-3 text-right">
                        {if user.role == 'admin' or user.role == 'supervisor'}
                        <button hx-delete="/api/trackers/{tracker_id}/students/{student.id}" 
                                hx-swap="none" hx-confirm="Remove this student from the tracker?"
                                class="text-red-400 hover:text-red-600 text-sm" title="Remove">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                        {/if}
                    </td>
                </tr>
                {/foreach}
            </tbody>
        </table>
    </div>
    
    {!-- Pagination --}
    {if pages > 1}
    <div class="px-4 py-3 border-t bg-gray-50 flex items-center justify-between">
        <span class="text-sm text-gray-500">Page {page} of {pages} ({total} students)</span>
        <div class="flex gap-1">
            {if page > 1}
            <button hx-get="/api/trackers/{tracker_id}/students?page={page - 1}" hx-target="#students-table" 
                    class="px-3 py-1 text-sm border rounded hover:bg-gray-100">Prev</button>
            {/if}
            {if page < pages}
            <button hx-get="/api/trackers/{tracker_id}/students?page={page + 1}" hx-target="#students-table" 
                    class="px-3 py-1 text-sm border rounded hover:bg-gray-100">Next</button>
            {/if}
        </div>
    </div>
    {/if}
</div>
{else}
<div class="text-center py-12 bg-white rounded-xl border border-gray-200">
    <i class="fas fa-user-graduate text-4xl text-gray-300 mb-3"></i>
    <p class="text-gray-500 font-medium">No students in this tracker yet</p>
    <p class="text-gray-400 text-sm mt-1">Add students manually or import from a CSV file</p>
</div>
{/if}
