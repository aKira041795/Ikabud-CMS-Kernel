{!-- Appointment / Session Types Settings --}

<div class="space-y-4">
    <div class="rounded-xl border border-indigo-100 bg-indigo-50/60 p-5">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h3 class="text-sm font-semibold text-gray-900">Add Session Type</h3>
                <p class="text-xs text-gray-500 mt-1">These types are used for internal scheduling and public booking.</p>
            </div>
        </div>

        <form hx-post="{base_url}/api/appointment-types" hx-swap="none" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <div class="md:col-span-2">
                    <label class="block text-xs font-medium text-gray-600 mb-1">Name *</label>
                    <input type="text" name="name" required placeholder="e.g. Initial Assessment"
                           class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Code</label>
                    <input type="text" name="code" placeholder="Auto-generated if blank"
                           class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                <div class="md:col-span-2">
                    <label class="block text-xs font-medium text-gray-600 mb-1">Description</label>
                    <input type="text" name="description" placeholder="Optional description"
                           class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Color</label>
                    <input type="color" name="color" value="#6366f1"
                           class="w-full h-10 px-2 py-1 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white">
                </div>
                <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Sort Order</label>
                    <input type="number" name="sort_order" value="0" min="0"
                           class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-4 text-sm text-gray-700">
                <label class="inline-flex items-center gap-2">
                    <input type="hidden" name="requires_case" value="0">
                    <input type="checkbox" name="requires_case" value="1" class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                    <span>Requires case</span>
                </label>
                <label class="inline-flex items-center gap-2">
                    <input type="hidden" name="is_public" value="0">
                    <input type="checkbox" name="is_public" value="1" checked class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                    <span>Available in booking</span>
                </label>
                <label class="inline-flex items-center gap-2">
                    <input type="hidden" name="is_active" value="0">
                    <input type="checkbox" name="is_active" value="1" checked class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                    <span>Active</span>
                </label>
            </div>

            <div class="flex justify-end">
                <button type="submit" class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition">
                    <i class="fas fa-plus mr-2"></i> Add Session Type
                </button>
            </div>
        </form>
    </div>

    {if appointment_types | count > 0}
        {foreach appointment_types as type}
        <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
            <form hx-put="{base_url}/api/appointment-types/{type.id}" hx-swap="none" class="space-y-4">
                <div class="flex items-start justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <span class="inline-flex w-3 h-3 rounded-full border border-gray-200" style="background:{type.color}"></span>
                        <div>
                            <h3 class="text-sm font-semibold text-gray-900">{type.name}</h3>
                            <p class="text-xs text-gray-500">Code: {type.code}</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        {if type.is_public}
                        <span class="px-2 py-1 rounded-full text-[11px] font-medium bg-blue-50 text-blue-700 border border-blue-200">Public</span>
                        {/if}
                        {if type.requires_case}
                        <span class="px-2 py-1 rounded-full text-[11px] font-medium bg-amber-50 text-amber-700 border border-amber-200">Case Required</span>
                        {/if}
                        {if type.is_active}
                        <span class="px-2 py-1 rounded-full text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">Active</span>
                        {else}
                        <span class="px-2 py-1 rounded-full text-[11px] font-medium bg-gray-100 text-gray-600 border border-gray-200">Inactive</span>
                        {/if}
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    <div class="md:col-span-2">
                        <label class="block text-xs font-medium text-gray-600 mb-1">Name</label>
                        <input type="text" name="name" value="{type.name}" required
                               class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Code</label>
                        <input type="text" name="code" value="{type.code}"
                               class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-3">
                    <div class="md:col-span-2">
                        <label class="block text-xs font-medium text-gray-600 mb-1">Description</label>
                        <input type="text" name="description" value="{type.description | default:''}"
                               class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Color</label>
                        <input type="color" name="color" value="{type.color}"
                               class="w-full h-10 px-2 py-1 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-600 mb-1">Sort Order</label>
                        <input type="number" name="sort_order" value="{type.sort_order}" min="0"
                               class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-4 text-sm text-gray-700">
                    <label class="inline-flex items-center gap-2">
                        <input type="hidden" name="requires_case" value="0">
                        <input type="checkbox" name="requires_case" value="1" {if type.requires_case}checked{/if} class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                        <span>Requires case</span>
                    </label>
                    <label class="inline-flex items-center gap-2">
                        <input type="hidden" name="is_public" value="0">
                        <input type="checkbox" name="is_public" value="1" {if type.is_public}checked{/if} class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                        <span>Available in booking</span>
                    </label>
                    <label class="inline-flex items-center gap-2">
                        <input type="hidden" name="is_active" value="0">
                        <input type="checkbox" name="is_active" value="1" {if type.is_active}checked{/if} class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                        <span>Active</span>
                    </label>
                </div>

                <div class="flex items-center justify-between pt-2 border-t border-gray-100">
                    <button type="button"
                            hx-delete="{base_url}/api/appointment-types/{type.id}"
                            hx-swap="none"
                            hx-confirm="Delete this session type? Existing appointments must not reference it."
                            class="inline-flex items-center px-3 py-2 text-sm font-medium text-red-600 hover:text-red-700 hover:bg-red-50 rounded-lg transition">
                        <i class="fas fa-trash mr-2"></i> Delete
                    </button>
                    <button type="submit" class="inline-flex items-center px-4 py-2 bg-gray-900 text-white text-sm font-medium rounded-lg hover:bg-black transition">
                        <i class="fas fa-save mr-2"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
        {/foreach}
    {else}
    <div class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-8 text-center text-gray-500">
        <i class="fas fa-layer-group text-2xl mb-3"></i>
        <p class="text-sm">No session types configured yet.</p>
    </div>
    {/if}
</div>