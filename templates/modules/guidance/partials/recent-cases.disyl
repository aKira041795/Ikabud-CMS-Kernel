{!-- Recent Counseling Sessions Partial - Dashboard Widget --}
{!-- Columns: CLIENT CODE, LAST NAME, FIRST NAME, COURSE, YEAR LEVEL, SEVERITY, OVERALL STATUS, DATE, COUNSELOR, ACTION --}

{if cases | count > 0}
<table class="w-full text-sm">
    <thead>
        <tr class="text-xs font-semibold text-gray-500 uppercase tracking-wide border-b border-gray-100">
            <th class="px-4 py-3 text-left">Client Code</th>
            <th class="px-4 py-3 text-left">Last Name</th>
            <th class="px-4 py-3 text-left">First Name</th>
            <th class="px-4 py-3 text-left">Course</th>
            <th class="px-4 py-3 text-left">Year Level</th>
            <th class="px-4 py-3 text-left">Severity</th>
            <th class="px-4 py-3 text-left">Overall Status</th>
            <th class="px-4 py-3 text-left">Date</th>
            <th class="px-4 py-3 text-left">Counselor</th>
            <th class="px-4 py-3 text-left">Action</th>
        </tr>
    </thead>
    <tbody class="divide-y divide-gray-50">
        {for case in cases}
        <tr class="hover:bg-gray-50 transition-colors cursor-pointer" data-case-id="{case.id}">
            <td class="px-4 py-3 font-medium text-gray-800 text-xs">{case.case_number | esc_html}</td>
            <td class="px-4 py-3 text-gray-700 text-xs">{case.last_name | esc_html | default:''}</td>
            <td class="px-4 py-3 text-gray-700 text-xs">{case.first_name | esc_html | default:''}</td>
            <td class="px-4 py-3 text-gray-600 text-xs">{case.college_code | esc_html | default:'—'}</td>
            <td class="px-4 py-3 text-gray-600 text-xs">{case.student_grade | esc_html | default:'—'}</td>
            <td class="px-4 py-3">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold uppercase tracking-wide
                    {if case.severity == 'high' || case.severity == 'critical'}bg-red-100 text-red-700
                    {elseif case.severity == 'medium'}bg-orange-100 text-orange-700
                    {else}bg-green-100 text-green-700{/if}">
                    {if case.severity == 'high' || case.severity == 'critical'}High Risk
                    {elseif case.severity == 'medium'}Moderate Risk
                    {else}Low Risk{/if}
                </span>
            </td>
            <td class="px-4 py-3">
                {if case.student_status}
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold uppercase tracking-wide
                    {if case.student_status == 'probationary'}bg-violet-100 text-violet-700
                    {elseif case.student_status == 'regular'}bg-blue-100 text-blue-700
                    {else}bg-gray-100 text-gray-600{/if}">
                    {case.student_status | upper | esc_html}
                </span>
                {else}
                <span class="text-gray-400 text-xs">—</span>
                {/if}
            </td>
            <td class="px-4 py-3 text-gray-500 text-xs">{case.updated_at | date:'M j, Y'}</td>
            <td class="px-4 py-3 text-gray-600 text-xs">{case.counselor_name | esc_html | default:'—'}</td>
            <td class="px-4 py-3" onclick="event.stopPropagation()">
                <button class="px-3 py-1 border border-gray-200 rounded text-xs text-gray-600 hover:bg-gray-100 transition-colors"
                        hx-get="{base_url}/api/cases/{case.id}/panel"
                        hx-target="#case-detail-panel"
                        hx-swap="innerHTML"
                        onclick="setTimeout(function(){var el=document.getElementById('case-detail-panel');if(el)el.scrollIntoView({behavior:'smooth',block:'start'});},150)">
                    View
                </button>
            </td>
        </tr>
        {/for}
    </tbody>
</table>
{else}
<div class="p-8 text-center text-gray-500">
    <i class="fas fa-inbox text-4xl mb-3 text-gray-300"></i>
    <p>No recent sessions</p>
</div>
{/if}
