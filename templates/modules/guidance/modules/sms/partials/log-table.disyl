{if logs}
<div class="overflow-x-auto">
    <table class="w-full text-sm">
        <thead class="bg-gray-50 text-left">
            <tr>
                <th class="px-4 py-3 font-medium text-gray-600">Status</th>
                <th class="px-4 py-3 font-medium text-gray-600">Recipient</th>
                <th class="px-4 py-3 font-medium text-gray-600">Message</th>
                <th class="px-4 py-3 font-medium text-gray-600">Trigger</th>
                <th class="px-4 py-3 font-medium text-gray-600">Provider</th>
                <th class="px-4 py-3 font-medium text-gray-600">Sent By</th>
                <th class="px-4 py-3 font-medium text-gray-600">Date</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            {foreach logs as log}
            <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                    {if log.status == 'sent'}
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                        <i class="fas fa-check-circle mr-1"></i> Sent
                    </span>
                    {/if}
                    {if log.status == 'failed'}
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800" title="{log.error_message}">
                        <i class="fas fa-times-circle mr-1"></i> Failed
                    </span>
                    {/if}
                    {if log.status == 'pending'}
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                        <i class="fas fa-clock mr-1"></i> Pending
                    </span>
                    {/if}
                    {if log.status == 'simulated'}
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                        <i class="fas fa-flask mr-1"></i> Test
                    </span>
                    {/if}
                </td>
                <td class="px-4 py-3">
                    <div class="font-medium text-gray-800">{log.recipient}</div>
                    {if log.recipient_name}
                    <div class="text-xs text-gray-500">{log.recipient_name}</div>
                    {/if}
                </td>
                <td class="px-4 py-3 max-w-xs">
                    <div class="truncate text-gray-700" title="{log.message}">{log.message}</div>
                </td>
                <td class="px-4 py-3">
                    {if log.trigger_event == 'manual'}
                    <span class="text-xs text-gray-500">Manual</span>
                    {/if}
                    {if log.trigger_event == 'test'}
                    <span class="text-xs text-blue-500">Test</span>
                    {/if}
                    {if log.trigger_event == 'case.created'}
                    <span class="text-xs text-purple-600">Case Created</span>
                    {/if}
                    {if log.trigger_event == 'appointment.confirmed'}
                    <span class="text-xs text-green-600">Appt Confirmed</span>
                    {/if}
                    {if log.trigger_event == 'appointment.reminder'}
                    <span class="text-xs text-orange-600">Reminder</span>
                    {/if}
                </td>
                <td class="px-4 py-3">
                    <span class="text-xs text-gray-500 capitalize">{log.provider}</span>
                </td>
                <td class="px-4 py-3">
                    <span class="text-xs text-gray-500">{log.sent_by_name | default:'System'}</span>
                </td>
                <td class="px-4 py-3">
                    <span class="text-xs text-gray-500">{log.created_at}</span>
                </td>
            </tr>
            {/foreach}
        </tbody>
    </table>
</div>

{!-- Pagination --}
{if pages > 1}
<div class="px-4 py-3 border-t bg-gray-50 flex items-center justify-between">
    <span class="text-sm text-gray-500">
        Showing page {page} of {pages} ({total} total)
    </span>
    <div class="flex gap-1">
        {if page > 1}
        <button hx-get="{base_url}/api/modules/sms/log?page={page - 1}" hx-target="#sms-log-container" 
                class="px-3 py-1 text-sm border rounded hover:bg-gray-100">
            <i class="fas fa-chevron-left"></i>
        </button>
        {/if}
        {if page < pages}
        <button hx-get="{base_url}/api/modules/sms/log?page={page + 1}" hx-target="#sms-log-container" 
                class="px-3 py-1 text-sm border rounded hover:bg-gray-100">
            <i class="fas fa-chevron-right"></i>
        </button>
        {/if}
    </div>
</div>
{/if}

{else}
<div class="p-12 text-center">
    <i class="fas fa-sms text-4xl text-gray-300 mb-3"></i>
    <p class="text-gray-500 font-medium">No SMS messages yet</p>
    <p class="text-gray-400 text-sm mt-1">Send your first SMS using the Compose button above</p>
</div>
{/if}
