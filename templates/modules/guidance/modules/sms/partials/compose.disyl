{!-- SMS Compose Modal --}
<div class="fixed inset-0 z-50 overflow-y-auto" 
     id="sms-compose-modal"
     x-data="{ open: true }" 
     x-show="open" 
     @click.self="open = false; document.getElementById('modal-container').innerHTML = ''">
    <div class="guidance-modal-shell">
           <div class="fixed inset-0 guidance-modal-backdrop"
               @click="open = false; document.getElementById('modal-container').innerHTML = ''"></div>
        <div class="guidance-modal-panel guidance-modal-panel--md" @click.stop>
        {!-- Header --}
        <div class="guidance-modal-header px-6 py-4">
            <h3 class="text-lg font-semibold text-gray-800">
                <i class="fas fa-paper-plane text-indigo-600 mr-2"></i> Compose SMS
            </h3>
            <button @click="open = false; document.getElementById('modal-container').innerHTML = ''" 
                    class="guidance-modal-close">
                <i class="fas fa-times text-lg"></i>
            </button>
        </div>
        
        {!-- Body --}
        <form hx-post="/api/modules/sms/send" 
              hx-target="#modal-container"
              hx-swap="innerHTML"
              class="p-6 space-y-4">
            
            {if test_mode}
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3 text-sm text-yellow-800">
                <i class="fas fa-flask mr-1"></i> <strong>Test Mode is ON.</strong> SMS will be logged but not actually sent.
            </div>
            {/if}
            
            {if !sms_configured}
            <div class="bg-red-50 border border-red-200 rounded-lg p-3 text-sm text-red-800">
                <i class="fas fa-exclamation-triangle mr-1"></i> SMS provider is not configured. Go to <strong>Settings &gt; Modules</strong> to configure.
            </div>
            {/if}
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Recipient Name</label>
                <input type="text" name="recipient_name" placeholder="e.g. Juan Dela Cruz" 
                       class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number <span class="text-red-500">*</span></label>
                <input type="tel" name="recipient" required placeholder="e.g. 09171234567" 
                       class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                <p class="text-xs text-gray-400 mt-1">Local format (09xx) or international (+639xx)</p>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Message <span class="text-red-500">*</span></label>
                <textarea name="message" required rows="4" maxlength="320" placeholder="Type your message here..."
                          class="w-full px-3 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                          oninput="document.getElementById('sms-char-count').textContent = this.value.length"></textarea>
                <div class="flex justify-between text-xs text-gray-400 mt-1">
                    <span><span id="sms-char-count">0</span> / 320 characters</span>
                    <span>1 SMS = 160 chars</span>
                </div>
            </div>
            
            <div class="flex justify-end gap-3 pt-2">
                <button type="button" 
                        @click="open = false; document.getElementById('modal-container').innerHTML = ''"
                        class="px-4 py-2 text-sm text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200">
                    Cancel
                </button>
                <button type="submit" 
                        class="px-4 py-2 text-sm text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 font-medium">
                    <i class="fas fa-paper-plane mr-1"></i> Send SMS
                </button>
            </div>
        </form>
        </div>
    </div>
</div>
