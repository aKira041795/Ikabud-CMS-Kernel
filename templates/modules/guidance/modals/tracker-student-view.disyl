{!-- Tracker Student View Modal --}

<div class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4">
        <div class="fixed inset-0 bg-black bg-opacity-50" onclick="closeModal()"></div>

        <div class="relative bg-white rounded-xl shadow-xl max-w-2xl w-full">
            <div class="flex items-center justify-between p-4 border-b">
                <div>
                    <h2 class="text-xl font-semibold text-gray-800">{student.student_name}</h2>
                    <div class="text-xs text-gray-500 mt-1">
                        {if student.student_id}<span class="mr-3"><i class="fas fa-id-card mr-1"></i>{student.student_id}</span>{/if}
                        {if student.year_level}<span class="mr-3"><i class="fas fa-layer-group mr-1"></i>{student.year_level}</span>{/if}
                        {if student.section}<span class="mr-3"><i class="fas fa-users mr-1"></i>{student.section}</span>{/if}
                    </div>
                </div>
                <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>

            <div class="p-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                    <div class="bg-gray-50 rounded-lg p-4">
                        <div class="text-xs text-gray-500">College</div>
                        <div class="font-semibold text-gray-800 mt-1">{student.college_name | default:'—'}</div>
                    </div>
                    <div class="bg-gray-50 rounded-lg p-4">
                        <div class="text-xs text-gray-500">Email</div>
                        <div class="font-semibold text-gray-800 mt-1">{student.email | default:'—'}</div>
                    </div>
                    <div class="bg-gray-50 rounded-lg p-4">
                        <div class="text-xs text-gray-500">Phone</div>
                        <div class="font-semibold text-gray-800 mt-1">{student.phone | default:'—'}</div>
                    </div>
                    <div class="bg-gray-50 rounded-lg p-4">
                        <div class="text-xs text-gray-500">Notes</div>
                        <div class="text-gray-700 mt-1 whitespace-pre-wrap">{student.notes | default:'—'}</div>
                    </div>
                </div>

                <div class="mt-6">
                    <div class="text-sm font-semibold text-gray-800 mb-2">Submissions</div>
                    <div class="text-xs text-gray-500 mb-3">Statuses are saved via the matrix on the tracker page.</div>
                    <div class="bg-gray-50 rounded-lg p-4 text-sm text-gray-600">No extra actions here yet.</div>
                </div>
            </div>

        </div>
    </div>
</div>
