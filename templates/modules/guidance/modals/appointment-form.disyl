{!-- Appointment Form Modal --}

<div class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
    <div class="guidance-modal-shell">
        <div class="fixed inset-0 guidance-modal-backdrop" onclick="closeModal()"></div>
        
        <div class="guidance-modal-panel guidance-modal-panel--md">
            <div class="guidance-modal-header">
                <h2 class="text-xl font-semibold text-gray-800">
                    {if appointment.id}Edit Appointment{else}New Appointment{/if}
                </h2>
                <button onclick="closeModal()" class="guidance-modal-close">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
            
            <form {if appointment.id}hx-put="{base_url}/api/appointments/{appointment.id}"{else}hx-post="{base_url}/api/appointments"{/if}
                  hx-swap="none"
                  class="p-6 space-y-4">
                
                {if case_id}
                <input type="hidden" name="case_id" value="{case_id}">
                {/if}
                
                {if !case_id}
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Case *</label>
                    <select name="case_id" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500"
                            hx-get="{base_url}/api/cases/options" hx-trigger="load" hx-target="this" hx-swap="innerHTML">
                        <option value="">Loading cases...</option>
                    </select>
                </div>
                {/if}
                
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Date *</label>
                        <input type="date" name="scheduled_date" required
                               value="{appointment.scheduled_date | default:''}"
                               min="{today}"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Time *</label>
                        <input type="time" name="scheduled_time" required
                               value="{appointment.scheduled_time | default:'09:00'}"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Session Type *</label>
                    <select name="appointment_type_id" id="appointment-type-select" required data-selected-type="{appointment.appointment_type_id | default:''}"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        <option value="">Loading session types...</option>
                    </select>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Duration (minutes)</label>
                    <select name="duration_minutes" id="appointment-duration-select" data-selected-duration="{appointment.duration_minutes | default:'60'}"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                        <option value="30">30 minutes</option>
                        <option value="45">45 minutes</option>
                        <option value="60">1 hour</option>
                        <option value="90">1.5 hours</option>
                    </select>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Purpose</label>
                    <input type="text" name="purpose" value="{appointment.purpose | default:''}" placeholder="Brief purpose of the appointment"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
                    <textarea name="notes" rows="3" placeholder="Additional notes..."
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">{appointment.notes | default:''}</textarea>
                </div>
                
                <div class="flex justify-end space-x-3 pt-4 border-t">
                    <button type="button" onclick="closeModal()" 
                            class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200">
                        Cancel
                    </button>
                    <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">
                        <i class="fas fa-save mr-2"></i> Save Appointment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function() {
    var typeSelect = document.getElementById('appointment-type-select');
    var durationSelect = document.getElementById('appointment-duration-select');
    if (!typeSelect || !durationSelect) return;

    var selectedTypeId = typeSelect.getAttribute('data-selected-type') || '';
    var selectedDuration = durationSelect.getAttribute('data-selected-duration') || '60';

    function syncDurationFromType() {
        var selected = typeSelect.selectedOptions[0];
        if (!selected || !selected.dataset.duration) return;
        durationSelect.value = selected.dataset.duration;
    }

    fetch(APP_BASE + '/api/appointment-types')
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (!data.success || !data.data) {
                throw new Error('Failed to load session types');
            }

            typeSelect.innerHTML = '<option value="">Select session type...</option>';
            data.data.forEach(function(type) {
                var option = document.createElement('option');
                option.value = type.id;
                option.textContent = type.name + ' (' + type.duration_minutes + ' min)';
                option.dataset.duration = type.duration_minutes;
                if (String(type.id) === selectedTypeId) {
                    option.selected = true;
                }
                typeSelect.appendChild(option);
            });

            durationSelect.value = selectedDuration;
            if (selectedTypeId) {
                syncDurationFromType();
            }
        })
        .catch(function() {
            typeSelect.innerHTML = '<option value="">Failed to load session types</option>';
        });

    typeSelect.addEventListener('change', syncDurationFromType);
})();
</script>
