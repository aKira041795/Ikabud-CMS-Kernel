{!-- Add Note Modal --}

<div class="fixed inset-0 z-50 overflow-hidden" aria-modal="true">
    <div class="guidance-modal-shell">
        <div class="fixed inset-0 guidance-modal-backdrop" onclick="document.getElementById('modal-container').innerHTML=''"></div>

        <div class="guidance-modal-panel guidance-modal-panel--lg">
            <div class="guidance-modal-header">
                <div>
                    <p class="guidance-modal-kicker">Counseling Session</p>
                    <h2 class="text-xl font-semibold text-gray-800 mt-1">
                        <i class="fas fa-sticky-note mr-2 text-indigo-500"></i> Add Counselor Note
                    </h2>
                </div>
                <button onclick="document.getElementById('modal-container').innerHTML=''" class="guidance-modal-close">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>

            <div class="guidance-modal-body">
                <form hx-post="{base_url}/api/cases/{case_id}/notes"
                      hx-swap="none"
                      class="guidance-modal-form">

                    <input type="hidden" name="case_id" value="{case_id}">
                    <input type="hidden" name="appointment_id" value="{appointment_id}">
                    <input type="hidden" name="note_type" value="session">

                    <section class="guidance-modal-section">
                        <div class="guidance-modal-section-title">
                            <i class="fas fa-info-circle text-indigo-400"></i>
                            <span>Session Info</span>
                        </div>
                        <div class="guidance-modal-stack">
                            <div class="guidance-modal-grid guidance-modal-grid--3">
                                <div>
                                    <label>Session Type</label>
                                    {ikb_select name="session_type" id="note-session-type-select" data-selected-type="{session_type | default:'' | esc_attr}"}
                                        <option value="">Loading session types...</option>
                                    {/ikb_select}
                                </div>
                                <div>
                                    <label>Session Date</label>
                                    {ikb_input type="date" name="session_date" value="{session_date | default:today}" /}
                                </div>
                                <div>
                                    <label>Risk Level</label>
                                    {ikb_select name="risk_level"}
                                        <option value="none">None</option>
                                        <option value="low">Low</option>
                                        <option value="moderate">Moderate</option>
                                        <option value="high">High</option>
                                        <option value="critical">Critical</option>
                                    {/ikb_select}
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="guidance-modal-section">
                        <div class="guidance-modal-section-title">
                            <i class="fas fa-file-alt text-indigo-400"></i>
                            <span>Counselor's Notes and Observations</span>
                        </div>
                        <div class="guidance-modal-stack">
                            {ikb_textarea name="note_content" rows="6" required placeholder="Document session notes, observations, and key points..."}{/ikb_textarea}
                        </div>
                    </section>

                    <section class="guidance-modal-section">
                        <div class="guidance-modal-section-title">
                            <i class="fas fa-lightbulb text-yellow-400"></i>
                            <span>Recommendation / Action Taken</span>
                        </div>
                        <div class="guidance-modal-stack">
                            {ikb_textarea name="observation_recommendation" rows="4" placeholder="Counselor's recommendations and actions taken..."}{/ikb_textarea}
                        </div>
                    </section>

                    <div class="guidance-modal-checkbox-row">
                        <label>
                            <input type="checkbox" name="followup_required" value="1" {if followup_required}checked{/if} class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                            <span>Follow-up Required</span>
                        </label>
                    </div>

                    <div class="guidance-modal-actions">
                        <button type="button" onclick="document.getElementById('modal-container').innerHTML=''" class="guidance-modal-secondary-btn">
                            Cancel
                        </button>
                        <button type="submit" class="inline-flex items-center justify-center gap-2 min-h-[2.75rem] px-5 py-2 bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 transition-colors shadow-sm">
                            <i class="fas fa-save"></i> Save Note
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    var typeSelect = document.getElementById('note-session-type-select');
    if (!typeSelect) return;

    var selectedType = (typeSelect.getAttribute('data-selected-type') || '').trim();

    fetch(APP_BASE + '/api/appointment-types')
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (!data.success || !data.data) {
                throw new Error('Failed to load session types');
            }

            typeSelect.innerHTML = '<option value="">Select session type...</option>';
            var hasSelected = false;
            data.data.forEach(function(type) {
                var option = document.createElement('option');
                option.value = type.name;
                option.textContent = type.name;
                if (type.name === selectedType) {
                    option.selected = true;
                    hasSelected = true;
                }
                typeSelect.appendChild(option);
            });

            if (selectedType !== '' && !hasSelected) {
                var fallback = document.createElement('option');
                fallback.value = selectedType;
                fallback.textContent = selectedType;
                fallback.selected = true;
                typeSelect.appendChild(fallback);
            }
        })
        .catch(function() {
            typeSelect.innerHTML = '<option value="">Failed to load session types</option>';
            if (selectedType !== '') {
                var fallback = document.createElement('option');
                fallback.value = selectedType;
                fallback.textContent = selectedType;
                fallback.selected = true;
                typeSelect.appendChild(fallback);
            }
        });
})();
</script>
