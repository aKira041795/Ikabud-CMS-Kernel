{!-- College Form Modal --}

<div class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
    <div class="guidance-modal-shell">
        <div class="fixed inset-0 guidance-modal-backdrop" onclick="closeModal()"></div>
        
        <div class="guidance-modal-panel guidance-modal-panel--lg">
            <div class="guidance-modal-header px-6 py-4">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-indigo-100 flex items-center justify-center">
                        <i class="fas fa-university text-indigo-600"></i>
                    </div>
                    <h2 class="text-lg font-bold text-gray-900">
                        {if college.id}Edit College{else}New College{/if}
                    </h2>
                </div>
                <button onclick="closeModal()" class="guidance-modal-close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            
            <form {if college.id}hx-put="/api/colleges/{college.id}"{else}hx-post="/api/colleges"{/if}
                  hx-swap="none"
                  class="p-6 space-y-5">
                
                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Code *</label>
                        <input type="text" name="code" required value="{college.code | default:''}" maxlength="20"
                               placeholder="e.g. CAS"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 uppercase font-mono">
                    </div>
                    <div class="col-span-2">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Name *</label>
                        <input type="text" name="name" required value="{college.name | default:''}"
                               placeholder="e.g. College of Arts and Sciences"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                    </div>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                    <textarea name="description" rows="2" placeholder="Optional description..."
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">{college.description | default:''}</textarea>
                </div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Sort Order</label>
                        <input type="number" name="sort_order" value="{college.sort_order | default:'0'}" min="0"
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                    </div>
                    {if college.id}
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                        <select name="is_active" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                            <option value="1" {if college.is_active == '1'}selected{/if}>Active</option>
                            <option value="0" {if college.is_active == '0'}selected{/if}>Inactive</option>
                        </select>
                    </div>
                    {/if}
                </div>
                
                {!-- Assigned Counselors (edit mode only) --}
                {if college.id}
                {if assigned_counselors}
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        <i class="fas fa-user-tie mr-1 text-indigo-500"></i> Assigned Counselors
                    </label>
                    <div class="space-y-2 max-h-32 overflow-y-auto">
                        {foreach assigned_counselors as counselor}
                        <div class="flex items-center justify-between px-3 py-2 bg-gray-50 rounded-lg">
                            <div class="flex items-center space-x-2">
                                <div class="w-7 h-7 bg-indigo-100 rounded-full flex items-center justify-center">
                                    <i class="fas fa-user text-indigo-600 text-xs"></i>
                                </div>
                                <div>
                                    <span class="text-sm font-medium text-gray-800">{counselor.name}</span>
                                    <span class="text-xs text-gray-500 ml-2">{counselor.email}</span>
                                </div>
                            </div>
                        </div>
                        {/foreach}
                    </div>
                    <p class="text-xs text-gray-400 mt-1">Manage assignments from the Users page.</p>
                </div>
                {else}
                <div class="px-3 py-2 bg-amber-50 border border-amber-200 rounded-lg">
                    <p class="text-sm text-amber-700"><i class="fas fa-info-circle mr-1"></i> No counselors assigned. Assign from the Users page.</p>
                </div>
                {/if}
                {/if}
                
                <div class="flex justify-end space-x-3 pt-4 border-t">
                    <button type="button" onclick="closeModal()" 
                            class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200">
                        Cancel
                    </button>
                    <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">
                        <i class="fas fa-save mr-2"></i> {if college.id}Update{else}Create{/if} College
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
