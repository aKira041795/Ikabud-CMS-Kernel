{!-- Tracker Form Modal --}

<div class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
    <div class="guidance-modal-shell">
        <div class="fixed inset-0 guidance-modal-backdrop" onclick="closeModal()"></div>

        <div class="guidance-modal-panel guidance-modal-panel--md">
            <div class="guidance-modal-header">
                <h2 class="text-xl font-semibold text-gray-800">
                    {if tracker.id}Edit Tracker{else}New Tracker{/if}
                </h2>
                <button onclick="closeModal()" class="guidance-modal-close">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>

            <form {if tracker.id}hx-put="/admin/guidance/api/trackers/{tracker.id}"{else}hx-post="/admin/guidance/api/trackers"{/if}
                  hx-swap="none"
                  class="p-6 space-y-4">

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Name *</label>
                    <input type="text" name="name" required value="{tracker.name | default:''}"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Academic Year</label>
                    <input type="text" name="academic_year" value="{tracker.academic_year | default:''}" placeholder="e.g., 2025-2026"
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">College (optional)</label>
                    <select name="college_id" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                        <option value="">All colleges</option>
                        {foreach colleges as c}
                        <option value="{c.id}" {if tracker.college_id == c.id}selected{/if}>{c.code} - {c.name}</option>
                        {/foreach}
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                    <textarea name="description" rows="3"
                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">{tracker.description | default:''}</textarea>
                </div>

                <div class="flex items-center gap-2">
                    <input type="checkbox" id="is_active" name="is_active" value="1" {if tracker.is_active != '0'}checked{/if}
                           class="h-4 w-4 text-indigo-600 border-gray-300 rounded">
                    <label for="is_active" class="text-sm text-gray-700">Active</label>
                </div>

                <div class="flex justify-end space-x-3 pt-4 border-t">
                    <button type="button" onclick="closeModal()"
                            class="px-4 py-2 text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200">
                        Cancel
                    </button>
                    <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">
                        <i class="fas fa-save mr-2"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
