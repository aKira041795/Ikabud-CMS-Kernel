{!-- Edit Note Modal --}

<div class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
    <div class="guidance-modal-shell">
        <div class="fixed inset-0 guidance-modal-backdrop" onclick="document.getElementById('modal-container').innerHTML=''"></div>

        <div class="guidance-modal-panel guidance-modal-panel--xl">
            {!-- Header --}
            <div class="guidance-modal-header">
                <h2 class="text-xl font-semibold text-gray-800">
                    <i class="fas fa-edit mr-2 text-teal-600"></i> Edit Counselor Note
                </h2>
                <button onclick="document.getElementById('modal-container').innerHTML=''"
                        class="guidance-modal-close">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>

            {!-- Form --}
            <form hx-put="/admin/guidance/api/cases/{case_id}/notes/{note_id}"
                  hx-swap="none"
                  class="p-6 space-y-5">

                <input type="hidden" name="case_id" value="{case_id}">
                <input type="hidden" name="note_type" value="{note.note_type | esc_attr | default:'session'}">

                {!-- Session Info --}
                <div>
                    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">
                        <i class="fas fa-info-circle mr-1 text-indigo-400"></i> Session Info
                    </h3>
                    {ikb_grid columns="2" gap="medium"}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Session Type</label>
                            {ikb_select name="session_type"}
                                <option value="walk-in" {if note.session_type == 'walk-in'}selected{/if}>Walk-in</option>
                                <option value="follow-up" {if note.session_type == 'follow-up'}selected{/if}>Follow-up</option>
                                <option value="referred" {if note.session_type == 'referred'}selected{/if}>Referred</option>
                            {/ikb_select}
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Session Date</label>
                            {ikb_input type="date" name="session_date" value="{note.session_date | default:today | esc_attr}" /}
                        </div>
                    {/ikb_grid}
                    {ikb_grid columns="2" gap="medium" class="mt-3"}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Intervention Used</label>
                            {ikb_input type="text" name="intervention_used" value="{note.intervention_used | esc_attr}" placeholder="e.g., CBT, Active Listening" /}
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Session Duration (min)</label>
                            {ikb_input type="number" name="session_duration_minutes" value="{note.session_duration_minutes | esc_attr}" placeholder="30" /}
                        </div>
                    {/ikb_grid}
                </div>

                {!-- Transcription / Presenting Problem --}
                <div>
                    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">
                        <i class="fas fa-file-alt mr-1 text-indigo-400"></i> Transcription (Presenting Problem)
                    </h3>
                    {ikb_textarea name="note_content" rows="4" required placeholder="Document the presenting problem and session transcription..."}{note.note_content | esc_html}{/ikb_textarea}
                </div>

                {!-- Mental Status Examination --}
                <div>
                    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">
                        <i class="fas fa-brain mr-1 text-purple-400"></i> Mental Status Examination
                        <span class="text-xs font-normal text-gray-400 ml-2">(Verbal and nonverbal observation)</span>
                    </h3>
                    {ikb_grid columns="2" gap="medium"}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Appearance</label>
                            {ikb_input type="text" name="mse_appearance" value="{note.mse_appearance | esc_attr}" placeholder="e.g., Well-groomed, Disheveled" /}
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">General Behavior</label>
                            {ikb_input type="text" name="mse_behavior" value="{note.mse_behavior | esc_attr}" placeholder="e.g., Cooperative, Agitated" /}
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Speech</label>
                            {ikb_input type="text" name="mse_speech" value="{note.mse_speech | esc_attr}" placeholder="e.g., Normal rate, Pressured" /}
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Emotions</label>
                            {ikb_input type="text" name="mse_emotions" value="{note.mse_emotions | esc_attr}" placeholder="e.g., Anxious, Flat affect" /}
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Thinking Process</label>
                            {ikb_input type="text" name="mse_thinking" value="{note.mse_thinking | esc_attr}" placeholder="e.g., Logical, Tangential" /}
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Cognition</label>
                            {ikb_input type="text" name="mse_cognition" value="{note.mse_cognition | esc_attr}" placeholder="e.g., Alert, Oriented x3" /}
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Judgment</label>
                            {ikb_input type="text" name="mse_judgment" value="{note.mse_judgment | esc_attr}" placeholder="e.g., Good, Fair, Poor" /}
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Reliability</label>
                            {ikb_input type="text" name="mse_reliability" value="{note.mse_reliability | esc_attr}" placeholder="e.g., Reliable, Questionable" /}
                        </div>
                    {/ikb_grid}
                </div>

                {!-- Case Conceptualization --}
                <div>
                    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">
                        <i class="fas fa-puzzle-piece mr-1 text-amber-400"></i> Case Conceptualization
                        <span class="text-xs font-normal text-gray-400 ml-2">(4 Ps of Case Formulation)</span>
                    </h3>
                    <div class="space-y-3">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">1. Predisposition Factors</label>
                            <p class="text-xs text-gray-400 mb-1">Risk of developing a problem (e.g., genetics, life events, temperament)</p>
                            {ikb_textarea name="case_predisposition" rows="2" placeholder="Describe predisposition factors..."}{note.case_predisposition | esc_html}{/ikb_textarea}
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">2. Precipitating Factors</label>
                            <p class="text-xs text-gray-400 mb-1">Specific events or triggers to the onset of the current problem</p>
                            {ikb_textarea name="case_precipitating" rows="2" placeholder="Describe precipitating factors..."}{note.case_precipitating | esc_html}{/ikb_textarea}
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">3. Perpetuating Factors</label>
                            <p class="text-xs text-gray-400 mb-1">Causative factors of established or chronic problems</p>
                            {ikb_textarea name="case_perpetuating" rows="2" placeholder="Describe perpetuating factors..."}{note.case_perpetuating | esc_html}{/ikb_textarea}
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">4. Protective Factors</label>
                            <p class="text-xs text-gray-400 mb-1">Strengths that help promote healthy functioning</p>
                            {ikb_textarea name="case_protective" rows="2" placeholder="Describe protective factors..."}{note.case_protective | esc_html}{/ikb_textarea}
                        </div>
                    </div>
                </div>

                {!-- Assessment & Response --}
                <div>
                    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">
                        <i class="fas fa-clipboard-check mr-1 text-green-400"></i> Assessment &amp; Response
                    </h3>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Student Response</label>
                        {ikb_textarea name="student_response" rows="2" placeholder="How did the student respond?"}{note.student_response | esc_html}{/ikb_textarea}
                    </div>
                    {ikb_grid columns="2" gap="medium" class="mt-3"}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Risk Level</label>
                            {ikb_select name="risk_level"}
                                <option value="none" {if note.risk_level == 'none'}selected{/if}>None</option>
                                <option value="low" {if note.risk_level == 'low'}selected{/if}>Low</option>
                                <option value="moderate" {if note.risk_level == 'moderate'}selected{/if}>Moderate</option>
                                <option value="high" {if note.risk_level == 'high'}selected{/if}>High</option>
                                <option value="critical" {if note.risk_level == 'critical'}selected{/if}>Critical</option>
                            {/ikb_select}
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Mood Assessment</label>
                            {ikb_input type="text" name="mood_assessment" value="{note.mood_assessment | esc_attr}" placeholder="e.g., Anxious, Calm" /}
                        </div>
                    {/ikb_grid}
                    <div class="mt-3">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Action Taken</label>
                        {ikb_textarea name="action_taken" rows="2" placeholder="What actions were taken?"}{note.action_taken | esc_html}{/ikb_textarea}
                    </div>
                </div>

                {!-- Observation & Recommendation --}
                <div>
                    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">
                        <i class="fas fa-lightbulb mr-1 text-yellow-400"></i> Observation &amp; Recommendation
                    </h3>
                    {ikb_textarea name="observation_recommendation" rows="3" placeholder="Counselor's observations and recommendations..."}{note.observation_recommendation | esc_html}{/ikb_textarea}
                </div>

                {!-- Flags --}
                <div class="flex items-center space-x-6">
                    <label class="flex items-center">
                        <input type="checkbox" name="followup_required" value="1"
                               {if note.followup_required}checked{/if}
                               class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                        <span class="ml-2 text-sm text-gray-700">Follow-up Required</span>
                    </label>
                    <label class="flex items-center">
                        <input type="checkbox" name="is_confidential" value="1"
                               {if note.is_confidential}checked{/if}
                               class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                        <span class="ml-2 text-sm text-gray-700">Confidential</span>
                    </label>
                </div>

                {!-- Actions --}
                <div class="flex items-center justify-end space-x-3 pt-4 border-t">
                    <button type="button" onclick="document.getElementById('modal-container').innerHTML=''"
                            class="px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg transition">
                        Cancel
                    </button>
                    {ikb_button type="submit" variant="primary"}
                        <i class="fas fa-save mr-2"></i> Save Changes
                    {/ikb_button}
                </div>
            </form>
        </div>
    </div>
</div>
