{!-- Appointment Detail Modal - Professional Wide Layout --}

<div class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
    <div class="flex items-start justify-center min-h-screen px-4 py-8">
        <div class="fixed inset-0 bg-black bg-opacity-50 transition-opacity" onclick="closeModal()"></div>
        
        <div class="relative bg-white rounded-2xl shadow-2xl max-w-4xl w-full">
            <div class="flex items-center justify-between px-8 py-5 border-b bg-gradient-to-r from-indigo-50 to-white rounded-t-2xl">
                <div class="flex items-center space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-indigo-100 flex items-center justify-center">
                        <i class="fas fa-calendar-check text-indigo-600 text-xl"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-gray-900">Appointment Details</h2>
                        <p class="text-sm text-gray-500">ID #{appointment.id} &middot; {appointment.case_number}</p>
                    </div>
                </div>
                <div class="flex items-center space-x-3">
                    {if appointment.status == 'pending'}
                        <span class="px-3 py-1.5 text-sm font-semibold rounded-full bg-amber-100 text-amber-800 border border-amber-200">
                            <i class="fas fa-clock mr-1"></i> Pending
                        </span>
                    {elseif appointment.status == 'scheduled'}
                        <span class="px-3 py-1.5 text-sm font-semibold rounded-full bg-blue-100 text-blue-800 border border-blue-200">
                            <i class="fas fa-calendar mr-1"></i> Scheduled
                        </span>
                    {elseif appointment.status == 'confirmed'}
                        <span class="px-3 py-1.5 text-sm font-semibold rounded-full bg-indigo-100 text-indigo-800 border border-indigo-200">
                            <i class="fas fa-check-circle mr-1"></i> Confirmed
                        </span>
                    {elseif appointment.status == 'completed'}
                        <span class="px-3 py-1.5 text-sm font-semibold rounded-full bg-green-100 text-green-800 border border-green-200">
                            <i class="fas fa-check-double mr-1"></i> Completed
                        </span>
                    {elseif appointment.status == 'cancelled'}
                        <span class="px-3 py-1.5 text-sm font-semibold rounded-full bg-red-100 text-red-800 border border-red-200">
                            <i class="fas fa-ban mr-1"></i> Cancelled
                        </span>
                    {elseif appointment.status == 'rejected'}
                        <span class="px-3 py-1.5 text-sm font-semibold rounded-full bg-gray-100 text-gray-800 border border-gray-200">
                            <i class="fas fa-times-circle mr-1"></i> Rejected
                        </span>
                    {elseif appointment.status == 'no_show'}
                        <span class="px-3 py-1.5 text-sm font-semibold rounded-full bg-yellow-100 text-yellow-800 border border-yellow-200">
                            <i class="fas fa-user-slash mr-1"></i> No Show
                        </span>
                    {else}
                        <span class="px-3 py-1.5 text-sm font-semibold rounded-full bg-gray-100 text-gray-700">
                            {appointment.status}
                        </span>
                    {/if}
                    <button onclick="closeModal()" class="p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition">
                        <i class="fas fa-times text-lg"></i>
                    </button>
                </div>
            </div>

            <div class="px-8 py-6">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <div class="lg:col-span-2 space-y-6">
                        <div class="bg-gray-50 rounded-xl p-5">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">
                                <i class="fas fa-clock mr-2 text-indigo-500"></i>Schedule
                            </h3>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                                <div>
                                    <p class="text-xs text-gray-400 mb-1">Date</p>
                                    <p class="text-sm font-semibold text-gray-800">{appointment.scheduled_date}</p>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 mb-1">Time</p>
                                    <p class="text-sm font-semibold text-gray-800">{appointment.scheduled_time}</p>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 mb-1">Duration</p>
                                    <p class="text-sm font-semibold text-gray-800">{appointment.duration_minutes} min</p>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 mb-1">Location</p>
                                    <p class="text-sm font-semibold text-gray-800">{appointment.location | default:'Not set'}</p>
                                </div>
                            </div>
                        </div>

                        <div class="bg-gray-50 rounded-xl p-5">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">
                                <i class="fas fa-info-circle mr-2 text-indigo-500"></i>Details
                            </h3>
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                                <div>
                                    <p class="text-xs text-gray-400 mb-1">Purpose</p>
                                    <p class="text-sm font-semibold text-gray-800 capitalize">{appointment.purpose | default:'Not specified'}</p>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 mb-1">Type</p>
                                    <p class="text-sm font-semibold text-gray-800 capitalize">{appointment.appointment_type | default:'Individual'}</p>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 mb-1">Urgent</p>
                                    {if appointment.is_urgent}
                                        <span class="inline-flex items-center text-sm font-semibold text-red-700">
                                            <i class="fas fa-exclamation-triangle mr-1"></i> Yes
                                        </span>
                                    {else}
                                        <p class="text-sm font-semibold text-gray-800">No</p>
                                    {/if}
                                </div>
                            </div>
                        </div>

                        <div class="bg-gray-50 rounded-xl p-5">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">
                                <i class="fas fa-sticky-note mr-2 text-indigo-500"></i>Appointment Notes
                            </h3>
                            {if appointment.notes}
                                <p class="text-sm text-gray-700 leading-relaxed whitespace-pre-wrap">{appointment.notes}</p>
                            {else}
                                <p class="text-sm text-gray-400 italic">No notes recorded</p>
                            {/if}
                        </div>

                        <div class="flex flex-wrap gap-2 pt-2">
                            <button hx-get="/admin/guidance/pages/appointments/{appointment.id}/edit" hx-target="#modal-container" hx-swap="innerHTML"
                                    class="px-3 py-2 text-sm bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">Edit</button>

                            {if appointment.status != 'completed'}
                            <button hx-post="/admin/guidance/api/appointments/{appointment.id}/complete" hx-confirm="Mark this appointment as completed?" hx-swap="none"
                                    class="px-3 py-2 text-sm bg-green-600 text-white rounded-lg hover:bg-green-700">Complete</button>
                            {/if}

                            {if appointment.status != 'no_show'}
                            <button hx-post="/admin/guidance/api/appointments/{appointment.id}/no-show" hx-confirm="Mark as no-show?" hx-swap="none"
                                    class="px-3 py-2 text-sm bg-yellow-600 text-white rounded-lg hover:bg-yellow-700">No Show</button>
                            {/if}

                            {if appointment.status != 'cancelled'}
                            <button hx-post="/admin/guidance/api/appointments/{appointment.id}/cancel" hx-confirm="Cancel this appointment?" hx-swap="none"
                                    class="px-3 py-2 text-sm bg-red-600 text-white rounded-lg hover:bg-red-700">Cancel</button>
                            {/if}
                        </div>
                    </div>

                    <div class="space-y-6">
                        <div class="bg-white border border-gray-200 rounded-xl p-5">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">
                                <i class="fas fa-user-graduate mr-2 text-indigo-500"></i>Student
                            </h3>
                            <div class="flex items-center space-x-3 mb-4">
                                <div class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center">
                                    <i class="fas fa-user text-indigo-600"></i>
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-gray-900">{appointment.student_name | default:'N/A'}</p>
                                    {if appointment.college_name}
                                    <p class="text-xs text-gray-500">{appointment.college_name}</p>
                                    {/if}
                                </div>
                            </div>
                            <div class="space-y-2 text-sm">
                                {if appointment.student_email}
                                <div class="flex items-center text-gray-600">
                                    <i class="fas fa-envelope w-5 text-gray-400 text-xs"></i>
                                    <span class="ml-2 truncate">{appointment.student_email}</span>
                                </div>
                                {/if}
                                {if appointment.student_phone}
                                <div class="flex items-center text-gray-600">
                                    <i class="fas fa-phone w-5 text-gray-400 text-xs"></i>
                                    <span class="ml-2">{appointment.student_phone}</span>
                                </div>
                                {/if}
                            </div>
                        </div>

                        <div class="bg-white border border-gray-200 rounded-xl p-5">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">
                                <i class="fas fa-user-tie mr-2 text-indigo-500"></i>Counselor
                            </h3>
                            <div class="flex items-center space-x-3">
                                <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center">
                                    <i class="fas fa-user-tie text-green-600"></i>
                                </div>
                                <p class="text-sm font-bold text-gray-900">{appointment.counselor_name | default:'Unassigned'}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
