{!-- Appointment Detail Modal - Professional Wide Layout --}

<div class="fixed inset-0 z-50 overflow-hidden" aria-modal="true">
    <div class="guidance-modal-shell">
        <div class="fixed inset-0 guidance-modal-backdrop transition-opacity" onclick="closeModal()"></div>
        
        <div class="guidance-modal-panel guidance-modal-panel--xl">
            {!-- Header --}
            <div class="guidance-modal-header px-8 py-5">
                <div class="flex items-center space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-indigo-100 flex items-center justify-center">
                        <i class="fas fa-calendar-check text-indigo-600 text-xl"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-gray-900">Appointment Details</h2>
                        <p class="text-sm text-gray-500">ID #{appointment.id} &middot; {appointment.case_number}</p>
                    </div>
                </div>
                <div class="flex items-center space-x-3">
                    {if appointment.status == 'pending'}
                        <span class="px-3 py-1.5 text-sm font-semibold rounded-full bg-amber-100 text-amber-800 border border-amber-200">
                            <i class="fas fa-clock mr-1"></i> Pending
                        </span>
                    {elseif appointment.status == 'scheduled'}
                        <span class="px-3 py-1.5 text-sm font-semibold rounded-full bg-blue-100 text-blue-800 border border-blue-200">
                            <i class="fas fa-calendar mr-1"></i> Scheduled
                        </span>
                    {elseif appointment.status == 'confirmed'}
                        <span class="px-3 py-1.5 text-sm font-semibold rounded-full bg-indigo-100 text-indigo-800 border border-indigo-200">
                            <i class="fas fa-check-circle mr-1"></i> Confirmed
                        </span>
                    {elseif appointment.status == 'completed'}
                        <span class="px-3 py-1.5 text-sm font-semibold rounded-full bg-green-100 text-green-800 border border-green-200">
                            <i class="fas fa-check-double mr-1"></i> Completed
                        </span>
                    {elseif appointment.status == 'cancelled'}
                        <span class="px-3 py-1.5 text-sm font-semibold rounded-full bg-red-100 text-red-800 border border-red-200">
                            <i class="fas fa-ban mr-1"></i> Cancelled
                        </span>
                    {elseif appointment.status == 'rejected'}
                        <span class="px-3 py-1.5 text-sm font-semibold rounded-full bg-gray-100 text-gray-800 border border-gray-200">
                            <i class="fas fa-times-circle mr-1"></i> Rejected
                        </span>
                    {elseif appointment.status == 'no_show'}
                        <span class="px-3 py-1.5 text-sm font-semibold rounded-full bg-yellow-100 text-yellow-800 border border-yellow-200">
                            <i class="fas fa-user-slash mr-1"></i> No Show
                        </span>
                    {else}
                        <span class="px-3 py-1.5 text-sm font-semibold rounded-full bg-gray-100 text-gray-700">
                            {appointment.status}
                        </span>
                    {/if}
                    <button onclick="closeModal()" class="guidance-modal-close">
                        <i class="fas fa-times text-lg"></i>
                    </button>
                </div>
            </div>
            
            {!-- Body --}
            <div class="guidance-modal-body px-8 py-6">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    
                    {!-- Left Column: Appointment Info --}
                    <div class="lg:col-span-2 space-y-6">
                        
                        {!-- Schedule & Location --}
                        <div class="bg-gray-50 rounded-xl p-5">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">
                                <i class="fas fa-clock mr-2 text-indigo-500"></i>Schedule
                            </h3>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                                <div>
                                    <p class="text-xs text-gray-400 mb-1">Date</p>
                                    <p class="text-sm font-semibold text-gray-800">{appointment.scheduled_date}</p>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 mb-1">Time</p>
                                    <p class="text-sm font-semibold text-gray-800">{appointment.scheduled_time}</p>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 mb-1">Duration</p>
                                    <p class="text-sm font-semibold text-gray-800">{appointment.duration_minutes} min</p>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 mb-1">Location</p>
                                    <p class="text-sm font-semibold text-gray-800">{appointment.location | default:'Not set'}</p>
                                </div>
                            </div>
                        </div>
                        
                        {!-- Purpose & Type --}
                        <div class="bg-gray-50 rounded-xl p-5">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">
                                <i class="fas fa-info-circle mr-2 text-indigo-500"></i>Details
                            </h3>
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                                <div>
                                    <p class="text-xs text-gray-400 mb-1">Purpose</p>
                                    <p class="text-sm font-semibold text-gray-800 capitalize">{appointment.purpose | default:'Not specified'}</p>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 mb-1">Type</p>
                                    <p class="text-sm font-semibold text-gray-800">{appointment.type_name | default:'Individual'}</p>
                                </div>
                                <div>
                                    <p class="text-xs text-gray-400 mb-1">Urgent</p>
                                    {if appointment.is_urgent}
                                        <span class="inline-flex items-center text-sm font-semibold text-red-700">
                                            <i class="fas fa-exclamation-triangle mr-1"></i> Yes
                                        </span>
                                    {else}
                                        <p class="text-sm font-semibold text-gray-800">No</p>
                                    {/if}
                                </div>
                            </div>
                        </div>
                        
                        {!-- Notes --}
                        <div class="bg-gray-50 rounded-xl p-5">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">
                                <i class="fas fa-sticky-note mr-2 text-indigo-500"></i>Appointment Notes
                            </h3>
                            {if appointment.notes}
                                <p class="text-sm text-gray-700 leading-relaxed whitespace-pre-wrap">{appointment.notes}</p>
                            {else}
                                <p class="text-sm text-gray-400 italic">No notes recorded</p>
                            {/if}
                        </div>
                        
                        {!-- Cancellation / Rejection Info --}
                        {if appointment.status == 'cancelled'}
                        <div class="bg-red-50 rounded-xl p-5 border border-red-100">
                            <h3 class="text-sm font-semibold text-red-600 uppercase tracking-wider mb-3">
                                <i class="fas fa-ban mr-2"></i>Cancellation Details
                            </h3>
                            <p class="text-sm text-red-700">{appointment.cancellation_reason | default:'No reason provided'}</p>
                            <p class="text-xs text-red-400 mt-2">Cancelled at: {appointment.cancelled_at | default:'N/A'}</p>
                        </div>
                        {/if}
                        
                        {if appointment.status == 'rejected'}
                        <div class="bg-gray-50 rounded-xl p-5 border border-gray-200">
                            <h3 class="text-sm font-semibold text-gray-600 uppercase tracking-wider mb-3">
                                <i class="fas fa-times-circle mr-2"></i>Rejection Details
                            </h3>
                            <p class="text-sm text-gray-700">{appointment.rejection_reason | default:'No reason provided'}</p>
                            <p class="text-xs text-gray-400 mt-2">Rejected at: {appointment.rejected_at | default:'N/A'}</p>
                        </div>
                        {/if}
                        
                        {!-- Recent Case Notes --}
                        {if case_notes}
                        <div>
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">
                                <i class="fas fa-file-alt mr-2 text-indigo-500"></i>Recent Case Notes
                            </h3>
                            <div class="space-y-3 max-h-48 overflow-y-auto">
                                {foreach case_notes as note}
                                <div class="bg-white border border-gray-200 rounded-lg p-3">
                                    <div class="flex items-center justify-between mb-1">
                                        <span class="text-xs font-medium text-indigo-600">{note.author_name}</span>
                                        <span class="text-xs text-gray-400">{note.created_at}</span>
                                    </div>
                                    <p class="text-sm text-gray-700 line-clamp-2">{note.note_content}</p>
                                </div>
                                {/foreach}
                            </div>
                        </div>
                        {/if}
                        
                    </div>
                    
                    {!-- Right Column: Student & Counselor --}
                    <div class="space-y-6">
                        
                        {!-- Student Card --}
                        <div class="bg-white border border-gray-200 rounded-xl p-5">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">
                                <i class="fas fa-user-graduate mr-2 text-indigo-500"></i>Student
                            </h3>
                            <div class="flex items-center space-x-3 mb-4">
                                <div class="w-10 h-10 rounded-full bg-indigo-100 flex items-center justify-center">
                                    <i class="fas fa-user text-indigo-600"></i>
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-gray-900">{appointment.student_name | default:'N/A'}</p>
                                    {if appointment.college_name}
                                    <p class="text-xs text-gray-500">{appointment.college_name}</p>
                                    {/if}
                                </div>
                            </div>
                            <div class="space-y-2 text-sm">
                                {if appointment.student_email}
                                <div class="flex items-center text-gray-600">
                                    <i class="fas fa-envelope w-5 text-gray-400 text-xs"></i>
                                    <span class="ml-2 truncate">{appointment.student_email}</span>
                                </div>
                                {/if}
                                {if appointment.student_phone}
                                <div class="flex items-center text-gray-600">
                                    <i class="fas fa-phone w-5 text-gray-400 text-xs"></i>
                                    <span class="ml-2">{appointment.student_phone}</span>
                                </div>
                                {/if}
                                {if appointment.student_year_level}
                                <div class="flex items-center text-gray-600">
                                    <i class="fas fa-layer-group w-5 text-gray-400 text-xs"></i>
                                    <span class="ml-2">Year {appointment.student_year_level}</span>
                                </div>
                                {/if}
                            </div>
                        </div>
                        
                        {!-- Counselor Card --}
                        <div class="bg-white border border-gray-200 rounded-xl p-5">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">
                                <i class="fas fa-user-tie mr-2 text-indigo-500"></i>Counselor
                            </h3>
                            <div class="flex items-center space-x-3">
                                <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center">
                                    <i class="fas fa-user-tie text-green-600"></i>
                                </div>
                                <p class="text-sm font-bold text-gray-900">{appointment.counselor_name | default:'Unassigned'}</p>
                            </div>
                        </div>
                        
                        {!-- Case Link --}
                        {if appointment.case_id}
                        <div class="bg-white border border-gray-200 rounded-xl p-5">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">
                                <i class="fas fa-folder-open mr-2 text-indigo-500"></i>Linked Case
                            </h3>
                            <a href="{base_url}/cases/{appointment.case_id}" 
                               hx-get="{base_url}/pages/cases/{appointment.case_id}"
                               hx-target="#main-content"
                               hx-push-url="{base_url}/cases/{appointment.case_id}"
                               onclick="closeModal()"
                               class="flex items-center justify-between p-3 bg-indigo-50 rounded-lg hover:bg-indigo-100 transition group cursor-pointer">
                                <div>
                                    <p class="text-sm font-bold text-indigo-700">{appointment.case_number}</p>
                                    <p class="text-xs text-indigo-500">View case details</p>
                                </div>
                                <i class="fas fa-arrow-right text-indigo-400 group-hover:text-indigo-600 transition"></i>
                            </a>
                        </div>
                        {elseif appointment.status == 'confirmed'}
                        <div class="bg-white border border-gray-200 rounded-xl p-5">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">
                                <i class="fas fa-folder-plus mr-2 text-indigo-500"></i>No Linked Case
                            </h3>
                            <button hx-get="{base_url}/pages/cases/new?appointment_id={appointment.id}"
                                    hx-target="#modal-container"
                                    hx-swap="innerHTML"
                                    class="w-full flex items-center justify-between p-3 bg-indigo-50 rounded-lg hover:bg-indigo-100 transition group">
                                <div class="text-left">
                                    <p class="text-sm font-bold text-indigo-700">Create Case</p>
                                    <p class="text-xs text-indigo-500">Link this confirmed appointment to a new case</p>
                                </div>
                                <i class="fas fa-arrow-right text-indigo-400 group-hover:text-indigo-600 transition"></i>
                            </button>
                        </div>
                        {/if}
                        
                        {!-- Timestamps --}
                        <div class="bg-white border border-gray-200 rounded-xl p-5">
                            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">
                                <i class="fas fa-history mr-2 text-indigo-500"></i>Timeline
                            </h3>
                            <div class="space-y-2 text-xs text-gray-500">
                                <div class="flex justify-between">
                                    <span>Created</span>
                                    <span class="text-gray-700 font-medium">{appointment.created_at}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>Updated</span>
                                    <span class="text-gray-700 font-medium">{appointment.updated_at}</span>
                                </div>
                                {if appointment.approved_at}
                                <div class="flex justify-between">
                                    <span>Approved</span>
                                    <span class="text-green-700 font-medium">{appointment.approved_at}</span>
                                </div>
                                {/if}
                            </div>
                        </div>
                        
                    </div>
                </div>
            </div>
            
            {!-- Footer Actions --}
            <div class="px-8 py-4 border-t bg-gray-50 flex items-center justify-between">
                <button type="button" onclick="closeModal()" class="px-4 py-2 text-sm text-gray-600 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                    <i class="fas fa-times mr-2"></i>Close
                </button>
                
                <div class="flex items-center space-x-2">
                    {if appointment.status == 'pending'}
                        <button type="button" hx-post="{base_url}/api/appointments/{appointment.id}/approve" hx-swap="none"
                                class="px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 transition">
                            <i class="fas fa-check mr-2"></i>Approve
                        </button>
                        <button type="button" hx-post="{base_url}/api/appointments/{appointment.id}/reject" hx-swap="none"
                                class="px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 transition">
                            <i class="fas fa-times mr-2"></i>Reject
                        </button>
                    {/if}
                    
                    {if appointment.status == 'scheduled' or appointment.status == 'confirmed'}
                        {if appointment.status == 'confirmed' and !appointment.case_id}
                        <button type="button" hx-get="{base_url}/pages/cases/new?appointment_id={appointment.id}" hx-target="#modal-container" hx-swap="innerHTML"
                                class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition">
                            <i class="fas fa-folder-plus mr-2"></i>Create Case
                        </button>
                        {/if}
                        {if can_mark_outcome}
                        <button type="button" hx-post="{base_url}/api/appointments/{appointment.id}/complete" hx-swap="none"
                                class="px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 transition">
                            <i class="fas fa-check-double mr-2"></i>Complete
                        </button>
                        <button type="button" hx-post="{base_url}/api/appointments/{appointment.id}/no-show" hx-swap="none"
                                class="px-4 py-2 text-sm font-medium text-white bg-yellow-600 rounded-lg hover:bg-yellow-700 transition">
                            <i class="fas fa-user-slash mr-2"></i>No Show
                        </button>
                        {else}
                        <button type="button" disabled title="{outcome_locked_reason}"
                                class="px-4 py-2 text-sm font-medium text-white bg-green-300 rounded-lg cursor-not-allowed opacity-70">
                            <i class="fas fa-check-double mr-2"></i>Complete
                        </button>
                        <button type="button" disabled title="{outcome_locked_reason}"
                                class="px-4 py-2 text-sm font-medium text-white bg-yellow-300 rounded-lg cursor-not-allowed opacity-70">
                            <i class="fas fa-user-slash mr-2"></i>No Show
                        </button>
                        {/if}
                        <button type="button" onclick="document.getElementById('cancel-form-{appointment.id}').classList.toggle('hidden')"
                                class="px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 transition">
                            <i class="fas fa-ban mr-2"></i>Cancel
                        </button>
                    {/if}
                </div>
            </div>
            {if (appointment.status == 'scheduled' or appointment.status == 'confirmed') and !can_mark_outcome}
            <div class="px-8 py-3 border-t bg-amber-50 text-xs text-amber-700">
                <i class="fas fa-info-circle mr-1"></i>{outcome_locked_reason}
            </div>
            {/if}
            
            {!-- Hidden Cancel Form --}
            {if appointment.status == 'scheduled' or appointment.status == 'confirmed'}
            <div id="cancel-form-{appointment.id}" class="hidden px-8 py-4 border-t bg-red-50">
                <form hx-post="{base_url}/api/appointments/{appointment.id}/cancel" hx-swap="none" class="flex items-end space-x-3">
                    <div class="flex-1">
                        <label class="block text-sm font-medium text-red-700 mb-1">Cancellation Reason</label>
                        <input type="text" name="cancellation_reason" required placeholder="Enter reason for cancellation..."
                               class="w-full px-4 py-2 border border-red-300 rounded-lg focus:ring-2 focus:ring-red-500 bg-white text-sm">
                    </div>
                    <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 transition whitespace-nowrap">
                        Confirm Cancel
                    </button>
                </form>
            </div>
            {/if}
            
        </div>
    </div>
</div>
