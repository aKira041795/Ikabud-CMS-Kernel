{!-- Guidance Monitoring System - Base Layout --}
{!-- Powered by DiSyL (Declarative Ikabud Syntax Language) --}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title | default:'Guidance Monitoring System'}</title>
    
    {!-- Tailwind CSS --}
    <script src="https://cdn.tailwindcss.com"></script>
    
    {!-- Font Awesome Icons --}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    {!-- HTMX for server-driven reactivity --}
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    
    {!-- Alpine.js for client-side interactivity --}
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>

    {!-- Chart.js for reports charts --}
    <script src="https://unpkg.com/chart.js@4/dist/chart.umd.min.js"></script>
    
    {!-- Application Stylesheet --}
    <link rel="stylesheet" href="/assets/guidance/css/app.css">
    
    {!-- Global config for JS --}
    <script>
        var APP_BASE = '{base_url}';
        var APP_COOKIE = '{cookie_name}';
        var APP_CSRF = '{csrf_token}';
        function guidanceAppPath(path) {
            if (typeof path !== 'string' || path === '') {
                return path;
            }
            if (path.indexOf('http://') === 0 || path.indexOf('https://') === 0 || path.indexOf('//') === 0) {
                return path;
            }
            if (path.charAt(0) !== '/') {
                return path;
            }
            if (APP_BASE && path.indexOf(APP_BASE) === 0) {
                return path;
            }
            return (APP_BASE || '') + path;
        }
        if (window.fetch) {
            var guidanceNativeFetch = window.fetch.bind(window);
            window.fetch = function(input, init) {
                if (typeof input === 'string') {
                    return guidanceNativeFetch(guidanceAppPath(input), init);
                }
                return guidanceNativeFetch(input, init);
            };
        }
        // Execute <script> tags in HTMX-swapped content so Alpine components work
        document.addEventListener('htmx:afterSettle', function(evt) {
            var scripts = evt.detail.target.querySelectorAll('script:not([src])');
            scripts.forEach(function(s) {
                var ns = document.createElement('script');
                ns.textContent = s.textContent;
                s.parentNode.replaceChild(ns, s);
            });
        });
        // Prefix all HTMX requests with the app base path and inject CSRF token
        document.addEventListener('htmx:configRequest', function(evt) {
            var path = evt.detail.path;
            if (path && path.charAt(0) === '/') {
                evt.detail.path = guidanceAppPath(path);
            }
            // Add CSRF token header for state-changing requests
            var verb = (evt.detail.verb || '').toUpperCase();
            if (verb === 'POST' || verb === 'PUT' || verb === 'PATCH' || verb === 'DELETE') {
                evt.detail.headers['X-CSRF-Token'] = APP_CSRF;
            }
        });

        // Optional debug instrumentation: append ?debug=htmx to URL to see all htmx events in console
        if (window.location.search.indexOf('debug=htmx') !== -1) {
            document.addEventListener('DOMContentLoaded', function () {
                if (window.htmx && typeof window.htmx.logAll === 'function') {
                    window.htmx.logAll();
                    console.log('[guidance] htmx.logAll() enabled');
                }
            });
            ['refreshAppointments', 'refreshNotes', 'refreshDocuments', 'refreshCasePanel', 'refreshCases', 'closeModal'].forEach(function (name) {
                document.body.addEventListener(name, function (evt) {
                    console.log('[guidance:event]', name, 'target=', evt.target, 'activeTab=',
                        (document.getElementById('case-view-root') || {}).getAttribute && document.getElementById('case-view-root').getAttribute('data-active-tab'));
                });
            });
        }

        // ============================================================
        // CASE-VIEW TAB AUTO-REFRESH SAFETY NET
        // ------------------------------------------------------------
        // Independent of HX-Trigger event names. Any successful state-
        // changing request to /admin/guidance/api/* while a case-view
        // is open re-fetches the currently active tab. This is the
        // single source of truth for tab refresh after CRUD.
        // ============================================================
        document.addEventListener('htmx:afterRequest', function (evt) {
            try {
                var xhr = evt.detail && evt.detail.xhr;
                if (!xhr || xhr.status < 200 || xhr.status >= 300) return;

                var verb = ((evt.detail.requestConfig && evt.detail.requestConfig.verb) || '').toUpperCase();
                if (verb !== 'POST' && verb !== 'PUT' && verb !== 'PATCH' && verb !== 'DELETE') return;

                var path = (evt.detail.requestConfig && evt.detail.requestConfig.path) || '';
                if (path.indexOf('/admin/guidance/api/') === -1) return;

                // Skip read-only or unrelated paths if any sneak in.
                var caseViewRoot = document.getElementById('case-view-root');
                if (!caseViewRoot) return;

                var activeTab = caseViewRoot.getAttribute('data-active-tab') || 'overview';

                if (window.location.search.indexOf('debug=htmx') !== -1) {
                    console.log('[guidance:autorefresh] ' + verb + ' ' + path + ' -> activeTab=' + activeTab);
                }

                // Slight delay so any HX-Trigger driven listeners (closeModal, toast) run first.
                setTimeout(function () {
                    if (typeof window.guidanceRefreshActiveCaseTab === 'function') {
                        window.guidanceRefreshActiveCaseTab(activeTab);
                    }
                }, 50);
            } catch (e) {
                if (window.console && console.warn) console.warn('[guidance:autorefresh] failed', e);
            }
        });
    </script>
    
    {block head}{/block}
</head>
<body class="bg-gray-50 min-h-screen" x-data="{ sidebarOpen: true, userMenuOpen: false, sessionsOpen: {if current_page == 'appointments' || current_page == 'session-records'}true{else}false{/if} }">

{if is_htmx}
{block content}{/block}
{else}
    
    {if user}
    {!-- Authenticated Layout --}
    <div class="flex h-screen overflow-hidden">
        
        {!-- Sidebar --}
        <aside class="bg-teal-800 text-white transition-all duration-300 flex flex-col"
               :class="sidebarOpen ? 'w-64' : 'w-20'">
            
            {!-- Logo --}
            <div class="flex items-center h-16 px-4 border-b border-teal-700 flex-shrink-0">
                <div class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-heart-pulse text-sm"></i>
                </div>
                <div class="ml-3 overflow-hidden" x-show="sidebarOpen" x-cloak>
                    <span class="font-bold text-sm leading-tight block">Guidance Counseling</span>
                    <span class="text-xs text-teal-300 block">System</span>
                </div>
            </div>
            
            {!-- Navigation --}
            <nav class="mt-4 px-2 flex-1 overflow-y-auto">
                <a href="{base_url}/" 
                   class="flex items-center px-4 py-3 rounded-lg mb-1 hover:bg-teal-700 transition-colors {if current_page == 'dashboard'}bg-teal-700{/if}"
                   hx-get="{base_url}/pages/dashboard" 
                   hx-target="#main-content" 
                   hx-push-url="{base_url}/">
                    <i class="fas fa-th-large w-5 text-center flex-shrink-0"></i>
                    <span class="ml-3 text-sm" x-show="sidebarOpen" x-cloak>Dashboard</span>
                </a>
                
                <a href="{base_url}/cases" 
                   class="flex items-center px-4 py-3 rounded-lg mb-1 hover:bg-teal-700 transition-colors {if current_page == 'cases'}bg-teal-700{/if}"
                   hx-get="{base_url}/pages/cases" 
                   hx-target="#main-content" 
                   hx-push-url="{base_url}/cases">
                    <i class="fas fa-user-graduate w-5 text-center flex-shrink-0"></i>
                    <span class="ml-3 text-sm" x-show="sidebarOpen" x-cloak>Students</span>
                </a>
                
                {!-- Sessions (expandable) --}
                <div x-show="sidebarOpen" x-cloak>
                    <button @click="sessionsOpen = !sessionsOpen"
                            class="w-full flex items-center px-4 py-3 rounded-lg mb-1 hover:bg-teal-700 transition-colors {if current_page == 'appointments' || current_page == 'session-records'}bg-teal-700{/if}">
                        <i class="fas fa-calendar-check w-5 text-center flex-shrink-0"></i>
                        <span class="ml-3 text-sm flex-1 text-left">Scheduling &amp; Records</span>
                        <i class="fas text-xs transition-transform" :class="sessionsOpen ? 'fa-chevron-down' : 'fa-chevron-right'"></i>
                    </button>
                    <div x-show="sessionsOpen" class="ml-4 space-y-0.5 mb-1">
                        <a href="{base_url}/appointments"
                           class="flex items-center pl-6 pr-4 py-2 rounded-lg hover:bg-teal-700 transition-colors text-teal-200 hover:text-white {if current_page == 'appointments'}bg-teal-700 text-white{/if}"
                           hx-get="{base_url}/pages/appointments"
                           hx-target="#main-content"
                           hx-push-url="{base_url}/appointments">
                            <span class="w-2 h-2 rounded-full bg-current mr-3 flex-shrink-0"></span>
                            <span class="text-sm">Appointments &amp; Scheduling</span>
                        </a>
                        <a href="{base_url}/session-records"
                           class="flex items-center pl-6 pr-4 py-2 rounded-lg hover:bg-teal-700 transition-colors text-teal-200 hover:text-white {if current_page == 'session-records'}bg-teal-700 text-white{/if}"
                           hx-get="{base_url}/pages/session-records"
                           hx-target="#main-content"
                           hx-push-url="{base_url}/session-records">
                            <span class="w-2 h-2 rounded-full bg-current mr-3 flex-shrink-0"></span>
                            <span class="text-sm">Clinical Session Records</span>
                        </a>
                    </div>
                </div>
                {!-- Sessions icon-only collapsed --}
                <div x-show="!sidebarOpen" x-cloak>
                    <a href="{base_url}/appointments"
                       class="flex items-center px-4 py-3 rounded-lg mb-1 hover:bg-teal-700 transition-colors {if current_page == 'appointments'}bg-teal-700{/if}"
                       hx-get="{base_url}/pages/appointments"
                       hx-target="#main-content"
                       hx-push-url="{base_url}/appointments">
                        <i class="fas fa-calendar-check w-5 text-center flex-shrink-0"></i>
                    </a>
                    <a href="{base_url}/session-records"
                       class="flex items-center px-4 py-3 rounded-lg mb-1 hover:bg-teal-700 transition-colors {if current_page == 'session-records'}bg-teal-700{/if}"
                       hx-get="{base_url}/pages/session-records"
                       hx-target="#main-content"
                       hx-push-url="{base_url}/session-records">
                        <i class="fas fa-clipboard-list w-5 text-center flex-shrink-0"></i>
                    </a>
                </div>
                
                <a href="{base_url}/reports" 
                   class="flex items-center px-4 py-3 rounded-lg mb-1 hover:bg-teal-700 transition-colors {if current_page == 'reports'}bg-teal-700{/if}"
                   hx-get="{base_url}/pages/reports" 
                   hx-target="#main-content" 
                   hx-push-url="{base_url}/reports">
                    <i class="fas fa-chart-bar w-5 text-center flex-shrink-0"></i>
                    <span class="ml-3 text-sm" x-show="sidebarOpen" x-cloak>Reports</span>
                </a>
                
                <a href="{base_url}/calendar" 
                   class="flex items-center px-4 py-3 rounded-lg mb-1 hover:bg-teal-700 transition-colors {if current_page == 'calendar'}bg-teal-700{/if}"
                   hx-get="{base_url}/pages/calendar" 
                   hx-target="#main-content" 
                   hx-push-url="{base_url}/calendar">
                    <i class="fas fa-calendar w-5 text-center flex-shrink-0"></i>
                    <span class="ml-3 text-sm" x-show="sidebarOpen" x-cloak>Calendar</span>
                </a>
                
                <a href="{base_url}/alerts"
                         class="flex items-center px-4 py-3 rounded-lg mb-1 hover:bg-teal-700 transition-colors {if current_page == 'alerts'}bg-teal-700{/if}"
                         hx-get="{base_url}/pages/alerts"
                         hx-target="#main-content"
                         hx-push-url="{base_url}/alerts">
                    <i class="fas fa-bell w-5 text-center flex-shrink-0"></i>
                    <span class="ml-3 text-sm" x-show="sidebarOpen" x-cloak>Alerts</span>
                </a>

                {if module_nav_items}
                <div class="mt-4 pt-4 border-t border-teal-700">
                    <span class="px-4 text-xs uppercase text-teal-400" x-show="sidebarOpen" x-cloak>Modules</span>
                    {foreach module_nav_items as nav}
                    <a href="{base_url}/{nav.module_id}" 
                       class="flex items-center px-4 py-3 rounded-lg mb-1 hover:bg-teal-700 mt-1 transition-colors {if current_page == nav.module_id}bg-teal-700{/if}"
                       hx-get="{base_url}/pages/{nav.module_id}" 
                       hx-target="#main-content" 
                       hx-push-url="{base_url}/{nav.module_id}">
                        <i class="{nav.icon} w-6"></i>
                        <span class="ml-3" x-show="sidebarOpen" x-cloak>{nav.label}</span>
                    </a>
                    {/foreach}
                </div>
                {/if}
                
                <div class="mt-4 pt-4 border-t border-teal-700">
                    <a href="{base_url}/trackers"
                       class="flex items-center px-4 py-3 rounded-lg mb-1 hover:bg-teal-700 transition-colors {if current_page == 'trackers'}bg-teal-700{/if}"
                       hx-get="{base_url}/pages/trackers"
                       hx-target="#main-content"
                       hx-push-url="{base_url}/trackers">
                        <i class="fas fa-file-alt w-5 text-center flex-shrink-0"></i>
                        <span class="ml-3 text-sm" x-show="sidebarOpen" x-cloak>Trackers</span>
                    </a>

                {if user.role == 'admin'}
                    <span class="px-4 pt-2 pb-1 text-xs uppercase text-teal-400 block" x-show="sidebarOpen" x-cloak>Administration</span>
                    <a href="{base_url}/users"
                       class="flex items-center px-4 py-3 rounded-lg mb-1 hover:bg-teal-700 transition-colors {if current_page == 'users'}bg-teal-700{/if}"
                       hx-get="{base_url}/pages/users"
                       hx-target="#main-content"
                       hx-push-url="{base_url}/users">
                        <i class="fas fa-users w-5 text-center flex-shrink-0"></i>
                        <span class="ml-3 text-sm" x-show="sidebarOpen" x-cloak>Users</span>
                    </a>
                    <a href="{base_url}/colleges"
                       class="flex items-center px-4 py-3 rounded-lg mb-1 hover:bg-teal-700 transition-colors {if current_page == 'colleges'}bg-teal-700{/if}"
                       hx-get="{base_url}/pages/colleges"
                       hx-target="#main-content"
                       hx-push-url="{base_url}/colleges">
                        <i class="fas fa-university w-5 text-center flex-shrink-0"></i>
                        <span class="ml-3 text-sm" x-show="sidebarOpen" x-cloak>Colleges</span>
                    </a>
                    <a href="{base_url}/form-settings"
                       class="flex items-center px-4 py-3 rounded-lg mb-1 hover:bg-teal-700 transition-colors {if current_page == 'form-settings'}bg-teal-700{/if}"
                       hx-get="{base_url}/pages/form-settings"
                       hx-target="#main-content"
                       hx-push-url="{base_url}/form-settings">
                        <i class="fas fa-sliders-h w-5 text-center flex-shrink-0"></i>
                        <span class="ml-3 text-sm" x-show="sidebarOpen" x-cloak>Form Settings</span>
                    </a>
                    <a href="{base_url}/email-templates"
                       class="flex items-center px-4 py-3 rounded-lg mb-1 hover:bg-teal-700 transition-colors {if current_page == 'email-templates'}bg-teal-700{/if}"
                       hx-get="{base_url}/pages/email-templates"
                       hx-target="#main-content"
                       hx-push-url="{base_url}/email-templates">
                        <i class="fas fa-envelope w-5 text-center flex-shrink-0"></i>
                        <span class="ml-3 text-sm" x-show="sidebarOpen" x-cloak>Email Templates</span>
                    </a>
                    <a href="{base_url}/settings" 
                       class="flex items-center px-4 py-3 rounded-lg mb-1 hover:bg-teal-700 transition-colors {if current_page == 'settings'}bg-teal-700{/if}"
                       hx-get="{base_url}/pages/settings" 
                       hx-target="#main-content" 
                       hx-push-url="{base_url}/settings">
                        <i class="fas fa-cog w-5 text-center flex-shrink-0"></i>
                        <span class="ml-3 text-sm" x-show="sidebarOpen" x-cloak>Settings</span>
                    </a>
                {/if}
                </div>
            </nav>

            {!-- Bottom user profile --}
            <div class="flex-shrink-0 border-t border-teal-700 p-3" x-data="{ open: false }">
                <button @click="open = !open" class="w-full flex items-center gap-3 rounded-lg hover:bg-teal-700 px-2 py-2 transition-colors">
                    <div class="w-9 h-9 bg-teal-600 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-semibold">
                        {user.first_name | first | upper}
                    </div>
                    <div class="flex-1 text-left overflow-hidden" x-show="sidebarOpen" x-cloak>
                        <p class="text-sm font-medium truncate">{user.first_name} {user.last_name}</p>
                        <p class="text-xs text-teal-300 capitalize">{user.role}</p>
                    </div>
                    <i class="fas fa-chevron-up text-xs text-teal-400" x-show="sidebarOpen" x-cloak :class="open ? '' : 'rotate-180'" style="transition:transform 0.2s"></i>
                </button>
                <div x-show="open" @click.away="open = false" x-cloak
                     class="mt-1 bg-teal-700 rounded-lg py-1 overflow-hidden">
                    <a href="{base_url}/profile"
                       hx-get="{base_url}/pages/profile" hx-target="#main-content" hx-push-url="{base_url}/profile"
                       @click="open = false"
                       class="flex items-center px-4 py-2 text-sm hover:bg-teal-600 transition-colors">
                        <i class="fas fa-user mr-2 w-4"></i> Profile
                    </a>
                    <hr class="my-1 border-teal-600">
                    <a href="{base_url}/logout" class="flex items-center px-4 py-2 text-sm text-red-300 hover:bg-teal-600 hover:text-red-200 transition-colors">
                        <i class="fas fa-sign-out-alt mr-2 w-4"></i> Logout
                    </a>
                </div>
            </div>
        </aside>
        
        {!-- Main Content Area --}
        <div class="flex-1 flex flex-col overflow-hidden">
            
            {!-- Top Header --}
            <header class="bg-white shadow-sm h-16 flex items-center justify-between px-6">
                <div class="flex items-center gap-4">
                    <button @click="sidebarOpen = !sidebarOpen" class="text-gray-500 hover:text-gray-700">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                </div>
                
                <div class="flex items-center space-x-4">
                    {!-- HTMX Loading Indicator --}
                    <div class="htmx-indicator">
                        <div class="animate-spin rounded-full h-5 w-5 border-2 border-gray-300 border-t-teal-600"></div>
                    </div>
                    
                    {!-- Notifications --}
                    <div class="relative" x-data="{ notifOpen: false, notifications: [], unread: {notifications_count} }" x-cloak>
                        <button @click="notifOpen = !notifOpen; if(notifOpen) fetchNotifications($data)" class="relative text-gray-500 hover:text-gray-700">
                            <i class="fas fa-bell text-xl"></i>
                            <span x-show="unread > 0" class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center" x-text="unread"></span>
                        </button>
                        
                        <div x-show="notifOpen" @click.away="notifOpen = false"
                             class="absolute right-0 mt-2 w-80 bg-white rounded-lg shadow-xl border border-gray-200 z-50 overflow-hidden">
                            <div class="flex items-center justify-between px-4 py-3 bg-gray-50 border-b">
                                <span class="font-semibold text-sm text-gray-700">Notifications</span>
                                <button x-show="unread > 0" @click="markAllRead($data)" class="text-xs text-teal-600 hover:underline">Mark all read</button>
                            </div>
                            <div class="max-h-80 overflow-y-auto divide-y divide-gray-100">
                                <template x-if="notifications.length === 0">
                                    <div class="px-4 py-8 text-center text-gray-400 text-sm">
                                        <i class="fas fa-bell-slash text-2xl mb-2"></i>
                                        <p>No notifications</p>
                                    </div>
                                </template>
                                <template x-for="n in notifications" :key="n.id">
                                    <a :href="n.link ? (APP_BASE + n.link) : '#'" 
                                       @click="markRead($data, n)"
                                       class="block px-4 py-3 hover:bg-gray-50 transition"
                                       :class="n.is_read == 0 ? 'bg-teal-50/50' : ''">
                                        <div class="flex items-start space-x-3">
                                            <div class="flex-shrink-0 mt-0.5">
                                                <i class="fas text-sm" :class="{
                                                    'fa-calendar-check text-green-500': n.type === 'appointment_approved',
                                                    'fa-calendar-plus text-teal-500': n.type === 'appointment_request',
                                                    'fa-calendar-times text-red-500': n.type === 'appointment_rejected',
                                                    'fa-folder-plus text-blue-500': n.type === 'case_assigned',
                                                    'fa-info-circle text-gray-400': !['appointment_approved','appointment_request','appointment_rejected','case_assigned'].includes(n.type)
                                                }"></i>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <p class="text-sm font-medium text-gray-900 truncate" x-text="n.title"></p>
                                                <p class="text-xs text-gray-500 truncate" x-text="n.message"></p>
                                                <p class="text-xs text-gray-400 mt-1" x-text="timeAgo(n.created_at)"></p>
                                            </div>
                                            <div x-show="n.is_read == 0" class="flex-shrink-0">
                                                <span class="inline-block w-2 h-2 bg-teal-500 rounded-full"></span>
                                            </div>
                                        </div>
                                    </a>
                                </template>
                            </div>
                        </div>
                    </div>
                    
                    {!-- User avatar (top-right) --}
                    <div class="relative" x-data="{ open: false }">
                        <button @click="open = !open" class="w-9 h-9 bg-gray-800 rounded-full flex items-center justify-center text-white text-sm font-semibold hover:bg-gray-700 transition-colors">
                            {user.first_name | first | upper}
                        </button>
                        
                        <div x-show="open" @click.away="open = false" x-cloak
                             class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg py-2 z-50">
                            <a href="{base_url}/profile" 
                               hx-get="{base_url}/pages/profile" 
                               hx-target="#main-content" 
                               hx-push-url="{base_url}/profile"
                               @click="open = false"
                               class="block px-4 py-2 text-gray-700 hover:bg-gray-100">
                                <i class="fas fa-user mr-2"></i> Profile
                            </a>
                            <hr class="my-2">
                            <a href="{base_url}/logout" class="block px-4 py-2 text-red-600 hover:bg-gray-100">
                                <i class="fas fa-sign-out-alt mr-2"></i> Logout
                            </a>
                        </div>
                    </div>
                </div>
            </header>
            
            {!-- Main Content --}
            <main id="main-content" class="flex-1 overflow-y-auto p-6">
                {block content}{/block}
            </main>
        </div>
    </div>
    
    {else}
    {!-- Guest Layout (Login Page) --}
    <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-teal-600 to-teal-800 py-12 px-4">
        {block content}{/block}
    </div>
    {/if}

    
    {!-- Toast Notifications Container --}
    <div id="toast-container" class="fixed bottom-4 right-4 z-50 space-y-2"></div>
    
    {!-- Modal Container --}
    <div id="modal-container"></div>
    
    {!-- Global Scripts --}
    <script>
        // HTMX event handlers
        document.body.addEventListener('htmx:beforeRequest', function(evt) {
            document.body.classList.add('htmx-request');
        });
        
        document.body.addEventListener('htmx:afterRequest', function(evt) {
            document.body.classList.remove('htmx-request');
        });
        
        // Update sidebar highlighting on HTMX navigation
        document.body.addEventListener('htmx:pushedIntoHistory', function(evt) {
            updateSidebarActive(evt.detail.path);
        });

        function normalizeGuidanceNavPath(path) {
            if (!path) {
                return '/';
            }
            if (APP_BASE && path.indexOf(APP_BASE) === 0) {
                path = path.substring(APP_BASE.length);
            }
            if (!path) {
                return '/';
            }
            path = path.replace(/\/+$/, '');
            return path === '' ? '/' : path;
        }
        
        function updateSidebarActive(path) {
            path = normalizeGuidanceNavPath(path);

            document.querySelectorAll('aside nav a').forEach(link => {
                link.classList.remove('bg-teal-700');
            });

            let matchPath = path;
            if (matchPath.startsWith('/cases/')) matchPath = '/cases';
            if (matchPath.startsWith('/appointments/')) matchPath = '/appointments';
            if (matchPath.startsWith('/trackers/')) matchPath = '/trackers';
            if (matchPath.startsWith('/session-records/')) matchPath = '/session-records';

            document.querySelectorAll('aside nav a[href]').forEach(link => {
                const linkPath = normalizeGuidanceNavPath(link.getAttribute('href') || '');
                if (linkPath === matchPath) {
                    link.classList.add('bg-teal-700');
                }
            });
        }
        
        // Initialize on page load - strip base path for matching
        var currentPath = window.location.pathname;
        if (APP_BASE && currentPath.indexOf(APP_BASE) === 0) {
            currentPath = currentPath.substring(APP_BASE.length);
        }
        if (!currentPath) currentPath = '/';
        updateSidebarActive(currentPath);
        
        // Notification functions
        function getAuthHeader() {
            return { 'Authorization': 'Bearer ' + (document.cookie.match(new RegExp(APP_COOKIE + '=([^;]+)'))?.[1] || '') };
        }
        
        function fetchNotifications(ctx) {
            fetch(APP_BASE + '/api/notifications', { headers: getAuthHeader() })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        ctx.notifications = data.data || [];
                        ctx.unread = data.unread_count || 0;
                    }
                })
                .catch(() => {});
        }
        
        function markRead(ctx, n) {
            if (n.is_read == 1) return;
            n.is_read = 1;
            ctx.unread = Math.max(0, ctx.unread - 1);
            fetch(APP_BASE + '/api/notifications/read', {
                method: 'POST',
                headers: Object.assign({ 'Content-Type': 'application/x-www-form-urlencoded' }, getAuthHeader()),
                body: 'id=' + n.id
            }).catch(() => {});
        }
        
        function markAllRead(ctx) {
            ctx.notifications.forEach(n => n.is_read = 1);
            ctx.unread = 0;
            fetch(APP_BASE + '/api/notifications/read', {
                method: 'POST',
                headers: Object.assign({ 'Content-Type': 'application/x-www-form-urlencoded' }, getAuthHeader()),
                body: ''
            }).catch(() => {});
        }
        
        function timeAgo(dateStr) {
            var d = new Date(dateStr.replace(' ', 'T'));
            var now = new Date();
            var diff = Math.floor((now - d) / 1000);
            if (diff < 60) return 'Just now';
            if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
            if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
            if (diff < 604800) return Math.floor(diff / 86400) + 'd ago';
            return d.toLocaleDateString();
        }
        
        // Toast notification function
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const colors = {
                success: 'bg-green-500',
                error: 'bg-red-500',
                warning: 'bg-yellow-500',
                info: 'bg-blue-500'
            };
            
            const toast = document.createElement('div');
            toast.className = `${colors[type]} text-white px-6 py-3 rounded-lg shadow-lg transform transition-all duration-300 translate-x-full`;
            toast.textContent = message;
            container.appendChild(toast);
            
            setTimeout(() => toast.classList.remove('translate-x-full'), 10);
            setTimeout(() => {
                toast.classList.add('translate-x-full');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }
        
        // Handle HTMX errors
        document.body.addEventListener('htmx:responseError', function(evt) {
            const xhr = evt.detail && evt.detail.xhr ? evt.detail.xhr : null;
            if (!xhr) {
                showToast('An error occurred. Please try again.', 'error');
                return;
            }

            const triggerHeader = xhr.getResponseHeader('HX-Trigger');
            if (triggerHeader) {
                return;
            }

            let message = 'An error occurred. Please try again.';
            const contentType = xhr.getResponseHeader('Content-Type') || '';

            if (contentType.indexOf('application/json') !== -1) {
                try {
                    const data = JSON.parse(xhr.responseText || '{}');
                    if (data && data.error) {
                        message = data.error;
                    }
                } catch (e) {}
            } else if (xhr.responseText) {
                const text = xhr.responseText.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
                if (text) {
                    message = text.length > 160 ? text.slice(0, 157) + '...' : text;
                }
            }

            showToast(message, 'error');
        });

        // Treat toast-only HX responses as handled validations, not hard HTMX errors.
        document.body.addEventListener('htmx:beforeSwap', function(evt) {
            const xhr = evt.detail && evt.detail.xhr ? evt.detail.xhr : null;
            if (!xhr) {
                return;
            }

            const triggerHeader = xhr.getResponseHeader('HX-Trigger');
            const responseText = (xhr.responseText || '').trim();
            if (!triggerHeader || responseText !== '') {
                return;
            }

            evt.detail.shouldSwap = false;
            evt.detail.isError = false;
        });
        
        // Handle custom showToast trigger from server
        document.body.addEventListener('showToast', function(evt) {
            if (evt.detail && evt.detail.message) {
                showToast(evt.detail.message, evt.detail.type || 'info');
            }
        });
        
        // Handle refreshUsers trigger - reload users list
        document.body.addEventListener('refreshUsers', function(evt) {
            closeModal();
            const usersList = document.getElementById('users-list');
            if (usersList) {
                htmx.trigger(usersList, 'load');
            }
        });
        
        // Handle closeModal trigger
        document.body.addEventListener('closeModal', function(evt) {
            closeModal();
        });
        
        // Handle refreshCases trigger
        document.body.addEventListener('refreshCases', function(evt) {
            closeModal();
            const casesList = document.getElementById('cases-list');
            if (casesList) {
                htmx.trigger(casesList, 'load');
            }
        });
        
        // Handle refreshFormFields trigger
        document.body.addEventListener('refreshFormFields', function(evt) {
            var fieldsList = document.getElementById('form-fields-list');
            if (fieldsList) {
                htmx.trigger(fieldsList, 'load');
            }
        });
        
        // Handle refreshColleges trigger
        document.body.addEventListener('refreshColleges', function(evt) {
            closeModal();
            var collegesList = document.getElementById('colleges-list');
            if (collegesList) {
                htmx.trigger(collegesList, 'load');
            }
        });

        function reloadCurrentCaseView() {
            const caseViewRoot = document.getElementById('case-view-root');
            if (!caseViewRoot) {
                return false;
            }

            const caseId = caseViewRoot.getAttribute('data-case-view-id');
            if (!caseId) {
                return false;
            }

            const activeTab = caseViewRoot.getAttribute('data-active-tab') || 'overview';
            const mainContent = document.getElementById('main-content');
            const tabEventMap = {
                appointments: 'load-case-appts',
                session_records: 'load-case-sessions',
                notes: 'load-case-notes',
                documents: 'load-case-docs',
                alerts: 'load-case-alerts',
                log: 'load-case-log'
            };

            if (mainContent) {
                const afterSwap = function(evt) {
                    if (evt.target !== mainContent) {
                        return;
                    }

                    mainContent.removeEventListener('htmx:afterSwap', afterSwap);

                    const tabEvent = tabEventMap[activeTab];
                    if (!tabEvent) {
                        return;
                    }

                    requestAnimationFrame(function() {
                        document.body.dispatchEvent(new CustomEvent(tabEvent, { bubbles: true }));
                    });
                };

                mainContent.addEventListener('htmx:afterSwap', afterSwap);
            }

            htmx.ajax('GET', APP_BASE + '/pages/cases/' + caseId, {
                target: '#main-content',
                swap: 'innerHTML'
            });
            return true;
        }

        function reloadCaseViewTab(tabName) {
            const tabMap = {
                appointments: 'case-appt-tab',
                session_records: 'case-sessions-tab',
                notes: 'case-notes-tab',
                documents: 'case-documents-tab',
                alerts: 'case-alerts-tab',
                log: 'case-log-tab'
            };

            const targetId = tabMap[tabName || ''];
            if (!targetId) {
                return false;
            }

            const targetEl = document.getElementById(targetId);
            if (!targetEl) {
                return false;
            }

            const url = targetEl.getAttribute('hx-get');
            if (!url) {
                return false;
            }

            // Cache-bust to defeat any intermediate browser/proxy caching of GETs.
            var bustChar = url.indexOf('?') === -1 ? '?' : '&';
            var bustedUrl = url + bustChar + '_ts=' + Date.now();

            htmx.ajax('GET', guidanceAppPath(bustedUrl), {
                target: '#' + targetId,
                swap: 'innerHTML'
            });

            return true;
        }

        // Expose a single, idempotent refresh entry point used by the
        // htmx:afterRequest safety net AND by HX-Trigger listeners below.
        window.guidanceRefreshActiveCaseTab = function (preferredTab) {
            const caseViewRoot = document.getElementById('case-view-root');
            if (!caseViewRoot) return false;
            const activeTab = preferredTab || caseViewRoot.getAttribute('data-active-tab') || 'overview';
            if (activeTab === 'overview') {
                return reloadCurrentCaseView();
            }
            return reloadCaseViewTab(activeTab);
        };
        
        // Handle refreshAppointments trigger
        document.body.addEventListener('refreshAppointments', function(evt) {
            closeModal();
            if (window.guidanceRefreshActiveCaseTab) {
                window.guidanceRefreshActiveCaseTab();
            }
        });
        
        // Handle refreshNotes trigger
        document.body.addEventListener('refreshNotes', function(evt) {
            closeModal();
            if (window.guidanceRefreshActiveCaseTab) {
                window.guidanceRefreshActiveCaseTab();
            }
        });

        // Handle refreshDocuments trigger
        document.body.addEventListener('refreshDocuments', function(evt) {
            closeModal();
            if (window.guidanceRefreshActiveCaseTab) {
                window.guidanceRefreshActiveCaseTab();
            }
        });

        // Close modal function
        function closeModal() {
            document.getElementById('modal-container').innerHTML = '';
        }
        
        // Close modal on escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeModal();
        });
        
        // Alpine.js component: Appointments page with calendar
        function appointmentsPage() {
            return {
                view: 'list',
                currentDate: new Date(),
                appointments: [],
                activeTab: 'all',
                filterStatus: '',
                filterFrom: '',
                filterTo: '',

                init() {
                    this.fetchAppointments();
                    document.body.addEventListener('refreshAppointments', () => this.fetchAppointments());
                },

                loadList() {
                    var values = { status: this.filterStatus };
                    if (this.filterFrom) values.from = this.filterFrom;
                    if (this.filterTo)   values.to   = this.filterTo;
                    htmx.ajax('GET', APP_BASE + '/api/appointments', {
                        target: '#appointments-list',
                        swap: 'innerHTML',
                        values: values
                    });
                },
                
                get monthLabel() {
                    return this.currentDate.toLocaleString('default', { month: 'long', year: 'numeric' });
                },
                
                prevMonth() {
                    this.currentDate = new Date(this.currentDate.getFullYear(), this.currentDate.getMonth() - 1, 1);
                    this.fetchAppointments();
                },
                
                nextMonth() {
                    this.currentDate = new Date(this.currentDate.getFullYear(), this.currentDate.getMonth() + 1, 1);
                    this.fetchAppointments();
                },
                
                goToday() {
                    this.currentDate = new Date();
                    this.fetchAppointments();
                },
                
                async fetchAppointments() {
                    try {
                        const resp = await fetch(APP_BASE + '/api/appointments', {
                            headers: { 'Authorization': 'Bearer ' + (document.cookie.match(new RegExp(APP_COOKIE + '=([^;]+)'))?.[1] || '') }
                        });
                        const data = await resp.json();
                        if (data.success) this.appointments = data.data || [];
                    } catch (e) {
                        console.error('Failed to fetch appointments', e);
                    }
                },
                
                get calendarCells() {
                    const year = this.currentDate.getFullYear();
                    const month = this.currentDate.getMonth();
                    const firstDay = new Date(year, month, 1).getDay();
                    const daysInMonth = new Date(year, month + 1, 0).getDate();
                    const daysInPrev = new Date(year, month, 0).getDate();
                    const today = new Date();
                    const cells = [];
                    
                    for (let i = firstDay - 1; i >= 0; i--) {
                        const d = daysInPrev - i;
                        cells.push({ key: 'p' + d, day: d, currentMonth: false, isToday: false, appointments: [] });
                    }
                    
                    for (let d = 1; d <= daysInMonth; d++) {
                        const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
                        const isToday = today.getFullYear() === year && today.getMonth() === month && today.getDate() === d;
                        const dayAppts = this.appointments.filter(a => a.scheduled_date === dateStr);
                        cells.push({ key: dateStr, day: d, currentMonth: true, isToday, appointments: dayAppts });
                    }
                    
                    const remaining = 42 - cells.length;
                    for (let d = 1; d <= remaining; d++) {
                        cells.push({ key: 'n' + d, day: d, currentMonth: false, isToday: false, appointments: [] });
                    }
                    
                    return cells;
                },
                
                statusColor(status) {
                    const colors = {
                        pending: 'bg-amber-100 text-amber-800 border border-amber-200',
                        scheduled: 'bg-blue-100 text-blue-800 border border-blue-200',
                        confirmed: 'bg-indigo-100 text-indigo-800 border border-indigo-200',
                        completed: 'bg-green-100 text-green-800 border border-green-200',
                        cancelled: 'bg-red-100 text-red-800 border border-red-200',
                        rejected: 'bg-gray-100 text-gray-800 border border-gray-200',
                        no_show: 'bg-yellow-100 text-yellow-800 border border-yellow-200',
                    };
                    return colors[status] || 'bg-gray-100 text-gray-700';
                },
                
                openAppt(id) {
                    htmx.ajax('GET', APP_BASE + '/pages/appointments/' + id + '/edit', { target: '#modal-container', swap: 'innerHTML' });
                }
            };
        }

        function guidanceCalendarPage(initMonth) {
            return {
                month: initMonth || '',
                monthLabel: '',
                loading: true,
                filterCounselor: '',
                appointments: [],
                calendarCells: [],

                init() {
                    if (!this.month) {
                        this.month = new Date().toISOString().slice(0, 7);
                    }
                    this.updateMonthLabel();
                    this.loadCalendar();
                    document.body.addEventListener('refreshAppointmentsCalendar', () => this.loadCalendar());
                },

                updateMonthLabel() {
                    var parts = (this.month || '').split('-');
                    var year = parseInt(parts[0], 10);
                    var month = parseInt(parts[1], 10) - 1;
                    var date = new Date(year, month, 1);
                    if (isNaN(date.getTime())) {
                        date = new Date();
                        this.month = date.toISOString().slice(0, 7);
                    }
                    this.monthLabel = date.toLocaleString('default', { month: 'long', year: 'numeric' });
                },

                prevMonth() {
                    var parts = this.month.split('-');
                    var date = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 2, 1);
                    this.month = date.getFullYear() + '-' + String(date.getMonth() + 1).padStart(2, '0');
                    this.updateMonthLabel();
                    this.loadCalendar();
                },

                nextMonth() {
                    var parts = this.month.split('-');
                    var date = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10), 1);
                    this.month = date.getFullYear() + '-' + String(date.getMonth() + 1).padStart(2, '0');
                    this.updateMonthLabel();
                    this.loadCalendar();
                },

                goToday() {
                    this.month = new Date().toISOString().slice(0, 7);
                    this.updateMonthLabel();
                    this.loadCalendar();
                },

                loadCalendar() {
                    this.loading = true;
                    var params = new URLSearchParams({ month: this.month });
                    if (this.filterCounselor) {
                        params.set('counselor_id', this.filterCounselor);
                    }

                    fetch(APP_BASE + '/api/appointments/calendar?' + params.toString())
                        .then(function(response) {
                            return response.json();
                        })
                        .then((data) => {
                            this.month = data.month || this.month;
                            this.updateMonthLabel();
                            this.appointments = Array.isArray(data.appointments) ? data.appointments : [];
                            this.buildCells();
                            this.loading = false;
                        })
                        .catch(() => {
                            this.buildCells();
                            this.loading = false;
                        });
                },

                buildCells() {
                    var parts = this.month.split('-');
                    var year = parseInt(parts[0], 10);
                    var month = parseInt(parts[1], 10) - 1;
                    var today = new Date();
                    var todayStr = today.getFullYear() + '-' + String(today.getMonth() + 1).padStart(2, '0') + '-' + String(today.getDate()).padStart(2, '0');

                    var first = new Date(year, month, 1);
                    var last = new Date(year, month + 1, 0);
                    var cells = [];

                    for (var i = 0; i < first.getDay(); i++) {
                        var leadingDate = new Date(year, month, 1 - first.getDay() + i);
                        cells.push({ day: leadingDate.getDate(), currentMonth: false, isToday: false, appointments: [] });
                    }

                    for (var day = 1; day <= last.getDate(); day++) {
                        var dateStr = year + '-' + String(month + 1).padStart(2, '0') + '-' + String(day).padStart(2, '0');
                        var dayAppointments = this.appointments.filter(function(appointment) {
                            return appointment.scheduled_date === dateStr;
                        });
                        cells.push({
                            day: day,
                            date: dateStr,
                            currentMonth: true,
                            isToday: dateStr === todayStr,
                            appointments: dayAppointments,
                        });
                    }

                    var trailing = 42 - cells.length;
                    for (var j = 1; j <= trailing; j++) {
                        cells.push({ day: j, currentMonth: false, isToday: false, appointments: [] });
                    }

                    this.calendarCells = cells;
                },

                apptColor(status) {
                    var map = {
                        completed: 'bg-green-500',
                        scheduled: 'bg-teal-500',
                        confirmed: 'bg-teal-600',
                        in_progress: 'bg-blue-500',
                        pending: 'bg-amber-400',
                        no_show: 'bg-red-400',
                        cancelled: 'bg-red-400',
                        rejected: 'bg-red-400',
                    };
                    return map[status] || 'bg-gray-400';
                },

                openAppt(appt) {
                    htmx.ajax('GET', APP_BASE + '/pages/appointments/' + appt.id, {
                        target: '#modal-container',
                        swap: 'innerHTML'
                    });
                }
            };
        }
        
        // Re-initialize Alpine.js on HTMX content swaps, including lazy-loaded case tabs.
        document.body.addEventListener('htmx:afterSettle', function(evt) {
            var target = evt.detail && evt.detail.target ? evt.detail.target : null;
            if (!target || !window.Alpine) {
                return;
            }

            if (
                target.hasAttribute('x-data') ||
                target.querySelector('[x-data], [x-init], [x-show], [x-text], template[x-for], template[x-if]')
            ) {
                // Defer to next tick so HTMX finishes all DOM operations first.
                setTimeout(function() { Alpine.initTree(target); }, 0);
            }
        });
    </script>
    
    {block scripts}{/block}
{/if}
</body>
</html>
