{extends "modules/guidance/layouts/app.disyl"}

{block content}
{!-- Reports Page --}

{ikb_section padding="none"}

<div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6 gap-4">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Reports</h1>
        <p class="text-sm text-gray-500 mt-1">Generate DOCX exports for cases and appointments</p>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-semibold text-gray-900">Case Summary (DOCX)</h2>
        </div>
        <div class="mt-3 text-sm text-gray-600">Export a single case with basic details and recent counselor notes.</div>

        <div class="mt-5 space-y-3">
            <label class="block text-sm font-medium text-gray-700">Case</label>
            <select name="case_id" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                    hx-get="/admin/guidance/api/cases/options" hx-trigger="load" hx-target="this" hx-swap="innerHTML">
                <option value="">Loading cases...</option>
            </select>
        </div>

        <div class="mt-5 flex items-center justify-end gap-3">
            <button type="button"
                    onclick="var id=document.querySelector('[name=case_id]').value; if(!id){alert('Select a case');return;} window.open('/admin/guidance/reports/cases/'+id+'/docx','_blank');"
                    class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition shadow-sm">
                <i class="fas fa-file-word mr-2"></i> Download DOCX
            </button>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <div class="flex items-center justify-between">
            <h2 class="text-lg font-semibold text-gray-900">Appointments (DOCX)</h2>
        </div>
        <div class="mt-3 text-sm text-gray-600">Export appointments by date range. Admin/supervisor can filter by counselor.</div>

        <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">From</label>
                <input type="date" name="from" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">To</label>
                <input type="date" name="to" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
            </div>
        </div>

        {if user_role != 'counselor'}
        <div class="mt-4">
            <label class="block text-sm font-medium text-gray-700 mb-1">Counselor</label>
            <select name="counselor_id" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                <option value="">All counselors</option>
                {foreach counselors as c}
                <option value="{c.id}">{c.first_name} {c.last_name}</option>
                {/foreach}
            </select>
        </div>
        {/if}

        <div class="mt-5 flex items-center justify-end gap-3">
            <button type="button"
                    onclick="var f=document.querySelector('[name=from]').value; var t=document.querySelector('[name=to]').value; if(!f||!t){alert('Select date range');return;} var qs=new URLSearchParams({from:f,to:t}); var c=document.querySelector('[name=counselor_id]'); if(c&&c.value) qs.set('counselor_id',c.value); window.open('/admin/guidance/reports/appointments/docx?'+qs.toString(),'_blank');"
                    class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition shadow-sm">
                <i class="fas fa-file-word mr-2"></i> Download DOCX
            </button>
        </div>
    </div>

</div>

{/ikb_section}

{/block}
