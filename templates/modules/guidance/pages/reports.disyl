{extends "modules/guidance/layouts/app.disyl"}

{block content}
{!-- Reports Page --}

{ikb_section padding="none"}
    
    <div class="mb-6 flex items-center justify-between">
        <div>
            {ikb_text tag="h1" size="2xl" weight="bold"}Reports{/ikb_text}
            {ikb_text color="muted"}Analytics and insights for guidance operations{/ikb_text}
        </div>
    </div>
    
    {!-- Date Range Filter --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 mb-6">
        <form id="reports-filter" class="flex flex-wrap items-end gap-4" hx-get="/api/reports/summary" hx-target="#reports-content" hx-trigger="submit">
            <div>
                <label class="block text-xs font-medium text-gray-500 mb-1">From</label>
                <input type="date" name="start_date" value="{start_date}" class="block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-indigo-500 focus:border-indigo-500" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-500 mb-1">To</label>
                <input type="date" name="end_date" value="{end_date}" class="block w-full rounded-lg border-gray-300 shadow-sm text-sm focus:ring-indigo-500 focus:border-indigo-500" />
            </div>
            <button type="submit" class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition">
                <i class="fas fa-filter mr-2"></i> Apply
            </button>
            <button type="button" onclick="document.querySelectorAll('#reports-filter input[type=date]').forEach(i=>i.value='');htmx.trigger('#reports-filter','submit')" class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-600 text-sm font-medium rounded-lg hover:bg-gray-200 transition">
                <i class="fas fa-times mr-1"></i> Clear
            </button>
            <div class="ml-auto flex gap-2">
                <a id="export-csv-link" href="{base_url}/api/reports/export?format=csv" target="_blank" class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg text-gray-700 bg-white hover:bg-gray-50 text-sm">
                    <i class="fas fa-file-csv mr-2 text-green-600"></i> CSV
                </a>
            </div>
        </form>
    </div>
    
    {!-- Reports Content (loaded dynamically via HTMX) --}
    <div id="reports-content" hx-get="/api/reports/summary" hx-trigger="load" hx-swap="innerHTML">
        <div class="flex items-center justify-center py-20 text-gray-400">
            <i class="fas fa-spinner fa-spin text-2xl mr-3"></i> Loading reports...
        </div>
    </div>
    
{/ikb_section}

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Update export link with current date filters
    var form = document.getElementById('reports-filter');
    if (form) {
        form.addEventListener('submit', function() {
            var sd = form.querySelector('[name=start_date]').value;
            var ed = form.querySelector('[name=end_date]').value;
            var link = document.getElementById('export-csv-link');
            if (link) {
                var base = '{base_url}/api/reports/export?format=csv';
                if (sd && ed) base += '&start_date=' + sd + '&end_date=' + ed;
                link.href = base;
            }
        });
    }
});
</script>

{/block}
