{extends "modules/guidance/layouts/app.disyl"}

{block content}
<div class="space-y-6" x-data="trackerDetail()">

    {!-- Header --}
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <a href="{base_url}/trackers" class="text-gray-400 hover:text-gray-600" hx-get="{base_url}/pages/trackers" hx-target="#main-content" hx-push-url="{base_url}/trackers">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h2 class="text-2xl font-bold text-gray-800">{tracker.name}</h2>
                    <div class="flex items-center gap-3 mt-1 text-sm text-gray-500">
                        {if tracker.academic_year}<span><i class="fas fa-calendar mr-1"></i>{tracker.academic_year}</span>{/if}
                        {if tracker.college_name}<span><i class="fas fa-university mr-1"></i>{tracker.college_code} - {tracker.college_name}</span>{/if}
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium {if tracker.is_active}bg-green-100 text-green-800{else}bg-gray-100 text-gray-600{/if}">
                            {if tracker.is_active}Active{else}Inactive{/if}
                        </span>
                    </div>
                </div>
            </div>
            {if tracker.description}<p class="text-sm text-gray-500 mt-2 ml-8">{tracker.description}</p>{/if}
        </div>
        <div class="flex items-center gap-2">
            <a href="{base_url}/api/trackers/{tracker.id}/export" class="inline-flex items-center px-3 py-2 text-sm font-medium text-gray-600 bg-white border rounded-lg hover:bg-gray-50 transition">
                <i class="fas fa-download mr-2"></i> Export CSV
            </a>
            {if user.role == 'admin' or user.role == 'supervisor'}
            <button @click="showImport = true" class="inline-flex items-center px-3 py-2 text-sm font-medium text-white bg-emerald-600 rounded-lg hover:bg-emerald-700 transition">
                <i class="fas fa-file-csv mr-2"></i> Import CSV
            </button>
            {/if}
        </div>
    </div>

    {!-- Stats Bar --}
    <div id="tracker-stats" hx-get="{base_url}/api/trackers/{tracker.id}/students?stats_only=1" hx-trigger="load, refreshStudents from:body" hx-swap="innerHTML">
    </div>

    {!-- Tabs --}
    <div class="border-b border-gray-200">
        <nav class="flex gap-6" aria-label="Tabs">
            <button @click="tab = 'students'" :class="tab === 'students' ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-gray-500 hover:text-gray-700'" class="pb-3 px-1 border-b-2 font-medium text-sm transition">
                <i class="fas fa-users mr-1"></i> Students
            </button>
            <button @click="tab = 'items'" :class="tab === 'items' ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-gray-500 hover:text-gray-700'" class="pb-3 px-1 border-b-2 font-medium text-sm transition">
                <i class="fas fa-list-check mr-1"></i> Required Documents
            </button>
        </nav>
    </div>

    {!-- Students Tab --}
    <div x-show="tab === 'students'" x-cloak>
        {!-- Student Filters --}
        <div class="flex flex-wrap gap-3 mb-4">
            <div class="relative flex-1 min-w-[200px] max-w-md">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" placeholder="Search students..." name="search"
                       class="w-full pl-9 pr-4 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                       hx-get="{base_url}/api/trackers/{tracker.id}/students" hx-trigger="keyup changed delay:300ms" hx-target="#students-table" hx-include="[name='college_filter']">
            </div>
            <select name="college_filter" class="px-3 py-2 text-sm border border-gray-200 rounded-lg"
                    hx-get="{base_url}/api/trackers/{tracker.id}/students" hx-trigger="change" hx-target="#students-table" hx-include="[name='search']">
                <option value="">All Colleges</option>
                {foreach colleges as col}
                <option value="{col.id}">{col.code} - {col.name}</option>
                {/foreach}
            </select>
            <button @click="showAddStudent = true" class="inline-flex items-center px-3 py-2 text-sm font-medium text-indigo-600 bg-indigo-50 rounded-lg hover:bg-indigo-100 transition">
                <i class="fas fa-user-plus mr-1"></i> Add Student
            </button>
        </div>

        {!-- Students Table --}
        <div id="students-table" hx-get="{base_url}/api/trackers/{tracker.id}/students" hx-trigger="load, refreshStudents from:body" hx-swap="innerHTML">
            <div class="flex items-center justify-center py-12">
                <div class="animate-spin rounded-full h-8 w-8 border-2 border-gray-300 border-t-indigo-600"></div>
            </div>
        </div>
    </div>

    {!-- Items Tab --}
    <div x-show="tab === 'items'" x-cloak>
        <div class="mb-4">
            {if user.role == 'admin' or user.role == 'supervisor'}
            <form hx-post="{base_url}/api/trackers/{tracker.id}/items" hx-swap="none" class="flex gap-3" x-data="{ itemName: '' }">
                <input type="text" name="name" x-model="itemName" placeholder="Add required document (e.g., Form 137)" required
                       class="flex-1 px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                <input type="date" name="deadline" class="px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500">
                <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition" :disabled="!itemName.trim()">
                    <i class="fas fa-plus mr-1"></i> Add
                </button>
            </form>
            {/if}
        </div>
        <div id="items-list" hx-get="{base_url}/api/trackers/{tracker.id}/items" hx-trigger="load, refreshItems from:body" hx-swap="innerHTML">
            <div class="flex items-center justify-center py-12">
                <div class="animate-spin rounded-full h-8 w-8 border-2 border-gray-300 border-t-indigo-600"></div>
            </div>
        </div>
    </div>

    {!-- Add Student Modal --}
    <div x-show="showAddStudent" x-cloak class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
        <div class="flex items-center justify-center min-h-screen px-4">
            <div class="fixed inset-0 bg-black bg-opacity-50" @click="showAddStudent = false"></div>
            <div class="relative bg-white rounded-xl shadow-xl max-w-lg w-full" @click.away="showAddStudent = false">
                <div class="flex items-center justify-between p-5 border-b">
                    <h3 class="text-lg font-semibold">Add Student</h3>
                    <button @click="showAddStudent = false" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times"></i></button>
                </div>
                <form hx-post="{base_url}/api/trackers/{tracker.id}/students" hx-swap="none" @htmx:after-request="if(event.detail.successful) showAddStudent = false" class="p-5 space-y-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-1">Student Name *</label>
                            <input type="text" name="student_name" required placeholder="Full name"
                                   class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Student ID</label>
                            <input type="text" name="student_id" placeholder="School ID number"
                                   class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">College</label>
                            <select name="college_id" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                                <option value="">Select college...</option>
                                {foreach colleges as col}
                                <option value="{col.id}">{col.code} - {col.name}</option>
                                {/foreach}
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Year Level</label>
                            <select name="year_level" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                                <option value="">Select...</option>
                                <option value="1st Year">1st Year</option>
                                <option value="2nd Year">2nd Year</option>
                                <option value="3rd Year">3rd Year</option>
                                <option value="4th Year">4th Year</option>
                                <option value="5th Year">5th Year</option>
                                <option value="Graduate">Graduate</option>
                                <option value="SHS-11">SHS Grade 11</option>
                                <option value="SHS-12">SHS Grade 12</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Section</label>
                            <input type="text" name="section" placeholder="e.g., A"
                                   class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                            <input type="email" name="email" placeholder="student@email.com"
                                   class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
                            <input type="text" name="phone" placeholder="09xx-xxx-xxxx"
                                   class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        </div>
                    </div>
                    <div class="flex justify-end gap-3 pt-2">
                        <button type="button" @click="showAddStudent = false" class="px-4 py-2 text-sm text-gray-600 hover:bg-gray-100 rounded-lg transition">Cancel</button>
                        <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition">
                            <i class="fas fa-check mr-1"></i> Add Student
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {!-- CSV Import Modal --}
    <div x-show="showImport" x-cloak class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
        <div class="flex items-center justify-center min-h-screen px-4">
            <div class="fixed inset-0 bg-black bg-opacity-50" @click="showImport = false"></div>
            <div class="relative bg-white rounded-xl shadow-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto" @click.away="showImport = false">
                <div class="flex items-center justify-between p-5 border-b sticky top-0 bg-white z-10">
                    <h3 class="text-lg font-semibold"><i class="fas fa-file-csv mr-2 text-emerald-600"></i>Import from CSV</h3>
                    <button @click="showImport = false" class="text-gray-400 hover:text-gray-600"><i class="fas fa-times"></i></button>
                </div>
                <div class="p-5" id="import-container">
                    {!-- Step 1: Upload --}
                    <div x-show="!importMapping">
                        <div class="border-2 border-dashed border-gray-300 rounded-xl p-8 text-center hover:border-indigo-400 transition"
                             x-data="csvUploader()" @dragover.prevent="dragging = true" @dragleave="dragging = false" @drop.prevent="handleDrop($event)"
                             :class="dragging ? 'border-indigo-500 bg-indigo-50' : ''">
                            <i class="fas fa-cloud-upload-alt text-4xl text-gray-300 mb-3"></i>
                            <p class="text-gray-600 font-medium">Drag & drop your CSV file here</p>
                            <p class="text-sm text-gray-400 mt-1">or click to browse</p>
                            <input type="file" accept=".csv,.txt" class="hidden" id="csv-file-input" @change="handleFile($event)">
                            <button type="button" @click="document.getElementById('csv-file-input').click()" class="mt-4 px-4 py-2 text-sm font-medium text-indigo-600 bg-indigo-50 rounded-lg hover:bg-indigo-100 transition">
                                <i class="fas fa-folder-open mr-1"></i> Browse Files
                            </button>
                            <div x-show="uploading" class="mt-4">
                                <div class="animate-spin rounded-full h-6 w-6 border-2 border-gray-300 border-t-indigo-600 mx-auto"></div>
                                <p class="text-sm text-gray-500 mt-2">Analyzing CSV...</p>
                            </div>
                        </div>
                        <div class="mt-4 flex items-start gap-3 p-3 bg-blue-50 rounded-lg text-sm text-blue-700">
                            <i class="fas fa-info-circle mt-0.5"></i>
                            <div>
                                <strong>Tip:</strong> Your CSV should have a header row. Columns will be auto-matched to database fields. 
                                Unrecognized columns can be mapped manually or created as new custom fields.
                                <div class="mt-2">
                                    <a href="{base_url}/api/trackers/{tracker.id}/import/template" class="inline-flex items-center text-indigo-600 hover:text-indigo-800 font-medium">
                                        <i class="fas fa-file-download mr-1"></i> Download CSV Template
                                    </a>
                                    <span class="text-blue-500 ml-1">— pre-formatted with correct headers, import instructions, and your current college list</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    {!-- Step 2: Mapping (loaded via HTMX) --}
                    <div id="import-mapping-area"></div>
                    {!-- Step 3: Results (loaded via HTMX) --}
                    <div id="import-result-area"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function trackerDetail() {
    return {
        tab: 'students',
        showAddStudent: false,
        showImport: false,
        importMapping: false,
    };
}

function csvUploader() {
    return {
        dragging: false,
        uploading: false,
        handleDrop(e) {
            this.dragging = false;
            const file = e.dataTransfer.files[0];
            if (file) this.uploadFile(file);
        },
        handleFile(e) {
            const file = e.target.files[0];
            if (file) this.uploadFile(file);
        },
        uploadFile(file) {
            this.uploading = true;
            const formData = new FormData();
            formData.append('csv_file', file);
            
            fetch('/api/trackers/{tracker.id}/import/preview', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-CSRF-Token': APP_CSRF,
                    'HX-Request': 'true'
                }
            })
            .then(r => r.text())
            .then(html => {
                this.uploading = false;
                document.getElementById('import-mapping-area').innerHTML = html;
                this.$root.__x.$data.importMapping = true;
            })
            .catch(err => {
                this.uploading = false;
                alert('Upload failed: ' + err.message);
            });
        }
    };
}
</script>
{/block}
