{!-- Reset Password Page - No layout extends (guest view) --}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - Guidance Monitoring System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/assets/guidance/css/app.css">
    <script>
        var APP_BASE = '{base_url}';
        var RESET_PASSWORD_ENDPOINT = '{reset_password_endpoint}';
        var LOGIN_PAGE_URL = '{login_page_url}';
        var TOKEN_VALID = '{token_valid}' === '1';
    </script>
</head>
<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-indigo-500 to-purple-600 py-12 px-4">
    
    <div class="max-w-md w-full">
        {!-- Logo & Title --}
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-20 h-20 bg-white rounded-full shadow-lg mb-4">
                <i class="fas fa-heart-pulse text-indigo-600 text-3xl"></i>
            </div>
            <h1 class="text-3xl font-bold text-white">Guidance</h1>
            <p class="text-indigo-200 mt-2">Monitoring System</p>
        </div>
        
        {!-- Reset Password Card --}
        <div class="bg-white rounded-2xl shadow-xl p-8">
            <h2 class="text-2xl font-bold text-gray-800 text-center mb-2">Reset Password</h2>
            <p class="text-gray-500 text-center text-sm mb-6">
                {if token_valid}
                Enter your new password below.
                {else}
                This reset link is invalid or expired. Request a new one to continue.
                {/if}
            </p>
            
            {!-- Messages --}
            <div id="reset-error" class="hidden mb-4 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 rounded text-sm">
                <i class="fas fa-exclamation-circle mr-2"></i>
                <span id="error-message"></span>
            </div>
            <div id="reset-success" class="hidden mb-4 p-4 bg-green-50 border-l-4 border-green-500 text-green-700 rounded text-sm">
                <i class="fas fa-check-circle mr-2"></i>
                <span id="success-message"></span>
            </div>
            
            {if token_valid}
            {!-- Form --}
            <form id="reset-form" class="space-y-5">
                <input type="hidden" name="token" value="{reset_token | esc_html}">
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">New Password</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                            <i class="fas fa-lock"></i>
                        </span>
                        <input type="password" name="password" required minlength="8" id="new-password"
                               class="w-full pl-10 pr-10 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                               placeholder="Minimum 8 characters">
                        <button type="button" onclick="togglePw('new-password', this)" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Confirm Password</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                            <i class="fas fa-lock"></i>
                        </span>
                        <input type="password" name="confirm_password" required minlength="8" id="confirm-password"
                               class="w-full pl-10 pr-10 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                               placeholder="Repeat password">
                        <button type="button" onclick="togglePw('confirm-password', this)" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>
                
                <button type="submit" id="submit-btn"
                        class="w-full py-3 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 transition flex items-center justify-center">
                    <i class="fas fa-key mr-2"></i> Reset Password
                </button>
            </form>
            {else}
            <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
                Password reset links expire after 60 minutes. Use the forgot-password page to generate a fresh link.
            </div>
            {/if}
            
            <div class="mt-6 text-center">
                <a href="{login_page_url}" class="text-sm text-indigo-600 hover:underline">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Login
                </a>
            </div>
        </div>
        
        <p class="text-center text-indigo-200 text-sm mt-6">
            Powered by <strong>DiSyL</strong> + <strong>Ikabud CMS</strong>
        </p>
    </div>
    
    <script>
    function togglePw(id, btn) {
        var input = document.getElementById(id);
        var icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    }
    
    var resetForm = document.getElementById('reset-form');
    if (!resetForm) {
        return;
    }

    resetForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        var btn = document.getElementById('submit-btn');
        var errorDiv = document.getElementById('reset-error');
        var successDiv = document.getElementById('reset-success');
        
        var pw = document.getElementById('new-password').value;
        var confirm = document.getElementById('confirm-password').value;
        if (pw !== confirm) {
            errorDiv.classList.remove('hidden');
            document.getElementById('error-message').textContent = 'Passwords do not match';
            return;
        }
        
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Resetting...';
        errorDiv.classList.add('hidden');
        successDiv.classList.add('hidden');
        
        try {
            var resp = await fetch(RESET_PASSWORD_ENDPOINT, {
                method: 'POST',
                body: new FormData(this)
            });
            var data = await resp.json();
            
            if (data.ok || data.success) {
                successDiv.classList.remove('hidden');
                document.getElementById('success-message').textContent = data.message;
                this.reset();
                setTimeout(function() { window.location.href = data.redirect || LOGIN_PAGE_URL; }, 2000);
            } else {
                errorDiv.classList.remove('hidden');
                document.getElementById('error-message').textContent = data.error || 'Something went wrong';
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-key mr-2"></i> Reset Password';
            }
        } catch (err) {
            errorDiv.classList.remove('hidden');
            document.getElementById('error-message').textContent = 'Connection error. Please try again.';
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-key mr-2"></i> Reset Password';
        }
    });
    </script>
</body>
</html>
