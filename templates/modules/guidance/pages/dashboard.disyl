{extends "modules/guidance/layouts/app.disyl"}

{block content}
{!-- Dashboard Page - Guidance Monitoring System --}

{ikb_section padding="none"}
    
    {!-- Welcome Header --}
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">
                Good {if hour >= 17}evening{elseif hour >= 12}afternoon{else}morning{/if}, {user_name}
            </h1>
            <p class="text-sm text-gray-500 mt-1">
                <i class="far fa-calendar-alt mr-1"></i> {today_date}
                <span class="ml-3 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium
                    {if user_role == 'admin'}bg-purple-100 text-purple-700
                    {elseif user_role == 'supervisor'}bg-blue-100 text-blue-700
                    {else}bg-green-100 text-green-700{/if}">
                    {user_role | title}
                </span>
            </p>
        </div>
        <div class="flex gap-2">
            <button hx-get="/pages/cases/new" hx-target="#modal-container" hx-swap="innerHTML"
                    class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition shadow-sm">
                <i class="fas fa-plus mr-2"></i> New Case
            </button>
            <button hx-get="/pages/appointments/new" hx-target="#modal-container" hx-swap="innerHTML"
                    class="inline-flex items-center px-4 py-2 bg-white text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition border border-gray-300 shadow-sm">
                <i class="fas fa-calendar-plus mr-2"></i> Appointment
            </button>
        </div>
    </div>
    
    {!-- Stats Cards with auto-refresh every 30 seconds --}
    <div id="stats-container" 
         hx-get="/admin/guidance/api/dashboard/stats" 
         hx-trigger="load, every 30s" 
         hx-swap="innerHTML">
        <div class="flex items-center justify-center py-12 text-gray-400">
            <i class="fas fa-spinner fa-spin text-xl mr-3"></i> Loading dashboard...
        </div>
    </div>
    
    {!-- Main Content Grid --}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
        
        {!-- Recent Cases (2 columns) --}
        <div class="lg:col-span-2">
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="p-4 border-b border-gray-100 flex items-center justify-between">
                    <h2 class="text-base font-semibold text-gray-900">
                        <i class="fas fa-clock text-indigo-500 mr-2"></i>Recent Cases
                    </h2>
                    <a href="{base_url}/cases" 
                       hx-get="/pages/cases" hx-target="#main-content" hx-push-url="{base_url}/cases"
                       class="text-sm text-indigo-600 hover:text-indigo-800 font-medium">
                        View All <i class="fas fa-arrow-right ml-1"></i>
                    </a>
                </div>
                
                <div id="recent-cases" 
                     hx-get="/admin/guidance/api/cases/recent" 
                     hx-trigger="load" 
                     hx-swap="innerHTML"
                     class="divide-y divide-gray-50">
                    <div class="p-8 text-center text-gray-400">
                        <i class="fas fa-spinner fa-spin text-lg mr-2"></i> Loading cases...
                    </div>
                </div>
            </div>
        </div>
        
        {!-- Right Column --}
        <div class="space-y-4">
            {!-- Pending Approvals Widget --}
            <div id="pending-approvals-widget"
                 hx-get="/admin/guidance/api/appointments/pending" 
                 hx-trigger="load, approvalChanged from:body"
                 hx-swap="innerHTML"
                 class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="p-6 text-center text-gray-400">
                    <i class="fas fa-spinner fa-spin text-lg mr-2"></i> Loading approvals...
                </div>
            </div>
        </div>
    </div>
{/ikb_section}
{/block}
