{extends "modules/guidance/layouts/app.disyl"}

{block content}
{!-- Dashboard Page - Guidance Monitoring System --}

{ikb_section padding="none"}
    
    {!-- Welcome Header --}
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">
                Good {if hour >= 17}evening{elseif hour >= 12}afternoon{else}morning{/if}, {user_name}
            </h1>
            <p class="text-sm text-gray-500 mt-1">
                <i class="far fa-calendar-alt mr-1"></i> {today_date}
                <span class="ml-3 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium
                    {if user_role == 'admin'}bg-purple-100 text-purple-700
                    {elseif user_role == 'supervisor'}bg-blue-100 text-blue-700
                    {else}bg-green-100 text-green-700{/if}">
                    {user_role | title}
                </span>
            </p>
        </div>
        <div class="flex gap-2">
            <button hx-get="/pages/cases/new" hx-target="#modal-container" hx-swap="innerHTML"
                    class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition shadow-sm">
                <i class="fas fa-plus mr-2"></i> New Case
            </button>
            <button hx-get="/pages/appointments/new" hx-target="#modal-container" hx-swap="innerHTML"
                    class="inline-flex items-center px-4 py-2 bg-white text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition border border-gray-300 shadow-sm">
                <i class="fas fa-calendar-plus mr-2"></i> Appointment
            </button>
        </div>
    </div>
    
    {!-- Stats Cards with auto-refresh every 30 seconds --}
    <div id="stats-container" 
         hx-get="/api/dashboard/stats" 
         hx-trigger="load, every 30s" 
         hx-swap="innerHTML">
        <div class="flex items-center justify-center py-12 text-gray-400">
            <i class="fas fa-spinner fa-spin text-xl mr-3"></i> Loading dashboard...
        </div>
    </div>
    
    {!-- Main Content Grid --}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
        
        {!-- Recent Cases (2 columns) --}
        <div class="lg:col-span-2">
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="p-4 border-b border-gray-100 flex items-center justify-between">
                    <h2 class="text-base font-semibold text-gray-900">
                        <i class="fas fa-clock text-indigo-500 mr-2"></i>Recent Cases
                    </h2>
                    <a href="{base_url}/cases" 
                       hx-get="/pages/cases" hx-target="#main-content" hx-push-url="{base_url}/cases"
                       class="text-sm text-indigo-600 hover:text-indigo-800 font-medium">
                        View All <i class="fas fa-arrow-right ml-1"></i>
                    </a>
                </div>
                
                <div id="recent-cases" 
                     hx-get="/api/cases/recent" 
                     hx-trigger="load" 
                     hx-swap="innerHTML"
                     class="divide-y divide-gray-50">
                    <div class="p-8 text-center text-gray-400">
                        <i class="fas fa-spinner fa-spin text-lg mr-2"></i> Loading cases...
                    </div>
                </div>
            </div>
        </div>
        
        {!-- Right Column --}
        <div class="space-y-4">
            {!-- Pending Approvals Widget --}
            <div id="pending-approvals-widget"
                 hx-get="/api/appointments/pending" 
                 hx-trigger="load, approvalChanged from:body"
                 hx-swap="innerHTML">
            </div>
            
            {!-- Today's Schedule --}
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="p-4 border-b border-gray-100 flex items-center justify-between">
                    <h2 class="text-base font-semibold text-gray-900">
                        <i class="fas fa-calendar-day text-green-500 mr-2"></i>Today's Schedule
                    </h2>
                </div>
                
                <div id="today-schedule" 
                     hx-get="/api/appointments/today" 
                     hx-trigger="load" 
                     hx-swap="innerHTML"
                     class="p-4">
                    <div class="text-center text-gray-400 py-4">
                        <i class="fas fa-spinner fa-spin"></i>
                    </div>
                </div>
            </div>
            
            {!-- Quick Actions --}
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
                <h2 class="text-base font-semibold text-gray-900 mb-3">
                    <i class="fas fa-bolt text-amber-500 mr-2"></i>Quick Actions
                </h2>
                <div class="grid grid-cols-2 gap-2">
                    <button hx-get="/pages/cases/new" hx-target="#modal-container" hx-swap="innerHTML"
                            class="flex flex-col items-center p-3 rounded-lg bg-indigo-50 hover:bg-indigo-100 transition text-center">
                        <i class="fas fa-plus-circle text-indigo-600 text-lg mb-1"></i>
                        <span class="text-xs font-medium text-indigo-700">New Case</span>
                    </button>
                    <button hx-get="/pages/appointments/new" hx-target="#modal-container" hx-swap="innerHTML"
                            class="flex flex-col items-center p-3 rounded-lg bg-green-50 hover:bg-green-100 transition text-center">
                        <i class="fas fa-calendar-plus text-green-600 text-lg mb-1"></i>
                        <span class="text-xs font-medium text-green-700">Appointment</span>
                    </button>
                    <a href="{base_url}/trackers" hx-get="/pages/trackers" hx-target="#main-content" hx-push-url="{base_url}/trackers"
                       class="flex flex-col items-center p-3 rounded-lg bg-purple-50 hover:bg-purple-100 transition text-center">
                        <i class="fas fa-clipboard-list text-purple-600 text-lg mb-1"></i>
                        <span class="text-xs font-medium text-purple-700">Trackers</span>
                    </a>
                    <a href="{base_url}/reports" hx-get="/pages/reports" hx-target="#main-content" hx-push-url="{base_url}/reports"
                       class="flex flex-col items-center p-3 rounded-lg bg-blue-50 hover:bg-blue-100 transition text-center">
                        <i class="fas fa-chart-bar text-blue-600 text-lg mb-1"></i>
                        <span class="text-xs font-medium text-blue-700">Reports</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
    
{/ikb_section}

{/block}

{block scripts}
<script>
    // Handle case click for detail view
    document.body.addEventListener('click', function(e) {
        const caseRow = e.target.closest('[data-case-id]');
        if (caseRow) {
            const caseId = caseRow.dataset.caseId;
            if (caseId && caseId !== '') {
                htmx.ajax('GET', guidanceAppPath('/pages/cases/' + caseId), {target: '#main-content', swap: 'innerHTML'});
                history.pushState({}, '', guidanceAppPath('/cases/' + caseId));
            }
        }
    });
    
    // Refresh pending approvals widget after approve/reject
    document.body.addEventListener('htmx:afterRequest', function(e) {
        var trigger = e.detail.elt;
        if (trigger && (trigger.getAttribute('hx-post') || '').match(/\/(approve|reject)$/)) {
            htmx.trigger(document.body, 'approvalChanged');
            // Also refresh stats
            var statsEl = document.getElementById('stats-container');
            if (statsEl) htmx.trigger(statsEl, 'load');
        }
    });
</script>
{/block}
