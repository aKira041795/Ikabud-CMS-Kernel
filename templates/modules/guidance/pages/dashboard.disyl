{extends "modules/guidance/layouts/app.disyl"}

{block content}
{!-- Dashboard Page - Guidance Counseling System --}

{ikb_section padding="none"}
    
    {!-- Welcome Header --}
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">
                Welcome back, {user_name}!
            </h1>
            <p class="text-sm text-gray-500 mt-1">Here's what's happening today.</p>
        </div>
        <div class="flex gap-2">
            <button hx-get="{base_url}/pages/cases/new" hx-target="#modal-container" hx-swap="innerHTML"
                    class="inline-flex items-center px-4 py-2 bg-teal-700 text-white text-sm font-medium rounded-lg hover:bg-teal-800 transition shadow-sm">
                <i class="fas fa-plus mr-2"></i> New Student
            </button>
            <button hx-get="{base_url}/pages/appointments/new" hx-target="#modal-container" hx-swap="innerHTML"
                    class="inline-flex items-center px-4 py-2 bg-white text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition border border-gray-300 shadow-sm">
                <i class="fas fa-calendar-plus mr-2"></i> New Session
            </button>
        </div>
    </div>
    
    {!-- Stats Cards with auto-refresh every 30 seconds --}
    <div id="stats-container" 
         hx-get="{base_url}/api/dashboard/stats" 
         hx-trigger="load, every 30s" 
         hx-swap="innerHTML">
        <div class="flex items-center justify-center py-12 text-gray-400">
            <i class="fas fa-spinner fa-spin text-xl mr-3"></i> Loading dashboard...
        </div>
    </div>
    
    {!-- Recent Counseling Sessions (full width) --}
    <div class="mt-6">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="p-4 border-b border-gray-100 flex items-center justify-between">
                <h2 class="text-base font-semibold text-gray-900">
                    Recent Counseling Sessions
                </h2>
                <a href="{base_url}/cases"
                   hx-get="{base_url}/pages/cases" hx-target="#main-content" hx-push-url="{base_url}/cases"
                   class="text-sm text-teal-600 hover:text-teal-800 font-medium">
                    View all sessions <i class="fas fa-arrow-right ml-1"></i>
                </a>
            </div>

            <div id="recent-cases"
                 hx-get="{base_url}/api/cases/recent"
                 hx-trigger="load, refreshCases from:body"
                 hx-swap="innerHTML">
                <div class="p-8 text-center text-gray-400">
                    <i class="fas fa-spinner fa-spin text-lg mr-2"></i> Loading...
                </div>
            </div>
        </div>
    </div>

    {!-- Inline Case Detail Panel --}
    <div id="case-detail-panel" class="mt-6"></div>
    
{/ikb_section}

{/block}

{block scripts}
<script>
    function reloadCaseDetailPanel(caseId, options) {
        if (!caseId) return;

        var target = document.getElementById('case-detail-panel');
        if (!target) return;

        var url = guidanceAppPath('/api/cases/' + caseId + '/panel');
        var params = new URLSearchParams();
        if (options && options.pane) params.set('pane', options.pane);
        if (options && options.noteId) params.set('note_id', options.noteId);
        var qs = params.toString();
        if (qs) url += '?' + qs;

        htmx.ajax('GET', url, {
            target: '#case-detail-panel',
            swap: 'innerHTML'
        });

        if (!options || options.scroll !== false) {
            target.scrollIntoView({behavior: 'smooth', block: 'start'});
        }
    }

    // Load case detail panel inline below the table
    document.body.addEventListener('click', function(e) {
        var caseRow = e.target.closest('[data-case-id]');
        if (caseRow) {
            var caseId = caseRow.dataset.caseId;
            if (caseId) {
                reloadCaseDetailPanel(caseId, {pane: 'overview'});
            }
        }
    });

    document.body.addEventListener('refreshCasePanel', function(e) {
        var currentPanel = document.querySelector('#case-detail-panel [data-panel-case-id]');
        var currentCaseId = currentPanel ? currentPanel.dataset.panelCaseId : null;
        var detail = e.detail || {};
        if (!currentCaseId || String(currentCaseId) !== String(detail.caseId || '')) {
            return;
        }

        reloadCaseDetailPanel(detail.caseId, {
            pane: detail.pane || 'overview',
            noteId: detail.noteId || '',
            scroll: false,
        });

        var statsEl = document.getElementById('stats-container');
        if (statsEl) htmx.trigger(statsEl, 'load');
    });
</script>
{/block}
