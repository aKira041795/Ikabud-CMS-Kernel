{extends "modules/guidance/layouts/app.disyl"}

{block content}
{!-- Tracker View Page --}

{ikb_section padding="none"}

<div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4 mb-6">
    <div>
        <div class="flex items-center gap-2">
            <a href="{base_url}/trackers" class="text-sm text-indigo-600 hover:text-indigo-800 font-medium"
               hx-get="/admin/guidance/pages/trackers" hx-target="#main-content" hx-push-url="{base_url}/trackers">
                <i class="fas fa-arrow-left mr-1"></i> Back
            </a>
        </div>
        <h1 class="text-2xl font-bold text-gray-900 mt-2">{tracker.name}</h1>
        <div class="mt-1 text-sm text-gray-500">{tracker.description | default:'—'}</div>
        <div class="mt-2 text-xs text-gray-400">
            {if tracker.academic_year}<span class="mr-3"><i class="fas fa-graduation-cap mr-1"></i>{tracker.academic_year}</span>{/if}
            {if tracker.college_name}<span class="mr-3"><i class="fas fa-building-columns mr-1"></i>{tracker.college_name}</span>{/if}
            {if tracker.is_active}<span class="px-2 py-1 rounded-full text-[11px] font-semibold bg-green-100 text-green-700">Active</span>{else}<span class="px-2 py-1 rounded-full text-[11px] font-semibold bg-gray-100 text-gray-700">Inactive</span>{/if}
        </div>
    </div>

    <div class="flex items-center gap-2">
        {if user_role != 'counselor'}
        <button hx-get="/admin/guidance/pages/trackers/{tracker.id}/edit" hx-target="#modal-container" hx-swap="innerHTML"
                class="inline-flex items-center px-3 py-2 bg-white border border-gray-200 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50">
            <i class="fas fa-pen mr-2"></i> Edit Tracker
        </button>
        {/if}
        <button hx-get="/admin/guidance/pages/trackers/{tracker.id}/students/new" hx-target="#modal-container" hx-swap="innerHTML"
                class="inline-flex items-center px-3 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 shadow-sm">
            <i class="fas fa-user-plus mr-2"></i> Add Student
        </button>
        {if user_role != 'counselor'}
        <button hx-get="/admin/guidance/pages/trackers/{tracker.id}/items/new" hx-target="#modal-container" hx-swap="innerHTML"
                class="inline-flex items-center px-3 py-2 bg-indigo-50 text-indigo-700 text-sm font-medium rounded-lg hover:bg-indigo-100">
            <i class="fas fa-list-check mr-2"></i> Add Item
        </button>
        {/if}
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <div class="lg:col-span-1 space-y-6">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-5 py-4 border-b flex items-center justify-between">
                <div class="text-sm font-semibold text-gray-800">Items</div>
                <div class="text-xs text-gray-400">{items | count} total</div>
            </div>
            <div id="tracker-items" class="divide-y divide-gray-100">
                {if items | count > 0}
                {foreach items as it}
                <div class="px-5 py-3 flex items-start justify-between gap-3">
                    <div class="min-w-0">
                        <div class="text-sm font-semibold text-gray-900 truncate">{it.name}</div>
                        <div class="text-xs text-gray-500 mt-0.5 line-clamp-2">{it.description | default:'—'}</div>
                        {if it.deadline}
                        <div class="text-xs text-gray-400 mt-1"><i class="fas fa-calendar mr-1"></i>Deadline: {it.deadline}</div>
                        {/if}
                    </div>
                    {if user_role != 'counselor'}
                    <div class="flex items-center gap-1 flex-shrink-0">
                        <button hx-get="/admin/guidance/pages/trackers/{tracker.id}/items/{it.id}/edit" hx-target="#modal-container" hx-swap="innerHTML"
                                class="p-2 text-gray-400 hover:text-gray-700 hover:bg-gray-100 rounded-lg" title="Edit">
                            <i class="fas fa-pen text-xs"></i>
                        </button>
                        <button hx-delete="/admin/guidance/api/trackers/{tracker.id}/items/{it.id}" hx-confirm="Delete this item?" hx-swap="none"
                                class="p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg" title="Delete">
                            <i class="fas fa-trash text-xs"></i>
                        </button>
                    </div>
                    {/if}
                </div>
                {/foreach}
                {else}
                <div class="p-6 text-sm text-gray-500">No items yet.</div>
                {/if}
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-5 py-4 border-b flex items-center justify-between">
                <div class="text-sm font-semibold text-gray-800">Students</div>
                <div class="text-xs text-gray-400">{students | count} total</div>
            </div>
            <div class="divide-y divide-gray-100">
                {if students | count > 0}
                {foreach students as s}
                <button class="w-full text-left px-5 py-3 hover:bg-gray-50 transition"
                        hx-get="/admin/guidance/pages/trackers/{tracker.id}/students/{s.id}" hx-target="#modal-container" hx-swap="innerHTML">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <div class="text-sm font-semibold text-gray-900 truncate">{s.student_name}</div>
                            <div class="text-xs text-gray-500 mt-0.5">
                                {if s.student_id}<span class="mr-2"><i class="fas fa-id-card mr-1"></i>{s.student_id}</span>{/if}
                                {if s.year_level}<span class="mr-2"><i class="fas fa-layer-group mr-1"></i>{s.year_level}</span>{/if}
                                {if s.section}<span class="mr-2"><i class="fas fa-users mr-1"></i>{s.section}</span>{/if}
                            </div>
                        </div>
                        <div class="text-xs text-gray-400 flex-shrink-0">
                            <i class="fas fa-chevron-right"></i>
                        </div>
                    </div>
                </button>
                {/foreach}
                {else}
                <div class="p-6 text-sm text-gray-500">No students yet.</div>
                {/if}
            </div>
        </div>
    </div>

    <div class="lg:col-span-2">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-5 py-4 border-b flex items-center justify-between">
                <div class="text-sm font-semibold text-gray-800">Submission Matrix</div>
                <div class="text-xs text-gray-500">Manage statuses per student and item</div>
            </div>

            <div class="overflow-x-auto">
                {if items | count > 0 && students | count > 0}
                <table class="min-w-full text-sm">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600">Student</th>
                            {foreach items as it}
                            <th class="text-left px-4 py-3 text-xs font-semibold text-gray-600">{it.name}</th>
                            {/foreach}
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {foreach students as s}
                        <tr>
                            <td class="px-4 py-3 whitespace-nowrap">
                                <div class="font-semibold text-gray-900">{s.student_name}</div>
                                <div class="text-xs text-gray-500">{s.student_id | default:''}</div>
                            </td>
                            {foreach items as it}
                            <td class="px-4 py-3">
                                <select name="sub_{s.id}_{it.id}"
                                        class="w-full px-2 py-1.5 border border-gray-200 rounded-lg text-xs focus:ring-2 focus:ring-indigo-500"
                                        hx-post="/admin/guidance/api/trackers/{tracker.id}/students/{s.id}/submissions"
                                        hx-trigger="change"
                                        hx-swap="none"
                                        hx-vals='{"tracker_item_id":{it.id}}'>
                                    <option value="pending" {if submissions[s.id][it.id] == 'pending'}selected{/if}>Pending</option>
                                    <option value="submitted" {if submissions[s.id][it.id] == 'submitted'}selected{/if}>Submitted</option>
                                    <option value="verified" {if submissions[s.id][it.id] == 'verified'}selected{/if}>Verified</option>
                                    <option value="rejected" {if submissions[s.id][it.id] == 'rejected'}selected{/if}>Rejected</option>
                                </select>
                            </td>
                            {/foreach}
                        </tr>
                        {/foreach}
                    </tbody>
                </table>
                {else}
                <div class="p-8 text-sm text-gray-500">Add items and students to start tracking submissions.</div>
                {/if}
            </div>
        </div>
    </div>

</div>

{/ikb_section}

{/block}
