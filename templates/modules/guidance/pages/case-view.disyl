{extends "modules/guidance/layouts/app.disyl"}

{block content}
<div x-data="{
    tab: 'overview',
    apptLoaded: false,
    sessionsLoaded: false,
    notesLoaded: false,
    docsLoaded: false,
    alertsLoaded: false,
    logLoaded: false
}">

{!-- === BREADCRUMB + ACTIONS === --}
<div class="mb-4 flex items-center justify-between flex-wrap gap-3">
    <nav class="flex items-center gap-2 text-sm text-gray-500">
          <a href="{base_url}/cases"
              hx-get="{base_url}/pages/cases" hx-target="#main-content" hx-push-url="{base_url}/cases"
           class="hover:text-teal-600 transition-colors">Students</a>
        <i class="fas fa-chevron-right text-xs text-gray-300"></i>
        <span class="font-medium text-gray-800">Student Profile</span>
    </nav>
    <div class="flex items-center gap-2">
          <a href="{base_url}/cases"
              hx-get="{base_url}/pages/cases" hx-target="#main-content" hx-push-url="{base_url}/cases"
           class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gray-200 text-sm text-gray-600 hover:bg-gray-50 transition-colors">
            <i class="fas fa-arrow-left text-xs"></i> Back to Students
        </a>
        {if case.status != 'closed'}
        <button hx-get="{base_url}/pages/cases/{case.id}/edit" hx-target="#modal-container"
                class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-gray-200 text-sm text-gray-600 hover:bg-gray-50 transition-colors">
            <i class="fas fa-edit text-xs"></i> Edit Student
        </button>
        {/if}
        <div class="relative" x-data="{moreOpen: false}">
            <button @click="moreOpen = !moreOpen"
                    class="w-9 h-9 rounded-lg border border-gray-200 flex items-center justify-center text-gray-500 hover:bg-gray-50 transition-colors">
                <i class="fas fa-ellipsis-v text-xs"></i>
            </button>
            <div x-show="moreOpen" @click.outside="moreOpen = false" x-cloak
                 class="absolute right-0 mt-1 w-48 bg-white rounded-xl shadow-lg border border-gray-100 py-1 z-50">
                {if case.status != 'closed'}
                <button hx-post="{base_url}/api/cases/{case.id}/close"
                        hx-confirm="Close this case?"
                        hx-swap="none"
                        @click="moreOpen = false"
                        class="w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 flex items-center gap-2">
                    <i class="fas fa-check-circle text-green-500 w-4 text-center"></i> Close Case
                </button>
                {else}
                <button hx-post="{base_url}/api/cases/{case.id}/reopen"
                        hx-swap="none"
                        @click="moreOpen = false"
                        class="w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-gray-50 flex items-center gap-2">
                    <i class="fas fa-rotate-left text-amber-500 w-4 text-center"></i> Reopen Case
                </button>
                {/if}
                {if can_delete_case}
                <button hx-delete="{base_url}/api/cases/{case.id}"
                        hx-confirm="Delete this case? This action cannot be undone."
                        hx-swap="none"
                        @click="moreOpen = false"
                        class="w-full text-left px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 flex items-center gap-2">
                    <i class="fas fa-trash w-4 text-center"></i> Delete Case
                </button>
                {/if}
            </div>
        </div>
    </div>
</div>

{!-- === STUDENT HEADER CARD === --}
<div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 mb-5">
    <div class="flex items-start gap-6 flex-wrap lg:flex-nowrap">

        {!-- Avatar --}
        <div class="w-24 h-24 rounded-full bg-indigo-100 flex items-center justify-center flex-shrink-0">
            <span class="text-3xl font-bold text-indigo-600">{case.student_name | first | upper}</span>
        </div>

        {!-- Main student info --}
        <div class="flex-1 min-w-0">
            <div class="flex items-center gap-3 flex-wrap mb-4">
                <h1 class="text-2xl font-bold text-gray-900">{case.student_name | esc_html}</h1>
                {if case.status == 'open' || case.status == 'in_progress'}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-700 uppercase tracking-wide">Active</span>
                {elseif case.status == 'on_hold'}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-700 uppercase tracking-wide">On Hold</span>
                {elseif case.status == 'closed'}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-500 uppercase tracking-wide">Closed</span>
                {else}
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-700 uppercase tracking-wide">{case.status | title}</span>
                {/if}
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-2 text-sm">
                <div class="flex gap-2 items-start">
                    <span class="text-gray-400 w-28 flex-shrink-0">Client Code</span>
                    <span class="font-medium text-gray-800">{case.case_number | esc_html | default:'—'}</span>
                </div>
                <div class="flex gap-2 items-start">
                    <span class="text-gray-400 w-28 flex-shrink-0">Course</span>
                    <span class="font-medium text-gray-800">{case.college_name | esc_html | default:'—'}</span>
                </div>
                <div class="flex gap-2 items-start">
                    <span class="text-gray-400 w-28 flex-shrink-0">Gender</span>
                    <span class="font-medium text-gray-800">{case.gender | title | esc_html | default:'—'}</span>
                </div>
                <div class="flex gap-2 items-start">
                    <span class="text-gray-400 w-28 flex-shrink-0">Year Level</span>
                    <span class="font-medium text-gray-800">{case.student_grade | esc_html | default:'—'}</span>
                </div>
                <div class="flex gap-2 items-start">
                    <span class="text-gray-400 w-28 flex-shrink-0">Date of Birth</span>
                    <span class="font-medium text-gray-800">
                        {case.date_of_birth | date:'F j, Y' | default:'—'}
                        {if age_str}<span class="text-gray-400 text-xs ml-1">{age_str}</span>{/if}
                    </span>
                </div>
                <div class="flex gap-2 items-start">
                    <span class="text-gray-400 w-28 flex-shrink-0">Section</span>
                    <span class="font-medium text-gray-800">{case.student_section | esc_html | default:'—'}</span>
                </div>
                <div class="flex gap-2 items-start">
                    <span class="text-gray-400 w-28 flex-shrink-0">Contact No.</span>
                    <span class="font-medium text-gray-800">{case.student_mobile | esc_html | default:'—'}</span>
                </div>
                <div class="flex gap-2 items-start">
                    <span class="text-gray-400 w-28 flex-shrink-0">Student ID</span>
                    <span class="font-medium text-gray-800">{case.student_id | esc_html | default:'—'}</span>
                </div>
                <div class="flex gap-2 items-start">
                    <span class="text-gray-400 w-28 flex-shrink-0">Email</span>
                    <span class="font-medium text-gray-800">{case.student_email | esc_html | default:'—'}</span>
                </div>
            </div>
        </div>

        {!-- Right status summary card --}
        <div class="w-full lg:w-56 flex-shrink-0 border border-gray-100 rounded-xl p-4 bg-gray-50/40 space-y-3 text-xs">
            <div class="flex items-center justify-between gap-2">
                <span class="text-gray-400">Overall Status</span>
                {if case.student_status == 'probationary'}
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-violet-100 text-violet-700">{case.student_status | upper}</span>
                {elseif case.student_status == 'regular'}
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-blue-100 text-blue-700">{case.student_status | upper}</span>
                {elseif case.student_status}
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-gray-100 text-gray-600">{case.student_status | upper}</span>
                {else}
                <span class="text-gray-400">—</span>
                {/if}
            </div>
            <div class="flex items-center justify-between gap-2">
                <span class="text-gray-400">Risk Level</span>
                {if case.severity == 'high' || case.severity == 'critical'}
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-red-100 text-red-700">High Risk</span>
                {elseif case.severity == 'medium'}
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-amber-100 text-amber-700">Moderate Risk</span>
                {else}
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold uppercase tracking-wide bg-green-100 text-green-700">Low Risk</span>
                {/if}
            </div>
            <div class="flex items-start justify-between gap-2 pt-2 border-t border-gray-100">
                <span class="text-gray-400 flex-shrink-0">Date Monitored</span>
                <span class="font-medium text-gray-700 text-right">{case.created_at | date:'M d, Y'}</span>
            </div>
            <div class="flex items-start justify-between gap-2">
                <span class="text-gray-400 flex-shrink-0">Last Updated</span>
                <div class="text-right">
                    <div class="font-medium text-gray-700">{case.updated_at | date:'M d, Y'}</div>
                    {if case.counselor_name}
                    <div class="text-gray-400">(By {case.counselor_name | esc_html})</div>
                    {/if}
                </div>
            </div>
        </div>

    </div>
</div>

{!-- === TAB NAVIGATION === --}
<div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-5">
    <div class="flex overflow-x-auto border-b border-gray-100 px-2 scrollbar-hide">
        <button @click="tab = 'overview'"
                :class="tab === 'overview' ? 'border-teal-600 text-teal-700 font-semibold' : 'border-transparent text-gray-500 hover:text-gray-700'"
                class="flex items-center gap-2 px-4 py-3.5 text-sm border-b-2 transition-colors whitespace-nowrap flex-shrink-0">
            <i class="fas fa-th-large text-xs"></i> Overview
        </button>
        <button @click="tab = 'appointments'; if (!apptLoaded) { apptLoaded = true; $dispatch('load-case-appts'); }"
                :class="tab === 'appointments' ? 'border-teal-600 text-teal-700 font-semibold' : 'border-transparent text-gray-500 hover:text-gray-700'"
                class="flex items-center gap-2 px-4 py-3.5 text-sm border-b-2 transition-colors whitespace-nowrap flex-shrink-0">
            <i class="fas fa-calendar-check text-xs"></i> Appointments
        </button>
        <button @click="tab = 'session_records'; if (!sessionsLoaded) { sessionsLoaded = true; $dispatch('load-case-sessions'); }"
                :class="tab === 'session_records' ? 'border-teal-600 text-teal-700 font-semibold' : 'border-transparent text-gray-500 hover:text-gray-700'"
                class="flex items-center gap-2 px-4 py-3.5 text-sm border-b-2 transition-colors whitespace-nowrap flex-shrink-0">
            <i class="fas fa-clipboard-list text-xs"></i> Session Records
        </button>
        <button @click="tab = 'notes'; if (!notesLoaded) { notesLoaded = true; $dispatch('load-case-notes'); }"
                :class="tab === 'notes' ? 'border-teal-600 text-teal-700 font-semibold' : 'border-transparent text-gray-500 hover:text-gray-700'"
                class="flex items-center gap-2 px-4 py-3.5 text-sm border-b-2 transition-colors whitespace-nowrap flex-shrink-0">
            <i class="fas fa-sticky-note text-xs"></i> Notes
        </button>
        <button @click="tab = 'documents'; if (!docsLoaded) { docsLoaded = true; $dispatch('load-case-docs'); }"
                :class="tab === 'documents' ? 'border-teal-600 text-teal-700 font-semibold' : 'border-transparent text-gray-500 hover:text-gray-700'"
                class="flex items-center gap-2 px-4 py-3.5 text-sm border-b-2 transition-colors whitespace-nowrap flex-shrink-0">
            <i class="fas fa-folder text-xs"></i> Documents
        </button>
        <button @click="tab = 'alerts'; if (!alertsLoaded) { alertsLoaded = true; $dispatch('load-case-alerts'); }"
                :class="tab === 'alerts' ? 'border-teal-600 text-teal-700 font-semibold' : 'border-transparent text-gray-500 hover:text-gray-700'"
                class="flex items-center gap-2 px-4 py-3.5 text-sm border-b-2 transition-colors whitespace-nowrap flex-shrink-0">
            <i class="fas fa-bell text-xs"></i> Alerts
        </button>
        <button @click="tab = 'log'; if (!logLoaded) { logLoaded = true; $dispatch('load-case-log'); }"
                :class="tab === 'log' ? 'border-teal-600 text-teal-700 font-semibold' : 'border-transparent text-gray-500 hover:text-gray-700'"
                class="flex items-center gap-2 px-4 py-3.5 text-sm border-b-2 transition-colors whitespace-nowrap flex-shrink-0">
            <i class="fas fa-history text-xs"></i> Activity Log
        </button>
    </div>
</div>

{!-- ============================= --}
{!-- OVERVIEW TAB                  --}
{!-- ============================= --}
<div x-show="tab === 'overview'">

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

        {!-- Left 2 columns --}
        <div class="lg:col-span-2 space-y-5">

            {!-- About / Background --}
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
                <h3 class="flex items-center gap-2 text-sm font-semibold text-gray-800 mb-3">
                    <i class="fas fa-user-circle text-teal-600 text-base"></i> About / Background
                </h3>
                <p class="text-sm text-gray-700 leading-relaxed">
                    {if case.presenting_issue}
                    {case.presenting_issue | esc_html | nl2br}
                    {else}
                    <span class="text-gray-400 italic">No background information recorded.</span>
                    {/if}
                </p>
                {if case.background_info}
                <p class="text-sm text-gray-600 leading-relaxed mt-2">{case.background_info | esc_html | nl2br}</p>
                {/if}

                {!-- 4-col info strip --}
                <div class="mt-5 pt-4 border-t border-gray-100 grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
                    <div>
                        <div class="flex items-center gap-1.5 text-gray-400 mb-1.5">
                            <i class="fas fa-users text-gray-300 text-xs"></i>
                            <span class="font-medium uppercase tracking-wide text-[10px]">Guardian / Contact Person</span>
                        </div>
                        <div class="font-medium text-gray-700">{case.parent_guardian_name | esc_html | default:'—'}</div>
                        {if case.parent_guardian_contact}
                        <div class="text-gray-500 mt-0.5">{case.parent_guardian_contact | esc_html}</div>
                        {/if}
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5 text-gray-400 mb-1.5">
                            <i class="fas fa-map-marker-alt text-gray-300 text-xs"></i>
                            <span class="font-medium uppercase tracking-wide text-[10px]">Address</span>
                        </div>
                        <div class="font-medium text-gray-700 leading-snug">{case.address | esc_html | default:'—'}</div>
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5 text-gray-400 mb-1.5">
                            <i class="fas fa-share-square text-gray-300 text-xs"></i>
                            <span class="font-medium uppercase tracking-wide text-[10px]">Referred By</span>
                        </div>
                        <div class="font-medium text-gray-700">{case.referred_by | esc_html | default:'Self'}</div>
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5 text-gray-400 mb-1.5">
                            <i class="fas fa-calendar-plus text-gray-300 text-xs"></i>
                            <span class="font-medium uppercase tracking-wide text-[10px]">Date Added</span>
                        </div>
                        <div class="font-medium text-gray-700">{case.created_at | date:'M d, Y'}</div>
                    </div>
                </div>
            </div>

            {!-- Recent Appointment Activity --}
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
                    <h3 class="flex items-center gap-2 text-sm font-semibold text-gray-800">
                        <i class="fas fa-calendar-alt text-teal-600 text-base"></i> Recent Appointment Activity
                    </h3>
                    <button @click="tab = 'appointments'; if (!apptLoaded) { apptLoaded = true; $dispatch('load-case-appts'); }"
                            class="text-sm text-teal-600 hover:text-teal-800 font-medium flex items-center gap-1 transition-colors">
                        View All Appointments <i class="fas fa-arrow-right text-xs"></i>
                    </button>
                </div>

                {if recent_sessions | count > 0}
                <div class="divide-y divide-gray-50">
                    {for session in recent_sessions}
                    <div class="px-6 py-4 flex items-start gap-4 hover:bg-gray-50/50 transition-colors">

                        {!-- Date / time --}
                        <div class="w-20 flex-shrink-0 text-xs text-gray-500">
                            <div class="font-medium text-gray-700">{session.formatted_date}</div>
                            <div class="mt-0.5 text-gray-400">{session.formatted_time}</div>
                        </div>

                        {!-- Status icon circle --}
                        <div class="mt-0.5 flex-shrink-0">
                            {if session.status == 'completed'}
                            <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center">
                                <i class="fas fa-check text-green-600 text-xs"></i>
                            </div>
                            {elseif session.status == 'no_show'}
                            <div class="w-8 h-8 rounded-full bg-orange-100 flex items-center justify-center">
                                <i class="fas fa-clock text-orange-500 text-xs"></i>
                            </div>
                            {elseif session.status == 'cancelled'}
                            <div class="w-8 h-8 rounded-full bg-red-100 flex items-center justify-center">
                                <i class="fas fa-times text-red-500 text-xs"></i>
                            </div>
                            {elseif session.status == 'scheduled' || session.status == 'confirmed'}
                            <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center">
                                <i class="fas fa-calendar-check text-blue-500 text-xs"></i>
                            </div>
                            {else}
                            <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center">
                                <i class="fas fa-calendar text-gray-400 text-xs"></i>
                            </div>
                            {/if}
                        </div>

                        {!-- Status badge + session info --}
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap mb-1">
                                {if session.status == 'completed'}
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide bg-green-100 text-green-700">WENT TO SESSION</span>
                                {elseif session.status == 'no_show'}
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide bg-orange-100 text-orange-700">DID NOT SHOW UP</span>
                                {elseif session.status == 'cancelled'}
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide bg-red-100 text-red-700">CANCELLED</span>
                                {elseif session.status == 'scheduled'}
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide bg-blue-100 text-blue-700">SCHEDULED</span>
                                {elseif session.status == 'confirmed'}
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide bg-teal-100 text-teal-700">CONFIRMED</span>
                                {elseif session.status == 'pending' || session.status == 'requested'}
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide bg-indigo-100 text-indigo-700">PENDING REVIEW</span>
                                {else}
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide bg-gray-100 text-gray-600">{session.status | upper}</span>
                                {/if}
                            </div>
                            <div class="text-sm font-medium text-gray-900">{session.type_name | esc_html | default:'Session'}</div>
                            {if session.purpose}
                            <div class="text-xs text-gray-500 mt-0.5 truncate max-w-xs">{session.purpose | esc_html}</div>
                            {/if}
                            <div class="text-xs text-gray-400 mt-0.5">{session.counselor_name | esc_html}</div>
                        </div>

                        {!-- Duration + action buttons --}
                        <div class="flex-shrink-0 flex flex-col items-end gap-2">
                            {if session.duration_minutes}
                            <span class="text-xs text-gray-400">{session.duration_minutes} mins</span>
                            {/if}
                            <div class="flex items-center gap-1.5">
                                {if session.status == 'completed'}
                                <button hx-get="{base_url}/pages/appointments/{session.id}"
                                        hx-target="#modal-container"
                                        onclick="event.stopPropagation();"
                                        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-teal-200 text-xs font-medium text-teal-700 hover:bg-teal-50 transition-colors">
                                    <i class="fas fa-eye text-[10px]"></i> View
                                </button>
                                {elseif session.status == 'no_show'}
                                <button hx-get="{base_url}/pages/appointments/{session.id}/edit"
                                        hx-target="#modal-container"
                                        onclick="event.stopPropagation();"
                                        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-amber-200 text-xs font-medium text-amber-700 hover:bg-amber-50 transition-colors">
                                    <i class="fas fa-calendar-plus text-[10px]"></i> Reschedule
                                </button>
                                {elseif session.status != 'cancelled'}
                                <button hx-get="{base_url}/pages/appointments/{session.id}"
                                        hx-target="#modal-container"
                                        onclick="event.stopPropagation();"
                                        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-gray-200 text-xs font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                                    <i class="fas fa-eye text-[10px]"></i> View
                                </button>
                                {/if}
                                <button class="w-6 h-6 flex items-center justify-center text-gray-300 hover:text-gray-500 transition-colors">
                                    <i class="fas fa-chevron-down text-[10px]"></i>
                                </button>
                            </div>
                        </div>

                    </div>
                    {/for}
                </div>

                <div class="px-6 py-3 border-t border-gray-50 text-center">
                    <button @click="tab = 'appointments'; if (!apptLoaded) { apptLoaded = true; $dispatch('load-case-appts'); }"
                            class="text-sm text-gray-500 hover:text-teal-600 transition-colors flex items-center gap-1.5 mx-auto">
                        Load more appointments <i class="fas fa-chevron-down text-xs"></i>
                    </button>
                </div>

                {else}
                <div class="px-6 py-12 text-center text-gray-400">
                    <i class="fas fa-calendar-times text-3xl mb-3 text-gray-200 block"></i>
                    <p class="text-sm">No appointment activity yet.</p>
                    <button hx-get="{base_url}/pages/appointments/new" hx-target="#modal-container"
                            class="mt-3 inline-flex items-center gap-1.5 px-3 py-1.5 bg-teal-700 text-white text-xs font-medium rounded-lg hover:bg-teal-800 transition-colors">
                        <i class="fas fa-plus text-[10px]"></i> Schedule First Appointment
                    </button>
                </div>
                {/if}
            </div>

        </div>

        {!-- Right column --}
        <div class="space-y-5">

            {!-- Risk & Status Summary --}
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                <h3 class="flex items-center gap-2 text-sm font-semibold text-gray-800 mb-4">
                    <i class="fas fa-shield-alt text-teal-600"></i> Risk & Status Summary
                </h3>
                <div class="space-y-3 text-sm">
                    <div class="flex items-center justify-between">
                        <span class="text-gray-500">Risk Level</span>
                        {if case.severity == 'high' || case.severity == 'critical'}
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold uppercase tracking-wide bg-red-100 text-red-700">High Risk</span>
                        {elseif case.severity == 'medium'}
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold uppercase tracking-wide bg-amber-100 text-amber-700">Moderate Risk</span>
                        {else}
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold uppercase tracking-wide bg-green-100 text-green-700">Low Risk</span>
                        {/if}
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-gray-500">Overall Status</span>
                        {if case.student_status == 'probationary'}
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold uppercase tracking-wide bg-violet-100 text-violet-700">{case.student_status | upper}</span>
                        {elseif case.student_status == 'regular'}
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold uppercase tracking-wide bg-blue-100 text-blue-700">{case.student_status | upper}</span>
                        {elseif case.student_status}
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold uppercase tracking-wide bg-gray-100 text-gray-600">{case.student_status | upper}</span>
                        {else}
                        <span class="text-gray-400 text-xs">—</span>
                        {/if}
                    </div>
                    <div class="flex items-start justify-between pt-2 border-t border-gray-100">
                        <span class="text-gray-500">Monitoring Since</span>
                        <span class="font-medium text-gray-800 text-right">{case.created_at | date:'M j, Y'}</span>
                    </div>
                    <div class="flex items-start justify-between">
                        <span class="text-gray-500">Reason for Monitoring</span>
                        <span class="font-medium text-gray-800 text-right max-w-[130px] leading-snug">{case.category | title | default:'—'}</span>
                    </div>
                    {if case.next_followup_date}
                    <div class="flex items-center justify-between">
                        <span class="text-gray-500">Next Review</span>
                        <span class="font-medium text-teal-700 text-right">
                            <i class="fas fa-calendar-check mr-1 text-xs"></i>{case.next_followup_date | date:'M d, Y'}
                        </span>
                    </div>
                    {/if}
                </div>
            </div>

            {!-- Upcoming Appointment --}
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                <h3 class="flex items-center gap-2 text-sm font-semibold text-gray-800 mb-4">
                    <i class="fas fa-calendar-day text-teal-600"></i> Upcoming Appointment
                </h3>
                {if next_appointment}
                <div class="rounded-lg border border-gray-100 bg-gray-50/50 p-3 space-y-2">
                    <div class="flex items-center gap-2 text-sm font-semibold text-gray-700">
                        <i class="fas fa-calendar text-teal-500 w-4 flex-shrink-0"></i>
                        {next_appointment.formatted_date} ({next_appointment.formatted_dow})
                    </div>
                    <div class="text-xs text-gray-500 pl-6">
                        {next_appointment.formatted_time} — {next_appointment.formatted_end}
                    </div>
                    <div class="space-y-1.5 mt-2 pt-2 border-t border-gray-100 text-xs">
                        <div class="flex items-start justify-between gap-2">
                            <span class="text-gray-400 flex-shrink-0">Purpose</span>
                            <span class="font-medium text-gray-700 text-right leading-snug">{next_appointment.type_name | esc_html | default:next_appointment.purpose | default:'—'}</span>
                        </div>
                        <div class="flex items-start justify-between gap-2">
                            <span class="text-gray-400 flex-shrink-0">Counselor</span>
                            <span class="font-medium text-gray-700 text-right">{next_appointment.counselor_name | esc_html | default:'—'}</span>
                        </div>
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-gray-400">Status</span>
                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-blue-100 text-blue-700">{next_appointment.status | upper}</span>
                        </div>
                    </div>
                </div>
                <button hx-get="{base_url}/pages/appointments/{next_appointment.id}"
                        hx-target="#modal-container"
                        class="mt-3 w-full inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg border border-gray-200 text-xs font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                    <i class="fas fa-calendar-check text-teal-500"></i> View Appointment
                </button>
                {else}
                <div class="text-center py-5 text-gray-400">
                    <i class="fas fa-calendar-times text-3xl mb-2 text-gray-200 block"></i>
                    <p class="text-xs">No upcoming appointments.</p>
                </div>
                <button hx-get="{base_url}/pages/appointments/new" hx-target="#modal-container"
                        class="mt-1 w-full inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg bg-teal-700 text-xs font-medium text-white hover:bg-teal-800 transition-colors">
                    <i class="fas fa-calendar-plus text-xs"></i> Schedule Appointment
                </button>
                {/if}
            </div>

            {!-- Quick Actions --}
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
                <h3 class="flex items-center gap-2 text-sm font-semibold text-gray-800 mb-3">
                    <i class="fas fa-bolt text-teal-600"></i> Quick Actions
                </h3>
                <div class="space-y-1.5">
                    <button hx-get="{base_url}/pages/appointments/new" hx-target="#modal-container"
                            class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg border border-gray-100 hover:bg-gray-50 text-sm text-gray-700 transition-colors text-left">
                        <i class="fas fa-calendar-plus text-teal-500 w-5 text-center flex-shrink-0"></i>
                        Schedule Appointment
                    </button>
                    <button hx-get="{base_url}/pages/cases/{case.id}/notes/new" hx-target="#modal-container"
                            class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg border border-gray-100 hover:bg-gray-50 text-sm text-gray-700 transition-colors text-left">
                        <i class="fas fa-clipboard-list text-teal-500 w-5 text-center flex-shrink-0"></i>
                        Add Session Record
                    </button>
                    <button hx-get="{base_url}/pages/cases/{case.id}/notes/new" hx-target="#modal-container"
                            class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg border border-gray-100 hover:bg-gray-50 text-sm text-gray-700 transition-colors text-left">
                        <i class="fas fa-sticky-note text-teal-500 w-5 text-center flex-shrink-0"></i>
                        Add Note
                    </button>
                    <button class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg border border-gray-100 bg-gray-50/50 text-sm text-gray-400 text-left cursor-not-allowed" disabled>
                        <i class="fas fa-upload w-5 text-center flex-shrink-0"></i>
                        Upload Document
                    </button>
                </div>
            </div>

        </div>
    </div>

    {!-- Documents + Notes bottom row --}
    <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-5">

        {!-- Documents --}
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
            <div class="flex items-center justify-between mb-4">
                <h3 class="flex items-center gap-2 text-sm font-semibold text-gray-800">
                    <i class="fas fa-folder-open text-teal-600"></i> Documents
                </h3>
                <button @click="tab = 'documents'"
                        class="text-xs text-teal-600 hover:text-teal-800 font-medium transition-colors">
                    View All
                </button>
            </div>
            {if recent_documents | count > 0}
            <div class="space-y-1">
                {for doc in recent_documents}
                <div class="flex items-center gap-3 py-2.5 border-b border-gray-50 last:border-0">
                    <div class="w-9 h-9 rounded-lg bg-red-50 flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-file-pdf text-red-500 text-sm"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="text-sm font-medium text-gray-800 truncate">{doc.file_name | esc_html}</div>
                        <div class="text-xs text-gray-400">Uploaded on {doc.uploaded_at | date:'M d, Y'}</div>
                    </div>
                </div>
                {/for}
            </div>
            {else}
            <div class="text-center py-6 text-gray-300">
                <i class="fas fa-folder-open text-3xl mb-2 block"></i>
                <p class="text-xs text-gray-400">No documents uploaded.</p>
            </div>
            {/if}
        </div>

        {!-- Notes --}
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
            <div class="flex items-center justify-between mb-4">
                <h3 class="flex items-center gap-2 text-sm font-semibold text-gray-800">
                    <i class="fas fa-sticky-note text-teal-600"></i> Notes
                </h3>
                <button @click="tab = 'notes'; if (!notesLoaded) { notesLoaded = true; $dispatch('load-case-notes'); }"
                        class="text-xs text-teal-600 hover:text-teal-800 font-medium transition-colors">
                    View All
                </button>
            </div>
            {if recent_notes | count > 0}
            <div class="space-y-3">
                {for note in recent_notes}
                <div class="pb-3 border-b border-gray-50 last:border-0">
                    <p class="text-sm text-gray-700 leading-relaxed line-clamp-3">{note.note_content | esc_html}</p>
                    <div class="mt-1.5 flex items-center gap-2 text-xs text-gray-400">
                        <span>{note.counselor_name | esc_html | default:'Counselor'}</span>
                        <span>•</span>
                        <span>{note.created_at | date:'M d, Y'}</span>
                    </div>
                </div>
                {/for}
            </div>
            {else}
            <div class="text-center py-6 text-gray-300">
                <i class="fas fa-sticky-note text-3xl mb-2 block"></i>
                <p class="text-xs text-gray-400">No notes yet.</p>
            </div>
            {/if}
        </div>

    </div>
</div>
{!-- END OVERVIEW TAB --}

{!-- ============================= --}
{!-- APPOINTMENTS TAB               --}
{!-- ============================= --}
<div x-show="tab === 'appointments'" x-cloak>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div id="case-appt-tab"
             hx-get="/admin/guidance/api/cases/{case.id}/appointments"
             hx-trigger="load-case-appts from:body"
             hx-swap="innerHTML">
            <div class="p-10 text-center text-gray-400">
                <i class="fas fa-spinner fa-spin text-xl mr-2"></i> Loading appointments...
            </div>
        </div>
    </div>
</div>

{!-- ============================= --}
{!-- SESSION RECORDS TAB           --}
{!-- ============================= --}
<div x-show="tab === 'session_records'" x-cloak>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div id="case-sessions-tab"
             hx-get="/admin/guidance/api/cases/{case.id}/session-records"
             hx-trigger="load-case-sessions from:body"
             hx-swap="innerHTML">
            <div class="p-10 text-center text-gray-400">
                <i class="fas fa-spinner fa-spin text-xl mr-2"></i> Loading session records...
            </div>
        </div>
    </div>
</div>

{!-- ============================= --}
{!-- NOTES TAB                     --}
{!-- ============================= --}
<div x-show="tab === 'notes'" x-cloak>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div id="case-notes-tab"
             hx-get="/admin/guidance/api/cases/{case.id}/notes"
             hx-trigger="load-case-notes from:body"
             hx-swap="innerHTML">
            <div class="p-10 text-center text-gray-400">
                <i class="fas fa-spinner fa-spin text-xl mr-2"></i> Loading notes...
            </div>
        </div>
    </div>
</div>

{!-- ============================= --}
{!-- DOCUMENTS TAB                 --}
{!-- ============================= --}
<div x-show="tab === 'documents'" x-cloak>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div id="case-documents-tab"
             hx-get="/admin/guidance/api/cases/{case.id}/documents"
             hx-trigger="load-case-docs from:body"
             hx-swap="innerHTML">
            <div class="p-10 text-center text-gray-400">
                <i class="fas fa-spinner fa-spin text-xl mr-2"></i> Loading documents...
            </div>
        </div>
    </div>
</div>

{!-- ============================= --}
{!-- ALERTS TAB                    --}
{!-- ============================= --}
<div x-show="tab === 'alerts'" x-cloak>
    <div id="case-alerts-tab"
         hx-get="/admin/guidance/api/cases/{case.id}/alerts"
         hx-trigger="load-case-alerts from:body"
         hx-swap="innerHTML">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-10 text-center text-gray-400">
            <i class="fas fa-spinner fa-spin text-xl mr-2"></i> Loading alerts...
        </div>
    </div>
</div>

{!-- ============================= --}
{!-- ACTIVITY LOG TAB              --}
{!-- ============================= --}
<div x-show="tab === 'log'" x-cloak>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100">
            <h3 class="text-sm font-semibold text-gray-800">Activity Log</h3>
        </div>
        <div id="case-log-tab"
             hx-get="/admin/guidance/api/cases/{case.id}/activity"
             hx-trigger="load-case-log from:body"
             hx-swap="innerHTML">
            <div class="p-10 text-center text-gray-400">
                <i class="fas fa-spinner fa-spin text-xl mr-2"></i> Loading activity log...
            </div>
        </div>
    </div>
</div>

</div>
{!-- end Alpine x-data wrapper --}

{/block}
