{extends "modules/guidance/layouts/app.disyl"}

{block content}
<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
    <div class="flex items-start justify-between gap-4">
        <div>
            <div class="text-xs uppercase tracking-wide text-gray-400">Case</div>
            <h1 class="text-xl font-semibold text-gray-900 mt-1">
                {case.case_number | default:'#'} — {case.student_name | default:'Student'}
            </h1>
            <div class="mt-2 flex flex-wrap gap-2">
                {if case.severity}
                {ikb_badge variant="{case.severity}"}{case.severity | title}{/ikb_badge}
                {/if}
                {if case.status}
                {ikb_badge variant="{case.status}"}{case.status | title}{/ikb_badge}
                {/if}
                {if case.category}
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs bg-gray-100 text-gray-700">
                    {case.category | title}
                </span>
                {/if}
            </div>
        </div>

        <div class="flex items-center gap-2">
            {if case.status != 'closed'}
            <button type="button"
                    hx-get="/pages/cases/{case.id}/edit"
                    hx-target="#modal-container"
                    class="inline-flex items-center rounded-lg border border-indigo-200 px-3 py-2 text-sm font-medium text-indigo-700 hover:bg-indigo-50">
                <i class="fas fa-edit mr-2"></i> Edit
            </button>
            <button type="button"
                    hx-post="/api/cases/{case.id}/close"
                    hx-confirm="Close this case?"
                    hx-swap="none"
                    class="inline-flex items-center rounded-lg border border-emerald-200 px-3 py-2 text-sm font-medium text-emerald-700 hover:bg-emerald-50">
                <i class="fas fa-check mr-2"></i> Close
            </button>
            {else}
            <button type="button"
                    hx-post="/api/cases/{case.id}/reopen"
                    hx-swap="none"
                    class="inline-flex items-center rounded-lg border border-amber-200 px-3 py-2 text-sm font-medium text-amber-700 hover:bg-amber-50">
                <i class="fas fa-rotate-left mr-2"></i> Reopen
            </button>
            {/if}

            {if can_delete_case}
            <button type="button"
                    hx-delete="/api/cases/{case.id}"
                    hx-confirm="Delete this case? This action cannot be undone."
                    hx-swap="none"
                    class="inline-flex items-center rounded-lg border border-red-200 px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-50">
                <i class="fas fa-trash mr-2"></i> Delete
            </button>
            {/if}

            <a href="{base_url}/cases" 
               hx-get="/admin/guidance/pages/cases" 
               hx-target="#main-content" 
               hx-push-url="{base_url}/cases"
               class="text-sm text-indigo-600 hover:text-indigo-800 font-medium ml-2">
                <i class="fas fa-arrow-left mr-1"></i> Back
            </a>
        </div>
    </div>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-lg border border-gray-100 p-4">
            <div class="text-xs text-gray-500">Student ID</div>
            <div class="text-sm font-medium text-gray-900 mt-1">{case.student_id | default:'—'}</div>
        </div>
        <div class="rounded-lg border border-gray-100 p-4">
            <div class="text-xs text-gray-500">Client Number</div>
            <div class="text-sm font-medium text-gray-900 mt-1">{case.student_mobile | default:'—'}</div>
        </div>
        <div class="rounded-lg border border-gray-100 p-4">
            <div class="text-xs text-gray-500">Updated</div>
            <div class="text-sm font-medium text-gray-900 mt-1">{case.updated_at | default:'—'}</div>
        </div>
        <div class="rounded-lg border border-gray-100 p-4 md:col-span-2">
            <div class="text-xs text-gray-500">Presenting Issue</div>
            <div class="text-sm text-gray-900 mt-1">{case.presenting_issue | default:'—' | raw}</div>
        </div>
        <div class="rounded-lg border border-gray-100 p-4 md:col-span-2">
            <div class="text-xs text-gray-500">Notes</div>
            <div class="text-sm text-gray-900 mt-1">{case.notes | default:'—' | raw}</div>
        </div>
    </div>
</div>

<div class="mt-6 bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100">
        <div class="text-sm font-semibold text-gray-900">Status History</div>
        <div class="text-xs text-gray-500 mt-1">Lifecycle changes recorded for this case.</div>
    </div>

    <div id="case-history"
         hx-get="/api/cases/{case.id}/history"
         hx-trigger="load, refreshCases from:body"
         hx-swap="innerHTML">
        <div class="p-8 text-center text-gray-500">
            <i class="fas fa-spinner fa-spin mr-2"></i> Loading history...
        </div>
    </div>
</div>

{if show_case_notes}
<div class="mt-6 bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between gap-3">
        <div>
            <div class="text-sm font-semibold text-gray-900">Counselor Notes</div>
            <div class="text-xs text-gray-500 mt-1">Session and intervention notes for this case.</div>
        </div>
        <button type="button"
                hx-get="/pages/cases/{case.id}/notes/new"
                hx-target="#modal-container"
                class="inline-flex items-center rounded-lg bg-indigo-600 px-3 py-2 text-sm font-medium text-white hover:bg-indigo-700">
            <i class="fas fa-plus mr-2"></i> Add Note
        </button>
    </div>

    <div id="notes-list"
         hx-get="/api/cases/{case.id}/notes"
         hx-trigger="load, refreshNotes from:body"
         hx-swap="innerHTML">
        <div class="p-8 text-center text-gray-500">
            <i class="fas fa-spinner fa-spin mr-2"></i> Loading notes...
        </div>
    </div>
</div>
{/if}
{/block}
