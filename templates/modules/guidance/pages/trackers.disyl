{extends "modules/guidance/layouts/app.disyl"}

{block content}
<div x-data="{ showCreate: false }">

{ikb_section padding="none"}

    {!-- Page Header --}
    <div class="flex items-start justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Student Trackers</h1>
            <p class="text-sm text-gray-500 mt-1">Monitor requirement trackers, student submissions, and completion progress.</p>
        </div>
        {if user.role == 'admin' || user.role == 'supervisor'}
        <button @click="showCreate = true"
                class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 transition shadow-sm flex-shrink-0">
            <i class="fas fa-plus mr-2"></i> New Tracker
        </button>
        {/if}
    </div>

    {!-- Stats Cards --}
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">

        <div class="bg-white rounded-xl border border-gray-100 p-4 flex items-center gap-4 shadow-sm">
            <div class="w-12 h-12 rounded-xl bg-teal-50 flex items-center justify-center flex-shrink-0">
                <i class="fas fa-clipboard-list text-teal-500 text-xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 mb-0.5">Total Trackers</p>
                <div class="text-2xl font-bold text-gray-900">{stats.total}</div>
                <div class="text-xs text-gray-400">All academic years</div>
            </div>
        </div>

        <div class="bg-white rounded-xl border border-gray-100 p-4 flex items-center gap-4 shadow-sm">
            <div class="w-12 h-12 rounded-xl bg-green-50 flex items-center justify-center flex-shrink-0">
                <i class="fas fa-play-circle text-green-500 text-xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 mb-0.5">Active Trackers</p>
                <div class="text-2xl font-bold text-gray-900">{stats.active}</div>
                <div class="text-xs text-gray-400">Active and accepting submissions</div>
            </div>
        </div>

        <div class="bg-white rounded-xl border border-gray-100 p-4 flex items-center gap-4 shadow-sm">
            <div class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center flex-shrink-0">
                <i class="fas fa-users text-blue-500 text-xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 mb-0.5">Students Covered</p>
                <div class="text-2xl font-bold text-gray-900">{stats.students}</div>
                <div class="text-xs text-gray-400">Across all trackers</div>
            </div>
        </div>

        <div class="bg-white rounded-xl border border-gray-100 p-4 flex items-center gap-4 shadow-sm">
            <div class="w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center flex-shrink-0">
                <i class="fas fa-clock text-amber-500 text-xl"></i>
            </div>
            <div>
                <p class="text-xs font-medium text-gray-500 mb-0.5">Pending Requirements</p>
                <div class="text-2xl font-bold text-gray-900">{stats.pending}</div>
                <div class="text-xs text-gray-400">Across all trackers</div>
            </div>
        </div>

    </div>

    {!-- Filter bar --}
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm mb-4 px-4 py-3">
        <div class="flex flex-wrap items-center gap-3">

            {!-- Search — no name attr; oninput syncs to hidden form before HTMX fires --}
            <div class="relative flex-1 min-w-[180px] max-w-xs">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
                <input type="text" id="tf-search" placeholder="Search trackers..."
                       oninput="document.getElementById('tf-search-h').value=this.value"
                       hx-get="{base_url}/api/trackers" hx-trigger="keyup changed delay:300ms" hx-target="#tracker-list" hx-include="#tf" hx-swap="innerHTML"
                       class="w-full pl-9 pr-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
            </div>

            {!-- Status --}
            <div class="flex flex-col">
                <label class="text-xs text-gray-400 font-medium mb-1 leading-none">Status</label>
                <select id="tf-status"
                        onchange="document.getElementById('tf-status-h').value=this.value; document.getElementById('tf-page-h').value='1'"
                        hx-get="{base_url}/api/trackers" hx-trigger="change" hx-target="#tracker-list" hx-include="#tf" hx-swap="innerHTML"
                        class="px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 min-w-[130px]">
                    <option value="">All Statuses</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                </select>
            </div>

            {!-- Academic Year --}
            <div class="flex flex-col">
                <label class="text-xs text-gray-400 font-medium mb-1 leading-none">Academic Year</label>
                <select id="tf-year"
                        onchange="document.getElementById('tf-year-h').value=this.value; document.getElementById('tf-page-h').value='1'"
                        hx-get="{base_url}/api/trackers" hx-trigger="change" hx-target="#tracker-list" hx-include="#tf" hx-swap="innerHTML"
                        class="px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 min-w-[130px]">
                    <option value="">All Years</option>
                    {foreach academic_years as yr}
                    <option value="{yr}">{yr}</option>
                    {/foreach}
                </select>
            </div>

            {!-- Sort --}
            <div class="flex flex-col">
                <label class="text-xs text-gray-400 font-medium mb-1 leading-none">Sort by</label>
                <select id="tf-sort"
                        onchange="document.getElementById('tf-sort-h').value=this.value; document.getElementById('tf-page-h').value='1'"
                        hx-get="{base_url}/api/trackers" hx-trigger="change" hx-target="#tracker-list" hx-include="#tf" hx-swap="innerHTML"
                        class="px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 min-w-[180px]">
                    <option value="newest">Last Updated (Newest)</option>
                    <option value="oldest">Last Updated (Oldest)</option>
                    <option value="name_asc">Name A–Z</option>
                    <option value="name_desc">Name Z–A</option>
                </select>
            </div>

            <div class="flex gap-2 ml-auto">
                <button type="button"
                        class="inline-flex items-center px-3.5 py-2 text-sm font-medium text-gray-600 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                    <i class="fas fa-chart-bar mr-1.5"></i> View Analytics
                </button>
                <button type="button"
                        class="inline-flex items-center px-3.5 py-2 text-sm font-medium text-gray-600 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
                    <i class="fas fa-download mr-1.5"></i> Export
                </button>
            </div>

        </div>
    </div>

    {!-- Hidden form — only these are submitted via hx-include="#tf" --}
    <form id="tf" class="hidden" aria-hidden="true">
        <input type="hidden" name="search"        id="tf-search-h"   value="">
        <input type="hidden" name="status"        id="tf-status-h"   value="">
        <input type="hidden" name="academic_year" id="tf-year-h"     value="">
        <input type="hidden" name="sort"          id="tf-sort-h"     value="newest">
        <input type="hidden" name="page"          id="tf-page-h"     value="1">
    </form>

    {!-- Tracker Table --}
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">

        {!-- Table header --}
        <div class="grid grid-cols-[2fr_110px_200px_240px_140px] gap-0 px-5 py-3 border-b border-gray-100 bg-gray-50/60">
            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Tracker</div>
            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Status</div>
            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Progress</div>
            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Requirements</div>
            <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide text-right">Actions</div>
        </div>

        {!-- List --}
        <div id="tracker-list"
             hx-get="{base_url}/api/trackers"
             hx-trigger="load, refreshTrackers from:body"
             hx-include="#tf"
             hx-swap="innerHTML"
             hx-history="false">
            <div class="flex items-center justify-center py-16 text-gray-400">
                <i class="fas fa-spinner fa-spin mr-2"></i> Loading...
            </div>
        </div>

    </div>

{/ikb_section}

    {!-- Create Tracker Modal --}
    <div x-show="showCreate" x-cloak class="fixed inset-0 z-50 overflow-y-auto" aria-modal="true">
        <div class="guidance-modal-shell">
            <div class="fixed inset-0 guidance-modal-backdrop" @click="showCreate = false"></div>
            <div class="guidance-modal-panel guidance-modal-panel--md" @click.away="showCreate = false">
                <div class="guidance-modal-header p-5">
                    <h3 class="text-lg font-semibold">Create New Tracker</h3>
                    <button @click="showCreate = false" class="guidance-modal-close"><i class="fas fa-times"></i></button>
                </div>
                <form hx-post="{base_url}/api/trackers" hx-swap="none" hx-on::after-request="if(event.detail.successful) { showCreate = false; this.reset(); }" class="p-5 space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Tracker Name *</label>
                        <input type="text" name="name" required placeholder="e.g., SY 2025-2026 Requirements"
                               class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                        <textarea name="description" rows="2" placeholder="Brief description of what this tracker is for..."
                                  class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"></textarea>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Academic Year</label>
                            <input type="text" name="academic_year" placeholder="e.g., 2025-2026"
                                   class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">College</label>
                            <select name="college_id" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                                <option value="">All Colleges</option>
                                {foreach colleges as col}
                                <option value="{col.id}">{col.code} - {col.name}</option>
                                {/foreach}
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Required Documents</label>
                        <p class="text-xs text-gray-400 mb-2">One per line. You can add more later.</p>
                        <div x-data="{ items: [''] }" class="space-y-2">
                            <template x-for="(item, index) in items" :key="index">
                                <div class="flex gap-2">
                                    <input type="text" :name="'items[' + index + ']'" x-model="items[index]" placeholder="e.g., Form 137"
                                           class="flex-1 px-3 py-2 text-sm border border-gray-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                                    <button type="button" @click="items.splice(index, 1)" x-show="items.length > 1" class="px-2 text-red-400 hover:text-red-600"><i class="fas fa-times"></i></button>
                                </div>
                            </template>
                            <button type="button" @click="items.push('')" class="text-sm text-indigo-600 hover:text-indigo-800">
                                <i class="fas fa-plus mr-1"></i> Add Document
                            </button>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 mb-2">
                        <input type="checkbox" id="new-tracker-is-active" name="is_active" value="1" checked
                               class="h-4 w-4 text-indigo-600 border-gray-300 rounded">
                        <label for="new-tracker-is-active" class="text-sm text-gray-700">Active</label>
                    </div>
                    <div class="flex justify-end gap-3 pt-2">
                        <button type="button" @click="showCreate = false" class="px-4 py-2 text-sm text-gray-600 hover:bg-gray-100 rounded-lg transition">Cancel</button>
                        <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-lg hover:bg-indigo-700 transition">
                            <i class="fas fa-check mr-1"></i> Create Tracker
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

{/block}
