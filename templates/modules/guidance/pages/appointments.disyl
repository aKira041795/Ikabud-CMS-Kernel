{extends "modules/guidance/layouts/app.disyl"}

{block content}
{!-- Appointments Page --}

{ikb_section padding="none"}

    <div x-data="appointmentsPage()" x-init="init()">

    {!-- Page Header --}
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-6 gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-teal-100 flex items-center justify-center">
                <i class="fas fa-calendar-check text-teal-600 text-xl"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Appointments</h1>
                <p class="text-sm text-gray-500 mt-0.5">Operational scheduling workspace for booking, confirming, rescheduling, and updating attendance outcomes.</p>
            </div>
        </div>
        <button hx-get="{base_url}/pages/appointments/new" hx-target="#modal-container" hx-swap="innerHTML"
                class="inline-flex items-center px-4 py-2 bg-teal-700 text-white text-sm font-medium rounded-lg hover:bg-teal-800 transition shadow-sm">
            <i class="fas fa-plus mr-2"></i> Schedule Appointment
        </button>
    </div>

    {!-- Appointment Stats --}
    <div id="appointment-stats"
         hx-get="{base_url}/api/appointments/stats"
         hx-trigger="load, refreshAppointments from:body"
         hx-swap="innerHTML"
         class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex items-center gap-3 animate-pulse">
            <div class="w-12 h-12 bg-gray-100 rounded-full"></div>
            <div class="h-8 bg-gray-100 rounded w-20"></div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex items-center gap-3 animate-pulse">
            <div class="w-12 h-12 bg-gray-100 rounded-full"></div>
            <div class="h-8 bg-gray-100 rounded w-20"></div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex items-center gap-3 animate-pulse">
            <div class="w-12 h-12 bg-gray-100 rounded-full"></div>
            <div class="h-8 bg-gray-100 rounded w-20"></div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 flex items-center gap-3 animate-pulse">
            <div class="w-12 h-12 bg-gray-100 rounded-full"></div>
            <div class="h-8 bg-gray-100 rounded w-20"></div>
        </div>
    </div>

    {!-- Tab Bar + Date Filter --}
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 mb-5">
        <div class="flex items-center border-b border-gray-100 px-4 overflow-x-auto">
            <button @click="activeTab = 'all'; filterStatus = ''; loadList()"
                    :class="activeTab === 'all' ? 'border-b-2 border-teal-600 text-teal-700 font-semibold' : 'text-gray-500 hover:text-gray-700'"
                    class="px-4 py-3 text-sm whitespace-nowrap mr-1 transition-colors">
                All Appointments
            </button>
            <button @click="activeTab = 'upcoming'; filterStatus = 'scheduled'; loadList()"
                    :class="activeTab === 'upcoming' ? 'border-b-2 border-teal-600 text-teal-700 font-semibold' : 'text-gray-500 hover:text-gray-700'"
                    class="px-4 py-3 text-sm whitespace-nowrap mr-1 transition-colors">
                Upcoming
            </button>
            <button @click="activeTab = 'pending'; filterStatus = 'pending'; loadList()"
                    :class="activeTab === 'pending' ? 'border-b-2 border-amber-500 text-amber-700 font-semibold' : 'text-gray-500 hover:text-gray-700'"
                    class="px-4 py-3 text-sm whitespace-nowrap mr-1 transition-colors">
                Pending Review
            </button>
            <button @click="activeTab = 'completed'; filterStatus = 'completed'; loadList()"
                    :class="activeTab === 'completed' ? 'border-b-2 border-teal-600 text-teal-700 font-semibold' : 'text-gray-500 hover:text-gray-700'"
                    class="px-4 py-3 text-sm whitespace-nowrap mr-1 transition-colors">
                Completed Sessions
            </button>
            <button @click="activeTab = 'cancelled'; filterStatus = 'cancelled'; loadList()"
                    :class="activeTab === 'cancelled' ? 'border-b-2 border-teal-600 text-teal-700 font-semibold' : 'text-gray-500 hover:text-gray-700'"
                    class="px-4 py-3 text-sm whitespace-nowrap mr-1 transition-colors">
                Cancelled
            </button>
            <button @click="activeTab = 'noshow'; filterStatus = 'no_show'; loadList()"
                    :class="activeTab === 'noshow' ? 'border-b-2 border-teal-600 text-teal-700 font-semibold' : 'text-gray-500 hover:text-gray-700'"
                    class="px-4 py-3 text-sm whitespace-nowrap mr-1 transition-colors">
                No-Show
            </button>

            {!-- Date Range (right side) --}
            <div class="ml-auto flex items-center gap-2 py-2 pl-4 flex-shrink-0">
                <i class="fas fa-calendar-alt text-gray-400 text-xs"></i>
                <ikb_input type="date" model="filterFrom" class="text-sm border border-gray-200 rounded-lg px-3 py-1.5 focus:ring-2 focus:ring-teal-500 focus:border-teal-500" />
                <span class="text-gray-400 text-xs font-medium">–</span>
                <ikb_input type="date" model="filterTo" class="text-sm border border-gray-200 rounded-lg px-3 py-1.5 focus:ring-2 focus:ring-teal-500 focus:border-teal-500" />
                <button type="button"
                        x-show="filterFrom || filterTo"
                        @click="filterFrom = ''; filterTo = ''; loadList()"
                        class="ml-1 px-2.5 py-1.5 text-xs font-semibold rounded-lg bg-red-500 text-white hover:bg-red-600 transition flex-shrink-0">
                    <i class="fas fa-times text-[10px]"></i>
                </button>
            </div>
        </div>
    </div>

        <div id="appointments-list"
             hx-get="{base_url}/api/appointments"
             hx-trigger="load, refreshAppointments from:body"
             hx-swap="innerHTML"
             hx-history="false">
            <div class="flex items-center justify-center py-16 text-gray-400">
                <i class="fas fa-spinner fa-spin text-lg mr-3"></i> Loading appointments...
            </div>
        </div>

    {!-- Calendar View --}
    <div x-show="view === 'calendar'" x-cloak>
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
            {!-- Calendar Header --}
            <div class="flex items-center justify-between mb-4">
                <button @click="prevMonth()" class="p-2 hover:bg-gray-100 rounded-lg transition">
                    <i class="fas fa-chevron-left text-gray-600"></i>
                </button>
                <div class="flex items-center gap-3">
                    <h2 class="text-lg font-semibold text-gray-800"><ikb_text tag="span" bind="monthLabel" /></h2>
                    <button @click="goToday()" class="px-2 py-1 text-xs font-medium text-teal-600 bg-teal-50 rounded hover:bg-teal-100 transition">Today</button>
                </div>
                <button @click="nextMonth()" class="p-2 hover:bg-gray-100 rounded-lg transition">
                    <i class="fas fa-chevron-right text-gray-600"></i>
                </button>
            </div>

            {!-- Day Headers --}
            <div class="grid grid-cols-7 gap-px bg-gray-200 rounded-t-lg overflow-hidden">
                <template x-for="day in ['Sun','Mon','Tue','Wed','Thu','Fri','Sat']">
                    <div class="bg-gray-50 py-2 text-center text-xs font-semibold text-gray-500 uppercase"><ikb_text tag="span" bind="day" /></div>
                </template>
            </div>

            {!-- Calendar Grid --}
            <div class="grid grid-cols-7 gap-px bg-gray-200 rounded-b-lg overflow-hidden">
                <template x-for="cell in calendarCells" :key="cell.key">
                    <div class="bg-white p-1 min-h-[90px] relative"
                         :class="{ 'bg-teal-50 ring-1 ring-inset ring-teal-200': cell.isToday, 'opacity-40': !cell.currentMonth }">
                        <ikb_text tag="span" bind="cell.day" class="text-xs font-medium block mb-1 px-1"
                                  :class="cell.isToday ? 'text-teal-700 font-bold' : 'text-gray-700'" />
                        <div class="space-y-0.5 overflow-y-auto max-h-[65px]">
                            <template x-for="appt in cell.appointments" :key="appt.id">
                                <div class="text-xs px-1.5 py-0.5 rounded cursor-pointer truncate"
                                     :class="statusColor(appt.status_key || appt.status)"
                                     :title="appt.student_name + ' - ' + appt.scheduled_time"
                                     @click="openAppt(appt.id)">
                                    <ikb_text tag="span" bind="appt.scheduled_time.substring(0,5) + ' ' + (appt.student_name || 'N/A')" />
                                </div>
                            </template>
                        </div>
                    </div>
                </template>
            </div>

            {!-- Legend --}
            <div class="flex flex-wrap gap-4 mt-4 pt-4 border-t text-xs text-gray-600">
                <span><span class="inline-block w-3 h-3 rounded bg-amber-100 border border-amber-300 mr-1"></span> Pending</span>
                <span><span class="inline-block w-3 h-3 rounded bg-blue-100 border border-blue-300 mr-1"></span> Upcoming</span>
                <span><span class="inline-block w-3 h-3 rounded bg-green-100 border border-green-300 mr-1"></span> Went to Session</span>
                <span><span class="inline-block w-3 h-3 rounded bg-red-100 border border-red-300 mr-1"></span> Cancelled</span>
                <span><span class="inline-block w-3 h-3 rounded bg-yellow-100 border border-yellow-300 mr-1"></span> Did Not Show Up</span>
            </div>
        </div>
    </div>

    {!-- Status Legend + Appointment Notes --}
    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
            <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Status Legend</h3>
            <div class="space-y-2.5">
                <div class="flex items-center gap-3 text-sm text-gray-600">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-green-100 text-green-700 text-xs font-semibold w-36 flex-shrink-0">
                        <i class="fas fa-check-circle text-[10px]"></i> Went to Session
                    </span>
                    <span class="text-xs">Student attended the scheduled session</span>
                </div>
                <div class="flex items-center gap-3 text-sm text-gray-600">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-orange-100 text-orange-700 text-xs font-semibold w-36 flex-shrink-0">
                        <i class="fas fa-clock text-[10px]"></i> Did Not Show Up
                    </span>
                    <span class="text-xs">Student did not attend the scheduled session</span>
                </div>
                <div class="flex items-center gap-3 text-sm text-gray-600">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-red-100 text-red-700 text-xs font-semibold w-36 flex-shrink-0">
                        <i class="fas fa-times-circle text-[10px]"></i> Cancelled
                    </span>
                    <span class="text-xs">Scheduled appointment was cancelled</span>
                </div>
                <div class="flex items-center gap-3 text-sm text-gray-600">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-700 text-xs font-semibold w-36 flex-shrink-0">
                        <i class="fas fa-calendar-check text-[10px]"></i> Upcoming
                    </span>
                    <span class="text-xs">Appointment is scheduled</span>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
            <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Appointment Notes</h3>
            <ul class="space-y-2.5 text-xs text-gray-600">
                <li class="flex items-start gap-2">
                    <i class="fas fa-dot-circle text-teal-400 mt-0.5 flex-shrink-0"></i>
                    You can update the status of an appointment by clicking the action menu.
                </li>
                <li class="flex items-start gap-2">
                    <i class="fas fa-dot-circle text-teal-400 mt-0.5 flex-shrink-0"></i>
                    For "Did Not Show Up" appointments, you may reschedule or mark the session as completed if it happened at another time.
                </li>
            </ul>
        </div>
    </div>

    </div>

{/ikb_section}

{/block}

