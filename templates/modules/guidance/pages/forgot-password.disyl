{!-- Forgot Password Page - No layout extends (guest view) --}
{@var string $login_page_url}
{@var string $base_url}
{@var string $csrf_token}
{@var string $page_title}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - Guidance Monitoring System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/assets/guidance/css/app.css">
    <script>
        var APP_BASE = '{base_url}';
        var FORGOT_PASSWORD_ENDPOINT = '{forgot_password_endpoint}';
        var LOGIN_PAGE_URL = '{login_page_url}';
    </script>
</head>
<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-indigo-500 to-purple-600 py-12 px-4">

    <div class="max-w-md w-full">
        {!-- Logo & Title --}
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-20 h-20 bg-white rounded-full shadow-lg mb-4">
                <i class="fas fa-heart-pulse text-indigo-600 text-3xl"></i>
            </div>
            <h1 class="text-3xl font-bold text-white">Guidance</h1>
            <p class="text-indigo-200 mt-2">Monitoring System</p>
        </div>

        {!-- Forgot Password Card --}
        <div class="bg-white rounded-2xl shadow-xl p-8">
            <h2 class="text-2xl font-bold text-gray-800 text-center mb-2">Forgot Password</h2>
            <p class="text-gray-500 text-center text-sm mb-6">Enter your username or email and we'll send you a reset link.</p>

            {!-- Messages --}
            <div id="forgot-error" class="hidden mb-4 p-4 bg-red-50 border-l-4 border-red-500 text-red-700 rounded text-sm">
                <i class="fas fa-exclamation-circle mr-2"></i>
                <span id="error-message"></span>
            </div>
            <div id="forgot-success" class="hidden mb-4 p-4 bg-green-50 border-l-4 border-green-500 text-green-700 rounded text-sm">
                <i class="fas fa-check-circle mr-2"></i>
                <span id="success-message"></span>
            </div>

            {!-- Form --}
            <form id="forgot-form" class="space-y-5">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Username or Email</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                            <i class="fas fa-envelope"></i>
                        </span>
                        <input type="text" name="identity" required
                               class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                               placeholder="your.username or you@school.edu">
                    </div>
                </div>

                <button type="submit" id="submit-btn"
                        class="w-full py-3 bg-indigo-600 text-white rounded-lg font-medium hover:bg-indigo-700 transition flex items-center justify-center">
                    <i class="fas fa-paper-plane mr-2"></i> Send Reset Link
                </button>
            </form>

            <div class="mt-6 text-center">
                <a href="{login_page_url}" class="text-sm text-indigo-600 hover:underline">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Login
                </a>
            </div>
        </div>

        <p class="text-center text-indigo-200 text-sm mt-6">
            Powered by <strong>DiSyL</strong> + <strong>Ikabud CMS</strong>
        </p>
    </div>

    <script>
    document.getElementById('forgot-form').addEventListener('submit', async function(e) {
        e.preventDefault();
        var btn = document.getElementById('submit-btn');
        var errorDiv = document.getElementById('forgot-error');
        var successDiv = document.getElementById('forgot-success');

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Sending...';
        errorDiv.classList.add('hidden');
        successDiv.classList.add('hidden');

        try {
            var resp = await fetch(FORGOT_PASSWORD_ENDPOINT, {
                method: 'POST',
                body: new FormData(this)
            });
            var data = await resp.json();

            if (data.ok || data.success) {
                successDiv.classList.remove('hidden');
                document.getElementById('success-message').textContent = data.message;
                this.reset();
            } else {
                errorDiv.classList.remove('hidden');
                document.getElementById('error-message').textContent = data.error || 'Something went wrong';
            }
        } catch (err) {
            errorDiv.classList.remove('hidden');
            document.getElementById('error-message').textContent = 'Connection error. Please try again.';
        }

        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paper-plane mr-2"></i> Send Reset Link';
    });
    </script>
</body>
</html>

