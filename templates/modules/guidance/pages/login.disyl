{!-- Login Page - No layout extends (guest view) --}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - {app_name}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <link rel="icon" type="image/svg+xml" href="/assets/guidance/favicon.svg">
    <link rel="stylesheet" href="/assets/guidance/css/app.css">
    <script>
        var APP_BASE = '{base_url}';
        var APP_COOKIE = '{cookie_name}';
        var FORGOT_PASSWORD_ENDPOINT = '{forgot_password_endpoint}';
        document.addEventListener('htmx:configRequest', function(evt) {
            var path = evt.detail.path;
            if (path && path.charAt(0) === '/' && path.indexOf(APP_BASE) !== 0) {
                evt.detail.path = APP_BASE + path;
            }
        });
    </script>
    <style>
        .gms-card   { border-radius: 3px !important; }
        .gms-input  { border-radius: 3px !important; }
        .gms-btn    { border-radius: 3px !important; }
        .gms-alert  { border-radius: 3px !important; }
        .gms-avatar { border-radius: 40px !important; }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-teal-600 to-emerald-700 py-12 px-4">
    
    <div class="max-w-md w-full">
        {!-- Logo & Title --}
        <div class="text-center mb-8">
            <div class="gms-avatar inline-flex items-center justify-center w-20 h-20 bg-white shadow-lg mb-4">
                <i class="fas fa-heart-pulse text-teal-600 text-3xl"></i>
            </div>
            <h1 class="text-3xl font-bold text-white">{app_name}</h1>
        </div>
        
        {!-- Login Card --}
        <div class="gms-card bg-white shadow-xl p-8">
            <h2 class="text-2xl font-bold text-gray-800 text-center mb-6" id="card-title">Welcome Back</h2>

            {!-- Message Banner --}
            <div id="login-message" class="gms-alert hidden mb-4 p-4 border-l-4 text-sm">
                <i class="fas fa-exclamation-circle mr-2" id="message-icon"></i>
                <span id="message-text"></span>
            </div>

            {!-- ① Login Form --}
            <form id="login-form" class="space-y-5">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Username or Email</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                            <i class="fas fa-envelope"></i>
                        </span>
                        <input type="text" name="identity" required
                               class="gms-input w-full pl-10 pr-4 py-3 border border-gray-300 focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                               placeholder="your.username or you@school.edu">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Password</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                            <i class="fas fa-lock"></i>
                        </span>
                        <input type="password" name="password" required id="login-password"
                               class="gms-input w-full pl-10 pr-10 py-3 border border-gray-300 focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                               placeholder="••••••••">
                        <button type="button" id="toggle-pw" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="flex items-center justify-between">
                    <label class="flex items-center">
                        <input type="checkbox" name="remember" class="gms-input rounded border-gray-300 text-teal-600 focus:ring-teal-500">
                        <span class="ml-2 text-sm text-gray-600">Remember me</span>
                    </label>
                    <a href="/guidance/forgot-password" id="show-forgot" class="text-sm text-teal-700 hover:underline font-medium">Forgot password?</a>
                </div>

                <button type="submit" id="login-submit"
                        class="gms-btn w-full py-3 bg-teal-600 text-white font-semibold hover:bg-teal-700 transition flex items-center justify-center">
                    Sign In
                </button>
            </form>

            {!-- ② OTP Verification Panel --}
            <div id="otp-panel" class="hidden space-y-5">
                <div class="gms-alert border border-teal-200 bg-teal-50 p-4 text-sm text-teal-800">
                    <p class="font-medium">Verification required</p>
                    <p class="mt-1">Enter the 6-digit code sent to <span id="otp-email" class="font-semibold"></span> to finish signing in.</p>
                </div>

                <form id="otp-form" class="space-y-5">
                    <input type="hidden" name="ticket" id="otp-ticket">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Verification Code</label>
                        <input type="text" name="code" id="otp-code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]*" maxlength="6" required
                               class="gms-input w-full px-4 py-3 text-center tracking-[0.4em] text-lg font-semibold border border-gray-300 focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                               placeholder="000000">
                    </div>
                    <button type="submit" id="otp-submit"
                            class="gms-btn w-full py-3 bg-teal-600 text-white font-semibold hover:bg-teal-700 transition flex items-center justify-center">
                        Verify &amp; Continue
                    </button>
                </form>

                <div class="flex items-center justify-between text-sm">
                    <button type="button" id="otp-back" class="text-gray-600 hover:text-gray-900">Use different credentials</button>
                    <button type="button" id="otp-resend" class="text-teal-700 hover:underline">Resend code</button>
                </div>
            </div>

            {!-- ③ Forgot Password Panel --}
            <div id="forgot-panel" class="hidden space-y-5">
                <p class="text-sm text-gray-500 text-center">Enter your username or email and we'll send you a reset link.</p>

                <form id="forgot-form" class="space-y-5">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Username or Email</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                                <i class="fas fa-envelope"></i>
                            </span>
                            <input type="text" name="identity" required
                                   class="gms-input w-full pl-10 pr-4 py-3 border border-gray-300 focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                                   placeholder="your.username or you@school.edu">
                        </div>
                    </div>
                    <button type="submit" id="forgot-submit"
                            class="gms-btn w-full py-3 bg-teal-600 text-white font-semibold hover:bg-teal-700 transition flex items-center justify-center">
                        <i class="fas fa-paper-plane mr-2"></i> Send Reset Link
                    </button>
                </form>

                <div class="text-center">
                    <button type="button" id="back-to-login" class="text-sm text-teal-700 hover:underline">
                        <i class="fas fa-arrow-left mr-1"></i> Back to Login
                    </button>
                </div>
            </div>
        </div>

        {!-- Footer --}
        <p class="text-center text-teal-100 text-sm mt-6">
            Powered by <strong>DiSyL</strong> + <strong>Ikabud CMS</strong>
        </p>
    </div>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // --- Elements ---
            const cardTitle   = document.getElementById('card-title');
            const msgBanner   = document.getElementById('login-message');
            const msgIcon     = document.getElementById('message-icon');
            const msgText     = document.getElementById('message-text');

            const loginForm   = document.getElementById('login-form');
            const loginSubmit = document.getElementById('login-submit');
            const togglePw    = document.getElementById('toggle-pw');
            const pwInput     = document.getElementById('login-password');
            const showForgot  = document.getElementById('show-forgot');

            const otpPanel    = document.getElementById('otp-panel');
            const otpForm     = document.getElementById('otp-form');
            const otpEmail    = document.getElementById('otp-email');
            const otpTicket   = document.getElementById('otp-ticket');
            const otpCode     = document.getElementById('otp-code');
            const otpBack     = document.getElementById('otp-back');
            const otpResend   = document.getElementById('otp-resend');
            const otpSubmit   = document.getElementById('otp-submit');

            const forgotPanel  = document.getElementById('forgot-panel');
            const forgotForm   = document.getElementById('forgot-form');
            const forgotSubmit = document.getElementById('forgot-submit');
            const backToLogin  = document.getElementById('back-to-login');

            let activeOtpTicket = '';
            let activeRedirect  = '/admin/guidance';

            // --- Password toggle ---
            togglePw.addEventListener('click', function() {
                var icon = this.querySelector('i');
                if (pwInput.type === 'password') {
                    pwInput.type = 'text';
                    icon.classList.replace('fa-eye', 'fa-eye-slash');
                } else {
                    pwInput.type = 'password';
                    icon.classList.replace('fa-eye-slash', 'fa-eye');
                }
            });

            // --- Message helpers ---
            function showMessage(msg, type) {
                var t = type || 'error';
                msgBanner.className = 'gms-alert mb-4 p-4 border-l-4 text-sm';
                if (t === 'info' || t === 'success') {
                    msgBanner.classList.add('bg-teal-50', 'border-teal-500', 'text-teal-800');
                    msgIcon.className = 'fas fa-info-circle mr-2';
                } else {
                    msgBanner.classList.add('bg-red-50', 'border-red-500', 'text-red-700');
                    msgIcon.className = 'fas fa-exclamation-circle mr-2';
                }
                msgText.textContent = msg;
            }
            function hideMessage() {
                msgBanner.classList.add('hidden');
            }

            // --- Panel switching ---
            function showPanel(name) {
                loginForm.classList.add('hidden');
                otpPanel.classList.add('hidden');
                forgotPanel.classList.add('hidden');
                hideMessage();
                if (name === 'login')  { loginForm.classList.remove('hidden');  cardTitle.textContent = 'Welcome Back'; }
                if (name === 'otp')    { otpPanel.classList.remove('hidden');   cardTitle.textContent = 'Verify Your Sign In'; }
                if (name === 'forgot') { forgotPanel.classList.remove('hidden'); cardTitle.textContent = 'Reset Password'; }
            }

            // --- Submit state helpers ---
            function setBusy(btn, busy, idleHtml) {
                btn.disabled = busy;
                btn.innerHTML = busy ? '<i class="fas fa-spinner fa-spin mr-2"></i> Please wait...' : idleHtml;
            }

            function completeLogin(data) {
                window.location.href = (data && data.redirect) ? data.redirect : '/admin/guidance';
            }

            // --- Login form ---
            loginForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                setBusy(loginSubmit, true, 'Sign In');
                hideMessage();
                try {
                    var resp = await fetch(APP_BASE + '/api/auth/login', { method: 'POST', body: new FormData(loginForm) });
                    var data = await resp.json();
                    if (data && data.requires_otp) {
                        activeOtpTicket = data.ticket || '';
                        activeRedirect  = data.redirect || '/admin/guidance';
                        otpTicket.value = activeOtpTicket;
                        otpEmail.textContent = data.masked_email || 'your email address';
                        otpCode.value = '';
                        showPanel('otp');
                        otpCode.focus();
                    } else if (data && (data.ok || data.success)) {
                        completeLogin(data);
                    } else {
                        showMessage((data && data.error) || 'Invalid credentials');
                        setBusy(loginSubmit, false, 'Sign In');
                    }
                } catch (err) {
                    showMessage('Connection error. Please try again.');
                    setBusy(loginSubmit, false, 'Sign In');
                }
            });

            // --- OTP form ---
            otpForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                setBusy(otpSubmit, true, 'Verify &amp; Continue');
                hideMessage();
                try {
                    var resp = await fetch(APP_BASE + '/api/auth/verify-otp', { method: 'POST', body: new FormData(otpForm) });
                    var data = await resp.json();
                    if (data && (data.ok || data.success)) {
                        completeLogin({ redirect: data.redirect || activeRedirect });
                    } else {
                        showMessage((data && data.error) || 'Unable to verify the code.');
                        setBusy(otpSubmit, false, 'Verify &amp; Continue');
                    }
                } catch (err) {
                    showMessage('Connection error. Please try again.');
                    setBusy(otpSubmit, false, 'Verify &amp; Continue');
                }
            });

            otpBack.addEventListener('click', function() { showPanel('login'); });

            otpResend.addEventListener('click', async function() {
                if (!activeOtpTicket) { showPanel('login'); return; }
                setBusy(otpSubmit, true, 'Verify &amp; Continue');
                hideMessage();
                try {
                    var fd = new FormData();
                    fd.append('ticket', activeOtpTicket);
                    var resp = await fetch(APP_BASE + '/api/auth/resend-otp', { method: 'POST', body: fd });
                    var data = await resp.json();
                    if (data && data.requires_otp) {
                        activeOtpTicket = data.ticket || activeOtpTicket;
                        otpTicket.value = activeOtpTicket;
                        showMessage(data.message || 'A new code was sent.', 'info');
                        setBusy(otpSubmit, false, 'Verify &amp; Continue');
                    } else {
                        showMessage((data && data.error) || 'Unable to resend.');
                        setBusy(otpSubmit, false, 'Verify &amp; Continue');
                    }
                } catch (err) {
                    showMessage('Connection error. Please try again.');
                    setBusy(otpSubmit, false, 'Verify &amp; Continue');
                }
            });

            // --- Forgot password ---
            showForgot.addEventListener('click', function() { showPanel('forgot'); });
            backToLogin.addEventListener('click', function() { showPanel('login'); });

            forgotForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                setBusy(forgotSubmit, true, '<i class="fas fa-paper-plane mr-2"></i> Send Reset Link');
                hideMessage();
                try {
                    var endpoint = (typeof FORGOT_PASSWORD_ENDPOINT !== 'undefined' && FORGOT_PASSWORD_ENDPOINT)
                        ? FORGOT_PASSWORD_ENDPOINT
                        : APP_BASE + '/api/v1/guidance/auth/forgot-password';
                    var resp = await fetch(endpoint, { method: 'POST', body: new FormData(forgotForm) });
                    var data = await resp.json();
                    if (data.ok || data.success) {
                        showMessage(data.message || 'If that account exists, a reset link has been sent.', 'success');
                        forgotForm.reset();
                    } else {
                        showMessage(data.error || 'Something went wrong. Please try again.');
                    }
                } catch (err) {
                    showMessage('Connection error. Please try again.');
                }
                setBusy(forgotSubmit, false, '<i class="fas fa-paper-plane mr-2"></i> Send Reset Link');
            });
        });
    </script>
</body>
</html>
