{extends "modules/guidance/layouts/app.disyl"}

{block content}
<div class="max-w-2xl mx-auto">
    <div class="bg-white border border-gray-200 rounded-xl p-6">
        <div class="mb-5">
            <h1 class="text-xl font-semibold text-gray-900">Profile</h1>
            <p class="text-sm text-gray-500 mt-1">Update your own account information.</p>
        </div>

        <div id="profile-msg" class="hidden mb-4 text-sm rounded-lg p-3"></div>

        <form id="profile-form" onsubmit="return submitProfile(event)">
            {csrf_field | raw}

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">First name</label>
                    <input id="first_name" name="first_name" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" type="text" value="{first_name}" required>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Last name</label>
                    <input id="last_name" name="last_name" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" type="text" value="{last_name}" required>
                </div>
            </div>

            <div class="mt-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
                <input id="phone" name="phone" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" type="tel" value="{phone}" placeholder="Optional">
            </div>

            <div class="mt-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                <input class="w-full px-4 py-2.5 border border-gray-200 rounded-lg bg-gray-50 text-gray-600" type="email" value="{email}" disabled>
                <p class="text-xs text-gray-500 mt-1">Email cannot be changed.</p>
            </div>

            <div class="mt-5 border-t border-gray-100 pt-5">
                <div class="flex items-center justify-between mb-2">
                    <h2 class="text-sm font-semibold text-gray-900">Change password</h2>
                    <span class="text-xs text-gray-500">Optional</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">New password</label>
                        <input id="password" name="password" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" type="password" placeholder="Leave blank to keep current">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Confirm password</label>
                        <input id="password_confirm" name="password_confirm" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" type="password" placeholder="Repeat new password">
                    </div>
                </div>
            </div>

            <div class="mt-6 flex items-center gap-3">
                <button id="profile-save" type="submit" class="px-4 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-semibold">Save changes</button>
                <a href="/admin/guidance" class="px-4 py-2.5 rounded-lg border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold">Back</a>
            </div>
        </form>
    </div>
</div>

<script>
async function submitProfile(e) {
    e.preventDefault();

    const btn = document.getElementById('profile-save');
    const msg = document.getElementById('profile-msg');

    const first = document.getElementById('first_name').value.trim();
    const last = document.getElementById('last_name').value.trim();
    const phone = document.getElementById('phone').value.trim();
    const pass = document.getElementById('password').value;
    const pass2 = document.getElementById('password_confirm').value;
    const csrf = document.querySelector('input[name="_token"]')?.value || '';

    msg.classList.add('hidden');
    msg.textContent = '';

    if (first === '' || last === '') {
        msg.className = 'mb-4 text-sm rounded-lg p-3 bg-red-50 text-red-700';
        msg.textContent = 'First and last name are required.';
        msg.classList.remove('hidden');
        return false;
    }

    if (pass !== '' && pass.length < 8) {
        msg.className = 'mb-4 text-sm rounded-lg p-3 bg-red-50 text-red-700';
        msg.textContent = 'Password must be at least 8 characters.';
        msg.classList.remove('hidden');
        return false;
    }

    if (pass !== '' && pass !== pass2) {
        msg.className = 'mb-4 text-sm rounded-lg p-3 bg-red-50 text-red-700';
        msg.textContent = 'Passwords do not match.';
        msg.classList.remove('hidden');
        return false;
    }

    btn.disabled = true;
    const oldText = btn.textContent;
    btn.textContent = 'Saving...';

    try {
        const res = await fetch('/admin/guidance/api/profile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ _token: csrf, first_name: first, last_name: last, phone: phone, password: pass })
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok || !data.ok) {
            msg.className = 'mb-4 text-sm rounded-lg p-3 bg-red-50 text-red-700';
            msg.textContent = data.error || 'Failed to update profile.';
            msg.classList.remove('hidden');
            return false;
        }

        msg.className = 'mb-4 text-sm rounded-lg p-3 bg-green-50 text-green-700';
        msg.textContent = 'Profile updated.';
        msg.classList.remove('hidden');

        document.getElementById('password').value = '';
        document.getElementById('password_confirm').value = '';

        setTimeout(() => window.location.reload(), 900);
        return false;
    } catch (err) {
        msg.className = 'mb-4 text-sm rounded-lg p-3 bg-red-50 text-red-700';
        msg.textContent = 'Failed to update profile.';
        msg.classList.remove('hidden');
        return false;
    } finally {
        btn.disabled = false;
        btn.textContent = oldText;
    }
}
</script>
{/block}
