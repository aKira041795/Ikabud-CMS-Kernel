{extends "modules/guidance/layouts/app.disyl"}

{block content}
{!-- Add New Student - Full Page --}

{ikb_section padding="none"}

    {!-- Breadcrumb --}
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
        <a href="{base_url}/cases"
           hx-get="/pages/cases"
           hx-target="#main-content"
           hx-push-url="{base_url}/cases"
           class="hover:text-teal-600 transition">Students</a>
        <i class="fas fa-chevron-right text-xs text-gray-400"></i>
        <span class="text-gray-700 font-medium">Add New Student</span>
    </nav>

    {!-- 2-column layout: Quick Stats sidebar + Form --}
    <div class="flex gap-6 items-start">

        {!-- Quick Stats Sidebar --}
        <div class="w-60 flex-shrink-0 sticky top-6">
            <div id="case-stats-panel"
                 hx-get="/api/cases/stats"
                 hx-trigger="load"
                 hx-swap="innerHTML"
                 hx-history="false">
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 space-y-3 animate-pulse">
                    <div class="h-3 bg-gray-200 rounded w-24"></div>
                    <div class="h-6 bg-gray-200 rounded w-16"></div>
                    <div class="border-t pt-3 space-y-3">
                        <div class="h-4 bg-gray-200 rounded w-full"></div>
                        <div class="h-4 bg-gray-200 rounded w-full"></div>
                        <div class="h-4 bg-gray-200 rounded w-full"></div>
                        <div class="h-4 bg-gray-200 rounded w-full"></div>
                    </div>
                </div>
            </div>
        </div>

        {!-- Form Area --}
        <div class="flex-1 min-w-0">
            <form id="student-form"
                  hx-post="/api/cases"
                  hx-swap="none"
                  class="space-y-6">

                {!-- CSRF --}

                {!-- ── 1. STUDENT INFORMATION ──────────────────────── --}
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="border-b border-gray-100 px-6 py-4 flex items-center gap-3">
                        <div class="w-8 h-8 bg-teal-50 rounded-lg flex items-center justify-center">
                            <i class="fas fa-user text-teal-600 text-sm"></i>
                        </div>
                        <h2 class="text-base font-semibold text-gray-900">Student Information</h2>
                    </div>

                    {!-- Hidden combined student_name (updated by JS) --}
                    <input type="hidden" name="student_name" id="inp-student-name">

                    <div class="p-6">
                        <div class="flex gap-6">
                            {!-- Left: form fields --}
                            <div class="flex-1 min-w-0 grid grid-cols-1 md:grid-cols-2 gap-4">

                                {!-- Client Code --}
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-client-code">
                                        Client Code <span class="text-red-500">*</span>
                                    </label>
                                    <input type="text" id="inp-client-code" name="client_code" required
                                           placeholder="e.g. CC-2024-001"
                                           class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                </div>

                                {!-- Spacer row to keep layout aligned --}
                                <div></div>

                                {!-- Last Name --}
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-last-name">
                                        Last Name <span class="text-red-500">*</span>
                                    </label>
                                    <input type="text" id="inp-last-name" required
                                           placeholder="Last name"
                                           oninput="updateStudentNameField()"
                                           class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                </div>

                                {!-- First Name --}
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-first-name">
                                        First Name <span class="text-red-500">*</span>
                                    </label>
                                    <input type="text" id="inp-first-name" required
                                           placeholder="First name"
                                           oninput="updateStudentNameField()"
                                           class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                </div>

                                {!-- Middle Name --}
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-middle-name">
                                        Middle Name
                                    </label>
                                    <input type="text" id="inp-middle-name"
                                           placeholder="Middle name (optional)"
                                           oninput="updateStudentNameField()"
                                           class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                </div>

                                {!-- Gender --}
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-gender">
                                        Gender <span class="text-red-500">*</span>
                                    </label>
                                    <select id="inp-gender" name="gender" required
                                            class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                        <option value="">Select gender</option>
                                        <option value="male">Male</option>
                                        <option value="female">Female</option>
                                        <option value="other">Other / Prefer not to say</option>
                                    </select>
                                </div>

                                {!-- Date of Birth --}
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-dob">
                                        Date of Birth <span class="text-red-500">*</span>
                                    </label>
                                    <input type="date" id="inp-dob" name="date_of_birth" required
                                           class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                </div>

                                {!-- Contact No. --}
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-mobile">
                                        Contact No. <span class="text-red-500">*</span>
                                    </label>
                                    <input type="tel" id="inp-mobile" name="student_mobile" required
                                           placeholder="e.g. 09171234567"
                                           class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                </div>

                                {!-- Email Address --}
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-email">
                                        Email Address
                                    </label>
                                    <input type="email" id="inp-email" name="student_email"
                                           placeholder="student@example.com"
                                           class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                </div>

                                {!-- Course / College --}
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-college">
                                        Course / College <span class="text-red-500">*</span>
                                    </label>
                                    <select id="inp-college" name="college_id" required
                                            class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                        <option value="">Select course / college</option>
                                        {foreach colleges as col}
                                        <option value="{col.id}">{col.name} ({col.code})</option>
                                        {/foreach}
                                    </select>
                                </div>

                                {!-- Year Level --}
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-year-level">
                                        Year Level <span class="text-red-500">*</span>
                                    </label>
                                    <select id="inp-year-level" name="student_grade" required
                                            class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                        <option value="">Select year level</option>
                                        <option value="1">1st Year</option>
                                        <option value="2">2nd Year</option>
                                        <option value="3">3rd Year</option>
                                        <option value="4">4th Year</option>
                                        <option value="5">5th Year</option>
                                        <option value="graduate">Graduate</option>
                                    </select>
                                </div>

                                {!-- Section --}
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-section">
                                        Section
                                    </label>
                                    <input type="text" id="inp-section" name="student_section"
                                           placeholder="e.g. A, Block 1"
                                           class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                </div>

                                {!-- Student ID --}
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-student-id">
                                        Student ID <span class="text-xs text-gray-400">(Optional)</span>
                                    </label>
                                    <input type="text" id="inp-student-id" name="student_id"
                                           placeholder="Institutional student ID"
                                           class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                </div>

                            </div>

                            {!-- Right: Tips panel --}
                            <div class="w-56 flex-shrink-0">
                                <div class="bg-teal-600 rounded-xl p-5 text-white">
                                    <div class="flex items-center gap-2 mb-4">
                                        <i class="fas fa-lightbulb text-teal-200 text-sm"></i>
                                        <h4 class="text-sm font-semibold">Tips</h4>
                                    </div>
                                    <ul class="space-y-3 text-xs text-teal-100 leading-relaxed">
                                        <li class="flex items-start gap-2">
                                            <i class="fas fa-check-circle text-teal-300 mt-0.5 flex-shrink-0"></i>
                                            <span>Use the student's full legal name as it appears in official school records.</span>
                                        </li>
                                        <li class="flex items-start gap-2">
                                            <i class="fas fa-check-circle text-teal-300 mt-0.5 flex-shrink-0"></i>
                                            <span>Client Code is your internal reference — keep it unique and consistent.</span>
                                        </li>
                                        <li class="flex items-start gap-2">
                                            <i class="fas fa-check-circle text-teal-300 mt-0.5 flex-shrink-0"></i>
                                            <span>Contact information helps follow-up and is treated as confidential.</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                        </div>{!-- /flex --}
                    </div>{!-- /p-6 --}
                </div>

                {!-- ── 2. MONITORING INFORMATION ───────────────────── --}
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="border-b border-gray-100 px-6 py-4 flex items-center gap-3">
                        <div class="w-8 h-8 bg-amber-50 rounded-lg flex items-center justify-center">
                            <i class="fas fa-shield-alt text-amber-600 text-sm"></i>
                        </div>
                        <h2 class="text-base font-semibold text-gray-900">Monitoring Information</h2>
                    </div>
                    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">

                        {!-- Overall Status --}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-student-status">
                                Overall Status <span class="text-red-500">*</span>
                            </label>
                            <select id="inp-student-status" name="student_status"
                                    class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                <option value="">Select overall status</option>
                                <option value="regular">Regular</option>
                                <option value="irregular">Irregular</option>
                                <option value="probationary">Probationary</option>
                                <option value="returnee">Returnee</option>
                                <option value="transferee">Transferee</option>
                            </select>
                        </div>

                        {!-- Severity / Risk Level --}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-severity">
                                Severity / Risk Level <span class="text-red-500">*</span>
                            </label>
                            <select id="inp-severity" name="severity" required
                                    class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                <option value="">Select risk level</option>
                                <option value="low">Low Risk</option>
                                <option value="medium">Moderate Risk</option>
                                <option value="high">High Risk</option>
                                <option value="critical">Critical</option>
                            </select>
                        </div>

                        {!-- Case Status --}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-case-status">
                                Case Status <span class="text-red-500">*</span>
                            </label>
                            <select id="inp-case-status" name="status" required
                                    class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                <option value="open" selected>Open</option>
                                <option value="in_progress">In Progress</option>
                                <option value="on_hold">On Hold</option>
                            </select>
                        </div>

                        {!-- Category --}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-category">
                                Category
                            </label>
                            <select id="inp-category" name="category"
                                    class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                <option value="general">General</option>
                                <option value="academic">Academic</option>
                                <option value="behavioral">Behavioral</option>
                                <option value="emotional">Emotional</option>
                                <option value="family">Family</option>
                                <option value="peer">Peer Relations</option>
                                <option value="career">Career</option>
                                <option value="crisis">Crisis</option>
                            </select>
                        </div>

                        {!-- Reason for Monitoring (full width) --}
                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-presenting-issue">
                                Reason for Monitoring <span class="text-red-500">*</span>
                            </label>
                            <textarea id="inp-presenting-issue" name="presenting_issue" required rows="3"
                                      placeholder="Describe the presenting issue or reason this student is being monitored..."
                                      class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 resize-none"></textarea>
                        </div>

                        {!-- Counselor (admin/supervisor only) --}
                        {if is_admin}
                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-counselor">
                                Assign Counselor <span class="text-red-500">*</span>
                            </label>
                            <select id="inp-counselor" name="counselor_id" required
                                    class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                <option value="">Select counselor...</option>
                                {foreach counselors as c}
                                <option value="{c.id}">{c.name}</option>
                                {/foreach}
                            </select>
                        </div>
                        {/if}

                    </div>
                </div>

                {!-- ── 3. SCHEDULE INITIAL SESSION ─────────────────── --}
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="border-b border-gray-100 px-6 py-4 flex items-center gap-3">
                        <div class="w-8 h-8 bg-blue-50 rounded-lg flex items-center justify-center">
                            <i class="fas fa-calendar-alt text-blue-600 text-sm"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-semibold text-gray-900">Schedule Initial Session</h2>
                            <p class="text-xs text-gray-400 mt-0.5">Required to open a new student case</p>
                        </div>
                    </div>
                    <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">

                        {!-- Appointment Type --}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-appt-type">
                                Session Type <span class="text-red-500">*</span>
                            </label>
                            <select id="inp-appt-type" name="appointment_type_id" required
                                    class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500">
                                <option value="">Select session type</option>
                                {foreach appointment_types as t}
                                <option value="{t.id}">{t.name}</option>
                                {/foreach}
                            </select>
                        </div>

                        {!-- Date --}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-appt-date">
                                Date <span class="text-red-500">*</span>
                            </label>
                            <input type="date" id="inp-appt-date" name="appointment_date" required
                                   min="{today}"
                                   class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500"
                                   hx-get="/api/appointments/slots"
                                   hx-target="#new-slot-container"
                                   hx-include="#inp-appt-type"
                                   hx-trigger="change">
                        </div>

                        {!-- Time Slots --}
                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium text-gray-700 mb-1">
                                Available Time Slots <span class="text-red-500">*</span>
                            </label>
                            <div id="new-slot-container" class="grid grid-cols-4 gap-2">
                                <div class="col-span-4 text-center py-4 text-gray-400 text-sm">
                                    <i class="fas fa-calendar mr-2"></i> Select a date to view available slots
                                </div>
                            </div>
                            <input type="hidden" name="appointment_time" id="inp-appt-time" required>
                        </div>

                    </div>
                </div>

                {!-- ── 4. ADDITIONAL INFORMATION ───────────────────── --}
                <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="border-b border-gray-100 px-6 py-4 flex items-center gap-3">
                        <div class="w-8 h-8 bg-gray-100 rounded-lg flex items-center justify-center">
                            <i class="fas fa-info-circle text-gray-500 text-sm"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-semibold text-gray-900">Additional Information</h2>
                            <p class="text-xs text-gray-400 mt-0.5">Optional</p>
                        </div>
                    </div>
                    <div class="p-6 space-y-4">

                        {!-- Initial Notes --}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1" for="inp-notes">
                                Initial Notes
                            </label>
                            <textarea id="inp-notes" name="background_info" rows="4"
                                      placeholder="Any background information, prior interventions, or relevant context..."
                                      class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 focus:border-teal-500 resize-none"></textarea>
                        </div>

                        {!-- Attachments (placeholder — server-side upload not wired yet) --}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                Attachments <span class="text-xs text-gray-400">(Optional)</span>
                            </label>
                            <div class="border-2 border-dashed border-gray-300 rounded-xl p-8 text-center hover:border-teal-400 transition-colors">
                                <i class="fas fa-cloud-upload-alt text-gray-300 text-3xl mb-3"></i>
                                <p class="text-sm text-gray-500">Drag &amp; drop files here, or <span class="text-teal-600 cursor-pointer hover:underline">browse</span></p>
                                <p class="text-xs text-gray-400 mt-1">PDF, DOC, JPG, PNG up to 10 MB</p>
                            </div>
                        </div>

                    </div>
                </div>

                {!-- ── FOOTER ──────────────────────────────────────── --}
                <div class="flex items-center justify-end gap-3 pt-2 pb-4">
                    <a href="{base_url}/cases"
                       hx-get="/pages/cases"
                       hx-target="#main-content"
                       hx-push-url="{base_url}/cases"
                       class="px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                        Cancel
                    </a>
                    <button type="submit"
                            class="px-6 py-2.5 text-sm font-semibold text-white bg-teal-600 rounded-lg hover:bg-teal-700 shadow-sm transition flex items-center gap-2">
                        <i class="fas fa-save"></i> Save Student
                    </button>
                </div>

            </form>
        </div>{!-- /form area --}
    </div>{!-- /2-column layout --}

{/ikb_section}

<script>
function updateStudentNameField() {
    var ln = (document.getElementById('inp-last-name').value || '').trim();
    var fn = (document.getElementById('inp-first-name').value || '').trim();
    var mn = (document.getElementById('inp-middle-name').value || '').trim();
    var parts = [ln, fn, mn].filter(function(p){ return p !== ''; });
    document.getElementById('inp-student-name').value = parts.join(' ');
}
</script>

{/block}
