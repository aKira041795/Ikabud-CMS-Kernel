{extends "modules/cms/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-xl font-bold text-slate-900">CMS Akira Navigation</h1>
            <p class="mt-0.5 text-sm text-slate-500">Navigation extension for the CMS Akira suite. Manage menus and site structure.</p>
        </div>
    </div>

    <!-- Contract card -->
    <div class="rounded-[28px] border border-slate-200 bg-white/92 shadow-[0_18px_40px_rgba(15,23,42,0.05)] p-8">
        <h2 class="text-base font-bold text-slate-900 mb-3">What this module provides</h2>
        <p class="text-sm text-slate-600 leading-relaxed">
            Resolves breadcrumb and navigation context for content pages through
            <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">akira.navigation.resolve@1</code>.
            Menu and menu-location ownership remains with the CMS module.
            When disabled, CMS Akira Core falls back to a minimal Home breadcrumb.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
            <span class="text-[11px] font-medium bg-slate-100 text-slate-600 rounded-full px-3 py-1">Exposes: <code>akira.navigation.resolve@1</code></span>
            <span class="text-[11px] font-medium bg-emerald-50 text-emerald-700 rounded-full px-3 py-1">Graceful fallback when disabled</span>
        </div>
    </div>

    <!-- Manage card -->
    <div class="rounded-[24px] border border-slate-200 bg-white/92 shadow-[0_18px_40px_rgba(15,23,42,0.05)] p-6">
        <div class="flex items-center justify-between gap-4">
            <div>
                <div class="font-semibold text-slate-900">Menus &amp; navigation</div>
                <p class="text-sm text-slate-500">Create and manage menus and menu locations in the CMS module.</p>
            </div>
            <a href="{base_url}/cms/admin/menus" class="shrink-0 text-sm font-medium text-sky-600 hover:text-sky-800 no-underline">Open Menus →</a>
        </div>
    </div>
</div>
{/block}
