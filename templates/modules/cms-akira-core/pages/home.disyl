{extends "modules/cms/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-xl font-bold text-slate-900">CMS Akira Core</h1>
            <p class="mt-0.5 text-sm text-slate-500">Product core for the CMS Akira suite. Foundation, providers, and shared infrastructure.</p>
        </div>
    </div>

    <!-- Status card -->
    <div class="rounded-[28px] border border-slate-200 bg-white/92 shadow-[0_18px_40px_rgba(15,23,42,0.05)] p-8 text-center">
        <div class="text-5xl mb-3">📦</div>
        <div class="font-semibold text-slate-800">Module scaffolded successfully</div>
        <p class="mt-1 text-sm text-slate-500">
            Build the Core surface in
            <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">modules/cms-akira-core/handlers.php</code>
            and
            <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">templates/modules/cms-akira-core/pages/home.disyl</code>.
        </p>
    </div>
</div>
{/block}
