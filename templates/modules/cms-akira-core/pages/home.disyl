{extends "modules/cms/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-xl font-bold text-slate-900">CMS Akira Core</h1>
            <p class="mt-0.5 text-sm text-slate-500">Product core for the CMS Akira suite. Provider boundaries, capability adapters, and graceful degradation.</p>
        </div>
    </div>

    <!-- Summary -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="rounded-[24px] border border-slate-200 bg-white/92 shadow-[0_18px_40px_rgba(15,23,42,0.05)] p-6">
            <div class="text-xs uppercase tracking-wider text-slate-400">Providers</div>
            <div class="text-2xl font-bold text-slate-900">{provider_total}</div>
        </div>
        <div class="rounded-[24px] border border-slate-200 bg-white/92 shadow-[0_18px_40px_rgba(15,23,42,0.05)] p-6">
            <div class="text-xs uppercase tracking-wider text-slate-400">Enabled</div>
            <div class="text-2xl font-bold text-emerald-600">{provider_enabled}</div>
        </div>
        <div class="rounded-[24px] border border-slate-200 bg-white/92 shadow-[0_18px_40px_rgba(15,23,42,0.05)] p-6">
            <div class="text-xs uppercase tracking-wider text-slate-400">Fallback mode</div>
            <div class="text-2xl font-bold text-amber-600">{provider_fallback}</div>
        </div>
    </div>

    <!-- Provider table -->
    <div class="rounded-[28px] border border-slate-200 bg-white/92 shadow-[0_18px_40px_rgba(15,23,42,0.05)] p-8">
        <h2 class="text-base font-bold text-slate-900 mb-4">Provider Boundary Status</h2>
        {if providers}
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-xs uppercase tracking-wider text-slate-400 border-b border-slate-200">
                        <th class="py-2 pr-4">Provider</th>
                        <th class="py-2 pr-4">Contract</th>
                        <th class="py-2 pr-4">Dependency</th>
                        <th class="py-2 pr-4">Enabled</th>
                        <th class="py-2 pr-4">Mode</th>
                    </tr>
                </thead>
                <tbody>
                {foreach providers as p}
                    <tr class="border-b border-slate-100">
                        <td class="py-2.5 pr-4 font-medium text-slate-900">{p.provider}</td>
                        <td class="py-2.5 pr-4 text-slate-500"><code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">{p.contract}</code></td>
                        <td class="py-2.5 pr-4 text-slate-500">{if p.dependency_module}{p.dependency_module}{else}core{/if}</td>
                        <td class="py-2.5 pr-4">
                            {if p.enabled}<span class="text-[10px] font-semibold uppercase tracking-wide bg-emerald-100 text-emerald-700 rounded-full px-2 py-0.5">On</span>
                            {else}<span class="text-[10px] font-semibold uppercase tracking-wide bg-slate-100 text-slate-500 rounded-full px-2 py-0.5">Off</span>{/if}
                        </td>
                        <td class="py-2.5 pr-4">
                            {if p.mode == 'provider'}<span class="text-[10px] font-semibold uppercase tracking-wide bg-sky-100 text-sky-700 rounded-full px-2 py-0.5">Provider</span>
                            {else}<span class="text-[10px] font-semibold uppercase tracking-wide bg-amber-100 text-amber-700 rounded-full px-2 py-0.5">Fallback</span>{/if}
                        </td>
                    </tr>
                {/foreach}
                </tbody>
            </table>
        </div>
        {else}
        <p class="text-sm text-slate-500">Provider runtime status is unavailable.</p>
        {/if}
    </div>
</div>
{/block}
