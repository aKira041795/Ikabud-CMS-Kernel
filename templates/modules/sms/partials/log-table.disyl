{if logs}
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Status</th>
                <th>Recipient</th>
                <th>Message</th>
                <th>Trigger</th>
                <th>Provider</th>
                <th>Sent By</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            {foreach logs as log}
            <tr>
                <td>
                    {if log.status == 'sent'}
                    <span class="sms-badge" style="background:var(--success-light);color:var(--success);">Sent</span>
                    {/if}
                    {if log.status == 'failed'}
                    <span class="sms-badge" style="background:var(--danger-light);color:var(--danger);" title="{log.error_message}">Failed</span>
                    {/if}
                    {if log.status == 'pending'}
                    <span class="sms-badge" style="background:var(--warning-light);color:var(--warning);">Pending</span>
                    {/if}
                    {if log.status == 'simulated'}
                    <span class="sms-badge" style="background:var(--primary-light);color:var(--primary);">Test</span>
                    {/if}
                </td>
                <td>
                    <div style="font-weight:600;">{log.recipient}</div>
                    {if log.recipient_name}<div class="text-sm text-muted">{log.recipient_name}</div>{/if}
                </td>
                <td style="max-width:240px;">
                    <div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="{log.message}">{log.message}</div>
                </td>
                <td>
                    {if log.trigger_event == 'manual'}<span class="text-muted">Manual</span>{/if}
                    {if log.trigger_event == 'test'}<span style="color:var(--primary);">Test</span>{/if}
                    {if log.trigger_event == 'daily_report'}<span style="color:var(--success);">Daily Report</span>{/if}
                </td>
                <td><span class="text-muted" style="text-transform:capitalize;">{log.provider}</span></td>
                <td><span class="text-muted">{log.sent_by_name | default:'System'}</span></td>
                <td><span class="text-muted">{log.created_at}</span></td>
            </tr>
            {/foreach}
        </tbody>
    </table>
</div>

{if pages > 1}
<div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:var(--bg);border-top:1px solid var(--border);">
    <span class="text-sm text-muted">Page {page} of {pages} ({total} total)</span>
    <div style="display:flex;gap:4px;">
        {if page > 1}
        <button class="btn btn-outline btn-sm" hx-get="/api/v1/modules/sms/log?page={page - 1}" hx-target="#sms-log-container">&laquo; Prev</button>
        {/if}
        {if page < pages}
        <button class="btn btn-outline btn-sm" hx-get="/api/v1/modules/sms/log?page={page + 1}" hx-target="#sms-log-container">Next &raquo;</button>
        {/if}
    </div>
</div>
{/if}

{else}
<div style="text-align:center;padding:48px 16px;color:var(--text-muted);">
    <div style="font-weight:600;">No SMS messages yet</div>
    <div class="text-sm" style="margin-top:4px;">Send your first SMS using the Compose button above</div>
</div>
{/if}
