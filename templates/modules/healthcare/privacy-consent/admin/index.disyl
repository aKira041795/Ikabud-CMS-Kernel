{extends "modules/ehr/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div>
            <div class="text-xs font-semibold uppercase tracking-[0.22em] text-teal-700">Governance</div>
            <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Privacy &amp; Consent</h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Review granted and revoked consents alongside active break-glass overrides before sensitive records are accessed.</p>
        </div>
    </section>

    <div class="grid gap-6 xl:grid-cols-2">
        <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 px-6 py-4">
                <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Recent Consents</h2>
            </div>
            <div class="divide-y divide-slate-100">
                {if consents}
                    {foreach consents as consent}
                    <div class="px-6 py-4">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <div class="text-base font-semibold text-slate-900">{consent.consent_type}</div>
                                <div class="mt-1 text-sm text-slate-600">{if consent.patient_summary}{consent.patient_summary.last_name}, {consent.patient_summary.first_name}{else}Unknown patient{/if}</div>
                            </div>
                            <div class="rounded-full bg-teal-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-teal-700">{consent.status}</div>
                        </div>
                        <div class="mt-3 grid gap-3 text-sm text-slate-600 md:grid-cols-3">
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Granted</div>
                                <div class="mt-1 text-slate-900">{consent.granted_at}</div>
                            </div>
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Expires</div>
                                <div class="mt-1 text-slate-900">{if consent.expires_at}{consent.expires_at}{else}No expiry{/if}</div>
                            </div>
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Revoked</div>
                                <div class="mt-1 text-slate-900">{if consent.revoked_at}{consent.revoked_at}{else}Active{/if}</div>
                            </div>
                        </div>
                    </div>
                    {/foreach}
                {else}
                    <div class="px-6 py-12 text-center text-sm text-slate-600">No consent records are available.</div>
                {/if}
            </div>
        </section>

        <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 px-6 py-4">
                <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Break-Glass Events</h2>
            </div>
            <div class="divide-y divide-slate-100">
                {if break_glass_events}
                    {foreach break_glass_events as event}
                    <div class="px-6 py-4">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <div class="text-base font-semibold text-slate-900">{event.object_type}</div>
                                <div class="mt-1 text-sm text-slate-600">{if event.patient_summary}{event.patient_summary.last_name}, {event.patient_summary.first_name}{else}Unknown patient{/if}</div>
                            </div>
                            <div class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-amber-700">{event.status}</div>
                        </div>
                        <div class="mt-3 text-sm leading-6 text-slate-700">{event.reason_text}</div>
                        <div class="mt-3 grid gap-3 text-sm text-slate-600 md:grid-cols-2">
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Granted</div>
                                <div class="mt-1 text-slate-900">{event.granted_at}</div>
                            </div>
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Window Ends</div>
                                <div class="mt-1 text-slate-900">{event.granted_until}</div>
                            </div>
                        </div>
                    </div>
                    {/foreach}
                {else}
                    <div class="px-6 py-12 text-center text-sm text-slate-600">No active break-glass events are available.</div>
                {/if}
            </div>
        </section>
    </div>

    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Record Consent</h2>
        {if form_notice == 'consent_recorded'}<div class="mt-4 border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Consent recorded.</div>{elseif form_notice == 'break_glass'}<div class="mt-4 border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Break-glass access granted.</div>{/if}
        {if form_error}<div class="mt-4 border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">{form_error}</div>{/if}
        <form method="POST" action="{base_url}/admin/ehr/privacy/consents" class="mt-4 grid gap-4 md:grid-cols-2">
            {csrf_field | raw}
            <div class="md:col-span-2">
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Patient</label>
                <select name="patient_id" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
                    <option value="">Select patient</option>
                    {foreach patient_options as patient}
                    <option value="{patient.id}" {if form_values.patient_id == patient.id}selected{/if}>{patient.last_name}, {patient.first_name}</option>
                    {/foreach}
                </select>
            </div>
            <div>
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Consent Type</label>
                <input type="text" name="consent_type" value="{form_values.consent_type}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
            </div>
            <div>
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Status</label>
                <select name="status" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
                    <option value="granted" {if form_values.status == 'granted'}selected{/if}>granted</option>
                    <option value="revoked" {if form_values.status == 'revoked'}selected{/if}>revoked</option>
                </select>
            </div>
            <div class="md:col-span-2">
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Expires At (YYYY-MM-DD HH:MM:SS)</label>
                <input type="text" name="expires_at" value="{form_values.expires_at}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm" placeholder="optional">
            </div>
            <div class="md:col-span-2"><button type="submit" class="bg-slate-900 px-4 py-3 text-sm font-semibold text-white">Record Consent</button></div>
        </form>
    </section>

    <section class="rounded-3xl border border-amber-200 bg-amber-50 p-6 shadow-sm">
        <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-700">Break-Glass Access</h2>
        <form method="POST" action="{base_url}/admin/ehr/privacy/break-glass" class="mt-4 grid gap-4 md:grid-cols-2">
            {csrf_field | raw}
            <div class="md:col-span-2">
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Patient</label>
                <select name="patient_id" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
                    <option value="">Select patient</option>
                    {foreach patient_options as patient}
                    <option value="{patient.id}" {if form_values.patient_id == patient.id}selected{/if}>{patient.last_name}, {patient.first_name}</option>
                    {/foreach}
                </select>
            </div>
            <div class="md:col-span-2">
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Reason</label>
                <textarea name="reason" rows="3" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">{form_values.reason}</textarea>
            </div>
            <div>
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Duration (minutes, max 240)</label>
                <input type="number" min="1" max="240" name="duration_minutes" value="{form_values.duration_minutes}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
            </div>
            <div class="md:col-span-2"><button type="submit" class="bg-amber-700 px-4 py-3 text-sm font-semibold text-white">Request Break-Glass</button></div>
        </form>
    </section>
</div>
{/block}