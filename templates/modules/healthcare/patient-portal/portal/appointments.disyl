<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title | default:'Your appointments'} — Patient Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    {include "modules/patient-portal/portal/_styles.disyl"}
</head>
<body class="min-h-screen bg-slate-100">
    {include "modules/patient-portal/portal/_header.disyl"}

    <main class="mx-auto max-w-6xl px-6 py-8">
        <section class="rounded bg-white shadow-sm ring-1 ring-slate-200">
            <div class="px-6 py-4 border-b border-slate-200">
                <h1 class="text-lg font-semibold text-slate-900">Your appointments</h1>
                <p class="mt-1 text-sm text-slate-600">Past and upcoming visits scheduled with your clinic.</p>
            </div>
            <div class="divide-y divide-slate-100">
                {if appointments}
                    {foreach appointments as appointment}
                    <div class="px-6 py-4 flex items-start gap-4">
                        <div class="flex-shrink-0 rounded bg-teal-50 px-3 py-2 text-center ring-1 ring-teal-100 min-w-[96px]">
                            <div class="text-[10px] font-semibold uppercase tracking-wide text-teal-600">When</div>
                            <div class="mt-0.5 text-xs font-bold text-teal-900">{appointment.scheduled_start}</div>
                            {if appointment.scheduled_end}<div class="mt-0.5 text-[10px] text-teal-700">to {appointment.scheduled_end}</div>{/if}
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="text-sm font-semibold text-slate-900">{appointment.appointment_type | default:'Visit'}</div>
                            {if appointment.reason_for_visit}<div class="mt-1 text-sm text-slate-600">{appointment.reason_for_visit}</div>{/if}
                            {if appointment.notes}<div class="mt-1 text-xs text-slate-500">{appointment.notes}</div>{/if}
                        </div>
                        <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-700 capitalize">{appointment.status}</span>
                    </div>
                    {/foreach}
                {else}
                    <div class="px-6 py-12 text-center text-sm text-slate-500">No appointments on file yet.</div>
                {/if}
            </div>
        </section>
    </main>
</body>
</html>
