<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title | default:'Your appointments'} — Patient Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-50">
    <header class="bg-white border-b border-slate-200">
        <div class="mx-auto max-w-5xl px-6 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="h-9 w-9 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center font-bold">P</div>
                <div>
                    <div class="text-sm font-semibold text-slate-900">Patient Portal</div>
                    <div class="text-xs text-slate-500">{if patient.first_name}{patient.first_name} {patient.last_name}{else}Welcome{/if}</div>
                </div>
            </div>
            <form method="POST" action="{logout_endpoint}">
                {csrf_field | raw}
                <button type="submit" class="text-sm font-medium text-slate-600 hover:text-slate-900">Sign out</button>
            </form>
        </div>
        <nav class="mx-auto max-w-5xl px-6 pb-3 flex gap-6 text-sm">
            <a href="/portal/dashboard" class="text-slate-600 hover:text-slate-900 pb-2">Overview</a>
            <a href="/portal/appointments" class="font-semibold text-teal-700 border-b-2 border-teal-600 pb-2">Appointments</a>
        </nav>
    </header>

    <main class="mx-auto max-w-5xl px-6 py-8">
        <section class="rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
            <div class="px-6 py-4 border-b border-slate-200">
                <h1 class="text-lg font-semibold text-slate-900">Your appointments</h1>
                <p class="mt-1 text-sm text-slate-600">Past and upcoming visits scheduled with your clinic.</p>
            </div>
            <div class="divide-y divide-slate-100">
                {if appointments}
                    {foreach appointments as appointment}
                    <div class="px-6 py-4 flex items-start justify-between">
                        <div>
                            <div class="text-sm font-semibold text-slate-900">{appointment.appointment_type | default:'Visit'}</div>
                            <div class="mt-1 text-xs text-slate-500">{appointment.scheduled_start}{if appointment.scheduled_end} – {appointment.scheduled_end}{/if}</div>
                            {if appointment.reason_for_visit}<div class="mt-2 text-sm text-slate-600">{appointment.reason_for_visit}</div>{/if}
                        </div>
                        <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-700">{appointment.status}</span>
                    </div>
                    {/foreach}
                {else}
                    <div class="px-6 py-12 text-center text-sm text-slate-500">No appointments on file yet.</div>
                {/if}
            </div>
        </section>
    </main>
</body>
</html>
