<style>
    /* Patient-friendly typography baseline */
    html { font-size: 17px; }
    @media (min-width: 768px) { html { font-size: 18px; } }
    body { line-height: 1.6; -webkit-text-size-adjust: 100%; }
    main p, main li, main dd { font-size: 1rem; }
    h1 { letter-spacing: -0.01em; }

    /* Larger touch targets for mobile */
    @media (max-width: 640px) {
        a, button, [role="button"] { min-height: 44px; }
        input, select, textarea { font-size: 16px; min-height: 44px; }
    }

    /* Accessible focus rings for keyboard users */
    a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
        outline: 3px solid #0d9488;
        outline-offset: 2px;
        border-radius: 3px;
    }

    /* Force 3px border radius across the patient portal */
    .rounded,
    .rounded-sm, .rounded-md, .rounded-lg, .rounded-xl, .rounded-2xl, .rounded-3xl,
    .rounded-t, .rounded-t-sm, .rounded-t-md, .rounded-t-lg, .rounded-t-xl, .rounded-t-2xl, .rounded-t-3xl,
    .rounded-b, .rounded-b-sm, .rounded-b-md, .rounded-b-lg, .rounded-b-xl, .rounded-b-2xl, .rounded-b-3xl,
    .rounded-l, .rounded-l-sm, .rounded-l-md, .rounded-l-lg, .rounded-l-xl, .rounded-l-2xl, .rounded-l-3xl,
    .rounded-r, .rounded-r-sm, .rounded-r-md, .rounded-r-lg, .rounded-r-xl, .rounded-r-2xl, .rounded-r-3xl {
        border-radius: 3px !important;
    }
    .rounded-full,
    [class*="rounded-full"] {
        border-radius: 9999px !important;
    }
    /* Inputs and buttons inherit too */
    input, select, textarea, button {
        border-radius: 3px;
    }

    /* Visually-hidden helper for screen readers */
    .sr-only {
        position: absolute; width: 1px; height: 1px; padding: 0;
        margin: -1px; overflow: hidden; clip: rect(0,0,0,0);
        white-space: nowrap; border: 0;
    }
</style>
