<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title | default:'Your results'} — Patient Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    {include "modules/patient-portal/portal/_styles.disyl"}
</head>
<body class="min-h-screen bg-slate-100">
    {include "modules/patient-portal/portal/_header.disyl"}

    <main class="mx-auto max-w-6xl px-6 py-8 space-y-4">
        <div class="rounded bg-sky-50 ring-1 ring-sky-200 px-4 py-3 text-sm text-sky-800">
            <strong>Note:</strong> Results are released by your care team. If something looks off or you have questions, please contact your clinic — do not change any treatment based only on what you read here.
        </div>
        <section class="rounded bg-white shadow-sm ring-1 ring-slate-200">
            <div class="px-6 py-4 border-b border-slate-200 flex items-start justify-between gap-4">
                <div>
                    <h1 class="text-lg font-semibold text-slate-900">Your released results</h1>
                    <p class="mt-1 text-sm text-slate-600">Only verified results released by your care team are shown here.</p>
                </div>
                <div class="text-right text-xs text-slate-500">{results | count} total</div>
            </div>
            <div class="divide-y divide-slate-100">
                {if results}
                    {foreach results as result}
                    <div class="px-6 py-4 flex items-start justify-between gap-4">
                        <div class="flex-1 min-w-0">
                            <div class="text-sm font-semibold text-slate-900">{result.test_name | default:'Result'}</div>
                            <div class="mt-1 text-xs text-slate-500">Observed {result.observed_at | default:result.released_at | default:'—'}</div>
                            {if result.value_text || result.value_numeric}
                            <div class="mt-2 text-base text-slate-900">
                                <span class="font-semibold">{if result.value_numeric}{result.value_numeric}{else}{result.value_text}{/if}</span>{if result.unit} <span class="text-xs text-slate-500">{result.unit}</span>{/if}
                            </div>
                            {/if}
                            {if result.reference_range_text}<div class="mt-1 text-xs text-slate-400">Typical range: {result.reference_range_text}</div>{/if}
                            {if result.released_by_name}<div class="mt-1 text-xs text-emerald-700">✓ Reviewed by {result.released_by_name}{if result.released_at} on {result.released_at}{/if}</div>{/if}
                        </div>
                        <div class="flex flex-col items-end gap-1">
                            {if result.abnormal_flag && result.abnormal_flag != 'N' && result.abnormal_flag != 'normal'}
                            <span class="inline-flex items-center rounded-full bg-rose-50 px-2.5 py-0.5 text-xs font-semibold text-rose-700">Outside typical range</span>
                            {else}
                            <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700">Within typical range</span>
                            {/if}
                            {if !result.acknowledged_at}<span class="text-[10px] font-semibold uppercase tracking-wide text-teal-600">New</span>{/if}
                        </div>
                    </div>
                    {/foreach}
                {else}
                    <div class="px-6 py-12 text-center text-sm text-slate-500">No released results yet. New results show up here once your provider releases them.</div>
                {/if}
            </div>
        </section>
    </main>
</body>
</html>
