<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title | default:'Your prescriptions'} — Patient Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    {include "modules/patient-portal/portal/_styles.disyl"}
</head>
<body class="min-h-screen bg-slate-100">
    {include "modules/patient-portal/portal/_header.disyl"}

    <main class="mx-auto max-w-6xl px-6 py-8">
        <section class="rounded bg-white shadow-sm ring-1 ring-slate-200">
            <div class="px-6 py-4 border-b border-slate-200 flex items-start justify-between gap-4">
                <div>
                    <h1 class="text-lg font-semibold text-slate-900">Your prescriptions</h1>
                    <p class="mt-1 text-sm text-slate-600">Issued and canceled medication orders from your visits.</p>
                </div>
                <div class="text-right text-xs text-slate-500">{prescriptions | count} total</div>
            </div>
            <div class="divide-y divide-slate-100">
                {if prescriptions}
                    {foreach prescriptions as rx}
                    <div class="px-6 py-4">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <div class="text-base font-semibold text-slate-900">{rx.medication_text | default:'Medication'}</div>
                                <dl class="mt-2 grid gap-1 text-xs text-slate-600 sm:grid-cols-3">
                                    {if rx.dose_text}<div><dt class="inline font-medium text-slate-500">Dose:</dt> <dd class="inline text-slate-900">{rx.dose_text}</dd></div>{/if}
                                    {if rx.route}<div><dt class="inline font-medium text-slate-500">Route:</dt> <dd class="inline text-slate-900">{rx.route}</dd></div>{/if}
                                    {if rx.frequency}<div><dt class="inline font-medium text-slate-500">Frequency:</dt> <dd class="inline text-slate-900">{rx.frequency}</dd></div>{/if}
                                </dl>
                                <div class="mt-2 text-xs text-slate-400">Issued {rx.created_at | default:'—'}</div>
                                {if rx.cancellation_reason}<div class="mt-2 rounded bg-rose-50 px-3 py-2 text-xs text-rose-700">Canceled: {rx.cancellation_reason}</div>{/if}
                            </div>
                            <span class="inline-flex items-center rounded-full {if rx.status == 'canceled'}bg-rose-50 text-rose-700{else}bg-teal-50 text-teal-700{/if} px-2.5 py-0.5 text-xs font-semibold capitalize">{rx.status | default:'active'}</span>
                        </div>
                    </div>
                    {/foreach}
                {else}
                    <div class="px-6 py-12 text-center text-sm text-slate-500">No prescriptions on file yet.</div>
                {/if}
            </div>
        </section>
    </main>
</body>
</html>
