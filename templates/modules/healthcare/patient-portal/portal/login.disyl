<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title | default:'Sign in'} — Patient Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-teal-50 via-white to-sky-50 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-teal-100 text-teal-700 text-xl font-bold shadow-sm">P</div>
            <h1 class="mt-4 text-2xl font-semibold text-slate-900">Patient Portal</h1>
            <p class="mt-1 text-sm text-slate-600">Sign in to view your appointments, prescriptions, and released results.</p>
        </div>

        <div class="rounded-2xl bg-white shadow-md ring-1 ring-slate-200 p-8">
            {if notice == 'registered'}
                <div class="mb-4 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Your portal account is ready. You can sign in below.</div>
            {/if}
            {if notice == 'password_reset'}
                <div class="mb-4 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Your password has been updated. Please sign in.</div>
            {/if}
            <div id="portal-error" class="hidden mb-4 rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700"></div>

            <form id="portal-login-form" method="POST" action="{login_endpoint}" class="space-y-5">
                {csrf_field | raw}
                <div>
                    <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Email</label>
                    <input type="email" name="email" id="email" required autocomplete="email"
                        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-teal-500 focus:ring-2 focus:ring-teal-200 focus:outline-none">
                </div>
                <div>
                    <label for="password" class="block text-sm font-medium text-slate-700 mb-1">Password</label>
                    <input type="password" name="password" id="password" required autocomplete="current-password"
                        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-teal-500 focus:ring-2 focus:ring-teal-200 focus:outline-none">
                </div>
                <button type="submit"
                    class="w-full rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 transition">
                    Sign in
                </button>
            </form>

            <div class="mt-5 flex items-center justify-between text-xs text-slate-600">
                <a href="/portal/forgot-password" class="hover:text-teal-700 hover:underline">Forgot password?</a>
                <a href="/portal/register" class="hover:text-teal-700 hover:underline">Activate your account</a>
            </div>
        </div>

        <p class="mt-6 text-center text-xs text-slate-500">
            Need help signing in? Contact your clinic to verify your portal account.
        </p>
    </div>

    <script>
        (function () {
            var form = document.getElementById('portal-login-form');
            var errorBox = document.getElementById('portal-error');
            if (!form) return;
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                errorBox.classList.add('hidden');
                var data = new FormData(form);
                fetch(form.action, {
                    method: 'POST',
                    body: data,
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                }).then(function (resp) {
                    return resp.json().then(function (body) { return { status: resp.status, body: body }; });
                }).then(function (result) {
                    if (result.body && result.body.ok && result.body.redirect) {
                        window.location.href = result.body.redirect;
                        return;
                    }
                    errorBox.textContent = (result.body && result.body.error) || 'Sign-in failed. Please try again.';
                    errorBox.classList.remove('hidden');
                }).catch(function () {
                    errorBox.textContent = 'Network error. Please try again.';
                    errorBox.classList.remove('hidden');
                });
            });
        })();
    </script>
</body>
</html>
