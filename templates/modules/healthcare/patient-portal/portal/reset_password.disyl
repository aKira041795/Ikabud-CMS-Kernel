<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title | default:'Choose a new password'} — Patient Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    {include "modules/patient-portal/portal/_styles.disyl"}
</head>
<body class="min-h-screen bg-gradient-to-br from-teal-50 via-white to-sky-50 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <div class="inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-teal-100 text-teal-700 text-xl font-bold shadow-sm">P</div>
            <h1 class="mt-4 text-2xl font-semibold text-slate-900">Choose a new password</h1>
            <p class="mt-1 text-sm text-slate-600">Set a new password for your patient portal account.</p>
        </div>

        <div class="rounded-2xl bg-white shadow-md ring-1 ring-slate-200 p-8">
            {if error_message != ''}
                <div class="mb-4 rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700">{error_message}</div>
            {/if}

            {if token_valid}
                <form method="POST" action="{form_endpoint}" class="space-y-5" autocomplete="off">
                    {csrf_field | raw}
                    <input type="hidden" name="token" value="{token}">
                    <div>
                        <label for="password" class="block text-sm font-medium text-slate-700 mb-1">New password</label>
                        <input type="password" name="password" id="password" required minlength="10" autocomplete="new-password"
                            class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-teal-500 focus:ring-2 focus:ring-teal-200 focus:outline-none">
                        <p class="mt-1 text-xs text-slate-500">Minimum 10 characters.</p>
                    </div>
                    <div>
                        <label for="password_confirm" class="block text-sm font-medium text-slate-700 mb-1">Confirm new password</label>
                        <input type="password" name="password_confirm" id="password_confirm" required minlength="10" autocomplete="new-password"
                            class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-teal-500 focus:ring-2 focus:ring-teal-200 focus:outline-none">
                    </div>
                    <button type="submit"
                        class="w-full rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 transition">
                        Update password
                    </button>
                </form>
            {else}
                <p class="text-sm text-slate-600">Please request a new password reset link.</p>
                <div class="mt-5 text-center">
                    <a href="/portal/forgot-password" class="text-teal-700 hover:underline text-sm">Request a new link</a>
                </div>
            {/if}

            <div class="mt-5 text-center text-xs text-slate-600">
                <a href="{login_url}" class="text-teal-700 hover:underline">Back to sign in</a>
            </div>
        </div>
    </div>
</body>
</html>
