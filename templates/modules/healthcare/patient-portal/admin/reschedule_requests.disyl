{extends "modules/ehr/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-[0.22em] text-amber-700">Patient Portal</div>
                <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Reschedule Requests</h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Patients have asked to move or cancel an appointment. Reach out using their preferred contact method, then mark the request handled.</p>
            </div>
            <a href="{back_url}" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                Back to Patient Portal
            </a>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-2 text-xs">
            <a href="?status=pending" class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 font-semibold {if status_filter == 'pending'}bg-amber-600 text-white{else}bg-slate-100 text-slate-700 hover:bg-slate-200{/if}">
                Pending <span class="inline-flex items-center justify-center rounded-full {if status_filter == 'pending'}bg-white/25{else}bg-slate-200 text-slate-700{/if} px-1.5 text-[11px] font-bold">{count_pending}</span>
            </a>
            <a href="?status=handled" class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 font-semibold {if status_filter == 'handled'}bg-emerald-600 text-white{else}bg-slate-100 text-slate-700 hover:bg-slate-200{/if}">
                Handled <span class="inline-flex items-center justify-center rounded-full {if status_filter == 'handled'}bg-white/25{else}bg-slate-200 text-slate-700{/if} px-1.5 text-[11px] font-bold">{count_handled}</span>
            </a>
            <a href="?status=dismissed" class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 font-semibold {if status_filter == 'dismissed'}bg-slate-700 text-white{else}bg-slate-100 text-slate-700 hover:bg-slate-200{/if}">
                Dismissed <span class="inline-flex items-center justify-center rounded-full {if status_filter == 'dismissed'}bg-white/25{else}bg-slate-200 text-slate-700{/if} px-1.5 text-[11px] font-bold">{count_dismissed}</span>
            </a>
            <a href="?status=all" class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 font-semibold {if status_filter == 'all'}bg-slate-900 text-white{else}bg-slate-100 text-slate-700 hover:bg-slate-200{/if}">All</a>
        </div>

        {if form_notice == 'handled'}
        <div class="mt-4 rounded border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs text-emerald-700">Marked as handled.</div>
        {elseif form_notice == 'dismissed'}
        <div class="mt-4 rounded border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-700">Request dismissed.</div>
        {elseif form_notice == 'handle_failed'}
        <div class="mt-4 rounded border border-rose-200 bg-rose-50 px-3 py-2 text-xs text-rose-700">{if form_error}{form_error}{else}Action failed.{/if}</div>
        {/if}
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white shadow-sm overflow-hidden">
        {if requests}
        <ul class="divide-y divide-slate-100">
            {foreach requests as r}
            <li class="px-6 py-5">
                <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                    <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="text-base font-semibold text-slate-900">{if r.last_name}{r.last_name}, {r.first_name}{else}Patient #{r.patient_id}{/if}</span>
                            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold {if r.status == 'pending'}bg-amber-100 text-amber-800{elseif r.status == 'handled'}bg-emerald-100 text-emerald-800{else}bg-slate-200 text-slate-700{/if}">{r.status}</span>
                            <span class="text-xs text-slate-500">submitted {r.created_at}</span>
                        </div>

                        <div class="mt-3 grid gap-3 text-sm sm:grid-cols-2 lg:grid-cols-4">
                            <div>
                                <div class="text-[11px] uppercase tracking-wide text-slate-400">Appointment</div>
                                <div class="mt-0.5 text-slate-900">{if r.appointment_type}{r.appointment_type}{else}—{/if}</div>
                                <div class="text-xs text-slate-500">{if r.scheduled_start}{r.scheduled_start}{else}No date on file{/if}</div>
                            </div>
                            <div>
                                <div class="text-[11px] uppercase tracking-wide text-slate-400">Preferred window</div>
                                <div class="mt-0.5 text-slate-900">{if r.preferred_window}{r.preferred_window}{else}<span class="text-slate-400">Not specified</span>{/if}</div>
                            </div>
                            <div>
                                <div class="text-[11px] uppercase tracking-wide text-slate-400">Best contact</div>
                                <div class="mt-0.5 font-semibold text-slate-900">{r.contact_method | default:'phone'}</div>
                            </div>
                            <div>
                                <div class="text-[11px] uppercase tracking-wide text-slate-400">Patient ref</div>
                                <div class="mt-0.5 text-xs text-slate-700">{if r.patient_uuid}{r.patient_uuid}{else}#{r.patient_id}{/if}</div>
                                <div class="text-[11px] text-slate-400">Appt: {r.appointment_uuid}</div>
                            </div>
                        </div>

                        <div class="mt-3 rounded-lg bg-slate-50 px-3 py-2 text-sm text-slate-800">
                            <div class="text-[11px] font-semibold uppercase tracking-wide text-slate-500">Reason</div>
                            <div class="mt-0.5 whitespace-pre-line">{r.reason}</div>
                        </div>

                        {if r.status != 'pending'}
                        <div class="mt-2 text-xs text-slate-500">Resolved {if r.handled_at}{r.handled_at}{/if}{if r.handled_by} by {r.handled_by}{/if}.</div>
                        {/if}
                    </div>

                    {if r.status == 'pending'}
                    <div class="flex flex-shrink-0 gap-2">
                        <form method="POST" action="{handle_endpoint}">
                            {csrf_field | raw}
                            <input type="hidden" name="id" value="{r.id}">
                            <input type="hidden" name="status" value="{status_filter}">
                            <input type="hidden" name="action" value="handle">
                            <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-2 text-xs font-semibold text-white hover:bg-emerald-700">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                                Mark handled
                            </button>
                        </form>
                        <form method="POST" action="{handle_endpoint}">
                            {csrf_field | raw}
                            <input type="hidden" name="id" value="{r.id}">
                            <input type="hidden" name="status" value="{status_filter}">
                            <input type="hidden" name="action" value="dismiss">
                            <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50">Dismiss</button>
                        </form>
                    </div>
                    {/if}
                </div>
            </li>
            {/foreach}
        </ul>
        {else}
        <div class="px-6 py-16 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div class="mt-3 text-sm font-semibold text-slate-900">No requests in this view</div>
            <div class="mt-1 text-xs text-slate-500">Try a different status filter, or check back later.</div>
        </div>
        {/if}
    </section>
</div>
{/block}
