{extends "modules/ehr/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-[0.22em] text-teal-700">Patient Access</div>
                <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Portal access</h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Provision portal accounts so patients can sign in and view their own appointments and released results.</p>
            </div>
            <div class="rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-600">
                <span class="font-semibold text-slate-900">{portal_accounts | count}</span> portal accounts
            </div>
        </div>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-amber-100 text-amber-700">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </span>
                <div class="text-sm text-amber-900">
                    <div class="font-semibold">Reschedule requests</div>
                    <div class="text-xs text-amber-800/80">{if reschedule_pending_count > 0}{reschedule_pending_count} pending request{if reschedule_pending_count != 1}s{/if} from patients.{else}No pending requests right now.{/if}</div>
                </div>
            </div>
            <a href="{reschedule_inbox_url}" class="inline-flex items-center gap-2 rounded-lg bg-amber-600 px-3 py-2 text-xs font-semibold text-white hover:bg-amber-700">
                Open inbox
                {if reschedule_pending_count > 0}<span class="inline-flex items-center justify-center rounded-full bg-white/25 px-2 text-[11px] font-bold">{reschedule_pending_count}</span>{/if}
            </a>
        </div>
    </section>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1.4fr)_minmax(340px,0.85fr)]">
        <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 px-6 py-4">
                <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">{if account_tab == 'inactive'}Inactive accounts{else}Active accounts{/if}</h2>
                <p class="mt-1 text-xs text-slate-500">{if account_tab == 'inactive'}Accounts that are currently blocked from portal sign-in.{else}Most recent portal accounts and their last sign-in.{/if}</p>
                <div class="mt-4 inline-flex rounded-full bg-slate-100 p-1 text-xs font-semibold">
                    <a href="{base_url}/admin/ehr/portal?tab=active" class="rounded-full px-3 py-1.5 {if account_tab == 'active'}bg-white text-slate-900 shadow-sm{else}text-slate-600 hover:text-slate-900{/if}">Active <span class="ml-1 text-[11px]">{active_accounts | count}</span></a>
                    <a href="{base_url}/admin/ehr/portal?tab=inactive" class="rounded-full px-3 py-1.5 {if account_tab == 'inactive'}bg-white text-slate-900 shadow-sm{else}text-slate-600 hover:text-slate-900{/if}">Inactive <span class="ml-1 text-[11px]">{inactive_accounts | count}</span></a>
                </div>
                {if form_notice == 'provisioned'}
                <div class="mt-3 rounded border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs text-emerald-700">Portal account provisioned.</div>
                {elseif form_notice == 'deactivated'}
                <div class="mt-3 rounded border border-slate-200 bg-white px-3 py-2 text-xs text-slate-600">Portal account deactivated.</div>
                {elseif form_notice == 'reactivated'}
                <div class="mt-3 rounded border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs text-emerald-700">Portal account reactivated.</div>
                {elseif form_notice == 'updated'}
                <div class="mt-3 rounded border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs text-emerald-700">Portal email updated.</div>
                {elseif form_notice == 'password_reset'}
                <div class="mt-3 rounded border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs text-emerald-700">Portal password reset. Share the new password with the patient through a secure channel.</div>
                {elseif form_notice == 'provision_failed' || form_notice == 'deactivate_failed' || form_notice == 'update_failed' || form_notice == 'password_reset_failed' || form_notice == 'reactivate_failed'}
                <div class="mt-3 rounded border border-rose-200 bg-rose-50 px-3 py-2 text-xs text-rose-700">{if form_error}{form_error}{else}Action failed.{/if}</div>
                {/if}
            </div>
            <div class="divide-y divide-slate-100">
                {if visible_accounts}
                    {foreach visible_accounts as account}
                    <div class="px-6 py-4">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <div class="text-base font-semibold text-slate-900">{if account.last_name}{account.last_name}, {account.first_name}{else}Unknown patient{/if}</div>
                                <div class="mt-1 text-xs text-slate-500">{account.email}</div>
                                <div class="mt-1 text-xs text-slate-400">Account UUID: {account.account_uuid}</div>
                            </div>
                            <span class="inline-flex items-center rounded-full bg-{if account.status == 'active'}emerald{else}slate{/if}-50 px-2.5 py-0.5 text-xs font-medium text-{if account.status == 'active'}emerald{else}slate{/if}-700">{account.status}</span>
                        </div>
                        <div class="mt-3 grid gap-3 text-sm text-slate-600 md:grid-cols-3">
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Last sign-in</div>
                                <div class="mt-1 text-slate-900">{if account.last_login_at}{account.last_login_at}{else}Never{/if}</div>
                            </div>
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Created</div>
                                <div class="mt-1 text-slate-900">{account.created_at}</div>
                            </div>
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Patient</div>
                                <div class="mt-1 text-slate-900">{account.patient_uuid}</div>
                            </div>
                        </div>
                        <div class="mt-4 space-y-2">
                            <details class="rounded-lg border border-slate-200 bg-slate-50">
                                <summary class="cursor-pointer px-3 py-2 text-xs font-semibold uppercase tracking-wide text-slate-600 hover:text-slate-900">Change email</summary>
                                <form method="POST" action="{update_endpoint}" class="space-y-2 px-3 pb-3 pt-2">
                                    {csrf_field | raw}
                                    <input type="hidden" name="patient_id" value="{account.patient_id}">
                                    <input type="hidden" name="redirect" value="/admin/ehr/portal?tab={account_tab}">
                                    <input type="email" name="email" required value="{account.email}" class="w-full rounded border border-slate-300 px-3 py-2 text-sm focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                                    <button type="submit" class="rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800">Update email</button>
                                </form>
                            </details>
                            <details class="rounded-lg border border-slate-200 bg-slate-50">
                                <summary class="cursor-pointer px-3 py-2 text-xs font-semibold uppercase tracking-wide text-slate-600 hover:text-slate-900">Reset password</summary>
                                <form method="POST" action="{reset_password_endpoint}" class="space-y-2 px-3 pb-3 pt-2">
                                    {csrf_field | raw}
                                    <input type="hidden" name="patient_id" value="{account.patient_id}">
                                    <input type="hidden" name="redirect" value="/admin/ehr/portal?tab={account_tab}">
                                    <input type="text" name="password" minlength="10" required placeholder="New password (min 10 chars)" class="w-full rounded border border-slate-300 px-3 py-2 text-sm focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                                    <p class="text-[11px] text-slate-500">Existing portal sessions and pending password-reset links will be invalidated.</p>
                                    <button type="submit" class="rounded-lg bg-amber-600 px-4 py-2 text-xs font-semibold text-white hover:bg-amber-700">Reset password</button>
                                </form>
                            </details>
                            {if account.status == 'active'}
                            <details class="rounded-lg border border-rose-200 bg-rose-50">
                                <summary class="cursor-pointer px-3 py-2 text-xs font-semibold uppercase tracking-wide text-rose-600 hover:text-rose-800">Deactivate</summary>
                                <form method="POST" action="{deactivate_endpoint}" class="space-y-2 px-3 pb-3 pt-2">
                                    {csrf_field | raw}
                                    <input type="hidden" name="patient_id" value="{account.patient_id}">
                                    <input type="hidden" name="redirect" value="/admin/ehr/portal?tab={account_tab}">
                                    <input type="text" name="reason" placeholder="Reason (e.g. Patient request)" class="w-full rounded border border-slate-300 px-3 py-2 text-sm focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/20">
                                    <button type="submit" class="rounded-lg bg-rose-600 px-4 py-2 text-xs font-semibold text-white hover:bg-rose-700">Deactivate account</button>
                                </form>
                            </details>
                            {else}
                            <form method="POST" action="{reactivate_endpoint}" class="rounded-lg border border-emerald-200 bg-emerald-50 p-3">
                                {csrf_field | raw}
                                <input type="hidden" name="patient_id" value="{account.patient_id}">
                                <input type="hidden" name="redirect" value="/admin/ehr/portal?tab={account_tab}">
                                <button type="submit" class="rounded-lg bg-emerald-600 px-4 py-2 text-xs font-semibold text-white hover:bg-emerald-700">Reactivate account</button>
                            </form>
                            {/if}
                        </div>
                    </div>
                    {/foreach}
                {else}
                    <div class="px-6 py-12 text-center text-sm text-slate-500">{if account_tab == 'inactive'}No inactive portal accounts.{else}No active portal accounts have been provisioned yet.{/if}</div>
                {/if}
            </div>
        </section>

        <aside class="space-y-4">
            <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Provision portal account</h2>
                <p class="mt-1 text-xs text-slate-500">Patient must already exist in the registry.</p>
                <form method="POST" action="{provision_endpoint}" class="mt-4 space-y-3">
                    {csrf_field | raw}
                    <input type="hidden" name="redirect" value="/admin/ehr/portal">
                    <div>
                        <label class="block text-xs font-medium text-slate-600">Patient</label>
                        <div class="mt-1">
                            {include "modules/healthcare/ehr/partials/_patient_picker" with {name: "patient_id", required: true, placeholder: "Search patient by name or MRN…"}}
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-600">Email</label>
                        <input type="email" name="email" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-teal-500 focus:ring-2 focus:ring-teal-200 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-600">Initial password</label>
                        <input type="text" name="password" minlength="10" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-teal-500 focus:ring-2 focus:ring-teal-200 focus:outline-none">
                        <p class="mt-1 text-[10px] text-slate-400">At least 10 characters. Share with the patient through a secure channel.</p>
                    </div>
                    <button type="submit" class="w-full rounded-lg bg-teal-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-700">Create account</button>
                </form>
            </section>
        </aside>
    </div>
</div>
{/block}
