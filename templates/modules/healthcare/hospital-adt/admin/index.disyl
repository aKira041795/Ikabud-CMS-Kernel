{extends "modules/ehr/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-[0.22em] text-teal-700">Inpatient</div>
                <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Admissions &amp; beds</h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Admit, transfer, and discharge inpatients across wards and beds.</p>
            </div>
            <div class="rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-600">
                <span class="font-semibold text-slate-900">{admissions | count}</span> recent admissions
            </div>
        </div>
    </section>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1.4fr)_minmax(340px,0.85fr)]">
        <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 px-6 py-4">
                <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Admissions</h2>
                <p class="mt-1 text-xs text-slate-500">Current and recent inpatient admissions.</p>
            </div>
            <div class="divide-y divide-slate-100">
                {if admissions}
                    {foreach admissions as a}
                    <div class="px-6 py-4 flex items-start justify-between gap-4">
                        <div>
                            <div class="text-sm font-semibold text-slate-900">Patient #{a.patient_id} — {a.ward_name | default:'(unassigned ward)'}{if a.bed_code} · Bed {a.bed_code}{/if}</div>
                            <div class="mt-1 text-xs text-slate-500">Admitted {a.admitted_at}{if a.discharged_at} · Discharged {a.discharged_at} ({a.discharge_disposition}){/if}</div>
                            <div class="mt-1 text-xs text-slate-400">UUID: {a.admission_uuid}</div>
                        </div>
                        <span class="inline-flex items-center rounded-full bg-{if a.status == 'admitted'}emerald{else}slate{/if}-50 px-2.5 py-0.5 text-xs font-medium text-{if a.status == 'admitted'}emerald{else}slate{/if}-700">{a.status}</span>
                    </div>
                    {/foreach}
                {else}
                    <div class="px-6 py-12 text-center text-sm text-slate-500">No admissions on file yet.</div>
                {/if}
            </div>
        </section>

        <aside class="space-y-4">
            <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Wards</h2>
                <ul class="mt-3 space-y-2 text-sm text-slate-700">
                    {if wards}
                        {foreach wards as w}<li class="flex items-center justify-between"><span class="font-medium">{w.name}</span><span class="text-xs text-slate-400">{w.code}</span></li>{/foreach}
                    {else}
                        <li class="text-xs text-slate-400">No wards configured.</li>
                    {/if}
                </ul>
                <form method="POST" action="{ward_create_endpoint}" class="mt-4 space-y-2">
                    {csrf_field | raw}
                    <input type="text" name="code" placeholder="Code (e.g. MED-1)" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
                    <input type="text" name="name" placeholder="Ward name" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
                    <input type="number" name="capacity" placeholder="Capacity" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
                    <button type="submit" class="w-full rounded-lg bg-teal-600 px-3 py-2 text-sm font-semibold text-white">Add ward</button>
                </form>
            </section>

            <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Admit patient</h2>
                <form method="POST" action="{admit_endpoint}" class="mt-3 space-y-2">
                    {csrf_field | raw}
                    {include "modules/healthcare/ehr/partials/_patient_picker" with {name: "patient_id", required: true, placeholder: "Search patient by name or MRN…"}}
                    <input type="number" name="ward_id" placeholder="Ward ID" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
                    <input type="number" name="bed_id" placeholder="Bed ID (optional)" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
                    <textarea name="notes" placeholder="Notes" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></textarea>
                    <button type="submit" class="w-full rounded-lg bg-teal-600 px-3 py-2 text-sm font-semibold text-white">Admit</button>
                </form>
            </section>
        </aside>
    </div>
</div>
{/block}
