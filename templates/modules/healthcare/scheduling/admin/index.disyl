{extends "modules/ehr/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-[0.22em] text-teal-700">Schedule</div>
                <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Appointments</h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">See who's coming in next, check them in, and book new appointments.</p>
            </div>
            <div class="rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-600">
                <span class="font-semibold text-slate-900">{result_count}</span> appointments in this worklist
            </div>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
            {if status_counts}
                {foreach status_counts as row}
                <div class="rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-700">
                    <span class="font-semibold text-slate-900">{row.total}</span> {row.status}
                </div>
                {/foreach}
            {else}
                <div class="rounded-full border border-dashed border-slate-200 px-4 py-2 text-sm text-slate-600">No appointment statuses recorded yet.</div>
            {/if}
        </div>
    </section>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1.4fr)_minmax(340px,0.85fr)]">
        <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 px-6 py-4">
                <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Today's queue</h2>
                <p class="mt-1 text-xs text-slate-500">Upcoming and in-progress appointments, ordered by scheduled start.</p>
            </div>
            <div class="divide-y divide-slate-100">
                {if appointments}
                    {foreach appointments as appointment}
                    <div class="px-6 py-4">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <div class="text-base font-semibold text-slate-900">{if appointment.patient_summary}{appointment.patient_summary.last_name}, {appointment.patient_summary.first_name}{else}Unknown patient{/if}</div>
                                <div class="mt-1 text-sm text-slate-600">Appointment UUID: {appointment.appointment_uuid}</div>
                            </div>
                            <div class="flex items-center gap-3">
                                <a href="{base_url}/admin/ehr/appointments?appointment_id={appointment.id}" class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-700 hover:text-teal-900">Edit</a>
                                <div class="rounded-full bg-teal-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-teal-700">{appointment.status}</div>
                            </div>
                        </div>
                        <div class="mt-3 grid gap-3 text-sm text-slate-600 md:grid-cols-4">
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Type</div>
                                <div class="mt-1 text-slate-900">{appointment.appointment_type}</div>
                            </div>
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Starts</div>
                                <div class="mt-1 text-slate-900">{appointment.scheduled_start}</div>
                            </div>
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Ends</div>
                                <div class="mt-1 text-slate-900">{if appointment.scheduled_end}{appointment.scheduled_end}{else}TBD{/if}</div>
                            </div>
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Reason</div>
                                <div class="mt-1 text-slate-900">{if appointment.reason_for_visit}{appointment.reason_for_visit}{else}Not recorded{/if}</div>
                            </div>
                        </div>
                        <div class="mt-3 flex flex-wrap gap-2">
                            {if appointment.status == 'scheduled'}
                            <form method="POST" action="{base_url}/admin/ehr/appointments/transition" class="inline">{csrf_field | raw}<input type="hidden" name="id" value="{appointment.id}"><input type="hidden" name="status" value="checked-in"><button type="submit" class="rounded-xl bg-teal-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-teal-700">Check In</button></form>
                            <form method="POST" action="{base_url}/admin/ehr/appointments/transition" class="inline">{csrf_field | raw}<input type="hidden" name="id" value="{appointment.id}"><input type="hidden" name="status" value="no-show"><button type="submit" class="rounded-xl border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:border-rose-300 hover:text-rose-700">No Show</button></form>
                            {/if}
                            {if appointment.status == 'checked-in'}
                            <form method="POST" action="{base_url}/admin/ehr/appointments/transition" class="inline">{csrf_field | raw}<input type="hidden" name="id" value="{appointment.id}"><input type="hidden" name="status" value="waiting"><button type="submit" class="rounded-xl bg-amber-500 px-3 py-1.5 text-xs font-semibold text-white hover:bg-amber-600">Send to Waiting</button></form>
                            <form method="POST" action="{base_url}/admin/ehr/appointments/transition" class="inline flex items-center gap-1">{csrf_field | raw}<input type="hidden" name="id" value="{appointment.id}"><input type="hidden" name="status" value="roomed"><input type="text" name="room_assignment" placeholder="Room" class="border border-slate-200 px-2 py-1 text-xs"><button type="submit" class="rounded-xl bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-700">Room</button></form>
                            {/if}
                            {if appointment.status == 'waiting'}
                            <form method="POST" action="{base_url}/admin/ehr/appointments/transition" class="inline flex items-center gap-1">{csrf_field | raw}<input type="hidden" name="id" value="{appointment.id}"><input type="hidden" name="status" value="roomed"><input type="text" name="room_assignment" placeholder="Room" class="border border-slate-200 px-2 py-1 text-xs"><button type="submit" class="rounded-xl bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-700">Room Now</button></form>
                            {/if}
                            {if appointment.status == 'roomed'}
                            <form method="POST" action="{base_url}/admin/ehr/appointments/transition" class="inline">{csrf_field | raw}<input type="hidden" name="id" value="{appointment.id}"><input type="hidden" name="status" value="completed"><button type="submit" class="rounded-xl bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700">Complete</button></form>
                            {/if}
                        </div>
                    </div>
                    {/foreach}
                {else}
                    <div class="px-6 py-12 text-center text-sm text-slate-600">No appointments yet. Book one using the form on the right.</div>
                {/if}
            </div>
        </section>

        <aside class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Appointment details</h2>
                    <p class="mt-1 text-xs text-slate-500">{if form_values.appointment_id}Update time, status, or notes.{else}Book a new appointment for a patient.{/if}</p>
                    <div class="mt-2 text-2xl font-semibold text-slate-900">{if form_values.appointment_id}Update appointment{else}Book appointment{/if}</div>
                </div>
                {if form_values.appointment_id}
                <a href="{base_url}/admin/ehr/appointments" class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 hover:text-slate-700">New</a>
                {/if}
            </div>

            {if form_notice == 'scheduled'}
            <div class="mt-4 border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Appointment scheduled.</div>
            {elseif form_notice == 'updated'}
            <div class="mt-4 border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Appointment updated.</div>
            {elseif form_notice == 'checked-in'}
            <div class="mt-4 border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Patient checked in.</div>
            {elseif form_notice == 'waiting'}
            <div class="mt-4 border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700">Moved to waiting.</div>
            {elseif form_notice == 'roomed'}
            <div class="mt-4 border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm text-indigo-700">Patient roomed; encounter opened.</div>
            {elseif form_notice == 'completed'}
            <div class="mt-4 border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Visit completed.</div>
            {elseif form_notice == 'no-show'}
            <div class="mt-4 border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">Marked as no-show.</div>
            {elseif form_notice == 'canceled'}
            <div class="mt-4 border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">Appointment canceled.</div>
            {/if}

            {if form_error}
            <div class="mt-4 border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">{form_error}</div>
            {/if}

            <form method="POST" action="{base_url}/admin/ehr/appointments" class="mt-4 space-y-4">
                {csrf_field | raw}
                <input type="hidden" name="appointment_id" value="{form_values.appointment_id}">
                <div>
                    <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Patient</label>
                    <select name="patient_id" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                        <option value="">Select patient</option>
                        {foreach patient_options as patient}
                        <option value="{patient.id}" {if form_values.patient_id == patient.id}selected{/if}>{patient.last_name}, {patient.first_name} · {patient.patient_uuid}</option>
                        {/foreach}
                    </select>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Type</label>
                        <input type="text" name="appointment_type" value="{form_values.appointment_type}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Status</label>
                        <select name="status" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                            {foreach status_options as status}
                            <option value="{status}" {if form_values.status == status}selected{/if}>{status}</option>
                            {/foreach}
                        </select>
                    </div>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Scheduled Start</label>
                        <input type="datetime-local" name="scheduled_start" value="{form_values.scheduled_start}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Scheduled End</label>
                        <input type="datetime-local" name="scheduled_end" value="{form_values.scheduled_end}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                    </div>
                </div>
                <div>
                    <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Reason for Visit</label>
                    <textarea name="reason_for_visit" rows="3" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">{form_values.reason_for_visit}</textarea>
                </div>
                <div>
                    <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Notes</label>
                    <textarea name="notes" rows="4" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">{form_values.notes}</textarea>
                </div>
                <button type="submit" class="w-full bg-slate-900 px-4 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">{if form_values.appointment_id}Update Appointment{else}Set Appointment{/if}</button>
            </form>
        </aside>
    </div>
</div>
{/block}