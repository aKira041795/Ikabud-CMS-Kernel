{extends "modules/ehr/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    {include "modules/ehr/partials/_insights_tabs"}
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div>
            <div class="text-xs font-semibold uppercase tracking-[0.22em] text-teal-700">Insights</div>
            <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Insights</h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Quality summary, decision-support rule library, and active alerts.</p>
        </div>
        <div class="mt-6 grid gap-3 sm:grid-cols-4">
            <div class="rounded-2xl bg-slate-50 px-4 py-3"><div class="text-xs uppercase text-slate-500">Active rules</div><div class="mt-1 text-2xl font-bold text-slate-900">{cds_summary.active_rules | default:0}</div></div>
            <div class="rounded-2xl bg-slate-50 px-4 py-3"><div class="text-xs uppercase text-slate-500">Evaluations (30d)</div><div class="mt-1 text-2xl font-bold text-slate-900">{cds_summary.evaluations | default:0}</div></div>
            <div class="rounded-2xl bg-slate-50 px-4 py-3"><div class="text-xs uppercase text-slate-500">Matched</div><div class="mt-1 text-2xl font-bold text-slate-900">{cds_summary.matched | default:0}</div></div>
            <div class="rounded-2xl bg-slate-50 px-4 py-3"><div class="text-xs uppercase text-slate-500">Open alerts</div><div class="mt-1 text-2xl font-bold text-slate-900">{cds_summary.open_alerts | default:0}</div></div>
        </div>
    </section>

    <div class="grid gap-6 xl:grid-cols-2">
        <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 px-6 py-4">
                <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Rules</h2>
            </div>
            <div class="divide-y divide-slate-100">
                {if cds_rules}
                    {foreach cds_rules as r}
                    <div class="px-6 py-4">
                        <div class="flex items-start justify-between">
                            <div>
                                <div class="text-sm font-semibold text-slate-900">{r.name} <span class="text-xs text-slate-400">({r.code})</span></div>
                                <div class="text-xs text-slate-500">{r.domain} · severity {r.severity}</div>
                                {if r.description}<div class="mt-1 text-xs text-slate-500">{r.description}</div>{/if}
                            </div>
                            <span class="inline-flex items-center rounded-full bg-{if r.active_flag}emerald{else}slate{/if}-50 px-2.5 py-0.5 text-xs font-medium text-{if r.active_flag}emerald{else}slate{/if}-700">{if r.active_flag}active{else}inactive{/if}</span>
                        </div>
                    </div>
                    {/foreach}
                {else}
                    <div class="px-6 py-8 text-center text-sm text-slate-500">No CDS rules defined yet.</div>
                {/if}
            </div>
        </section>

        <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 px-6 py-4">
                <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Recent alerts</h2>
            </div>
            <div class="divide-y divide-slate-100">
                {if cds_alerts}
                    {foreach cds_alerts as a}
                    <div class="px-6 py-4 flex items-start justify-between gap-3">
                        <div>
                            <div class="text-sm font-semibold text-slate-900">{a.message}</div>
                            <div class="text-xs text-slate-500">{a.rule_code} · {a.created_at}{if a.patient_id} · patient #{a.patient_id}{/if}</div>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="inline-flex items-center rounded-full bg-{if a.severity == 'critical'}rose{else}amber{/if}-50 px-2.5 py-0.5 text-xs font-medium text-{if a.severity == 'critical'}rose{else}amber{/if}-700">{a.severity}</span>
                            {if a.status != 'acknowledged'}
                            <form method="POST" action="{alert_ack_endpoint}">
                                {csrf_field | raw}
                                <input type="hidden" name="alert_id" value="{a.id}">
                                <button type="submit" class="text-xs font-semibold text-teal-700 hover:underline">Ack</button>
                            </form>
                            {else}
                            <span class="text-xs text-slate-400">Acked</span>
                            {/if}
                        </div>
                    </div>
                    {/foreach}
                {else}
                    <div class="px-6 py-8 text-center text-sm text-slate-500">No alerts yet.</div>
                {/if}
            </div>
        </section>
    </div>

    <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-4">
            <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Add rule</h2>
        </div>
        <form method="POST" action="{rule_create_endpoint}" class="px-6 py-4 grid gap-3 md:grid-cols-2">
            {csrf_field | raw}
            <input type="text" name="code" placeholder="Rule code" required class="rounded-lg border border-slate-300 px-3 py-2 text-sm">
            <input type="text" name="name" placeholder="Rule name" required class="rounded-lg border border-slate-300 px-3 py-2 text-sm">
            <input type="text" name="domain" placeholder="Domain (e.g. labs)" class="rounded-lg border border-slate-300 px-3 py-2 text-sm">
            <select name="severity" class="rounded-lg border border-slate-300 px-3 py-2 text-sm">
                <option value="info">Info</option>
                <option value="warning">Warning</option>
                <option value="critical">Critical</option>
            </select>
            <textarea name="description" placeholder="Description" class="md:col-span-2 rounded-lg border border-slate-300 px-3 py-2 text-sm"></textarea>
            <textarea name="expression_json" required placeholder='Expression JSON, e.g. {"field":"lab.value","op":">","value":200}' class="md:col-span-2 rounded-lg border border-slate-300 px-3 py-2 font-mono text-xs"></textarea>
            <button type="submit" class="md:col-span-2 rounded-lg bg-teal-600 px-3 py-2 text-sm font-semibold text-white">Add rule</button>
        </form>
    </section>
</div>
{/block}
