{extends "modules/ehr/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-[0.22em] text-teal-700">Patients</div>
                <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Patient registry</h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Find a patient by name, ID, phone, or email — or register a new one.</p>
            </div>
            <div class="rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-600">
                <span class="font-semibold text-slate-900">{result_count}</span> patients in current result set
            </div>
        </div>
        <form method="GET" action="{base_url}/admin/ehr/patients" class="mt-6 grid gap-3 lg:grid-cols-[minmax(0,1fr)_auto]">
            <input type="text" name="q" value="{search_query}" placeholder="Search by patient name, UUID, phone, or email" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-teal-400 focus:ring-2 focus:ring-teal-100">
            <button type="submit" class="rounded-2xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">Search Registry</button>
        </form>
    </section>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1.4fr)_minmax(320px,0.8fr)]">
        <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 px-6 py-4">
                <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Search results</h2>
                <p class="mt-1 text-xs text-slate-500">Tap a patient to load their record into the editor on the right.</p>
            </div>
            <div class="divide-y divide-slate-100">
                {if patients}
                    {foreach patients as patient}
                    <a href="{base_url}/admin/ehr/patients?patient_id={patient.id}{if search_query}&q={search_query}{/if}" class="block px-6 py-4 transition hover:bg-slate-50">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <div class="text-base font-semibold text-slate-900">{patient.last_name}, {patient.first_name}</div>
                                <div class="mt-1 text-sm text-slate-600">UUID: {patient.patient_uuid}</div>
                            </div>
                            <div class="rounded-full bg-teal-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-teal-700">{patient.status}</div>
                        </div>
                        <div class="mt-3 grid gap-3 text-sm text-slate-600 md:grid-cols-3">
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Birth Date</div>
                                <div class="mt-1 text-slate-900">{patient.birth_date}</div>
                            </div>
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Phone</div>
                                <div class="mt-1 text-slate-900">{if patient.primary_phone}{patient.primary_phone}{else}Not set{/if}</div>
                            </div>
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Email</div>
                                <div class="mt-1 text-slate-900">{if patient.email}{patient.email}{else}Not set{/if}</div>
                            </div>
                        </div>
                    </a>
                    {/foreach}
                {else}
                    <div class="px-6 py-12 text-center">
                        <div class="text-base font-semibold text-slate-900">No patients matched your search.</div>
                        <p class="mt-2 text-sm text-slate-600">Try a last name, phone number, or patient ID.</p>
                    </div>
                {/if}
            </div>
        </section>

        <aside class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Patient details</h2>
                    <p class="mt-1 text-xs text-slate-500">{if form_values.patient_id}Update demographics, contact info, and identifiers.{else}Fill in the basics to register a new patient.{/if}</p>
                    <div class="mt-2 text-2xl font-semibold text-slate-900">{if form_values.patient_id}Edit patient{else}Register patient{/if}</div>
                    {if selected_patient}<div class="mt-1 text-sm text-slate-600">Patient UUID: {selected_patient.patient_uuid}</div>{/if}
                </div>
                {if form_values.patient_id}
                <a href="{base_url}/admin/ehr/patients{if search_query}?q={search_query}{/if}" class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 hover:text-slate-700">New</a>
                {/if}
            </div>

            {if form_notice == 'created'}
            <div class="mt-4 border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Patient created.</div>
            {elseif form_notice == 'updated'}
            <div class="mt-4 border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Patient updated.</div>
            {/if}

            {if form_error}
            <div class="mt-4 border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">{form_error}</div>
            {/if}

            <form method="POST" action="{base_url}/admin/ehr/patients" class="mt-4 space-y-4">
                {csrf_field | raw}
                <input type="hidden" name="patient_id" value="{form_values.patient_id}">
                <input type="hidden" name="q" value="{search_query}">
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">First Name</label>
                        <input type="text" name="first_name" value="{form_values.first_name}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Last Name</label>
                        <input type="text" name="last_name" value="{form_values.last_name}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                    </div>
                </div>
                <div>
                    <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Middle Name</label>
                    <input type="text" name="middle_name" value="{form_values.middle_name}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                </div>
                <div class="grid gap-4 sm:grid-cols-3">
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Birth Date</label>
                        <input type="date" name="birth_date" value="{form_values.birth_date}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Sex</label>
                        <select name="sex" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                            <option value="unknown" {if form_values.sex == 'unknown'}selected{/if}>unknown</option>
                            <option value="female" {if form_values.sex == 'female'}selected{/if}>female</option>
                            <option value="male" {if form_values.sex == 'male'}selected{/if}>male</option>
                            <option value="other" {if form_values.sex == 'other'}selected{/if}>other</option>
                        </select>
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Status</label>
                        <select name="status" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                            <option value="active" {if form_values.status == 'active'}selected{/if}>active</option>
                            <option value="inactive" {if form_values.status == 'inactive'}selected{/if}>inactive</option>
                            <option value="archived" {if form_values.status == 'archived'}selected{/if}>archived</option>
                        </select>
                    </div>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Phone</label>
                        <input type="text" name="primary_phone" value="{form_values.primary_phone}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Email</label>
                        <input type="email" name="email" value="{form_values.email}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                    </div>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Primary Identifier Type</label>
                        <input type="text" name="identifier_type" value="{form_values.identifier_type}" placeholder="MRN, PhilHealth, National ID" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Primary Identifier Value</label>
                        <input type="text" name="identifier_value" value="{form_values.identifier_value}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                    </div>
                </div>
                <div>
                    <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Issuing Authority</label>
                    <input type="text" name="identifier_issuing_authority" value="{form_values.identifier_issuing_authority}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                </div>
                <button type="submit" class="w-full bg-slate-900 px-4 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">{if form_values.patient_id}Save Patient Changes{else}Register Patient{/if}</button>
            </form>

            {if selected_patient && selected_patient.identifiers}
            <div class="mt-6">
                <div class="text-xs uppercase tracking-wide text-slate-400">Existing Identifiers</div>
                <div class="mt-3 space-y-3">
                    {foreach selected_patient.identifiers as identifier}
                    <div class="border border-slate-200 p-4">
                        <div class="text-sm font-semibold text-slate-900">{identifier.identifier_type}: {identifier.identifier_value}</div>
                        <div class="mt-1 text-xs text-slate-500">{if identifier.issuing_authority}{identifier.issuing_authority}{else}No issuing authority{/if}</div>
                    </div>
                    {/foreach}
                </div>
            </div>
            {/if}

            {if selected_patient}
            <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-5">
                <div class="flex items-center justify-between gap-3">
                    <div>
                        <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Patient Portal Access</div>
                        <div class="mt-1 text-sm text-slate-600">Provision or deactivate this patient's portal login.</div>
                    </div>
                    {if portal_account}
                    <span class="rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide {if portal_account.status == 'active'}bg-emerald-100 text-emerald-700{else}bg-slate-200 text-slate-700{/if}">{portal_account.status}</span>
                    {else}
                    <span class="rounded-full bg-slate-200 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-slate-700">no account</span>
                    {/if}
                </div>

                {if form_notice == 'provisioned'}
                <div class="mt-3 rounded border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs text-emerald-700">Portal account provisioned.</div>
                {elseif form_notice == 'deactivated'}
                <div class="mt-3 rounded border border-slate-200 bg-white px-3 py-2 text-xs text-slate-600">Portal account deactivated.</div>
                {elseif form_notice == 'reactivated'}
                <div class="mt-3 rounded border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs text-emerald-700">Portal account reactivated.</div>
                {elseif form_notice == 'updated'}
                <div class="mt-3 rounded border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs text-emerald-700">Portal email updated.</div>
                {elseif form_notice == 'password_reset'}
                <div class="mt-3 rounded border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs text-emerald-700">Portal password reset. Share the new password with the patient through a secure channel.</div>
                {elseif form_notice == 'provision_failed' || form_notice == 'deactivate_failed' || form_notice == 'update_failed' || form_notice == 'password_reset_failed' || form_notice == 'reactivate_failed'}
                <div class="mt-3 rounded border border-rose-200 bg-rose-50 px-3 py-2 text-xs text-rose-700">{if form_values.error}{form_values.error}{else}Action failed.{/if}</div>
                {/if}

                {if portal_account}
                <dl class="mt-4 grid gap-2 text-xs text-slate-600 sm:grid-cols-2">
                    <div><dt class="font-semibold uppercase tracking-wide text-slate-400">Email</dt><dd class="mt-0.5 text-slate-900">{portal_account.email}</dd></div>
                    <div><dt class="font-semibold uppercase tracking-wide text-slate-400">Last login</dt><dd class="mt-0.5 text-slate-900">{if portal_account.last_login_at}{portal_account.last_login_at}{else}Never{/if}</dd></div>
                </dl>

                <div class="mt-4 space-y-3">
                    <details class="rounded-lg border border-slate-200 bg-white">
                        <summary class="cursor-pointer px-3 py-2 text-xs font-semibold uppercase tracking-wide text-slate-600 hover:text-slate-900">Change email</summary>
                        <form method="POST" action="{base_url}/admin/ehr/portal/update" class="space-y-2 px-3 pb-3 pt-2">
                            {csrf_field | raw}
                            <input type="hidden" name="patient_id" value="{form_values.patient_id}">
                            <input type="hidden" name="redirect" value="/admin/ehr/patients?patient_id={form_values.patient_id}">
                            <input type="email" name="email" required value="{portal_account.email}" class="w-full border border-slate-300 px-3 py-2 text-sm focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                            <button type="submit" class="rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800">Update email</button>
                        </form>
                    </details>

                    <details class="rounded-lg border border-slate-200 bg-white">
                        <summary class="cursor-pointer px-3 py-2 text-xs font-semibold uppercase tracking-wide text-slate-600 hover:text-slate-900">Reset password</summary>
                        <form method="POST" action="{base_url}/admin/ehr/portal/reset-password" class="space-y-2 px-3 pb-3 pt-2">
                            {csrf_field | raw}
                            <input type="hidden" name="patient_id" value="{form_values.patient_id}">
                            <input type="hidden" name="redirect" value="/admin/ehr/patients?patient_id={form_values.patient_id}">
                            <input type="text" name="password" minlength="10" required placeholder="New password (min 10 chars)" class="w-full border border-slate-300 px-3 py-2 text-sm focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                            <p class="text-[11px] text-slate-500">Existing portal sessions and pending password-reset links will be invalidated.</p>
                            <button type="submit" class="rounded-lg bg-amber-600 px-4 py-2 text-xs font-semibold text-white hover:bg-amber-700">Reset password</button>
                        </form>
                    </details>

                    {if portal_account.status == 'active'}
                    <details class="rounded-lg border border-rose-200 bg-white">
                        <summary class="cursor-pointer px-3 py-2 text-xs font-semibold uppercase tracking-wide text-rose-600 hover:text-rose-800">Deactivate</summary>
                        <form method="POST" action="{base_url}/admin/ehr/portal/deactivate" class="space-y-2 px-3 pb-3 pt-2">
                            {csrf_field | raw}
                            <input type="hidden" name="patient_id" value="{form_values.patient_id}">
                            <input type="hidden" name="redirect" value="/admin/ehr/patients?patient_id={form_values.patient_id}">
                            <input type="text" name="reason" placeholder="Reason (e.g. Patient request)" class="w-full border border-slate-300 px-3 py-2 text-sm focus:border-rose-500 focus:outline-none focus:ring-2 focus:ring-rose-500/20">
                            <button type="submit" class="rounded-lg bg-rose-600 px-4 py-2 text-xs font-semibold text-white hover:bg-rose-700">Deactivate account</button>
                        </form>
                    </details>
                    {else}
                    <form method="POST" action="{base_url}/admin/ehr/portal/reactivate" class="rounded-lg border border-emerald-200 bg-emerald-50 p-3">
                        {csrf_field | raw}
                        <input type="hidden" name="patient_id" value="{form_values.patient_id}">
                        <input type="hidden" name="redirect" value="/admin/ehr/patients?patient_id={form_values.patient_id}">
                        <p class="text-xs text-emerald-800">Account is currently inactive.{if portal_account.deactivation_reason} Reason: <em>{portal_account.deactivation_reason}</em>.{/if}</p>
                        <button type="submit" class="mt-2 rounded-lg bg-emerald-600 px-4 py-2 text-xs font-semibold text-white hover:bg-emerald-700">Reactivate account</button>
                    </form>
                    {/if}
                </div>
                {else}
                <form method="POST" action="{base_url}/admin/ehr/portal/provision" class="mt-4 grid gap-3 sm:grid-cols-[1fr_1fr_auto]">
                    {csrf_field | raw}
                    <input type="hidden" name="patient_id" value="{form_values.patient_id}">
                    <input type="hidden" name="redirect" value="/admin/ehr/patients?patient_id={form_values.patient_id}">
                    <div>
                        <label class="block text-xs font-medium uppercase tracking-wide text-slate-500">Email</label>
                        <input type="email" name="email" required value="{form_values.email}" class="mt-1 w-full border border-slate-300 px-3 py-2 text-sm focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                    </div>
                    <div>
                        <label class="block text-xs font-medium uppercase tracking-wide text-slate-500">Initial password</label>
                        <input type="text" name="password" minlength="10" required class="mt-1 w-full border border-slate-300 px-3 py-2 text-sm focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                    </div>
                    <div class="flex items-end">
                        <button type="submit" class="w-full rounded-lg bg-teal-600 px-4 py-2 text-sm font-semibold text-white hover:bg-teal-700">Provision</button>
                    </div>
                </form>
                <p class="mt-2 text-[11px] text-slate-500">At least 10 characters. Share with the patient through a secure channel.</p>
                {/if}
            </div>
            {/if}
        </aside>
    </div>
</div>
{/block}