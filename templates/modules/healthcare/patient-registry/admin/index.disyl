{extends "modules/ehr/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-[0.22em] text-teal-700">Patient Identity</div>
                <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Patient Registry</h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Search the canonical patient registry by name, UUID, phone, or email. Select a record to review identifiers and demographics.</p>
            </div>
            <div class="rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-600">
                <span class="font-semibold text-slate-900">{result_count}</span> patients in current result set
            </div>
        </div>
        <form method="GET" action="{base_url}/admin/ehr/patients" class="mt-6 grid gap-3 lg:grid-cols-[minmax(0,1fr)_auto]">
            <input type="text" name="q" value="{search_query}" placeholder="Search by patient name, UUID, phone, or email" class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-teal-400 focus:ring-2 focus:ring-teal-100">
            <button type="submit" class="rounded-2xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">Search Registry</button>
        </form>
    </section>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1.4fr)_minmax(320px,0.8fr)]">
        <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 px-6 py-4">
                <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Search Results</h2>
            </div>
            <div class="divide-y divide-slate-100">
                {if patients}
                    {foreach patients as patient}
                    <a href="{base_url}/admin/ehr/patients?patient_id={patient.id}{if search_query}&q={search_query}{/if}" class="block px-6 py-4 transition hover:bg-slate-50">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <div class="text-base font-semibold text-slate-900">{patient.last_name}, {patient.first_name}</div>
                                <div class="mt-1 text-sm text-slate-600">UUID: {patient.patient_uuid}</div>
                            </div>
                            <div class="rounded-full bg-teal-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-teal-700">{patient.status}</div>
                        </div>
                        <div class="mt-3 grid gap-3 text-sm text-slate-600 md:grid-cols-3">
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Birth Date</div>
                                <div class="mt-1 text-slate-900">{patient.birth_date}</div>
                            </div>
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Phone</div>
                                <div class="mt-1 text-slate-900">{if patient.primary_phone}{patient.primary_phone}{else}Not set{/if}</div>
                            </div>
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Email</div>
                                <div class="mt-1 text-slate-900">{if patient.email}{patient.email}{else}Not set{/if}</div>
                            </div>
                        </div>
                    </a>
                    {/foreach}
                {else}
                    <div class="px-6 py-12 text-center">
                        <div class="text-base font-semibold text-slate-900">No patient records matched this search.</div>
                        <p class="mt-2 text-sm text-slate-600">Try a patient last name, phone number, or UUID.</p>
                    </div>
                {/if}
            </div>
        </section>

        <aside class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Patient Snapshot</h2>
            {if selected_patient}
                <div class="mt-4 space-y-4">
                    <div>
                        <div class="text-2xl font-semibold text-slate-900">{selected_patient.last_name}, {selected_patient.first_name}</div>
                        <div class="mt-1 text-sm text-slate-600">Patient UUID: {selected_patient.patient_uuid}</div>
                    </div>
                    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-1">
                        <div class="rounded-2xl bg-slate-50 p-4">
                            <div class="text-xs uppercase tracking-wide text-slate-400">Status</div>
                            <div class="mt-2 text-sm font-semibold text-slate-900">{selected_patient.status}</div>
                        </div>
                        <div class="rounded-2xl bg-slate-50 p-4">
                            <div class="text-xs uppercase tracking-wide text-slate-400">Birth Date</div>
                            <div class="mt-2 text-sm font-semibold text-slate-900">{selected_patient.birth_date}</div>
                        </div>
                        <div class="rounded-2xl bg-slate-50 p-4">
                            <div class="text-xs uppercase tracking-wide text-slate-400">Sex</div>
                            <div class="mt-2 text-sm font-semibold text-slate-900">{selected_patient.sex}</div>
                        </div>
                        <div class="rounded-2xl bg-slate-50 p-4">
                            <div class="text-xs uppercase tracking-wide text-slate-400">Contact</div>
                            <div class="mt-2 text-sm font-semibold text-slate-900">{if selected_patient.primary_phone}{selected_patient.primary_phone}{else}Not set{/if}</div>
                            <div class="mt-1 text-sm text-slate-600">{if selected_patient.email}{selected_patient.email}{else}No email recorded{/if}</div>
                        </div>
                    </div>
                    <div>
                        <div class="text-xs uppercase tracking-wide text-slate-400">Identifiers</div>
                        <div class="mt-3 space-y-3">
                            {if selected_patient.identifiers}
                                {foreach selected_patient.identifiers as identifier}
                                <div class="rounded-2xl border border-slate-200 p-4">
                                    <div class="text-sm font-semibold text-slate-900">{identifier.identifier_type}: {identifier.identifier_value}</div>
                                    <div class="mt-1 text-xs text-slate-500">{if identifier.issuing_authority}{identifier.issuing_authority}{else}No issuing authority{/if}</div>
                                </div>
                                {/foreach}
                            {else}
                                <div class="rounded-2xl border border-dashed border-slate-200 p-4 text-sm text-slate-600">No identifiers recorded for this patient.</div>
                            {/if}
                        </div>
                    </div>
                </div>
            {else}
                <div class="mt-4 rounded-2xl border border-dashed border-slate-200 p-6 text-sm leading-6 text-slate-600">Select a patient from the result list to review demographics and identifiers in this sidebar.</div>
            {/if}
        </aside>
    </div>
</div>
{/block}