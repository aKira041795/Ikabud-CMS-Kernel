{extends "modules/ehr/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-[0.22em] text-teal-700">Medications</div>
                <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Medications</h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">See what's been prescribed and issue new medication for a patient visit.</p>
            </div>
            <div class="rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-600">
                <span class="font-semibold text-slate-900">{result_count}</span> prescriptions in current view
            </div>
        </div>
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-4">
            <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Recent prescriptions</h2>
            <p class="mt-1 text-xs text-slate-500">Latest medications issued, including dose, route, and frequency.</p>
        </div>
        <div class="divide-y divide-slate-100">
            {if prescriptions}
                {foreach prescriptions as prescription}
                <div class="px-6 py-4">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <div class="text-base font-semibold text-slate-900">{prescription.medication_text}</div>
                            <div class="mt-1 text-sm text-slate-600">{if prescription.patient_summary}{prescription.patient_summary.last_name}, {prescription.patient_summary.first_name}{else}Unknown patient{/if} · {prescription.prescription_uuid}</div>
                        </div>
                        {if prescription.status_badge}{include "modules/healthcare/ehr/partials/_status_badge" with {badge: prescription.status_badge, size: 'sm'}}{else}<div class="rounded-full bg-teal-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-teal-700">{prescription.status}</div>{/if}
                    </div>
                    <div class="mt-3 grid gap-3 text-sm text-slate-600 md:grid-cols-4">
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Dose</div>
                            <div class="mt-1 text-slate-900">{if prescription.dose_text}{prescription.dose_text}{else}Not recorded{/if}</div>
                        </div>
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Route</div>
                            <div class="mt-1 text-slate-900">{if prescription.route}{prescription.route}{else}Not recorded{/if}</div>
                        </div>
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Frequency</div>
                            <div class="mt-1 text-slate-900">{if prescription.frequency}{prescription.frequency}{else}Not recorded{/if}</div>
                        </div>
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Issued</div>
                            <div class="mt-1 text-slate-900">{prescription.issued_at}</div>
                        </div>
                    </div>
                    {if prescription.status == 'issued'}
                    <div class="mt-3 flex flex-wrap items-center gap-2">
                        <form method="POST" action="{base_url}/admin/ehr/prescriptions/refill" class="inline" onsubmit="return confirm('Request a refill for this prescription?');">
                            {csrf_field | raw}
                            <input type="hidden" name="prescription_id" value="{prescription.id}">
                            <button type="submit" class="rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-700">Request Refill{if prescription.refills} ({prescription.refills} left){/if}</button>
                        </form>
                        <form method="POST" action="{base_url}/admin/ehr/prescriptions/cancel" class="inline flex flex-wrap items-center gap-2" onsubmit="return confirm('Cancel this prescription?');">
                            {csrf_field | raw}
                            <input type="hidden" name="prescription_id" value="{prescription.id}">
                            <input type="text" name="reason" required placeholder="Cancellation reason" class="rounded-md border border-slate-200 px-2 py-1 text-xs">
                            <button type="submit" class="rounded-md bg-rose-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-rose-700">Cancel</button>
                        </form>
                    </div>
                    {elseif prescription.status == 'canceled'}
                    <div class="mt-3 text-xs text-rose-600">Canceled{if prescription.cancellation_reason}: {prescription.cancellation_reason}{/if}</div>
                    {/if}
                </div>
                {/foreach}
            {else}
                <div class="px-6 py-12 text-center text-sm text-slate-600">No prescriptions have been issued yet. Use the form below to issue one.</div>
            {/if}
        </div>
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Issue a prescription</h2>
        <p class="mt-1 text-xs text-slate-500">Pick the patient and visit, then enter the medication details.</p>
        {if form_notice == 'created'}<div class="mt-4 border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Prescription issued.</div>{elseif form_notice == 'canceled'}<div class="mt-4 border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">Prescription canceled.</div>{elseif form_notice == 'refill_requested'}<div class="mt-4 border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm text-indigo-700">Refill requested.</div>{/if}
        {if form_error}<div class="mt-4 border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">{form_error}</div>{/if}
        <form method="POST" action="{base_url}/admin/ehr/prescriptions" class="mt-4 grid gap-4 md:grid-cols-2">
            {csrf_field | raw}
            <div>
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Patient</label>
                <select name="patient_id" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
                    <option value="">Select patient</option>
                    {foreach patient_options as patient}
                    <option value="{patient.id}" {if form_values.patient_id == patient.id}selected{/if}>{patient.last_name}, {patient.first_name}</option>
                    {/foreach}
                </select>
            </div>
            <div>
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Encounter</label>
                <select name="encounter_id" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
                    <option value="">Select encounter</option>
                    {foreach encounter_options as encounter}
                    <option value="{encounter.id}" {if form_values.encounter_id == encounter.id}selected{/if}>#{encounter.id} · {encounter.status}</option>
                    {/foreach}
                </select>
            </div>
            <div class="md:col-span-2">
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Medication</label>
                <input type="text" name="medication_text" value="{form_values.medication_text}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
            </div>
            <div>
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Dose</label>
                <input type="text" name="dose_text" value="{form_values.dose_text}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
            </div>
            <div>
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Route</label>
                <input type="text" name="route" value="{form_values.route}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
            </div>
            <div>
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Frequency</label>
                <input type="text" name="frequency" value="{form_values.frequency}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
            </div>
            <div class="md:col-span-2"><button type="submit" class="bg-slate-900 px-4 py-3 text-sm font-semibold text-white">Issue Prescription</button></div>
        </form>
    </section>
</div>
{/block}