{extends "modules/ehr/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-[0.22em] text-teal-700">Medication Management</div>
                <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Prescriptions</h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Review issued and canceled medication orders, including dose, route, frequency, and refill instructions.</p>
            </div>
            <div class="rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-600">
                <span class="font-semibold text-slate-900">{result_count}</span> prescriptions in current view
            </div>
        </div>
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-4">
            <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Recent Prescriptions</h2>
        </div>
        <div class="divide-y divide-slate-100">
            {if prescriptions}
                {foreach prescriptions as prescription}
                <div class="px-6 py-4">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <div class="text-base font-semibold text-slate-900">{prescription.medication_text}</div>
                            <div class="mt-1 text-sm text-slate-600">{if prescription.patient_summary}{prescription.patient_summary.last_name}, {prescription.patient_summary.first_name}{else}Unknown patient{/if} · {prescription.prescription_uuid}</div>
                        </div>
                        <div class="rounded-full bg-teal-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-teal-700">{prescription.status}</div>
                    </div>
                    <div class="mt-3 grid gap-3 text-sm text-slate-600 md:grid-cols-4">
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Dose</div>
                            <div class="mt-1 text-slate-900">{if prescription.dose_text}{prescription.dose_text}{else}Not recorded{/if}</div>
                        </div>
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Route</div>
                            <div class="mt-1 text-slate-900">{if prescription.route}{prescription.route}{else}Not recorded{/if}</div>
                        </div>
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Frequency</div>
                            <div class="mt-1 text-slate-900">{if prescription.frequency}{prescription.frequency}{else}Not recorded{/if}</div>
                        </div>
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Issued</div>
                            <div class="mt-1 text-slate-900">{prescription.issued_at}</div>
                        </div>
                    </div>
                </div>
                {/foreach}
            {else}
                <div class="px-6 py-12 text-center text-sm text-slate-600">No prescriptions have been issued yet.</div>
            {/if}
        </div>
    </section>
</div>
{/block}