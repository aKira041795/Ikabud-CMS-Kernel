{extends "modules/ehr/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-[0.22em] text-teal-700">Orders</div>
                <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Lab &amp; imaging orders</h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Track active orders and create new ones for a patient visit.</p>
            </div>
            <div class="rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-600">
                <span class="font-semibold text-slate-900">{result_count}</span> orders in current view
            </div>
        </div>
    </section>

    {if status_buckets}
    <section class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Pending</div>
            <div class="mt-1 text-2xl font-semibold text-slate-900">{status_buckets.pending}</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-indigo-600">In Progress</div>
            <div class="mt-1 text-2xl font-semibold text-slate-900">{status_buckets.in_progress}</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-emerald-600">Resulted</div>
            <div class="mt-1 text-2xl font-semibold text-slate-900">{status_buckets.resulted}</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm">
            <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Cancelled</div>
            <div class="mt-1 text-2xl font-semibold text-slate-900">{status_buckets.cancelled}</div>
        </div>
    </section>
    {/if}

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1.4fr)_minmax(340px,0.85fr)]">
        <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 px-6 py-4">
                <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Recent orders</h2>
                <p class="mt-1 text-xs text-slate-500">Latest orders with their priority and clinical question.</p>
            </div>
            <div class="divide-y divide-slate-100">
                {if orders}
                    {foreach orders as order}
                    <div class="px-6 py-4">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <div class="text-base font-semibold text-slate-900">{if order.first_item_label}{order.first_item_label}{else}{order.order_type}{/if}</div>
                                <div class="mt-1 text-sm text-slate-600">{if order.patient_summary}{order.patient_summary.last_name}, {order.patient_summary.first_name}{else}Unknown patient{/if} · {order.order_uuid}</div>
                            </div>
                            <div class="flex items-center gap-3">
                                <a href="{base_url}/admin/ehr/orders?order_id={order.id}" class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-700 hover:text-teal-900">Edit</a>
                                {if order.status_badge}{include "modules/healthcare/ehr/partials/_status_badge" with {badge: order.status_badge, size: 'sm'}}{else}<div class="rounded-full bg-teal-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-teal-700">{order.status}</div>{/if}
                            </div>
                        </div>
                        <div class="mt-3 grid gap-3 text-sm text-slate-600 md:grid-cols-4">
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Order Type</div>
                                <div class="mt-1 text-slate-900">{order.order_type}</div>
                            </div>
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Priority</div>
                                <div class="mt-1 text-slate-900">{order.priority}</div>
                            </div>
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Items</div>
                                <div class="mt-1 text-slate-900">{order.item_count}</div>
                            </div>
                            <div>
                                <div class="text-xs uppercase tracking-wide text-slate-400">Ordered At</div>
                                <div class="mt-1 text-slate-900">{order.ordered_at}</div>
                            </div>
                        </div>
                        <div class="mt-3 rounded-2xl bg-slate-50 px-4 py-3 text-sm leading-6 text-slate-700">{if order.clinical_question}{order.clinical_question}{else}No clinical question recorded.{/if}</div>
                    </div>
                    {/foreach}
                {else}
                    <div class="px-6 py-12 text-center text-sm text-slate-600">No orders yet. Place one using the form on the right.</div>
                {/if}
            </div>
        </section>

        <aside class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Order details</h2>
                    <p class="mt-1 text-xs text-slate-500">{if form_values.order_id}Update the order or change its status.{else}Place a new order for a patient visit.{/if}</p>
                    <div class="mt-2 text-2xl font-semibold text-slate-900">{if form_values.order_id}Edit order{else}New order{/if}</div>
                    {if selected_order}<div class="mt-1 text-sm text-slate-600">Order UUID: {selected_order.order_uuid}</div>{/if}
                </div>
                {if form_values.order_id}
                <a href="{base_url}/admin/ehr/orders" class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 hover:text-slate-700">New</a>
                {/if}
            </div>

            {if form_notice == 'created'}
            <div class="mt-4 border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Order created.</div>
            {elseif form_notice == 'updated'}
            <div class="mt-4 border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Order updated.</div>
            {/if}

            {if form_error}
            <div class="mt-4 border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">{form_error}</div>
            {/if}

            <form method="POST" action="{base_url}/admin/ehr/orders" class="mt-4 space-y-4">
                {csrf_field | raw}
                <input type="hidden" name="order_id" value="{form_values.order_id}">
                <div>
                    <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Patient</label>
                    <select name="patient_id" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                        <option value="">Select patient</option>
                        {foreach patient_options as patient}
                        <option value="{patient.id}" {if form_values.patient_id == patient.id}selected{/if}>{patient.last_name}, {patient.first_name} · {patient.patient_uuid}</option>
                        {/foreach}
                    </select>
                </div>
                <div>
                    <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Encounter</label>
                    <select name="encounter_id" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                        <option value="">Select encounter</option>
                        {foreach encounter_options as encounter}
                        <option value="{encounter.id}" {if form_values.encounter_id == encounter.id}selected{/if}>{encounter.encounter_uuid} · {if encounter.patient_summary}{encounter.patient_summary.last_name}, {encounter.patient_summary.first_name}{else}Unknown patient{/if} · {encounter.status}</option>
                        {/foreach}
                    </select>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Order Type</label>
                        <input type="text" name="order_type" value="{form_values.order_type}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Priority</label>
                        <input type="text" name="priority" value="{form_values.priority}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                    </div>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Status</label>
                        <select name="status" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                            {foreach status_options as status}
                            <option value="{status}" {if form_values.status == status}selected{/if}>{status}</option>
                            {/foreach}
                        </select>
                    </div>
                    <div>
                        <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Destination Module</label>
                        <input type="text" name="destination_module" value="{form_values.destination_module}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                    </div>
                </div>
                <div>
                    <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Primary Item Label</label>
                    <input type="text" name="item_label" value="{form_values.item_label}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                </div>
                <div>
                    <label class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-500">Clinical Question</label>
                    <textarea name="clinical_question" rows="4" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500/20">{form_values.clinical_question}</textarea>
                </div>
                <button type="submit" class="w-full bg-slate-900 px-4 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">{if form_values.order_id}Save Order Changes{else}Create Order{/if}</button>
            </form>
        </aside>
    </div>
</div>
{/block}