{extends "modules/ehr/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div>
            <div class="text-xs font-semibold uppercase tracking-[0.22em] text-teal-700">Integrations</div>
            <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Interoperability Bridge</h1>
            <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">FHIR exports, message log, and external identifier mapping.</p>
        </div>
    </section>

    <div class="grid gap-6 xl:grid-cols-2">
        <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 px-6 py-4">
                <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Recent messages</h2>
            </div>
            <div class="divide-y divide-slate-100">
                {if messages}
                    {foreach messages as m}
                    <div class="px-6 py-3 flex items-center justify-between text-sm">
                        <div>
                            <div class="font-semibold text-slate-900">{m.protocol | upper} · {m.message_type}</div>
                            <div class="text-xs text-slate-500">{m.direction} · {m.occurred_at}{if m.patient_id} · patient #{m.patient_id}{/if}</div>
                        </div>
                        <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-700">{m.status}</span>
                    </div>
                    {/foreach}
                {else}
                    <div class="px-6 py-8 text-center text-sm text-slate-500">No messages logged yet.</div>
                {/if}
            </div>
        </section>

        <aside class="space-y-4">
            <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Export patient as FHIR</h2>
                <form method="POST" action="{export_endpoint}" class="mt-3 space-y-2">
                    {csrf_field | raw}
                    <input type="number" name="patient_id" placeholder="Patient ID" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
                    <button type="submit" class="w-full rounded-lg bg-teal-600 px-3 py-2 text-sm font-semibold text-white">Export</button>
                </form>
            </section>

            <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Map identifier</h2>
                <form method="POST" action="{identifier_endpoint}" class="mt-3 space-y-2">
                    {csrf_field | raw}
                    <input type="text" name="local_entity" placeholder="local_entity (e.g. patient)" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
                    <input type="number" name="local_id" placeholder="local_id" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
                    <input type="text" name="external_system" placeholder="external_system" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
                    <input type="text" name="external_id" placeholder="external_id" required class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
                    <button type="submit" class="w-full rounded-lg bg-teal-600 px-3 py-2 text-sm font-semibold text-white">Save mapping</button>
                </form>
                <h3 class="mt-4 text-xs font-semibold uppercase tracking-wide text-slate-500">Latest mappings</h3>
                <ul class="mt-2 divide-y divide-slate-100 text-sm">
                    {if identifier_maps}
                        {foreach identifier_maps as m}<li class="py-2"><div class="font-medium text-slate-900">{m.local_entity} #{m.local_id}</div><div class="text-xs text-slate-500">{m.external_system} → {m.external_id}</div></li>{/foreach}
                    {else}
                        <li class="py-2 text-xs text-slate-400">No mappings yet.</li>
                    {/if}
                </ul>
            </section>
        </aside>
    </div>
</div>
{/block}
