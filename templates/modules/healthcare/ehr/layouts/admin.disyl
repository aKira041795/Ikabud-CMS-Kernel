<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page_title} — {brand_name}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://unpkg.com/alpinejs@3.14.3/dist/cdn.min.js"></script>
    <link rel="stylesheet" href="/css/ehr-system.css">
    <style>
        /* Right content panel: slightly deeper, calm clinical wash so the
           lighter sidebar (analogous to the brand block) reads as elevated. */
        body {
            background:
                radial-gradient(circle at top right, rgba(13, 148, 136, 0.10), transparent 30%),
                radial-gradient(circle at bottom left, rgba(2, 132, 199, 0.09), transparent 26%),
                linear-gradient(180deg, #cfe4e8 0%, #dbe7ec 100%);
            color: #0f172a;
        }

        .ehr-page-views [class*="rounded"] {
            border-radius: 6px !important;
        }

        .ehr-page-views [class*="file:rounded"]::file-selector-button {
            border-radius: 6px !important;
        }

        .ehr-shell-sidebar [class*="rounded"] {
            border-radius: 6px !important;
        }

        /* Smooth chevron rotation for collapsible nav groups */
        .ehr-nav-group-chevron { transition: transform 200ms ease; }
        .ehr-nav-group[data-open="true"] .ehr-nav-group-chevron { transform: rotate(90deg); }
    </style>
    {block head}{/block}
</head>
<body class="min-h-screen text-slate-900" x-data="{ mobileNavOpen: false }">
    <div class="min-h-screen lg:grid lg:grid-cols-[280px_minmax(0,1fr)]">
        <aside class="ehr-shell-sidebar hidden border-r border-teal-200/70 bg-gradient-to-b from-teal-50 via-cyan-50 to-sky-50 text-slate-700 lg:flex lg:flex-col">
            <div class="border-b border-teal-200/60 bg-gradient-to-br from-teal-600 to-cyan-700 px-6 py-6 text-white">
                <div class="flex items-center gap-4">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/15 text-lg font-semibold text-white ring-1 ring-white/25">{brand_initial}</div>
                    <div>
                        <div class="text-[11px] uppercase tracking-[0.22em] text-teal-100">EHR Admin</div>
                        <div class="mt-0.5 text-base font-semibold leading-tight text-white">{brand_name}</div>
                    </div>
                </div>
            </div>
            <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-4">
                <div class="mb-3 space-y-2 px-1">
                    <div class="px-1 text-[11px] font-bold uppercase tracking-[0.22em] text-slate-700">Find Patient</div>
                    <input
                        type="text"
                        placeholder="Search by name or MRN..."
                        class="w-full rounded-lg border border-teal-200/80 bg-white/80 px-3 py-2 text-sm text-slate-900 placeholder-slate-400 focus:border-teal-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-teal-500/30"
                        x-data
                        @input="$dispatch('search-patient', { query: $el.value })"
                    >
                </div>
                {foreach sidebar_nav_groups as group}
                <section
                    class="ehr-nav-group mb-1"
                    x-data="{ open: {if group.is_active}true{else}false{/if} }"
                    :data-open="open ? 'true' : 'false'"
                >
                    <button
                        type="button"
                        @click="open = !open"
                        class="flex w-full items-center justify-between px-2 py-1.5 text-[11px] font-bold uppercase tracking-[0.22em] text-slate-700 hover:text-teal-800"
                        :aria-expanded="open"
                    >
                        <span class="flex items-center gap-2">
                            <span>{group.title}</span>
                            <span class="rounded-full bg-teal-100 px-1.5 py-0.5 text-[10px] font-bold normal-case tracking-normal text-teal-800">{group.count}</span>
                        </span>
                        <span class="ehr-nav-group-chevron text-teal-700">›</span>
                    </button>
                    <div x-show="open" x-cloak class="mt-1 space-y-0.5">
                        {foreach group.items as item}
                        <a href="{item.url}" class="block rounded-md border-l-2 px-3 py-2 transition {if current_page == item.key}border-teal-700 bg-white text-teal-900 shadow-sm{else}border-transparent text-slate-800 hover:border-teal-500 hover:bg-white hover:text-teal-900{/if}">
                            <div class="text-sm font-semibold">{item.label}</div>
                            <div class="mt-0.5 text-xs {if current_page == item.key}text-teal-800{else}text-slate-600{/if}">{item.description}</div>
                        </a>
                        {/foreach}
                    </div>
                </section>
                {/foreach}
            </nav>
            <div class="border-t border-teal-200/60 bg-white/60 px-5 py-4 text-sm">
                <div class="font-semibold text-slate-900">{user_display}</div>
                <div class="mt-0.5 text-xs text-slate-500">{user_role}</div>
                <form method="POST" action="{logout_url}" class="mt-3">
                    {csrf_field | raw}
                    <button type="submit" class="inline-flex w-full items-center justify-center rounded-md border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition hover:border-teal-300 hover:bg-teal-50 hover:text-teal-800">
                        Sign Out
                    </button>
                </form>
            </div>
        </aside>

        <div class="flex min-h-screen flex-col">
            <header class="border-b border-slate-200/80 bg-white/80 px-4 py-4 backdrop-blur lg:px-8">
                <div class="flex items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <button type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-slate-200 bg-white text-slate-600 lg:hidden" @click="mobileNavOpen = !mobileNavOpen">☰</button>
                        <div>
                            <div class="text-xs font-semibold uppercase tracking-[0.22em] text-teal-700">EHR Workspace</div>
                            <h1 class="mt-1 text-2xl font-semibold tracking-tight text-slate-900">{page_title}</h1>
                        </div>
                    </div>
                    <div class="hidden text-right lg:block">
                        <div class="text-sm font-semibold text-slate-900">{user_display}</div>
                        <div class="text-xs text-slate-500">{user_role}</div>
                        <form method="POST" action="{logout_url}" class="mt-3">
                            {csrf_field | raw}
                            <button type="submit" class="text-sm font-semibold text-teal-700 transition hover:text-teal-900">Sign Out</button>
                        </form>
                    </div>
                </div>
                <div class="ehr-shell-sidebar mt-4 space-y-3 lg:hidden" x-show="mobileNavOpen" x-cloak>
                    {foreach sidebar_nav_groups as group}
                    <section
                        class="ehr-nav-group rounded-md border border-slate-200 bg-white"
                        x-data="{ open: {if group.is_active}true{else}false{/if} }"
                        :data-open="open ? 'true' : 'false'"
                    >
                        <button
                            type="button"
                            @click="open = !open"
                            class="flex w-full items-center justify-between px-3 py-2 text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500 hover:text-slate-700"
                            :aria-expanded="open"
                        >
                            <span class="flex items-center gap-2">
                                <span>{group.title}</span>
                                <span class="rounded-full bg-slate-100 px-1.5 py-0.5 text-[10px] font-semibold normal-case tracking-normal text-slate-500">{group.count}</span>
                            </span>
                            <span class="ehr-nav-group-chevron text-slate-400">›</span>
                        </button>
                        <div x-show="open" x-cloak class="space-y-1 border-t border-slate-100 p-2">
                            {foreach group.items as item}
                            <a href="{item.url}" class="block rounded-md border-l-2 px-3 py-2 text-sm {if current_page == item.key}border-teal-600 bg-teal-50 text-teal-900{else}border-transparent text-slate-600 hover:bg-slate-50 hover:text-slate-900{/if}">
                                <div class="font-medium">{item.label}</div>
                                <div class="mt-0.5 text-xs text-slate-500">{item.description}</div>
                            </a>
                            {/foreach}
                        </div>
                    </section>
                    {/foreach}
                    <form method="POST" action="{logout_url}" class="pt-2">
                        {csrf_field | raw}
                        <button type="submit" class="block w-full rounded-md border border-slate-200 bg-white px-4 py-3 text-left text-sm font-semibold text-teal-700">Sign Out</button>
                    </form>
                </div>
            </header>
            {if patient_context}
            <div class="border-b border-teal-200/70 bg-gradient-to-r from-teal-50 via-white to-sky-50 px-4 py-3 lg:px-8">
                <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
                    <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-teal-600 text-sm font-semibold text-white">{patient_context.initial}</div>
                        <div>
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="text-base font-semibold text-slate-900">{patient_context.name}</span>
                                {if patient_context.restricted}
                                <span class="inline-flex items-center gap-1 rounded-full border border-amber-300 bg-amber-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-800" title="Restricted record">🔒 Restricted</span>
                                {/if}
                                {if patient_context.allergies.items}
                                <span class="inline-flex items-center gap-1 rounded-full border border-rose-300 bg-rose-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-rose-800" title="Allergies on file">⚠ Allergies: {foreach patient_context.allergies.items as a}{a}{if !loop.last}, {/if}{/foreach}</span>
                                {elseif patient_context.allergies.nka}
                                <span class="inline-flex items-center gap-1 rounded-full border border-emerald-300 bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-emerald-800" title="No known allergies">✓ NKA</span>
                                {else}
                                <span class="inline-flex items-center gap-1 rounded-full border border-amber-300 bg-amber-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-800" title="Allergies have not been captured for this patient">⚠ Allergies: not captured</span>
                                {/if}
                            </div>
                            <div class="mt-0.5 text-xs text-slate-600">
                                {if patient_context.sex}{patient_context.sex} · {/if}{if patient_context.age != null}{patient_context.age} yrs · {/if}{if patient_context.mrn}MRN: {patient_context.mrn}{/if}
                            </div>
                        </div>
                    </div>
                    {if patient_context.encounter}
                    <div class="rounded-2xl border border-teal-200 bg-white/80 px-3 py-1.5 text-xs">
                        <div class="font-semibold uppercase tracking-[0.18em] text-teal-700">Active Visit</div>
                        <div class="mt-0.5 text-sm text-slate-800">{patient_context.encounter.type}{if patient_context.encounter.service_line} · {patient_context.encounter.service_line}{/if} · <span class="font-semibold">{patient_context.encounter.status}</span></div>
                    </div>
                    {/if}
                    <div class="ml-auto flex flex-wrap items-center gap-2">
                        <a href="{patient_context.chart_url}" class="rounded-xl bg-teal-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-teal-700">Open Chart</a>
                        <a href="/admin/ehr/notes?patient_id={patient_context.patient_id}" class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:border-teal-300">Add Note</a>
                        <a href="/admin/ehr/orders?patient_id={patient_context.patient_id}" class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:border-teal-300">Order</a>
                        <a href="/admin/ehr/prescriptions?patient_id={patient_context.patient_id}" class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:border-teal-300">Prescribe</a>
                        <form method="POST" action="{patient_context.clear_url}" class="inline">
                            {csrf_field | raw}
                            <button type="submit" class="rounded-xl border border-transparent px-2 py-1.5 text-xs text-slate-500 transition hover:text-rose-600" title="End patient session">✕ End session</button>
                        </form>
                    </div>
                </div>
            </div>
            {if patient_context.progress}
            <div class="border-b border-slate-200 bg-slate-50 px-4 py-2 lg:px-8">
                {include "modules/healthcare/ehr/partials/_visit_progress" with {progress: patient_context.progress}}
            </div>
            {/if}
            {/if}
            <main class="ehr-page-views flex-1 px-4 py-6 lg:px-8 lg:py-8">
                {block content}{/block}
            </main>
        </div>
    </div>
    <script>
    (function () {
        function initPicker(root) {
            if (root.__ehrPpInit) return; root.__ehrPpInit = true;
            var d = root.dataset;
            var endpoint = d.endpoint && d.endpoint.length ? d.endpoint : ((d.baseUrl || '') + '/api/v1/ehr/patients/search');
            var placeholder = d.placeholder || 'Search patient by name or MRN…';
            var hidden = root.querySelector('[data-ehr-pp-input]');
            var input  = root.querySelector('[data-ehr-pp-query]');
            var clearBtn = root.querySelector('[data-ehr-pp-clear]');
            var panel  = root.querySelector('[data-ehr-pp-panel]');
            var list   = root.querySelector('[data-ehr-pp-list]');
            var empty  = root.querySelector('[data-ehr-pp-empty]');
            var selectedId = (d.value || '').toString();
            var selectedLabel = (d.valueLabel || '').toString();
            var options = []; var active = 0; var loading = false; var fetchSeq = 0;
            input.placeholder = placeholder;
            function showClear() { clearBtn.classList.toggle('hidden', !selectedId); clearBtn.classList.toggle('flex', !!selectedId); }
            showClear();
            function openPanel() { panel.classList.remove('hidden'); }
            function closePanel() { panel.classList.add('hidden'); }
            function highlight() {
                Array.prototype.forEach.call(list.querySelectorAll('button'), function (b, i) {
                    b.className = 'flex w-full items-start gap-3 px-3 py-2 text-left text-sm transition ' + (i === active ? 'bg-teal-50' : 'hover:bg-slate-50');
                });
            }
            function render() {
                if (!options.length) {
                    list.innerHTML = '';
                    empty.textContent = loading ? 'Searching…' : (input.value ? ('No patients match “' + input.value + '”.') : 'Type a name or MRN to search.');
                    empty.classList.remove('hidden');
                    return;
                }
                empty.classList.add('hidden');
                list.innerHTML = '';
                options.forEach(function (opt, idx) {
                    var li = document.createElement('li');
                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'flex w-full items-start gap-3 px-3 py-2 text-left text-sm transition ' + (idx === active ? 'bg-teal-50' : 'hover:bg-slate-50');
                    var initial = (opt.label || '?').charAt(0).toUpperCase();
                    btn.innerHTML = '<span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-teal-100 text-xs font-semibold text-teal-700"></span><span class="min-w-0 flex-1"><span class="block font-medium text-slate-800"></span><span class="block truncate text-[11px] text-slate-500"></span></span>';
                    btn.children[0].textContent = initial;
                    btn.children[1].children[0].textContent = opt.label || '';
                    btn.children[1].children[1].textContent = opt.sub || '';
                    btn.addEventListener('mouseenter', function () { active = idx; highlight(); });
                    btn.addEventListener('mousedown', function (e) { e.preventDefault(); selectOpt(opt); });
                    li.appendChild(btn); list.appendChild(li);
                });
            }
            function selectOpt(opt) {
                selectedId = String(opt.id || '');
                selectedLabel = (opt.label || '') + (opt.sub ? ' (' + opt.sub + ')' : '');
                hidden.value = selectedId;
                input.value = selectedLabel;
                showClear();
                closePanel();
            }
            function fetchOptions(q) {
                var seq = ++fetchSeq;
                loading = true;
                if (!options.length) render();
                fetch(endpoint + '?q=' + encodeURIComponent(q || ''), { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
                    .then(function (r) { return r.json(); })
                    .then(function (data) { if (seq !== fetchSeq) return; options = (data && data.patients) ? data.patients : []; active = 0; loading = false; render(); })
                    .catch(function () { if (seq !== fetchSeq) return; options = []; loading = false; render(); });
            }
            input.addEventListener('focus', function () { openPanel(); if (!options.length) fetchOptions(input.value); });
            var debounce; input.addEventListener('input', function () {
                if (input.value !== selectedLabel) { selectedId = ''; hidden.value = ''; showClear(); }
                clearTimeout(debounce); debounce = setTimeout(function () { fetchOptions(input.value); }, 200);
                openPanel();
            });
            input.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowDown') { e.preventDefault(); openPanel(); if (!options.length) { fetchOptions(input.value); return; } active = (active + 1) % options.length; highlight(); }
                else if (e.key === 'ArrowUp') { e.preventDefault(); if (!options.length) return; active = (active - 1 + options.length) % options.length; highlight(); }
                else if (e.key === 'Enter') { if (options[active]) { e.preventDefault(); selectOpt(options[active]); } }
                else if (e.key === 'Escape') { closePanel(); }
            });
            clearBtn.addEventListener('click', function () { selectedId = ''; selectedLabel = ''; hidden.value = ''; input.value = ''; options = []; showClear(); closePanel(); input.focus(); });
            document.addEventListener('click', function (e) { if (!root.contains(e.target)) closePanel(); });
        }
        function initAll() { document.querySelectorAll('[data-ehr-picker]').forEach(initPicker); }
        // Strip transient flash params from the URL after first paint so a
        // refresh / back-nav does not re-show "Appointment scheduled." etc.
        function stripFlashParams() {
            try {
                var url = new URL(window.location.href);
                var changed = false;
                ['notice', 'error'].forEach(function (k) { if (url.searchParams.has(k)) { url.searchParams.delete(k); changed = true; } });
                if (changed) window.history.replaceState({}, '', url.pathname + (url.search ? url.search : '') + url.hash);
            } catch (_e) {}
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', stripFlashParams); else stripFlashParams();
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAll); else initAll();
    })();
    </script>
    {block scripts}{/block}
</body>
</html>