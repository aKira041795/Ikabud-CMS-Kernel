{extends "modules/ehr/layouts/admin.disyl"}

{block content}
<div class="space-y-6">

    <!-- Top KPI strip -->
    <section class="rounded-2xl border border-slate-200 bg-white p-6">
        <div class="flex flex-col gap-2 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-teal-700">Today's Clinic</div>
                <h2 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900">{today_label}</h2>
            </div>
            <div class="text-sm text-slate-500">Live counts from today's queue and active visits.</div>
        </div>
        <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
            <div class="rounded-xl border border-teal-200 bg-teal-50/70 p-4">
                <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-teal-700">Appointments</div>
                <div class="mt-1 text-3xl font-semibold text-teal-900">{summary.appointments.total}</div>
                <div class="text-xs text-teal-700/80">scheduled today</div>
            </div>
            <div class="rounded-xl border border-amber-200 bg-amber-50/70 p-4">
                <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-amber-700">Checked In</div>
                <div class="mt-1 text-3xl font-semibold text-amber-900">{summary.appointments.checked_in}</div>
                <div class="text-xs text-amber-700/80">waiting</div>
            </div>
            <div class="rounded-xl border border-sky-200 bg-sky-50/70 p-4">
                <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-sky-700">In Consult</div>
                <div class="mt-1 text-3xl font-semibold text-sky-900">{summary.appointments.in_consult}</div>
                <div class="text-xs text-sky-700/80">roomed</div>
            </div>
            <div class="rounded-xl border border-indigo-200 bg-indigo-50/70 p-4">
                <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-indigo-700">Active Visits</div>
                <div class="mt-1 text-3xl font-semibold text-indigo-900">{summary.active_visits_count}</div>
                <div class="text-xs text-indigo-700/80">open encounters</div>
            </div>
            <div class="rounded-xl border border-emerald-200 bg-emerald-50/70 p-4">
                <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-emerald-700">Completed</div>
                <div class="mt-1 text-3xl font-semibold text-emerald-900">{summary.appointments.completed}</div>
                <div class="text-xs text-emerald-700/80">visits today</div>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
                <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-600">No-show / Canceled</div>
                <div class="mt-1 text-3xl font-semibold text-slate-800">{summary.appointments.no_show}</div>
                <div class="text-xs text-slate-500">{summary.appointments.canceled} canceled</div>
            </div>
        </div>
    </section>

    <!-- Quick actions -->
    {if quick_actions}
    <section class="rounded-2xl border border-slate-200 bg-white p-6">
        <div class="mb-4">
            <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Quick Actions</div>
            <h3 class="mt-2 text-lg font-semibold text-slate-900">Today's workflow starters</h3>
        </div>
        <div class="flex flex-wrap gap-3">
            {foreach quick_actions as action}
            <a href="{action.url}" class="inline-flex items-center gap-2 rounded-lg border border-teal-300 bg-teal-50 px-4 py-2 text-sm font-medium text-teal-900 transition hover:bg-teal-100">
                {action.label}
            </a>
            {/foreach}
        </div>
    </section>
    {/if}

    <!-- Patient flow -->
    {if patient_flow}
    <section>
        <div class="mb-4">
            <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-teal-700">Patient Flow</div>
            <h3 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900">Follow the visit, step by step</h3>
            <p class="mt-1 text-sm text-slate-500">Each card opens the worklist for that step.</p>
        </div>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {foreach patient_flow as item}
            <a href="{item.url}" class="group block rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-teal-300 hover:shadow-sm">
                <div class="flex items-baseline justify-between gap-3">
                    <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-500">Step {item.step}</div>
                    {if item.count}<div class="text-2xl font-semibold text-slate-900">{item.count}</div>{/if}
                </div>
                <div class="mt-1 text-base font-semibold text-slate-900">{item.title}</div>
                <div class="mt-2 text-sm text-slate-600">{item.detail}</div>
                <div class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-teal-700 group-hover:text-teal-800">{item.cta} <span aria-hidden="true">→</span></div>
            </a>
            {/foreach}
        </div>
    </section>
    {/if}

    <!-- Worklists -->
    {if worklists}
    <section class="rounded-2xl border border-slate-200 bg-white">
        <div class="border-b border-slate-200 px-6 py-4">
            <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">My Worklists</div>
            <h3 class="mt-2 text-lg font-semibold text-slate-900">Items needing attention</h3>
        </div>
        <div class="divide-y divide-slate-100">
            {foreach worklists as list}
            <a href="{list.url}" class="flex items-center justify-between gap-4 px-6 py-4 transition hover:bg-slate-50">
                <div class="flex-1">
                    <div class="font-medium text-slate-900">{list.title}</div>
                    <div class="mt-1 text-sm text-slate-600">{list.detail}</div>
                </div>
                <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-sm font-semibold text-slate-700">{list.count}</span>
            </a>
            {/foreach}
        </div>
    </section>
    {/if}

    <!-- Workspace modules -->
    {if workspace_nav_groups}
    <section class="rounded-2xl border border-slate-200 bg-white p-6">
        <div class="mb-4">
            <div class="text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-500">Workspace Modules</div>
            <h3 class="mt-2 text-lg font-semibold text-slate-900">Open another module</h3>
        </div>
        <div class="grid gap-3 lg:grid-cols-2 xl:grid-cols-3">
            {foreach workspace_nav_groups as group}
            <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                <div class="mb-3 flex items-center justify-between">
                    <div class="text-sm font-semibold text-slate-900">{group.title}</div>
                </div>
                <div class="space-y-1">
                    {foreach group.items as item}
                    <a href="{item.url}" class="block rounded px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-white hover:text-slate-900">{item.label}</a>
                    {/foreach}
                </div>
            </div>
            {/foreach}
        </div>
    </section>
    {/if}

</div>
{/block}
