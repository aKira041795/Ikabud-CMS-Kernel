{extends "modules/ehr/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-[0.22em] text-teal-700">Billing</div>
                <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Billing queue</h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Suggested charges from completed visits, orders, and prescriptions — ready for billing review.</p>
            </div>
            <div class="rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-600">
                <span class="font-semibold text-slate-900">{result_count}</span> charge candidates in current view
            </div>
        </div>
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-4">
            <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Pending charges</h2>
            <p class="mt-1 text-xs text-slate-500">Each row links back to the visit, order, or prescription it was generated from.</p>
        </div>
        <div class="divide-y divide-slate-100">
            {if candidates}
                {foreach candidates as candidate}
                <div class="px-6 py-4">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <div class="text-base font-semibold text-slate-900">{candidate.label}</div>
                            <div class="mt-1 text-sm text-slate-600">{candidate.billing_code} · {if candidate.patient_summary}{candidate.patient_summary.last_name}, {candidate.patient_summary.first_name}{else}Unknown patient{/if}</div>
                        </div>
                        <div class="rounded-full bg-teal-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-teal-700">{candidate.candidate_type}</div>
                    </div>
                    <div class="mt-3 grid gap-3 text-sm text-slate-600 md:grid-cols-4">
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Quantity</div>
                            <div class="mt-1 text-slate-900">{candidate.quantity}</div>
                        </div>
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Event At</div>
                            <div class="mt-1 text-slate-900">{candidate.event_at}</div>
                        </div>
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Source Action</div>
                            <div class="mt-1 text-slate-900">{candidate.source_action}</div>
                        </div>
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Encounter</div>
                            <div class="mt-1 text-slate-900">{if candidate.encounter_summary}{candidate.encounter_summary.encounter_uuid}{else}No encounter{/if}</div>
                        </div>
                    </div>
                </div>
                {/foreach}
            {else}
                <div class="px-6 py-12 text-center text-sm text-slate-600">No charges to bill right now.</div>
            {/if}
        </div>
    </section>
</div>
{/block}