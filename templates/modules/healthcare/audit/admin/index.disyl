{extends "modules/ehr/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-[0.22em] text-teal-700">Activity</div>
                <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Access activity</h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Who did what, and when — across the patient chart.</p>
            </div>
            <div class="rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-600">
                <span class="font-semibold text-slate-900">{result_count}</span> recent audit events
            </div>
        </div>
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-4">
            <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Latest activity</h2>
            <p class="mt-1 text-xs text-slate-500">Most recent record changes, views, and access decisions.</p>
            <form method="GET" action="{base_url}/admin/ehr/audit" class="mt-4 flex flex-col gap-3 md:flex-row md:items-end">
                <div class="flex-1">
                    <label for="audit-q" class="text-xs font-semibold uppercase tracking-wide text-slate-500">Search</label>
                    <input id="audit-q" type="text" name="q" value="{filter_q}" placeholder="Event, module, patient id…" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-200">
                </div>
                <label class="inline-flex items-center gap-2 text-sm text-slate-700">
                    <input type="checkbox" name="break_glass" value="1" {if filter_break_glass}checked{/if} class="rounded border-slate-300 text-rose-600 focus:ring-rose-200">
                    Break-glass only
                </label>
                <button type="submit" class="rounded-lg bg-teal-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-700">Filter</button>
            </form>
        </div>
        <div class="divide-y divide-slate-100">
            {if entries}
                {foreach entries as entry}
                <div class="px-6 py-4">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <div class="text-base font-semibold text-slate-900">{entry.event_label}{if entry.is_break_glass} <span class="ml-2 inline-flex items-center rounded-full bg-rose-100 px-2 py-0.5 text-xs font-semibold text-rose-700">Break-glass</span>{/if}</div>
                            <div class="mt-1 text-sm text-slate-600">{entry.module} · {entry.entity_type} {entry.entity_id}</div>
                        </div>
                        <div class="text-xs font-semibold uppercase tracking-wide text-slate-500">{entry.created_at}</div>
                    </div>
                    <div class="mt-3 grid gap-3 text-sm text-slate-600 md:grid-cols-3">
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Actor Source</div>
                            <div class="mt-1 text-slate-900">{if entry.actor_source}{entry.actor_source}{else}Unknown{/if}</div>
                        </div>
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Actor User</div>
                            <div class="mt-1 text-slate-900">{if entry.actor_user_id}{entry.actor_user_id}{else}N/A{/if}</div>
                        </div>
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Patient Context</div>
                            <div class="mt-1 text-slate-900">{if entry.context.patient_id}{entry.context.patient_id}{else}None{/if}</div>
                        </div>
                    </div>
                </div>
                {/foreach}
            {else}
                <div class="px-6 py-12 text-center text-sm text-slate-600">No activity yet.</div>
            {/if}
        </div>
    </section>
</div>
{/block}