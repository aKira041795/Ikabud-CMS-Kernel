{extends "modules/ehr/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-[0.22em] text-teal-700">Lab &amp; Imaging</div>
                <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Results</h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Enter incoming results, verify them, and release them to the care team.</p>
            </div>
            <div class="rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-600">
                <span class="font-semibold text-slate-900">{result_count}</span> results in current view
            </div>
        </div>
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-4">
            <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Recent results</h2>
            <p class="mt-1 text-xs text-slate-500">Latest values entered, with abnormal flags highlighted.</p>
        </div>
        <div class="divide-y divide-slate-100">
            {if results}
                {foreach results as result}
                <div class="px-6 py-4">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <div class="text-base font-semibold text-slate-900">{if result.item_label}{result.item_label}{else}Clinical result{/if}</div>
                            <div class="mt-1 text-sm text-slate-600">{if result.patient_summary}{result.patient_summary.last_name}, {result.patient_summary.first_name}{else}Unknown patient{/if} · {if result.order_uuid}{result.order_uuid}{else}No order reference{/if}</div>
                        </div>
                        <div class="flex items-center gap-2">
                            {if result.restricted_flag}
                            <div class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-amber-700">Restricted</div>
                            {/if}
                            <div class="rounded-full bg-teal-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-teal-700">{result.result_status}</div>
                        </div>
                    </div>
                    <div class="mt-3 grid gap-3 text-sm text-slate-600 md:grid-cols-4">
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Observed</div>
                            <div class="mt-1 text-slate-900">{result.observed_at}</div>
                        </div>
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Value</div>
                            <div class="mt-1 text-slate-900">{if result.value_text}{result.value_text}{else}{result.value_numeric} {result.unit}{/if}</div>
                        </div>
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Flag</div>
                            <div class="mt-1 text-slate-900">{if result.abnormal_flag}{result.abnormal_flag}{else}Normal{/if}</div>
                        </div>
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Encounter</div>
                            <div class="mt-1 text-slate-900">{if result.encounter_summary}{result.encounter_summary.encounter_uuid}{else}No encounter{/if}</div>
                        </div>
                    </div>
                    <div class="mt-3 flex flex-wrap items-center gap-2">
                        {if result.result_status == 'entered'}
                        <form method="POST" action="{base_url}/admin/ehr/results/transition" class="inline">
                            {csrf_field | raw}
                            <input type="hidden" name="result_id" value="{result.id}">
                            <input type="hidden" name="action" value="verify">
                            <button type="submit" class="rounded-md bg-teal-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-teal-700">Verify</button>
                        </form>
                        {/if}
                        {if result.result_status == 'verified'}
                        <form method="POST" action="{base_url}/admin/ehr/results/transition" class="inline">
                            {csrf_field | raw}
                            <input type="hidden" name="result_id" value="{result.id}">
                            <input type="hidden" name="action" value="release">
                            <button type="submit" class="rounded-md bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700">Release</button>
                        </form>
                        {/if}
                        {if result.result_status == 'released'}
                            {if result.acknowledged_at}
                            <span class="rounded-md bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-600">Acknowledged {result.acknowledged_at}</span>
                            {else}
                            <form method="POST" action="{base_url}/admin/ehr/results/transition" class="inline">
                                {csrf_field | raw}
                                <input type="hidden" name="result_id" value="{result.id}">
                                <input type="hidden" name="action" value="acknowledge">
                                <button type="submit" class="rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-700">Acknowledge</button>
                            </form>
                            {/if}
                        {/if}
                    </div>
                </div>
                {/foreach}
            {else}
                <div class="px-6 py-12 text-center text-sm text-slate-600">No results have been entered yet. Use the form below to add one.</div>
            {/if}
        </div>
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Enter a result</h2>
        <p class="mt-1 text-xs text-slate-500">Choose the order item, then record the value, units, and any flags.</p>
        {if form_notice == 'created'}<div class="mt-4 border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Result entered.</div>{elseif form_notice == 'verified'}<div class="mt-4 border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Result verified.</div>{elseif form_notice == 'released'}<div class="mt-4 border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Result released.</div>{elseif form_notice == 'acknowledged'}<div class="mt-4 border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm text-indigo-700">Result acknowledged.</div>{/if}
        {if form_error}<div class="mt-4 border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">{form_error}</div>{/if}
        <form method="POST" action="{base_url}/admin/ehr/results" class="mt-4 grid gap-4 md:grid-cols-2">
            {csrf_field | raw}
            <div class="md:col-span-2">
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Order Item</label>
                <select name="order_item_id" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
                    <option value="">Select order item</option>
                    {foreach order_item_options as item}
                    <option value="{item.order_item_id}" {if form_values.order_item_id == item.order_item_id}selected{/if}>{item.order_uuid} · {item.item_label}</option>
                    {/foreach}
                </select>
            </div>
            <div>
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Value (text)</label>
                <input type="text" name="value_text" value="{form_values.value_text}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
            </div>
            <div>
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Value (numeric)</label>
                <input type="text" name="value_numeric" value="{form_values.value_numeric}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
            </div>
            <div>
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Unit</label>
                <input type="text" name="unit" value="{form_values.unit}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
            </div>
            <div>
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Reference Range</label>
                <input type="text" name="reference_range_text" value="{form_values.reference_range_text}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
            </div>
            <div>
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Abnormal Flag</label>
                <input type="text" name="abnormal_flag" value="{form_values.abnormal_flag}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm" placeholder="e.g. H, L, A">
            </div>
            <div class="md:col-span-2"><button type="submit" class="bg-slate-900 px-4 py-3 text-sm font-semibold text-white">Enter Result</button></div>
        </form>
    </section>
</div>
{/block}