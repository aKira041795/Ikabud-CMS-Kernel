{extends "modules/ehr/layouts/admin.disyl"}

{block content}
<div class="space-y-6">
    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <div class="text-xs font-semibold uppercase tracking-[0.22em] text-teal-700">Notes</div>
                <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900">Clinical notes</h1>
                <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Read what's been documented for each visit and start a new note when you're ready.</p>
            </div>
            <div class="rounded-2xl bg-slate-50 px-4 py-3 text-sm text-slate-600">
                <span class="font-semibold text-slate-900">{result_count}</span> notes in current view
            </div>
        </div>
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 px-6 py-4">
            <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Recent notes</h2>
            <p class="mt-1 text-xs text-slate-500">Most recent drafts, signed notes, and amendments across visits.</p>
        </div>
        <div class="divide-y divide-slate-100">
            {if notes}
                {foreach notes as note}
                <div class="px-6 py-4 {if note.status == 'draft'}border-l-4 border-amber-400 bg-amber-50/40{/if}">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="text-base font-semibold text-slate-900">{note.note_type}</span>
                                {if note.status == 'draft'}<span class="rounded-sm border border-amber-400 bg-amber-100 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-widest text-amber-900">DRAFT — UNSIGNED</span>{/if}
                                {if note.status == 'signed'}<span class="text-xs text-emerald-700" title="Signed">✓ Signed{if note.signed_at} · {note.signed_at}{/if}</span>{/if}
                            </div>
                            <div class="mt-1 text-sm text-slate-600">{if note.patient_summary}{note.patient_summary.last_name}, {note.patient_summary.first_name}{else}Unknown patient{/if} · {if note.encounter_summary}{note.encounter_summary.encounter_uuid}{else}No encounter{/if}</div>
                        </div>
                        <div class="flex items-center gap-2">
                            {if note.restricted_flag}
                            <div class="rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-amber-700">Restricted</div>
                            {/if}
                            {if note.status_badge}{include "modules/healthcare/ehr/partials/_status_badge" with {badge: note.status_badge, size: 'sm'}}{else}<div class="rounded-full bg-teal-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-teal-700">{note.status}</div>{/if}
                        </div>
                    </div>
                    <div class="mt-3 grid gap-3 text-sm text-slate-600 md:grid-cols-3">
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Version</div>
                            <div class="mt-1 text-slate-900">{if note.version_no}v{note.version_no}{else}Unversioned{/if} {if note.version_kind}· {note.version_kind}{/if}</div>
                        </div>
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Signed</div>
                            <div class="mt-1 text-slate-900">{if note.signed_at}{note.signed_at}{else}Not signed{/if}</div>
                        </div>
                        <div>
                            <div class="text-xs uppercase tracking-wide text-slate-400">Updated</div>
                            <div class="mt-1 text-slate-900">{note.updated_at}</div>
                        </div>
                    </div>
                    <div class="mt-3 rounded-2xl bg-slate-50 px-4 py-3 text-sm leading-6 text-slate-700">{if note.excerpt}{note.excerpt}{else}No note body preview available for this version.{/if}</div>
                    <div class="mt-3 flex flex-wrap gap-2">
                        {if note.status == 'draft'}
                        <form method="POST" action="{base_url}/admin/ehr/notes/sign" class="flex flex-wrap items-center gap-2">
                            {csrf_field | raw}
                            <input type="hidden" name="note_id" value="{note.id}">
                            <input type="text" name="sign_reason" placeholder="Sign reason (optional)" class="border border-slate-200 px-2 py-1.5 text-xs">
                            <button type="submit" class="rounded-xl bg-emerald-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-700">Sign Note</button>
                        </form>
                        {/if}
                        {if note.status == 'signed' || note.status == 'amended'}
                        <details class="group">
                            <summary class="inline-flex cursor-pointer items-center rounded-xl border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:border-teal-300">Amend</summary>
                            <form method="POST" action="{base_url}/admin/ehr/notes/amend" class="mt-2 grid gap-2 rounded-xl border border-slate-200 bg-white p-3">
                                {csrf_field | raw}
                                <input type="hidden" name="note_id" value="{note.id}">
                                <input type="text" name="amendment_reason" placeholder="Amendment reason (required)" required class="border border-slate-200 px-2 py-1.5 text-xs">
                                <textarea name="body_text" rows="4" placeholder="New body text" required class="border border-slate-200 px-2 py-1.5 text-xs"></textarea>
                                <button type="submit" class="justify-self-start rounded-xl bg-amber-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-amber-700">Submit Amendment</button>
                            </form>
                        </details>
                        {/if}
                    </div>
                </div>
                {/foreach}
            {else}
                <div class="px-6 py-16 text-center">
                    <div class="mx-auto mb-3 text-4xl text-slate-300">📝</div>
                    <div class="text-sm font-semibold text-slate-700">No clinical notes yet</div>
                    <div class="mt-1 text-xs text-slate-500">Notes are the legal record of each visit. Start one in the form below.</div>
                </div>
            {/if}
        </div>
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Write a new note</h2>
        <p class="mt-1 text-xs text-slate-500">Save as a draft now and sign it after review.</p>
        <div class="mt-3 text-2xl font-semibold text-slate-900">Draft note</div>
        {if form_notice == 'created'}<div class="mt-4 border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Note drafted.</div>{/if}
        {if form_notice == 'signed'}<div class="mt-4 border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Note signed.</div>{/if}
        {if form_notice == 'amended'}<div class="mt-4 border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">Amendment recorded.</div>{/if}
        {if form_error}<div class="mt-4 border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">{form_error}</div>{/if}
        <form method="POST" action="{base_url}/admin/ehr/notes" class="mt-4 grid gap-4 md:grid-cols-2">
            {csrf_field | raw}
            <div>
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Patient</label>
                <select name="patient_id" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
                    <option value="">Select patient</option>
                    {foreach patient_options as patient}
                    <option value="{patient.id}" {if form_values.patient_id == patient.id}selected{/if}>{patient.last_name}, {patient.first_name}</option>
                    {/foreach}
                </select>
            </div>
            <div>
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Encounter</label>
                <select name="encounter_id" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
                    <option value="">Select encounter</option>
                    {foreach encounter_options as encounter}
                    <option value="{encounter.id}" {if form_values.encounter_id == encounter.id}selected{/if}>#{encounter.id} · {encounter.status}</option>
                    {/foreach}
                </select>
            </div>
            <div>
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Note Type</label>
                <input type="text" name="note_type" value="{form_values.note_type}" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">
            </div>
            <div class="md:col-span-2">
                <label class="mb-1 block text-xs uppercase tracking-wide text-slate-500">Body</label>
                <textarea name="body_text" rows="6" class="w-full border border-slate-200 bg-white px-3 py-2 text-sm">{form_values.body_text}</textarea>
            </div>
            <div class="md:col-span-2"><button type="submit" class="bg-slate-900 px-4 py-3 text-sm font-semibold text-white">Create Draft</button></div>
        </form>
    </section>
</div>
{/block}