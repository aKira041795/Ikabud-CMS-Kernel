{
  "comments": {
    "blockComment": [
      "{!",
      "!}"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "{if",
      "{/if}"
    ],
    [
      "{foreach",
      "{/foreach}"
    ],
    [
      "{for",
      "{/for}"
    ],
    [
      "{block",
      "{/block}"
    ],
    [
      "{component",
      "{/component}"
    ],
    [
      "{sandbox",
      "{/sandbox}"
    ],
    [
      "{cache",
      "{/cache}"
    ],
    [
      "{parallel",
      "{/parallel}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "{!",
      "close": "!}"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    },
    {
      "open": "(",
      "close": ")"
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ],
    [
      "(",
      ")"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*\\{(?:if|elseif|else|foreach|for|while|block|component|sandbox|cache|parallel|match|untrusted)\\b[^}]*\\}(?!.*\\{/\\w)",
    "decreaseIndentPattern": "^\\s*\\{/(?:if|foreach|for|while|block|component|sandbox|cache|parallel|match|untrusted)\\}"
  },
  "wordPattern": "[a-zA-Z_][\\w.]*"
}