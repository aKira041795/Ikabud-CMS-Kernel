parameters:
    level: 6
    paths:
        - kernel
        - src
        - modules
    excludePaths:
        - analyse
        - '**/*Test.php'
        - modules/*/builder-ui
        - modules/*/node_modules
        - vendor
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Bootstrap global functions used before class-based resolution
        - '#Function [a-zA-Z_]+ not found#'
        # Dynamic module loading patterns
        - '#Variable \$[a-zA-Z_]+ might not be defined#'
        # --- Path-specific level overrides ---
        # kernel/ stays at level 6 (the global level)
        # modules/ relaxed to level 4 during initial rollout

    # Baseline — generated errors we accept during initial rollout.
    # After baseline is clean, this file can be removed and
    # continue-on-error removed from CI.
    # Generate with: php vendor/bin/phpstan analyse --generate-baseline phpstan-baseline.neon
    # Then uncomment:
    # includes:
    #     - phpstan-baseline.neon
